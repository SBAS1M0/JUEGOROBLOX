          <Item class="ModuleScript" referent="21">
            <Properties>
              <string name="Name">PixelArt</string>
              <string name="Source"><![CDATA[-- Dibuja un lienzo de 16x16 dentro de un Frame usando pocas piezas:
-- las celdas seguidas del mismo color de una fila se unen en un solo rectángulo.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Palette = require(Shared.Palette)

local PixelArt = {}

function PixelArt.render(container, cells, emptyColor)
	local old = container:FindFirstChild("Pixels")
	if old then
		old:Destroy()
	end
	if type(cells) ~= "string" or #cells ~= Config.CELLS then
		return
	end
	local grid = Config.GRID
	local holder = Instance.new("Frame")
	holder.Name = "Pixels"
	holder.Size = UDim2.fromScale(1, 1)
	holder.BackgroundTransparency = 1
	holder.ZIndex = container.ZIndex

	for row = 0, grid - 1 do
		local col = 0
		while col < grid do
			local key = string.sub(cells, row * grid + col + 1, row * grid + col + 1)
			local runEnd = col
			while runEnd + 1 < grid and string.sub(cells, row * grid + runEnd + 2, row * grid + runEnd + 2) == key do
				runEnd += 1
			end
			local color = key == Palette.EMPTY and (emptyColor or Palette.EmptyColor) or Palette.colorOf(key)
			local pixel = Instance.new("Frame")
			pixel.BorderSizePixel = 0
			pixel.BackgroundColor3 = color
			-- Un pelín más grande para que no se vean rendijas entre filas.
			pixel.Position = UDim2.fromScale(col / grid, row / grid)
			pixel.Size = UDim2.new((runEnd - col + 1) / grid, 1, 1 / grid, 1)
			pixel.ZIndex = container.ZIndex
			pixel.Parent = holder
			col = runEnd + 1
		end
	end
	holder.Parent = container
end

return PixelArt
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="22">
            <Properties>
              <string name="Name">Results</string>
              <string name="Source"><![CDATA[-- Pantalla de resultados tras entregar una obra (estrellas, monedas, confeti)
-- y la ventana de ayuda.

local Players = game:GetService("Players")

local Theme = require(script.Parent.Theme)
local PixelArt = require(script.Parent.PixelArt)

local Results = {}

local C = Theme.Colors
local CONFETTI_COLORS = {
	Color3.fromRGB(255, 90, 140),
	Color3.fromRGB(255, 200, 60),
	Color3.fromRGB(90, 200, 255),
	Color3.fromRGB(140, 110, 255),
	Color3.fromRGB(80, 220, 140),
}

local gui
local refs = {}
local queue = {}
local showing = false

local function confetti(amount)
	local holder = refs.confetti
	local random = Random.new()
	for _ = 1, amount do
		local piece = Theme.new("Frame", {
			Size = UDim2.fromOffset(random:NextInteger(8, 14), random:NextInteger(12, 20)),
			Position = UDim2.new(random:NextNumber(0.1, 0.9), 0, -0.05, 0),
			Rotation = random:NextInteger(0, 360),
			BackgroundColor3 = CONFETTI_COLORS[random:NextInteger(1, #CONFETTI_COLORS)],
			BorderSizePixel = 0,
			Parent = holder,
		}, { Theme.corner(3) })
		local duration = random:NextNumber(1.6, 2.8)
		Theme.tween(piece, duration, {
			Position = UDim2.new(piece.Position.X.Scale + random:NextNumber(-0.15, 0.15), 0, 1.05, 0),
			Rotation = piece.Rotation + random:NextInteger(-540, 540),
		}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		task.delay(duration, function()
			piece:Destroy()
		end)
	end
end

local function row(parent, order, icon, text, color)
	local frame = Theme.new("Frame", {
		Size = UDim2.new(1, 0, 0, 34),
		BackgroundColor3 = C.PanelSoft,
		LayoutOrder = order,
		Parent = parent,
	}, { Theme.corner(10) })
	Theme.label({
		Size = UDim2.new(1, -20, 1, -8),
		Position = UDim2.fromOffset(10, 4),
		Text = icon .. "  " .. text,
		TextColor3 = color or C.Ink,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 22,
		Parent = frame,
	})
	frame.Visible = false
	return frame
end

local function buildModal(name)
	local holder = Theme.new("Frame", {
		Name = name,
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = gui,
	})
	Theme.new("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = C.Shadow,
		BackgroundTransparency = 0.45,
		Text = "",
		AutoButtonColor = false,
		Parent = holder,
	})
	-- El "Wrapper" lleva la escala por pantalla y la tarjeta la animación de entrada.
	local wrapper = Theme.new("Frame", {
		Name = "Wrapper",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(440, 600),
		BackgroundTransparency = 1,
		Parent = holder,
	})
	local card = Theme.new("Frame", {
		Name = "Card",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = C.Background,
		Parent = wrapper,
	}, {
		Theme.corner(26),
		Theme.stroke(C.Ink, 4),
	})
	return holder, card, wrapper
end

local function buildResults()
	local holder, card = buildModal("Results")
	refs.holder = holder
	refs.card = card

	refs.title = Theme.label({
		Size = UDim2.new(1, -40, 0, 46),
		Position = UDim2.fromOffset(20, 14),
		Text = "¡Obra entregada!",
		TextColor3 = C.Primary,
		MaxTextSize = 40,
		Parent = card,
	})
	Theme.textStroke(Color3.new(1, 1, 1), 3).Parent = refs.title

	local starRow = Theme.new("Frame", {
		Size = UDim2.new(1, -40, 0, 70),
		Position = UDim2.fromOffset(20, 62),
		BackgroundTransparency = 1,
		Parent = card,
	}, {
		Theme.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			Padding = UDim.new(0, 10),
		}),
	})
	refs.stars = {}
	for i = 1, 3 do
		local star = Theme.label({
			Size = UDim2.fromOffset(i == 2 and 74 or 62, i == 2 and 74 or 62),
			Text = "★",
			TextColor3 = Color3.fromRGB(220, 214, 230),
			MaxTextSize = 80,
			LayoutOrder = i,
			Parent = starRow,
		})
		Theme.textStroke(C.Ink, 3).Parent = star
		refs.stars[i] = star
	end

	refs.art = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 140),
		Size = UDim2.fromOffset(150, 150),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = card,
	}, { Theme.stroke(C.Gold, 6), Theme.corner(4) })

	refs.line = Theme.label({
		Size = UDim2.new(1, -40, 0, 30),
		Position = UDim2.fromOffset(20, 302),
		Text = "",
		Font = Theme.Fonts.Bold,
		TextColor3 = C.InkSoft,
		MaxTextSize = 20,
		Parent = card,
	})

	refs.rows = Theme.new("Frame", {
		Size = UDim2.new(1, -60, 0, 180),
		Position = UDim2.fromOffset(30, 338),
		BackgroundTransparency = 1,
		Parent = card,
	}, {
		Theme.new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
	})

	refs.continue = Theme.button({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -18),
		Size = UDim2.fromOffset(220, 56),
		Text = "¡Genial!",
		Color = C.Green,
		Parent = card,
		OnClick = function()
			Results.hide()
		end,
	})

	refs.confetti = Theme.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		ZIndex = 20,
		Parent = gui,
	})
end

local function buildLevelUp()
	local holder, card, wrapper = buildModal("LevelUp")
	wrapper.Size = UDim2.fromOffset(420, 340)
	refs.levelHolder = holder
	refs.levelCard = card
	local banner = Theme.new("Frame", {
		Size = UDim2.new(1, 0, 0, 90),
		BackgroundColor3 = C.Gold,
		Parent = card,
	}, { Theme.corner(26), Theme.gradient(Color3.fromRGB(255, 220, 90), Color3.fromRGB(255, 150, 60), 0) })
	refs.levelTitle = Theme.label({
		Size = UDim2.new(1, -20, 1, -16),
		Position = UDim2.fromOffset(10, 8),
		Text = "¡NIVEL 2!",
		TextColor3 = Color3.new(1, 1, 1),
		MaxTextSize = 56,
		Parent = banner,
	})
	Theme.textStroke(C.GoldDark, 3).Parent = refs.levelTitle
	refs.levelText = Theme.label({
		Size = UDim2.new(1, -40, 0, 150),
		Position = UDim2.fromOffset(20, 104),
		Text = "",
		Font = Theme.Fonts.Bold,
		TextWrapped = true,
		TextColor3 = C.Ink,
		MaxTextSize = 22,
		Parent = card,
	})
	Theme.button({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -18),
		Size = UDim2.fromOffset(220, 56),
		Text = "¡A pintar!",
		Color = C.Primary,
		Parent = card,
		OnClick = function()
			refs.levelHolder.Visible = false
			Results.next()
		end,
	})
end

local HELP_TEXT = table.concat({
	"1️⃣  Los clientes entran a tu galería con un pedido.",
	"2️⃣  Pulsa «Pintar» en la lista o acércate y pulsa E.",
	"3️⃣  Pinta sobre la imagen: usa la 🪣 cubeta para rellenar zonas y el 🖌️ pincel para detalles.",
	"4️⃣  En modo Original y Remix los números te dicen qué color va en cada casilla.",
	"5️⃣  ¡Entrega rápido! Más estrellas y más paciencia restante = más monedas y propinas.",
	"6️⃣  Compra mejoras 🛒, sube de nivel ⭐ y desbloquea nuevas obras.",
	"",
	"Atajos: B pincel · F cubeta · X borrador · Z deshacer · Enter entregar",
}, "\n")

local function buildHelp()
	local holder, card, wrapper = buildModal("Help")
	wrapper.Size = UDim2.fromOffset(560, 470)
	refs.helpHolder = holder
	refs.helpCard = card
	local title = Theme.label({
		Size = UDim2.new(1, -40, 0, 50),
		Position = UDim2.fromOffset(20, 16),
		Text = "🎨 ¿Cómo se juega?",
		TextColor3 = C.Primary,
		MaxTextSize = 40,
		Parent = card,
	})
	Theme.textStroke(Color3.new(1, 1, 1), 2).Parent = title
	Theme.label({
		Size = UDim2.new(1, -50, 0, 300),
		Position = UDim2.fromOffset(25, 76),
		Text = HELP_TEXT,
		Font = Theme.Fonts.Body,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextColor3 = C.Ink,
		MaxTextSize = 20,
		Parent = card,
	})
	Theme.button({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -18),
		Size = UDim2.fromOffset(220, 56),
		Text = "¡Entendido!",
		Color = C.Green,
		Parent = card,
		OnClick = function()
			refs.helpHolder.Visible = false
		end,
	})
end

-- Muestra los resultados uno a uno (por si llegan varios seguidos).
function Results.next()
	if showing then
		return
	end
	local item = table.remove(queue, 1)
	if not item then
		return
	end
	showing = true
	if item.kind == "level" then
		refs.levelTitle.Text = "¡NIVEL " .. item.level .. "!"
		local lines = { "¡Tu galería es cada vez más famosa! 🌟" }
		for _, name in ipairs(item.unlocked) do
			table.insert(lines, "🖼️ Nueva obra: " .. name)
		end
		for _, name in ipairs(item.modes) do
			table.insert(lines, "✨ Nuevo modo de pedido: " .. name)
		end
		refs.levelText.Text = table.concat(lines, "\n")
		refs.levelHolder.Visible = true
		Theme.pop(refs.levelCard, 0.5)
		Theme.playSound("success", 0.8)
		confetti(70)
		showing = false
		return
	end

	local result = item.result
	refs.holder.Visible = true
	Theme.pop(refs.card, 0.6)
	PixelArt.render(refs.art, item.art)
	refs.line.Text = "«" .. result.line .. "»"
	local titles =
		{ [0] = "Hmm... no le gustó", [1] = "¡Obra entregada!", [2] = "¡Muy bien hecho!", [3] = "¡OBRA MAESTRA!" }
	refs.title.Text = titles[result.stars] or "¡Obra entregada!"
	refs.title.TextColor3 = result.stars >= 3 and C.Gold or (result.stars == 0 and C.Red or C.Primary)

	for _, child in ipairs(refs.rows:GetChildren()) do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	local rows = {
		row(
			refs.rows,
			1,
			"💰",
			"Pago: " .. Theme.formatNumber(result.payment) .. (result.vip and "  (VIP 👑)" or ""),
			C.GoldDark
		),
	}
	if result.tip > 0 then
		table.insert(
			rows,
			row(refs.rows, 2, "⚡", "Propina por rapidez: " .. Theme.formatNumber(result.tip), C.Orange)
		)
	end
	if result.streak > 1 then
		table.insert(
			rows,
			row(
				refs.rows,
				3,
				"🔥",
				"Racha x" .. result.streak .. "  (+" .. math.floor(result.streakBonus * 100 + 0.5) .. "%)",
				C.Red
			)
		)
	end
	table.insert(
		rows,
		row(
			refs.rows,
			4,
			"⭐",
			"+" .. result.xp .. " XP  ·  Precisión " .. math.floor(result.quality * 100 + 0.5) .. "%",
			C.Primary
		)
	)

	for _, star in ipairs(refs.stars) do
		star.TextColor3 = Color3.fromRGB(220, 214, 230)
	end
	refs.continue.Holder.Visible = false
	task.spawn(function()
		task.wait(0.35)
		for i = 1, result.stars do
			local star = refs.stars[i]
			star.TextColor3 = C.Gold
			Theme.pop(star, 1.8)
			Theme.playSound("success", 0.9 + i * 0.15)
			task.wait(0.32)
		end
		for _, frame in ipairs(rows) do
			frame.Visible = true
			Theme.pop(frame, 0.8)
			Theme.playSound("click", 1.3)
			task.wait(0.15)
		end
		if result.stars >= 3 then
			confetti(90)
		elseif result.stars == 2 then
			confetti(30)
		end
		refs.continue.Holder.Visible = true
		Theme.pop(refs.continue.Holder, 0.6)
	end)
end

function Results.hide()
	refs.holder.Visible = false
	showing = false
	Results.next()
end

function Results.show(result, template, art)
	table.insert(queue, { kind = "result", result = result, template = template, art = art })
	if result.levelUp then
		table.insert(queue, {
			kind = "level",
			level = result.levelUp,
			unlocked = result.unlocked or {},
			modes = result.newModes or {},
		})
	end
	Results.next()
end

function Results.showHelp()
	refs.helpHolder.Visible = true
	Theme.pop(refs.helpCard, 0.7)
end

function Results.init()
	gui = Theme.new("ScreenGui", {
		Name = "Results",
		ResetOnSpawn = false,
		DisplayOrder = 20,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = Players.LocalPlayer:WaitForChild("PlayerGui"),
	})
	buildResults()
	buildLevelUp()
	buildHelp()

	-- Ajusta las ventanas a pantallas pequeñas.
	local function updateScale()
		local camera = workspace.CurrentCamera
		if not camera then
			return
		end
		local viewport = camera.ViewportSize
		for _, holder in ipairs({ refs.holder, refs.levelHolder, refs.helpHolder }) do
			local wrapper = holder:FindFirstChild("Wrapper")
			local size = wrapper.Size
			local scale = math.min((viewport.X - 20) / size.X.Offset, (viewport.Y - 80) / size.Y.Offset)
			local uiScale = wrapper:FindFirstChild("ViewportScale")
				or Theme.new("UIScale", { Name = "ViewportScale", Parent = wrapper })
			uiScale.Scale = math.clamp(scale, 0.45, 1.15)
		end
	end
	updateScale()
	if workspace.CurrentCamera then
		workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
	end
end

return Results
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="23">
            <Properties>
              <string name="Name">Shop</string>
              <string name="Source"><![CDATA[-- Tienda de mejoras de la galería.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)

local Theme = require(script.Parent.Theme)

local Shop = {}

local C = Theme.Colors

local app
local gui, panel
local cards = {}
local busy = false

-- Texto con el efecto actual y el siguiente de cada mejora.
local function effectText(id, level)
	local levels = { [id] = level }
	local nextLevels = { [id] = level + 1 }
	if id == "precio" or id == "decoracion" then
		return string.format("Pago x%.2f → x%.2f", Config.payMultiplier(levels), Config.payMultiplier(nextLevels))
	elseif id == "paciencia" then
		return string.format(
			"Paciencia x%.2f → x%.2f",
			Config.patienceMultiplier(levels),
			Config.patienceMultiplier(nextLevels)
		)
	elseif id == "fama" then
		return string.format(
			"Cliente cada %.1fs → %.1fs · Fila %d",
			Config.spawnInterval(levels),
			Config.spawnInterval(nextLevels),
			Config.maxQueue(nextLevels)
		)
	elseif id == "propinas" then
		return string.format("Propina x%.2f → x%.2f", Config.tipMultiplier(levels), Config.tipMultiplier(nextLevels))
	elseif id == "vip" then
		return string.format(
			"VIP %d%% → %d%%",
			math.floor(Config.vipChance(levels) * 100 + 0.5),
			math.floor(Config.vipChance(nextLevels) * 100 + 0.5)
		)
	elseif id == "pincel" then
		return level == 0 and "Desbloquea pincel 2x2" or "Desbloquea pincel 3x3"
	end
	return ""
end

local function buildCard(upgrade, order, parent)
	local card = Theme.new("Frame", {
		Size = UDim2.new(1, 0, 0, 96),
		BackgroundColor3 = C.Panel,
		LayoutOrder = order,
		Parent = parent,
	}, { Theme.corner(18), Theme.stroke(C.Ink, 2, 0.8) })
	local iconBack = Theme.new("Frame", {
		Size = UDim2.fromOffset(72, 72),
		Position = UDim2.fromOffset(12, 12),
		BackgroundColor3 = C.PanelSoft,
		Parent = card,
	}, { Theme.corner(16) })
	Theme.label({ Size = UDim2.fromScale(1, 1), Text = upgrade.icon, MaxTextSize = 44, Parent = iconBack })

	Theme.label({
		Size = UDim2.new(1, -270, 0, 28),
		Position = UDim2.fromOffset(96, 8),
		Text = upgrade.name,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 24,
		Parent = card,
	})
	Theme.label({
		Size = UDim2.new(1, -270, 0, 20),
		Position = UDim2.fromOffset(96, 36),
		Text = upgrade.desc,
		Font = Theme.Fonts.Body,
		TextColor3 = C.InkSoft,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 16,
		Parent = card,
	})
	local effect = Theme.label({
		Size = UDim2.new(1, -270, 0, 18),
		Position = UDim2.fromOffset(96, 58),
		Text = "",
		Font = Theme.Fonts.Bold,
		TextColor3 = C.Primary,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 15,
		Parent = card,
	})
	local dots = Theme.new("Frame", {
		Size = UDim2.new(1, -270, 0, 8),
		Position = UDim2.fromOffset(96, 80),
		BackgroundTransparency = 1,
		Parent = card,
	}, {
		Theme.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 3),
		}),
	})
	local dotFrames = {}
	for i = 1, upgrade.max do
		dotFrames[i] = Theme.new("Frame", {
			Size = UDim2.new(1 / upgrade.max, -3, 1, 0),
			BackgroundColor3 = Color3.fromRGB(230, 224, 240),
			Parent = dots,
		}, { Theme.corner(4) })
	end

	local button = Theme.button({
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0.5, -2),
		Size = UDim2.fromOffset(150, 60),
		Text = "",
		Color = C.Green,
		Parent = card,
		OnClick = function()
			if busy then
				return
			end
			busy = true
			local ok, success, message = pcall(function()
				return app.remotes.BuyUpgrade:InvokeServer(upgrade.id)
			end)
			busy = false
			if ok and success then
				Theme.playSound("success", 1.2)
				app.notify("✨ " .. message, "success")
				Theme.pop(card, 0.9)
			else
				app.notify(ok and message or "No se pudo comprar.", "error")
			end
		end,
	})
	cards[upgrade.id] = { effect = effect, dots = dotFrames, button = button }
end

function Shop.refresh()
	local state = app.state
	if not (state and gui) then
		return
	end
	for _, upgrade in ipairs(Config.Upgrades) do
		local card = cards[upgrade.id]
		local level = state.upgrades[upgrade.id] or 0
		for i, dot in ipairs(card.dots) do
			dot.BackgroundColor3 = i <= level and C.Pink or Color3.fromRGB(230, 224, 240)
		end
		if level >= upgrade.max then
			card.effect.Text = "¡Nivel máximo!"
			card.button.Button.Text = "MÁX"
			card.button.SetEnabled(false)
		else
			local cost = Config.upgradeCost(upgrade.id, level)
			card.effect.Text = effectText(upgrade.id, level)
			card.button.Button.Text = "💰 " .. Theme.formatNumber(cost)
			card.button.SetEnabled(state.coins >= cost)
		end
	end
	if panel then
		panel.Header.Coins.Text = "💰 " .. Theme.formatNumber(state.coins)
	end
end

function Shop.open()
	gui.Enabled = true
	Shop.refresh()
	Theme.pop(panel, 0.8)
	Theme.playSound("whoosh", 1.1)
end

function Shop.close()
	gui.Enabled = false
end

function Shop.init(appRef)
	app = appRef
	gui = Theme.new("ScreenGui", {
		Name = "Shop",
		ResetOnSpawn = false,
		DisplayOrder = 8,
		Enabled = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = Players.LocalPlayer:WaitForChild("PlayerGui"),
	})
	local dim = Theme.new("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = C.Shadow,
		BackgroundTransparency = 0.5,
		Text = "",
		AutoButtonColor = false,
		Parent = gui,
	})
	dim.Activated:Connect(Shop.close)

	panel = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0.9, 0, 0.88, 0),
		BackgroundColor3 = C.Background,
		Parent = gui,
	}, {
		Theme.corner(24),
		Theme.stroke(C.Ink, 4),
		Theme.new("UISizeConstraint", { MaxSize = Vector2.new(720, 640) }),
	})
	local header = Theme.new("Frame", {
		Name = "Header",
		Size = UDim2.new(1, 0, 0, 64),
		BackgroundColor3 = C.Green,
		Parent = panel,
	}, { Theme.corner(24), Theme.gradient(Color3.fromRGB(60, 210, 140), Color3.fromRGB(40, 170, 200), 0) })
	Theme.label({
		Size = UDim2.new(0.5, 0, 0, 40),
		Position = UDim2.fromOffset(20, 12),
		Text = "🛒 Mejoras de la Galería",
		TextColor3 = Color3.new(1, 1, 1),
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 32,
		Parent = header,
	})
	local coins = Theme.label({
		Name = "Coins",
		Size = UDim2.new(0.3, 0, 0, 34),
		Position = UDim2.new(0.58, 0, 0, 15),
		Text = "",
		TextColor3 = Color3.new(1, 1, 1),
		MaxTextSize = 28,
		Parent = header,
	})
	Theme.textStroke(C.GreenDark, 2).Parent = coins
	Theme.button({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 10),
		Size = UDim2.fromOffset(44, 44),
		Text = "✕",
		Color = C.Red,
		Parent = header,
		OnClick = Shop.close,
	})

	local list = Theme.new("ScrollingFrame", {
		Position = UDim2.fromOffset(16, 78),
		Size = UDim2.new(1, -32, 1, -92),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 8,
		ScrollBarImageColor3 = C.Primary,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = panel,
	}, {
		Theme.new("UIListLayout", { Padding = UDim.new(0, 12), SortOrder = Enum.SortOrder.LayoutOrder }),
		Theme.new(
			"UIPadding",
			{ PaddingRight = UDim.new(0, 12), PaddingTop = UDim.new(0, 2), PaddingBottom = UDim.new(0, 8) }
		),
	})
	for order, upgrade in ipairs(Config.Upgrades) do
		buildCard(upgrade, order, list)
	end
end

return Shop
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="24">
            <Properties>
              <string name="Name">Studio</string>
              <string name="Source"><![CDATA[-- Estudio de pintura: el jugador pinta sobre la plantilla del pedido.
-- Herramientas: pincel (con tamaños), cubeta de relleno por zonas, borrador,
-- deshacer y limpiar. En los modos Original y Remix se ven los números guía.

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Palette = require(Shared.Palette)
local Scoring = require(Shared.Scoring)
local Templates = require(Shared.Templates)

local Theme = require(script.Parent.Theme)
local PixelArt = require(script.Parent.PixelArt)

local Studio = {}

local C = Theme.Colors
local GRID = Config.GRID
local EMPTY = Palette.EMPTY
local OUTLINE = Palette.OUTLINE
local MAX_UNDO = 40
local GRID_LINE = Color3.fromRGB(226, 218, 236)

local app
local gui, panel
local canvasFrame, catcher
local cellFrames, numberLabels = {}, {}
local paletteButtons = {}
local toolButtons = {}
local sizeButtons = {}
local sizeLocked = {}
local refs = {}

local current = nil -- pedido abierto
local cells = {}
local undoStack = {}
local selectedKey = "r"
local tool = "brush"
local brushSize = 1
local stroking = false
local lastCell = nil
local submitting = false
local confirmUntil = 0
local drafts = {}

-- Utilidades de lienzo ------------------------------------------------------------
local function index(col, row)
	return row * GRID + col + 1
end

local function templateKey(i)
	return string.sub(current.template.flat, i, i)
end

local function targetKey(i)
	if current.target then
		return string.sub(current.target, i, i)
	end
	return nil
end

local function cellColor(i)
	local key = cells[i]
	if key == OUTLINE then
		return Palette.OutlineColor
	end
	if key == EMPTY then
		local target = targetKey(i)
		if current.hints and target == selectedKey and tool ~= "eraser" then
			return Palette.EmptyColor:Lerp(Palette.colorOf(selectedKey), 0.28)
		end
		return Palette.EmptyColor
	end
	return Palette.colorOf(key)
end

local function refreshCell(i)
	local frame = cellFrames[i]
	if not frame then
		return
	end
	frame.BackgroundColor3 = cellColor(i)
	local label = numberLabels[i]
	if label then
		label.Visible = current.hints and cells[i] == EMPTY
	end
end

local function refreshAll()
	for i = 1, Config.CELLS do
		refreshCell(i)
	end
end

local function updateProgress()
	local paintable, filled = 0, 0
	for i = 1, Config.CELLS do
		if templateKey(i) ~= OUTLINE then
			paintable += 1
			if cells[i] ~= EMPTY then
				filled += 1
			end
		end
	end
	local fraction = filled / math.max(paintable, 1)
	refs.progressFill.Size = UDim2.fromScale(fraction, 1)
	refs.progressText.Text = "Progreso " .. math.floor(fraction * 100 + 0.5) .. "%"
	refs.submit.SetBaseColor(fraction >= 0.999 and C.Green or C.Primary)
	return fraction
end

local function snapshot()
	return table.concat(cells)
end

local function pushUndo()
	table.insert(undoStack, snapshot())
	if #undoStack > MAX_UNDO then
		table.remove(undoStack, 1)
	end
end

local function loadSnapshot(str)
	for i = 1, Config.CELLS do
		cells[i] = string.sub(str, i, i)
	end
	refreshAll()
	updateProgress()
end

local function paintCell(col, row, key)
	if col < 0 or row < 0 or col >= GRID or row >= GRID then
		return false
	end
	local i = index(col, row)
	if templateKey(i) == OUTLINE or cells[i] == key then
		return false
	end
	cells[i] = key
	refreshCell(i)
	return true
end

local function paintBrush(col, row)
	local key = tool == "eraser" and EMPTY or selectedKey
	local offset = math.floor((brushSize - 1) / 2)
	local changed = false
	for dy = 0, brushSize - 1 do
		for dx = 0, brushSize - 1 do
			if paintCell(col + dx - offset, row + dy - offset, key) then
				changed = true
			end
		end
	end
	return changed
end

-- Rellena la zona de la plantilla (misma letra) que tenga el mismo color actual.
local function floodFill(col, row)
	local start = index(col, row)
	local zone = templateKey(start)
	if zone == OUTLINE then
		return false
	end
	local from = cells[start]
	local to = selectedKey
	if from == to then
		return false
	end
	local queue = { { col, row } }
	local seen = { [start] = true }
	local head = 1
	while head <= #queue do
		local c, r = queue[head][1], queue[head][2]
		head += 1
		local i = index(c, r)
		cells[i] = to
		refreshCell(i)
		for _, d in ipairs({ { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } }) do
			local nc, nr = c + d[1], r + d[2]
			if nc >= 0 and nr >= 0 and nc < GRID and nr < GRID then
				local ni = index(nc, nr)
				if not seen[ni] and templateKey(ni) == zone and cells[ni] == from then
					seen[ni] = true
					table.insert(queue, { nc, nr })
				end
			end
		end
	end
	return true
end

local function cellAt(position)
	local absPos = canvasFrame.AbsolutePosition
	local absSize = canvasFrame.AbsoluteSize
	if absSize.X <= 0 or absSize.Y <= 0 then
		return nil
	end
	local col = math.floor((position.X - absPos.X) / absSize.X * GRID)
	local row = math.floor((position.Y - absPos.Y) / absSize.Y * GRID)
	if col < 0 or row < 0 or col >= GRID or row >= GRID then
		return nil
	end
	return col, row
end

local function strokeTo(col, row)
	if not lastCell then
		paintBrush(col, row)
	else
		-- Interpola para que los trazos rápidos no dejen huecos.
		local c0, r0 = lastCell[1], lastCell[2]
		local steps = math.max(math.abs(col - c0), math.abs(row - r0))
		for s = 1, steps do
			local t = s / steps
			paintBrush(math.floor(c0 + (col - c0) * t + 0.5), math.floor(r0 + (row - r0) * t + 0.5))
		end
	end
	lastCell = { col, row }
end

local function onPress(position)
	if not current or submitting then
		return
	end
	local col, row = cellAt(position)
	if not col then
		return
	end
	pushUndo()
	if tool == "fill" then
		if floodFill(col, row) then
			Theme.playSound("whoosh", 1.3)
			updateProgress()
		else
			table.remove(undoStack)
		end
		return
	end
	stroking = true
	lastCell = nil
	strokeTo(col, row)
	Theme.playSound("paint", 0.9 + math.random() * 0.3)
	updateProgress()
end

-- Selección de herramientas ---------------------------------------------------------
local function refreshTools()
	for key, button in pairs(paletteButtons) do
		local selected = (key == selectedKey and tool ~= "eraser") or (key == EMPTY and tool == "eraser")
		button.stroke.Thickness = selected and 4 or 0
		button.check.Visible = selected
	end
	for name, button in pairs(toolButtons) do
		button.SetBaseColor(name == tool and C.Pink or C.Primary)
	end
	for size, button in pairs(sizeButtons) do
		if sizeLocked[size] then
			button.SetEnabled(false)
		else
			button.SetBaseColor((size == brushSize and tool ~= "fill") and C.Pink or Color3.fromRGB(150, 130, 200))
		end
	end
	if refs.colorName then
		if tool == "eraser" then
			refs.colorName.Text = "Borrador"
		else
			local entry = Palette.ByKey[selectedKey]
			refs.colorName.Text = entry and (entry.index .. " · " .. entry.name) or ""
		end
	end
	if current then
		refreshAll()
	end
end

local function selectColor(key)
	if key == EMPTY then
		tool = "eraser"
	else
		selectedKey = key
		if tool == "eraser" then
			tool = "brush"
		end
	end
	refreshTools()
end

local function setTool(name)
	tool = name
	refreshTools()
end

-- Construcción de la interfaz ---------------------------------------------------------
local function buildCanvas(parent)
	canvasFrame = Theme.new("Frame", {
		Name = "Canvas",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = GRID_LINE,
		BorderSizePixel = 0,
		Parent = parent,
	})
	for row = 0, GRID - 1 do
		for col = 0, GRID - 1 do
			local i = index(col, row)
			local cell = Theme.new("Frame", {
				Name = "C" .. i,
				Position = UDim2.new(col / GRID, 0, row / GRID, 0),
				Size = UDim2.new(1 / GRID, -1, 1 / GRID, -1),
				BackgroundColor3 = Palette.EmptyColor,
				BorderSizePixel = 0,
				Parent = canvasFrame,
			})
			cellFrames[i] = cell
			numberLabels[i] = Theme.new("TextLabel", {
				Size = UDim2.fromScale(1, 1),
				BackgroundTransparency = 1,
				Font = Theme.Fonts.Bold,
				TextScaled = true,
				TextColor3 = Color3.fromRGB(170, 160, 190),
				Text = "",
				Visible = false,
				Parent = cell,
			}, {
				Theme.new("UITextSizeConstraint", { MaxTextSize = 14 }),
				Theme.new("UIPadding", {
					PaddingTop = UDim.new(0.2, 0),
					PaddingBottom = UDim.new(0.2, 0),
				}),
			})
		end
	end
	catcher = Theme.new("TextButton", {
		Name = "Input",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 5,
		Parent = canvasFrame,
	})
	catcher.InputBegan:Connect(function(input)
		if
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			onPress(input.Position)
		end
	end)
end

local function buildPalette(parent)
	local grid = Theme.new("Frame", {
		Name = "Palette",
		Size = UDim2.fromScale(1, 0.5),
		BackgroundTransparency = 1,
		Parent = parent,
	}, {
		Theme.new("UIGridLayout", {
			CellSize = UDim2.new(1 / 3, -6, 1 / 6, -6),
			CellPadding = UDim2.fromOffset(6, 6),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	local entries = {}
	for _, entry in ipairs(Palette.List) do
		table.insert(entries, entry)
	end
	table.insert(entries, { key = EMPTY, name = "Borrador", color = Color3.fromRGB(255, 255, 255), index = 99 })

	for order, entry in ipairs(entries) do
		local button = Theme.new("TextButton", {
			Name = entry.key,
			BackgroundColor3 = entry.color,
			AutoButtonColor = false,
			Text = "",
			LayoutOrder = order,
			Parent = grid,
		}, { Theme.corner(10) })
		local stroke = Theme.stroke(C.Ink, 0)
		stroke.Parent = button
		Theme.stroke(Color3.fromRGB(0, 0, 0), 1, 0.85).Parent = button
		local isLight = entry.color.R * 0.3 + entry.color.G * 0.59 + entry.color.B * 0.11 > 0.6
		Theme.label({
			Size = UDim2.fromScale(1, 1),
			Text = entry.key == EMPTY and "🧽" or tostring(entry.index),
			Font = Theme.Fonts.Title,
			TextColor3 = isLight and C.Ink or Color3.new(1, 1, 1),
			MaxTextSize = 22,
			Parent = button,
		}, nil)
		local check = Theme.new("Frame", {
			Size = UDim2.fromOffset(12, 12),
			Position = UDim2.new(1, -6, 0, -6),
			BackgroundColor3 = C.Pink,
			Visible = false,
			ZIndex = 3,
			Parent = button,
		}, { Theme.corner(6), Theme.stroke(Color3.new(1, 1, 1), 2) })
		button.Activated:Connect(function()
			Theme.playSound("click", 1.2)
			selectColor(entry.key)
		end)
		paletteButtons[entry.key] = { stroke = stroke, check = check }
	end
end

