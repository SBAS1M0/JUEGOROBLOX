	})

	-- 2. Precio.
	refs.priceSection = Theme.new("Frame", {
		Position = UDim2.fromOffset(0, 160),
		Size = UDim2.new(1, 0, 0, 300),
		BackgroundTransparency = 1,
		Parent = column,
	})
	refs.priceTitle = sectionTitle(refs.priceSection, "2. Ponle tu precio", 0)
	refs.market = Theme.label({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.fromOffset(230, 26),
		BackgroundColor3 = C.PrimaryLight,
		BackgroundTransparency = 0,
		Text = "",
		Font = Theme.Fonts.Heavy,
		TextColor3 = C.PrimaryDark,
		MaxTextSize = 16,
		Parent = refs.priceSection,
	})
	Theme.round().Parent = refs.market
	local _, priceCard = Theme.card({
		Position = UDim2.fromOffset(0, 34),
		Size = UDim2.new(1, 0, 0, 76),
		Radius = 16,
		Parent = refs.priceSection,
	})
	local function stepButton(text, x, anchor, sign)
		Theme.button({
			AnchorPoint = Vector2.new(anchor, 0.5),
			Position = UDim2.new(x, anchor == 0 and 10 or -10, 0.5, 0),
			Size = UDim2.fromOffset(56, 52),
			Text = text,
			Variant = "navy",
			Radius = 14,
			MaxTextSize = 28,
			Parent = priceCard,
			OnClick = function()
				local painting = currentPainting()
				setPrice(price + sign * Exhibition.priceStep(marketOf(painting)))
			end,
		})
	end
	stepButton("−", 0, 0, -1)
	stepButton("+", 1, 1, 1)
	refs.price = Theme.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 6),
		Size = UDim2.new(1, -150, 0, 42),
		Text = "",
		Font = Theme.Fonts.Display,
		TextColor3 = C.Ink,
		MaxTextSize = 38,
		Parent = priceCard,
	})
	refs.percent = Theme.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 48),
		Size = UDim2.new(1, -150, 0, 18),
		Text = "",
		Font = Theme.Fonts.Bold,
		TextColor3 = C.InkSoft,
		MaxTextSize = 14,
		Parent = priceCard,
	})
	-- Atajos de precio.
	local presets = Theme.new("Frame", {
		Position = UDim2.fromOffset(0, 120),
		Size = UDim2.new(1, 0, 0, 38),
		BackgroundTransparency = 1,
		Parent = refs.priceSection,
	}, { Theme.list("h", 8) })
	for i, preset in ipairs({
		{ "Rápido −15%", 0.85 },
		{ "Precio medio", 1 },
		{ "+25%", 1.25 },
		{ "+50%", 1.5 },
	}) do
		Theme.button({
			Size = UDim2.new(0.25, -6, 1, 0),
			Text = preset[1],
			Variant = "ghost",
			Radius = 12,
			Depth = 3,
			MaxTextSize = 15,
			LayoutOrder = i,
			Parent = presets,
			OnClick = function()
				setPrice(Exhibition.roundPrice(marketOf(currentPainting()) * preset[2]))
			end,
		})
	end
	-- Medidor: de ganga a carísimo.
	local meter = Theme.new("Frame", {
		Position = UDim2.fromOffset(4, 176),
		Size = UDim2.new(1, -8, 0, 14),
		BackgroundTransparency = 1,
		Parent = refs.priceSection,
	})
	local from = METER_MIN
	for i, band in ipairs(Exhibition.PriceBands) do
		local to = math.min(band.max, METER_MAX)
		local a, b = ratioToMeter(from), ratioToMeter(to)
		Theme.new("Frame", {
			Position = UDim2.fromScale(a, 0),
			Size = UDim2.new(b - a, i < #Exhibition.PriceBands and -2 or 0, 1, 0),
			BackgroundColor3 = band.color,
			Parent = meter,
		}, { Theme.corner(5) })
		from = to
	end
	refs.marker = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.33, 0.5),
		Size = UDim2.fromOffset(26, 26),
		BackgroundTransparency = 1,
		ZIndex = 3,
		Parent = meter,
	})
	refs.markerDot = Theme.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = C.Primary,
		ZIndex = 3,
		Parent = refs.marker,
	}, { Theme.round(), Theme.stroke(C.White, 4) })
	Theme.label({
		Position = UDim2.fromOffset(0, 196),
		Size = UDim2.new(0.5, 0, 0, 16),
		Text = "Ganga",
		Font = Theme.Fonts.Bold,
		TextColor3 = C.InkFaint,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 13,
		Parent = refs.priceSection,
	})
	Theme.label({
		Position = UDim2.new(0.5, 0, 0, 196),
		Size = UDim2.new(0.5, 0, 0, 16),
		Text = "Carísimo",
		Font = Theme.Fonts.Bold,
		TextColor3 = C.InkFaint,
		TextXAlignment = Enum.TextXAlignment.Right,
		MaxTextSize = 13,
		Parent = refs.priceSection,
	})
	refs.bandText = Theme.label({
		Position = UDim2.fromOffset(0, 214),
		Size = UDim2.new(1, 0, 0, 22),
		Text = "",
		Font = Theme.Fonts.Heavy,
		MaxTextSize = 18,
		Parent = refs.priceSection,
	})
	refs.interest = Theme.label({
		Position = UDim2.fromOffset(0, 236),
		Size = UDim2.new(1, 0, 0, 18),
		Text = "",
		Font = Theme.Fonts.Medium,
		TextColor3 = C.InkSoft,
		MaxTextSize = 14,
		Parent = refs.priceSection,
	})
	refs.primary = Theme.button({
		Position = UDim2.fromOffset(0, 258),
		Size = UDim2.new(1, 0, 0, 52),
		Text = "",
		Variant = "primary",
		Radius = 14,
		MaxTextSize = 21,
		Parent = refs.priceSection,
		OnClick = primaryAction,
	})
end

-- API ------------------------------------------------------------------------------------------------
function StandPanel.open(index)
	local s = state()
	if not (window and s and Exhibition.Spots[index]) then
		return
	end
	spot = index
	selected = 1
	previewKey, storageKey = nil, nil
	local painting = currentPainting()
	local onStand = entryOnStand()
	price = onStand and onStand.p or marketOf(painting)
	window.Open()
	StandPanel.refresh()
end

function StandPanel.close()
	if window then
		window.Close()
	end
	spot = nil
end

function StandPanel.isOpen()
	return window ~= nil and window.Holder.Visible
end

function StandPanel.init(appRef)
	app = appRef
	local gui = Theme.new("ScreenGui", {
		Name = "StandPanel",
		ResetOnSpawn = false,
		DisplayOrder = 14,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = Players.LocalPlayer:WaitForChild("PlayerGui"),
	})
	window = Theme.window({
		Name = "Window",
		Parent = gui,
		Size = UDim2.fromOffset(860, 580),
		Title = "Stand",
		Icon = "🖼️",
		Accent = "gold",
		OnClose = StandPanel.close,
	})
	buildLeft(window.Body)
	buildRight(window.Body)
end

return StandPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="33">
            <Properties>
              <string name="Name">Theme</string>
              <string name="Source"><![CDATA[-- Sistema de diseño de la interfaz: colores, tipografías y componentes
-- (botones con relieve, tarjetas, ventanas, barras, insignias). Estilo de
-- "estudio de arte": crema, azul tinta y acentos turquesa, ámbar y coral.

local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Theme = {}

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

-- Paleta "estudio": crema y azul tinta, con acentos turquesa, ámbar y coral.
Theme.Colors = {
	Bg = rgb(250, 246, 238),
	Panel = rgb(255, 255, 255),
	PanelSoft = rgb(247, 242, 233),
	Border = rgb(234, 225, 210),
	Ink = rgb(34, 42, 66),
	InkSoft = rgb(104, 110, 130),
	InkFaint = rgb(166, 168, 180),
	Navy = rgb(38, 50, 84),
	NavyDark = rgb(26, 35, 62),
	Primary = rgb(18, 168, 148),
	PrimaryDark = rgb(10, 128, 112),
	PrimaryLight = rgb(218, 246, 240),
	Pink = rgb(246, 112, 90),
	PinkLight = rgb(255, 232, 226),
	Coral = rgb(246, 112, 90),
	Mint = rgb(52, 188, 116),
	MintDark = rgb(28, 140, 82),
	MintLight = rgb(224, 247, 234),
	Gold = rgb(250, 176, 40),
	GoldDark = rgb(198, 124, 10),
	GoldLight = rgb(255, 244, 214),
	Red = rgb(236, 86, 76),
	RedLight = rgb(255, 230, 226),
	Orange = rgb(244, 140, 50),
	Blue = rgb(64, 140, 240),
	Purple = rgb(130, 96, 220),
	Shadow = rgb(20, 24, 40),
	White = rgb(255, 255, 255),
}
local C = Theme.Colors

-- Degradados de los botones y fichas (de arriba a abajo).
Theme.Gradients = {
	primary = { rgb(40, 196, 172), rgb(14, 156, 138) },
	mint = { rgb(84, 214, 140), rgb(40, 172, 104) },
	gold = { rgb(255, 204, 74), rgb(244, 160, 24) },
	red = { rgb(255, 136, 112), rgb(236, 92, 74) },
	coral = { rgb(255, 136, 112), rgb(236, 92, 74) },
	blue = { rgb(96, 166, 255), rgb(52, 124, 232) },
	purple = { rgb(156, 124, 240), rgb(118, 86, 212) },
	pink = { rgb(255, 136, 112), rgb(236, 92, 74) },
	orange = { rgb(255, 176, 86), rgb(240, 128, 40) },
	navy = { rgb(60, 76, 120), rgb(36, 48, 84) },
	dark = { rgb(60, 76, 120), rgb(36, 48, 84) },
	gray = { rgb(214, 212, 206), rgb(192, 190, 184) },
}

Theme.Fonts = {
	Display = Enum.Font.FredokaOne,
	Heavy = Enum.Font.BuilderSansExtraBold,
	Bold = Enum.Font.BuilderSansBold,
	Medium = Enum.Font.BuilderSansMedium,
	Body = Enum.Font.BuilderSans,
	Title = Enum.Font.FredokaOne,
}

local function darker(color, amount)
	return color:Lerp(Color3.new(0, 0, 0), amount or 0.22)
end
Theme.darker = darker

-- Instancias ----------------------------------------------------------------------------------
function Theme.new(className, props, children)
	local instance = Instance.new(className)
	if props then
		for key, value in pairs(props) do
			if key ~= "Parent" then
				instance[key] = value
			end
		end
	end
	if children then
		for _, child in ipairs(children) do
			child.Parent = instance
		end
	end
	if props and props.Parent then
		instance.Parent = props.Parent
	end
	return instance
end

function Theme.corner(radius)
	return Theme.new("UICorner", { CornerRadius = UDim.new(0, radius or 14) })
end

function Theme.round()
	return Theme.new("UICorner", { CornerRadius = UDim.new(0.5, 0) })
end

function Theme.stroke(color, thickness, transparency)
	return Theme.new("UIStroke", {
		Color = color or C.Border,
		Thickness = thickness or 2,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function Theme.textStroke(color, thickness, transparency)
	return Theme.new("UIStroke", {
		Color = color or C.Ink,
		Thickness = thickness or 2,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
	})
end

function Theme.padding(all, horizontal)
	local v = UDim.new(0, all)
	local h = UDim.new(0, horizontal or all)
	return Theme.new("UIPadding", { PaddingTop = v, PaddingBottom = v, PaddingLeft = h, PaddingRight = h })
end

function Theme.gradient(a, b, rotation)
	if type(a) == "string" then
		local pair = Theme.Gradients[a]
		return Theme.new("UIGradient", { Color = ColorSequence.new(pair[1], pair[2]), Rotation = b or 90 })
	end
	return Theme.new("UIGradient", { Color = ColorSequence.new(a, b), Rotation = rotation or 90 })
end

function Theme.list(direction, padding, hAlign, vAlign)
	return Theme.new("UIListLayout", {
		FillDirection = direction == "h" and Enum.FillDirection.Horizontal or Enum.FillDirection.Vertical,
		Padding = UDim.new(0, padding or 8),
		HorizontalAlignment = hAlign or Enum.HorizontalAlignment.Left,
		VerticalAlignment = vAlign or Enum.VerticalAlignment.Top,
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
end

-- Texto con tamaño automático y límite de tamaño.
function Theme.label(props)
	local defaults = {
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Bold,
		TextColor3 = C.Ink,
		TextScaled = true,
		TextWrapped = true,
		Text = "",
	}
	for key, value in pairs(props) do
		if key ~= "MaxTextSize" then
			defaults[key] = value
		end
	end
	local label = Theme.new("TextLabel", defaults)
	if label.TextScaled then
		Theme.new("UITextSizeConstraint", { MaxTextSize = props.MaxTextSize or 32, Parent = label })
	end
	return label
end

-- Tarjeta blanca con sombra suave. Devuelve el contenedor y el cuerpo.
function Theme.card(props)
	local holder = Theme.new("Frame", {
		Name = props.Name or "Card",
		Size = props.Size or UDim2.fromOffset(200, 100),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.new(),
		BackgroundTransparency = 1,
		LayoutOrder = props.LayoutOrder or 0,
		Visible = props.Visible ~= false,
		Parent = props.Parent,
	})
	local radius = props.Radius or 16
	Theme.new("Frame", {
		Name = "Shadow",
		Position = UDim2.fromOffset(0, props.ShadowOffset or 4),
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = C.Shadow,
		BackgroundTransparency = props.ShadowTransparency or 0.88,
		Parent = holder,
	}, { Theme.corner(radius) })
	local body = Theme.new("Frame", {
		Name = "Body",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = props.Color or C.Panel,
		BackgroundTransparency = props.Transparency or 0,
		Parent = holder,
	}, { Theme.corner(radius) })
	if props.Stroke ~= false then
		Theme.stroke(props.StrokeColor or C.Border, props.StrokeThickness or 1.5).Parent = body
	end
	return holder, body
end

-- Botones con relieve: una cara con degradado sobre un "labio" más oscuro que
-- se hunde al pulsar. Variant: primary, mint, gold, coral, blue, navy, ghost.
function Theme.button(props)
	local variant = props.Variant or (props.Soft and "ghost") or "primary"
	local radius = props.Radius or 14
	local depth = props.Depth or 4
	local holder = Theme.new("Frame", {
		Name = props.Name or "Button",
		Size = props.Size or UDim2.fromOffset(160, 48),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.new(),
		BackgroundTransparency = 1,
		LayoutOrder = props.LayoutOrder or 0,
		ZIndex = props.ZIndex or 1,
		Parent = props.Parent,
	})
	local lip = Theme.new("Frame", {
		Name = "Shadow",
		Position = UDim2.fromOffset(0, depth),
		Size = UDim2.new(1, 0, 1, -depth),
		BackgroundColor3 = C.Navy,
		ZIndex = holder.ZIndex,
		Parent = holder,
	}, { Theme.corner(radius) })
	local button = Theme.new("TextButton", {
		Name = "Face",
		Size = UDim2.new(1, 0, 1, -depth),
		BackgroundColor3 = C.White,
		AutoButtonColor = false,
		Font = props.Font or Theme.Fonts.Heavy,
		Text = props.Text or "",
		TextColor3 = C.White,
		TextScaled = true,
		ZIndex = holder.ZIndex + 1,
		Parent = holder,
	}, {
		Theme.corner(radius),
		Theme.new("UIPadding", {
			PaddingTop = UDim.new(0.2, 0),
			PaddingBottom = UDim.new(0.2, 0),
			PaddingLeft = UDim.new(0, 10),
			PaddingRight = UDim.new(0, 10),
		}),
		Theme.new("UITextSizeConstraint", { MaxTextSize = props.MaxTextSize or 22 }),
	})
	local gradient = Theme.new("UIGradient", { Rotation = 90, Parent = button })
	local border = Theme.stroke(C.Border, 0)
	border.Parent = button
	local textStroke = Theme.textStroke(C.Shadow, 1.2, 0.8)
	textStroke.Parent = button

	local enabled = true
	local function paint()
		local v = enabled and variant or "gray"
		if v == "ghost" then
			gradient.Color = ColorSequence.new(C.White, C.PanelSoft)
			lip.BackgroundColor3 = C.Border
			button.TextColor3 = props.TextColor or C.Ink
			border.Color = props.Color or C.Border
			border.Thickness = 1.5
			textStroke.Transparency = 1
		else
			local pair = Theme.Gradients[v] or Theme.Gradients.primary
			gradient.Color = ColorSequence.new(pair[1], pair[2])
			lip.BackgroundColor3 = darker(pair[2], 0.25)
			button.TextColor3 = C.White
			border.Thickness = 0
			textStroke.Transparency = v == "gray" and 1 or 0.8
		end
		button.TextTransparency = enabled and 0 or 0.15
	end
	paint()

	local function press(down)
		button.Position = UDim2.fromOffset(0, down and depth - 1 or 0)
	end
	local scale = Theme.new("UIScale", { Name = "Interact", Parent = holder })
	button.MouseEnter:Connect(function()
		if enabled then
			Theme.tween(scale, 0.12, { Scale = 1.03 })
		end
	end)
	button.MouseLeave:Connect(function()
		Theme.tween(scale, 0.12, { Scale = 1 })
		press(false)
	end)
	button.MouseButton1Down:Connect(function()
		if enabled then
			press(true)
		end
	end)
	button.MouseButton1Up:Connect(function()
		press(false)
	end)

	local api = { Holder = holder, Button = button, Shadow = lip }
	function api.SetEnabled(value)
		enabled = value
		button.Active = value
		paint()
	end
	function api.SetVariant(newVariant)
		variant = newVariant
		paint()
	end
	function api.SetText(text)
		button.Text = text
	end
	if props.OnClick then
		button.Activated:Connect(function()
			if enabled then
				Theme.playSound("click")
				props.OnClick()
			end
		end)
	end
	return api
end

-- Ficha cuadrada del menú lateral (icono + texto) con relieve e insignia.
function Theme.tile(props)
	local pair = Theme.Gradients[props.Gradient or "navy"] or Theme.Gradients.navy
	local holder = Theme.new("Frame", {
		Name = props.Name or "Tile",
		Size = props.Size or UDim2.fromOffset(64, 64),
		BackgroundTransparency = 1,
		LayoutOrder = props.LayoutOrder or 0,
		Parent = props.Parent,
	})
	Theme.new("Frame", {
		Name = "Lip",
		Size = UDim2.new(1, 0, 1, -4),
		Position = UDim2.fromOffset(0, 4),
		BackgroundColor3 = darker(pair[2], 0.3),
		Parent = holder,
	}, { Theme.corner(16) })
	local face = Theme.new("TextButton", {
		Name = "Face",
		Size = UDim2.new(1, 0, 1, -4),
		BackgroundColor3 = C.White,
		AutoButtonColor = false,
		Text = "",
		Parent = holder,
	}, {
		Theme.corner(16),
		Theme.gradient(pair[1], pair[2], 90),
		Theme.stroke(C.White, 1.5, 0.55),
	})
	Theme.label({
		Name = "Icon",
		Size = UDim2.new(1, 0, 0.56, 0),
		Position = UDim2.fromScale(0, 0.06),
		Text = props.Icon,
		Font = Theme.Fonts.Bold,
		MaxTextSize = props.IconSize or 28,
		Parent = face,
	})
	local caption = Theme.label({
		Name = "Caption",
		Size = UDim2.new(1, -6, 0.26, 0),
		Position = UDim2.new(0, 3, 0.64, 0),
		Text = props.Text,
		Font = Theme.Fonts.Heavy,
		TextColor3 = C.White,
		MaxTextSize = 13,
		Parent = face,
	})
	Theme.textStroke(C.Shadow, 1.2, 0.6).Parent = caption
	local badge = Theme.new("Frame", {
		Name = "Badge",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -4, 0, 4),
		Size = UDim2.fromOffset(20, 20),
		BackgroundColor3 = C.Red,
		Visible = false,
		ZIndex = 5,
		Parent = holder,
	}, { Theme.round(), Theme.stroke(C.White, 2) })
	local badgeText = Theme.label({
		Size = UDim2.fromScale(1, 1),
		Text = "!",
		Font = Theme.Fonts.Heavy,
		TextColor3 = C.White,
		MaxTextSize = 12,
		ZIndex = 6,
		Parent = badge,
	})
	local ring = Theme.stroke(C.White, 0)
	ring.Parent = face
	local scale = Theme.new("UIScale", { Name = "Interact", Parent = holder })
	face.MouseEnter:Connect(function()
		Theme.tween(scale, 0.12, { Scale = 1.06 })
	end)
	face.MouseLeave:Connect(function()
		Theme.tween(scale, 0.12, { Scale = 1 })
		face.Position = UDim2.new()
	end)
	face.MouseButton1Down:Connect(function()
		face.Position = UDim2.fromOffset(0, 3)
	end)
	face.MouseButton1Up:Connect(function()
		face.Position = UDim2.new()
	end)
	if props.OnClick then
		face.Activated:Connect(function()
			Theme.playSound("click")
			props.OnClick()
		end)
	end
	local api = { Holder = holder, Button = face, Caption = caption }
	function api.SetBadge(value)
		if value == nil or value == false or value == 0 then
			badge.Visible = false
		else
			badge.Visible = true
			badgeText.Text = value == true and "!" or tostring(value)
		end
	end
	function api.SetActive(active)
		ring.Thickness = active and 3 or 0
		ring.Color = C.White
	end
	return api
end

-- Barra de progreso con degradado.
function Theme.progress(props)
	local track = Theme.new("Frame", {
		Name = props.Name or "Progress",
		Size = props.Size or UDim2.new(1, 0, 0, 10),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.new(),
		BackgroundColor3 = props.TrackColor or rgb(236, 229, 216),
		LayoutOrder = props.LayoutOrder or 0,
		ZIndex = props.ZIndex or 1,
		Parent = props.Parent,
	}, { Theme.round() })
	local fill = Theme.new("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = C.White,
		ZIndex = track.ZIndex,
		Parent = track,
	}, { Theme.round() })
	local fillGradient = Theme.gradient(props.Gradient or "primary", 0)
	fillGradient.Parent = fill
	local api = { Frame = track, Fill = fill }
	function api.Set(fraction, animate)
		fraction = math.clamp(fraction or 0, 0, 1)
		local target = UDim2.fromScale(fraction, 1)
		if animate then
			Theme.tween(fill, 0.35, { Size = target })
		else
			fill.Size = target
		end
		fill.Visible = fraction > 0.001
	end
	function api.SetGradient(name)
		local pair = Theme.Gradients[name]
		fillGradient.Color = ColorSequence.new(pair[1], pair[2])
	end
	return api
end

-- Etiqueta en forma de píldora.
function Theme.chip(props)
	local chip = Theme.new("Frame", {
		Name = props.Name or "Chip",
		Size = props.Size or UDim2.fromOffset(100, 26),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.new(),
		BackgroundColor3 = props.Color or C.PrimaryLight,
		LayoutOrder = props.LayoutOrder or 0,
		Visible = props.Visible ~= false,
		ZIndex = props.ZIndex or 1,
		Parent = props.Parent,
	}, { Theme.round() })
	local label = Theme.label({
		Size = UDim2.fromScale(1, 1),
		Text = props.Text or "",
		Font = Theme.Fonts.Heavy,
		TextColor3 = props.TextColor or props.TextColor3 or C.PrimaryDark,
		MaxTextSize = props.MaxTextSize or 15,
		ZIndex = chip.ZIndex,
		Parent = chip,
	})
	Theme.new("UIPadding", {
		PaddingLeft = UDim.new(0, 8),
		PaddingRight = UDim.new(0, 8),
		PaddingTop = UDim.new(0.15, 0),
		PaddingBottom = UDim.new(0.15, 0),
		Parent = label,
	})
	return chip, label
end

-- Ventana modal: cabecera azul tinta con icono y título, cuerpo crema -----------------------
function Theme.window(props)
	local holder = Theme.new("Frame", {
		Name = props.Name or "Window",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = props.Parent,
	})
	local dim = Theme.new("TextButton", {
		Name = "Dim",
		Position = UDim2.fromOffset(0, -80),
		Size = UDim2.new(1, 0, 1, 80),
		BackgroundColor3 = C.Shadow,
		BackgroundTransparency = 0.5,
		Text = "",
		AutoButtonColor = false,
		Parent = holder,
	})
	local wrapper = Theme.new("Frame", {
		Name = "Wrapper",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = props.Size or UDim2.fromOffset(900, 560),
		BackgroundTransparency = 1,
		Parent = holder,
	})
	local panelCard, panel = Theme.card({
		Name = "PanelCard",
		Size = UDim2.fromScale(1, 1),
		Radius = 22,
		Color = C.Bg,
		ShadowOffset = 8,
		ShadowTransparency = 0.7,
		StrokeColor = C.Navy,
		StrokeThickness = 3,
		Parent = wrapper,
	})
	panel.Name = "Panel"
	local header = Theme.new("Frame", {
		Name = "Header",
		Size = UDim2.new(1, 0, 0, 74),
		BackgroundColor3 = C.White,
		Parent = panel,
	}, { Theme.corner(22), Theme.gradient(Theme.Gradients.navy[1], Theme.Gradients.navy[2], 90) })
	-- Tapa las esquinas inferiores redondeadas de la cabecera.
	Theme.new("Frame", {
		Position = UDim2.new(0, 0, 1, -22),
		Size = UDim2.new(1, 0, 0, 22),
		BackgroundColor3 = C.White,
		BorderSizePixel = 0,
		Parent = header,
	}, { Theme.gradient(Theme.Gradients.navy[1]:Lerp(Theme.Gradients.navy[2], 0.7), Theme.Gradients.navy[2], 90) })
	local accent = Theme.Gradients[props.Accent or "primary"] or Theme.Gradients.primary
	local badge = Theme.new("Frame", {
		Name = "IconBadge",
		Position = UDim2.fromOffset(18, 13),
		Size = UDim2.fromOffset(48, 48),
		BackgroundColor3 = C.White,
		Visible = props.Icon ~= nil,
		Parent = header,
	}, { Theme.corner(14), Theme.gradient(accent[1], accent[2], 90), Theme.stroke(C.White, 2, 0.5) })
	Theme.label({ Size = UDim2.fromScale(1, 1), Text = props.Icon or "", MaxTextSize = 28, Parent = badge })
	local textX = props.Icon and 78 or 24
	local title = Theme.label({
		Name = "Title",
		Size = UDim2.new(1, -textX - 80, 0, 32),
		Position = UDim2.fromOffset(textX, 10),
		Text = props.Title or "",
		Font = Theme.Fonts.Display,
		TextColor3 = C.White,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 30,
		Parent = header,
	})
	local subtitle = Theme.label({
		Name = "Subtitle",
		Size = UDim2.new(1, -textX - 80, 0, 18),
		Position = UDim2.fromOffset(textX, 44),
		Text = props.Subtitle or "",
		Font = Theme.Fonts.Medium,
		TextColor3 = C.White,
		TextTransparency = 0.25,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 15,
		Parent = header,
	})
	Theme.new("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -18, 0, 40),
		Size = UDim2.fromOffset(40, 40),
		BackgroundColor3 = darker(C.Coral, 0.3),
		Parent = header,
	}, { Theme.round() })
	local close = Theme.new("TextButton", {
		Name = "Close",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -18, 0, 37),
		Size = UDim2.fromOffset(40, 40),
		BackgroundColor3 = C.White,
		Font = Theme.Fonts.Heavy,
		Text = "✕",
		TextScaled = true,
		TextColor3 = C.White,
		AutoButtonColor = true,
		Parent = header,
	}, { Theme.round(), Theme.padding(11), Theme.gradient(Theme.Gradients.coral[1], Theme.Gradients.coral[2], 90) })
	local body = Theme.new("Frame", {
		Name = "Body",
		Position = UDim2.fromOffset(0, 74),
		Size = UDim2.new(1, 0, 1, -74),
		BackgroundTransparency = 1,
		Parent = panel,
	})

	local api = {
		Holder = holder,
		Panel = panel,
		Body = body,
		Header = header,
		Wrapper = wrapper,
		Title = title,
		Subtitle = subtitle,
		Close = close,
	}
	function api.Open()
		holder.Visible = true
		dim.BackgroundTransparency = 1
		Theme.tween(dim, 0.2, { BackgroundTransparency = 0.5 })
		Theme.pop(panelCard, 0.9)
		Theme.playSound("whoosh", 1.1)
	end
	function api.Close()
		holder.Visible = false
	end
	local function requestClose()
		Theme.playSound("click")
		if props.OnClose then
			props.OnClose()
		else
			api.Close()
		end
	end
	close.Activated:Connect(requestClose)
	if not props.Modal then
		dim.Activated:Connect(requestClose)
	end
	local function updateScale()
		local camera = workspace.CurrentCamera
		if not camera then
			return
		end
		local size = wrapper.Size
		local viewport = camera.ViewportSize
		local scale = math.min((viewport.X - 24) / size.X.Offset, (viewport.Y - 70) / size.Y.Offset)
		local uiScale = wrapper:FindFirstChild("ViewportScale")
			or Theme.new("UIScale", { Name = "ViewportScale", Parent = wrapper })
		uiScale.Scale = math.clamp(scale, 0.4, 1.1)
	end
	updateScale()
	if workspace.CurrentCamera then
		workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
	end
	api.UpdateScale = updateScale
	return api
end

-- Mayúsculas que respetan tildes y eñes (string.upper solo cambia ASCII).
local ACCENTS =
	{ ["á"] = "Á", ["é"] = "É", ["í"] = "Í", ["ó"] = "Ó", ["ú"] = "Ú", ["ñ"] = "Ñ", ["ü"] = "Ü" }
function Theme.upper(text)
	local result = string.upper(text)
	for lower, upper in pairs(ACCENTS) do
		result = string.gsub(result, lower, upper)
	end
	return result
end

-- Animaciones ---------------------------------------------------------------------------------
function Theme.tween(instance, time, props, style, direction)
	local tween = TweenService:Create(
		instance,
		TweenInfo.new(time, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out),
		props
	)
	tween:Play()
	return tween
end

-- Igual que pop pero para tarjetas (cuerpo y sombra crecen juntos).
function Theme.popCard(holder, scale)
	for _, name in ipairs({ "Body", "Shadow" }) do
		local part = holder:FindFirstChild(name)
		if part then
			Theme.pop(part, scale)
		end
	end
end

function Theme.pop(guiObject, scale)
	local uiScale = guiObject:FindFirstChild("PopScale")
	if not uiScale then
		uiScale = Theme.new("UIScale", { Name = "PopScale", Parent = guiObject })
	end
	uiScale.Scale = scale or 0.6
	Theme.tween(uiScale, 0.32, { Scale = 1 }, Enum.EasingStyle.Back)
end

-- Formato ---------------------------------------------------------------------------------------
local function trimZero(text)
	local cleaned = string.gsub(text, "%.0$", "")
	return cleaned
end

function Theme.formatNumber(n)
	n = math.floor(n or 0)
	local abs = math.abs(n)
	if abs >= 1e9 then
		return trimZero(string.format("%.1f", n / 1e9)) .. "B"
	elseif abs >= 1e6 then
		return trimZero(string.format("%.1f", n / 1e6)) .. "M"
	elseif abs >= 1e4 then
		return trimZero(string.format("%.1f", n / 1e3)) .. "K"
	end
	local formatted = tostring(n)
	while true do
		local replaced, count = string.gsub(formatted, "^(-?%d+)(%d%d%d)", "%1.%2")
		formatted = replaced
		if count == 0 then
			break
		end
	end
	return formatted
end

function Theme.formatTime(seconds)
	seconds = math.max(0, math.floor(seconds))
	local h = math.floor(seconds / 3600)
	local m = math.floor(seconds % 3600 / 60)
	if h > 0 then
		return string.format("%dh %02dm", h, m)
	end
	return string.format("%dm %02ds", m, seconds % 60)
end

-- Sonidos ---------------------------------------------------------------------------------------
-- Sonidos incluidos en el cliente de Roblox (no requieren subir audio).
local SOUND_IDS = {
	click = "rbxasset://sounds/button.wav",
	paint = "rbxasset://sounds/clickfast.wav",
	success = "rbxasset://sounds/electronicpingshort.wav",
	whoosh = "rbxasset://sounds/swoosh.wav",
}
local SOUND_VOLUME = { click = 0.35, paint = 0.12, success = 0.55, whoosh = 0.35 }
local soundCache = {}
Theme.soundsEnabled = true

function Theme.playSound(name, pitch)
	if not Theme.soundsEnabled then
		return
	end
	local id = SOUND_IDS[name]
	if not id then
		return
	end
	local sound = soundCache[name]
	if not sound then
		sound = Instance.new("Sound")
		sound.SoundId = id
		sound.Volume = SOUND_VOLUME[name] or 0.5
		sound.Parent = SoundService
		soundCache[name] = sound
	end
	sound.PlaybackSpeed = pitch or 1
	SoundService:PlayLocalSound(sound)
end

return Theme
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="34">
            <Properties>
              <string name="Name">Tutorial</string>
              <string name="Source"><![CDATA[-- Tutorial guiado: un panel con la guía (paso, instrucción, progreso y botón
-- para saltarlo) y, en el mundo, un camino luminoso desde tu personaje hasta
-- el objetivo, que además se resalta con una flecha flotante.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)

local Theme = require(script.Parent.Theme)

local Tutorial = {}

local C = Theme.Colors
local player = Players.LocalPlayer

local STEP_TITLES = {
	"La máquina de colores",
	"Tu mesa de dibujo",
	"¡A pintar!",
	"La sala de exposición",
	"Tu primera venta",
}
local ARROW_TEXT = { "¡Tira aquí!", "¡Pinta aquí!", nil, "¡Expón aquí!", "¡La caja!" }

local app
local gui
local refs = {}
local highlight
local arrow
local arrowLabel
local beam
local fromAttachment
local toAttachment
local currentTarget
local lastStep = nil

local function myPlot()
	local plotName = app.state and app.state.plotName or ""
	local plots = Workspace:FindFirstChild("Plots")
	return plots and plotName ~= "" and plots:FindFirstChild(plotName) or nil
end

-- Devuelve el modelo a resaltar y la pieza sobre la que va la flecha.
local function findTarget(name)
	local plot = myPlot()
	if not plot then
		return nil, nil
	end
	local workshop = plot:FindFirstChild("Workshop")
	local gallery = plot:FindFirstChild("Gallery")
	if name == "machine" then
		local machine = workshop and workshop:FindFirstChild("Machine")
		return machine, machine and machine:FindFirstChild("Body")
	elseif name == "easel" then
		local easel = workshop and workshop:FindFirstChild("Easel")
		return easel, easel and easel:FindFirstChild("Canvas")
	elseif name == "freeStand" then
		local spots = gallery and gallery:FindFirstChild("Spots")
		local stands = gallery and gallery:FindFirstChild("Stands")
		if not (spots and stands) then
			return nil, nil
		end
		for i = 1, #spots:GetChildren() do
			local anchor = spots:FindFirstChild("Spot" .. i)
			if
				anchor
				and anchor:GetAttribute("Open")
				and anchor:GetAttribute("Owned")
				and not anchor:GetAttribute("HasPainting")
			then
				return stands:FindFirstChild("Stand" .. i), anchor
			end
		end
	elseif name == "caja" then
		local interior = plot:FindFirstChild("GalleryInterior")
		local caja = interior and interior:FindFirstChild("Caja")
		return caja, caja and caja:FindFirstChild("Register")
	end
	return nil, nil
end

local function setWorldTarget(model, anchor, text)
	if model ~= currentTarget then
		currentTarget = model
		highlight.Adornee = model
		highlight.Parent = model
		highlight.Enabled = model ~= nil
	end
	arrow.Adornee = anchor
	arrow.Enabled = anchor ~= nil
	arrowLabel.Text = text or "¡Aquí!"
	-- Camino luminoso desde los pies del personaje hasta el objetivo.
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if anchor and root then
		if fromAttachment.Parent ~= root then
			fromAttachment.Parent = root
		end
		if toAttachment.Parent ~= anchor then
			toAttachment.Parent = anchor
		end
		beam.Parent = anchor
		beam.Enabled = (root.Position - anchor.Position).Magnitude > 8
	else
		beam.Enabled = false
	end
end

function Tutorial.update()
	local state = app.state
	local step = state and state.tutorial or 0
	local def = Config.Tutorial[step]
	local busy = app.isBusy()
	refs.panel.Visible = def ~= nil and not busy
	if def then
		refs.step.Text = "PASO " .. step .. " DE " .. #Config.Tutorial
		refs.title.Text = STEP_TITLES[step] or ""
		local suffix = def.goal > 1 and ("  (" .. (state.tutorialProgress or 0) .. "/" .. def.goal .. ")") or ""
		refs.text.Text = def.text .. suffix
		for i, dot in ipairs(refs.dots) do
			dot.BackgroundColor3 = i < step and C.Mint or (i == step and C.Gold or C.Border)
			dot.Size = UDim2.fromOffset(i == step and 22 or 10, 10)
		end
		if lastStep ~= step then
			lastStep = step
			Theme.popCard(refs.panel, 0.85)
			Theme.playSound("success", 1.4)
		end
	end
	local model, anchor = nil, nil
	if def and def.target and not busy then
		model, anchor = findTarget(def.target)
	end
	setWorldTarget(model, anchor, ARROW_TEXT[step])
end

function Tutorial.applyState()
	if refs.panel then
		Tutorial.update()
	end
end

local function buildPanel()
	gui = Theme.new("ScreenGui", {
		Name = "TutorialGuide",
		ResetOnSpawn = false,
		DisplayOrder = 5,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	local holder, body = Theme.card({
		Name = "Panel",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 62),
		Size = UDim2.fromOffset(500, 92),
		Radius = 22,
		Color = C.Bg,
		StrokeColor = C.Navy,
		StrokeThickness = 2.5,
		Visible = false,
		Parent = gui,
	})
	refs.panel = holder
	local avatar = Theme.new("Frame", {
		Position = UDim2.fromOffset(12, 12),
		Size = UDim2.fromOffset(68, 68),
		BackgroundColor3 = C.White,
		Parent = body,
	}, {
		Theme.round(),
		Theme.gradient(Theme.Gradients.primary[1], Theme.Gradients.primary[2], 90),
		Theme.stroke(C.White, 3),
	})
	Theme.label({ Size = UDim2.fromScale(1, 1), Text = "🧑‍🎨", MaxTextSize = 40, Parent = avatar })
	refs.step = Theme.label({
		Position = UDim2.fromOffset(92, 10),
		Size = UDim2.fromOffset(120, 16),
		Text = "",
		Font = Theme.Fonts.Heavy,
		TextColor3 = C.GoldDark,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 13,
		Parent = body,
	})
	refs.title = Theme.label({
		Position = UDim2.fromOffset(92, 25),
		Size = UDim2.new(1, -190, 0, 24),
		Text = "",
		Font = Theme.Fonts.Display,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 21,
		Parent = body,
	})
	refs.text = Theme.label({
		Position = UDim2.fromOffset(92, 50),
		Size = UDim2.new(1, -104, 0, 22),
		Text = "",
		Font = Theme.Fonts.Bold,
		TextColor3 = C.InkSoft,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 16,
		Parent = body,
	})
	local dots = Theme.new("Frame", {
		Position = UDim2.fromOffset(92, 76),
		Size = UDim2.fromOffset(200, 10),
		BackgroundTransparency = 1,
		Parent = body,
	}, { Theme.list("h", 5, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center) })
	refs.dots = {}
	for i = 1, #Config.Tutorial do
		refs.dots[i] = Theme.new("Frame", {
			Size = UDim2.fromOffset(10, 10),
			BackgroundColor3 = C.Border,
			LayoutOrder = i,
			Parent = dots,
		}, { Theme.round() })
	end
	Theme.button({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 10),
		Size = UDim2.fromOffset(82, 32),
		Text = "Saltar",
		Variant = "ghost",
		Radius = 12,
		Depth = 3,
		MaxTextSize = 14,
		Parent = body,
		OnClick = function()
			app.remotes.SkipTutorial:FireServer()
		end,
	})
	local scale = Theme.new("UIScale", { Name = "ViewportScale", Parent = holder })
	local function updateScale()
		local camera = Workspace.CurrentCamera
		if camera then
			local viewport = camera.ViewportSize
			scale.Scale = math.clamp(math.min(viewport.X / 1280, viewport.Y / 720), 0.6, 1)
		end
	end
	updateScale()
	if Workspace.CurrentCamera then
		Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
	end
end

local function buildWorldMarkers()
	highlight = Instance.new("Highlight")
	highlight.Name = "TutorialHighlight"
	highlight.FillColor = C.Gold
	highlight.FillTransparency = 0.8
	highlight.OutlineColor = C.White
	highlight.OutlineTransparency = 0
	highlight.DepthMode = Enum.HighlightDepthMode.Occluded
	highlight.Enabled = false

	arrow = Theme.new("BillboardGui", {
		Name = "TutorialArrow",
		Size = UDim2.fromOffset(170, 110),
		StudsOffset = Vector3.new(0, 6, 0),
		AlwaysOnTop = true,
		LightInfluence = 0,
		ResetOnSpawn = false,
		Enabled = false,
		Parent = player:WaitForChild("PlayerGui"),
	})
	local bubble = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0),
		Size = UDim2.fromOffset(156, 40),
		BackgroundColor3 = C.White,
		Parent = arrow,
	}, {
		Theme.round(),
		Theme.gradient(Theme.Gradients.gold[1], Theme.Gradients.gold[2], 90),
		Theme.stroke(C.White, 2.5),
	})
	arrowLabel = Theme.label({
		Size = UDim2.new(1, -16, 1, -10),
		Position = UDim2.fromOffset(8, 5),
		Text = "",
		Font = Theme.Fonts.Display,
		TextColor3 = C.White,
		MaxTextSize = 19,
		Parent = bubble,
	})
	Theme.textStroke(C.GoldDark, 1.5, 0.2).Parent = arrowLabel
	local pointer = Theme.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 42),
		Size = UDim2.fromOffset(60, 60),
		Text = "▼",
		Font = Theme.Fonts.Heavy,
		TextColor3 = C.Gold,
		MaxTextSize = 46,
		Parent = arrow,
	})
	Theme.textStroke(C.White, 3).Parent = pointer

	fromAttachment = Instance.new("Attachment")
	fromAttachment.Name = "TutorialFrom"
	fromAttachment.Position = Vector3.new(0, -2.6, 0)
	toAttachment = Instance.new("Attachment")
	toAttachment.Name = "TutorialTo"
	beam = Instance.new("Beam")
	beam.Name = "TutorialPath"
	beam.Attachment0 = fromAttachment
	beam.Attachment1 = toAttachment
	beam.Color = ColorSequence.new(C.Gold, C.Primary)
	beam.Transparency = NumberSequence.new(0.15, 0.35)
	beam.Width0 = 0.9
	beam.Width1 = 0.9
	beam.FaceCamera = true
	beam.LightEmission = 0.6
	beam.Segments = 12
	beam.Enabled = false
end

function Tutorial.init(appRef)
	app = appRef
	buildPanel()
	buildWorldMarkers()
	-- La flecha flota arriba y abajo y el camino parpadea suavemente.
	RunService.RenderStepped:Connect(function()
		local t = os.clock()
		if arrow.Enabled then
			arrow.StudsOffset = Vector3.new(0, 6 + math.sin(t * 4) * 0.6, 0)
		end
		if beam.Enabled then
			local a = 0.15 + 0.2 * (0.5 + 0.5 * math.sin(t * 3))
			beam.Transparency = NumberSequence.new(a, a + 0.2)
		end
	end)
	task.spawn(function()
		while true do
			task.wait(0.4)
			Tutorial.update()
		end
	end)
end

return Tutorial
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">World</string>
            <string name="Source"><![CDATA[-- Parte visual del mundo que se dibuja en el cliente: cuadros de los stands
-- (con su etiqueta de precio), avisos de los huecos libres, caballete del
-- taller y globos de diálogo de los visitantes.

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Colors = require(Shared.Colors)
local Config = require(Shared.Config)
local Designs = require(Shared.Designs)
local Exhibition = require(Shared.Exhibition)

local UI = script.Parent:WaitForChild("UI")
local Theme = require(UI.Theme)
local DesignArt = require(UI.DesignArt)

local World = {}

local C = Theme.Colors
local player = Players.LocalPlayer

-- Cuadros -------------------------------------------------------------------------------
local function setupCanvas(canvas)
	if canvas:FindFirstChild("ArtGui") then
		return
	end
	local gui = Theme.new("SurfaceGui", {
		Name = "ArtGui",
		Face = Enum.NormalId.Front,
		SizingMode = Enum.SurfaceGuiSizingMode.FixedSize,
		CanvasSize = Vector2.new(300, 300),
		LightInfluence = 0.35,
		Brightness = 1.15,
		Parent = canvas,
	})
	local art = Theme.new("Frame", {
		Name = "Art",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(252, 248, 240),
		BorderSizePixel = 0,
		Parent = gui,
	})
	local placeholder = Theme.label({
		Name = "Placeholder",
		Size = UDim2.fromScale(0.84, 0.5),
		Position = UDim2.fromScale(0.08, 0.25),
		Text = "",
		TextColor3 = Color3.fromRGB(176, 180, 190),
		Font = Theme.Fonts.Medium,
		MaxTextSize = 34,
		Parent = art,
	})
	local stars = Theme.label({
		Name = "Stars",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -8, 1, -8),
		Size = UDim2.fromOffset(84, 28),
		BackgroundColor3 = C.Ink,
		BackgroundTransparency = 0.25,
		Text = "",
		Font = Theme.Fonts.Heavy,
		TextColor3 = C.Gold,
		MaxTextSize = 22,
		ZIndex = 5,
		Parent = art,
	})
	Theme.round().Parent = stars
	-- Etiqueta de precio con el color de la banda (ganga, justo, caro...).
	local priceTag = Theme.label({
		Name = "PriceTag",
		Position = UDim2.new(0, 8, 1, -36),
		Size = UDim2.fromOffset(130, 28),
		BackgroundColor3 = C.Primary,
		BackgroundTransparency = 0,
		Text = "",
		Font = Theme.Fonts.Heavy,
		TextColor3 = C.White,
		MaxTextSize = 22,
		Visible = false,
		ZIndex = 5,
		Parent = art,
	})
	Theme.round().Parent = priceTag
	local glitter = nil
	local function refresh()
		local design = Designs.get(canvas:GetAttribute("Design") or "")
		local starCount = canvas:GetAttribute("Stars") or 0
		stars.Text = design and string.rep("★", starCount) or ""
		stars.Visible = stars.Text ~= ""
		local price = canvas:GetAttribute("Price") or 0
		local market = canvas:GetAttribute("Market") or 0
		priceTag.Visible = design ~= nil and price > 0
		if priceTag.Visible then
			priceTag.Text = "💵 " .. Config.formatNumber(price)
			priceTag.BackgroundColor3 = Exhibition.band(price / math.max(1, market)).color
		end
		local best = 0
		if design then
			placeholder.Visible = false
			local colors = Designs.decodeColors(canvas:GetAttribute("Colors"))
			for _, colorId in pairs(colors) do
				best = math.max(best, Colors.rarityOf(Colors.ById[colorId]).index)
			end
			DesignArt.render(art, design, {
				mode = "color",
				colors = colors,
				outlineThickness = 1.5,
			})
		else
			local old = art:FindFirstChild("Art")
			if old then
				old:Destroy()
			end
			placeholder.Visible = true
			placeholder.Text = canvas:GetAttribute("Locked") and "🔒" or "Espacio libre"
		end
		-- Los cuadros con colores legendarios o míticos brillan.
		if best >= 5 and not glitter then
			glitter = Theme.new("ParticleEmitter", {
				Name = "Glitter",
				Texture = "rbxasset://textures/particles/sparkles_main.dds",
				Color = ColorSequence.new(best >= 6 and Color3.fromRGB(255, 140, 220) or Color3.fromRGB(255, 214, 110)),
				Size = NumberSequence.new(0.35, 0),
				Lifetime = NumberRange.new(0.8, 1.4),
				Rate = best >= 6 and 6 or 3,
				Speed = NumberRange.new(0.3, 0.8),
				SpreadAngle = Vector2.new(60, 60),
				LightEmission = 0.6,
				Parent = canvas,
			})
		elseif best < 5 and glitter then
			glitter:Destroy()
			glitter = nil
		end
	end
	for _, attribute in ipairs({ "Design", "Colors", "Locked", "Stars", "Price", "Market" }) do
		canvas:GetAttributeChangedSignal(attribute):Connect(refresh)
	end
	refresh()
end

-- Visitantes -----------------------------------------------------------------------------
local function setupVisitor(model)
	local head = model:WaitForChild("Head", 10)
	if not head or head:FindFirstChild("VisitorBubble") then
		return
	end
	local billboard = Theme.new("BillboardGui", {
		Name = "VisitorBubble",
		Size = UDim2.fromOffset(240, 110),
		StudsOffset = Vector3.new(0, 3.2, 0),
		MaxDistance = 70,
		LightInfluence = 0,
		ResetOnSpawn = false,
		Parent = head,
	})
	local bubble = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -30),
		Size = UDim2.fromOffset(220, 54),
		BackgroundColor3 = C.Panel,
		Visible = false,
		Parent = billboard,
	}, { Theme.corner(14), Theme.stroke(model:GetAttribute("VIP") and C.Gold or C.Border, 1.5) })
	local reaction = Theme.label({
		Size = UDim2.new(1, -16, 1, -8),
		Position = UDim2.fromOffset(8, 4),
		Text = "",
		MaxTextSize = 22,
		Parent = bubble,
	})
	local name = Theme.label({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, 0),
		Size = UDim2.fromOffset(220, 26),
		Text = (model:GetAttribute("VIP") and "👑 " or "") .. tostring(model:GetAttribute("VisitorName") or ""),
		Font = Theme.Fonts.Heavy,
		TextColor3 = model:GetAttribute("VIP") and C.Gold or Color3.new(1, 1, 1),
		MaxTextSize = 22,
		Parent = billboard,
	})
	Theme.textStroke(C.Ink, 1.5, 0.2).Parent = name
	local function refresh()
		local text = model:GetAttribute("Reaction") or ""
		bubble.Visible = text ~= ""
		reaction.Text = text
		bubble.Size = UDim2.fromOffset(text == "🤔" and 60 or 220, string.find(text, "\n") and 64 or 46)
		if bubble.Visible then
			Theme.pop(bubble, 0.5)
		end
	end
	model:GetAttributeChangedSignal("Reaction"):Connect(refresh)
	refresh()
end

-- Hueco de la sala: cartel «＋ Stand» con su precio (solo lo ve el dueño).
local function setupSpot(anchor, plot)
	if anchor:FindFirstChild("SpotTag") then
		return
	end
	local billboard = Theme.new("BillboardGui", {
		Name = "SpotTag",
		Size = UDim2.fromOffset(170, 64),
		StudsOffset = Vector3.new(0, 0.5, 0),
		MaxDistance = 60,
		LightInfluence = 0,
		AlwaysOnTop = false,
		ResetOnSpawn = false,
		Enabled = false,
		Parent = anchor,
	})
	local card = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(160, 56),
		BackgroundColor3 = C.Navy,
		BackgroundTransparency = 0.08,
		Parent = billboard,
	}, { Theme.corner(16), Theme.stroke(C.White, 2, 0.4) })
	local title = Theme.label({
		Position = UDim2.fromOffset(8, 4),
		Size = UDim2.new(1, -16, 0, 26),
		Text = "＋ Stand",
		Font = Theme.Fonts.Display,
		TextColor3 = C.White,
		MaxTextSize = 22,
		Parent = card,
	})
	local cost = Theme.label({
		Position = UDim2.fromOffset(8, 30),
		Size = UDim2.new(1, -16, 0, 20),
		Text = "",
		Font = Theme.Fonts.Heavy,
		TextColor3 = C.Gold,
		MaxTextSize = 18,
		Parent = card,
	})
	local function refresh()
		local mine = plot:GetAttribute("OwnerUserId") == player.UserId
		local open = anchor:GetAttribute("Open") == true
		local owned = anchor:GetAttribute("Owned") == true
		billboard.Enabled = mine and open and not owned
		local price = anchor:GetAttribute("Cost") or 0
		title.Text = "＋ Stand"
		cost.Text = price > 0 and ("💵 " .. Config.formatNumber(price)) or "¡Gratis!"
	end
	for _, attribute in ipairs({ "Open", "Owned", "Cost" }) do
		anchor:GetAttributeChangedSignal(attribute):Connect(refresh)
	end
	plot:GetAttributeChangedSignal("OwnerUserId"):Connect(refresh)
	refresh()
end

-- Avisos (taller y sala) solo para el dueño del terreno.
local function setPromptDistance(plot, prompt)
	local mine = plot:GetAttribute("OwnerUserId") == player.UserId
	local inGallery = prompt:IsDescendantOf(plot:FindFirstChild("Gallery") or plot)
	prompt.MaxActivationDistance = mine and (inGallery and 10 or 12) or 0
end

local function updatePrompts(plot)
	for _, folderName in ipairs({ "Workshop", "Gallery" }) do
		local folder = plot:FindFirstChild(folderName)
		if folder then
			for _, descendant in ipairs(folder:GetDescendants()) do
				if descendant:IsA("ProximityPrompt") then
					setPromptDistance(plot, descendant)
				end
			end
		end
	end
end

local function watchPlot(plot)
	local gallery = plot:WaitForChild("Gallery", 10)
	if gallery then
		local function check(descendant)
			if descendant.Name == "Canvas" and descendant:IsA("BasePart") then
				setupCanvas(descendant)
			elseif descendant:IsA("ProximityPrompt") then
				setPromptDistance(plot, descendant)
			elseif
				descendant:IsA("BasePart")
				and descendant:GetAttribute("Index")
				and descendant.Parent.Name == "Spots"
			then
				setupSpot(descendant, plot)
			end
		end
		for _, descendant in ipairs(gallery:GetDescendants()) do
			task.spawn(check, descendant)
		end
		gallery.DescendantAdded:Connect(function(descendant)
			task.defer(check, descendant)
		end)
	end
	local workshop = plot:WaitForChild("Workshop", 10)
	local easel = workshop and workshop:WaitForChild("Easel", 10)
	local easelCanvas = easel and easel:WaitForChild("Canvas", 10)
	if easelCanvas then
		setupCanvas(easelCanvas)
	end
	local visitors = plot:WaitForChild("Visitors", 10)
	if visitors then
		for _, model in ipairs(visitors:GetChildren()) do
			task.spawn(setupVisitor, model)
		end
		visitors.ChildAdded:Connect(function(model)
			task.spawn(setupVisitor, model)
		end)
		-- El cuadro que se lleva el visitante que lo compró.
		visitors.DescendantAdded:Connect(function(descendant)
			if descendant.Name == "Canvas" and descendant:IsA("BasePart") then
				task.defer(setupCanvas, descendant)
			end
		end)
	end
	plot:GetAttributeChangedSignal("OwnerUserId"):Connect(function()
		updatePrompts(plot)
	end)
	updatePrompts(plot)
end

-- El cuadro que llevas a la espalda.
local function watchCharacter(character)
	local function check(child)
		if child.Name == "CarriedPainting" then
			local canvas = child:WaitForChild("Canvas", 5)
			if canvas then
				setupCanvas(canvas)
			end
		end
	end
	for _, child in ipairs(character:GetChildren()) do
		task.spawn(check, child)
	end
	character.ChildAdded:Connect(function(child)
		task.spawn(check, child)
	end)
end

function World.start()
	if player.Character then
		task.spawn(watchCharacter, player.Character)
	end
	player.CharacterAdded:Connect(watchCharacter)
	local plots = Workspace:WaitForChild("Plots")
	for _, plot in ipairs(plots:GetChildren()) do
		task.spawn(watchPlot, plot)
	end
	plots.ChildAdded:Connect(function(plot)
		task.spawn(watchPlot, plot)
	end)
end

return World
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="36">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">true</bool>
    </Properties>
  </Item>
</roblox>