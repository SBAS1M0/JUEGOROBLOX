  <Item class="ServerScriptService" referent="7">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="8">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Script" referent="9">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Punto de entrada del servidor: crea el mundo, asigna galerías y gestiona
-- pedidos, monedas, niveles, mejoras y recompensas.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Templates = require(Shared.Templates)
local Scoring = require(Shared.Scoring)

local Services = script.Parent:WaitForChild("Services")
local DataService = require(Services.DataService)
local WorldBuilder = require(Services.WorldBuilder)
local CustomerService = require(Services.CustomerService)

-- Remotos -------------------------------------------------------------------------
local remotes = Instance.new("Folder")
remotes.Name = "Remotes"

local function remote(class, name)
	local r = Instance.new(class)
	r.Name = name
	r.Parent = remotes
	return r
end

local GetState = remote("RemoteFunction", "GetState")
local StateChanged = remote("RemoteEvent", "StateChanged")
local Notify = remote("RemoteEvent", "Notify")
local OpenOrder = remote("RemoteEvent", "OpenOrder")
local StartPainting = remote("RemoteFunction", "StartPainting")
local StopPainting = remote("RemoteEvent", "StopPainting")
local SubmitPainting = remote("RemoteFunction", "SubmitPainting")
local BuyUpgrade = remote("RemoteFunction", "BuyUpgrade")
local ClaimDaily = remote("RemoteFunction", "ClaimDaily")
local GoHome = remote("RemoteEvent", "GoHome")
remotes.Parent = ReplicatedStorage

-- Mundo ---------------------------------------------------------------------------
local plots = WorldBuilder.build()
local plotOf = {}
local sessions = {}

local function getSession(player)
	local session = sessions[player]
	if not session then
		session = { streak = 0, lastSubmit = 0, painting = nil }
		sessions[player] = session
	end
	return session
end

local function upgradeLevel(data, id)
	return data.upgrades[id] or 0
end

local function dailyStatus(data)
	local now = os.time()
	local ready = now - data.lastDaily >= Config.DAILY_COOLDOWN
	local streak = data.dailyStreak
	if now - data.lastDaily > Config.DAILY_COOLDOWN * 2.4 then
		streak = 0
	end
	local nextStreak = math.min(streak + 1, 7)
	local amount = 100 + data.level * 25 + nextStreak * 50
	return ready, amount, math.max(0, Config.DAILY_COOLDOWN - (now - data.lastDaily)), nextStreak
end

local function buildState(player)
	local data = DataService.get(player)
	if not data then
		return nil
	end
	local session = getSession(player)
	local ready, amount, wait, nextStreak = dailyStatus(data)
	local plot = plotOf[player]
	return {
		coins = data.coins,
		xp = data.xp,
		level = data.level,
		xpNext = Config.xpToNext(data.level),
		upgrades = data.upgrades,
		streak = session.streak,
		sold = data.sold,
		perfect = data.perfect,
		dailyReady = ready,
		dailyAmount = amount,
		dailyWait = wait,
		dailyStreak = nextStreak,
		plotIndex = plot and plot.index or 0,
	}
end

local function updateLeaderstats(player)
	local data = DataService.get(player)
	local stats = player:FindFirstChild("leaderstats")
	if not (data and stats) then
		return
	end
	stats.Monedas.Value = data.coins
	stats.Nivel.Value = data.level
	stats.Obras.Value = data.sold
end

local function pushState(player)
	local state = buildState(player)
	if state then
		StateChanged:FireClient(player, state)
	end
	updateLeaderstats(player)
end

local function notify(player, text, kind)
	Notify:FireClient(player, text, kind or "info")
end

-- Galería en las paredes ---------------------------------------------------------
local function renderGallery(plot, data)
	local gallery = data and data.gallery or {}
	for i = 1, Config.GALLERY_SIZE do
		local entry = gallery[i]
		local canvas = plot.canvases[i]
		local plaque = plot.plaques[i]
		if entry and type(entry.c) == "string" and #entry.c == Config.CELLS then
			canvas:SetAttribute("Cells", entry.c)
			local template = Templates.get(entry.t)
			plaque.Text = string.rep("★", entry.s or 0) .. "  " .. (template and template.name or "Obra")
		else
			canvas:SetAttribute("Cells", "")
			plaque.Text = "Tu próxima obra"
		end
	end
	local latest = gallery[1]
	plot.easelCanvas:SetAttribute("Cells", latest and latest.c or "")
end

-- Asignación de galerías ------------------------------------------------------------
local function assignPlot(player)
	for _, plot in ipairs(plots) do
		if plot.model:GetAttribute("OwnerUserId") == 0 then
			plot.model:SetAttribute("OwnerUserId", player.UserId)
			plotOf[player] = plot
			plot.signLabel.Text = "Galería de " .. player.DisplayName
			return plot
		end
	end
	return nil
end

local function releasePlot(player)
	local plot = plotOf[player]
	if not plot then
		return
	end
	plotOf[player] = nil
	CustomerService.detach(plot)
	plot.model:SetAttribute("OwnerUserId", 0)
	plot.signLabel.Text = "Galería libre"
	renderGallery(plot, nil)
	WorldBuilder.setDecorLevel(plot, 0)
end

local function teleportHome(player)
	local plot = plotOf[player]
	local character = player.Character
	if not (plot and character) then
		return
	end
	local rootPart = character:FindFirstChild("HumanoidRootPart")
	if rootPart then
		character:PivotTo(plot.ownerSpawn)
	end
end

-- Jugadores -------------------------------------------------------------------------
local function onPlayerAdded(player)
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	for _, name in ipairs({ "Monedas", "Nivel", "Obras" }) do
		local value = Instance.new("IntValue")
		value.Name = name
		value.Parent = stats
	end
	stats.Parent = player

	local data = DataService.load(player)
	if not player.Parent then
		return
	end

	local plot = assignPlot(player)
	if plot then
		renderGallery(plot, data)
		WorldBuilder.setDecorLevel(plot, upgradeLevel(data, "decoracion"))
		CustomerService.attach(plot, player)
	else
		notify(player, "Todas las galerías están ocupadas. ¡Explora la plaza!", "error")
	end

	player.CharacterAdded:Connect(function(character)
		character:WaitForChild("HumanoidRootPart", 10)
		task.wait(0.2)
		teleportHome(player)
	end)
	if player.Character then
		task.defer(teleportHome, player)
	end

	pushState(player)
	notify(player, "¡Bienvenido a tu galería! Atiende a los clientes que entran 🎨", "success")
end

local function onPlayerRemoving(player)
	local session = sessions[player]
	if session and session.painting then
		local customer = CustomerService.getWaiting(player, session.painting)
		if customer then
			CustomerService.setPainting(customer, false)
		end
	end
	releasePlot(player)
	DataService.release(player)
	sessions[player] = nil
end

-- Clientes ---------------------------------------------------------------------------
CustomerService.getProfile = function(player)
	return DataService.get(player)
end

CustomerService.onPromptTriggered = function(player, customer)
	if customer.owner ~= player then
		notify(player, "Este cliente es de otra galería 😉", "error")
		return
	end
	if customer.state == "waiting" then
		OpenOrder:FireClient(player, customer.id)
	end
end

CustomerService.onExpired = function(player, customer)
	local session = getSession(player)
	if session.painting == customer.id then
		session.painting = nil
	end
	if session.streak > 0 then
		notify(player, "Un cliente se fue sin su obra. ¡Racha perdida! 💔", "error")
	else
		notify(player, "Un cliente se cansó de esperar 😤", "error")
	end
	session.streak = 0
	pushState(player)
end

-- Remotos: pintura ---------------------------------------------------------------------
StartPainting.OnServerInvoke = function(player, orderId)
	if type(orderId) ~= "string" then
		return false
	end
	local customer = CustomerService.getWaiting(player, orderId)
	if not customer then
		return false
	end
	local session = getSession(player)
	if session.painting and session.painting ~= orderId then
		local previous = CustomerService.getWaiting(player, session.painting)
		if previous then
			CustomerService.setPainting(previous, false)
		end
	end
	session.painting = orderId
	CustomerService.setPainting(customer, true)
	return true
end

StopPainting.OnServerEvent:Connect(function(player, orderId)
	local session = getSession(player)
	if type(orderId) ~= "string" or session.painting ~= orderId then
		return
	end
	session.painting = nil
	local customer = CustomerService.getWaiting(player, orderId)
	if customer then
		CustomerService.setPainting(customer, false)
	end
end)

local function pickLine(stars)
	local list
	if stars >= 3 then
		list = Config.HappyLines
	elseif stars >= 1 then
		list = Config.OkLines
	else
		list = Config.SadLines
	end
	return list[math.random(1, #list)]
end

SubmitPainting.OnServerInvoke = function(player, orderId, cells)
	local data = DataService.get(player)
	local session = getSession(player)
	if not data or type(orderId) ~= "string" then
		return { ok = false, reason = "Pedido no válido." }
	end
	local now = os.clock()
	if now - session.lastSubmit < 1 then
		return { ok = false, reason = "Espera un momento..." }
	end
	local customer = CustomerService.getWaiting(player, orderId)
	if not customer then
		return { ok = false, reason = "El cliente ya se fue 😢" }
	end
	local template = Templates.get(customer.order.templateId)
	if not template or not Scoring.isValidCanvas(cells, template) then
		return { ok = false, reason = "El lienzo no es válido." }
	end
	session.lastSubmit = now
	if session.painting == orderId then
		session.painting = nil
	end

	local result = Scoring.evaluate(customer.order, template, cells)
	local stars = result.stars
	local levels = data.upgrades

	if stars >= 2 then
		session.streak += 1
	else
		session.streak = 0
	end
	data.bestStreak = math.max(data.bestStreak, session.streak)

	local streakBonus = math.min(Config.MAX_STREAK_BONUS, math.max(0, session.streak - 1) * Config.STREAK_BONUS)
	local payment = math.floor(customer.order.reward * Config.STAR_PAY[stars] * (1 + streakBonus))
	local patienceLeft = math.clamp(customer.patience / customer.order.patience, 0, 1)
	local tip = 0
	if stars >= 1 then
		tip = math.floor(customer.order.reward * 0.5 * patienceLeft * Config.tipMultiplier(levels))
	end
	local xp = math.floor(template.xp * (0.4 + 0.3 * stars) * (customer.order.vip and 2 or 1))

	data.coins += payment + tip
	data.xp += xp
	data.sold += 1
	if stars >= 3 then
		data.perfect += 1
	end

	local oldLevel = data.level
	while data.xp >= Config.xpToNext(data.level) do
		data.xp -= Config.xpToNext(data.level)
		data.level += 1
	end
	local unlocked = {}
	for _, t in ipairs(Templates.List) do
		if t.level > oldLevel and t.level <= data.level then
			table.insert(unlocked, t.name)
		end
	end
	local newModes = {}
	for _, id in ipairs(Config.ModeOrder) do
		local mode = Config.Modes[id]
		if mode.level > oldLevel and mode.level <= data.level then
			table.insert(newModes, mode.name)
		end
	end

	if stars >= 1 then
		table.insert(data.gallery, 1, { t = template.id, c = cells, s = stars })
		while #data.gallery > Config.GALLERY_SIZE do
			table.remove(data.gallery)
		end
		local plot = plotOf[player]
		if plot then
			renderGallery(plot, data)
		end
	end

	local line = pickLine(stars)
	CustomerService.complete(customer, stars, line)
	pushState(player)

	return {
		ok = true,
		stars = stars,
		quality = result.quality,
		payment = payment,
		tip = tip,
		xp = xp,
		streak = session.streak,
		streakBonus = streakBonus,
		vip = customer.order.vip,
		line = line,
		levelUp = data.level > oldLevel and data.level or nil,
		unlocked = unlocked,
		newModes = newModes,
	}
end

-- Remotos: progreso ---------------------------------------------------------------------
GetState.OnServerInvoke = function(player)
	for _ = 1, 50 do
		if DataService.get(player) then
			break
		end
		task.wait(0.2)
	end
	return buildState(player)
end

BuyUpgrade.OnServerInvoke = function(player, id)
	local data = DataService.get(player)
	local upgrade = type(id) == "string" and Config.UpgradeById[id]
	if not (data and upgrade) then
		return false, "Mejora no válida."
	end
	local level = upgradeLevel(data, id)
	if level >= upgrade.max then
		return false, "¡Ya está al máximo!"
	end
	local cost = Config.upgradeCost(id, level)
	if data.coins < cost then
		return false, "Te faltan " .. (cost - data.coins) .. " monedas."
	end
	data.coins -= cost
	data.upgrades[id] = level + 1
	if id == "decoracion" then
		local plot = plotOf[player]
		if plot then
			WorldBuilder.setDecorLevel(plot, level + 1)
		end
	end
	pushState(player)
	return true, upgrade.name .. " subió a nivel " .. (level + 1) .. "!"
end

ClaimDaily.OnServerInvoke = function(player)
	local data = DataService.get(player)
	if not data then
		return false, 0
	end
	local ready, amount, _, nextStreak = dailyStatus(data)
	if not ready then
		return false, 0
	end
	data.lastDaily = os.time()
	data.dailyStreak = nextStreak
	data.coins += amount
	pushState(player)
	return true, amount
end

GoHome.OnServerEvent:Connect(function(player)
	local session = getSession(player)
	local now = os.clock()
	if now - (session.lastHome or 0) < 2 then
		return
	end
	session.lastHome = now
	teleportHome(player)
end)

-- Arranque -----------------------------------------------------------------------------
DataService.start()
CustomerService.start()

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, player)
end

-- Refresca el contador del regalo diario cada minuto.
task.spawn(function()
	while true do
		task.wait(60)
		for _, player in ipairs(Players:GetPlayers()) do
			pushState(player)
		end
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="10">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">CustomerService</string>
            <string name="Source"><![CDATA[-- Clientes: aparecen, caminan hasta la galería, esperan con su pedido y se van.
-- Cada cliente es un modelo hecho con piezas (no necesita assets externos).

local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Palette = require(Shared.Palette)
local Templates = require(Shared.Templates)

local CustomerService = {}

local WALK_SPEED = 10
local ROOT_HEIGHT = 2.6
local PATIENCE_UPDATE = 0.2

local SKIN_TONES = {
	Color3.fromRGB(255, 224, 196),
	Color3.fromRGB(241, 194, 150),
	Color3.fromRGB(214, 160, 120),
	Color3.fromRGB(170, 116, 80),
	Color3.fromRGB(120, 80, 56),
}

local rng = Random.new()
local plotStates = {}
local customersById = {}

-- Callbacks que asigna el GameService.
CustomerService.getProfile = nil
CustomerService.onExpired = nil

local function pick(list)
	return list[rng:NextInteger(1, #list)]
end

-- Construcción del muñequito ------------------------------------------------------
local function attachPart(model, root, props, offset)
	local p = Instance.new("Part")
	p.Anchored = false
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for key, value in pairs(props) do
		p[key] = value
	end
	p.CFrame = root.CFrame * offset
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = p
	weld.Parent = p
	p.Parent = model
	return p
end

local function ball(size)
	return Vector3.new(size, size, size)
end

local function buildModel(startCF, vip)
	local model = Instance.new("Model")
	model.Name = "Customer"

	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(2, 2, 2)
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.CanTouch = false
	root.CFrame = startCF * CFrame.new(0, ROOT_HEIGHT, 0)
	root.Parent = model
	model.PrimaryPart = root

	local skin = pick(SKIN_TONES)
	local shirt = pick(Config.CustomerColors)
	if vip then
		shirt = Color3.fromRGB(255, 214, 90)
	end

	local body =
		attachPart(model, root, { Name = "Body", Size = Vector3.new(3, 3.6, 2.8), Color = shirt }, CFrame.new())
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = body

	attachPart(
		model,
		root,
		{ Name = "Head", Shape = Enum.PartType.Ball, Size = ball(2.8), Color = skin },
		CFrame.new(0, 2.9, 0)
	)
	for _, side in ipairs({ -1, 1 }) do
		attachPart(
			model,
			root,
			{ Shape = Enum.PartType.Ball, Size = ball(0.45), Color = Color3.fromRGB(40, 30, 50) },
			CFrame.new(side * 0.5, 3.05, -1.22)
		)
		attachPart(model, root, {
			Shape = Enum.PartType.Ball,
			Size = ball(0.16),
			Color = Color3.new(1, 1, 1),
			Material = Enum.Material.Neon,
		}, CFrame.new(side * 0.45, 3.15, -1.42))
		attachPart(model, root, {
			Shape = Enum.PartType.Ball,
			Size = ball(0.42),
			Color = Color3.fromRGB(255, 140, 160),
			Transparency = 0.35,
		}, CFrame.new(side * 0.88, 2.6, -1.08))
		attachPart(
			model,
			root,
			{ Name = "Hand", Shape = Enum.PartType.Ball, Size = ball(0.9), Color = skin },
			CFrame.new(side * 1.6, -0.3, -0.2)
		)
		attachPart(
			model,
			root,
			{ Name = "Foot", Shape = Enum.PartType.Ball, Size = ball(0.95), Color = Color3.fromRGB(70, 56, 90) },
			CFrame.new(side * 0.65, -2.15, -0.15)
		)
	end
	attachPart(
		model,
		root,
		{ Size = Vector3.new(0.55, 0.12, 0.1), Color = Color3.fromRGB(150, 60, 70) },
		CFrame.new(0, 2.42, -1.33)
	)

	local hatStyle = vip and "crown" or pick({ "none", "beret", "tophat", "bow", "cap", "none" })
	local hatColor = pick(Config.CustomerColors):Lerp(Color3.new(0, 0, 0), 0.25)
	if hatStyle == "beret" then
		attachPart(
			model,
			root,
			{ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.5, 2.6, 2.6), Color = hatColor },
			CFrame.new(0.25, 4.2, 0) * CFrame.Angles(0, 0, math.rad(80))
		)
	elseif hatStyle == "tophat" then
		attachPart(
			model,
			root,
			{ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.2, 2.9, 2.9), Color = Color3.fromRGB(40, 32, 50) },
			CFrame.new(0, 4.15, 0) * CFrame.Angles(0, 0, math.rad(90))
		)
		attachPart(
			model,
			root,
			{ Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.6, 1.9, 1.9), Color = Color3.fromRGB(40, 32, 50) },
			CFrame.new(0, 4.95, 0) * CFrame.Angles(0, 0, math.rad(90))
		)
		attachPart(
			model,
			root,
			{ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.35, 1.95, 1.95), Color = hatColor },
			CFrame.new(0, 4.45, 0) * CFrame.Angles(0, 0, math.rad(90))
		)
	elseif hatStyle == "bow" then
		for _, side in ipairs({ -1, 1 }) do
			attachPart(
				model,
				root,
				{ Shape = Enum.PartType.Ball, Size = ball(0.8), Color = Color3.fromRGB(255, 110, 170) },
				CFrame.new(side * 0.45, 4.25, 0.2)
			)
		end
		attachPart(
			model,
			root,
			{ Shape = Enum.PartType.Ball, Size = ball(0.4), Color = Color3.fromRGB(230, 70, 140) },
			CFrame.new(0, 4.25, 0.2)
		)
	elseif hatStyle == "cap" then
		attachPart(
			model,
			root,
			{ Shape = Enum.PartType.Ball, Size = ball(2.9), Color = hatColor },
			CFrame.new(0, 3.35, 0.05)
		)
		attachPart(model, root, { Size = Vector3.new(1.8, 0.15, 1.2), Color = hatColor }, CFrame.new(0, 3.75, -1.5))
	elseif hatStyle == "crown" then
		local gold = Color3.fromRGB(255, 200, 60)
		attachPart(model, root, {
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.7, 1.9, 1.9),
			Color = gold,
			Material = Enum.Material.Metal,
			Reflectance = 0.2,
		}, CFrame.new(0, 4.35, 0) * CFrame.Angles(0, 0, math.rad(90)))
		for i = 0, 4 do
			local angle = i / 5 * math.pi * 2
			attachPart(model, root, {
				Shape = Enum.PartType.Ball,
				Size = ball(0.42),
				Color = (i % 2 == 0) and Color3.fromRGB(255, 80, 120) or Color3.fromRGB(90, 200, 255),
				Material = Enum.Material.Neon,
			}, CFrame.new(math.cos(angle) * 0.8, 4.85, math.sin(angle) * 0.8))
		end
		local sparkle = Instance.new("Sparkles")
		sparkle.SparkleColor = gold
		sparkle.Parent = body
	end

	return model, root
end

-- Pedidos ---------------------------------------------------------------------------
local function chooseTemplate(level)
	local unlocked = Templates.unlockedFor(level)
	local total = 0
	local weights = {}
	for i in ipairs(unlocked) do
		-- Las obras recién desbloqueadas salen un poco más a menudo.
		local weight = 1 + i / #unlocked
		weights[i] = weight
		total += weight
	end
	local roll = rng:NextNumber() * total
	for i, template in ipairs(unlocked) do
		roll -= weights[i]
		if roll <= 0 then
			return template
		end
	end
	return unlocked[#unlocked]
end

local function chooseMode(level)
	local total = 0
	for _, id in ipairs(Config.ModeOrder) do
		local mode = Config.Modes[id]
		if mode.level <= level then
			total += mode.weight
		end
	end
	local roll = rng:NextNumber() * total
	for _, id in ipairs(Config.ModeOrder) do
		local mode = Config.Modes[id]
		if mode.level <= level then
			roll -= mode.weight
			if roll <= 0 then
				return id
			end
		end
	end
	return "original"
end

-- Elige el color principal del dibujo y un color nuevo que no esté en la plantilla.
local function chooseSwap(template)
	local counts = {}
	local background = string.sub(template.flat, 1, 1)
	for i = 1, #template.flat do
		local key = string.sub(template.flat, i, i)
		if key ~= Palette.OUTLINE and key ~= background then
			counts[key] = (counts[key] or 0) + 1
		end
	end
	local from, best = nil, 0
	for key, count in pairs(counts) do
		if count > best then
			from, best = key, count
		end
	end
	from = from or background
	local options = {}
	for _, entry in ipairs(Palette.List) do
		if not string.find(template.flat, entry.key, 1, true) then
			table.insert(options, entry.key)
		end
	end
	return from, pick(options)
end

local function makeOrder(profile, levels)
	local level = profile.level
	local template = chooseTemplate(level)
	local mode = chooseMode(level)
	local vip = rng:NextNumber() < Config.vipChance(levels)
	local order = {
		templateId = template.id,
		mode = mode,
		vip = vip,
		theme = "",
		swapFrom = "",
		swapTo = "",
	}
	if mode == "remix" then
		order.swapFrom, order.swapTo = chooseSwap(template)
	elseif mode == "tema" then
		order.theme = pick(Config.Themes).id
	end
	local price = template.reward * Config.Modes[mode].pay * Config.payMultiplier(levels)
	if vip then
		price *= Config.VIP_MULTIPLIER
	end
	order.reward = math.floor(price)
	local patience = template.patience * Config.patienceMultiplier(levels)
	if mode == "remix" or mode == "tema" then
		patience *= 1.1
	end
	order.patience = patience
	return order
end

-- Movimiento ------------------------------------------------------------------------
local function walk(customer, points, onDone)
	if customer.walkConnection then
		customer.walkConnection:Disconnect()
	end
	local root = customer.root
	local index = 1
	local elapsed = 0
	local position = root.Position - Vector3.new(0, ROOT_HEIGHT, 0)
	customer.walkConnection = RunService.Heartbeat:Connect(function(dt)
		if not root.Parent then
			customer.walkConnection:Disconnect()
			return
		end
		elapsed += dt
		local target = points[index].Position
		local offset = target - position
		local distance = offset.Magnitude
		local step = WALK_SPEED * dt
		local direction = distance > 0.01 and offset.Unit or Vector3.new(0, 0, -1)
		if distance <= step then
			position = target
			index += 1
		else
			position += direction * step
		end
		local flat = Vector3.new(direction.X, 0, direction.Z)
		if flat.Magnitude < 0.01 then
			flat = root.CFrame.LookVector
		end
		local hop = math.abs(math.sin(elapsed * 9)) * 0.55
		if index > #points then
			customer.walkConnection:Disconnect()
			customer.walkConnection = nil
			root.CFrame = points[#points] * CFrame.new(0, ROOT_HEIGHT, 0)
			if onDone then
				onDone()
			end
			return
		end
		local sway = math.sin(elapsed * 9) * 0.08
		root.CFrame = CFrame.lookAt(position, position + flat)
			* CFrame.new(0, ROOT_HEIGHT + hop, 0)
			* CFrame.Angles(0, 0, sway)
	end)
end

local function setState(customer, state)
	customer.state = state
	customer.model:SetAttribute("State", state)
	customer.prompt.Enabled = state == "waiting"
end

local function removeCustomer(customer)
	if customer.walkConnection then
		customer.walkConnection:Disconnect()
		customer.walkConnection = nil
	end
	customersById[customer.id] = nil
	local plotState = plotStates[customer.plot.index]
	if plotState then
		plotState.customers[customer.id] = nil
		if plotState.spotsTaken[customer.spotIndex] == customer then
			plotState.spotsTaken[customer.spotIndex] = nil
		end
	end
	if customer.model then
		customer.model:Destroy()
	end
end

local function leave(customer, reaction)
	if customer.state == "leaving" then
		return
	end
	setState(customer, "leaving")
	if reaction then
		customer.model:SetAttribute("Reaction", reaction)
	end
	local plotState = plotStates[customer.plot.index]
	if plotState and plotState.spotsTaken[customer.spotIndex] == customer then
		plotState.spotsTaken[customer.spotIndex] = nil
	end
	local plot = customer.plot
	local spot = plot.spots[customer.spotIndex]
	task.delay(1.6, function()
		if not customer.model.Parent then
			return
		end
		walk(customer, {
			spot * CFrame.new(0, 0, -6),
			plot.inside,
			plot.entrance,
			plot.street,
		}, function()
			removeCustomer(customer)
		end)
	end)
end

local function spawnCustomer(plotState)
	local plot = plotState.plot
	local owner = plotState.owner
	local profile = CustomerService.getProfile(owner)
	if not profile then
		return
	end
	local spotIndex
	local free = {}
	for i = 1, #plot.spots do
		if not plotState.spotsTaken[i] then
			table.insert(free, i)
		end
	end
	if #free == 0 then
		return
	end
	spotIndex = pick(free)

	local order = makeOrder(profile, profile.upgrades)
	local id = HttpService:GenerateGUID(false)
	local model, root = buildModel(plot.street, order.vip)
	local name = pick(Config.CustomerNames)

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Pintar pedido"
	prompt.ObjectText = name
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 14
	prompt.RequiresLineOfSight = false
	prompt.Enabled = false
	prompt.Parent = root

	model:SetAttribute("OrderId", id)
	model:SetAttribute("Owner", owner.UserId)
	model:SetAttribute("CustomerName", name)
	model:SetAttribute("TemplateId", order.templateId)
	model:SetAttribute("Mode", order.mode)
	model:SetAttribute("Theme", order.theme)
	model:SetAttribute("SwapFrom", order.swapFrom)
	model:SetAttribute("SwapTo", order.swapTo)
	model:SetAttribute("VIP", order.vip)
	model:SetAttribute("Reward", order.reward)
	model:SetAttribute("MaxPatience", order.patience)
	model:SetAttribute("Patience", order.patience)
	model:SetAttribute("Painting", false)
	model:SetAttribute("Reaction", "")
	model.Name = "Customer_" .. name

	local customer = {
		id = id,
		plot = plot,
		owner = owner,
		model = model,
		root = root,
		prompt = prompt,
		spotIndex = spotIndex,
		order = order,
		patience = order.patience,
		painting = false,
		sinceUpdate = 0,
	}
	plotState.spotsTaken[spotIndex] = customer
	plotState.customers[id] = customer
	customersById[id] = customer
	setState(customer, "entering")
	model.Parent = plot.customersFolder

	prompt.Triggered:Connect(function(player)
		if CustomerService.onPromptTriggered then
			CustomerService.onPromptTriggered(player, customer)
		end
	end)

	local spot = plot.spots[spotIndex]
	walk(customer, {
		plot.entrance,
		plot.inside,
		spot * CFrame.new(0, 0, -6),
		spot,
	}, function()
		if customer.state ~= "entering" then
			return
		end
		root.CFrame = spot * CFrame.new(0, ROOT_HEIGHT, 0) * CFrame.Angles(0, math.pi, 0)
		setState(customer, "waiting")
	end)
end

-- API pública ------------------------------------------------------------------------
function CustomerService.attach(plot, owner)
	plotStates[plot.index] = {
		plot = plot,
		owner = owner,
		customers = {},
		spotsTaken = {},
		spawnTimer = Config.BASE_SPAWN_INTERVAL - 2,
	}
end

function CustomerService.detach(plot)
	local plotState = plotStates[plot.index]
	if not plotState then
		return
	end
	plotStates[plot.index] = nil
	for _, customer in pairs(plotState.customers) do
		removeCustomer(customer)
	end
	plot.customersFolder:ClearAllChildren()
end

-- Devuelve el cliente si el pedido es válido para ese jugador.
function CustomerService.getWaiting(player, orderId)
	local customer = customersById[orderId]
	if customer and customer.owner == player and customer.state == "waiting" then
		return customer
	end
	return nil
end

function CustomerService.setPainting(customer, painting)
	customer.painting = painting
	if customer.model.Parent then
		customer.model:SetAttribute("Painting", painting)
	end
end

function CustomerService.complete(customer, stars, line)
	customer.painting = false
	local emoji = stars >= 3 and "😍" or (stars >= 2 and "😊" or (stars >= 1 and "🙂" or "😕"))
	leave(customer, emoji .. " " .. line)
	if stars >= 2 then
		local hearts = Instance.new("ParticleEmitter")
		hearts.Rate = 0
		hearts.Lifetime = NumberRange.new(1, 1.6)
		hearts.Speed = NumberRange.new(4, 7)
		hearts.SpreadAngle = Vector2.new(60, 60)
		hearts.LightEmission = 0.6
		hearts.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.8),
			NumberSequenceKeypoint.new(1, 0),
		})
		hearts.Color = ColorSequence.new(Color3.fromRGB(255, 120, 180), Color3.fromRGB(255, 220, 120))
		hearts.EmissionDirection = Enum.NormalId.Top
		hearts.Parent = customer.root
		hearts:Emit(stars >= 3 and 40 or 20)
	end
end

function CustomerService.countFor(player)
	local count = 0
	for _, customer in pairs(customersById) do
		if customer.owner == player and customer.state ~= "leaving" then
			count += 1
		end
	end
	return count
end

function CustomerService.start()
	RunService.Heartbeat:Connect(function(dt)
		for _, plotState in pairs(plotStates) do
			local owner = plotState.owner
			local profile = CustomerService.getProfile(owner)
			if profile then
				local levels = profile.upgrades
				-- Generar clientes nuevos.
				local active = 0
				for _, customer in pairs(plotState.customers) do
					if customer.state ~= "leaving" then
						active += 1
					end
				end
				if active < Config.maxQueue(levels) then
					plotState.spawnTimer += dt
					if plotState.spawnTimer >= Config.spawnInterval(levels) then
						plotState.spawnTimer = 0
						spawnCustomer(plotState)
					end
				else
					plotState.spawnTimer = math.min(plotState.spawnTimer, Config.spawnInterval(levels) * 0.5)
				end

				-- Paciencia de los clientes que esperan.
				for _, customer in pairs(plotState.customers) do
					if customer.state == "waiting" then
						local rate = customer.painting and Config.PAINTING_PATIENCE_RATE or 1
						customer.patience -= dt * rate
						customer.sinceUpdate += dt
						if customer.patience <= 0 then
							customer.patience = 0
							customer.model:SetAttribute("Patience", 0)
							leave(customer, pick(Config.AngryLines))
							if CustomerService.onExpired then
								task.spawn(CustomerService.onExpired, owner, customer)
							end
						elseif customer.sinceUpdate >= PATIENCE_UPDATE then
							customer.sinceUpdate = 0
							customer.model:SetAttribute("Patience", customer.patience)
						end
					end
				end
			end
		end
	end)
end

return CustomerService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[-- Guarda y carga el progreso de cada jugador con DataStoreService.
-- Si los DataStores no están disponibles (por ejemplo en Studio sin publicar)
-- el juego sigue funcionando, solo que sin guardar.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)

local DataService = {}

local STORE_NAME = "GaleriaPincelada_v1"
local MAX_RETRIES = 4

local store = nil
local profiles = {}
local loaded = {}

do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
	else
		warn("[Galería] DataStores no disponibles, el progreso no se guardará: " .. tostring(result))
	end
end

local function defaultData()
	return {
		coins = Config.START_COINS,
		xp = 0,
		level = 1,
		upgrades = {},
		sold = 0,
		perfect = 0,
		bestStreak = 0,
		lastDaily = 0,
		dailyStreak = 0,
		gallery = {},
	}
end

-- Rellena campos que falten (por ejemplo tras una actualización del juego).
local function reconcile(data)
	local template = defaultData()
	if type(data) ~= "table" then
		return template
	end
	for key, value in pairs(template) do
		if type(data[key]) ~= type(value) then
			data[key] = value
		end
	end
	for id in pairs(data.upgrades) do
		if not Config.UpgradeById[id] then
			data.upgrades[id] = nil
		end
	end
	return data
end

-- Errores que no se arreglan reintentando (Studio sin acceso a las APIs).
local function isPermanentError(message)
	message = tostring(message)
	return string.find(message, "StudioAccessToApisNotAllowed", 1, true) ~= nil
		or string.find(message, "publish", 1, true) ~= nil
end

local function disableStore(reason)
	if store then
		store = nil
		warn("[Galería] DataStores no disponibles, el progreso no se guardará: " .. tostring(reason))
	end
end

local function withRetries(callback)
	local lastError
	for attempt = 1, MAX_RETRIES do
		local ok, result = pcall(callback)
		if ok then
			return true, result
		end
		lastError = result
		if isPermanentError(result) then
			disableStore(result)
			break
		end
		task.wait(attempt * 1.5)
	end
	return false, lastError
end

function DataService.load(player)
	local data
	local canSave = store ~= nil
	local currentStore = store
	if currentStore then
		local ok, result = withRetries(function()
			return currentStore:GetAsync("player_" .. player.UserId)
		end)
		if ok then
			data = result
		else
			-- No guardamos encima de datos que no pudimos leer.
			canSave = false
			if store then
				warn("[Galería] No se pudo cargar a " .. player.Name .. ": " .. tostring(result))
			end
		end
	end
	data = reconcile(data)
	if player.Parent then
		profiles[player] = data
		loaded[player] = canSave
	end
	return data
end

function DataService.get(player)
	return profiles[player]
end

function DataService.save(player)
	local data = profiles[player]
	local currentStore = store
	if not (currentStore and data and loaded[player]) then
		return
	end
	local ok, result = withRetries(function()
		return currentStore:UpdateAsync("player_" .. player.UserId, function()
			return data
		end)
	end)
	if not ok then
		warn("[Galería] No se pudo guardar a " .. player.Name .. ": " .. tostring(result))
	end
end

function DataService.release(player)
	DataService.save(player)
	profiles[player] = nil
	loaded[player] = nil
end

function DataService.start()
	task.spawn(function()
		while true do
			task.wait(Config.AUTOSAVE_SECONDS)
			for _, player in ipairs(Players:GetPlayers()) do
				task.spawn(DataService.save, player)
			end
		end
	end)

	game:BindToClose(function()
		if RunService:IsStudio() and not store then
			return
		end
		local pending = 0
		for _, player in ipairs(Players:GetPlayers()) do
			pending += 1
			task.spawn(function()
				DataService.save(player)
				pending -= 1
			end)
		end
		local started = os.clock()
		while pending > 0 and os.clock() - started < 25 do
			task.wait(0.2)
		end
	end)
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">WorldBuilder</string>
            <string name="Source"><![CDATA[-- Construye todo el mundo por código: plaza, fuente, árboles y las galerías.
-- Así el juego funciona sin modelos externos ni assets que puedan fallar.

local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)

local WorldBuilder = {}

local PLOT_RADIUS = 120
local PLAZA_RADIUS = 58

local WALL_COLORS = {
	Color3.fromRGB(255, 196, 214),
	Color3.fromRGB(184, 236, 214),
	Color3.fromRGB(212, 196, 255),
	Color3.fromRGB(255, 214, 176),
	Color3.fromRGB(178, 220, 255),
	Color3.fromRGB(255, 236, 160),
}
local ACCENT_COLORS = {
	Color3.fromRGB(236, 72, 128),
	Color3.fromRGB(30, 170, 120),
	Color3.fromRGB(124, 92, 255),
	Color3.fromRGB(255, 120, 40),
	Color3.fromRGB(40, 130, 230),
	Color3.fromRGB(230, 170, 20),
}
local RAINBOW = {
	Color3.fromRGB(255, 90, 110),
	Color3.fromRGB(255, 170, 60),
	Color3.fromRGB(255, 225, 80),
	Color3.fromRGB(110, 220, 120),
	Color3.fromRGB(90, 170, 255),
	Color3.fromRGB(180, 120, 255),
}

local WOOD = Color3.fromRGB(196, 140, 96)
local DARK_WOOD = Color3.fromRGB(120, 78, 52)
local CREAM = Color3.fromRGB(255, 248, 236)
local GOLD = Color3.fromRGB(240, 190, 70)

-- Crea una pieza anclada con propiedades por defecto bonitas.
local function part(props)
	local p = Instance.new(props.Class or "Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for key, value in pairs(props) do
		if key ~= "Class" and key ~= "Parent" then
			p[key] = value
		end
	end
	p.Parent = props.Parent
	return p
end

local function cylinderUp(cf)
	return cf * CFrame.Angles(0, 0, math.rad(90))
end

local function addLight(parent, class, props)
	local light = Instance.new(class)
	for key, value in pairs(props) do
		light[key] = value
	end
	light.Parent = parent
	return light
end

local function surfaceText(parentPart, face, text, props)
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = props.pps or 40
	gui.LightInfluence = props.lightInfluence or 0
	gui.Parent = parentPart
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = props.font or Enum.Font.FredokaOne
	label.Text = text
	label.TextScaled = true
	label.TextColor3 = props.color or Color3.new(1, 1, 1)
	label.Parent = gui
	local padding = Instance.new("UIPadding")
	padding.PaddingLeft = UDim.new(0.04, 0)
	padding.PaddingRight = UDim.new(0.04, 0)
	padding.PaddingTop = UDim.new(0.08, 0)
	padding.PaddingBottom = UDim.new(0.08, 0)
	padding.Parent = label
	if props.stroke then
		local stroke = Instance.new("UIStroke")
		stroke.Color = props.stroke
		stroke.Thickness = props.strokeThickness or 3
		stroke.Parent = label
	end
	return label
end

-- Ambiente -----------------------------------------------------------------------
local function setupLighting()
	Lighting.ClockTime = 14.6
	Lighting.GeographicLatitude = 35
	Lighting.Brightness = 2.6
	Lighting.Ambient = Color3.fromRGB(105, 95, 120)
	Lighting.OutdoorAmbient = Color3.fromRGB(150, 140, 165)
	Lighting.EnvironmentDiffuseScale = 1
	Lighting.EnvironmentSpecularScale = 1
	Lighting.GlobalShadows = true
	Lighting.ShadowSoftness = 0.25

	for _, child in ipairs(Lighting:GetChildren()) do
		if child:IsA("PostEffect") or child:IsA("Atmosphere") or child:IsA("Sky") then
			child:Destroy()
		end
	end

	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Density = 0.28
	atmosphere.Offset = 0.15
	atmosphere.Color = Color3.fromRGB(214, 190, 235)
	atmosphere.Decay = Color3.fromRGB(150, 120, 190)
	atmosphere.Glare = 0.3
	atmosphere.Haze = 1.2
	atmosphere.Parent = Lighting

	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.55
	bloom.Size = 26
	bloom.Threshold = 1.4
	bloom.Parent = Lighting

	local color = Instance.new("ColorCorrectionEffect")
	color.Saturation = 0.18
	color.Contrast = 0.06
	color.Brightness = 0.02
	color.TintColor = Color3.fromRGB(255, 248, 242)
	color.Parent = Lighting

	local rays = Instance.new("SunRaysEffect")
	rays.Intensity = 0.06
	rays.Spread = 0.8
	rays.Parent = Lighting
end

-- Elementos decorativos -------------------------------------------------------
local function buildTree(parent, cf, scale, rng)
	local model = Instance.new("Model")
	model.Name = "Tree"
	local trunkHeight = 9 * scale
	part({
		Name = "Trunk",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(trunkHeight, 1.6 * scale, 1.6 * scale),
		CFrame = cylinderUp(cf * CFrame.new(0, trunkHeight / 2, 0)),
		Color = DARK_WOOD,
		Material = Enum.Material.Wood,
		Parent = model,
	})
	local leafColors = {
		Color3.fromRGB(110, 200, 110),
		Color3.fromRGB(90, 180, 100),
		Color3.fromRGB(255, 170, 200),
		Color3.fromRGB(130, 210, 120),
	}
	local leafColor = leafColors[rng:NextInteger(1, #leafColors)]
	for i = 1, 4 do
		local size = (6 + rng:NextNumber() * 3) * scale
		local offset = Vector3.new(rng:NextNumber(-2, 2), trunkHeight + rng:NextNumber(-1, 3), rng:NextNumber(-2, 2))
			* scale
		if i == 1 then
			offset = Vector3.new(0, trunkHeight + 1.5 * scale, 0)
		end
		part({
			Name = "Leaves",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(size, size, size),
			CFrame = cf * CFrame.new(offset),
			Color = leafColor:Lerp(Color3.new(1, 1, 1), rng:NextNumber() * 0.12),
			Material = Enum.Material.Grass,
			CanCollide = false,
			Parent = model,
		})
	end
	model.Parent = parent
end

local function buildLampPost(parent, cf)
	local model = Instance.new("Model")
	model.Name = "Lamp"
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(12, 0.7, 0.7),
		CFrame = cylinderUp(cf * CFrame.new(0, 6, 0)),
		Color = Color3.fromRGB(60, 50, 80),
		Material = Enum.Material.Metal,
		Parent = model,
	})
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.6, 2, 2),
		CFrame = cylinderUp(cf * CFrame.new(0, 0.3, 0)),
		Color = Color3.fromRGB(60, 50, 80),
		Material = Enum.Material.Metal,
		Parent = model,
	})
	local bulb = part({
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(2.2, 2.2, 2.2),
		CFrame = cf * CFrame.new(0, 12.6, 0),
		Color = Color3.fromRGB(255, 226, 170),
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = model,
	})
	addLight(
		bulb,
		"PointLight",
		{ Range = 18, Brightness = 1.3, Color = Color3.fromRGB(255, 214, 160), Shadows = false }
	)
	model.Parent = parent
end

local function buildBench(parent, cf)
	local model = Instance.new("Model")
	model.Name = "Bench"
	part({
		Size = Vector3.new(6, 0.4, 2),
		CFrame = cf * CFrame.new(0, 1.8, 0),
		Color = WOOD,
		Material = Enum.Material.WoodPlanks,
		Parent = model,
	})
	part({
		Size = Vector3.new(6, 1.6, 0.3),
		CFrame = cf * CFrame.new(0, 3, 0.9),
		Color = WOOD,
		Material = Enum.Material.WoodPlanks,
		Parent = model,
	})
	for _, x in ipairs({ -2.5, 2.5 }) do
		part({
			Size = Vector3.new(0.4, 1.6, 1.8),
			CFrame = cf * CFrame.new(x, 0.8, 0),
			Color = Color3.fromRGB(60, 50, 80),
			Material = Enum.Material.Metal,
			Parent = model,
		})
	end
	model.Parent = parent
end

local function buildFlowerBed(parent, cf, width, rng)
	part({
		Size = Vector3.new(width, 0.8, 3),
		CFrame = cf * CFrame.new(0, 0.4, 0),
		Color = Color3.fromRGB(110, 76, 56),
		Material = Enum.Material.Ground,
		Parent = parent,
	})
	local count = math.floor(width / 1.4)
	for i = 1, count do
		local x = -width / 2 + (i - 0.5) * (width / count)
		local z = rng:NextNumber(-0.8, 0.8)
		part({
			Size = Vector3.new(0.2, 1.2, 0.2),
			CFrame = cf * CFrame.new(x, 1.2, z),
			Color = Color3.fromRGB(80, 170, 80),
			CanCollide = false,
			Parent = parent,
		})
		part({
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(0.9, 0.9, 0.9),
			CFrame = cf * CFrame.new(x, 1.9, z),
			Color = RAINBOW[rng:NextInteger(1, #RAINBOW)],
			CanCollide = false,
			Parent = parent,
		})
	end
end

local function buildPlant(parent, cf, scale)
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(2.4 * scale, 2.4 * scale, 2.4 * scale),
		CFrame = cylinderUp(cf * CFrame.new(0, 1.2 * scale, 0)),
		Color = Color3.fromRGB(220, 120, 90),
		Material = Enum.Material.Slate,
		Parent = parent,
	})
	for i = 1, 3 do
		local angle = i * 2.1
		part({
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(2.6, 2.6, 2.6) * scale,
			CFrame = cf
				* CFrame.new(math.cos(angle) * 0.6 * scale, (3 + i * 0.8) * scale, math.sin(angle) * 0.6 * scale),
			Color = Color3.fromRGB(80 + i * 15, 180 + i * 10, 100),
			Material = Enum.Material.Grass,
			CanCollide = false,
			Parent = parent,
		})
	end
end

local function buildFountain(parent)
	local model = Instance.new("Model")
	model.Name = "Fountain"
	local base = CFrame.new(0, 0, 0)
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(2.4, 26, 26),
		CFrame = cylinderUp(base * CFrame.new(0, 1.2, 0)),
		Color = CREAM,
		Material = Enum.Material.Marble,
		Parent = model,
	})
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.4, 23, 23),
		CFrame = cylinderUp(base * CFrame.new(0, 2.3, 0)),
		Color = Color3.fromRGB(110, 200, 255),
		Material = Enum.Material.Glass,
		Transparency = 0.25,
		CanCollide = false,
		Parent = model,
	})
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(8, 3, 3),
		CFrame = cylinderUp(base * CFrame.new(0, 5, 0)),
		Color = CREAM,
		Material = Enum.Material.Marble,
		Parent = model,
	})
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(1, 11, 11),
		CFrame = cylinderUp(base * CFrame.new(0, 9, 0)),
		Color = CREAM,
		Material = Enum.Material.Marble,
		Parent = model,
	})
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.3, 9.6, 9.6),
		CFrame = cylinderUp(base * CFrame.new(0, 9.5, 0)),
		Color = Color3.fromRGB(110, 200, 255),
		Material = Enum.Material.Glass,
		Transparency = 0.25,
		CanCollide = false,
		Parent = model,
	})

	-- Escultura de pincel gigante sobre la fuente.
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(7, 1.2, 1.2),
		CFrame = cylinderUp(base * CFrame.new(0, 13, 0)),
		Color = Color3.fromRGB(236, 72, 128),
		Material = Enum.Material.SmoothPlastic,
		Parent = model,
	})
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(1.2, 1.5, 1.5),
		CFrame = cylinderUp(base * CFrame.new(0, 16.8, 0)),
		Color = GOLD,
		Material = Enum.Material.Metal,
		Parent = model,
	})
	local tip = part({
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(2.4, 2.4, 2.4),
		CFrame = base * CFrame.new(0, 18.2, 0),
		Color = Color3.fromRGB(124, 92, 255),
		Material = Enum.Material.Neon,
		Parent = model,
	})
	addLight(tip, "PointLight", { Range = 22, Brightness = 1.5, Color = Color3.fromRGB(190, 160, 255) })

	local sparkles = Instance.new("ParticleEmitter")
	sparkles.Rate = 12
	sparkles.Lifetime = NumberRange.new(1.5, 2.5)
	sparkles.Speed = NumberRange.new(2, 4)
	sparkles.SpreadAngle = Vector2.new(180, 180)
	sparkles.LightEmission = 1
	sparkles.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.6),
		NumberSequenceKeypoint.new(1, 0),
	})
	sparkles.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 160, 220)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(160, 220, 255)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 240, 160)),
	})
	sparkles.Parent = tip
	model.Parent = parent
end

-- Marcos de la galería ---------------------------------------------------------
local function buildFrame(parent, cf, name)
	local frame = Instance.new("Model")
	frame.Name = name
	part({
		Size = Vector3.new(7.4, 7.4, 0.5),
		CFrame = cf,
		Color = GOLD,
		Material = Enum.Material.Metal,
		Reflectance = 0.05,
		Parent = frame,
	})
	local canvas = part({
		Name = "Canvas",
		Size = Vector3.new(6.2, 6.2, 0.2),
		CFrame = cf * CFrame.new(0, 0, -0.3),
		Color = CREAM,
		Parent = frame,
	})
	canvas:SetAttribute("Cells", "")
	local plaque = part({
		Name = "Plaque",
		Size = Vector3.new(3.6, 0.9, 0.2),
		CFrame = cf * CFrame.new(0, -4.3, -0.1),
		Color = Color3.fromRGB(50, 40, 70),
		Parent = frame,
	})
	local plaqueLabel = surfaceText(plaque, Enum.NormalId.Front, "", { pps = 50, color = GOLD })
	plaqueLabel.Name = "PlaqueText"
	local lamp = part({
		Size = Vector3.new(2.4, 0.4, 0.6),
		CFrame = cf * CFrame.new(0, 4.4, -0.8),
		Color = Color3.fromRGB(50, 40, 70),
		Material = Enum.Material.Metal,
		CanCollide = false,
		Parent = frame,
	})
	addLight(lamp, "SpotLight", {
		Face = Enum.NormalId.Bottom,
		Angle = 70,
		Range = 10,
		Brightness = 2.2,
		Color = Color3.fromRGB(255, 236, 210),
	})
	frame.Parent = parent
	return canvas, plaqueLabel
end

local function buildEasel(parent, cf)
	local model = Instance.new("Model")
	model.Name = "Easel"
	for _, x in ipairs({ -1.8, 1.8 }) do
		part({
			Size = Vector3.new(0.4, 10, 0.4),
			CFrame = cf * CFrame.new(x, 5, 0) * CFrame.Angles(math.rad(-8), 0, math.rad(x > 0 and 8 or -8)),
			Color = WOOD,
			Material = Enum.Material.Wood,
			Parent = model,
		})
	end
	part({
		Size = Vector3.new(0.4, 9, 0.4),
		CFrame = cf * CFrame.new(0, 4.5, 1.4) * CFrame.Angles(math.rad(14), 0, 0),
		Color = WOOD,
		Material = Enum.Material.Wood,
		Parent = model,
	})
	part({
		Size = Vector3.new(6, 0.4, 0.9),
		CFrame = cf * CFrame.new(0, 3.9, -0.5),
		Color = WOOD,
		Material = Enum.Material.Wood,
		Parent = model,
	})
	local canvas = part({
		Name = "Canvas",
		Size = Vector3.new(5.6, 5.6, 0.25),
		CFrame = cf * CFrame.new(0, 6.95, -0.35) * CFrame.Angles(math.rad(-8), 0, 0),
		Color = CREAM,
		Parent = model,
	})
	canvas:SetAttribute("Cells", "")
	-- Paleta de pintor apoyada.
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.2, 2.6, 2.6),
		CFrame = cf * CFrame.new(2.6, 4.2, -0.6) * CFrame.Angles(0, math.rad(90), 0),
		Color = Color3.fromRGB(230, 190, 140),
		Parent = model,
	})
	for i, color in ipairs(RAINBOW) do
		local angle = i * 0.9
		part({
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(0.45, 0.45, 0.45),
			CFrame = cf * CFrame.new(2.6 + math.cos(angle) * 0.8, 4.2 + math.sin(angle) * 0.8, -0.75),
			Color = color,
			CanCollide = false,
			Parent = model,
		})
	end
	model.Parent = parent
	return canvas
end

-- Decoraciones que aparecen al subir la mejora "Decoración".
local DECOR_BUILDERS = {
	function(folder, L)
		buildPlant(folder, L(-7.5, 0, -21.5), 1.1)
		buildPlant(folder, L(7.5, 0, -21.5), 1.1)
	end,
	function(folder, L)
		part({
			Size = Vector3.new(5, 0.12, 22),
			CFrame = L(0, 1.06, -8),
			Color = Color3.fromRGB(200, 40, 70),
			Material = Enum.Material.Fabric,
			CanCollide = false,
			Parent = folder,
		})
		for _, x in ipairs({ -2.6, 2.6 }) do
			part({
				Size = Vector3.new(0.25, 0.14, 22),
				CFrame = L(x, 1.07, -8),
				Color = GOLD,
				Material = Enum.Material.Fabric,
				CanCollide = false,
				Parent = folder,
			})
		end
	end,
	function(folder, L)
		part({
			Size = Vector3.new(3, 3, 3),
			CFrame = L(-17, 2.5, -12),
			Color = CREAM,
			Material = Enum.Material.Marble,
			Parent = folder,
		})
		local shapes = { Enum.PartType.Ball, Enum.PartType.Block, Enum.PartType.Ball }
		for i, shape in ipairs(shapes) do
			local s = 2.4 - i * 0.4
			part({
				Shape = shape,
				Size = Vector3.new(s, s, s),
				CFrame = L(-17, 3.5 + i * 1.7, -12) * CFrame.Angles(i, i * 0.7, 0),
				Color = RAINBOW[i * 2],
				Material = Enum.Material.Glass,
				Transparency = 0.15,
				CanCollide = false,
				Parent = folder,
			})
		end
	end,
	function(folder, L)
		for i = 0, 22 do
			local x = -22 + i * 2
			local bulb = part({
				Shape = Enum.PartType.Ball,
				Size = Vector3.new(0.7, 0.7, 0.7),
				CFrame = L(x, 11.9 - math.sin(i * 0.55) ^ 2 * 0.6, -23.4),
				Color = RAINBOW[i % #RAINBOW + 1],
				Material = Enum.Material.Neon,
				CanCollide = false,
				Parent = folder,
			})
			if i % 4 == 0 then
				addLight(bulb, "PointLight", { Range = 8, Brightness = 0.8, Color = bulb.Color })
			end
		end
	end,
	function(folder, L)
		part({
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.4, 5, 5),
			CFrame = cylinderUp(L(0, 16.5, 9)),
			Color = GOLD,
			Material = Enum.Material.Metal,
			CanCollide = false,
			Parent = folder,
		})
		part({
			Size = Vector3.new(0.2, 2.5, 0.2),
			CFrame = L(0, 17.9, 9),
			Color = GOLD,
			Material = Enum.Material.Metal,
			CanCollide = false,
			Parent = folder,
		})
		for i = 1, 8 do
			local angle = i / 8 * math.pi * 2
			part({
				Shape = Enum.PartType.Ball,
				Size = Vector3.new(0.8, 0.8, 0.8),
				CFrame = L(math.cos(angle) * 2.5, 16.1, 9 + math.sin(angle) * 2.5),
				Color = Color3.fromRGB(220, 240, 255),
				Material = Enum.Material.Neon,
				CanCollide = false,
				Parent = folder,
			})
		end
		local core = part({
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(1.4, 1.4, 1.4),
			CFrame = L(0, 15.6, 9),
			Color = Color3.fromRGB(200, 230, 255),
			Material = Enum.Material.Glass,
			Transparency = 0.2,
			CanCollide = false,
			Parent = folder,
		})
		addLight(core, "PointLight", { Range = 20, Brightness = 1.2, Color = Color3.fromRGB(230, 240, 255) })
	end,
	function(folder, L)
		local index = 0
		for step = 0, 16 do
			local angle = math.pi * step / 16
			index += 1
			part({
				Shape = Enum.PartType.Ball,
				Size = Vector3.new(1.4, 1.4, 1.4),
				CFrame = L(math.cos(angle) * 6.2, 7 + math.sin(angle) * 5.6, -19.9),
				Color = RAINBOW[index % #RAINBOW + 1],
				Material = Enum.Material.SmoothPlastic,
				Reflectance = 0.15,
				CanCollide = false,
				Parent = folder,
			})
		end
		for _, x in ipairs({ -6.2, 6.2 }) do
			for y = 1.7, 6.5, 1.3 do
				index += 1
				part({
					Shape = Enum.PartType.Ball,
					Size = Vector3.new(1.4, 1.4, 1.4),
					CFrame = L(x, y, -19.9),
					Color = RAINBOW[index % #RAINBOW + 1],
					Reflectance = 0.15,
					CanCollide = false,
					Parent = folder,
				})
			end
		end
	end,
}
WorldBuilder.DECOR_LEVELS = #DECOR_BUILDERS

-- Galería de un jugador -----------------------------------------------------------
local function buildPlot(parent, index, plotCF, rng)
	local wallColor = WALL_COLORS[index]
	local accent = ACCENT_COLORS[index]
	local function L(x, y, z)
		return plotCF * CFrame.new(x, y, z)
	end

	local model = Instance.new("Model")
	model.Name = "Plot" .. index
	model:SetAttribute("Index", index)
	model:SetAttribute("OwnerUserId", 0)

	local shop = Instance.new("Model")
	shop.Name = "Shop"
	shop.Parent = model

	-- Suelo, alfombra y camino hasta la plaza.
	part({
		Name = "Floor",
		Size = Vector3.new(46, 1, 38),
		CFrame = L(0, 0.5, 0),
		Color = WOOD,
		Material = Enum.Material.WoodPlanks,
		Parent = shop,
	})
	part({
		Size = Vector3.new(18, 0.1, 11),
		CFrame = L(0, 1.05, -9),
		Color = accent:Lerp(Color3.new(1, 1, 1), 0.55),
		Material = Enum.Material.Fabric,
		CanCollide = false,
		Parent = shop,
	})
	part({
		Size = Vector3.new(16.6, 0.12, 9.6),
		CFrame = L(0, 1.06, -9),
		Color = accent:Lerp(Color3.new(1, 1, 1), 0.25),
		Material = Enum.Material.Fabric,
		CanCollide = false,
		Parent = shop,
	})
	local pathLength = PLOT_RADIUS - PLAZA_RADIUS - 19
	part({
		Size = Vector3.new(10, 0.4, pathLength),
		CFrame = L(0, 0.2, -19 - pathLength / 2),
		Color = Color3.fromRGB(230, 214, 190),
		Material = Enum.Material.Cobblestone,
		Parent = shop,
	})
	part({
		Size = Vector3.new(8, 0.15, 3),
		CFrame = L(0, 1.07, -16.6),
		Color = accent,
		Material = Enum.Material.Fabric,
		CanCollide = false,
		Parent = shop,
	})

	-- Paredes.
	part({ Size = Vector3.new(46, 18, 1), CFrame = L(0, 10, 18.5), Color = wallColor, Parent = shop })
	part({ Size = Vector3.new(1, 18, 38), CFrame = L(-22.5, 10, 0), Color = wallColor, Parent = shop })
	part({ Size = Vector3.new(1, 18, 38), CFrame = L(22.5, 10, 0), Color = wallColor, Parent = shop })
	for _, side in ipairs({ -1, 1 }) do
		local cx = side * 14
		part({ Size = Vector3.new(18, 3, 1), CFrame = L(cx, 2.5, -18.5), Color = wallColor, Parent = shop })
		part({ Size = Vector3.new(18, 6, 1), CFrame = L(cx, 16, -18.5), Color = wallColor, Parent = shop })
		part({
			Size = Vector3.new(18, 9, 0.3),
			CFrame = L(cx, 8.5, -18.5),
			Color = Color3.fromRGB(200, 235, 255),
			Material = Enum.Material.Glass,
			Transparency = 0.65,
			Parent = shop,
		})
		part({ Size = Vector3.new(0.4, 9, 0.6), CFrame = L(cx, 8.5, -18.5), Color = CREAM, Parent = shop })
		part({ Size = Vector3.new(18, 0.4, 0.6), CFrame = L(cx, 8.5, -18.5), Color = CREAM, Parent = shop })
	end
	part({ Size = Vector3.new(10, 6, 1), CFrame = L(0, 16, -18.5), Color = wallColor, Parent = shop })
	-- Molduras.
	for _, z in ipairs({ -18.5, 18.5 }) do
		part({ Size = Vector3.new(46.4, 0.8, 1.4), CFrame = L(0, 19, z), Color = CREAM, Parent = shop })
		part({ Size = Vector3.new(46.4, 0.6, 1.3), CFrame = L(0, 1.3, z), Color = CREAM, Parent = shop })
	end
	for _, x in ipairs({ -22.5, 22.5 }) do
		part({ Size = Vector3.new(1.4, 0.8, 38), CFrame = L(x, 19, 0), Color = CREAM, Parent = shop })
	end
	for _, x in ipairs({ -5.4, 5.4, -22.8, 22.8 }) do
		part({ Size = Vector3.new(1, 18, 1.4), CFrame = L(x, 10, -18.6), Color = CREAM, Parent = shop })
	end

	-- Techo y letrero.
	part({ Size = Vector3.new(48, 1.2, 40), CFrame = L(0, 19.9, 0), Color = Color3.fromRGB(70, 60, 90), Parent = shop })
	part({
		Size = Vector3.new(26, 5.4, 0.8),
		CFrame = L(0, 23.2, -18.7),
		Color = Color3.fromRGB(50, 40, 70),
		Parent = shop,
	})
	local signPart = part({
		Name = "Sign",
		Size = Vector3.new(24.8, 4.4, 0.3),
		CFrame = L(0, 23.2, -19.2),
		Color = Color3.fromRGB(60, 48, 84),
		Parent = shop,
	})
	local signLabel = surfaceText(signPart, Enum.NormalId.Front, "Galería libre", {
		pps = 30,
		color = Color3.fromRGB(255, 244, 220),
		stroke = accent,
		strokeThickness = 4,
	})
	signLabel.Name = "SignText"
	for _, data in ipairs({
		{ Vector3.new(26, 0.35, 0.35), CFrame.new(0, 2.85, 0) },
		{ Vector3.new(26, 0.35, 0.35), CFrame.new(0, -2.85, 0) },
		{ Vector3.new(0.35, 6, 0.35), CFrame.new(13, 0, 0) },
		{ Vector3.new(0.35, 6, 0.35), CFrame.new(-13, 0, 0) },
	}) do
		local neon = part({
			Size = data[1],
			CFrame = L(0, 23.2, -19.2) * data[2],
			Color = accent,
			Material = Enum.Material.Neon,
			CanCollide = false,
			Parent = shop,
		})
		neon.Name = "SignNeon"
	end
	addLight(
		signPart,
		"SurfaceLight",
		{ Face = Enum.NormalId.Front, Range = 10, Brightness = 1.2, Color = accent, Angle = 80 }
	)

	-- Toldo de rayas sobre las ventanas (lonas inclinadas con faldón).
	for side = -1, 1, 2 do
		for i = 0, 3 do
			local x = side * (5.75 + 2.25 + i * 4.5)
			local stripe = (i % 2 == 0) and accent or Color3.new(1, 1, 1)
			part({
				Size = Vector3.new(4.5, 0.3, 4.8),
				CFrame = L(x, 14.2, -20.8) * CFrame.Angles(math.rad(-28), 0, 0),
				Color = stripe,
				Material = Enum.Material.Fabric,
				CanCollide = false,
				Parent = shop,
			})
			part({
				Size = Vector3.new(4.5, 0.9, 0.2),
				CFrame = L(x, 12.75, -22.9),
				Color = stripe,
				Material = Enum.Material.Fabric,
				CanCollide = false,
				Parent = shop,
			})
		end
	end

	-- Mostrador.
	part({
		Size = Vector3.new(14, 4, 3),
		CFrame = L(0, 3, 4),
		Color = DARK_WOOD,
		Material = Enum.Material.Wood,
		Parent = shop,
	})
	part({ Size = Vector3.new(14.2, 0.6, 0.2), CFrame = L(0, 4.3, 2.45), Color = accent, Parent = shop })
	part({
		Size = Vector3.new(15, 0.5, 3.8),
		CFrame = L(0, 5.25, 4),
		Color = CREAM,
		Material = Enum.Material.Marble,
		Parent = shop,
	})
	part({
		Size = Vector3.new(2.2, 1.4, 1.8),
		CFrame = L(4.5, 6.2, 4.2),
		Color = Color3.fromRGB(70, 60, 90),
		Parent = shop,
	})
	part({
		Size = Vector3.new(1.8, 0.9, 0.2),
		CFrame = L(4.5, 7.2, 4.6) * CFrame.Angles(math.rad(-20), 0, 0),
		Color = Color3.fromRGB(120, 255, 190),
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = shop,
	})
	for i = 1, 5 do
		part({
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(1.2, 0.8, 0.8),
			CFrame = cylinderUp(L(-5.5 + i * 0.9, 6.1, 4)),
			Color = RAINBOW[i],
			Parent = shop,
		})
	end

	-- Estantería con botes de pintura.
	part({
		Size = Vector3.new(8, 0.4, 2),
		CFrame = L(-17.5, 6, 17.2),
		Color = WOOD,
		Material = Enum.Material.Wood,
		Parent = shop,
	})
	part({
		Size = Vector3.new(8, 0.4, 2),
		CFrame = L(-17.5, 3, 17.2),
		Color = WOOD,
		Material = Enum.Material.Wood,
		Parent = shop,
	})
	for i = 1, 6 do
		for row = 0, 1 do
			part({
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(1.4, 1.1, 1.1),
				CFrame = cylinderUp(L(-21 + i * 1.15, 3.9 + row * 3, 17.2)),
				Color = RAINBOW[(i + row * 3) % #RAINBOW + 1],
				Parent = shop,
			})
		end
	end

	-- Lámparas colgantes.
	for _, pos in ipairs({ Vector3.new(-12, 0, -2), Vector3.new(12, 0, -2), Vector3.new(0, 0, -10) }) do
		part({
			Size = Vector3.new(0.15, 3, 0.15),
			CFrame = L(pos.X, 17.8, pos.Z),
			Color = Color3.fromRGB(40, 30, 50),
			CanCollide = false,
			Parent = shop,
		})
		part({
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(1, 2.6, 2.6),
			CFrame = cylinderUp(L(pos.X, 16.2, pos.Z)),
			Color = accent,
			CanCollide = false,
			Parent = shop,
		})
		local bulb = part({
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(1.3, 1.3, 1.3),
			CFrame = L(pos.X, 15.6, pos.Z),
			Color = Color3.fromRGB(255, 230, 180),
			Material = Enum.Material.Neon,
			CanCollide = false,
			Parent = shop,
		})
		addLight(
			bulb,
			"PointLight",
			{ Range = 22, Brightness = 1.2, Color = Color3.fromRGB(255, 220, 180), Shadows = true }
		)
	end

	-- Plantas interiores.
	buildPlant(shop, L(19.5, 1, 15.5), 1)
	buildPlant(shop, L(-19.5, 1, -15.5), 0.9)
	buildPlant(shop, L(19.5, 1, -15.5), 0.9)

	-- Puestos de espera con cojines.
	local spots = {}
	for i, x in ipairs({ -12, -6, 0, 6, 12 }) do
		part({
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.2, 3.2, 3.2),
			CFrame = cylinderUp(L(x, 1.1, -3.5)),
			Color = (i % 2 == 0) and accent or CREAM,
			Material = Enum.Material.Fabric,
			CanCollide = false,
			Parent = shop,
		})
		spots[i] = L(x, 1, -3.5)
	end

	-- Galería en las paredes.
	local gallery = Instance.new("Folder")
	gallery.Name = "Gallery"
	gallery.Parent = model
	local frameCFrames = {
		L(-12, 11, 17.9),
		L(0, 11.5, 17.9),
		L(12, 11, 17.9),
		L(-21.9, 11, 8) * CFrame.Angles(0, -math.pi / 2, 0),
		L(-21.9, 11, -6) * CFrame.Angles(0, -math.pi / 2, 0),
		L(21.9, 11, 8) * CFrame.Angles(0, math.pi / 2, 0),
		L(21.9, 11, -6) * CFrame.Angles(0, math.pi / 2, 0),
	}
	local canvases, plaques = {}, {}
	for i = 1, Config.GALLERY_SIZE do
		canvases[i], plaques[i] = buildFrame(gallery, frameCFrames[i], "Frame" .. i)
	end
	local easelCanvas = buildEasel(shop, L(13, 1, 11) * CFrame.Angles(0, math.rad(-25), 0))

	local decor = Instance.new("Folder")
	decor.Name = "Decor"
	decor.Parent = model

	local customers = Instance.new("Folder")
	customers.Name = "Customers"
	customers.Parent = model

	-- Exterior: jardineras junto a la entrada.
	buildFlowerBed(shop, L(-14, 0, -24.5), 16, rng)
	buildFlowerBed(shop, L(14, 0, -24.5), 16, rng)

	model.Parent = parent

	return {
		index = index,
		model = model,
		cframe = plotCF,
		spots = spots,
		entrance = L(0, 0.4, -24),
		inside = L(0, 1, -12),
		street = L(0, 0.4, -(PLOT_RADIUS - PLAZA_RADIUS) + 4),
		ownerSpawn = L(0, 4, 9),
		signLabel = signLabel,
		canvases = canvases,
		plaques = plaques,
		easelCanvas = easelCanvas,
		decorFolder = decor,
		customersFolder = customers,
		decorBuilt = 0,
		L = L,
	}
end

-- Construye las decoraciones hasta el nivel indicado (o las quita si baja).
function WorldBuilder.setDecorLevel(plot, level)
	if level < plot.decorBuilt then
		plot.decorFolder:ClearAllChildren()
		plot.decorBuilt = 0
	end
	for i = plot.decorBuilt + 1, math.min(level, #DECOR_BUILDERS) do
		local folder = Instance.new("Folder")
		folder.Name = "Decor" .. i
		DECOR_BUILDERS[i](folder, plot.L)
		folder.Parent = plot.decorFolder
		plot.decorBuilt = i
	end
end

function WorldBuilder.build()
	setupLighting()

	local world = Instance.new("Folder")
	world.Name = "World"
	world.Parent = Workspace

	local rng = Random.new(2024)

	part({
		Name = "Ground",
		Size = Vector3.new(800, 4, 800),
		CFrame = CFrame.new(0, -2, 0),
		Color = Color3.fromRGB(120, 200, 110),
		Material = Enum.Material.Grass,
		Parent = world,
	})
	part({
		Name = "Plaza",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.4, PLAZA_RADIUS * 2, PLAZA_RADIUS * 2),
		CFrame = cylinderUp(CFrame.new(0, 0.2, 0)),
		Color = Color3.fromRGB(236, 222, 200),
		Material = Enum.Material.Cobblestone,
		Parent = world,
	})
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.45, 40, 40),
		CFrame = cylinderUp(CFrame.new(0, 0.22, 0)),
		Color = Color3.fromRGB(214, 196, 240),
		Material = Enum.Material.Pavement,
		Parent = world,
	})
	buildFountain(world)

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "PlazaSpawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(8, 0.4, 8)
	spawn.CFrame = CFrame.new(26, 0.6, 0)
	spawn.Color = Color3.fromRGB(255, 196, 214)
	spawn.Material = Enum.Material.SmoothPlastic
	spawn.Duration = 0
	spawn.Neutral = true
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.Parent = world

	-- Jardineras redondas alrededor de la fuente, entre los caminos.
	for i = 0, Config.MAX_PLOTS - 1 do
		local angle = (i + 0.5) / Config.MAX_PLOTS * math.pi * 2
		local center = CFrame.new(math.cos(angle) * 30, 0, math.sin(angle) * 30)
		part({
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(1.6, 9, 9),
			CFrame = cylinderUp(center * CFrame.new(0, 0.8, 0)),
			Color = CREAM,
			Material = Enum.Material.Marble,
			Parent = world,
		})
		part({
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.4, 8, 8),
			CFrame = cylinderUp(center * CFrame.new(0, 1.5, 0)),
			Color = Color3.fromRGB(110, 76, 56),
			Material = Enum.Material.Ground,
			Parent = world,
		})
		for f = 1, 10 do
			local a = f / 10 * math.pi * 2
			local r = (f % 2 == 0) and 2.6 or 1.4
			part({
				Shape = Enum.PartType.Ball,
				Size = Vector3.new(1.3, 1.3, 1.3),
				CFrame = center * CFrame.new(math.cos(a) * r, 2.3 + (f % 3) * 0.3, math.sin(a) * r),
				Color = RAINBOW[(i + f) % #RAINBOW + 1],
				CanCollide = false,
				Parent = world,
			})
		end
		part({
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(3.4, 3.4, 3.4),
			CFrame = center * CFrame.new(0, 3.2, 0),
			Color = Color3.fromRGB(110, 200, 110),
			Material = Enum.Material.Grass,
			CanCollide = false,
			Parent = world,
		})
	end

	for i = 0, 11 do
		local angle = (i + 0.5) / 12 * math.pi * 2
		local pos = Vector3.new(math.cos(angle), 0, math.sin(angle)) * (PLAZA_RADIUS - 4)
		buildLampPost(world, CFrame.new(pos))
		if i % 2 == 0 then
			buildBench(world, CFrame.lookAt(pos * 0.82, Vector3.new(0, 0, 0)))
		end
	end

	-- Árboles entre galerías y alrededor del mundo.
	for i = 0, Config.MAX_PLOTS - 1 do
		local angle = (i + 0.5) / Config.MAX_PLOTS * math.pi * 2
		for _, radius in ipairs({ 86, 118, 150 }) do
			local jitter = Vector3.new(rng:NextNumber(-6, 6), 0, rng:NextNumber(-6, 6))
			local pos = Vector3.new(math.cos(angle), 0, math.sin(angle)) * radius + jitter
			buildTree(world, CFrame.new(pos), rng:NextNumber(0.9, 1.3), rng)
		end
	end
	for i = 1, 40 do
		local angle = i / 40 * math.pi * 2 + rng:NextNumber(-0.05, 0.05)
		local radius = rng:NextNumber(185, 240)
		buildTree(world, CFrame.new(math.cos(angle) * radius, 0, math.sin(angle) * radius), rng:NextNumber(1, 1.6), rng)
	end

	local plotsFolder = Instance.new("Folder")
	plotsFolder.Name = "Plots"
	plotsFolder.Parent = Workspace

	local plots = {}
	for i = 1, Config.MAX_PLOTS do
		local angle = (i - 1) / Config.MAX_PLOTS * math.pi * 2
		local position = Vector3.new(math.cos(angle), 0, math.sin(angle)) * PLOT_RADIUS
		local plotCF = CFrame.lookAt(position, Vector3.new(0, 0, 0))
		plots[i] = buildPlot(plotsFolder, i, plotCF, rng)
	end
	return plots
end

return WorldBuilder
]]></string>
