			"ckgggggdgggggrkc",
			"cckggrgggggggkcc",
			"ccckkkkuukkkkccc",
			"cccccckuukcccccc",
			"cccccckuukcccccc",
			"cccccckuukcccccc",
			"ggggggkuukgggggg",
			"gggggggggggggggg",
		},
	},
	{
		id = "pulpo",
		name = "Pulpo",
		level = 13,
		reward = 250,
		xp = 46,
		patience = 120,
		rows = {
			"bbbbbbbbbbbbbcbb",
			"bbbbbkkkkkkbbbbb",
			"bbbbkppppppkbbcb",
			"bbbkppppppppkbbb",
			"bbkppwpppppppkbb",
			"bbkpwkppppwkpkbb",
			"bbkppppppppppkbb",
			"bbkppppmmppppkbb",
			"bbkppppppppppkbb",
			"bkppkppkkppkppkb",
			"bkppkppkkppkppkb",
			"kppkbkpkkpkbkppk",
			"kpkbbkpkkpkbbkpk",
			"bkbbbkpkkpkbbbkb",
			"bbbbbbkbbkbbbbbb",
			"bcbbbbbbbbbbbbbb",
		},
	},
	{
		id = "luna",
		name = "Luna y Estrellas",
		level = 15,
		reward = 300,
		xp = 55,
		patience = 125,
		rows = {
			"nnnnnnnnnnnnnnnn",
			"nnnnkkkknnnnnnnn",
			"nnnkyyyykknnnynn",
			"nnkyyyykknnnnnnn",
			"nkyyyyknnnnnnnnn",
			"nkyyyknnnnnnynnn",
			"kyyyyknnnnnyyynn",
			"kyyyyknnnnnnynnn",
			"kyyyyknnnnnnnnnn",
			"kyyyyyknnnnnnnnn",
			"nkyyyyyknnnnnnnn",
			"nkyyyyyykkknnnnn",
			"nnkkyyyyyyykknnn",
			"nnnnkkkkkkkknnwn",
			"nwnnnnnnnnnnnnnn",
			"nnnnnnnnwnnnnnnn",
		},
	},
}

Templates.ById = {}
for index, template in ipairs(Templates.List) do
	template.index = index
	template.flat = table.concat(template.rows)
	Templates.ById[template.id] = template
end

function Templates.get(id)
	return Templates.ById[id]
end

-- Devuelve las plantillas desbloqueadas para un nivel dado.
function Templates.unlockedFor(level)
	local result = {}
	for _, template in ipairs(Templates.List) do
		if template.level <= level then
			table.insert(result, template)
		end
	end
	return result
end

-- Siguiente plantilla que se desbloqueará (o nil si ya están todas).
function Templates.nextUnlock(level)
	for _, template in ipairs(Templates.List) do
		if template.level > level then
			return template
		end
	end
	return nil
end

return Templates
]]></string>
