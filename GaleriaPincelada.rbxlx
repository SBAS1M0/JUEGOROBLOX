      <Item class="Folder" referent="18">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="LocalScript" referent="19">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- Punto de entrada del cliente: conecta las ventanas con el servidor.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")

local UI = script.Parent:WaitForChild("UI")
local Theme = require(UI.Theme)
local HUD = require(UI.HUD)
local Machine = require(UI.Machine)
local DesignPicker = require(UI.DesignPicker)
local ColorPicker = require(UI.ColorPicker)
local Painter = require(UI.Painter)
local Shop = require(UI.Shop)
local Daily = require(UI.Daily)
local Tutorial = require(UI.Tutorial)
local World = require(script.Parent:WaitForChild("World"))

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Colors = require(Shared.Colors)

local remotes = ReplicatedStorage:WaitForChild("Remotes")

local app = { state = nil, remotes = {} }
for _, name in ipairs({
	"GetState",
	"StateChanged",
	"Notify",
	"Roll",
	"SetAutoRoll",
	"RollResult",
	"OpenDesigns",
	"UnlockDesign",
	"StartPainting",
	"CancelPainting",
	"FinishPainting",
	"BuyUpgrade",
	"ClaimDaily",
	"ClaimQuest",
	"GoHome",
}) do
	app.remotes[name] = remotes:WaitForChild(name)
end

-- Último cuadro empezado (para retomarlo si se cierra la ventana).
local lastPainting = nil

function app.notify(text, kind)
	HUD.notify(text, kind)
end

function app.celebrate()
	HUD.celebrate()
end

function app.openShop()
	Shop.open()
end

function app.openCollection()
	Machine.openCollection()
end

function app.openDaily()
	Daily.open()
end

function app.openDesigns()
	if Painter.isOpen() then
		return
	end
	DesignPicker.open()
end

function app.openColorPicker(design)
	ColorPicker.open(design)
end

function app.openPainter(design, colors)
	lastPainting = { design = design, colors = colors }
	Painter.open(design, colors)
end

function app.resumePainting()
	if Painter.isOpen() then
		return
	end
	if lastPainting and app.state and app.state.painting == lastPainting.design.id then
		Painter.open(lastPainting.design, lastPainting.colors)
	else
		app.remotes.CancelPainting:FireServer()
	end
end

-- ¿Hay alguna ventana grande abierta? (oculta el tutorial mientras tanto)
function app.isBusy()
	return Painter.isOpen() or DesignPicker.isOpen()
end

function app.setHudVisible(visible)
	HUD.setVisible(visible)
	Machine.setVisible(visible)
end

local claimingQuest = false
function app.claimQuest(index)
	if claimingQuest then
		return
	end
	claimingQuest = true
	local ok, success, result = pcall(function()
		return app.remotes.ClaimQuest:InvokeServer(index)
	end)
	claimingQuest = false
	if ok and success and type(result) == "table" then
		Theme.playSound("success", 1.15)
		app.notify("📜 ¡Misión completada! +💵" .. Theme.formatNumber(result.reward), "gold")
		local bonus = Colors.ById[result.bonusColor or ""]
		if bonus then
			app.notify("🎉 ¡Bonus del día! Ganaste «" .. bonus.name .. "»", "gold")
			app.celebrate()
		end
	end
end

local function applyState(state)
	if type(state) ~= "table" then
		return
	end
	app.state = state
	HUD.applyState(state)
	Machine.applyState(state)
	Shop.refresh()
	DesignPicker.refresh()
	ColorPicker.refresh()
	Daily.refresh()
end

pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
end)

HUD.init(app)
Machine.init(app)
DesignPicker.init(app)
ColorPicker.init(app)
Painter.init(app)
Shop.init(app)
Daily.init(app)
Tutorial.init(app)
World.start()

app.remotes.StateChanged.OnClientEvent:Connect(applyState)
app.remotes.Notify.OnClientEvent:Connect(function(text, kind)
	app.notify(text, kind)
end)
app.remotes.RollResult.OnClientEvent:Connect(function(colorId, auto)
	Machine.onRoll(colorId, auto)
end)
app.remotes.OpenDesigns.OnClientEvent:Connect(function()
	app.openDesigns()
end)

task.spawn(function()
	local ok, state = pcall(function()
		return app.remotes.GetState:InvokeServer()
	end)
	if ok and state and not app.state then
		applyState(state)
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="20">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="21">
            <Properties>
              <string name="Name">ColorPicker</string>
              <string name="Source"><![CDATA[-- Ventana "Elige tus colores": un color por área antes de empezar a pintar.
-- Los colores raros multiplican el valor del cuadro.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Colors = require(Shared.Colors)
local Config = require(Shared.Config)

local Theme = require(script.Parent.Theme)
local DesignArt = require(script.Parent.DesignArt)

local ColorPicker = {}

local C = Theme.Colors

local app
local window
local refs = {}
local design
local choices = {}
local selectedArea
local preview
local areaRows = {}
local remembered = {}
local busy = false

local function owned(colorId)
	local entry = Colors.ById[colorId]
	if entry and entry.basic then
		return math.huge
	end
	return app.state and app.state.paints[colorId] or 0
end

-- Unidades libres de un color sin contar el área indicada.
local function remaining(colorId, exceptArea)
	local used = 0
	for areaId, chosen in pairs(choices) do
		if chosen == colorId and areaId ~= exceptArea then
			used += 1
		end
	end
	return owned(colorId) - used
end

local function rarityInfo(colorId)
	local entry = Colors.ById[colorId]
	local rarity = Colors.rarityOf(entry)
	return rarity, string.format("%s x%.1f", rarity.name, rarity.mult)
end

local function updateValue()
	if not design then
		return
	end
	local state = app.state
	local mult = Config.colorMultiplier(design, choices)
	local value = Config.paintingValue(design, choices, state.upgrades, state.made[design.id] or 0, 1)
	refs.multiplier.Text = string.format("x%.2f", mult)
	refs.value.Text = "💵 "
		.. Theme.formatNumber(value)
		.. "  (hasta "
		.. Theme.formatNumber(math.floor(value * (1 + Config.STAR_BONUS[3])))
		.. " con ⭐⭐⭐)"
	refs.multBar.Set(math.clamp((mult - 1) / 5, 0, 1), true)
	preview.setColors(choices)
end

local function refreshAreas()
	for _, row in pairs(areaRows) do
		local areaId = row.area.id
		local selected = areaId == selectedArea
		row.body.BackgroundColor3 = selected and C.PrimaryLight or C.Panel
		row.stroke.Color = selected and C.Primary or C.Border
		row.stroke.Thickness = selected and 2.5 or 1.5
		DesignArt.swatch(row.swatch, choices[areaId])
		local entry = Colors.ById[choices[areaId]]
		local rarity = rarityInfo(choices[areaId])
		row.colorName.Text = entry and entry.name or ""
		row.colorName.TextColor3 = entry and entry.basic and C.InkSoft or rarity.color
	end
end

local function sortedColors()
	local list = {}
	for _, entry in ipairs(Colors.List) do
		if not entry.basic and owned(entry.id) > 0 then
			table.insert(list, entry)
		end
	end
	table.sort(list, function(a, b)
		local ra, rb = Colors.rarityOf(a).index, Colors.rarityOf(b).index
		if ra ~= rb then
			return ra > rb
		end
		return a.index < b.index
	end)
	for _, entry in ipairs(Colors.List) do
		if entry.basic then
			table.insert(list, entry)
		end
	end
	return list
end

local function refreshColors()
	local area = design.areaById[selectedArea]
	refs.colorsTitle.Text = "Pintura para «" .. area.name .. "»"
	for _, child in ipairs(refs.grid:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	for order, entry in ipairs(sortedColors()) do
		local free = remaining(entry.id, selectedArea)
		local selected = choices[selectedArea] == entry.id
		local rarity, rarityLabel = rarityInfo(entry.id)
		local holder, body = Theme.card({
			Name = entry.id,
			Size = UDim2.fromOffset(112, 128),
			Radius = 16,
			LayoutOrder = order,
			Color = selected and C.PrimaryLight or C.Panel,
			StrokeColor = selected and C.Primary or C.Border,
			StrokeThickness = selected and 3 or 1.5,
			Parent = refs.grid,
		})
		local cell = Theme.new("TextButton", {
			Name = entry.id,
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Text = "",
			ZIndex = 3,
			Parent = body,
		})
		local swatch = Theme.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0, 10),
			Size = UDim2.fromOffset(58, 58),
			Parent = body,
		}, { Theme.round() })
		DesignArt.swatch(swatch, entry.id)
		Theme.stroke(entry.basic and C.Border or rarity.color, 3).Parent = swatch
		Theme.label({
			Position = UDim2.fromOffset(4, 72),
			Size = UDim2.new(1, -8, 0, 18),
			Text = entry.name,
			Font = Theme.Fonts.Bold,
			MaxTextSize = 15,
			Parent = body,
		})
		Theme.chip({
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0, 94),
			Size = UDim2.new(1, -12, 0, 22),
			Color = entry.basic and C.PanelSoft or rarity.color,
			TextColor3 = entry.basic and C.InkSoft or C.White,
			Text = entry.basic and "Básico · ∞" or (rarityLabel .. " · " .. owned(entry.id)),
			MaxTextSize = 12,
			Parent = body,
		})
		if free <= 0 and not selected then
			body.BackgroundTransparency = 0.4
			swatch.BackgroundTransparency = 0.6
		end
		cell.Activated:Connect(function()
			if remaining(entry.id, selectedArea) <= 0 then
				app.notify("Ya usaste todo tu «" .. entry.name .. "» 🎨", "error")
				return
			end
			Theme.playSound("click", 1.2)
			choices[selectedArea] = entry.id
			local index = design.areaById[selectedArea].index
			local nextArea = design.areas[index + 1]
			if nextArea then
				selectedArea = nextArea.id
			end
			refreshAreas()
			refreshColors()
			updateValue()
		end)
		holder.Name = entry.id
	end
end

-- Asigna los colores más valiosos a las áreas más grandes.
local function autoPick()
	local areas = {}
	for _, area in ipairs(design.areas) do
		table.insert(areas, area)
		choices[area.id] = area.default
	end
	table.sort(areas, function(a, b)
		return a.weight > b.weight
	end)
	local pool = {}
	for _, entry in ipairs(Colors.List) do
		if not entry.basic then
			for _ = 1, owned(entry.id) do
				table.insert(pool, entry)
			end
		end
	end
	table.sort(pool, function(a, b)
		return Colors.rarityOf(a).mult > Colors.rarityOf(b).mult
	end)
	for i, area in ipairs(areas) do
		local entry = pool[i]
		if entry and Colors.rarityOf(entry).mult > 1 then
			choices[area.id] = entry.id
		end
	end
	refreshAreas()
	refreshColors()
	updateValue()
	Theme.playSound("success", 1.3)
end

local function build(parent)
	-- Izquierda: vista previa y áreas.
	local _, left = Theme.card({
		Position = UDim2.fromOffset(18, 14),
		Size = UDim2.new(0, 330, 1, -28),
		Radius = 22,
		Parent = parent,
	})
	local previewBox = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 14),
		Size = UDim2.fromOffset(200, 200),
		BackgroundColor3 = C.White,
		Parent = left,
	}, { Theme.corner(14), Theme.stroke(C.Gold, 5) })
	refs.previewBox = Theme.new(
		"Frame",
		{ Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = previewBox },
		{
			Theme.corner(12),
		}
	)
	refs.areas = Theme.new("ScrollingFrame", {
		Position = UDim2.fromOffset(10, 224),
		Size = UDim2.new(1, -20, 1, -234),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 5,
		ScrollBarImageColor3 = C.InkFaint,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = left,
	}, {
		Theme.list("v", 6),
		Theme.new("UIPadding", {
			PaddingTop = UDim.new(0, 3),
			PaddingLeft = UDim.new(0, 3),
			PaddingRight = UDim.new(0, 10),
			PaddingBottom = UDim.new(0, 6),
		}),
	})

	-- Derecha: colores.
	refs.colorsTitle = Theme.label({
		Position = UDim2.fromOffset(366, 12),
		Size = UDim2.new(1, -600, 0, 32),
		Text = "",
		Font = Theme.Fonts.Display,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 26,
		Parent = parent,
	})
	Theme.button({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -20, 0, 10),
		Size = UDim2.fromOffset(210, 40),
		Text = "✨ Mejores colores",
		Variant = "purple",
		MaxTextSize = 18,
		Parent = parent,
		OnClick = function()
			autoPick()
		end,
	})
	refs.grid = Theme.new("ScrollingFrame", {
		Position = UDim2.fromOffset(360, 56),
		Size = UDim2.new(1, -378, 1, -160),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = C.InkFaint,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = parent,
	}, {
		Theme.new("UIGridLayout", {
			CellSize = UDim2.fromOffset(112, 128),
			CellPadding = UDim2.fromOffset(10, 12),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
		Theme.new(
			"UIPadding",
			{ PaddingTop = UDim.new(0, 4), PaddingLeft = UDim.new(0, 6), PaddingBottom = UDim.new(0, 8) }
		),
	})

	-- Barra inferior con el valor.
	local _, footer = Theme.card({
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 360, 1, -14),
		Size = UDim2.new(1, -378, 0, 84),
		Radius = 20,
		Parent = parent,
	})
	Theme.label({
		Position = UDim2.fromOffset(16, 10),
		Size = UDim2.fromOffset(170, 18),
		Text = "VALOR DEL CUADRO",
		Font = Theme.Fonts.Heavy,
		TextColor3 = C.InkFaint,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 13,
		Parent = footer,
	})
	refs.multiplier = Theme.label({
		Position = UDim2.fromOffset(16, 28),
		Size = UDim2.fromOffset(110, 40),
		Text = "x1.00",
		Font = Theme.Fonts.Display,
		TextColor3 = C.Primary,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 34,
		Parent = footer,
	})
	refs.value = Theme.label({
		Position = UDim2.fromOffset(130, 32),
		Size = UDim2.new(1, -390, 0, 24),
		Text = "",
		Font = Theme.Fonts.Bold,
		TextColor3 = C.MintDark,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 17,
		Parent = footer,
	})
	refs.multBar = Theme.progress({
		Position = UDim2.fromOffset(130, 60),
		Size = UDim2.new(1, -390, 0, 8),
		Gradient = "primary",
		Parent = footer,
	})
	refs.continue = Theme.button({
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0.5, 0),
		Size = UDim2.fromOffset(220, 56),
		Text = "Empezar a pintar ➜",
		Variant = "mint",
		Radius = 18,
		Parent = footer,
		OnClick = function()
			ColorPicker.confirm()
		end,
	})
end

function ColorPicker.open(newDesign)
	design = newDesign
	choices = {}
	local saved = remembered[design.id] or {}
	for _, area in ipairs(design.areas) do
		local colorId = saved[area.id]
		if not colorId or owned(colorId) <= 0 then
			colorId = area.default
		end
		choices[area.id] = colorId
	end
	for _, area in ipairs(design.areas) do
		if remaining(choices[area.id], nil) < 0 then
			choices[area.id] = area.default
		end
	end
	selectedArea = design.areas[1].id

	window.Title.Text = "🎨 Elige tus colores · " .. design.name
	window.Subtitle.Text = "Este cuadro tiene "
		.. #design.areas
		.. " áreas. Cada área toma el color de su pintura: ¡los colores raros valen más!"
	preview = DesignArt.render(refs.previewBox, design, { mode = "color", colors = choices, outline = false })

	for _, row in pairs(areaRows) do
		row.holder:Destroy()
	end
	areaRows = {}
	for _, area in ipairs(design.areas) do
		local holder, body = Theme.card({
			Size = UDim2.new(1, 0, 0, 48),
			Radius = 14,
			LayoutOrder = area.index,
			Parent = refs.areas,
		})
		local button = Theme.new("TextButton", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Text = "",
			ZIndex = 3,
			Parent = body,
		})
		local swatch = Theme.new("Frame", {
			Position = UDim2.fromOffset(10, 9),
			Size = UDim2.fromOffset(30, 30),
			Parent = body,
		}, { Theme.round(), Theme.stroke(C.Border, 2) })
		Theme.label({
			Position = UDim2.fromOffset(48, 6),
			Size = UDim2.new(0.5, -40, 1, -12),
			Text = area.name,
			Font = Theme.Fonts.Bold,
			TextXAlignment = Enum.TextXAlignment.Left,
			MaxTextSize = 17,
			Parent = body,
		})
		local colorName = Theme.label({
			Position = UDim2.new(0.5, 0, 0, 8),
			Size = UDim2.new(0.5, -12, 1, -16),
			Text = "",
			Font = Theme.Fonts.Heavy,
			TextXAlignment = Enum.TextXAlignment.Right,
			MaxTextSize = 14,
			Parent = body,
		})
		button.Activated:Connect(function()
			Theme.playSound("click", 1.1)
			selectedArea = area.id
			refreshAreas()
			refreshColors()
		end)
		areaRows[area.id] = {
			area = area,
			holder = holder,
			body = body,
			stroke = body:FindFirstChildOfClass("UIStroke"),
			swatch = swatch,
			colorName = colorName,
		}
	end

	refreshAreas()
	refreshColors()
	updateValue()
	window.Open()
end

function ColorPicker.refresh()
	if design and window.Holder.Visible then
		refreshColors()
		updateValue()
	end
end

function ColorPicker.confirm()
	if busy or not design then
		return
	end
	busy = true
	local ok, success, message = pcall(function()
		return app.remotes.StartPainting:InvokeServer(design.id, choices)
	end)
	busy = false
	if ok and success then
		remembered[design.id] = table.clone(choices)
		window.Close()
		app.openPainter(design, choices)
	else
		app.notify(ok and message or "No se pudo empezar.", "error")
	end
end

function ColorPicker.init(appRef)
	app = appRef
	local gui = Theme.new("ScreenGui", {
		Name = "ColorPicker",
		ResetOnSpawn = false,
		DisplayOrder = 13,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = Players.LocalPlayer:WaitForChild("PlayerGui"),
	})
	window = Theme.window({
		Name = "Window",
		Parent = gui,
		Size = UDim2.fromOffset(1010, 650),
		Gradient = "pink",
		Title = "🎨 Elige tus colores",
	})
	build(window.Body)
end

return ColorPicker
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="22">
            <Properties>
              <string name="Name">Daily</string>
              <string name="Source"><![CDATA[-- Ventana del regalo diario: racha de 7 días con monedas y un color raro.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Colors = require(Shared.Colors)
local Config = require(Shared.Config)

local Theme = require(script.Parent.Theme)

local Daily = {}

local C = Theme.Colors

local app
local window
local tiles = {}
local claimButton
local claiming = false

local function buildTiles(parent)
	local row = Theme.new("Frame", {
		Position = UDim2.fromOffset(20, 22),
		Size = UDim2.new(1, -40, 0, 156),
		BackgroundTransparency = 1,
		Parent = parent,
	}, { Theme.list("h", 10, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center) })
	for day = 1, 7 do
		local big = day == 7
		local _, body = Theme.card({
			Name = "Day" .. day,
			Size = UDim2.fromOffset(big and 120 or 92, 150),
			Radius = 18,
			LayoutOrder = day,
			Parent = row,
		})
		if big then
			Theme.gradient(C.GoldLight, Color3.fromRGB(255, 218, 120), 90).Parent = body
		end
		local title = Theme.label({
			Position = UDim2.fromOffset(4, 10),
			Size = UDim2.new(1, -8, 0, 22),
			Text = big and "Día 7 · ¡Premio!" or ("Día " .. day),
			Font = Theme.Fonts.Heavy,
			TextColor3 = C.InkSoft,
			MaxTextSize = 17,
			Parent = body,
		})
		local icon = Theme.label({
			Position = UDim2.fromOffset(4, 36),
			Size = UDim2.new(1, -8, 0, 46),
			Text = big and "👑" or "🎁",
			MaxTextSize = big and 44 or 38,
			Parent = body,
		})
		local amount = Theme.label({
			Position = UDim2.fromOffset(4, 88),
			Size = UDim2.new(1, -8, 0, 22),
			Text = "",
			Font = Theme.Fonts.Display,
			TextColor3 = C.GoldDark,
			MaxTextSize = 19,
			Parent = body,
		})
		Theme.label({
			Position = UDim2.fromOffset(4, 114),
			Size = UDim2.new(1, -8, 0, 18),
			Text = big and "+ color Épico ✨" or "+ color raro",
			Font = Theme.Fonts.Bold,
			TextColor3 = big and C.Purple or C.Primary,
			MaxTextSize = 13,
			Parent = body,
		})
		local check = Theme.label({
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -6, 0, 6),
			Size = UDim2.fromOffset(24, 24),
			Text = "✔",
			Font = Theme.Fonts.Heavy,
			TextColor3 = C.MintDark,
			MaxTextSize = 18,
			Visible = false,
			Parent = body,
		})
		tiles[day] = {
			body = body,
			big = big,
			stroke = body:FindFirstChildOfClass("UIStroke"),
			title = title,
			icon = icon,
			amount = amount,
			check = check,
		}
	end
end

function Daily.refresh()
	local state = app.state
	if not (state and window and window.Holder.Visible) then
		return
	end
	local scale = Config.questScale(state.openLevel)
	local today = state.dailyStreak
	for day, tile in ipairs(tiles) do
		tile.amount.Text = "💵 " .. Theme.formatNumber(math.floor((80 + day * 40) * scale))
		local claimed = day < today or (day == today and not state.dailyReady)
		local current = day == today and state.dailyReady
		tile.check.Visible = claimed
		if not tile.big then
			tile.body.BackgroundColor3 = current and C.GoldLight or (claimed and C.MintLight or C.Panel)
		end
		tile.stroke.Color = current and C.Gold or C.Border
		tile.stroke.Thickness = current and 3.5 or 1.5
		tile.title.TextColor3 = current and C.GoldDark or C.InkSoft
	end
	if state.dailyReady then
		claimButton.SetText("🎁 Reclamar día " .. today)
		claimButton.SetEnabled(true)
	else
		claimButton.SetText("⏰ Vuelve en " .. Theme.formatTime(state.dailyWait))
		claimButton.SetEnabled(false)
	end
end

function Daily.open()
	window.Open()
	Daily.refresh()
end

function Daily.claim()
	if claiming then
		return
	end
	claiming = true
	local ok, success, amount, colorId = pcall(function()
		return app.remotes.ClaimDaily:InvokeServer()
	end)
	claiming = false
	if ok and success then
		Theme.playSound("success", 1.1)
		local entry = Colors.ById[colorId]
		app.notify(
			"🎁 ¡Regalo diario! +💵"
				.. Theme.formatNumber(amount)
				.. (entry and (" y «" .. entry.name .. "»") or ""),
			"gold"
		)
		app.celebrate()
		window.Close()
	end
end

function Daily.init(appRef)
	app = appRef
	local gui = Theme.new("ScreenGui", {
		Name = "Daily",
		ResetOnSpawn = false,
		DisplayOrder = 14,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = Players.LocalPlayer:WaitForChild("PlayerGui"),
	})
	window = Theme.window({
		Name = "Window",
		Parent = gui,
		Size = UDim2.fromOffset(820, 360),
		Gradient = "pink",
		Title = "🎁 Regalo diario",
		Subtitle = "Vuelve cada día: la recompensa crece con tu racha.",
	})
	buildTiles(window.Body)
	claimButton = Theme.button({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -18),
		Size = UDim2.fromOffset(300, 56),
		Text = "",
		Variant = "gold",
		Radius = 18,
		Parent = window.Body,
		OnClick = function()
			Daily.claim()
		end,
	})
end

return Daily
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="23">
            <Properties>
              <string name="Name">DesignArt</string>
              <string name="Source"><![CDATA[-- Dibuja un diseño (figuras) dentro de un Frame cuadrado.
-- mode = "color": cuadro terminado. mode = "lineart": líneas para colorear,
-- cada figura se va rellenando de abajo arriba con setProgress.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Colors = require(Shared.Colors)
local Designs = require(Shared.Designs)

local DesignArt = {}

local LINE_COLOR = Color3.fromRGB(236, 150, 186)

local function applyColor(frame, gradient, colorId)
	local entry = Colors.ById[colorId]
	if entry and entry.gradient then
		frame.BackgroundColor3 = Color3.new(1, 1, 1)
		gradient.Color = Colors.sequence(colorId)
	else
		frame.BackgroundColor3 = entry and entry.color or Color3.new(1, 1, 1)
		gradient.Color = ColorSequence.new(Color3.new(1, 1, 1))
	end
end

local function revealSequence(p)
	if p >= 1 then
		return NumberSequence.new(0)
	end
	if p <= 0 then
		return NumberSequence.new(1)
	end
	local edge = math.min(p + 0.05, 1)
	if edge >= 1 then
		return NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(p, 0),
			NumberSequenceKeypoint.new(1, 1),
		})
	end
	return NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(p, 0),
		NumberSequenceKeypoint.new(edge, 1),
		NumberSequenceKeypoint.new(1, 1),
	})
end

function DesignArt.render(container, design, opts)
	opts = opts or {}
	local old = container:FindFirstChild("Art")
	if old then
		old:Destroy()
	end
	local mode = opts.mode or "color"
	local colors = opts.colors or Designs.defaultColors(design)
	local zindex = opts.zindex or container.ZIndex
	local stroke = opts.stroke or 2

	local holder = Instance.new("Frame")
	holder.Name = "Art"
	holder.Size = UDim2.fromScale(1, 1)
	holder.BackgroundTransparency = 1
	holder.ClipsDescendants = true
	holder.ZIndex = zindex

	local handle = { shapes = {}, design = design, holder = holder }

	for i, shape in ipairs(design.shapes) do
		local base = Instance.new("Frame")
		base.Name = "S" .. i
		base.AnchorPoint = Vector2.new(0.5, 0.5)
		base.Position = UDim2.fromScale(shape.x, shape.y)
		base.Size = UDim2.fromScale(shape.w, shape.h)
		base.Rotation = shape.rot
		base.BorderSizePixel = 0
		base.ZIndex = zindex
		if shape.r > 0 then
			local corner = Instance.new("UICorner")
			corner.CornerRadius = UDim.new(shape.r, 0)
			corner.Parent = base
		end

		local entry = { shape = shape, base = base }
		if mode == "lineart" then
			base.BackgroundColor3 = Color3.new(1, 1, 1)
			local line = Instance.new("UIStroke")
			line.Color = LINE_COLOR
			line.Thickness = stroke
			line.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
			line.Parent = base

			local fill = Instance.new("Frame")
			fill.Name = "Fill"
			fill.Size = UDim2.fromScale(1, 1)
			fill.BorderSizePixel = 0
			fill.ZIndex = zindex
			if shape.r > 0 then
				local corner = Instance.new("UICorner")
				corner.CornerRadius = UDim.new(shape.r, 0)
				corner.Parent = fill
			end
			local gradient = Instance.new("UIGradient")
			gradient.Rotation = -90
			gradient.Transparency = revealSequence(0)
			gradient.Parent = fill
			applyColor(fill, gradient, colors[shape.area])
			fill.Parent = base
			entry.fill = fill
			entry.gradient = gradient
			entry.progress = 0
		else
			local gradient = Instance.new("UIGradient")
			gradient.Rotation = 35
			gradient.Parent = base
			applyColor(base, gradient, colors[shape.area])
			entry.gradient = gradient
			if opts.outline ~= false then
				local line = Instance.new("UIStroke")
				line.Color = Colors.mainColor(colors[shape.area]):Lerp(Color3.new(0, 0, 0), 0.25)
				line.Thickness = opts.outlineThickness or 1
				line.Transparency = 0.55
				line.Parent = base
			end
		end
		base.Parent = holder
		handle.shapes[i] = entry
	end

	function handle.setProgress(i, p)
		local entry = handle.shapes[i]
		if entry and entry.gradient and entry.fill then
			entry.progress = p
			entry.gradient.Transparency = revealSequence(p)
		end
	end

	-- Dirección del relleno (en grados): el color "entra" desde donde pasó el pincel.
	function handle.setFillDirection(i, rotation)
		local entry = handle.shapes[i]
		if entry and entry.fill and entry.progress <= 0 then
			entry.gradient.Rotation = rotation
		end
	end

	function handle.setColors(newColors)
		colors = newColors
		for _, entry in ipairs(handle.shapes) do
			local target = entry.fill or entry.base
			applyColor(target, entry.gradient, newColors[entry.shape.area])
		end
	end

	holder.Parent = container
	return handle
end

-- Muestra de color redonda (soporta degradados).
function DesignArt.swatch(frame, colorId)
	local gradient = frame:FindFirstChild("SwatchGradient")
	if not gradient then
		gradient = Instance.new("UIGradient")
		gradient.Name = "SwatchGradient"
		gradient.Rotation = 35
		gradient.Parent = frame
	end
	applyColor(frame, gradient, colorId)
end

return DesignArt
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="24">
            <Properties>
              <string name="Name">DesignPicker</string>
              <string name="Source"><![CDATA[-- Ventana "Elige un diseño": diseños por niveles, desbloqueos y maestría.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Designs = require(Shared.Designs)

local Theme = require(script.Parent.Theme)
local DesignArt = require(script.Parent.DesignArt)

local DesignPicker = {}

local C = Theme.Colors
local MEDALS = { bronce = "🥉", plata = "🥈", oro = "🥇" }

local app
local window
local cards = {}
local levelHeaders = {}
local detail = {}
local selectedId = "globo"
local busy = false

local function stateOf(design)
	local state = app.state
	if not state then
		return "closed"
	end
	if state.unlocked[design.id] then
		return "unlocked"
	end
	if Designs.isLevelOpen(design.level, state.made) then
		return "buyable"
	end
	return "closed"
end

local function averageValue(level)
	local total, count = 0, 0
	for _, design in ipairs(Designs.Levels[level]) do
		total += design.value
		count += 1
	end
	return math.floor(total / math.max(count, 1))
end

-- Tarjetas ------------------------------------------------------------------------------------
local function buildCard(design, parent)
	local holder, body = Theme.card({
		Name = design.id,
		Size = UDim2.fromOffset(146, 192),
		Radius = 20,
		LayoutOrder = design.index,
		Parent = parent,
	})
	local stroke = body:FindFirstChildOfClass("UIStroke")
	local button = Theme.new("TextButton", {
		Name = design.id,
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		ZIndex = 3,
		Parent = body,
	})
	local artBox = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 10),
		Size = UDim2.fromOffset(122, 122),
		BackgroundColor3 = C.PanelSoft,
		Parent = body,
	}, { Theme.corner(16) })
	local art = Theme.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = artBox }, {
		Theme.corner(16),
	})
	DesignArt.render(art, design, { mode = "color", outline = false })
	local lock = Theme.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = C.Shadow,
		BackgroundTransparency = 0.35,
		Visible = false,
		ZIndex = 2,
		Parent = artBox,
	}, { Theme.corner(16) })
	local lockIcon = Theme.label({
		Size = UDim2.fromScale(1, 1),
		Text = "🔒",
		Font = Theme.Fonts.Heavy,
		MaxTextSize = 44,
		ZIndex = 2,
		Parent = lock,
	})
	local name = Theme.label({
		Position = UDim2.fromOffset(6, 136),
		Size = UDim2.new(1, -12, 0, 22),
		Text = design.name,
		Font = Theme.Fonts.Heavy,
		MaxTextSize = 17,
		Parent = body,
	})
	local footer = Theme.new("Frame", {
		Position = UDim2.fromOffset(10, 162),
		Size = UDim2.new(1, -20, 0, 22),
		BackgroundTransparency = 1,
		Parent = body,
	})
	local medal = Theme.label({ Size = UDim2.fromOffset(22, 22), Text = "", MaxTextSize = 18, Parent = footer })
	local bar = Theme.progress({
		Position = UDim2.new(0, 26, 0.5, -4),
		Size = UDim2.new(1, -66, 0, 8),
		Gradient = "gold",
		Parent = footer,
	})
	local count = Theme.label({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 1),
		Size = UDim2.fromOffset(36, 20),
		Text = "",
		Font = Theme.Fonts.Heavy,
		TextColor3 = C.InkSoft,
		TextXAlignment = Enum.TextXAlignment.Right,
		MaxTextSize = 13,
		Parent = footer,
	})
	local price, priceLabel = Theme.chip({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 161),
		Size = UDim2.fromOffset(110, 24),
		Color = C.GoldLight,
		TextColor3 = C.GoldDark,
		Text = "",
		MaxTextSize = 14,
		Parent = body,
	})

	button.Activated:Connect(function()
		Theme.playSound("click", 1.2)
		selectedId = design.id
		DesignPicker.refresh()
	end)

	cards[design.id] = {
		holder = holder,
		body = body,
		stroke = stroke,
		art = art,
		lock = lock,
		lockIcon = lockIcon,
		name = name,
		footer = footer,
		medal = medal,
		bar = bar,
		count = count,
		price = price,
		priceLabel = priceLabel,
	}
end

local function buildList(parent)
	local list = Theme.new("ScrollingFrame", {
		Position = UDim2.fromOffset(18, 14),
		Size = UDim2.new(0, 668, 1, -28),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = C.InkFaint,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = parent,
	}, {
		Theme.list("v", 10),
		Theme.new("UIPadding", {
			PaddingTop = UDim.new(0, 4),
			PaddingLeft = UDim.new(0, 6),
			PaddingRight = UDim.new(0, 8),
			PaddingBottom = UDim.new(0, 14),
		}),
	})
	for level = 1, Designs.MAX_LEVEL do
		local header = Theme.new("Frame", {
			Name = "Header" .. level,
			Size = UDim2.new(1, -10, 0, 36),
			BackgroundTransparency = 1,
			LayoutOrder = level * 2 - 1,
			Parent = list,
		})
		local chip = Theme.chip({
			Size = UDim2.fromOffset(110, 32),
			Color = C.Primary,
			TextColor3 = C.White,
			Text = "Nivel " .. level,
			MaxTextSize = 18,
			Parent = header,
		})
		local info = Theme.label({
			Position = UDim2.fromOffset(122, 4),
			Size = UDim2.new(1, -130, 0, 26),
			Text = "💵 Se venden por ~" .. Theme.formatNumber(averageValue(level)),
			Font = Theme.Fonts.Bold,
			TextColor3 = C.MintDark,
			TextXAlignment = Enum.TextXAlignment.Left,
			MaxTextSize = 18,
			Parent = header,
		})
		levelHeaders[level] = { chip = chip, info = info }
		local grid = Theme.new("Frame", {
			Name = "Level" .. level,
			Size = UDim2.new(1, -10, 0, 204),
			BackgroundTransparency = 1,
			LayoutOrder = level * 2,
			Parent = list,
		}, {
			Theme.new("UIGridLayout", {
				CellSize = UDim2.fromOffset(146, 192),
				CellPadding = UDim2.fromOffset(12, 10),
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
		})
		for _, design in ipairs(Designs.Levels[level]) do
			buildCard(design, grid)
		end
	end
end

-- Panel de detalle ------------------------------------------------------------------------------
local function buildDetail(parent)
	local _, panel = Theme.card({
		Position = UDim2.new(1, -306, 0, 14),
		Size = UDim2.new(0, 288, 1, -28),
		Radius = 22,
		Parent = parent,
	})
	local artBox = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 16),
		Size = UDim2.fromOffset(176, 176),
		BackgroundColor3 = C.PanelSoft,
		Parent = panel,
	}, { Theme.corner(18), Theme.stroke(C.Gold, 5) })
	detail.art = Theme.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = artBox }, {
		Theme.corner(16),
	})
	detail.lock = Theme.label({
		Size = UDim2.fromScale(1, 1),
		Text = "🔒",
		Font = Theme.Fonts.Heavy,
		BackgroundColor3 = C.Shadow,
		BackgroundTransparency = 0.35,
		MaxTextSize = 60,
		Visible = false,
		Parent = artBox,
	})
	Theme.corner(16).Parent = detail.lock
	detail.name = Theme.label({
		Position = UDim2.fromOffset(12, 200),
		Size = UDim2.new(1, -24, 0, 34),
		Text = "",
		Font = Theme.Fonts.Display,
		MaxTextSize = 28,
		Parent = panel,
	})
	detail.value = Theme.label({
		Position = UDim2.fromOffset(12, 234),
		Size = UDim2.new(1, -24, 0, 24),
		Text = "",
		Font = Theme.Fonts.Heavy,
		TextColor3 = C.MintDark,
		MaxTextSize = 19,
		Parent = panel,
	})
	detail.info = Theme.label({
		Position = UDim2.fromOffset(12, 258),
		Size = UDim2.new(1, -24, 0, 20),
		Text = "",
		Font = Theme.Fonts.Medium,
		TextColor3 = C.InkSoft,
		MaxTextSize = 15,
		Parent = panel,
	})
	local masteryBox = Theme.new("Frame", {
		Position = UDim2.fromOffset(12, 286),
		Size = UDim2.new(1, -24, 0, 92),
		BackgroundColor3 = C.GoldLight,
		Parent = panel,
	}, { Theme.corner(16) })
	detail.medal = Theme.label({
		Position = UDim2.fromOffset(8, 8),
		Size = UDim2.fromOffset(40, 40),
		Text = "",
		MaxTextSize = 34,
		Parent = masteryBox,
	})
	detail.tier = Theme.label({
		Position = UDim2.fromOffset(54, 8),
		Size = UDim2.new(1, -62, 0, 22),
		Text = "",
		Font = Theme.Fonts.Heavy,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 17,
		Parent = masteryBox,
	})
	detail.tierBonus = Theme.label({
		Position = UDim2.fromOffset(54, 30),
		Size = UDim2.new(1, -62, 0, 18),
		Text = "",
		Font = Theme.Fonts.Medium,
		TextColor3 = C.GoldDark,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 14,
		Parent = masteryBox,
	})
	detail.bar = Theme.progress({
		Position = UDim2.fromOffset(10, 56),
		Size = UDim2.new(1, -20, 0, 10),
		Gradient = "gold",
		Parent = masteryBox,
	})
	detail.progress = Theme.label({
		Position = UDim2.fromOffset(10, 68),
		Size = UDim2.new(1, -20, 0, 18),
		Text = "",
		Font = Theme.Fonts.Bold,
		TextColor3 = C.InkSoft,
		MaxTextSize = 13,
		Parent = masteryBox,
	})
	detail.tiers = Theme.label({
		Position = UDim2.fromOffset(12, 384),
		Size = UDim2.new(1, -24, 0, 20),
		Text = "🥉 3 → +5%   🥈 8 → +10%   🥇 20 → +20%",
		Font = Theme.Fonts.Bold,
		TextColor3 = C.InkSoft,
		MaxTextSize = 14,
		Parent = panel,
	})
	detail.button = Theme.button({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -14),
		Size = UDim2.new(1, -28, 0, 58),
		Text = "🎨 Empezar a pintar",
		Variant = "primary",
		Radius = 18,
		Parent = panel,
		OnClick = function()
			DesignPicker.action()
		end,
	})
end

-- Lógica ---------------------------------------------------------------------------------------------
function DesignPicker.refresh()
	if not (window and window.Holder.Visible and app.state) then
		return
	end
	local state = app.state
	for level, header in pairs(levelHeaders) do
		local open = Designs.isLevelOpen(level, state.made)
		header.chip.BackgroundColor3 = open and C.Primary or C.InkFaint
	end
	for _, design in ipairs(Designs.List) do
		local card = cards[design.id]
		local status = stateOf(design)
		local made = state.made[design.id] or 0
		local selected = design.id == selectedId
		card.stroke.Color = selected and C.Primary or C.Border
		card.stroke.Thickness = selected and 3.5 or 1.5
		card.body.BackgroundColor3 = selected and C.PrimaryLight or C.Panel
		card.art.Visible = status ~= "closed"
		card.lock.Visible = status ~= "unlocked"
		card.lockIcon.Text = status == "closed" and "🔒" or "🛒"
		card.footer.Visible = status == "unlocked"
		card.price.Visible = status ~= "unlocked"
		card.priceLabel.Text = (status == "closed" and "🔒 " or "💵 ") .. Theme.formatNumber(design.price)
		card.name.Text = status == "closed" and "???" or design.name
		card.name.TextColor3 = status == "closed" and C.InkFaint or C.Ink
		local tier, nextTier = Config.masteryFor(made)
		card.medal.Text = tier and MEDALS[tier.id] or "⚪"
		local goal = nextTier and nextTier.made or made
		card.bar.Set(made / math.max(goal, 1))
		card.count.Text = nextTier and (made .. "/" .. goal) or tostring(made)
	end

	local design = Designs.get(selectedId) or Designs.List[1]
	local status = stateOf(design)
	local made = state.made[design.id] or 0
	DesignArt.render(detail.art, design, { mode = "color", outline = false })
	detail.art.Visible = status ~= "closed"
	detail.lock.Visible = status == "closed"
	local value = Config.paintingValue(design, Designs.defaultColors(design), state.upgrades, made, 3)
	detail.value.Text = "💵 Hasta ~" .. Theme.formatNumber(value) .. " con colores básicos"
	detail.name.Text = status == "closed" and "???" or design.name
	detail.info.Text = "Nivel "
		.. design.level
		.. "  ·  "
		.. #design.areas
		.. " colores  ·  "
		.. #design.shapes
		.. " figuras"
	local tier, nextTier = Config.masteryFor(made)
	detail.medal.Text = tier and MEDALS[tier.id] or "⚪"
	detail.tier.Text = tier and ("Maestría de " .. tier.name) or "Sin maestría aún"
	detail.tierBonus.Text = tier and ("Se vende un " .. math.floor(tier.bonus * 100 + 0.5) .. "% más caro")
		or "Píntalo varias veces para ganar medallas"
	if nextTier then
		detail.bar.Set(made / nextTier.made)
		detail.progress.Text = made .. " de " .. nextTier.made .. " para " .. nextTier.name
	else
		detail.bar.Set(1)
		detail.progress.Text = "¡Maestría máxima! (" .. made .. " pintados)"
	end

	if status == "unlocked" then
		detail.button.SetText(state.painting and "🎨 Tienes un cuadro empezado" or "🎨 Empezar a pintar")
		detail.button.SetVariant("primary")
		detail.button.SetEnabled(not state.painting)
	elseif status == "buyable" then
		detail.button.SetText("🔓 Desbloquear · 💵 " .. Theme.formatNumber(design.price))
		detail.button.SetVariant("gold")
		detail.button.SetEnabled(state.coins >= design.price)
	else
		detail.button.SetText("🔒 Pinta todo el nivel " .. (design.level - 1))
		detail.button.SetEnabled(false)
	end
end

function DesignPicker.action()
	if busy then
		return
	end
	local design = Designs.get(selectedId)
	local status = stateOf(design)
	if status == "unlocked" then
		window.Close()
		app.openColorPicker(design)
	elseif status == "buyable" then
		busy = true
		local ok, success, message = pcall(function()
			return app.remotes.UnlockDesign:InvokeServer(design.id)
		end)
		busy = false
		if ok and success then
			Theme.playSound("success", 1.1)
			app.notify("🔓 " .. message, "success")
			app.celebrate()
		else
			app.notify(ok and message or "No se pudo desbloquear.", "error")
		end
		DesignPicker.refresh()
	end
end

function DesignPicker.open()
	if app.state and app.state.painting then
		app.resumePainting()
		return
	end
	window.Open()
	DesignPicker.refresh()
end

function DesignPicker.isOpen()
	return window.Holder.Visible
end

function DesignPicker.init(appRef)
	app = appRef
	local gui = Theme.new("ScreenGui", {
		Name = "DesignPicker",
		ResetOnSpawn = false,
		DisplayOrder = 12,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = Players.LocalPlayer:WaitForChild("PlayerGui"),
	})
	window = Theme.window({
		Name = "Window",
		Parent = gui,
		Size = UDim2.fromOffset(1010, 650),
		Title = "🖌️ Elige un diseño",
		Subtitle = "Pinta todos los diseños de un nivel para abrir el siguiente. Los niveles altos se venden más caros.",
	})
	buildList(window.Body)
	buildDetail(window.Body)
end

return DesignPicker
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="25">
            <Properties>
              <string name="Name">HUD</string>
              <string name="Source"><![CDATA[-- Interfaz principal: monedas, menú lateral, misiones diarias, tutorial,
-- avisos y confeti.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Designs = require(Shared.Designs)

local Theme = require(script.Parent.Theme)

local HUD = {}

local C = Theme.Colors
local player = Players.LocalPlayer

local app
local gui
local refs = {}
local tiles = {}
local questRows = {}
local shownCoins = nil
local toastHolder
local confettiHolder
local questsVisible = true

local KIND_GRADIENT = { info = "primary", success = "mint", error = "red", gold = "gold" }
local CONFETTI_COLORS = {
	Color3.fromRGB(255, 120, 170),
	Color3.fromRGB(255, 210, 80),
	Color3.fromRGB(110, 210, 255),
	Color3.fromRGB(150, 120, 255),
	Color3.fromRGB(100, 220, 160),
}

-- Avisos ------------------------------------------------------------------------------------
function HUD.notify(text, kind)
	if not toastHolder then
		return
	end
	local holder, body = Theme.card({
		Size = UDim2.new(1, 0, 0, 48),
		Radius = 24,
		LayoutOrder = -math.floor(os.clock() * 100),
		Parent = toastHolder,
	})
	local accent = Theme.new("Frame", {
		Position = UDim2.fromOffset(6, 6),
		Size = UDim2.fromOffset(36, 36),
		BackgroundColor3 = C.White,
		Parent = body,
	}, { Theme.round(), Theme.gradient(KIND_GRADIENT[kind] or "primary", 90) })
	Theme.label({
		Size = UDim2.fromScale(1, 1),
		Text = kind == "error" and "!" or (kind == "gold" and "★" or "✓"),
		Font = Theme.Fonts.Heavy,
		TextColor3 = C.White,
		MaxTextSize = 20,
		Parent = accent,
	})
	Theme.label({
		Size = UDim2.new(1, -62, 1, -12),
		Position = UDim2.fromOffset(50, 6),
		Text = text,
		Font = Theme.Fonts.Bold,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 19,
		Parent = body,
	})
	Theme.pop(holder, 0.7)
	if kind == "error" then
		Theme.playSound("click", 0.6)
	end
	task.delay(4, function()
		if holder.Parent then
			holder:Destroy()
		end
	end)
	local toasts = {}
	for _, child in ipairs(toastHolder:GetChildren()) do
		if child:IsA("Frame") then
			table.insert(toasts, child)
		end
	end
	if #toasts > 4 then
		table.sort(toasts, function(a, b)
			return a.LayoutOrder > b.LayoutOrder
		end)
		toasts[1]:Destroy()
	end
end

function HUD.celebrate()
	local random = Random.new()
	for _ = 1, 80 do
		local piece = Theme.new("Frame", {
			Size = UDim2.fromOffset(random:NextInteger(8, 14), random:NextInteger(12, 20)),
			Position = UDim2.new(random:NextNumber(0.05, 0.95), 0, -0.05, 0),
			Rotation = random:NextInteger(0, 360),
			BackgroundColor3 = CONFETTI_COLORS[random:NextInteger(1, #CONFETTI_COLORS)],
			BorderSizePixel = 0,
			Parent = confettiHolder,
		}, { Theme.corner(3) })
		local duration = random:NextNumber(1.6, 2.8)
		Theme.tween(piece, duration, {
			Position = UDim2.new(piece.Position.X.Scale + random:NextNumber(-0.15, 0.15), 0, 1.05, 0),
			Rotation = piece.Rotation + random:NextInteger(-540, 540),
		}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		task.delay(duration, function()
			piece:Destroy()
		end)
	end
end

-- Barra superior --------------------------------------------------------------------------------
local function pill(parent, props)
	local holder, body = Theme.card({
		Name = props.Name,
		Size = props.Size,
		Radius = 24,
		LayoutOrder = props.LayoutOrder,
		Parent = parent,
	})
	local icon = Theme.new("Frame", {
		Position = UDim2.fromOffset(5, 5),
		Size = UDim2.fromOffset(38, 38),
		BackgroundColor3 = C.White,
		Parent = body,
	}, { Theme.round(), Theme.gradient(props.Gradient, 90) })
	Theme.label({ Size = UDim2.fromScale(1, 1), Text = props.Icon, MaxTextSize = 22, Parent = icon }, nil)
	if props.Caption then
		Theme.label({
			Name = "Caption",
			Size = UDim2.new(1, -60, 0, 14),
			Position = UDim2.fromOffset(50, 5),
			Text = props.Caption,
			Font = Theme.Fonts.Heavy,
			TextColor3 = C.InkFaint,
			TextXAlignment = Enum.TextXAlignment.Left,
			MaxTextSize = 12,
			Parent = body,
		})
	end
	local label = Theme.label({
		Name = "Value",
		Size = props.Caption and UDim2.new(1, -60, 0, 24) or UDim2.new(1, -60, 1, -12),
		Position = UDim2.fromOffset(50, props.Caption and 19 or 6),
		Text = "0",
		Font = props.Font or Theme.Fonts.Heavy,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = props.MaxTextSize or 24,
		Parent = body,
	})
	return holder, label, body
end

local function buildTopBar()
	local bar = Theme.new("Frame", {
		Name = "TopBar",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 8),
		Size = UDim2.new(0, 620, 0, 48),
		BackgroundTransparency = 1,
		Parent = gui,
	}, { Theme.list("h", 12, Enum.HorizontalAlignment.Center) })
	local coins, coinsLabel, coinsBody = pill(bar, {
		Name = "Coins",
		Size = UDim2.new(0, 220, 1, 0),
		Gradient = "gold",
		Icon = "💵",
		LayoutOrder = 1,
		Font = Theme.Fonts.Display,
		MaxTextSize = 28,
	})
	refs.coins = coinsLabel
	refs.coinsFrame = coins
	local plus = Theme.new("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -6, 0.5, 0),
		Size = UDim2.fromOffset(34, 34),
		BackgroundColor3 = C.White,
		Font = Theme.Fonts.Heavy,
		Text = "+",
		TextScaled = true,
		TextColor3 = C.White,
		Parent = coinsBody,
	}, { Theme.round(), Theme.gradient("mint", 90), Theme.padding(5) })
	plus.Activated:Connect(function()
		Theme.playSound("click")
		app.openShop()
	end)
	local _, gallery = pill(bar, {
		Name = "Gallery",
		Size = UDim2.new(0, 160, 1, 0),
		Gradient = "pink",
		Icon = "🖼️",
		Caption = "EN VENTA",
		LayoutOrder = 2,
		MaxTextSize = 21,
	})
	refs.gallery = gallery
	local _, level = pill(bar, {
		Name = "Level",
		Size = UDim2.new(0, 160, 1, 0),
		Gradient = "purple",
		Icon = "🎨",
		Caption = "DISEÑOS",
		LayoutOrder = 3,
		MaxTextSize = 21,
	})
	refs.level = level
end

-- Menú lateral --------------------------------------------------------------------------------------
local function buildMenu()
	local menu = Theme.new("Frame", {
		Name = "Menu",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 14, 0.5, 0),
		Size = UDim2.new(0, 170, 0, 290),
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		Theme.new("UIGridLayout", {
			CellSize = UDim2.fromOffset(78, 82),
			CellPadding = UDim2.fromOffset(12, 14),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	local entries = {
		{
			"paint",
			"🖌️",
			"Pintar",
			"primary",
			function()
				app.openDesigns()
			end,
		},
		{
			"colors",
			"📚",
			"Colores",
			"blue",
			function()
				app.openCollection()
			end,
		},
		{
			"shop",
			"🛒",
			"Mejoras",
			"mint",
			function()
				app.openShop()
			end,
		},
		{
			"quests",
			"📜",
			"Misiones",
			"gold",
			function()
				HUD.toggleQuests()
			end,
		},
		{
			"daily",
			"🎁",
			"Regalo",
			"pink",
			function()
				app.openDaily()
			end,
		},
		{
			"home",
			"🏠",
			"Mi galería",
			"orange",
			function()
				app.remotes.GoHome:FireServer()
			end,
		},
	}
	for order, entry in ipairs(entries) do
		tiles[entry[1]] = Theme.tile({
			Name = entry[1],
			Icon = entry[2],
			Text = entry[3],
			Gradient = entry[4],
			LayoutOrder = order,
			Parent = menu,
			OnClick = entry[5],
		})
	end
end

-- Misiones diarias -------------------------------------------------------------------------------
local function buildQuests()
	local holder, body = Theme.card({
		Name = "Quests",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 70),
		Size = UDim2.fromOffset(290, 318),
		Radius = 20,
		Parent = gui,
	})
	refs.quests = holder
	local header = Theme.new("Frame", {
		Size = UDim2.new(1, 0, 0, 46),
		BackgroundColor3 = C.White,
		Parent = body,
	}, { Theme.corner(20), Theme.gradient("gold", 0) })
	Theme.new("Frame", {
		Position = UDim2.new(0, 0, 1, -20),
		Size = UDim2.new(1, 0, 0, 20),
		BackgroundColor3 = C.White,
		BorderSizePixel = 0,
		Parent = header,
	}, { Theme.gradient("gold", 0) })
	local title = Theme.label({
		Position = UDim2.fromOffset(14, 8),
		Size = UDim2.new(1, -28, 0, 30),
		Text = "📜 Misiones de hoy",
		Font = Theme.Fonts.Display,
		TextColor3 = C.White,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 22,
		Parent = header,
	})
	Theme.textStroke(C.GoldDark, 1.5, 0.3).Parent = title
	local list = Theme.new("Frame", {
		Position = UDim2.fromOffset(10, 54),
		Size = UDim2.new(1, -20, 1, -90),
		BackgroundTransparency = 1,
		Parent = body,
	}, { Theme.list("v", 8) })
	for i = 1, Config.QUESTS_PER_DAY do
		local row = Theme.new("Frame", {
			Size = UDim2.new(1, 0, 0, 72),
			BackgroundColor3 = C.PanelSoft,
			LayoutOrder = i,
			Parent = list,
		}, { Theme.corner(14) })
		local icon = Theme.new("Frame", {
			Position = UDim2.fromOffset(8, 8),
			Size = UDim2.fromOffset(34, 34),
			BackgroundColor3 = C.GoldLight,
			Parent = row,
		}, { Theme.corner(10) })
		local iconLabel = Theme.label({ Size = UDim2.fromScale(1, 1), Text = "", MaxTextSize = 20, Parent = icon })
		local text = Theme.label({
			Position = UDim2.fromOffset(50, 6),
			Size = UDim2.new(1, -58, 0, 36),
			Text = "",
			Font = Theme.Fonts.Bold,
			TextXAlignment = Enum.TextXAlignment.Left,
			MaxTextSize = 16,
			Parent = row,
		})
		local bar = Theme.progress({
			Position = UDim2.fromOffset(10, 50),
			Size = UDim2.new(1, -120, 0, 12),
			Gradient = "gold",
			Parent = row,
		})
		local count = Theme.label({
			Position = UDim2.new(1, -108, 0, 44),
			Size = UDim2.fromOffset(40, 22),
			Text = "",
			Font = Theme.Fonts.Heavy,
			TextColor3 = C.InkSoft,
			MaxTextSize = 14,
			Parent = row,
		})
		local claim = Theme.button({
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -6, 0, 42),
			Size = UDim2.fromOffset(62, 26),
			Text = "",
			Variant = "mint",
			Radius = 10,
			MaxTextSize = 13,
			Parent = row,
			OnClick = function()
				app.claimQuest(i)
			end,
		})
		questRows[i] = { row = row, icon = iconLabel, text = text, bar = bar, count = count, claim = claim }
	end
	refs.questBonus = Theme.label({
		Position = UDim2.new(0, 10, 1, -32),
		Size = UDim2.new(1, -20, 0, 24),
		Text = "🎁 Completa las 3: ¡color Épico o mejor!",
		Font = Theme.Fonts.Bold,
		TextColor3 = C.GoldDark,
		MaxTextSize = 15,
		Parent = body,
	})
end

function HUD.toggleQuests()
	questsVisible = not questsVisible
	refs.quests.Visible = questsVisible
	if questsVisible then
		Theme.pop(refs.quests.Body, 0.85)
	end
end

local function refreshQuests(state)
	local claimable = 0
	for i, rowRefs in ipairs(questRows) do
		local quest = state.quests and state.quests[i]
		rowRefs.row.Visible = quest ~= nil
		if quest then
			local def = Config.QuestById[quest.id]
			rowRefs.icon.Text = def and def.icon or "❔"
			rowRefs.text.Text = Config.questText(quest)
			rowRefs.bar.Set(quest.progress / math.max(quest.goal, 1), true)
			rowRefs.count.Text = Theme.formatNumber(quest.progress) .. "/" .. Theme.formatNumber(quest.goal)
			local done = quest.progress >= quest.goal
			if quest.claimed then
				rowRefs.claim.SetText("✔")
				rowRefs.claim.SetEnabled(false)
			elseif done then
				claimable += 1
				rowRefs.claim.SetText("💵 " .. Theme.formatNumber(quest.reward))
				rowRefs.claim.SetEnabled(true)
			else
				rowRefs.claim.SetText("💵 " .. Theme.formatNumber(quest.reward))
				rowRefs.claim.SetEnabled(false)
			end
			rowRefs.row.BackgroundColor3 = (done and not quest.claimed) and C.MintLight or C.PanelSoft
		end
	end
	refs.questBonus.Text = state.questBonus and "🎉 ¡Bonus de hoy reclamado!"
		or "🎁 Completa las 3: ¡color Épico o mejor!"
	tiles.quests.SetBadge(claimable > 0 and claimable or nil)
end

-- Tutorial ------------------------------------------------------------------------------------------
local function buildTutorial()
	local holder, body = Theme.card({
		Name = "Tutorial",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 66),
		Size = UDim2.fromOffset(470, 62),
		Radius = 20,
		Color = C.White,
		StrokeColor = C.Primary,
		StrokeThickness = 2.5,
		Visible = false,
		Parent = gui,
	})
	refs.tutorial = holder
	local step = Theme.new("Frame", {
		Position = UDim2.fromOffset(8, 8),
		Size = UDim2.fromOffset(46, 46),
		BackgroundColor3 = C.White,
		Parent = body,
	}, { Theme.round(), Theme.gradient("primary", 90) })
	refs.tutorialStep = Theme.label({
		Size = UDim2.fromScale(1, 1),
		Text = "1",
		Font = Theme.Fonts.Display,
		TextColor3 = C.White,
		MaxTextSize = 24,
		Parent = step,
	})
	refs.tutorialTitle = Theme.label({
		Position = UDim2.fromOffset(64, 6),
		Size = UDim2.new(1, -76, 0, 18),
		Text = "TUTORIAL",
		Font = Theme.Fonts.Heavy,
		TextColor3 = C.Primary,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 13,
		Parent = body,
	})
	refs.tutorialText = Theme.label({
		Position = UDim2.fromOffset(64, 24),
		Size = UDim2.new(1, -76, 0, 30),
		Text = "",
		Font = Theme.Fonts.Bold,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 20,
		Parent = body,
	})
end

local function refreshTutorial(state)
	local step = state.tutorial or 0
	local def = Config.Tutorial[step]
	local visible = step > 0 and def ~= nil and not app.isBusy()
	refs.tutorial.Visible = visible
	if def then
		refs.tutorialStep.Text = tostring(step)
		refs.tutorialTitle.Text = "TUTORIAL · PASO " .. step .. " DE " .. #Config.Tutorial
		local suffix = def.goal > 1 and ("  (" .. (state.tutorialProgress or 0) .. "/" .. def.goal .. ")") or ""
		refs.tutorialText.Text = "👉 " .. def.text .. suffix
	end
	if refs.lastTutorial ~= step then
		refs.lastTutorial = step
		if visible then
			Theme.pop(refs.tutorial.Body, 0.8)
		end
	end
end

-- Ajustes (sonido) -----------------------------------------------------------------------------------
local function buildSettings()
	local button = Theme.new("TextButton", {
		Name = "Settings",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -14, 1, -14),
		Size = UDim2.fromOffset(46, 46),
		BackgroundColor3 = C.White,
		Font = Theme.Fonts.Bold,
		Text = "🔊",
		TextScaled = true,
		Parent = gui,
	}, { Theme.round(), Theme.stroke(C.Border, 2), Theme.padding(9) })
	refs.settings = button
	button.Activated:Connect(function()
		Theme.soundsEnabled = not Theme.soundsEnabled
		button.Text = Theme.soundsEnabled and "🔊" or "🔇"
		Theme.playSound("click")
	end)
end

-- Estado --------------------------------------------------------------------------------------------
local function animateCoins(target)
	if shownCoins == nil then
		shownCoins = target
		refs.coins.Text = Theme.formatNumber(target)
		return
	end
	local start = shownCoins
	shownCoins = target
	if start == target then
		return
	end
	if target > start then
		Theme.pop(refs.coinsFrame, 0.88)
	end
	task.spawn(function()
		local duration = 0.6
		local t0 = os.clock()
		while os.clock() - t0 < duration do
			if shownCoins ~= target then
				return
			end
			refs.coins.Text = Theme.formatNumber(start + (target - start) * (os.clock() - t0) / duration)
			RunService.RenderStepped:Wait()
		end
		refs.coins.Text = Theme.formatNumber(target)
	end)
end

function HUD.applyState(state)
	animateCoins(state.coins)
	refs.gallery.Text = state.displayed .. " / " .. state.slots
	refs.level.Text = "Nivel " .. state.openLevel .. " / " .. Designs.MAX_LEVEL
	tiles.daily.SetBadge(state.dailyReady)
	tiles.daily.Caption.Text = state.dailyReady and "¡Regalo!" or Theme.formatTime(state.dailyWait)
	tiles.paint.SetBadge(state.painting and "…" or nil)
	refreshQuests(state)
	refreshTutorial(state)
end

function HUD.setVisible(visible)
	gui.Enabled = visible
end

function HUD.init(appRef)
	app = appRef
	gui = Theme.new("ScreenGui", {
		Name = "HUD",
		ResetOnSpawn = false,
		DisplayOrder = 1,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	buildTopBar()
	buildMenu()
	buildQuests()
	buildTutorial()
	buildSettings()

	local overlay = Theme.new("ScreenGui", {
		Name = "Notifications",
		ResetOnSpawn = false,
		DisplayOrder = 50,
		Parent = player:WaitForChild("PlayerGui"),
	})
	toastHolder = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 136),
		Size = UDim2.new(0, 480, 0, 280),
		BackgroundTransparency = 1,
		Parent = overlay,
	}, { Theme.list("v", 8, Enum.HorizontalAlignment.Center) })
	confettiHolder = Theme.new("Frame", {
		Position = UDim2.fromOffset(0, -80),
		Size = UDim2.new(1, 0, 1, 80),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		Parent = overlay,
	})

	-- Escala en pantallas pequeñas.
	local scaled = { gui.TopBar, gui.Menu, refs.quests, refs.tutorial, toastHolder, refs.settings }
	local function updateScale()
		local camera = Workspace.CurrentCamera
		if not camera then
			return
		end
		local viewport = camera.ViewportSize
		local scale = math.clamp(math.min(viewport.X / 1280, viewport.Y / 720), 0.55, 1)
		for _, frame in ipairs(scaled) do
			local uiScale = frame:FindFirstChild("ViewportScale")
				or Theme.new("UIScale", { Name = "ViewportScale", Parent = frame })
			uiScale.Scale = scale
		end
		-- En pantallas estrechas las misiones empiezan ocultas.
		if viewport.X < 900 and refs.quests.Visible and not refs.questsAutoHidden then
			refs.questsAutoHidden = true
			questsVisible = false
			refs.quests.Visible = false
		end
	end
	updateScale()
	if Workspace.CurrentCamera then
		Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
	end
end

return HUD
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="26">
            <Properties>
              <string name="Name">Machine</string>
              <string name="Source"><![CDATA[-- Máquina de colores: panel inferior con carrete animado, cartel sobre la
-- máquina del taller, aviso de colores raros y ventana de colección.

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Colors = require(Shared.Colors)
local Config = require(Shared.Config)

local Theme = require(script.Parent.Theme)
local DesignArt = require(script.Parent.DesignArt)

local Machine = {}

local C = Theme.Colors
local player = Players.LocalPlayer

local app
local gui
local refs = {}
local board = {}
local collection
local lastRollAt = -100
local rolling = false
local spinning = false
local spinToken = 0
local knownPaints = nil
local rollCooldown = 2.5

local function rarityText(colorId)
	local entry = Colors.ById[colorId]
	if not entry then
		return "¡Tira tu primer color!", C.InkSoft
	end
	local rarity = Colors.rarityOf(entry)
	return rarity.name .. "  ·  x" .. string.format("%.1f", rarity.mult), rarity.color
end

local function myMachine()
	local name = app.state and app.state.plotName or ""
	local plots = Workspace:FindFirstChild("Plots")
	local plot = plots and name ~= "" and plots:FindFirstChild(name)
	local workshop = plot and plot:FindFirstChild("Workshop")
	return workshop and workshop:FindFirstChild("Machine")
end

-- Panel inferior -------------------------------------------------------------------------------
local function buildWidget()
	local holder, body = Theme.card({
		Name = "MachineWidget",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -14),
		Size = UDim2.fromOffset(500, 120),
		Radius = 24,
		Parent = gui,
	})
	refs.widget = holder

	-- Carrete.
	local reel = Theme.new("Frame", {
		Position = UDim2.fromOffset(12, 12),
		Size = UDim2.fromOffset(96, 96),
		BackgroundColor3 = C.White,
		Parent = body,
	}, { Theme.corner(22), Theme.gradient("dark", 90) })
	refs.reelStroke = Theme.stroke(C.InkFaint, 3)
	refs.reelStroke.Parent = reel
	refs.swatch = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(66, 66),
		BackgroundColor3 = Color3.fromRGB(90, 80, 120),
		Parent = reel,
	}, { Theme.round(), Theme.stroke(C.White, 3, 0.2) })
	refs.swatchShine = Theme.new("Frame", {
		Position = UDim2.fromScale(0.2, 0.14),
		Size = UDim2.fromScale(0.28, 0.2),
		BackgroundColor3 = C.White,
		BackgroundTransparency = 0.45,
		Rotation = -25,
		Parent = refs.swatch,
	}, { Theme.round() })

	-- Texto.
	Theme.label({
		Position = UDim2.fromOffset(122, 12),
		Size = UDim2.new(1, -290, 0, 16),
		Text = "MÁQUINA DE COLORES",
		Font = Theme.Fonts.Heavy,
		TextColor3 = C.InkFaint,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 13,
		Parent = body,
	})
	refs.name = Theme.label({
		Position = UDim2.fromOffset(122, 30),
		Size = UDim2.new(1, -290, 0, 30),
		Text = "",
		Font = Theme.Fonts.Display,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 26,
		Parent = body,
	})
	local chip, chipLabel = Theme.chip({
		Position = UDim2.fromOffset(122, 64),
		Size = UDim2.fromOffset(150, 24),
		Color = C.PanelSoft,
		Text = "",
		MaxTextSize = 13,
		Parent = body,
	})
	refs.rarityChip = chip
	refs.rarityLabel = chipLabel
	refs.count = Theme.label({
		Position = UDim2.fromOffset(122, 92),
		Size = UDim2.new(1, -290, 0, 18),
		Text = "",
		Font = Theme.Fonts.Medium,
		TextColor3 = C.InkSoft,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 14,
		Parent = body,
	})

	-- Botones.
	refs.rollButton = Theme.button({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 12),
		Size = UDim2.fromOffset(148, 54),
		Text = "🎲 TIRAR",
		Variant = "primary",
		Radius = 16,
		MaxTextSize = 24,
		Parent = body,
		OnClick = function()
			Machine.roll()
		end,
	})
	refs.cooldown = Theme.progress({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 72),
		Size = UDim2.fromOffset(148, 6),
		Gradient = "mint",
		Parent = body,
	})
	refs.autoButton = Theme.button({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -62, 0, 84),
		Size = UDim2.fromOffset(100, 28),
		Text = "🔒 Auto",
		Variant = "ghost",
		Radius = 14,
		MaxTextSize = 14,
		Parent = body,
		OnClick = function()
			Machine.toggleAuto()
		end,
	})
	Theme.button({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 84),
		Size = UDim2.fromOffset(42, 28),
		Text = "📚",
		Variant = "ghost",
		Radius = 14,
		MaxTextSize = 16,
		Parent = body,
		OnClick = function()
			Machine.openCollection()
		end,
	})
end

-- Cartel sobre la máquina del taller.
local function buildBoard()
	board.gui = Theme.new("BillboardGui", {
		Name = "MachineBoard",
		Size = UDim2.fromOffset(240, 130),
		StudsOffset = Vector3.new(0, 1.5, 0),
		MaxDistance = 50,
		LightInfluence = 0,
		ResetOnSpawn = false,
		Active = true,
		Enabled = false,
		Parent = player:WaitForChild("PlayerGui"),
	})
	local card = Theme.new("Frame", {
		Size = UDim2.new(1, 0, 0, 74),
		BackgroundColor3 = C.White,
		BackgroundTransparency = 0.05,
		Parent = board.gui,
	}, { Theme.corner(18), Theme.stroke(C.Border, 2) })
	board.name = Theme.label({
		Position = UDim2.fromOffset(10, 8),
		Size = UDim2.new(1, -20, 0, 30),
		Text = "",
		Font = Theme.Fonts.Display,
		MaxTextSize = 22,
		Parent = card,
	})
	board.rarity = Theme.label({
		Position = UDim2.fromOffset(10, 40),
		Size = UDim2.new(1, -20, 0, 24),
		Text = "",
		Font = Theme.Fonts.Heavy,
		MaxTextSize = 17,
		Parent = card,
	})
	board.auto = Theme.new("TextButton", {
		Position = UDim2.fromOffset(0, 82),
		Size = UDim2.new(0.56, -4, 0, 40),
		BackgroundColor3 = C.White,
		Font = Theme.Fonts.Heavy,
		Text = "🔒 Auto-Rolling",
		TextScaled = true,
		TextColor3 = C.InkSoft,
		Parent = board.gui,
	}, { Theme.round(), Theme.stroke(C.Border, 2), Theme.padding(9, 10) })
	board.auto.Activated:Connect(function()
		Machine.toggleAuto()
	end)
	local upgrade = Theme.new("TextButton", {
		Position = UDim2.new(0.56, 4, 0, 82),
		Size = UDim2.new(0.44, -4, 0, 40),
		BackgroundColor3 = C.White,
		Font = Theme.Fonts.Heavy,
		Text = "⬆ Mejora",
		TextScaled = true,
		TextColor3 = C.White,
		Parent = board.gui,
	}, { Theme.round(), Theme.gradient("gold", 90), Theme.padding(9, 10) })
	upgrade.Activated:Connect(function()
		app.openShop()
	end)
end

-- Aviso grande de color raro.
local function buildPopup()
	refs.popup = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.42),
		Size = UDim2.fromOffset(320, 300),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 30,
		Parent = gui,
	})
	local cardHolder, card = Theme.card({
		Size = UDim2.fromScale(1, 1),
		Radius = 30,
		ShadowTransparency = 0.6,
		Parent = refs.popup,
	})
	refs.popupCard = card
	refs.popupHolder = cardHolder
	refs.popupStroke = card:FindFirstChildOfClass("UIStroke")
	refs.popupStroke.Thickness = 5
	refs.popupBand = Theme.new("Frame", {
		Size = UDim2.new(1, 0, 0, 70),
		BackgroundColor3 = C.White,
		Parent = card,
	}, { Theme.corner(30), Theme.gradient("gold", 0) })
	refs.popupRarity = Theme.label({
		Position = UDim2.fromOffset(10, 12),
		Size = UDim2.new(1, -20, 0, 46),
		Text = "",
		Font = Theme.Fonts.Display,
		TextColor3 = C.White,
		MaxTextSize = 40,
		Parent = card,
	})
	Theme.textStroke(C.Shadow, 2, 0.6).Parent = refs.popupRarity
	refs.popupSwatch = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 86),
		Size = UDim2.fromOffset(120, 120),
		Parent = card,
	}, { Theme.round(), Theme.stroke(C.White, 6) })
	refs.popupSparkles = {}
	for i = 1, 6 do
		local sparkle = Theme.label({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(28, 28),
			Text = "✦",
			Font = Theme.Fonts.Heavy,
			TextColor3 = C.Gold,
			MaxTextSize = 26,
			Parent = card,
		})
		refs.popupSparkles[i] = sparkle
	end
	refs.popupName = Theme.label({
		Position = UDim2.fromOffset(10, 214),
		Size = UDim2.new(1, -20, 0, 36),
		Text = "",
		Font = Theme.Fonts.Display,
		MaxTextSize = 30,
		Parent = card,
	})
	refs.popupMult = Theme.label({
		Position = UDim2.fromOffset(10, 252),
		Size = UDim2.new(1, -20, 0, 26),
		Text = "",
		Font = Theme.Fonts.Bold,
		TextColor3 = C.MintDark,
		MaxTextSize = 20,
		Parent = card,
	})
end

local popupToken = 0
local function showPopup(colorId, isNew)
	local entry = Colors.ById[colorId]
	local rarity = Colors.rarityOf(entry)
	popupToken += 1
	local token = popupToken
	refs.popupStroke.Color = rarity.color
	local band = refs.popupBand:FindFirstChildOfClass("UIGradient")
	band.Color = ColorSequence.new(rarity.color:Lerp(C.White, 0.25), rarity.color)
	refs.popupRarity.Text = "¡" .. (isNew and "NUEVO · " or "") .. Theme.upper(rarity.name) .. "!"
	DesignArt.swatch(refs.popupSwatch, colorId)
	refs.popupName.Text = entry.name
	refs.popupMult.Text = "Multiplica tus cuadros x" .. string.format("%.1f", rarity.mult)
	refs.popup.Visible = true
	Theme.pop(refs.popupHolder, 0.3)
	Theme.playSound("success", 0.7 + rarity.index * 0.1)
	if rarity.index >= 4 then
		app.celebrate()
	end
	task.spawn(function()
		local t0 = os.clock()
		while token == popupToken and refs.popup.Visible do
			local t = os.clock() - t0
			for i, sparkle in ipairs(refs.popupSparkles) do
				local angle = t * 1.6 + i / #refs.popupSparkles * math.pi * 2
				sparkle.Position = UDim2.new(0.5, math.cos(angle) * 92, 0, 146 + math.sin(angle) * 74)
				sparkle.Rotation = t * 120
				sparkle.TextColor3 = rarity.color:Lerp(C.White, (math.sin(t * 5 + i) + 1) * 0.25)
			end
			task.wait()
		end
	end)
	task.delay(rarity.index >= 4 and 3.2 or 2.2, function()
		if token == popupToken then
			refs.popup.Visible = false
		end
	end)
end

-- Colección -------------------------------------------------------------------------------------
local function buildCollection()
	local holderGui = Theme.new("ScreenGui", {
		Name = "Collection",
		ResetOnSpawn = false,
		DisplayOrder = 12,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	collection = Theme.window({
		Name = "Window",
		Parent = holderGui,
		Size = UDim2.fromOffset(880, 600),
		Gradient = "blue",
		Title = "📚 Colección de pinturas",
		Subtitle = "Descubre todos los colores. Cuanto más raros, más valen tus cuadros.",
	})
	refs.collectionProgress = Theme.label({
		Position = UDim2.new(1, -330, 0, 14),
		Size = UDim2.fromOffset(250, 24),
		Text = "",
		Font = Theme.Fonts.Heavy,
		TextColor3 = C.White,
		TextXAlignment = Enum.TextXAlignment.Right,
		MaxTextSize = 18,
		Parent = collection.Header,
	})
	refs.collectionList = Theme.new("ScrollingFrame", {
		Position = UDim2.fromOffset(20, 14),
		Size = UDim2.new(1, -40, 1, -28),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = C.InkFaint,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = collection.Body,
	}, {
		Theme.list("v", 8),
		Theme.new("UIPadding", {
			PaddingLeft = UDim.new(0, 4),
			PaddingRight = UDim.new(0, 12),
			PaddingTop = UDim.new(0, 4),
			PaddingBottom = UDim.new(0, 10),
		}),
	})
end

local function colorCell(parent, entry, count, order)
	local known = entry.basic or count > 0 or (knownPaints and knownPaints[entry.id])
	local _, cell = Theme.card({ Size = UDim2.fromOffset(110, 112), Radius = 16, LayoutOrder = order, Parent = parent })
	local swatch = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 10),
		Size = UDim2.fromOffset(56, 56),
		BackgroundColor3 = C.Border,
		Parent = cell,
	}, { Theme.round() })
	if known then
		DesignArt.swatch(swatch, entry.id)
		Theme.stroke(Colors.rarityOf(entry).color, 3).Parent = swatch
	else
		Theme.label({
			Size = UDim2.fromScale(1, 1),
			Text = "?",
			Font = Theme.Fonts.Display,
			TextColor3 = C.InkFaint,
			MaxTextSize = 30,
			Parent = swatch,
		})
	end
	Theme.label({
		Position = UDim2.fromOffset(4, 70),
		Size = UDim2.new(1, -8, 0, 18),
		Text = known and entry.name or "???",
		Font = Theme.Fonts.Bold,
		MaxTextSize = 15,
		Parent = cell,
	})
	Theme.label({
		Position = UDim2.fromOffset(4, 88),
		Size = UDim2.new(1, -8, 0, 16),
		Text = entry.basic and "∞" or ("x" .. count),
		Font = Theme.Fonts.Heavy,
		TextColor3 = count > 0 and C.MintDark or C.InkFaint,
		MaxTextSize = 14,
		Parent = cell,
	})
end

function Machine.refreshCollection()
	if not (collection and collection.Holder.Visible and app.state) then
		return
	end
	local list = refs.collectionList
	for _, child in ipairs(list:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	local chances = Colors.chances(Config.luck(app.state.upgrades))
	local found, total = 0, 0
	for _, entry in ipairs(Colors.List) do
		if not entry.basic then
			total += 1
			if knownPaints and knownPaints[entry.id] then
				found += 1
			end
		end
	end
	refs.collectionProgress.Text = "Descubiertos " .. found .. "/" .. total
	local order = 0
	local sections = {}
	for i = #Colors.Rarities, 1, -1 do
		table.insert(sections, Colors.Rarities[i])
	end
	table.insert(sections, Colors.BASIC_RARITY)
	for _, rarity in ipairs(sections) do
		order += 1
		local header = Theme.new(
			"Frame",
			{ Size = UDim2.new(1, 0, 0, 34), BackgroundTransparency = 1, LayoutOrder = order, Parent = list }
		)
		local chip = Theme.chip({
			Size = UDim2.fromOffset(150, 30),
			Color = rarity.color,
			Text = rarity.name,
			TextColor3 = C.White,
			MaxTextSize = 16,
			Parent = header,
		})
		chip.Position = UDim2.fromOffset(0, 2)
		Theme.label({
			Position = UDim2.fromOffset(160, 4),
			Size = UDim2.new(1, -170, 0, 26),
			Text = rarity.id == "basico" and "Siempre disponibles · x1.0"
				or string.format("Valor x%.1f  ·  %.1f%% por tirada", rarity.mult, chances[rarity.id] * 100),
			Font = Theme.Fonts.Bold,
			TextColor3 = C.InkSoft,
			TextXAlignment = Enum.TextXAlignment.Left,
			MaxTextSize = 17,
			Parent = header,
		})
		order += 1
		local entries = {}
		for _, entry in ipairs(Colors.List) do
			if (rarity.id == "basico" and entry.basic) or entry.rarity == rarity.id then
				table.insert(entries, entry)
			end
		end
		local rows = math.ceil(#entries / 7)
		local grid = Theme.new("Frame", {
			Size = UDim2.new(1, 0, 0, rows * 122),
			BackgroundTransparency = 1,
			LayoutOrder = order,
			Parent = list,
		}, {
			Theme.new("UIGridLayout", {
				CellSize = UDim2.fromOffset(110, 112),
				CellPadding = UDim2.fromOffset(8, 10),
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
		})
		for i, entry in ipairs(entries) do
			colorCell(grid, entry, app.state.paints[entry.id] or 0, i)
		end
	end
end

function Machine.openCollection()
	collection.Open()
	Machine.refreshCollection()
end

-- Acciones -------------------------------------------------------------------------------------
local function jiggleBalls()
	local machine = myMachine()
	if not machine then
		return
	end
	for _, ball in ipairs(machine:GetChildren()) do
		if ball.Name == "Ball" and ball:IsA("BasePart") then
			local base = ball.CFrame
			local up = base * CFrame.new(math.random() - 0.5, math.random() * 0.9, math.random() - 0.5)
			Theme.tween(ball, 0.12, { CFrame = up })
			task.delay(0.14, function()
				if ball.Parent then
					Theme.tween(ball, 0.25, { CFrame = base }, Enum.EasingStyle.Bounce)
				end
			end)
		end
	end
end

local function showColor(colorId)
	local entry = Colors.ById[colorId]
	if entry then
		DesignArt.swatch(refs.swatch, colorId)
	end
	local text, color = rarityText(colorId)
	refs.name.Text = entry and entry.name or "Sin colores"
	refs.rarityLabel.Text = text
	refs.rarityChip.BackgroundColor3 = entry and color or C.PanelSoft
	refs.rarityLabel.TextColor3 = entry and C.White or C.InkSoft
	refs.reelStroke.Color = color
	board.name.Text = entry and entry.name or "Máquina de colores"
	board.rarity.Text = text
	board.rarity.TextColor3 = color
end

function Machine.roll()
	if rolling or spinning then
		return
	end
	if os.clock() - lastRollAt < rollCooldown then
		return
	end
	rolling = true
	local ok, result = pcall(function()
		return app.remotes.Roll:InvokeServer()
	end)
	rolling = false
	if ok and not result then
		app.notify("La máquina se está recargando ⚙️", "info")
	end
end

function Machine.toggleAuto()
	local state = app.state
	if not (state and state.autoUnlocked) then
		app.notify("🔒 Compra «Auto-Rolling» en Mejoras para que la máquina tire sola", "info")
		app.openShop()
		return
	end
	app.remotes.SetAutoRoll:FireServer(not state.autoRoll)
	Theme.playSound("click", state.autoRoll and 0.9 or 1.2)
end

function Machine.onRoll(colorId, auto)
	lastRollAt = os.clock()
	local entry = Colors.ById[colorId]
	if not entry then
		return
	end
	local isNew = knownPaints ~= nil and not knownPaints[colorId]
	if knownPaints then
		knownPaints[colorId] = true
	end
	spinToken += 1
	local token = spinToken
	spinning = true
	jiggleBalls()
	task.spawn(function()
		local steps = auto and 7 or 14
		local options = {}
		for _, option in ipairs(Colors.List) do
			if not option.basic then
				table.insert(options, option.id)
			end
		end
		for i = 1, steps do
			if token ~= spinToken then
				return
			end
			DesignArt.swatch(refs.swatch, options[math.random(1, #options)])
			if i % 2 == 0 then
				Theme.playSound("click", 1.4 + i * 0.03)
			end
			task.wait(0.03 + i * (auto and 0.006 or 0.009))
		end
		if token ~= spinToken then
			return
		end
		spinning = false
		showColor(colorId)
		Theme.pop(refs.swatch, 0.5)
		local rarity = Colors.rarityOf(entry)
		if rarity.index >= 3 or isNew then
			showPopup(colorId, isNew)
		else
			Theme.playSound("success", 1.3)
		end
		if app.state then
			refs.count.Text = "Tienes x" .. (app.state.paints[colorId] or 0) .. " de este color"
		end
	end)
end

function Machine.applyState(state)
	if knownPaints == nil then
		knownPaints = {}
		for colorId, count in pairs(state.paints) do
			if count > 0 then
				knownPaints[colorId] = true
			end
		end
	end
	rollCooldown = state.rollInterval or rollCooldown
	if not spinning then
		showColor(state.lastRoll)
		refs.count.Text = Colors.ById[state.lastRoll]
				and ("Tienes x" .. (state.paints[state.lastRoll] or 0) .. " de este color")
			or "Pulsa TIRAR o acércate a la máquina"
	end
	if not state.autoUnlocked then
		refs.autoButton.SetText("🔒 Auto")
		refs.autoButton.SetVariant("ghost")
		board.auto.Text = "🔒 Auto-Rolling"
		board.auto.TextColor3 = C.InkSoft
	elseif state.autoRoll then
		refs.autoButton.SetText("🔄 Auto: Sí")
		refs.autoButton.SetVariant("mint")
		board.auto.Text = "🔄 Auto-Rolling"
		board.auto.TextColor3 = C.MintDark
	else
		refs.autoButton.SetText("⏸ Auto: No")
		refs.autoButton.SetVariant("ghost")
		board.auto.Text = "⏸ Auto-Rolling"
		board.auto.TextColor3 = C.InkSoft
	end
	Machine.refreshCollection()
end

function Machine.init(appRef)
	app = appRef
	gui = Theme.new("ScreenGui", {
		Name = "MachineHud",
		ResetOnSpawn = false,
		DisplayOrder = 3,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	buildWidget()
	buildBoard()
	buildPopup()
	buildCollection()

	-- Recarga del botón y cartel sobre la máquina.
	task.spawn(function()
		while true do
			task.wait(0.05)
			local fraction = math.clamp((os.clock() - lastRollAt) / rollCooldown, 0, 1)
			refs.cooldown.Set(fraction)
			refs.rollButton.SetEnabled(fraction >= 1 and not spinning)
			if app.state and not board.gui.Adornee then
				local machine = myMachine()
				local top = machine and machine:FindFirstChild("Top")
				board.gui.Adornee = top
				board.gui.Enabled = top ~= nil
			elseif board.gui.Adornee and not board.gui.Adornee.Parent then
				board.gui.Adornee = nil
				board.gui.Enabled = false
			end
		end
	end)

	local function updateScale()
		local camera = Workspace.CurrentCamera
		if camera then
			local viewport = camera.ViewportSize
			local scale = math.clamp(math.min(viewport.X / 1280, viewport.Y / 720), 0.6, 1)
			local uiScale = refs.widget:FindFirstChild("ViewportScale")
				or Theme.new("UIScale", { Name = "ViewportScale", Parent = refs.widget })
			uiScale.Scale = scale
		end
	end
	updateScale()
	if Workspace.CurrentCamera then
		Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
	end
	local popupScale = Theme.new("UIScale", { Name = "ViewportScale", Parent = refs.popup })
	local function updatePopupScale()
		local camera = Workspace.CurrentCamera
		if camera then
			popupScale.Scale = math.clamp(camera.ViewportSize.Y / 720, 0.6, 1)
		end
	end
	updatePopupScale()
end

function Machine.setVisible(visible)
	gui.Enabled = visible
end

return Machine
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="27">
            <Properties>
              <string name="Name">Painter</string>
              <string name="Source"><![CDATA[-- Estudio de pintura: el diseño aparece en líneas y cada figura se rellena con
-- el color de su área mientras pasas el pincel. Cuanto más rápido terminas,
-- más estrellas (y más valor) consigue el cuadro.

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Colors = require(Shared.Colors)
local Config = require(Shared.Config)
local Designs = require(Shared.Designs)

local Theme = require(script.Parent.Theme)
local DesignArt = require(script.Parent.DesignArt)

local Painter = {}

local C = Theme.Colors
local SAMPLE_RING = 6

local app
local gui, root, canvasFrame, catcher, cursor, particles
local refs = {}
local current
local stroking = false
local pointer = nil
local tool = "brush"
local particleClock = 0
local soundClock = 0
local confirmCancelUntil = 0
local finishing = false

-- Utilidades ----------------------------------------------------------------------------------
local function levels()
	return app.state and app.state.upgrades or {}
end

local function canvasPoint(position)
	local absPos = canvasFrame.AbsolutePosition
	local absSize = canvasFrame.AbsoluteSize
	if absSize.X <= 0 then
		return nil
	end
	return (position.X - absPos.X) / absSize.X, (position.Y - absPos.Y) / absSize.Y
end

local function areaPercent(areaId)
	local total, done = 0, 0
	for i, shape in ipairs(current.design.shapes) do
		if shape.area == areaId then
			total += shape.visible
			done += shape.visible * current.progress[i]
		end
	end
	return total > 0 and done / total or 1
end

local function totalPercent()
	local total, done = 0, 0
	for i, shape in ipairs(current.design.shapes) do
		total += shape.visible
		done += shape.visible * current.progress[i]
	end
	return total > 0 and done / total or 1
end

local function isComplete()
	for i in ipairs(current.design.shapes) do
		if current.progress[i] < 1 then
			return false
		end
	end
	return true
end

local function elapsed()
	return os.clock() - current.started
end

local function currentStars()
	return Config.starsFor(current.design, levels(), elapsed())
end

local function refreshLabels()
	for areaId, row in pairs(current.areaRows) do
		local p = areaPercent(areaId)
		row.bar.Set(p)
		if p >= 0.999 then
			row.percent.Text = "✔"
			row.percent.TextColor3 = C.MintDark
		else
			row.percent.Text = math.floor(p * 100) .. "%"
			row.percent.TextColor3 = C.InkSoft
		end
	end
	local total = totalPercent()
	refs.percent.Text = math.floor(total * 100) .. "%"
	refs.progress.Set(total)
end

local function refreshTimer()
	if not current or current.done then
		return
	end
	local par = Config.parTime(current.design, levels())
	local t = elapsed()
	local limit = par * 2.5
	refs.timerBar.Set(1 - math.clamp(t / limit, 0, 1))
	local stars = currentStars()
	for i, star in ipairs(refs.stars) do
		star.TextColor3 = i <= stars and C.Gold or C.Border
	end
	refs.timerBar.SetGradient(stars >= 3 and "gold" or (stars == 2 and "orange" or "red"))
	refs.timerText.Text = string.format("%d:%02d", math.floor(t / 60), math.floor(t % 60))
end

-- Partículas -----------------------------------------------------------------------------------
local function spawnParticle(x, y, color, burst)
	local dot = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(x, y),
		Size = UDim2.fromScale(0.02, 0.02),
		BackgroundColor3 = color,
		ZIndex = 6,
		Parent = particles,
	}, { Theme.round() })
	local angle = math.random() * math.pi * 2
	local distance = (burst and 0.09 or 0.035) * (0.4 + math.random())
	Theme.tween(dot, 0.45, {
		Position = UDim2.fromScale(x + math.cos(angle) * distance, y + math.sin(angle) * distance),
		Size = UDim2.fromScale(0.004, 0.004),
		BackgroundTransparency = 1,
	})
	task.delay(0.5, function()
		dot:Destroy()
	end)
end

-- Pintar ---------------------------------------------------------------------------------------
local function setShapeProgress(i, p)
	current.progress[i] = p
	current.art.setProgress(i, p)
end

local function areaColor(shapeIndex)
	local shape = current.design.shapes[shapeIndex]
	return Colors.mainColor(current.colors[shape.area])
end

-- El relleno empieza en el lado por el que entró el pincel.
local function aimFill(index, x, y)
	if current.progress[index] > 0 then
		return
	end
	local shape = current.design.shapes[index]
	local dx, dy = shape.x - x, shape.y - y
	if dx * dx + dy * dy > 0.0001 then
		current.art.setFillDirection(index, math.deg(math.atan2(dy, dx)) - shape.rot)
	end
end

local function completeIfDone()
	if not current.done and isComplete() then
		current.done = true
		current.finishedAt = elapsed()
		stroking = false
		refreshLabels()
		task.delay(0.4, function()
			if current and current.done then
				Painter.showComplete()
			end
		end)
	end
end

local function brush(x, y, dt)
	local radius = Config.brushRadius(levels())
	local speed = Config.brushSpeed(levels())
	local hits = {}
	local samples = { { x, y } }
	for k = 0, SAMPLE_RING - 1 do
		local angle = k / SAMPLE_RING * math.pi * 2
		table.insert(samples, { x + math.cos(angle) * radius, y + math.sin(angle) * radius })
	end
	for _, point in ipairs(samples) do
		local index = Designs.shapeAt(current.design, point[1], point[2])
		if index and current.progress[index] < 1 then
			hits[index] = (hits[index] or 0) + 1
		end
	end
	local painted = nil
	for index, count in pairs(hits) do
		aimFill(index, x, y)
		local time = Designs.shapeTime(current.design.shapes[index])
		-- Basta con rozar una figura para pintarla; cubrirla entera va más rápido.
		local coverage = 0.6 + 0.4 * count / #samples
		local amount = dt * speed * coverage * 1.15 / math.max(time, 0.05)
		setShapeProgress(index, math.min(1, current.progress[index] + amount))
		if current.progress[index] >= 1 then
			for _ = 1, 4 do
				spawnParticle(x, y, areaColor(index), true)
			end
		end
		painted = index
	end
	if painted then
		particleClock += dt
		if particleClock > 0.05 then
			particleClock = 0
			spawnParticle(x, y, areaColor(painted), false)
		end
		soundClock += dt
		if soundClock > 0.18 then
			soundClock = 0
			Theme.playSound("paint", 0.9 + math.random() * 0.3)
		end
	end
	return painted ~= nil
end

local function bucket(x, y)
	local index = Designs.shapeAt(current.design, x, y)
	if index and current.progress[index] < 1 then
		aimFill(index, x, y)
		setShapeProgress(index, 1)
		for _ = 1, 10 do
			spawnParticle(x, y, areaColor(index), true)
		end
		Theme.playSound("whoosh", 1.3)
		refreshLabels()
		completeIfDone()
	end
end

local function updateCursor()
	if not pointer or not current or current.done then
		cursor.Visible = false
		return
	end
	local x, y = canvasPoint(pointer)
	if not x or x < 0 or y < 0 or x > 1 or y > 1 then
		cursor.Visible = false
		return
	end
	local radius = tool == "bucket" and 0.025 or Config.brushRadius(levels())
	cursor.Visible = true
	cursor.Position = UDim2.fromScale(x, y)
	cursor.Size = UDim2.fromScale(radius * 2.4, radius * 2.4)
	local index = Designs.shapeAt(current.design, x, y)
	cursor.BackgroundColor3 = index and areaColor(index) or C.White
end

local function onStep(dt)
	if not current then
		return
	end
	updateCursor()
	current.timerClock = (current.timerClock or 0) + dt
	if current.timerClock > 0.2 then
		current.timerClock = 0
		refreshTimer()
	end
	if stroking and pointer and not current.done and tool == "brush" then
		local x, y = canvasPoint(pointer)
		if x and x >= -0.05 and y >= -0.05 and x <= 1.05 and y <= 1.05 then
			if brush(x, y, math.min(dt, 0.1)) then
				current.labelClock = (current.labelClock or 0) + dt
				if current.labelClock > 0.1 then
					current.labelClock = 0
					refreshLabels()
				end
				completeIfDone()
			end
		end
	end
end

-- Interfaz ---------------------------------------------------------------------------------------
local function setTool(name)
	tool = name
	refs.brushButton.SetVariant(name == "brush" and "primary" or "ghost")
	refs.bucketButton.SetVariant(name == "bucket" and "primary" or "ghost")
end

local function buildTopBar(parent)
	refs.exit = Theme.button({
		Position = UDim2.fromOffset(18, 14),
		Size = UDim2.fromOffset(130, 46),
		Text = "✕ Salir",
		Variant = "ghost",
		Color = C.Red,
		TextColor = C.Red,
		Parent = parent,
		OnClick = function()
			Painter.requestCancel()
		end,
	})
	refs.title = Theme.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 8),
		Size = UDim2.new(0.44, 0, 0, 38),
		Text = "",
		Font = Theme.Fonts.Display,
		MaxTextSize = 34,
		Parent = parent,
	})
	refs.progress = Theme.progress({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, -24, 0, 52),
		Size = UDim2.new(0.28, 0, 0, 12),
		Gradient = "mint",
		Parent = parent,
	})
	refs.percent = Theme.label({
		AnchorPoint = Vector2.new(0, 0),
		Position = UDim2.new(0.64, -16, 0, 46),
		Size = UDim2.fromOffset(60, 24),
		Text = "0%",
		Font = Theme.Fonts.Heavy,
		TextColor3 = C.MintDark,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 18,
		Parent = parent,
	})
	refs.brushButton = Theme.button({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -168, 0, 14),
		Size = UDim2.fromOffset(140, 46),
		Text = "🖌️ Pincel",
		Parent = parent,
		OnClick = function()
			setTool("brush")
		end,
	})
	refs.bucketButton = Theme.button({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -18, 0, 14),
		Size = UDim2.fromOffset(140, 46),
		Text = "🪣 Cubeta",
		Variant = "ghost",
		Parent = parent,
		OnClick = function()
			if Config.hasBucket(levels()) then
				setTool("bucket")
			else
				app.notify("🔒 Compra la mejora «Cubeta mágica» 🪣", "info")
			end
		end,
	})
end

local function buildTimer(parent)
	local holder, body = Theme.card({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 76),
		Size = UDim2.fromOffset(330, 40),
		Radius = 20,
		Parent = parent,
	})
	refs.timerCard = holder
	refs.stars = {}
	for i = 1, 3 do
		refs.stars[i] = Theme.label({
			Position = UDim2.fromOffset(10 + (i - 1) * 26, 6),
			Size = UDim2.fromOffset(26, 28),
			Text = "★",
			Font = Theme.Fonts.Heavy,
			TextColor3 = C.Gold,
			MaxTextSize = 26,
			Parent = body,
		})
	end
	refs.timerBar = Theme.progress({
		Position = UDim2.fromOffset(96, 15),
		Size = UDim2.new(1, -170, 0, 10),
		Gradient = "gold",
		Parent = body,
	})
	refs.timerText = Theme.label({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 8),
		Size = UDim2.fromOffset(56, 24),
		Text = "0:00",
		Font = Theme.Fonts.Heavy,
		TextColor3 = C.InkSoft,
		TextXAlignment = Enum.TextXAlignment.Right,
		MaxTextSize = 18,
		Parent = body,
	})
end

local function buildCanvas(parent)
	local canvasCard = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 46),
		Size = UDim2.new(0.56, 0, 1, -196),
		BackgroundTransparency = 1,
		Parent = parent,
	}, { Theme.new("UIAspectRatioConstraint", { AspectRatio = 1 }) })
	local _, canvasBody = Theme.card({
		Size = UDim2.fromScale(1, 1),
		Radius = 22,
		ShadowOffset = 8,
		ShadowTransparency = 0.8,
		StrokeColor = C.White,
		StrokeThickness = 6,
		Parent = canvasCard,
	})
	canvasFrame = Theme.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		Parent = canvasBody,
	}, { Theme.corner(22) })
	particles = Theme.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 6,
		Parent = canvasBody,
	})
	cursor = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromScale(0.07, 0.07),
		BackgroundTransparency = 0.3,
		Visible = false,
		ZIndex = 8,
		Parent = canvasBody,
	}, { Theme.round(), Theme.stroke(C.Ink, 2.5) })
	catcher = Theme.new("TextButton", {
		Name = "PaintInput",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 9,
		Parent = canvasBody,
	})
	catcher.InputBegan:Connect(function(input)
		if not current or current.done then
			return
		end
		if
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			pointer = input.Position
			if tool == "bucket" then
				local x, y = canvasPoint(pointer)
				if x then
					bucket(x, y)
				end
			else
				stroking = true
			end
		end
	end)
end

local function buildColumns(parent)
	for _, side in ipairs({ "left", "right" }) do
		local column = Theme.new("Frame", {
			Name = side,
			AnchorPoint = Vector2.new(side == "left" and 0 or 1, 0.5),
			Position = UDim2.new(side == "left" and 0 or 1, side == "left" and 18 or -18, 0.5, 46),
			Size = UDim2.new(0.19, 0, 1, -200),
			BackgroundTransparency = 1,
			Parent = parent,
		}, { Theme.list("v", 10, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center) })
		refs[side] = column
	end
end

local function buildValue(parent)
	local holder, body = Theme.card({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -10),
		Size = UDim2.fromOffset(420, 38),
		Radius = 19,
		Parent = parent,
	})
	refs.valueCard = holder
	refs.value = Theme.label({
		Size = UDim2.new(1, -20, 1, -8),
		Position = UDim2.fromOffset(10, 4),
		Text = "",
		Font = Theme.Fonts.Heavy,
		TextColor3 = C.MintDark,
		MaxTextSize = 19,
		Parent = body,
	})
end

-- Ventana de cuadro terminado.
local function buildComplete()
	refs.done = Theme.new("Frame", {
		Position = UDim2.fromOffset(0, -80),
		Size = UDim2.new(1, 0, 1, 80),
		BackgroundColor3 = C.Shadow,
		BackgroundTransparency = 0.45,
		Visible = false,
		ZIndex = 20,
		Parent = gui,
	})
	local wrapper = Theme.new("Frame", {
		Name = "Wrapper",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 16),
		Size = UDim2.fromOffset(480, 610),
		BackgroundTransparency = 1,
		ZIndex = 20,
		Parent = refs.done,
	})
	refs.doneWrapper = wrapper
	local panelCard, panel = Theme.card({
		Size = UDim2.fromScale(1, 1),
		Radius = 28,
		ShadowTransparency = 0.55,
		ShadowOffset = 10,
		StrokeColor = C.White,
		StrokeThickness = 3,
		Parent = wrapper,
	})
	refs.donePanel = panel
	refs.donePanelCard = panelCard
	local band = Theme.new("Frame", {
		Size = UDim2.new(1, 0, 0, 120),
		BackgroundColor3 = C.White,
		Parent = panel,
	}, { Theme.corner(28), Theme.gradient("primary", 0) })
	local title = Theme.label({
		Position = UDim2.fromOffset(20, 12),
		Size = UDim2.new(1, -40, 0, 44),
		Text = "¡Cuadro terminado!",
		Font = Theme.Fonts.Display,
		TextColor3 = C.White,
		MaxTextSize = 38,
		Parent = band,
	})
	Theme.textStroke(C.Shadow, 2, 0.7).Parent = title
	refs.doneStars = {}
	for i = 1, 3 do
		local star = Theme.label({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, (i - 2) * 64, 0, i == 2 and 84 or 90),
			Size = UDim2.fromOffset(i == 2 and 62 or 52, i == 2 and 62 or 52),
			Text = "★",
			Font = Theme.Fonts.Heavy,
			TextColor3 = C.Gold,
			MaxTextSize = 60,
			Parent = band,
		})
		Theme.textStroke(C.GoldDark, 2.5).Parent = star
		refs.doneStars[i] = star
	end
	local artBox = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 136),
		Size = UDim2.fromOffset(220, 220),
		BackgroundColor3 = C.White,
		Parent = panel,
	}, { Theme.corner(10), Theme.stroke(C.Gold, 8) })
	refs.doneArt = Theme.new(
		"Frame",
		{ Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = artBox },
		{ Theme.corner(10) }
	)
	refs.doneValue = Theme.label({
		Position = UDim2.fromOffset(20, 366),
		Size = UDim2.new(1, -40, 0, 36),
		Text = "",
		Font = Theme.Fonts.Display,
		TextColor3 = C.MintDark,
		MaxTextSize = 32,
		Parent = panel,
	})
	refs.doneBreakdown = Theme.label({
		Position = UDim2.fromOffset(20, 402),
		Size = UDim2.new(1, -40, 0, 22),
		Text = "",
		Font = Theme.Fonts.Bold,
		TextColor3 = C.InkSoft,
		MaxTextSize = 16,
		Parent = panel,
	})
	refs.doneInfo = Theme.label({
		Position = UDim2.fromOffset(20, 426),
		Size = UDim2.new(1, -40, 0, 22),
		Text = "",
		Font = Theme.Fonts.Medium,
		TextColor3 = C.InkSoft,
		MaxTextSize = 16,
		Parent = panel,
	})
	refs.exhibit = Theme.button({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 460),
		Size = UDim2.new(1, -60, 0, 62),
		Text = "",
		Variant = "mint",
		Radius = 18,
		Parent = panel,
		OnClick = function()
			Painter.finish("galeria")
		end,
	})
	refs.sell = Theme.button({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 534),
		Size = UDim2.new(1, -60, 0, 54),
		Text = "",
		Variant = "ghost",
		Color = C.Gold,
		Radius = 18,
		Parent = panel,
		OnClick = function()
			Painter.finish("vender")
		end,
	})
end

local function buildUI()
	gui = Theme.new("ScreenGui", {
		Name = "Painter",
		ResetOnSpawn = false,
		DisplayOrder = 15,
		Enabled = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = Players.LocalPlayer:WaitForChild("PlayerGui"),
	})
	-- Fondo que tapa también la barra superior de Roblox.
	local background = Theme.new("Frame", {
		Position = UDim2.fromOffset(0, -80),
		Size = UDim2.new(1, 0, 1, 80),
		BackgroundColor3 = C.White,
		Parent = gui,
	}, { Theme.gradient(Color3.fromRGB(250, 247, 255), Color3.fromRGB(236, 230, 252), 90) })
	root = Theme.new("Frame", {
		Position = UDim2.fromOffset(0, 80),
		Size = UDim2.new(1, 0, 1, -80),
		BackgroundTransparency = 1,
		Parent = background,
	})
	buildTopBar(root)
	buildTimer(root)
	buildCanvas(root)
	buildColumns(root)
	buildValue(root)
	buildComplete()
end

local function updateScales()
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local viewport = camera.ViewportSize
	local scale = math.clamp(math.min((viewport.X - 20) / 480, (viewport.Y - 70) / 610), 0.45, 1.1)
	local uiScale = refs.doneWrapper:FindFirstChild("ViewportScale")
		or Theme.new("UIScale", { Name = "ViewportScale", Parent = refs.doneWrapper })
	uiScale.Scale = scale
	local hudScale = math.clamp(math.min(viewport.X / 1280, viewport.Y / 720), 0.6, 1)
	for _, frame in ipairs({ refs.timerCard, refs.valueCard }) do
		local s = frame:FindFirstChild("ViewportScale")
			or Theme.new("UIScale", { Name = "ViewportScale", Parent = frame })
		s.Scale = hudScale
	end
end

local function bindInput()
	UserInputService.InputChanged:Connect(function(input)
		if not current then
			return
		end
		if
			input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch
		then
			pointer = input.Position
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			stroking = false
			if current then
				refreshLabels()
			end
		end
	end)
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or not current then
			return
		end
		if input.KeyCode == Enum.KeyCode.B then
			setTool("brush")
		elseif input.KeyCode == Enum.KeyCode.F and Config.hasBucket(levels()) then
			setTool("bucket")
		end
	end)
	RunService.RenderStepped:Connect(onStep)
end

local function setControlsEnabled(enabled)
	pcall(function()
		local playerModule = require(Players.LocalPlayer.PlayerScripts:WaitForChild("PlayerModule", 2))
		local controls = playerModule:GetControls()
		if enabled then
			controls:Enable()
		else
			controls:Disable()
		end
	end)
end

-- API --------------------------------------------------------------------------------------------
function Painter.open(design, colors)
	current = {
		design = design,
		colors = colors,
		progress = {},
		areaRows = {},
		done = false,
		started = os.clock(),
	}
	current.art = DesignArt.render(canvasFrame, design, { mode = "lineart", colors = colors, stroke = 2.5 })
	for i, shape in ipairs(design.shapes) do
		-- Las figuras completamente tapadas ya cuentan como pintadas.
		setShapeProgress(i, shape.visible <= 0 and 1 or 0)
	end
	for _, column in ipairs({ refs.left, refs.right }) do
		for _, child in ipairs(column:GetChildren()) do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end
	end
	local half = math.ceil(#design.areas / 2)
	for i, area in ipairs(design.areas) do
		local column = i <= half and refs.left or refs.right
		local _, body = Theme.card({
			Size = UDim2.new(1, 0, 0, 62),
			Radius = 16,
			LayoutOrder = i,
			Parent = column,
		})
		local swatch = Theme.new("Frame", {
			Position = UDim2.fromOffset(10, 11),
			Size = UDim2.fromOffset(40, 40),
			Parent = body,
		}, { Theme.round(), Theme.stroke(C.Border, 2.5) })
		DesignArt.swatch(swatch, colors[area.id])
		Theme.label({
			Position = UDim2.fromOffset(58, 8),
			Size = UDim2.new(1, -110, 0, 24),
			Text = area.name,
			Font = Theme.Fonts.Bold,
			TextXAlignment = Enum.TextXAlignment.Left,
			MaxTextSize = 19,
			Parent = body,
		})
		local percent = Theme.label({
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -10, 0, 8),
			Size = UDim2.fromOffset(46, 24),
			Text = "0%",
			Font = Theme.Fonts.Heavy,
			TextColor3 = C.InkSoft,
			TextXAlignment = Enum.TextXAlignment.Right,
			MaxTextSize = 17,
			Parent = body,
		})
		local bar = Theme.progress({
			Position = UDim2.fromOffset(58, 38),
			Size = UDim2.new(1, -70, 0, 10),
			Gradient = "mint",
			Parent = body,
		})
		current.areaRows[area.id] = { percent = percent, bar = bar }
	end
	refs.title.Text = design.name
	local made = app.state and app.state.made[design.id] or 0
	local base = Config.paintingValue(design, colors, levels(), made, 1)
	refs.value.Text = string.format(
		"💵 %s  ·  Colores x%.2f  ·  ⭐⭐⭐ +%d%%",
		Theme.formatNumber(base),
		Config.colorMultiplier(design, colors),
		math.floor(Config.STAR_BONUS[3] * 100)
	)
	refs.done.Visible = false
	setTool(tool == "bucket" and Config.hasBucket(levels()) and "bucket" or "brush")
	refreshLabels()
	refreshTimer()
	updateScales()
	gui.Enabled = true
	ProximityPromptService.Enabled = false
	setControlsEnabled(false)
	app.setHudVisible(false)
	Theme.playSound("whoosh")
	completeIfDone()
end

function Painter.isOpen()
	return current ~= nil
end

function Painter.close()
	current = nil
	stroking = false
	gui.Enabled = false
	refs.done.Visible = false
	ProximityPromptService.Enabled = true
	setControlsEnabled(true)
	app.setHudVisible(true)
end

function Painter.requestCancel()
	if not current then
		return
	end
	if os.clock() > confirmCancelUntil then
		confirmCancelUntil = os.clock() + 3
		refs.exit.SetText("¿Salir? Toca otra vez")
		task.delay(3, function()
			refs.exit.SetText("✕ Salir")
		end)
		app.notify("Si sales pierdes este cuadro (te devolvemos las pinturas).", "info")
		return
	end
	confirmCancelUntil = 0
	refs.exit.SetText("✕ Salir")
	app.remotes.CancelPainting:FireServer()
	Painter.close()
end

function Painter.showComplete()
	local state = app.state
	local design = current.design
	local stars = Config.starsFor(design, levels(), current.finishedAt or elapsed())
	current.stars = stars
	local made = state and state.made[design.id] or 0
	local value = Config.paintingValue(design, current.colors, levels(), made, stars)
	current.value = value
	local tier = Config.masteryFor(made)
	DesignArt.render(refs.doneArt, design, { mode = "color", colors = current.colors, outline = false })
	refs.doneValue.Text = "💵 Vale " .. Theme.formatNumber(value)
	refs.doneBreakdown.Text = string.format(
		"Colores x%.2f  ·  Estrellas +%d%%  ·  Maestría +%d%%",
		Config.colorMultiplier(design, current.colors),
		math.floor(Config.STAR_BONUS[stars] * 100),
		math.floor((tier and tier.bonus or 0) * 100)
	)
	local free = state and (state.slots - state.displayed) or 0
	refs.doneInfo.Text = free > 0 and ("Huecos libres en tu galería: " .. free)
		or "Tu galería está llena: compra «Más paredes» 🖼️"
	refs.exhibit.SetText(
		"🖼️ Exponer · un visitante pagará 💵 " .. Theme.formatNumber(math.floor(value * Config.GALLERY_BONUS))
	)
	refs.exhibit.SetEnabled(free > 0)
	refs.sell.SetText("💰 Vender ya · 💵 " .. Theme.formatNumber(value))
	for _, star in ipairs(refs.doneStars) do
		star.TextColor3 = C.White
		star.TextTransparency = 0.6
	end
	updateScales()
	refs.done.Visible = true
	Theme.pop(refs.donePanelCard, 0.6)
	Theme.playSound("success", 1)
	task.spawn(function()
		task.wait(0.35)
		for i = 1, stars do
			local star = refs.doneStars[i]
			if not star.Parent then
				return
			end
			star.TextColor3 = C.Gold
			star.TextTransparency = 0
			Theme.pop(star, 1.8)
			Theme.playSound("success", 0.9 + i * 0.15)
			task.wait(0.28)
		end
		if stars >= 3 then
			app.celebrate()
		end
	end)
end

function Painter.finish(choice)
	if finishing or not current then
		return
	end
	finishing = true
	local result
	for _ = 1, 30 do
		local ok, response = pcall(function()
			return app.remotes.FinishPainting:InvokeServer(choice)
		end)
		result = ok and response or nil
		if result and not result.ok and result.reason == "¡Aún no está terminado!" then
			task.wait(1)
		else
			break
		end
	end
	finishing = false
	if not (result and result.ok) then
		app.notify(result and result.reason or "No se pudo terminar el cuadro.", "error")
		return
	end
	Painter.close()
	local stars = string.rep("⭐", result.stars or 1)
	if result.displayed then
		app.notify(
			stars .. " ¡Expuesto! Un visitante lo comprará por 💵" .. Theme.formatNumber(result.price),
			"success"
		)
	else
		app.notify(stars .. " ¡Vendido por 💵" .. Theme.formatNumber(result.price) .. "!", "gold")
	end
	if result.mastery then
		app.notify("🏅 ¡Maestría de " .. result.mastery .. " en este diseño!", "gold")
	end
	if result.newLevel then
		app.notify("🔓 ¡Nivel " .. result.newLevel .. " de diseños desbloqueado!", "gold")
		app.celebrate()
	end
end

function Painter.init(appRef)
	app = appRef
	buildUI()
	bindInput()
	if workspace.CurrentCamera then
		workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScales)
	end
end

return Painter
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="28">
            <Properties>
              <string name="Name">Shop</string>
              <string name="Source"><![CDATA[-- Tienda de mejoras del taller y la galería, agrupadas por secciones.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Colors = require(Shared.Colors)
local Config = require(Shared.Config)

local Theme = require(script.Parent.Theme)

local Shop = {}

local C = Theme.Colors

local SECTIONS = {
	{ name = "🎲 Máquina de colores", gradient = "blue", ids = { "suerte", "velocidad", "auto" } },
	{ name = "🖌️ Pintura", gradient = "pink", ids = { "pincel", "cubeta" } },
	{ name = "🖼️ Galería", gradient = "mint", ids = { "precio", "fama", "paredes", "decoracion" } },
}

local app
local window
local cards = {}
local busy = false

-- Efecto actual → siguiente de cada mejora.
local function effectText(id, level)
	local levels = { [id] = level }
	local nextLevels = { [id] = level + 1 }
	if id == "precio" or id == "decoracion" then
		return string.format("Valor x%.2f → x%.2f", Config.payMultiplier(levels), Config.payMultiplier(nextLevels))
	elseif id == "suerte" then
		local function rare(chances)
			return (chances.raro + chances.epico + chances.legendario + chances.mitico) * 100
		end
		return string.format(
			"Raro o mejor %.1f%% → %.1f%%",
			rare(Colors.chances(Config.luck(levels))),
			rare(Colors.chances(Config.luck(nextLevels)))
		)
	elseif id == "velocidad" then
		return string.format("Recarga %.1fs → %.1fs", Config.rollInterval(levels), Config.rollInterval(nextLevels))
	elseif id == "auto" then
		return "Tira sola cada " .. string.format("%.1f", Config.autoRollInterval({})) .. "s"
	elseif id == "pincel" then
		return string.format("Velocidad x%.1f → x%.1f", Config.brushSpeed(levels), Config.brushSpeed(nextLevels))
	elseif id == "cubeta" then
		return "Un toque rellena una figura"
	elseif id == "fama" then
		return string.format(
			"Visitas cada %.0fs → %.0fs · VIP %d%%",
			Config.buyerInterval(levels),
			Config.buyerInterval(nextLevels),
			math.floor(Config.vipChance(nextLevels) * 100 + 0.5)
		)
	elseif id == "paredes" then
		return string.format("Cuadros en venta %d → %d", Config.gallerySlots(levels), Config.gallerySlots(nextLevels))
	end
	return ""
end

local function buildCard(upgrade, order, parent, gradient)
	local _, body = Theme.card({
		Name = upgrade.id,
		Size = UDim2.fromOffset(372, 132),
		Radius = 20,
		LayoutOrder = order,
		Parent = parent,
	})
	local icon = Theme.new("Frame", {
		Position = UDim2.fromOffset(12, 12),
		Size = UDim2.fromOffset(64, 64),
		BackgroundColor3 = C.White,
		Parent = body,
	}, { Theme.corner(18), Theme.gradient(gradient, 90) })
	Theme.label({ Size = UDim2.fromScale(1, 1), Text = upgrade.icon, MaxTextSize = 36, Parent = icon })
	Theme.label({
		Position = UDim2.fromOffset(88, 10),
		Size = UDim2.new(1, -170, 0, 24),
		Text = upgrade.name,
		Font = Theme.Fonts.Heavy,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 19,
		Parent = body,
	})
	local level, levelLabel = Theme.chip({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 12),
		Size = UDim2.fromOffset(72, 22),
		Text = "",
		MaxTextSize = 12,
		Parent = body,
	})
	Theme.label({
		Position = UDim2.fromOffset(88, 34),
		Size = UDim2.new(1, -100, 0, 18),
		Text = upgrade.desc,
		Font = Theme.Fonts.Medium,
		TextColor3 = C.InkSoft,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 14,
		Parent = body,
	})
	local effect = Theme.label({
		Position = UDim2.fromOffset(88, 54),
		Size = UDim2.new(1, -100, 0, 18),
		Text = "",
		Font = Theme.Fonts.Heavy,
		TextColor3 = C.Primary,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 14,
		Parent = body,
	})
	local bar = Theme.progress({
		Position = UDim2.fromOffset(12, 98),
		Size = UDim2.new(1, -170, 0, 10),
		Gradient = gradient,
		Parent = body,
	})
	local button = Theme.button({
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -12, 1, -12),
		Size = UDim2.fromOffset(140, 42),
		Text = "",
		Variant = "gold",
		Radius = 14,
		MaxTextSize = 18,
		Parent = body,
		OnClick = function()
			Shop.buy(upgrade, body)
		end,
	})
	cards[upgrade.id] = { effect = effect, bar = bar, button = button, level = level, levelLabel = levelLabel }
end

function Shop.buy(upgrade, body)
	if busy then
		return
	end
	busy = true
	local ok, success, message = pcall(function()
		return app.remotes.BuyUpgrade:InvokeServer(upgrade.id)
	end)
	busy = false
	if ok and success then
		Theme.playSound("success", 1.2)
		app.notify("✨ " .. message, "success")
		Theme.pop(body, 0.92)
	else
		app.notify(ok and message or "No se pudo comprar.", "error")
	end
end

function Shop.refresh()
	local state = app.state
	if not (state and window) then
		return
	end
	window.Subtitle.Text = "Tienes 💵 " .. Theme.formatNumber(state.coins) .. " · Mejora tu taller y tu galería"
	for _, upgrade in ipairs(Config.Upgrades) do
		local card = cards[upgrade.id]
		local level = state.upgrades[upgrade.id] or 0
		card.bar.Set(level / upgrade.max)
		card.levelLabel.Text = "Nv " .. level .. "/" .. upgrade.max
		if level >= upgrade.max then
			card.effect.Text = "¡Nivel máximo!"
			card.button.SetText("MÁX")
			card.button.SetEnabled(false)
		else
			local cost = Config.upgradeCost(upgrade.id, level)
			card.effect.Text = effectText(upgrade.id, level)
			card.button.SetText("💰 " .. Theme.formatNumber(cost))
			card.button.SetEnabled(state.coins >= cost)
		end
	end
end

function Shop.open()
	window.Open()
	Shop.refresh()
end

function Shop.close()
	window.Close()
end

function Shop.init(appRef)
	app = appRef
	local gui = Theme.new("ScreenGui", {
		Name = "Shop",
		ResetOnSpawn = false,
		DisplayOrder = 14,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = Players.LocalPlayer:WaitForChild("PlayerGui"),
	})
	window = Theme.window({
		Name = "Window",
		Parent = gui,
		Size = UDim2.fromOffset(830, 640),
		Gradient = "mint",
		Title = "🛒 Mejoras",
	})
	local list = Theme.new("ScrollingFrame", {
		Position = UDim2.fromOffset(18, 12),
		Size = UDim2.new(1, -36, 1, -24),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = C.InkFaint,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = window.Body,
	}, {
		Theme.list("v", 10),
		Theme.new("UIPadding", {
			PaddingRight = UDim.new(0, 10),
			PaddingLeft = UDim.new(0, 4),
			PaddingTop = UDim.new(0, 4),
			PaddingBottom = UDim.new(0, 12),
		}),
	})
	local order = 0
	for _, section in ipairs(SECTIONS) do
		order += 1
		Theme.chip({
			Size = UDim2.fromOffset(240, 32),
			Color = C.White,
			TextColor3 = C.Ink,
			Text = section.name,
			MaxTextSize = 18,
			LayoutOrder = order,
			Parent = list,
		})
		order += 1
		local rows = math.ceil(#section.ids / 2)
		local grid = Theme.new("Frame", {
			Size = UDim2.new(1, 0, 0, rows * 146),
			BackgroundTransparency = 1,
			LayoutOrder = order,
			Parent = list,
		}, {
			Theme.new("UIGridLayout", {
				CellSize = UDim2.fromOffset(372, 132),
				CellPadding = UDim2.fromOffset(14, 14),
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
		})
		for i, id in ipairs(section.ids) do
			buildCard(Config.UpgradeById[id], i, grid, section.gradient)
		end
	end
end

return Shop
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="29">
            <Properties>
              <string name="Name">Theme</string>
              <string name="Source"><![CDATA[-- Sistema de diseño de la interfaz: colores, tipografías y componentes
-- (botones, tarjetas, ventanas, barras, insignias) con animaciones.

local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Theme = {}

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

Theme.Colors = {
	Bg = rgb(246, 243, 255),
	Panel = rgb(255, 255, 255),
	PanelSoft = rgb(248, 246, 255),
	Border = rgb(230, 224, 246),
	Ink = rgb(43, 36, 69),
	InkSoft = rgb(116, 108, 146),
	InkFaint = rgb(176, 170, 198),
	Primary = rgb(124, 92, 255),
	PrimaryDark = rgb(88, 60, 210),
	PrimaryLight = rgb(236, 230, 255),
	Pink = rgb(255, 102, 170),
	PinkLight = rgb(255, 232, 244),
	Mint = rgb(40, 200, 150),
	MintDark = rgb(22, 150, 110),
	MintLight = rgb(220, 248, 238),
	Gold = rgb(255, 186, 36),
	GoldDark = rgb(206, 130, 0),
	GoldLight = rgb(255, 246, 214),
	Red = rgb(240, 84, 104),
	RedLight = rgb(255, 228, 232),
	Orange = rgb(255, 146, 60),
	Blue = rgb(64, 146, 255),
	Purple = rgb(150, 100, 250),
	Shadow = rgb(24, 14, 54),
	White = rgb(255, 255, 255),
}
local C = Theme.Colors

-- Pares de colores para degradados.
Theme.Gradients = {
	primary = { rgb(150, 110, 255), rgb(255, 104, 182) },
	mint = { rgb(56, 222, 170), rgb(24, 178, 196) },
	gold = { rgb(255, 214, 80), rgb(255, 146, 40) },
	red = { rgb(255, 120, 130), rgb(230, 60, 100) },
	blue = { rgb(90, 180, 255), rgb(90, 110, 255) },
	purple = { rgb(186, 120, 255), rgb(120, 90, 250) },
	pink = { rgb(255, 150, 200), rgb(255, 90, 150) },
	orange = { rgb(255, 190, 90), rgb(255, 120, 70) },
	dark = { rgb(70, 60, 104), rgb(44, 36, 72) },
	gray = { rgb(214, 210, 226), rgb(190, 184, 206) },
}

Theme.Fonts = {
	Display = Enum.Font.FredokaOne,
	Heavy = Enum.Font.BuilderSansExtraBold,
	Bold = Enum.Font.BuilderSansBold,
	Medium = Enum.Font.BuilderSansMedium,
	Body = Enum.Font.BuilderSans,
	Title = Enum.Font.FredokaOne,
}

-- Instancias ----------------------------------------------------------------------------------
function Theme.new(className, props, children)
	local instance = Instance.new(className)
	if props then
		for key, value in pairs(props) do
			if key ~= "Parent" then
				instance[key] = value
			end
		end
	end
	if children then
		for _, child in ipairs(children) do
			child.Parent = instance
		end
	end
	if props and props.Parent then
		instance.Parent = props.Parent
	end
	return instance
end

function Theme.corner(radius)
	return Theme.new("UICorner", { CornerRadius = UDim.new(0, radius or 14) })
end

function Theme.round()
	return Theme.new("UICorner", { CornerRadius = UDim.new(0.5, 0) })
end

function Theme.stroke(color, thickness, transparency)
	return Theme.new("UIStroke", {
		Color = color or C.Border,
		Thickness = thickness or 2,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function Theme.textStroke(color, thickness, transparency)
	return Theme.new("UIStroke", {
		Color = color or C.Ink,
		Thickness = thickness or 2,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
	})
end

function Theme.padding(all, horizontal)
	local v = UDim.new(0, all)
	local h = UDim.new(0, horizontal or all)
	return Theme.new("UIPadding", { PaddingTop = v, PaddingBottom = v, PaddingLeft = h, PaddingRight = h })
end

function Theme.gradient(a, b, rotation)
	if type(a) == "string" then
		local pair = Theme.Gradients[a]
		return Theme.new("UIGradient", { Color = ColorSequence.new(pair[1], pair[2]), Rotation = b or 90 })
	end
	return Theme.new("UIGradient", { Color = ColorSequence.new(a, b), Rotation = rotation or 90 })
end

function Theme.list(direction, padding, hAlign, vAlign)
	return Theme.new("UIListLayout", {
		FillDirection = direction == "h" and Enum.FillDirection.Horizontal or Enum.FillDirection.Vertical,
		Padding = UDim.new(0, padding or 8),
		HorizontalAlignment = hAlign or Enum.HorizontalAlignment.Left,
		VerticalAlignment = vAlign or Enum.VerticalAlignment.Top,
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
end

-- Texto con tamaño automático y límite de tamaño.
function Theme.label(props)
	local defaults = {
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Bold,
		TextColor3 = C.Ink,
		TextScaled = true,
		TextWrapped = true,
		Text = "",
	}
	for key, value in pairs(props) do
		if key ~= "MaxTextSize" then
			defaults[key] = value
		end
	end
	local label = Theme.new("TextLabel", defaults)
	if label.TextScaled then
		Theme.new("UITextSizeConstraint", { MaxTextSize = props.MaxTextSize or 32, Parent = label })
	end
	return label
end

-- Tarjeta blanca con sombra suave. Devuelve el contenedor y el cuerpo.
function Theme.card(props)
	local holder = Theme.new("Frame", {
		Name = props.Name or "Card",
		Size = props.Size or UDim2.fromOffset(200, 100),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.new(),
		BackgroundTransparency = 1,
		LayoutOrder = props.LayoutOrder or 0,
		Visible = props.Visible ~= false,
		Parent = props.Parent,
	})
	local radius = props.Radius or 18
	Theme.new("Frame", {
		Name = "Shadow",
		Position = UDim2.fromOffset(0, props.ShadowOffset or 5),
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = C.Shadow,
		BackgroundTransparency = props.ShadowTransparency or 0.86,
		Parent = holder,
	}, { Theme.corner(radius) })
	local body = Theme.new("Frame", {
		Name = "Body",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = props.Color or C.Panel,
		Parent = holder,
	}, { Theme.corner(radius) })
	if props.Stroke ~= false then
		Theme.stroke(props.StrokeColor or C.Border, props.StrokeThickness or 1.5).Parent = body
	end
	return holder, body
end

-- Botones -------------------------------------------------------------------------------------
-- Variant: primary, mint, gold, red, blue, purple, pink, orange, dark, ghost.
function Theme.button(props)
	local variant = props.Variant or (props.Soft and "ghost") or "primary"
	local radius = props.Radius or 14
	local holder = Theme.new("Frame", {
		Name = props.Name or "Button",
		Size = props.Size or UDim2.fromOffset(160, 48),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.new(),
		BackgroundTransparency = 1,
		LayoutOrder = props.LayoutOrder or 0,
		ZIndex = props.ZIndex or 1,
		Parent = props.Parent,
	})
	local shadow = Theme.new("Frame", {
		Name = "Shadow",
		Size = UDim2.fromScale(1, 1),
		Position = UDim2.fromOffset(0, 4),
		BackgroundColor3 = C.Shadow,
		BackgroundTransparency = 0.75,
		ZIndex = holder.ZIndex,
		Parent = holder,
	}, { Theme.corner(radius) })
	local button = Theme.new("TextButton", {
		Name = "Face",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = C.White,
		AutoButtonColor = false,
		Font = props.Font or Theme.Fonts.Heavy,
		Text = props.Text or "",
		TextColor3 = C.White,
		TextScaled = true,
		ZIndex = holder.ZIndex + 1,
		Parent = holder,
	}, {
		Theme.corner(radius),
		Theme.new("UIPadding", {
			PaddingTop = UDim.new(0.2, 0),
			PaddingBottom = UDim.new(0.2, 0),
			PaddingLeft = UDim.new(0, 10),
			PaddingRight = UDim.new(0, 10),
		}),
		Theme.new("UITextSizeConstraint", { MaxTextSize = props.MaxTextSize or 24 }),
	})
	local gradient = Theme.new("UIGradient", { Rotation = 90, Parent = button })
	local border = Theme.stroke(C.Border, 0)
	border.Parent = button
	local textStroke = Theme.textStroke(C.Shadow, 1.2, 0.75)
	textStroke.Parent = button
	local scale = Theme.new("UIScale", { Name = "Interact", Parent = holder })

	local enabled = true
	local function paint()
		local v = enabled and variant or "gray"
		if v == "ghost" then
			gradient.Color = ColorSequence.new(C.White, C.PanelSoft)
			button.TextColor3 = props.TextColor or C.Ink
			border.Color = props.Color or C.Border
			border.Thickness = 2
			textStroke.Transparency = 1
			shadow.BackgroundTransparency = 0.88
		else
			local pair = Theme.Gradients[v] or Theme.Gradients.primary
			gradient.Color = ColorSequence.new(pair[1], pair[2])
			button.TextColor3 = C.White
			border.Thickness = 0
			textStroke.Transparency = 0.7
			shadow.BackgroundTransparency = 0.72
		end
		button.TextTransparency = enabled and 0 or 0.25
	end
	paint()

	button.MouseEnter:Connect(function()
		if enabled then
			Theme.tween(scale, 0.12, { Scale = 1.05 })
		end
	end)
	button.MouseLeave:Connect(function()
		Theme.tween(scale, 0.12, { Scale = 1 })
	end)
	button.MouseButton1Down:Connect(function()
		if enabled then
			Theme.tween(scale, 0.06, { Scale = 0.94 })
		end
	end)
	button.MouseButton1Up:Connect(function()
		Theme.tween(scale, 0.1, { Scale = 1 })
	end)

	local api = { Holder = holder, Button = button, Shadow = shadow }
	function api.SetEnabled(value)
		enabled = value
		button.Active = value
		paint()
	end
	function api.SetVariant(newVariant)
		variant = newVariant
		paint()
	end
	function api.SetText(text)
		button.Text = text
	end
	if props.OnClick then
		button.Activated:Connect(function()
			if enabled then
				Theme.playSound("click")
				props.OnClick()
			end
		end)
	end
	return api
end

-- Botón cuadrado del menú lateral (icono + texto) con insignia.
function Theme.tile(props)
	local holder = Theme.new("Frame", {
		Name = props.Name or "Tile",
		Size = props.Size or UDim2.fromOffset(78, 78),
		BackgroundTransparency = 1,
		LayoutOrder = props.LayoutOrder or 0,
		Parent = props.Parent,
	})
	Theme.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		Position = UDim2.fromOffset(0, 4),
		BackgroundColor3 = C.Shadow,
		BackgroundTransparency = 0.7,
		Parent = holder,
	}, { Theme.corner(20) })
	local face = Theme.new("TextButton", {
		Name = "Face",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = C.White,
		AutoButtonColor = false,
		Text = "",
		Parent = holder,
	}, {
		Theme.corner(20),
		Theme.gradient(props.Gradient or "primary", 90),
		Theme.stroke(C.White, 2.5, 0.35),
	})
	Theme.label({
		Name = "Icon",
		Size = UDim2.new(1, 0, 0.58, 0),
		Position = UDim2.fromScale(0, 0.04),
		Text = props.Icon,
		Font = Theme.Fonts.Bold,
		MaxTextSize = 34,
		Parent = face,
	})
	local caption = Theme.label({
		Name = "Caption",
		Size = UDim2.new(1, -6, 0.3, 0),
		Position = UDim2.new(0, 3, 0.64, 0),
		Text = props.Text,
		Font = Theme.Fonts.Heavy,
		TextColor3 = C.White,
		MaxTextSize = 15,
		Parent = face,
	})
	Theme.textStroke(C.Shadow, 1.2, 0.6).Parent = caption
	local badge = Theme.new("Frame", {
		Name = "Badge",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -6, 0, 6),
		Size = UDim2.fromOffset(24, 24),
		BackgroundColor3 = C.Red,
		Visible = false,
		ZIndex = 5,
		Parent = holder,
	}, { Theme.round(), Theme.stroke(C.White, 2.5) })
	local badgeText = Theme.label({
		Size = UDim2.fromScale(1, 1),
		Text = "!",
		Font = Theme.Fonts.Heavy,
		TextColor3 = C.White,
		MaxTextSize = 14,
		ZIndex = 6,
		Parent = badge,
	})
	local scale = Theme.new("UIScale", { Name = "Interact", Parent = holder })
	face.MouseEnter:Connect(function()
		Theme.tween(scale, 0.12, { Scale = 1.07 })
	end)
	face.MouseLeave:Connect(function()
		Theme.tween(scale, 0.12, { Scale = 1 })
	end)
	face.MouseButton1Down:Connect(function()
		Theme.tween(scale, 0.06, { Scale = 0.93 })
	end)
	face.MouseButton1Up:Connect(function()
		Theme.tween(scale, 0.1, { Scale = 1 })
	end)
	if props.OnClick then
		face.Activated:Connect(function()
			Theme.playSound("click")
			props.OnClick()
		end)
	end
	local api = { Holder = holder, Button = face, Caption = caption }
	function api.SetBadge(value)
		if value == nil or value == false or value == 0 then
			badge.Visible = false
		else
			badge.Visible = true
			badgeText.Text = value == true and "!" or tostring(value)
		end
	end
	return api
end

-- Barra de progreso con degradado.
function Theme.progress(props)
	local track = Theme.new("Frame", {
		Name = props.Name or "Progress",
		Size = props.Size or UDim2.new(1, 0, 0, 10),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.new(),
		BackgroundColor3 = props.TrackColor or C.Border,
		LayoutOrder = props.LayoutOrder or 0,
		ZIndex = props.ZIndex or 1,
		Parent = props.Parent,
	}, { Theme.round() })
	local fill = Theme.new("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = C.White,
		ZIndex = track.ZIndex,
		Parent = track,
	}, { Theme.round() })
	local fillGradient = Theme.gradient(props.Gradient or "primary", 0)
	fillGradient.Parent = fill
	local api = { Frame = track, Fill = fill }
	function api.Set(fraction, animate)
		fraction = math.clamp(fraction or 0, 0, 1)
		local target = UDim2.fromScale(fraction, 1)
		if animate then
			Theme.tween(fill, 0.35, { Size = target })
		else
			fill.Size = target
		end
		fill.Visible = fraction > 0.001
	end
	function api.SetGradient(name)
		local pair = Theme.Gradients[name]
		fillGradient.Color = ColorSequence.new(pair[1], pair[2])
	end
	return api
end

-- Etiqueta en forma de píldora.
function Theme.chip(props)
	local chip = Theme.new("Frame", {
		Name = props.Name or "Chip",
		Size = props.Size or UDim2.fromOffset(100, 26),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.new(),
		BackgroundColor3 = props.Color or C.PrimaryLight,
		LayoutOrder = props.LayoutOrder or 0,
		Visible = props.Visible ~= false,
		ZIndex = props.ZIndex or 1,
		Parent = props.Parent,
	}, { Theme.round() })
	local label = Theme.label({
		Size = UDim2.fromScale(1, 1),
		Text = props.Text or "",
		Font = Theme.Fonts.Heavy,
		TextColor3 = props.TextColor or props.TextColor3 or C.PrimaryDark,
		MaxTextSize = props.MaxTextSize or 15,
		ZIndex = chip.ZIndex,
		Parent = chip,
	})
	Theme.new("UIPadding", {
		PaddingLeft = UDim.new(0, 8),
		PaddingRight = UDim.new(0, 8),
		PaddingTop = UDim.new(0.15, 0),
		PaddingBottom = UDim.new(0.15, 0),
		Parent = label,
	})
	return chip, label
end

-- Ventana modal con cabecera de color --------------------------------------------------------
function Theme.window(props)
	local holder = Theme.new("Frame", {
		Name = props.Name or "Window",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = props.Parent,
	})
	local dim = Theme.new("TextButton", {
		Name = "Dim",
		Position = UDim2.fromOffset(0, -80),
		Size = UDim2.new(1, 0, 1, 80),
		BackgroundColor3 = C.Shadow,
		BackgroundTransparency = 0.45,
		Text = "",
		AutoButtonColor = false,
		Parent = holder,
	})
	local wrapper = Theme.new("Frame", {
		Name = "Wrapper",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = props.Size or UDim2.fromOffset(900, 560),
		BackgroundTransparency = 1,
		Parent = holder,
	})
	local panelCard, panel = Theme.card({
		Name = "PanelCard",
		Size = UDim2.fromScale(1, 1),
		Radius = 26,
		Color = C.Bg,
		ShadowOffset = 10,
		ShadowTransparency = 0.6,
		StrokeColor = C.White,
		StrokeThickness = 3,
		Parent = wrapper,
	})
	panel.Name = "Panel"
	local header = Theme.new("Frame", {
		Name = "Header",
		Size = UDim2.new(1, 0, 0, 84),
		BackgroundColor3 = C.White,
		Parent = panel,
	}, { Theme.corner(26), Theme.gradient(props.Gradient or "primary", 0) })
	-- Tapa las esquinas inferiores redondeadas de la cabecera.
	Theme.new("Frame", {
		Position = UDim2.new(0, 0, 1, -26),
		Size = UDim2.new(1, 0, 0, 26),
		BackgroundColor3 = C.White,
		BorderSizePixel = 0,
		Parent = header,
	}, { Theme.gradient(props.Gradient or "primary", 0) })
	local title = Theme.label({
		Name = "Title",
		Size = UDim2.new(1, -140, 0, 40),
		Position = UDim2.fromOffset(28, 12),
		Text = props.Title or "",
		Font = Theme.Fonts.Display,
		TextColor3 = C.White,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 36,
		Parent = header,
	})
	Theme.textStroke(C.Shadow, 2, 0.75).Parent = title
	local subtitle = Theme.label({
		Name = "Subtitle",
		Size = UDim2.new(1, -140, 0, 22),
		Position = UDim2.fromOffset(28, 52),
		Text = props.Subtitle or "",
		Font = Theme.Fonts.Medium,
		TextColor3 = C.White,
		TextTransparency = 0.1,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 17,
		Parent = header,
	})
	local close = Theme.new("TextButton", {
		Name = "Close",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -22, 0, 42),
		Size = UDim2.fromOffset(46, 46),
		BackgroundColor3 = C.White,
		BackgroundTransparency = 0.1,
		Font = Theme.Fonts.Heavy,
		Text = "✕",
		TextScaled = true,
		TextColor3 = C.Ink,
		Parent = header,
	}, { Theme.round(), Theme.padding(11) })
	local body = Theme.new("Frame", {
		Name = "Body",
		Position = UDim2.fromOffset(0, 84),
		Size = UDim2.new(1, 0, 1, -84),
		BackgroundTransparency = 1,
		Parent = panel,
	})

	local api = {
		Holder = holder,
		Panel = panel,
		Body = body,
		Header = header,
		Wrapper = wrapper,
		Title = title,
		Subtitle = subtitle,
		Close = close,
	}
	function api.Open()
		holder.Visible = true
		dim.BackgroundTransparency = 1
		Theme.tween(dim, 0.2, { BackgroundTransparency = 0.45 })
		Theme.pop(panelCard, 0.85)
		Theme.playSound("whoosh", 1.1)
	end
	function api.Close()
		holder.Visible = false
	end
	local function requestClose()
		Theme.playSound("click")
		if props.OnClose then
			props.OnClose()
		else
			api.Close()
		end
	end
	close.Activated:Connect(requestClose)
	if not props.Modal then
		dim.Activated:Connect(requestClose)
	end
	local function updateScale()
		local camera = workspace.CurrentCamera
		if not camera then
			return
		end
		local size = wrapper.Size
		local viewport = camera.ViewportSize
		local scale = math.min((viewport.X - 24) / size.X.Offset, (viewport.Y - 70) / size.Y.Offset)
		local uiScale = wrapper:FindFirstChild("ViewportScale")
			or Theme.new("UIScale", { Name = "ViewportScale", Parent = wrapper })
		uiScale.Scale = math.clamp(scale, 0.4, 1.15)
	end
	updateScale()
	if workspace.CurrentCamera then
		workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
	end
	api.UpdateScale = updateScale
	return api
end

-- Mayúsculas que respetan tildes y eñes (string.upper solo cambia ASCII).
local ACCENTS =
	{ ["á"] = "Á", ["é"] = "É", ["í"] = "Í", ["ó"] = "Ó", ["ú"] = "Ú", ["ñ"] = "Ñ", ["ü"] = "Ü" }
function Theme.upper(text)
	local result = string.upper(text)
	for lower, upper in pairs(ACCENTS) do
		result = string.gsub(result, lower, upper)
	end
	return result
end

-- Animaciones ---------------------------------------------------------------------------------
function Theme.tween(instance, time, props, style, direction)
	local tween = TweenService:Create(
		instance,
		TweenInfo.new(time, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out),
		props
	)
	tween:Play()
	return tween
end

function Theme.pop(guiObject, scale)
	local uiScale = guiObject:FindFirstChild("PopScale")
	if not uiScale then
		uiScale = Theme.new("UIScale", { Name = "PopScale", Parent = guiObject })
	end
	uiScale.Scale = scale or 0.6
	Theme.tween(uiScale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
end

-- Formato ---------------------------------------------------------------------------------------
local function trimZero(text)
	local cleaned = string.gsub(text, "%.0$", "")
	return cleaned
end

function Theme.formatNumber(n)
	n = math.floor(n or 0)
	local abs = math.abs(n)
	if abs >= 1e9 then
		return trimZero(string.format("%.1f", n / 1e9)) .. "B"
	elseif abs >= 1e6 then
		return trimZero(string.format("%.1f", n / 1e6)) .. "M"
	elseif abs >= 1e4 then
		return trimZero(string.format("%.1f", n / 1e3)) .. "K"
	end
	local formatted = tostring(n)
	while true do
		local replaced, count = string.gsub(formatted, "^(-?%d+)(%d%d%d)", "%1.%2")
		formatted = replaced
		if count == 0 then
			break
		end
	end
	return formatted
end

function Theme.formatTime(seconds)
	seconds = math.max(0, math.floor(seconds))
	local h = math.floor(seconds / 3600)
	local m = math.floor(seconds % 3600 / 60)
	if h > 0 then
		return string.format("%dh %02dm", h, m)
	end
	return string.format("%dm %02ds", m, seconds % 60)
end

-- Sonidos ---------------------------------------------------------------------------------------
-- Sonidos incluidos en el cliente de Roblox (no requieren subir audio).
local SOUND_IDS = {
	click = "rbxasset://sounds/button.wav",
	paint = "rbxasset://sounds/clickfast.wav",
	success = "rbxasset://sounds/electronicpingshort.wav",
	whoosh = "rbxasset://sounds/swoosh.wav",
}
local SOUND_VOLUME = { click = 0.35, paint = 0.12, success = 0.55, whoosh = 0.35 }
local soundCache = {}
Theme.soundsEnabled = true

function Theme.playSound(name, pitch)
	if not Theme.soundsEnabled then
		return
	end
	local id = SOUND_IDS[name]
	if not id then
		return
	end
	local sound = soundCache[name]
	if not sound then
		sound = Instance.new("Sound")
		sound.SoundId = id
		sound.Volume = SOUND_VOLUME[name] or 0.5
		sound.Parent = SoundService
		soundCache[name] = sound
	end
	sound.PlaybackSpeed = pitch or 1
	SoundService:PlayLocalSound(sound)
end

return Theme
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="30">
            <Properties>
              <string name="Name">Tutorial</string>
              <string name="Source"><![CDATA[-- Marcas del tutorial en el mundo: resalta el objeto del paso actual y pone
-- una flecha flotante encima.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)

local Theme = require(script.Parent.Theme)

local Tutorial = {}

local C = Theme.Colors
local player = Players.LocalPlayer

local app
local highlight
local arrow
local arrowLabel
local currentTarget

local function findTarget(name)
	local plotName = app.state and app.state.plotName or ""
	local plots = Workspace:FindFirstChild("Plots")
	local plot = plots and plotName ~= "" and plots:FindFirstChild(plotName)
	if not plot then
		return nil, nil
	end
	local workshop = plot:FindFirstChild("Workshop")
	if name == "machine" then
		local machine = workshop and workshop:FindFirstChild("Machine")
		return machine, machine and machine:FindFirstChild("Top")
	elseif name == "easel" then
		local easel = workshop and workshop:FindFirstChild("Easel")
		return easel, easel and easel:FindFirstChild("Canvas")
	elseif name == "gallery" then
		local gallery = plot:FindFirstChild("Gallery")
		local frame = gallery and gallery:FindFirstChild("Frame1")
		return frame, frame and frame:FindFirstChild("Canvas")
	end
	return nil, nil
end

function Tutorial.update()
	local state = app.state
	local step = state and state.tutorial or 0
	local def = Config.Tutorial[step]
	local targetName = def and def.target or nil
	local model, anchor = nil, nil
	if targetName and not app.isBusy() then
		model, anchor = findTarget(targetName)
	end
	if model ~= currentTarget then
		currentTarget = model
		highlight.Adornee = model
		highlight.Parent = model
		highlight.Enabled = model ~= nil
	end
	arrow.Adornee = anchor
	arrow.Enabled = anchor ~= nil
	if def then
		arrowLabel.Text = step == 1 and "¡Tira aquí!" or (step == 2 and "¡Pinta aquí!" or "¡Aquí!")
	end
end

function Tutorial.init(appRef)
	app = appRef
	highlight = Instance.new("Highlight")
	highlight.Name = "TutorialHighlight"
	highlight.FillColor = C.Gold
	highlight.FillTransparency = 0.75
	highlight.OutlineColor = C.White
	highlight.OutlineTransparency = 0
	highlight.DepthMode = Enum.HighlightDepthMode.Occluded
	highlight.Enabled = false

	arrow = Theme.new("BillboardGui", {
		Name = "TutorialArrow",
		Size = UDim2.fromOffset(170, 110),
		StudsOffset = Vector3.new(0, 3, 0),
		AlwaysOnTop = true,
		LightInfluence = 0,
		ResetOnSpawn = false,
		Enabled = false,
		Parent = player:WaitForChild("PlayerGui"),
	})
	local bubble = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0),
		Size = UDim2.fromOffset(160, 42),
		BackgroundColor3 = C.White,
		Parent = arrow,
	}, { Theme.round(), Theme.gradient("gold", 90), Theme.stroke(C.White, 3) })
	arrowLabel = Theme.label({
		Size = UDim2.new(1, -16, 1, -10),
		Position = UDim2.fromOffset(8, 5),
		Text = "",
		Font = Theme.Fonts.Heavy,
		TextColor3 = C.White,
		MaxTextSize = 20,
		Parent = bubble,
	})
	Theme.textStroke(C.GoldDark, 1.5).Parent = arrowLabel
	local pointer = Theme.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 44),
		Size = UDim2.fromOffset(60, 60),
		Text = "⬇",
		Font = Theme.Fonts.Heavy,
		TextColor3 = C.Gold,
		MaxTextSize = 54,
		Parent = arrow,
	})
	Theme.textStroke(C.White, 3).Parent = pointer

	-- La flecha flota arriba y abajo.
	RunService.RenderStepped:Connect(function()
		if arrow.Enabled then
			arrow.StudsOffset = Vector3.new(0, 3 + math.sin(os.clock() * 4) * 0.6, 0)
		end
	end)
	task.spawn(function()
		while true do
			task.wait(0.5)
			Tutorial.update()
		end
	end)
end

return Tutorial
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">World</string>
            <string name="Source"><![CDATA[-- Parte visual del mundo que se dibuja en el cliente: cuadros de la galería,
-- caballete del taller y globos de diálogo de los visitantes.

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Designs = require(Shared.Designs)

local UI = script.Parent:WaitForChild("UI")
local Theme = require(UI.Theme)
local DesignArt = require(UI.DesignArt)

local World = {}

local C = Theme.Colors
local player = Players.LocalPlayer

-- Cuadros -------------------------------------------------------------------------------
local function setupCanvas(canvas)
	if canvas:FindFirstChild("ArtGui") then
		return
	end
	local gui = Theme.new("SurfaceGui", {
		Name = "ArtGui",
		Face = Enum.NormalId.Front,
		SizingMode = Enum.SurfaceGuiSizingMode.FixedSize,
		CanvasSize = Vector2.new(300, 300),
		LightInfluence = 0.35,
		Brightness = 1.15,
		Parent = canvas,
	})
	local art = Theme.new("Frame", {
		Name = "Art",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(252, 248, 240),
		BorderSizePixel = 0,
		Parent = gui,
	})
	local placeholder = Theme.label({
		Name = "Placeholder",
		Size = UDim2.fromScale(0.84, 0.5),
		Position = UDim2.fromScale(0.08, 0.25),
		Text = "",
		TextColor3 = Color3.fromRGB(196, 180, 170),
		MaxTextSize = 60,
		Parent = art,
	})
	local stars = Theme.label({
		Name = "Stars",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -8, 1, -6),
		Size = UDim2.fromOffset(110, 34),
		Text = "",
		Font = Theme.Fonts.Heavy,
		TextColor3 = C.Gold,
		TextXAlignment = Enum.TextXAlignment.Right,
		MaxTextSize = 30,
		ZIndex = 5,
		Parent = art,
	})
	Theme.textStroke(C.Shadow, 2, 0.3).Parent = stars
	local function refresh()
		local design = Designs.get(canvas:GetAttribute("Design") or "")
		local starCount = canvas:GetAttribute("Stars") or 0
		stars.Text = design and string.rep("★", starCount) or ""
		if design then
			placeholder.Visible = false
			DesignArt.render(art, design, {
				mode = "color",
				colors = Designs.decodeColors(canvas:GetAttribute("Colors")),
				outlineThickness = 1.5,
			})
		else
			local old = art:FindFirstChild("Art")
			if old then
				old:Destroy()
			end
			placeholder.Visible = true
			placeholder.Text = canvas:GetAttribute("Locked") and "🔒" or "🖌️\nEspacio libre"
		end
	end
	canvas:GetAttributeChangedSignal("Design"):Connect(refresh)
	canvas:GetAttributeChangedSignal("Colors"):Connect(refresh)
	canvas:GetAttributeChangedSignal("Locked"):Connect(refresh)
	canvas:GetAttributeChangedSignal("Stars"):Connect(refresh)
	refresh()
end

-- Visitantes -----------------------------------------------------------------------------
local function setupVisitor(model)
	local head = model:WaitForChild("Head", 10)
	if not head or head:FindFirstChild("VisitorBubble") then
		return
	end
	local billboard = Theme.new("BillboardGui", {
		Name = "VisitorBubble",
		Size = UDim2.fromOffset(240, 110),
		StudsOffset = Vector3.new(0, 3.2, 0),
		MaxDistance = 70,
		LightInfluence = 0,
		ResetOnSpawn = false,
		Parent = head,
	})
	local bubble = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -30),
		Size = UDim2.fromOffset(220, 54),
		BackgroundColor3 = C.Panel,
		Visible = false,
		Parent = billboard,
	}, { Theme.corner(18), Theme.stroke(model:GetAttribute("VIP") and C.Gold or C.Pink, 2.5) })
	local reaction = Theme.label({
		Size = UDim2.new(1, -16, 1, -8),
		Position = UDim2.fromOffset(8, 4),
		Text = "",
		MaxTextSize = 22,
		Parent = bubble,
	})
	local name = Theme.label({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, 0),
		Size = UDim2.fromOffset(220, 26),
		Text = (model:GetAttribute("VIP") and "👑 " or "") .. tostring(model:GetAttribute("VisitorName") or ""),
		Font = Theme.Fonts.Heavy,
		TextColor3 = model:GetAttribute("VIP") and C.Gold or Color3.new(1, 1, 1),
		MaxTextSize = 22,
		Parent = billboard,
	})
	Theme.textStroke(C.Ink, 2).Parent = name
	local function refresh()
		local text = model:GetAttribute("Reaction") or ""
		bubble.Visible = text ~= ""
		reaction.Text = text
		bubble.Size = UDim2.fromOffset(text == "🤔" and 60 or 220, string.find(text, "\n") and 64 or 46)
		if bubble.Visible then
			Theme.pop(bubble, 0.5)
		end
	end
	model:GetAttributeChangedSignal("Reaction"):Connect(refresh)
	refresh()
end

-- Avisos solo para el dueño del taller.
local function updatePrompts(plot)
	local mine = plot:GetAttribute("OwnerUserId") == player.UserId
	local workshop = plot:FindFirstChild("Workshop")
	if not workshop then
		return
	end
	for _, descendant in ipairs(workshop:GetDescendants()) do
		if descendant:IsA("ProximityPrompt") then
			descendant.MaxActivationDistance = mine and 12 or 0
		end
	end
end

local function watchPlot(plot)
	local gallery = plot:WaitForChild("Gallery", 10)
	if gallery then
		for _, descendant in ipairs(gallery:GetDescendants()) do
			if descendant.Name == "Canvas" and descendant:IsA("BasePart") then
				setupCanvas(descendant)
			end
		end
	end
	local workshop = plot:WaitForChild("Workshop", 10)
	local easel = workshop and workshop:WaitForChild("Easel", 10)
	local easelCanvas = easel and easel:WaitForChild("Canvas", 10)
	if easelCanvas then
		setupCanvas(easelCanvas)
	end
	local visitors = plot:WaitForChild("Visitors", 10)
	if visitors then
		for _, model in ipairs(visitors:GetChildren()) do
			task.spawn(setupVisitor, model)
		end
		visitors.ChildAdded:Connect(function(model)
			task.spawn(setupVisitor, model)
		end)
	end
	plot:GetAttributeChangedSignal("OwnerUserId"):Connect(function()
		updatePrompts(plot)
	end)
	updatePrompts(plot)
end

function World.start()
	local plots = Workspace:WaitForChild("Plots")
	for _, plot in ipairs(plots:GetChildren()) do
		task.spawn(watchPlot, plot)
	end
	plots.ChildAdded:Connect(function(plot)
		task.spawn(watchPlot, plot)
	end)
end

return World
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="32">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">true</bool>
    </Properties>
  </Item>
