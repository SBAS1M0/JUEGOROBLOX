-- Entrada global (arrastrar el pincel y atajos de teclado) --------------------------
local function bindInput()
	UserInputService.InputChanged:Connect(function(input)
		if not (stroking and current) then
			return
		end
		if
			input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch
		then
			local col, row = cellAt(input.Position)
			if col then
				strokeTo(col, row)
				updateProgress()
			end
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			stroking = false
			lastCell = nil
		end
	end)
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or not current then
			return
		end
		local code = input.KeyCode
		if code == Enum.KeyCode.B then
			setTool("brush")
		elseif code == Enum.KeyCode.F or code == Enum.KeyCode.G then
			setTool("fill")
		elseif code == Enum.KeyCode.X then
			selectColor(EMPTY)
		elseif code == Enum.KeyCode.Z then
			Studio.undo()
		elseif code == Enum.KeyCode.Return then
			Studio.submit()
		end
	end)
end

local function setControlsEnabled(enabled)
	pcall(function()
		local playerModule = require(Players.LocalPlayer.PlayerScripts:WaitForChild("PlayerModule", 2))
		local controls = playerModule:GetControls()
		if enabled then
			controls:Enable()
		else
			controls:Disable()
		end
	end)
end

-- API ----------------------------------------------------------------------------------
function Studio.init(appRef)
	app = appRef
	buildUI()
	refreshTools()
end

function Studio.isOpen()
	return current ~= nil
end

function Studio.undo()
	if not current or #undoStack == 0 then
		return
	end
	loadSnapshot(table.remove(undoStack))
	Theme.playSound("click", 0.8)
end

local opening = false

function Studio.open(model)
	if current or submitting or opening then
		return
	end
	local orderId = model:GetAttribute("OrderId")
	local template = Templates.get(model:GetAttribute("TemplateId"))
	if not (orderId and template) then
		return
	end
	opening = true
	local ok, accepted = pcall(function()
		return app.remotes.StartPainting:InvokeServer(orderId)
	end)
	opening = false
	if not (ok and accepted) then
		app.notify("Ese cliente ya no está esperando.", "error")
		return
	end

	local order = {
		mode = model:GetAttribute("Mode"),
		swapFrom = model:GetAttribute("SwapFrom"),
		swapTo = model:GetAttribute("SwapTo"),
		theme = model:GetAttribute("Theme"),
	}
	local target = Scoring.targetString(order, template)
	current = {
		id = orderId,
		model = model,
		template = template,
		order = order,
		target = target,
		hints = target ~= nil,
	}

	-- Números guía.
	for i = 1, Config.CELLS do
		local label = numberLabels[i]
		local key = target and string.sub(target, i, i)
		local entry = key and Palette.ByKey[key]
		label.Text = entry and tostring(entry.index) or ""
	end

	-- Cargar borrador previo o lienzo en blanco.
	undoStack = {}
	loadSnapshot(drafts[orderId] or Scoring.blankCanvas(template))

	-- Panel del pedido.
	local mode = Config.Modes[order.mode] or Config.Modes.original
	local vip = model:GetAttribute("VIP")
	refs.customer.Text = (vip and "👑 " or "") .. "Pedido de " .. tostring(model:GetAttribute("CustomerName"))
	refs.modeBadge.BackgroundColor3 = mode.color
	refs.modeText.Text = mode.icon .. " Modo " .. mode.name .. (vip and " · VIP" or "")
	refs.request.Text = Scoring.describe(order, template)
	refs.reward.Text = "💰 Hasta "
		.. Theme.formatNumber(math.floor((model:GetAttribute("Reward") or 0) * Config.STAR_PAY[3]))
		.. " + propina"
	PixelArt.render(refs.preview, target or Scoring.blankCanvas(template))
	refs.previewTag.Text = target and "Referencia" or (order.mode == "tema" and "¡Tú eliges!" or "¡Libre!")

	for _, child in ipairs(refs.swatches:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	if order.mode == "tema" then
		local theme = Config.ThemeById[order.theme]
		if theme then
			for i = 1, #theme.keys do
				Theme.new("Frame", {
					Size = UDim2.new(0, 22, 1, 0),
					BackgroundColor3 = Palette.colorOf(string.sub(theme.keys, i, i)),
					Parent = refs.swatches,
				}, { Theme.corner(6), Theme.stroke(C.Ink, 1, 0.6) })
			end
		end
	end

	-- Pinceles desbloqueados.
	local sizes = Config.brushSizes(app.state and app.state.upgrades or {})
	local unlocked = {}
	for _, size in ipairs(sizes) do
		unlocked[size] = true
	end
	for size, button in pairs(sizeButtons) do
		sizeLocked[size] = not unlocked[size]
		button.SetEnabled(unlocked[size] == true)
		button.Button.Text = unlocked[size] and (size .. "x" .. size) or "🔒"
	end
	if not unlocked[brushSize] then
		brushSize = 1
	end
	tool = target and "fill" or "brush"
	if target then
		-- Empieza con el color de la zona más grande para ir directo al grano.
		local counts, best, bestKey = {}, 0, selectedKey
		for i = 1, #target do
			local key = string.sub(target, i, i)
			if key ~= OUTLINE then
				counts[key] = (counts[key] or 0) + 1
				if counts[key] > best then
					best, bestKey = counts[key], key
				end
			end
		end
		selectedKey = bestKey
	end
	refreshTools()

	-- Vigilar al cliente.
	local function watch()
		if not current or current.model ~= model then
			return
		end
		local max = model:GetAttribute("MaxPatience") or 1
		local fraction = math.clamp((model:GetAttribute("Patience") or 0) / math.max(max, 1), 0, 1)
		refs.patienceFill.Size = UDim2.fromScale(fraction, 1)
		refs.patienceFill.BackgroundColor3 = app.patienceColor(fraction)
		if model:GetAttribute("State") ~= "waiting" and not submitting then
			app.notify((model:GetAttribute("CustomerName") or "El cliente") .. " se fue sin esperar 😢", "error")
			Studio.close(false)
		end
	end
	current.attrConnection = model.AttributeChanged:Connect(watch)
	current.ancestryConnection = model.AncestryChanged:Connect(function(_, parent)
		if parent == nil and current and current.model == model and not submitting then
			Studio.close(false)
		end
	end)
	watch()

	ProximityPromptService.Enabled = false
	setControlsEnabled(false)
	gui.Enabled = true
	Theme.pop(panel, 0.85)
	Theme.playSound("whoosh")
end

function Studio.close(sendStop)
	if not current then
		gui.Enabled = false
		return
	end
	local closing = current
	drafts[closing.id] = snapshot()
	if closing.attrConnection then
		closing.attrConnection:Disconnect()
	end
	if closing.ancestryConnection then
		closing.ancestryConnection:Disconnect()
	end
	if sendStop then
		app.remotes.StopPainting:FireServer(closing.id)
	end
	current = nil
	stroking = false
	lastCell = nil
	gui.Enabled = false
	ProximityPromptService.Enabled = true
	setControlsEnabled(true)
end

function Studio.submit()
	if not current or submitting then
		return
	end
	local fraction = updateProgress()
	if fraction < 0.9 and os.clock() > confirmUntil then
		confirmUntil = os.clock() + 3
		refs.submit.Button.Text = "¿Entregar incompleta?"
		task.delay(3, function()
			if refs.submit.Button.Text == "¿Entregar incompleta?" then
				refs.submit.Button.Text = "✅ Entregar obra"
			end
		end)
		return
	end
	confirmUntil = 0
	refs.submit.Button.Text = "✅ Entregar obra"

	submitting = true
	local order = current
	local art = snapshot()
	local ok, result = pcall(function()
		return app.remotes.SubmitPainting:InvokeServer(order.id, art)
	end)
	submitting = false

	if not ok or type(result) ~= "table" then
		app.notify("No se pudo entregar. Inténtalo otra vez.", "error")
		return
	end
	if not result.ok then
		app.notify(result.reason or "No se pudo entregar.", "error")
		if current == order and not (order.model.Parent and order.model:GetAttribute("State") == "waiting") then
			Studio.close(false)
		end
		return
	end
	drafts[order.id] = nil
	if current == order then
		Studio.close(false)
	end
	drafts[order.id] = nil
	app.showResults(result, order.template, art)
end

function Studio.start()
	bindInput()
end

return Studio
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="25">
            <Properties>
              <string name="Name">Theme</string>
              <string name="Source"><![CDATA[-- Estilo visual compartido por toda la interfaz y pequeñas utilidades.

local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Theme = {}

Theme.Colors = {
	Background = Color3.fromRGB(255, 249, 242),
	Panel = Color3.fromRGB(255, 255, 255),
	PanelSoft = Color3.fromRGB(246, 240, 255),
	Ink = Color3.fromRGB(52, 40, 74),
	InkSoft = Color3.fromRGB(122, 108, 150),
	Primary = Color3.fromRGB(124, 92, 255),
	PrimaryDark = Color3.fromRGB(92, 64, 214),
	Pink = Color3.fromRGB(255, 105, 180),
	Gold = Color3.fromRGB(255, 196, 40),
	GoldDark = Color3.fromRGB(214, 150, 10),
	Green = Color3.fromRGB(46, 196, 120),
	GreenDark = Color3.fromRGB(26, 150, 90),
	Red = Color3.fromRGB(240, 80, 100),
	Orange = Color3.fromRGB(255, 150, 50),
	Shadow = Color3.fromRGB(40, 20, 70),
}

Theme.Fonts = {
	Title = Enum.Font.FredokaOne,
	Body = Enum.Font.GothamMedium,
	Bold = Enum.Font.GothamBold,
}

-- Crea una instancia con propiedades e hijos en una sola llamada.
function Theme.new(className, props, children)
	local instance = Instance.new(className)
	if props then
		for key, value in pairs(props) do
			if key ~= "Parent" then
				instance[key] = value
			end
		end
	end
	if children then
		for _, child in ipairs(children) do
			child.Parent = instance
		end
	end
	if props and props.Parent then
		instance.Parent = props.Parent
	end
	return instance
end

function Theme.corner(radius)
	return Theme.new("UICorner", { CornerRadius = UDim.new(0, radius or 14) })
end

function Theme.stroke(color, thickness, transparency)
	return Theme.new("UIStroke", {
		Color = color or Theme.Colors.Ink,
		Thickness = thickness or 2,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function Theme.textStroke(color, thickness)
	return Theme.new("UIStroke", {
		Color = color or Theme.Colors.Ink,
		Thickness = thickness or 2,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
	})
end

function Theme.padding(all)
	local p = UDim.new(0, all)
	return Theme.new("UIPadding", { PaddingTop = p, PaddingBottom = p, PaddingLeft = p, PaddingRight = p })
end

function Theme.gradient(top, bottom, rotation)
	return Theme.new("UIGradient", {
		Color = ColorSequence.new(top, bottom),
		Rotation = rotation or 90,
	})
end

function Theme.label(props)
	local defaults = {
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Title,
		TextColor3 = Theme.Colors.Ink,
		TextScaled = true,
		Text = "",
	}
	for key, value in pairs(props) do
		if key ~= "MaxTextSize" then
			defaults[key] = value
		end
	end
	local label = Theme.new("TextLabel", defaults)
	if props.TextScaled ~= false and not label:FindFirstChildOfClass("UITextSizeConstraint") then
		Theme.new("UITextSizeConstraint", { MaxTextSize = props.MaxTextSize or 40, Parent = label })
	end
	return label
end

-- Botón con sombra "3D" y animación al pulsar.
function Theme.button(props)
	local color = props.Color or Theme.Colors.Primary
	local holder = Theme.new("Frame", {
		Name = props.Name or "Button",
		Size = props.Size or UDim2.fromOffset(160, 48),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.new(),
		BackgroundTransparency = 1,
		LayoutOrder = props.LayoutOrder or 0,
		ZIndex = props.ZIndex or 1,
		Parent = props.Parent,
	})
	local shadow = Theme.new("Frame", {
		Name = "Shadow",
		Size = UDim2.new(1, 0, 1, 0),
		Position = UDim2.fromOffset(0, 4),
		BackgroundColor3 = color:Lerp(Color3.new(0, 0, 0), 0.35),
		ZIndex = holder.ZIndex,
		Parent = holder,
	}, { Theme.corner(props.Radius or 14) })
	local button = Theme.new("TextButton", {
		Name = "Face",
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundColor3 = color,
		AutoButtonColor = false,
		Font = Theme.Fonts.Title,
		Text = props.Text or "",
		TextColor3 = props.TextColor or Color3.new(1, 1, 1),
		TextScaled = true,
		ZIndex = holder.ZIndex + 1,
		Parent = holder,
	}, {
		Theme.corner(props.Radius or 14),
		Theme.gradient(Color3.new(1, 1, 1), Color3.fromRGB(215, 215, 215)),
		Theme.new("UIPadding", {
			PaddingTop = UDim.new(0.18, 0),
			PaddingBottom = UDim.new(0.18, 0),
			PaddingLeft = UDim.new(0, 8),
			PaddingRight = UDim.new(0, 8),
		}),
		Theme.new("UITextSizeConstraint", { MaxTextSize = props.MaxTextSize or 28 }),
	})
	Theme.textStroke(color:Lerp(Color3.new(0, 0, 0), 0.45), 1.5).Parent = button

	local enabled = true
	button.MouseButton1Down:Connect(function()
		if enabled then
			button.Position = UDim2.fromOffset(0, 3)
		end
	end)
	button.MouseButton1Up:Connect(function()
		button.Position = UDim2.fromOffset(0, 0)
	end)
	button.MouseLeave:Connect(function()
		button.Position = UDim2.fromOffset(0, 0)
	end)

	local api = { Holder = holder, Button = button, Shadow = shadow }
	function api.SetColor(newColor)
		button.BackgroundColor3 = newColor
		shadow.BackgroundColor3 = newColor:Lerp(Color3.new(0, 0, 0), 0.35)
	end
	function api.SetEnabled(value)
		enabled = value
		button.Active = value
		button.AutoButtonColor = false
		api.SetColor(value and color or Color3.fromRGB(190, 184, 200))
	end
	function api.SetBaseColor(newColor)
		color = newColor
		api.SetColor(newColor)
	end
	if props.OnClick then
		button.Activated:Connect(function()
			if enabled then
				Theme.playSound("click")
				props.OnClick()
			end
		end)
	end
	return api
end

function Theme.tween(instance, time, props, style, direction)
	local tween = TweenService:Create(
		instance,
		TweenInfo.new(time, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out),
		props
	)
	tween:Play()
	return tween
end

-- Pequeño "rebote" al aparecer.
function Theme.pop(guiObject, scale)
	local uiScale = guiObject:FindFirstChild("PopScale")
	if not uiScale then
		uiScale = Theme.new("UIScale", { Name = "PopScale", Parent = guiObject })
	end
	uiScale.Scale = scale or 0.6
	Theme.tween(uiScale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
end

-- Formatea números grandes: 1234 -> 1.234, 1500000 -> 1,5M
function Theme.formatNumber(n)
	n = math.floor(n or 0)
	if n >= 1000000 then
		return (string.gsub(string.format("%.1fM", n / 1000000), "%.", ","))
	end
	local formatted = tostring(n)
	while true do
		local replaced, count = string.gsub(formatted, "^(-?%d+)(%d%d%d)", "%1.%2")
		formatted = replaced
		if count == 0 then
			break
		end
	end
	return formatted
end

function Theme.formatTime(seconds)
	seconds = math.max(0, math.floor(seconds))
	local h = math.floor(seconds / 3600)
	local m = math.floor(seconds % 3600 / 60)
	if h > 0 then
		return string.format("%dh %02dm", h, m)
	end
	return string.format("%dm %02ds", m, seconds % 60)
end

-- Sonidos incluidos en el cliente de Roblox (no requieren subir audio).
local SOUND_IDS = {
	click = "rbxasset://sounds/button.wav",
	paint = "rbxasset://sounds/clickfast.wav",
	success = "rbxasset://sounds/electronicpingshort.wav",
	whoosh = "rbxasset://sounds/swoosh.wav",
}
local SOUND_VOLUME = {
	click = 0.4,
	paint = 0.15,
	success = 0.6,
	whoosh = 0.4,
}
local soundCache = {}

function Theme.playSound(name, pitch)
	local id = SOUND_IDS[name]
	if not id then
		return
	end
	local sound = soundCache[name]
	if not sound then
		sound = Instance.new("Sound")
		sound.SoundId = id
		sound.Volume = SOUND_VOLUME[name] or 0.5
		sound.Parent = SoundService
		soundCache[name] = sound
	end
	sound.PlaybackSpeed = pitch or 1
	SoundService:PlayLocalSound(sound)
end

return Theme
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">World</string>
            <string name="Source"><![CDATA[-- Parte visual del mundo que se dibuja en el cliente:
-- cuadros de la galería y los globos de pedido sobre cada cliente.

local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Palette = require(Shared.Palette)
local Scoring = require(Shared.Scoring)
local Templates = require(Shared.Templates)

local UI = script.Parent:WaitForChild("UI")
local Theme = require(UI.Theme)
local PixelArt = require(UI.PixelArt)

local World = {}

local C = Theme.Colors

-- Cuadros ------------------------------------------------------------------------------
local function setupCanvas(canvas)
	if canvas:FindFirstChild("ArtGui") then
		return
	end
	local gui = Theme.new("SurfaceGui", {
		Name = "ArtGui",
		Face = Enum.NormalId.Front,
		SizingMode = Enum.SurfaceGuiSizingMode.FixedSize,
		CanvasSize = Vector2.new(256, 256),
		LightInfluence = 0.4,
		Brightness = 1.2,
		Parent = canvas,
	})
	local art = Theme.new("Frame", {
		Name = "Art",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Palette.EmptyColor,
		BorderSizePixel = 0,
		Parent = gui,
	})
	local placeholder = Theme.label({
		Name = "Placeholder",
		Size = UDim2.fromScale(0.8, 0.5),
		Position = UDim2.fromScale(0.1, 0.25),
		Text = "🖌️\nPróximamente",
		TextColor3 = Color3.fromRGB(190, 180, 205),
		MaxTextSize = 60,
		Parent = art,
	})
	local function refresh()
		local cells = canvas:GetAttribute("Cells")
		local valid = type(cells) == "string" and #cells == Config.CELLS
		placeholder.Visible = not valid
		PixelArt.render(art, valid and cells or nil)
	end
	canvas:GetAttributeChangedSignal("Cells"):Connect(refresh)
	refresh()
end

-- Globos de pedido ---------------------------------------------------------------------
local function orderPreview(model)
	local template = Templates.get(model:GetAttribute("TemplateId"))
	if not template then
		return nil, nil
	end
	local order = {
		mode = model:GetAttribute("Mode"),
		swapFrom = model:GetAttribute("SwapFrom"),
		swapTo = model:GetAttribute("SwapTo"),
		theme = model:GetAttribute("Theme"),
	}
	return template, Scoring.targetString(order, template) or Scoring.blankCanvas(template)
end

function World.orderPreview(model)
	return orderPreview(model)
end

local function patienceColor(fraction)
	if fraction > 0.5 then
		return C.Green:Lerp(C.Gold, (1 - fraction) * 2)
	end
	return C.Gold:Lerp(C.Red, 1 - fraction * 2)
end
World.patienceColor = patienceColor

local function setupCustomer(model)
	local root = model:WaitForChild("Root", 5)
	if not root or root:FindFirstChild("OrderBubble") then
		return
	end
	local isMine = model:GetAttribute("Owner") == game:GetService("Players").LocalPlayer.UserId
	if not isMine then
		-- Solo el dueño de la galería ve el aviso para atender a sus clientes.
		local prompt = root:FindFirstChildOfClass("ProximityPrompt")
		if prompt then
			prompt.MaxActivationDistance = 0
		end
	end
	local _, preview = orderPreview(model)
	local mode = Config.Modes[model:GetAttribute("Mode")] or Config.Modes.original
	local vip = model:GetAttribute("VIP")

	local billboard = Theme.new("BillboardGui", {
		Name = "OrderBubble",
		Size = UDim2.new(5.2, 0, 6.4, 0),
		StudsOffset = Vector3.new(0, 7.6, 0),
		MaxDistance = isMine and 90 or 45,
		LightInfluence = 0,
		ResetOnSpawn = false,
		Parent = root,
	})

	local bubble = Theme.new("Frame", {
		Size = UDim2.fromScale(1, 0.86),
		BackgroundColor3 = vip and Color3.fromRGB(255, 246, 214) or C.Panel,
		Parent = billboard,
	}, {
		Theme.corner(16),
		Theme.stroke(vip and C.Gold or mode.color, 3),
	})
	Theme.new("Frame", {
		Size = UDim2.fromScale(0.16, 0.12),
		Position = UDim2.fromScale(0.42, 0.93),
		Rotation = 45,
		BackgroundColor3 = bubble.BackgroundColor3,
		BorderSizePixel = 0,
		Parent = billboard,
	})

	local nameLabel = Theme.label({
		Size = UDim2.fromScale(0.92, 0.13),
		Position = UDim2.fromScale(0.04, 0.03),
		Text = (vip and "👑 " or "") .. tostring(model:GetAttribute("CustomerName")),
		TextColor3 = vip and C.GoldDark or C.Ink,
		Parent = bubble,
	})

	local thumb = Theme.new("Frame", {
		Size = UDim2.fromScale(0.62, 0.5),
		Position = UDim2.fromScale(0.19, 0.18),
		BackgroundColor3 = Palette.EmptyColor,
		Parent = bubble,
	}, {
		Theme.new("UIAspectRatioConstraint", { AspectRatio = 1 }),
		Theme.stroke(C.Ink, 2, 0.6),
	})
	if preview then
		PixelArt.render(thumb, preview)
	end
	Theme.label({
		Size = UDim2.fromScale(0.3, 0.3),
		Position = UDim2.fromScale(0.82, -0.08),
		Text = mode.icon,
		Parent = thumb,
	})

	local rewardLabel = Theme.label({
		Size = UDim2.fromScale(0.92, 0.13),
		Position = UDim2.fromScale(0.04, 0.69),
		Text = "💰 " .. Theme.formatNumber(model:GetAttribute("Reward")),
		TextColor3 = C.GoldDark,
		Parent = bubble,
	})

	local barBack = Theme.new("Frame", {
		Size = UDim2.fromScale(0.84, 0.07),
		Position = UDim2.fromScale(0.08, 0.86),
		BackgroundColor3 = Color3.fromRGB(230, 224, 240),
		Parent = bubble,
	}, { Theme.corner(8) })
	local bar = Theme.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = C.Green,
		Parent = barBack,
	}, { Theme.corner(8) })

	local reaction = Theme.label({
		Name = "Reaction",
		Size = UDim2.fromScale(0.92, 0.6),
		Position = UDim2.fromScale(0.04, 0.2),
		Text = "",
		Visible = false,
		Font = Theme.Fonts.Title,
		Parent = bubble,
	})

	local function refresh()
		local state = model:GetAttribute("State")
		local reactionText = model:GetAttribute("Reaction") or ""
		local leaving = state == "leaving" and reactionText ~= ""
		reaction.Visible = leaving
		reaction.Text = reactionText
		thumb.Visible = not leaving
		rewardLabel.Visible = not leaving
		barBack.Visible = state == "waiting"
		nameLabel.Visible = true
		if state == "leaving" and reactionText == "" then
			billboard.Enabled = false
		end
		local max = model:GetAttribute("MaxPatience") or 1
		local fraction = math.clamp((model:GetAttribute("Patience") or 0) / math.max(max, 1), 0, 1)
		bar.Size = UDim2.fromScale(fraction, 1)
		bar.BackgroundColor3 = patienceColor(fraction)
		if model:GetAttribute("Painting") and state == "waiting" then
			rewardLabel.Text = "🎨 Pintando..."
		else
			rewardLabel.Text = "💰 " .. Theme.formatNumber(model:GetAttribute("Reward"))
		end
	end

	model.AttributeChanged:Connect(refresh)
	refresh()
	Theme.pop(bubble, 0.3)
end

local function watchPlot(plot)
	local gallery = plot:WaitForChild("Gallery", 10)
	if gallery then
		for _, descendant in ipairs(gallery:GetDescendants()) do
			if descendant.Name == "Canvas" and descendant:IsA("BasePart") then
				setupCanvas(descendant)
			end
		end
		gallery.DescendantAdded:Connect(function(descendant)
			if descendant.Name == "Canvas" and descendant:IsA("BasePart") then
				setupCanvas(descendant)
			end
		end)
	end
	local shop = plot:WaitForChild("Shop", 10)
	local easel = shop and shop:WaitForChild("Easel", 10)
	local easelCanvas = easel and easel:WaitForChild("Canvas", 10)
	if easelCanvas then
		setupCanvas(easelCanvas)
	end
	local customers = plot:WaitForChild("Customers", 10)
	if customers then
		for _, model in ipairs(customers:GetChildren()) do
			task.spawn(setupCustomer, model)
		end
		customers.ChildAdded:Connect(function(model)
			task.spawn(setupCustomer, model)
		end)
	end
end

function World.start()
	local plots = Workspace:WaitForChild("Plots")
	for _, plot in ipairs(plots:GetChildren()) do
		task.spawn(watchPlot, plot)
	end
	plots.ChildAdded:Connect(function(plot)
		task.spawn(watchPlot, plot)
	end)
end

return World
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="27">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">false</bool>
    </Properties>
  </Item>
</roblox>