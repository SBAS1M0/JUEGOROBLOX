          <string name="Source"><![CDATA[-- Punto de entrada del servidor: crea el terreno propio de cada jugador y
-- gestiona la máquina de colores, los cuadros, la galería, las ventas,
-- las mejoras, las misiones diarias y el tutorial.

local Players = game:GetService("Players")
local PhysicsService = game:GetService("PhysicsService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Colors = require(Shared.Colors)
local Designs = require(Shared.Designs)

local Services = script.Parent:WaitForChild("Services")
local DataService = require(Services.DataService)
local WorldBuilder = require(Services.WorldBuilder)
local VisitorService = require(Services.VisitorService)

local rng = Random.new()

-- Remotos -------------------------------------------------------------------------
local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
local function remote(class, name)
	local r = Instance.new(class)
	r.Name = name
	r.Parent = remotes
	return r
end
local GetState = remote("RemoteFunction", "GetState")
local StateChanged = remote("RemoteEvent", "StateChanged")
local Notify = remote("RemoteEvent", "Notify")
local Roll = remote("RemoteFunction", "Roll")
local SetAutoRoll = remote("RemoteEvent", "SetAutoRoll")
local RollResult = remote("RemoteEvent", "RollResult")
local OpenDesigns = remote("RemoteEvent", "OpenDesigns")
local UnlockDesign = remote("RemoteFunction", "UnlockDesign")
local StartPainting = remote("RemoteFunction", "StartPainting")
local CancelPainting = remote("RemoteEvent", "CancelPainting")
local FinishPainting = remote("RemoteFunction", "FinishPainting")
local BuyUpgrade = remote("RemoteFunction", "BuyUpgrade")
local ClaimDaily = remote("RemoteFunction", "ClaimDaily")
local ClaimQuest = remote("RemoteFunction", "ClaimQuest")
local GoHome = remote("RemoteEvent", "GoHome")
remotes.Parent = ReplicatedStorage

-- Colisiones: los visitantes no empujan a los jugadores ni entre ellos.
local PLAYER_GROUP = "Jugadores"
pcall(function()
	PhysicsService:RegisterCollisionGroup(VisitorService.COLLISION_GROUP)
	PhysicsService:RegisterCollisionGroup(PLAYER_GROUP)
	PhysicsService:CollisionGroupSetCollidable(VisitorService.COLLISION_GROUP, VisitorService.COLLISION_GROUP, false)
	PhysicsService:CollisionGroupSetCollidable(VisitorService.COLLISION_GROUP, PLAYER_GROUP, false)
end)

local tryRoll

-- Estado de la sesión --------------------------------------------------------------------
local plotOf = {}
local usedSlots = {}
local sessions = {}

local function getSession(player)
	local session = sessions[player]
	if not session then
		session = { nextRoll = 0, nextAuto = 0, painting = nil, lastHome = 0 }
		sessions[player] = session
	end
	return session
end

local function notify(player, text, kind)
	Notify:FireClient(player, text, kind or "info")
end

local function openLevel(data)
	local level = 1
	for l = 2, Designs.MAX_LEVEL do
		if Designs.isLevelOpen(l, data.made) then
			level = l
		end
	end
	return level
end

local function dailyStatus(data)
	local now = os.time()
	local ready = now - data.lastDaily >= Config.DAILY_COOLDOWN
	local streak = data.dailyStreak
	if now - data.lastDaily > Config.DAILY_COOLDOWN * 2.4 then
		streak = 0
	end
	local nextStreak = math.min(streak + 1, 7)
	local amount = math.floor((80 + nextStreak * 40) * Config.questScale(openLevel(data)))
	return ready, amount, math.max(0, Config.DAILY_COOLDOWN - (now - data.lastDaily)), nextStreak
end

-- Misiones diarias -----------------------------------------------------------------------
local function ensureQuests(data)
	local day = math.floor(os.time() / 86400)
	if data.questDay == day and #data.quests == Config.QUESTS_PER_DAY then
		return
	end
	data.questDay = day
	data.questBonus = false
	data.quests = {}
	local scale = Config.questScale(openLevel(data))
	local pool = {}
	for _, def in ipairs(Config.QuestTypes) do
		table.insert(pool, def)
	end
	for _ = 1, Config.QUESTS_PER_DAY do
		local def = table.remove(pool, rng:NextInteger(1, #pool))
		local tier = rng:NextInteger(1, #def.goals)
		local goal = def.goals[tier]
		if def.scale then
			goal = math.floor(goal * scale / 10 + 0.5) * 10
		end
		table.insert(data.quests, {
			id = def.id,
			goal = goal,
			progress = 0,
			reward = math.floor((40 + 35 * tier) * scale),
			claimed = false,
		})
	end
end

-- Tutorial ----------------------------------------------------------------------------------
local pushState

local function tutorialEvent(player, data, step, amount)
	if data.tutorial ~= step then
		return
	end
	local def = Config.Tutorial[step]
	data.tutorialProgress += amount or 1
	if data.tutorialProgress >= def.goal then
		data.tutorial += 1
		data.tutorialProgress = 0
		if data.tutorial > #Config.Tutorial then
			data.tutorial = 0
			data.coins += Config.TUTORIAL_REWARD
			notify(player, "🎓 ¡Tutorial completado! +💵" .. Config.TUTORIAL_REWARD, "gold")
		end
	end
end

local function questEvent(player, data, id, amount)
	ensureQuests(data)
	for _, quest in ipairs(data.quests) do
		if quest.id == id and quest.progress < quest.goal then
			quest.progress = math.min(quest.goal, quest.progress + amount)
			if quest.progress >= quest.goal then
				notify(player, "✅ Misión lista: " .. Config.questText(quest) .. " (¡reclámala!)", "success")
			end
		end
	end
end

local function earn(player, data, amount)
	data.coins += amount
	data.earned += amount
	questEvent(player, data, "ganar", amount)
end

-- Estado para el cliente -------------------------------------------------------------------
local function buildState(player)
	local data = DataService.get(player)
	if not data then
		return nil
	end
	ensureQuests(data)
	local session = getSession(player)
	local ready, amount, wait, nextStreak = dailyStatus(data)
	local plot = plotOf[player]
	return {
		coins = data.coins,
		paints = data.paints,
		unlocked = data.unlocked,
		made = data.made,
		upgrades = data.upgrades,
		openLevel = openLevel(data),
		slots = Config.gallerySlots(data.upgrades),
		displayed = #data.gallery,
		autoUnlocked = Config.hasAutoRoll(data.upgrades),
		autoRoll = data.autoRoll and Config.hasAutoRoll(data.upgrades),
		lastRoll = data.lastRoll,
		rolls = data.rolls,
		rollInterval = Config.rollInterval(data.upgrades),
		sold = data.sold,
		earned = data.earned,
		painting = session.painting and session.painting.designId or nil,
		quests = data.quests,
		questBonus = data.questBonus,
		tutorial = data.tutorial,
		tutorialProgress = data.tutorialProgress,
		dailyReady = ready,
		dailyAmount = amount,
		dailyWait = wait,
		dailyStreak = nextStreak,
		plotName = plot and plot.model.Name or "",
	}
end

local function updateLeaderstats(player)
	local data = DataService.get(player)
	local stats = player:FindFirstChild("leaderstats")
	if data and stats then
		stats.Monedas.Value = data.coins
		stats.Vendidos.Value = data.sold
	end
end

function pushState(player)
	local state = buildState(player)
	if state then
		StateChanged:FireClient(player, state)
	end
	updateLeaderstats(player)
end

-- Visuales del terreno ----------------------------------------------------------------------
local function rarityIndex(colorId)
	return Colors.rarityOf(Colors.ById[colorId]).index
end

local function ownedSorted(data)
	local owned = {}
	for colorId, count in pairs(data and data.paints or {}) do
		if count > 0 and Colors.ById[colorId] then
			table.insert(owned, colorId)
		end
	end
	table.sort(owned, function(a, b)
		local ra, rb = rarityIndex(a), rarityIndex(b)
		if ra ~= rb then
			return ra > rb
		end
		return Colors.ById[a].index < Colors.ById[b].index
	end)
	return owned
end

local function renderShelf(plot, data)
	local owned = ownedSorted(data)
	for i, can in ipairs(plot.workshop.shelfCans) do
		local colorId = owned[i]
		if colorId then
			local rarity = rarityIndex(colorId)
			can.Color = Colors.mainColor(colorId)
			can.Transparency = 0
			can.Material = rarity >= 6 and Enum.Material.Neon
				or (rarity >= 5 and Enum.Material.Metal or Enum.Material.SmoothPlastic)
		else
			can.Color = Color3.fromRGB(230, 230, 236)
			can.Transparency = 0.7
			can.Material = Enum.Material.SmoothPlastic
		end
	end
	-- Las bolas de la máquina muestran tus colores.
	if #owned > 0 then
		for i, ball in ipairs(plot.workshop.machineBalls) do
			ball.Color = Colors.mainColor(owned[(i - 1) % #owned + 1])
		end
	end
end

local function renderMachine(plot, colorId)
	local workshop = plot.workshop
	local entry = Colors.ById[colorId]
	workshop.machineTop:SetAttribute("ColorId", entry and colorId or "")
	if entry then
		workshop.machineCan.Color = Colors.mainColor(colorId)
		workshop.machineGlow.Color = Colors.rarityOf(entry).color
	end
end

local function slotEntry(data, slot)
	for i, entry in ipairs(data.gallery) do
		if entry.s == slot then
			return entry, i
		end
	end
	return nil
end

local function renderGallery(plot, data)
	local slots = Config.gallerySlots(data.upgrades)
	for i = 1, Config.GALLERY_SIZE do
		local canvas = plot.canvases[i]
		local plaque = plot.plaques[i]
		local entry = slotEntry(data, i)
		local design = entry and Designs.get(entry.d)
		canvas:SetAttribute("Locked", i > slots)
		if design then
			canvas:SetAttribute("Design", entry.d)
			canvas:SetAttribute("Colors", entry.c)
			canvas:SetAttribute("Price", entry.v)
			canvas:SetAttribute("Stars", entry.st or 1)
			plaque.Text = design.name .. "  ·  💵 " .. entry.v
		else
			canvas:SetAttribute("Design", "")
			canvas:SetAttribute("Colors", "")
			canvas:SetAttribute("Price", 0)
			canvas:SetAttribute("Stars", 0)
			plaque.Text = i > slots and "🔒 Mejora «Más paredes»" or "Espacio libre"
		end
	end
end

local function renderEasel(plot, designId, colors)
	plot.workshop.easelCanvas:SetAttribute("Design", designId or "")
	plot.workshop.easelCanvas:SetAttribute("Colors", colors or "")
end

local function refreshPlot(player)
	local plot = plotOf[player]
	local data = DataService.get(player)
	if plot and data then
		renderGallery(plot, data)
		renderShelf(plot, data)
	end
end

-- Terreno propio de cada jugador ----------------------------------------------------------------
local function createPlot(player, data)
	local slot
	for i = 1, Config.MAX_PLOTS do
		if not usedSlots[i] then
			slot = i
			break
		end
	end
	if not slot then
		return nil
	end
	usedSlots[slot] = player
	local plot = WorldBuilder.buildLot(slot)
	plot.model:SetAttribute("OwnerUserId", player.UserId)
	pcall(function()
		plot.model:AddPersistentPlayer(player)
	end)
	WorldBuilder.setOwnerName(plot, player.DisplayName)
	plotOf[player] = plot
	renderGallery(plot, data)
	renderShelf(plot, data)
	renderMachine(plot, data.lastRoll)
	WorldBuilder.setDecorLevel(plot, data.upgrades.decoracion or 0)
	VisitorService.attach(plot, player)

	plot.workshop.drawPrompt.Triggered:Connect(function(who)
		if who == player then
			OpenDesigns:FireClient(player)
		end
	end)
	plot.workshop.machinePrompt.Triggered:Connect(function(who)
		if who == player then
			tryRoll(player)
		end
	end)
	return plot
end

local function releasePlot(player)
	local plot = plotOf[player]
	if not plot then
		return
	end
	plotOf[player] = nil
	usedSlots[plot.slot] = nil
	VisitorService.detach(plot)
	WorldBuilder.destroyLot(plot)
end

local function teleportHome(player)
	local plot = plotOf[player]
	local character = player.Character
	if not (plot and character and character:FindFirstChild("HumanoidRootPart")) then
		return
	end
	pcall(function()
		player:RequestStreamAroundAsync(plot.ownerSpawn.Position, 5)
	end)
	if character.Parent then
		character:PivotTo(plot.ownerSpawn)
	end
end

-- Máquina de colores ---------------------------------------------------------------------------
local function addPaint(data, colorId, amount)
	data.paints[colorId] = math.min(Config.MAX_PAINT_STACK, (data.paints[colorId] or 0) + amount)
end

local function doRoll(player, auto)
	local data = DataService.get(player)
	if not data then
		return nil
	end
	local entry = Colors.roll(Config.luck(data.upgrades), rng)
	addPaint(data, entry.id, 1)
	data.lastRoll = entry.id
	data.rolls += 1
	questEvent(player, data, "tirar", 1)
	if Colors.rarityOf(entry).index >= 3 then
		questEvent(player, data, "raro", 1)
	end
	tutorialEvent(player, data, 1, 1)
	local plot = plotOf[player]
	if plot then
		renderMachine(plot, entry.id)
		renderShelf(plot, data)
	end
	RollResult:FireClient(player, entry.id, auto == true)
	pushState(player)
	return entry.id
end

function tryRoll(player)
	local data = DataService.get(player)
	local session = getSession(player)
	if not data then
		return nil
	end
	local now = os.clock()
	if now < session.nextRoll then
		return nil
	end
	session.nextRoll = now + Config.rollInterval(data.upgrades)
	return doRoll(player, false)
end

Roll.OnServerInvoke = function(player)
	return tryRoll(player)
end

SetAutoRoll.OnServerEvent:Connect(function(player, enabled)
	local data = DataService.get(player)
	if not (data and type(enabled) == "boolean") then
		return
	end
	if enabled and not Config.hasAutoRoll(data.upgrades) then
		notify(player, "🔒 Desbloquea «Auto-Rolling» en Mejoras", "error")
		return
	end
	data.autoRoll = enabled
	pushState(player)
end)

-- Diseños y pintura -------------------------------------------------------------------------------
UnlockDesign.OnServerInvoke = function(player, designId)
	local data = DataService.get(player)
	local design = type(designId) == "string" and Designs.get(designId)
	if not (data and design) then
		return false, "Diseño no válido."
	end
	if data.unlocked[designId] then
		return false, "Ya lo tienes."
	end
	if not Designs.isLevelOpen(design.level, data.made) then
		return false, "Pinta todos los diseños del nivel " .. (design.level - 1) .. " primero."
	end
	if data.coins < design.price then
		return false, "Te faltan " .. (design.price - data.coins) .. " monedas."
	end
	data.coins -= design.price
	data.unlocked[designId] = true
	pushState(player)
	return true, "¡Desbloqueaste «" .. design.name .. "»!"
end

-- Unidades de cada color que pide la elección (las básicas no se gastan).
local function paintCost(colors)
	local cost = {}
	for _, colorId in pairs(colors) do
		local entry = Colors.ById[colorId]
		if entry and not entry.basic then
			cost[colorId] = (cost[colorId] or 0) + 1
		end
	end
	return cost
end

StartPainting.OnServerInvoke = function(player, designId, colors)
	local data = DataService.get(player)
	local session = getSession(player)
	local design = type(designId) == "string" and Designs.get(designId)
	if not (data and design) or type(colors) ~= "table" then
		return false, "Diseño no válido."
	end
	if session.painting then
		return false, "Ya estás pintando un cuadro."
	end
	if not data.unlocked[designId] or not Designs.isLevelOpen(design.level, data.made) then
		return false, "Ese diseño está bloqueado."
	end
	local chosen = {}
	for _, area in ipairs(design.areas) do
		local colorId = colors[area.id]
		if type(colorId) ~= "string" or not Colors.ById[colorId] then
			return false, "Elige un color para «" .. area.name .. "»."
		end
		chosen[area.id] = colorId
	end
	local cost = paintCost(chosen)
	for colorId, amount in pairs(cost) do
		if (data.paints[colorId] or 0) < amount then
			return false, "No tienes suficiente «" .. Colors.ById[colorId].name .. "»."
		end
	end
	for colorId, amount in pairs(cost) do
		data.paints[colorId] -= amount
		if data.paints[colorId] <= 0 then
			data.paints[colorId] = nil
		end
	end
	session.painting = {
		designId = designId,
		colors = chosen,
		started = os.clock(),
		minTime = Config.minPaintTime(design, data.upgrades),
	}
	tutorialEvent(player, data, 2, 1)
	refreshPlot(player)
	pushState(player)
	return true
end

local function cancelPainting(player)
	local data = DataService.get(player)
	local session = getSession(player)
	local painting = session.painting
	if not (data and painting) then
		return
	end
	session.painting = nil
	for colorId, amount in pairs(paintCost(painting.colors)) do
		addPaint(data, colorId, amount)
	end
	refreshPlot(player)
	pushState(player)
end

CancelPainting.OnServerEvent:Connect(cancelPainting)

local function freeSlot(data)
	for slot = 1, Config.gallerySlots(data.upgrades) do
		if not slotEntry(data, slot) then
			return slot
		end
	end
	return nil
end

FinishPainting.OnServerInvoke = function(player, choice)
	local data = DataService.get(player)
	local session = getSession(player)
	local painting = session.painting
	if not (data and painting) then
		return { ok = false, reason = "No estás pintando nada." }
	end
	local elapsed = os.clock() - painting.started
	if elapsed < painting.minTime then
		return { ok = false, reason = "¡Aún no está terminado!" }
	end
	local design = Designs.get(painting.designId)
	local madeBefore = data.made[design.id] or 0
	-- Las estrellas se calculan sobre el primer intento de entrega.
	painting.stars = painting.stars or Config.starsFor(design, data.upgrades, elapsed)
	local stars = painting.stars
	local value = Config.paintingValue(design, painting.colors, data.upgrades, madeBefore, stars)
	local encoded = Designs.encodeColors(painting.colors)
	local levelBefore = openLevel(data)
	local tierBefore = Config.masteryFor(madeBefore)

	session.painting = nil
	data.made[design.id] = madeBefore + 1
	questEvent(player, data, "pintar", 1)
	if stars >= 3 then
		questEvent(player, data, "estrellas", 1)
	end
	tutorialEvent(player, data, 3, 1)

	local result = { ok = true, value = value, stars = stars, designId = design.id }
	local slot = choice == "galeria" and freeSlot(data)
	if slot then
		local price = math.floor(value * Config.GALLERY_BONUS)
		table.insert(data.gallery, { s = slot, d = design.id, c = encoded, v = price, st = stars })
		result.displayed = true
		result.price = price
		result.slot = slot
		tutorialEvent(player, data, 4, 1)
	else
		earn(player, data, value)
		data.sold += 1
		result.displayed = false
		result.price = value
	end

	local tierAfter = Config.masteryFor(data.made[design.id])
	if tierAfter and tierAfter ~= tierBefore then
		result.mastery = tierAfter.name
	end
	local levelAfter = openLevel(data)
	if levelAfter > levelBefore then
		result.newLevel = levelAfter
	end

	local plot = plotOf[player]
	if plot then
		renderEasel(plot, design.id, encoded)
	end
	refreshPlot(player)
	pushState(player)
	return result
end

-- Ventas a visitantes ---------------------------------------------------------------------------
VisitorService.getProfile = function(player)
	return DataService.get(player)
end

VisitorService.availableSlots = function(player)
	local data = DataService.get(player)
	local list = {}
	if data then
		for _, entry in ipairs(data.gallery) do
			table.insert(list, entry.s)
		end
	end
	return list
end

VisitorService.onPurchase = function(player, slot, buyerName, vip)
	local data = DataService.get(player)
	if not data or not player.Parent then
		return nil
	end
	local entry, index = slotEntry(data, slot)
	if not entry then
		return nil
	end
	table.remove(data.gallery, index)
	local price = vip and math.floor(entry.v * Config.VIP_MULTIPLIER) or entry.v
	earn(player, data, price)
	data.sold += 1
	questEvent(player, data, "vender", 1)
	tutorialEvent(player, data, 5, 1)
	local design = Designs.get(entry.d)
	notify(
		player,
		(vip and "👑 ¡Coleccionista! " or "🖼️ ")
			.. tostring(buyerName)
			.. " compró «"
			.. (design and design.name or "tu cuadro")
			.. "» por 💵"
			.. price,
		"gold"
	)
	refreshPlot(player)
	pushState(player)
	return price
end

-- Mejoras, regalo diario y misiones ----------------------------------------------------------------
BuyUpgrade.OnServerInvoke = function(player, id)
	local data = DataService.get(player)
	local upgrade = type(id) == "string" and Config.UpgradeById[id]
	if not (data and upgrade) then
		return false, "Mejora no válida."
	end
	local level = data.upgrades[id] or 0
	if level >= upgrade.max then
		return false, "¡Ya está al máximo!"
	end
	local cost = Config.upgradeCost(id, level)
	if data.coins < cost then
		return false, "Te faltan " .. (cost - data.coins) .. " monedas."
	end
	data.coins -= cost
	data.upgrades[id] = level + 1
	local plot = plotOf[player]
	if plot then
		if id == "decoracion" then
			WorldBuilder.setDecorLevel(plot, level + 1)
		elseif id == "paredes" then
			renderGallery(plot, data)
		end
	end
	if id == "auto" then
		data.autoRoll = true
	end
	pushState(player)
	return true, upgrade.name .. " subió a nivel " .. (level + 1) .. "!"
end

local function rareGift(minRarity)
	local gift
	for _ = 1, 200 do
		gift = Colors.roll(4, rng)
		if Colors.rarityOf(gift).index >= (minRarity or 3) then
			break
		end
	end
	return gift
end

ClaimDaily.OnServerInvoke = function(player)
	local data = DataService.get(player)
	if not data then
		return false
	end
	local ready, amount, _, nextStreak = dailyStatus(data)
	if not ready then
		return false
	end
	data.lastDaily = os.time()
	data.dailyStreak = nextStreak
	earn(player, data, amount)
	-- El séptimo día de racha regala un color Épico o mejor.
	local gift = rareGift(nextStreak >= 7 and 4 or 3)
	addPaint(data, gift.id, 1)
	refreshPlot(player)
	pushState(player)
	return true, amount, gift.id
end

ClaimQuest.OnServerInvoke = function(player, index)
	local data = DataService.get(player)
	if not data or type(index) ~= "number" then
		return false
	end
	ensureQuests(data)
	local quest = data.quests[index]
	if not quest or quest.claimed or quest.progress < quest.goal then
		return false
	end
	quest.claimed = true
	data.coins += quest.reward
	local result = { reward = quest.reward }
	local allDone = true
	for _, q in ipairs(data.quests) do
		if not q.claimed then
			allDone = false
		end
	end
	if allDone and not data.questBonus then
		data.questBonus = true
		local bonus = nil
		for _ = 1, 80 do
			bonus = Colors.roll(6, rng)
			if Colors.rarityOf(bonus).index >= 4 then
				break
			end
		end
		addPaint(data, bonus.id, 1)
		result.bonusColor = bonus.id
	end
	refreshPlot(player)
	pushState(player)
	return true, result
end

GetState.OnServerInvoke = function(player)
	for _ = 1, 50 do
		if DataService.get(player) then
			break
		end
		task.wait(0.2)
	end
	return buildState(player)
end

GoHome.OnServerEvent:Connect(function(player)
	local session = getSession(player)
	if os.clock() - session.lastHome >= 2 then
		session.lastHome = os.clock()
		teleportHome(player)
	end
end)

-- Jugadores -----------------------------------------------------------------------------------------
local function setCharacterGroup(character)
	local function apply(part)
		if part:IsA("BasePart") then
			part.CollisionGroup = PLAYER_GROUP
		end
	end
	for _, descendant in ipairs(character:GetDescendants()) do
		apply(descendant)
	end
	character.DescendantAdded:Connect(apply)
end

local function onPlayerAdded(player)
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	for _, name in ipairs({ "Monedas", "Vendidos" }) do
		local value = Instance.new("IntValue")
		value.Name = name
		value.Parent = stats
	end
	stats.Parent = player

	player.CharacterAdded:Connect(function(character)
		setCharacterGroup(character)
		character:WaitForChild("HumanoidRootPart", 10)
		task.wait(0.2)
		teleportHome(player)
	end)

	local data = DataService.load(player)
	if not player.Parent then
		return
	end
	-- Los jugadores que ya habían vendido no necesitan el tutorial.
	if data.tutorial ~= 0 and data.sold > 0 then
		data.tutorial = 0
	end
	if not Config.hasAutoRoll(data.upgrades) then
		data.autoRoll = false
	end
	ensureQuests(data)

	local plot = createPlot(player, data)
	if not plot then
		notify(player, "El servidor está lleno, prueba en otro servidor.", "error")
	end
	if player.Character then
		setCharacterGroup(player.Character)
		task.defer(teleportHome, player)
	end
	pushState(player)
	notify(player, "¡Bienvenido a tu galería! 🎨", "success")
end

-- Si el servidor estaba lleno, el primero que esperaba recibe el terreno libre.
local function assignWaitingPlayers()
	for _, waiting in ipairs(Players:GetPlayers()) do
		local data = DataService.get(waiting)
		if data and not plotOf[waiting] then
			if not createPlot(waiting, data) then
				return
			end
			teleportHome(waiting)
			pushState(waiting)
			notify(waiting, "¡Tu galería está lista! 🎨", "success")
		end
	end
end

local function onPlayerRemoving(player)
	cancelPainting(player)
	releasePlot(player)
	DataService.release(player)
	sessions[player] = nil
	task.defer(assignWaitingPlayers)
end

-- Arranque -------------------------------------------------------------------------------------------
WorldBuilder.buildSpawn()
DataService.start()
VisitorService.start()

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, player)
end

-- Tiradas automáticas (solo con la mejora Auto-Rolling).
task.spawn(function()
	while true do
		task.wait(0.2)
		local now = os.clock()
		for _, player in ipairs(Players:GetPlayers()) do
			local data = DataService.get(player)
			local session = sessions[player]
			if data and session and data.autoRoll and Config.hasAutoRoll(data.upgrades) and plotOf[player] then
				if now >= session.nextAuto then
					session.nextAuto = now + Config.autoRollInterval(data.upgrades)
					doRoll(player, true)
				end
			end
		end
	end
end)

-- Refresca el contador del regalo diario y cambia las misiones al cambiar el día.
task.spawn(function()
	while true do
		task.wait(60)
		for _, player in ipairs(Players:GetPlayers()) do
			pushState(player)
		end
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="11">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[-- Guarda y carga el progreso de cada jugador con DataStoreService.
-- Si los DataStores no están disponibles (por ejemplo en Studio sin publicar)
-- el juego sigue funcionando, solo que sin guardar.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)

local DataService = {}

local STORE_NAME = "GaleriaPincelada_v2"
local MAX_RETRIES = 4

local store = nil
local profiles = {}
local loaded = {}

do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
	else
		warn("[Galería] DataStores no disponibles, el progreso no se guardará: " .. tostring(result))
	end
end

local function defaultData()
	return {
		coins = Config.START_COINS,
		paints = {}, -- colorId -> cantidad
		unlocked = { globo = true }, -- diseños comprados
		made = {}, -- diseñoId -> veces pintado
		upgrades = {},
		gallery = {}, -- { s = hueco, d = diseño, c = colores, v = valor }
		autoRoll = false,
		lastRoll = "",
		rolls = 0,
		quests = {},
		questDay = 0,
		questBonus = false,
		tutorial = 1,
		tutorialProgress = 0,
		sold = 0,
		earned = 0,
		lastDaily = 0,
		dailyStreak = 0,
	}
end

-- Rellena campos que falten (por ejemplo tras una actualización del juego).
local function reconcile(data)
	local template = defaultData()
	if type(data) ~= "table" then
		return template
	end
	for key, value in pairs(template) do
		if type(data[key]) ~= type(value) then
			data[key] = value
		end
	end
	for id in pairs(data.upgrades) do
		if not Config.UpgradeById[id] then
			data.upgrades[id] = nil
		end
	end
	return data
end

-- Errores que no se arreglan reintentando (Studio sin acceso a las APIs).
local function isPermanentError(message)
	message = tostring(message)
	return string.find(message, "StudioAccessToApisNotAllowed", 1, true) ~= nil
		or string.find(message, "publish", 1, true) ~= nil
end

local function disableStore(reason)
	if store then
		store = nil
		warn("[Galería] DataStores no disponibles, el progreso no se guardará: " .. tostring(reason))
	end
end

local function withRetries(callback)
	local lastError
	for attempt = 1, MAX_RETRIES do
		local ok, result = pcall(callback)
		if ok then
			return true, result
		end
		lastError = result
		if isPermanentError(result) then
			disableStore(result)
			break
		end
		task.wait(attempt * 1.5)
	end
	return false, lastError
end

function DataService.load(player)
	local data
	local canSave = store ~= nil
	local currentStore = store
	if currentStore then
		local ok, result = withRetries(function()
			return currentStore:GetAsync("player_" .. player.UserId)
		end)
		if ok then
			data = result
		else
			-- No guardamos encima de datos que no pudimos leer.
			canSave = false
			if store then
				warn("[Galería] No se pudo cargar a " .. player.Name .. ": " .. tostring(result))
			end
		end
	end
	data = reconcile(data)
	if player.Parent then
		profiles[player] = data
		loaded[player] = canSave
	end
	return data
end

function DataService.get(player)
	return profiles[player]
end

function DataService.save(player)
	local data = profiles[player]
	local currentStore = store
	if not (currentStore and data and loaded[player]) then
		return
	end
	local ok, result = withRetries(function()
		return currentStore:UpdateAsync("player_" .. player.UserId, function()
			return data
		end)
	end)
	if not ok then
		warn("[Galería] No se pudo guardar a " .. player.Name .. ": " .. tostring(result))
	end
end

function DataService.release(player)
	DataService.save(player)
	profiles[player] = nil
	loaded[player] = nil
end

function DataService.start()
	task.spawn(function()
		while true do
			task.wait(Config.AUTOSAVE_SECONDS)
			for _, player in ipairs(Players:GetPlayers()) do
				task.spawn(DataService.save, player)
			end
		end
	end)

	game:BindToClose(function()
		if RunService:IsStudio() and not store then
			return
		end
		local pending = 0
		for _, player in ipairs(Players:GetPlayers()) do
			pending += 1
			task.spawn(function()
				DataService.save(player)
				pending -= 1
			end)
		end
		local started = os.clock()
		while pending > 0 and os.clock() - started < 25 do
			task.wait(0.2)
		end
	end)
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">VisitorService</string>
            <string name="Source"><![CDATA[-- Visitantes: avatares reales de Roblox (los amigos del dueño o avatares
-- conocidos) que entran a la galería, miran un cuadro expuesto y lo compran.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)

local VisitorService = {}

VisitorService.COLLISION_GROUP = "Visitantes"

local ANIMATIONS = {
	walk = "rbxassetid://507777826",
	idle = "rbxassetid://507766388",
	cheer = "rbxassetid://507770677",
	wave = "rbxassetid://507770239",
}
local FALLBACK_NAMES =
	{ "Lucía", "Mateo", "Sofía", "Diego", "Valentina", "Leo", "Camila", "Hugo", "Martina", "Bruno" }
local SKIN_TONES = {
	Color3.fromRGB(255, 224, 196),
	Color3.fromRGB(241, 194, 150),
	Color3.fromRGB(214, 160, 120),
	Color3.fromRGB(170, 116, 80),
	Color3.fromRGB(120, 80, 56),
}
local SHIRT_COLORS = {
	Color3.fromRGB(255, 140, 160),
	Color3.fromRGB(120, 190, 255),
	Color3.fromRGB(130, 220, 160),
	Color3.fromRGB(255, 200, 100),
	Color3.fromRGB(190, 150, 255),
}

-- Callbacks que asigna el servidor principal.
VisitorService.getProfile = nil -- (player) -> datos
VisitorService.availableSlots = nil -- (player) -> { hueco, ... } con cuadro
VisitorService.onPurchase = nil -- (player, hueco, nombre) -> precio o nil

local rng = Random.new()
local states = {}
local descriptionCache = {}
local friendsOf = {}

local function pick(list)
	return list[rng:NextInteger(1, #list)]
end

-- Avatares ----------------------------------------------------------------------------
local function loadFriends(owner)
	if friendsOf[owner] then
		return
	end
	friendsOf[owner] = {}
	task.spawn(function()
		local ok, pages = pcall(function()
			return Players:GetFriendsAsync(owner.UserId)
		end)
		if not ok or not pages then
			return
		end
		local okPage, page = pcall(function()
			return pages:GetCurrentPage()
		end)
		if okPage and type(page) == "table" then
			local list = {}
			for _, friend in ipairs(page) do
				if type(friend) == "table" and friend.Id then
					table.insert(list, { id = friend.Id, name = friend.DisplayName or friend.Username })
				end
			end
			if owner.Parent then
				friendsOf[owner] = list
			end
		end
	end)
end

local function getDescription(userId)
	local cached = descriptionCache[userId]
	if cached ~= nil then
		return cached or nil
	end
	local ok, description = pcall(function()
		return Players:GetHumanoidDescriptionFromUserId(userId)
	end)
	descriptionCache[userId] = (ok and description) or false
	return ok and description or nil
end

local function randomDescription()
	local description = Instance.new("HumanoidDescription")
	local skin = pick(SKIN_TONES)
	local shirt = pick(SHIRT_COLORS)
	description.HeadColor = skin
	description.LeftArmColor = skin
	description.RightArmColor = skin
	description.TorsoColor = shirt
	description.LeftLegColor = Color3.fromRGB(70, 70, 110)
	description.RightLegColor = Color3.fromRGB(70, 70, 110)
	return description
end

local function setCollisionGroup(model)
	for _, descendant in ipairs(model:GetDescendants()) do
		if descendant:IsA("BasePart") then
			descendant.CollisionGroup = VisitorService.COLLISION_GROUP
		end
	end
end

local function createAvatar(owner)
	local friends = friendsOf[owner] or {}
	local userId, name
	if #friends > 0 and rng:NextNumber() < 0.75 then
		local friend = pick(friends)
		userId, name = friend.id, friend.name
	else
		userId = pick(Config.FALLBACK_AVATARS)
	end
	local description = getDescription(userId) or randomDescription()
	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromDescription(description, Enum.HumanoidRigType.R15)
	end)
	if not ok or not model then
		ok, model = pcall(function()
			return Players:CreateHumanoidModelFromDescription(randomDescription(), Enum.HumanoidRigType.R15)
		end)
		if not ok or not model then
			return nil
		end
	end
	return model, name or pick(FALLBACK_NAMES)
end

-- Movimiento y animaciones -------------------------------------------------------------
local function loadTracks(humanoid)
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end
	local tracks = {}
	for name, id in pairs(ANIMATIONS) do
		local animation = Instance.new("Animation")
		animation.AnimationId = id
		local ok, track = pcall(function()
			return animator:LoadAnimation(animation)
		end)
		if ok and track then
			track.Looped = name == "walk" or name == "idle"
			tracks[name] = track
		end
	end
	return tracks
end

local function play(visitor, name)
	for trackName, track in pairs(visitor.tracks) do
		if trackName ~= name and track.IsPlaying then
			track:Stop(0.2)
		end
	end
	local track = visitor.tracks[name]
	if track and not track.IsPlaying then
		track:Play(0.2)
	end
end

local function alive(visitor)
	return visitor.model.Parent ~= nil and visitor.humanoid.Parent ~= nil
end

-- Camina hasta el punto. Roblox corta MoveTo a los 8 s, así que se repite
-- mientras siga avanzando; si se atasca, se le acerca al destino.
local function walkTo(visitor, target)
	for _ = 1, 4 do
		if not alive(visitor) then
			return false
		end
		play(visitor, "walk")
		local finished = false
		local connection = visitor.humanoid.MoveToFinished:Connect(function()
			finished = true
		end)
		visitor.humanoid:MoveTo(target.Position)
		local started = os.clock()
		while not finished and alive(visitor) and os.clock() - started < 9 do
			task.wait(0.1)
		end
		connection:Disconnect()
		if not alive(visitor) then
			return false
		end
		local offset = visitor.root.Position - target.Position
		if Vector3.new(offset.X, 0, offset.Z).Magnitude <= 3 then
			return true
		end
	end
	visitor.model:PivotTo(target * CFrame.new(0, 3, 0))
	return true
end

local function walkRoute(visitor, points)
	for _, point in ipairs(points) do
		if not walkTo(visitor, point) then
			return false
		end
	end
	return true
end

-- Ciclo de un visitante -----------------------------------------------------------------
local function runVisitor(state, slot)
	local plot = state.plot
	local owner = state.owner
	local model, name = createAvatar(owner)
	if not model or states[plot.index] ~= state then
		state.reserved[slot] = nil
		if model then
			model:Destroy()
		end
		return
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local root = model:FindFirstChild("HumanoidRootPart")
	if not (humanoid and root) then
		state.reserved[slot] = nil
		model:Destroy()
		return
	end
	local profile = VisitorService.getProfile(owner)
	local vip = profile ~= nil and rng:NextNumber() < Config.vipChance(profile.upgrades)
	model.Name = vip and "Coleccionista" or "Visitante"
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.WalkSpeed = 13
	model:SetAttribute("VisitorName", name)
	model:SetAttribute("VIP", vip)
	model:SetAttribute("Owner", owner.UserId)
	model:SetAttribute("Reaction", "")
	setCollisionGroup(model)
	local start = plot.route[1]
	model:PivotTo(CFrame.lookAt(start.Position, plot.route[2].Position) * CFrame.new(0, 3, 0))
	model.Parent = plot.visitorsFolder
	pcall(function()
		root:SetNetworkOwner(nil)
	end)
	if vip then
		local sparkles = Instance.new("Sparkles")
		sparkles.SparkleColor = Color3.fromRGB(255, 210, 80)
		sparkles.Parent = root
	end

	local visitor = { model = model, humanoid = humanoid, root = root, tracks = loadTracks(humanoid) }
	state.visitors[visitor] = true

	local function finish()
		state.visitors[visitor] = nil
		state.reserved[slot] = nil
		if model.Parent then
			model:Destroy()
		end
	end

	if not walkRoute(visitor, plot.route) then
		finish()
		return
	end

	-- Mira otro cuadro antes de decidirse (si hay más de uno).
	local others = {}
	for _, other in ipairs(VisitorService.availableSlots(owner)) do
		if other ~= slot then
			table.insert(others, other)
		end
	end
	if #others > 0 and rng:NextNumber() < 0.6 then
		local browse = plot.standPoints[pick(others)]
		if walkTo(visitor, browse) then
			model:PivotTo(browse * CFrame.new(0, 3, 0))
			play(visitor, "idle")
			model:SetAttribute("Reaction", "👀")
			task.wait(rng:NextNumber(1.5, 2.5))
		end
	end

	-- Se planta frente al cuadro elegido y lo admira.
	local stand = plot.standPoints[slot]
	if not walkTo(visitor, stand) then
		finish()
		return
	end
	model:PivotTo(stand * CFrame.new(0, 3, 0))
	play(visitor, "idle")
	model:SetAttribute("Reaction", vip and "🧐✨" or "🤔")
	task.wait(rng:NextNumber(2.5, 4))
	if not alive(visitor) or states[plot.index] ~= state then
		finish()
		return
	end

	local price = VisitorService.onPurchase and VisitorService.onPurchase(owner, slot, name, vip)
	if price then
		local line = vip and "¡Una joya para mi colección! 👑" or pick(Config.BuyerLines)
		model:SetAttribute("Reaction", line .. "\n💰 " .. price)
		play(visitor, "cheer")
	else
		model:SetAttribute("Reaction", "Oh... ya no está 😢")
		play(visitor, "wave")
	end
	state.reserved[slot] = nil
	task.wait(2.6)

	walkRoute(visitor, plot.exitRoute)
	finish()
end

-- API pública --------------------------------------------------------------------------
function VisitorService.attach(plot, owner)
	loadFriends(owner)
	states[plot.index] = {
		plot = plot,
		owner = owner,
		timer = 0,
		visitors = {},
		reserved = {},
	}
end

function VisitorService.detach(plot)
	local state = states[plot.index]
	states[plot.index] = nil
	if state then
		for visitor in pairs(state.visitors) do
			if visitor.model.Parent then
				visitor.model:Destroy()
			end
		end
		friendsOf[state.owner] = nil
	end
	plot.visitorsFolder:ClearAllChildren()
end

function VisitorService.start()
	RunService.Heartbeat:Connect(function(dt)
		for _, state in pairs(states) do
			local profile = VisitorService.getProfile(state.owner)
			if profile then
				local levels = profile.upgrades
				local count = 0
				for _ in pairs(state.visitors) do
					count += 1
				end
				state.timer += dt
				if count < Config.maxBuyers(levels) and state.timer >= Config.buyerInterval(levels) then
					local options = {}
					for _, slot in ipairs(VisitorService.availableSlots(state.owner)) do
						if not state.reserved[slot] then
							table.insert(options, slot)
						end
					end
					if #options > 0 then
						state.timer = 0
						local slot = pick(options)
						state.reserved[slot] = true
						task.spawn(runVisitor, state, slot)
					else
						state.timer = Config.buyerInterval(levels) * 0.7
					end
				end
			end
		end
	end)
end

return VisitorService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">WorldBuilder</string>
            <string name="Source"><![CDATA[-- Construye el terreno privado de cada jugador: galería y taller conectados,
-- jardín, estanque, fuente, calle y bosque alrededor. Todo por código, sin
-- assets externos. Cada jugador tiene su propio terreno, lejos de los demás.

local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)

local WorldBuilder = {}

local LOT_SPACING = 3000
local FLOOR = 2
local CEILING = 22

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local COLORS = {
	plaster = rgb(250, 242, 230),
	plasterShade = rgb(236, 224, 208),
	trim = rgb(255, 252, 246),
	stone = rgb(196, 186, 172),
	roof = rgb(178, 96, 78),
	roofRidge = rgb(140, 70, 58),
	galleryFloor = rgb(176, 122, 82),
	workshopFloor = rgb(226, 204, 170),
	wainscot = rgb(122, 92, 150),
	galleryAccent = rgb(236, 92, 140),
	workshopAccent = rgb(40, 180, 160),
	wood = rgb(196, 140, 96),
	darkWood = rgb(110, 72, 48),
	gold = rgb(240, 190, 70),
	brass = rgb(214, 170, 90),
	cream = rgb(255, 248, 236),
	glass = rgb(200, 232, 255),
	leaf = rgb(96, 176, 90),
	hedge = rgb(70, 140, 76),
	path = rgb(228, 214, 190),
	asphalt = rgb(70, 72, 82),
}
local RAINBOW = {
	rgb(255, 90, 110),
	rgb(255, 170, 60),
	rgb(255, 225, 80),
	rgb(110, 220, 120),
	rgb(90, 170, 255),
	rgb(180, 120, 255),
}

-- Utilidades ---------------------------------------------------------------------------
local function part(props)
	local p = Instance.new(props.Class or "Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for key, value in pairs(props) do
		if key ~= "Class" and key ~= "Parent" then
			p[key] = value
		end
	end
	p.Parent = props.Parent
	return p
end

local function cylinderUp(cf)
	return cf * CFrame.Angles(0, 0, math.rad(90))
end

local function addLight(parent, class, props)
	local light = Instance.new(class)
	for key, value in pairs(props) do
		light[key] = value
	end
	light.Parent = parent
	return light
end

local function surfaceText(parentPart, face, text, props)
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = props.pps or 40
	gui.LightInfluence = props.lightInfluence or 0
	gui.Parent = parentPart
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = props.font or Enum.Font.FredokaOne
	label.Text = text
	label.TextScaled = true
	label.TextColor3 = props.color or Color3.new(1, 1, 1)
	label.Parent = gui
	local padding = Instance.new("UIPadding")
	padding.PaddingLeft = UDim.new(0.05, 0)
	padding.PaddingRight = UDim.new(0.05, 0)
	padding.PaddingTop = UDim.new(0.12, 0)
	padding.PaddingBottom = UDim.new(0.12, 0)
	padding.Parent = label
	if props.stroke then
		local stroke = Instance.new("UIStroke")
		stroke.Color = props.stroke
		stroke.Thickness = props.strokeThickness or 3
		stroke.Parent = label
	end
	return label
end

local function prompt(parent, action, object, distance)
	local p = Instance.new("ProximityPrompt")
	p.ActionText = action
	p.ObjectText = object
	p.HoldDuration = 0
	p.MaxActivationDistance = distance or 12
	p.RequiresLineOfSight = false
	p.Parent = parent
	return p
end

-- Ambiente global -----------------------------------------------------------------------
local lightingReady = false
local function setupLighting()
	if lightingReady then
		return
	end
	lightingReady = true
	Lighting.ClockTime = 14.8
	Lighting.GeographicLatitude = 30
	Lighting.Brightness = 3
	Lighting.Ambient = rgb(118, 108, 128)
	Lighting.OutdoorAmbient = rgb(150, 145, 165)
	Lighting.EnvironmentDiffuseScale = 1
	Lighting.EnvironmentSpecularScale = 1
	Lighting.GlobalShadows = true
	Lighting.ShadowSoftness = 0.2
	for _, child in ipairs(Lighting:GetChildren()) do
		if child:IsA("PostEffect") or child:IsA("Atmosphere") then
			child:Destroy()
		end
	end
	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Density = 0.3
	atmosphere.Offset = 0.2
	atmosphere.Color = rgb(206, 196, 236)
	atmosphere.Decay = rgb(150, 130, 190)
	atmosphere.Glare = 0.25
	atmosphere.Haze = 1.4
	atmosphere.Parent = Lighting
	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.5
	bloom.Size = 24
	bloom.Threshold = 1.5
	bloom.Parent = Lighting
	local color = Instance.new("ColorCorrectionEffect")
	color.Saturation = 0.16
	color.Contrast = 0.07
	color.Brightness = 0.02
	color.TintColor = rgb(255, 250, 244)
	color.Parent = Lighting
	local rays = Instance.new("SunRaysEffect")
	rays.Intensity = 0.05
	rays.Spread = 0.7
	rays.Parent = Lighting
	local depth = Instance.new("DepthOfFieldEffect")
	depth.FarIntensity = 0.12
	depth.FocusDistance = 120
	depth.InFocusRadius = 140
	depth.NearIntensity = 0
	depth.Parent = Lighting

	local terrain = Workspace.Terrain
	terrain.WaterColor = rgb(80, 170, 200)
	terrain.WaterTransparency = 0.6
	terrain.WaterWaveSize = 0.08
	terrain.WaterReflectance = 0.4
	if not terrain:FindFirstChildOfClass("Clouds") then
		local clouds = Instance.new("Clouds")
		clouds.Cover = 0.55
		clouds.Density = 0.6
		clouds.Color = rgb(255, 250, 255)
		clouds.Parent = terrain
	end
end

-- Elementos reutilizables ------------------------------------------------------------------
local function buildTree(parent, cf, scale, rng, pink)
	local model = Instance.new("Model")
	model.Name = "Tree"
	local trunkHeight = 9 * scale
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(trunkHeight, 1.8 * scale, 1.8 * scale),
		CFrame = cylinderUp(cf * CFrame.new(0, trunkHeight / 2, 0)),
		Color = rgb(112, 76, 56),
		Material = Enum.Material.Wood,
		Parent = model,
	})
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(1.2 * scale, 2.8 * scale, 2.8 * scale),
		CFrame = cylinderUp(cf * CFrame.new(0, 0.5 * scale, 0)),
		Color = rgb(98, 66, 48),
		Material = Enum.Material.Wood,
		Parent = model,
	})
	local base = pink and rgb(255, 172, 204) or COLORS.leaf
	for i = 1, 5 do
		local size = (5.5 + rng:NextNumber() * 3) * scale
		local offset = Vector3.new(
			rng:NextNumber(-2.4, 2.4),
			trunkHeight + rng:NextNumber(-1, 3),
			rng:NextNumber(-2.4, 2.4)
		) * scale
		if i == 1 then
			offset = Vector3.new(0, trunkHeight + 2 * scale, 0)
			size = 8 * scale
		end
		part({
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(size, size, size),
			CFrame = cf * CFrame.new(offset),
			Color = base:Lerp(rgb(255, 255, 255), rng:NextNumber() * 0.15)
				:Lerp(rgb(30, 80, 40), rng:NextNumber() * 0.15),
			Material = Enum.Material.LeafyGrass,
			CanCollide = false,
			Parent = model,
		})
	end
	model.Parent = parent
end

local function buildBush(parent, cf, scale, color)
	for i = 1, 3 do
		local angle = i * 2.1
		local size = (2.6 + i * 0.3) * scale
		part({
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(size, size, size),
			CFrame = cf * CFrame.new(math.cos(angle) * 0.9 * scale, size * 0.35, math.sin(angle) * 0.9 * scale),
			Color = color or COLORS.leaf:Lerp(rgb(30, 90, 40), i * 0.08),
			Material = Enum.Material.LeafyGrass,
			CanCollide = false,
			Parent = parent,
		})
	end
end

local function buildLampPost(parent, cf)
	local dark = rgb(54, 50, 70)
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.8, 2.2, 2.2),
		CFrame = cylinderUp(cf * CFrame.new(0, 0.4, 0)),
		Color = dark,
		Material = Enum.Material.Metal,
		Parent = parent,
	})
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(11, 0.6, 0.6),
		CFrame = cylinderUp(cf * CFrame.new(0, 6, 0)),
		Color = dark,
		Material = Enum.Material.Metal,
		Parent = parent,
	})
	part({
		Size = Vector3.new(1.8, 0.3, 1.8),
		CFrame = cf * CFrame.new(0, 11.6, 0),
		Color = dark,
		Material = Enum.Material.Metal,
		Parent = parent,
	})
	part({
		Size = Vector3.new(1.4, 1.8, 1.4),
		CFrame = cf * CFrame.new(0, 12.7, 0),
		Color = rgb(255, 236, 196),
		Material = Enum.Material.Glass,
		Transparency = 0.25,
		CanCollide = false,
		Parent = parent,
	})
	local bulb = part({
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(0.9, 0.9, 0.9),
		CFrame = cf * CFrame.new(0, 12.7, 0),
		Color = rgb(255, 226, 170),
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = parent,
	})
	part({
		Class = "WedgePart",
		Size = Vector3.new(2, 0.6, 1),
		CFrame = cf * CFrame.new(0, 13.9, -0.5),
		Color = dark,
		Material = Enum.Material.Metal,
		Parent = parent,
	})
	part({
		Class = "WedgePart",
		Size = Vector3.new(2, 0.6, 1),
		CFrame = cf * CFrame.new(0, 13.9, 0.5) * CFrame.Angles(0, math.pi, 0),
		Color = dark,
		Material = Enum.Material.Metal,
		Parent = parent,
	})
	addLight(bulb, "PointLight", { Range = 16, Brightness = 1.2, Color = rgb(255, 214, 160), Shadows = false })
end

local function buildBench(parent, cf)
	local slats = rgb(176, 120, 80)
	local metal = rgb(54, 50, 70)
	for i = 0, 2 do
		part({
			Size = Vector3.new(6, 0.3, 0.6),
			CFrame = cf * CFrame.new(0, 1.9, -0.7 + i * 0.7),
			Color = slats,
			Material = Enum.Material.Wood,
			Parent = parent,
		})
	end
	for i = 0, 1 do
		part({
			Size = Vector3.new(6, 0.5, 0.25),
			CFrame = cf * CFrame.new(0, 2.7 + i * 0.7, 1.05) * CFrame.Angles(math.rad(-10), 0, 0),
			Color = slats,
			Material = Enum.Material.Wood,
			Parent = parent,
		})
	end
	for _, x in ipairs({ -2.6, 2.6 }) do
		part({
			Size = Vector3.new(0.3, 1.8, 2.2),
			CFrame = cf * CFrame.new(x, 0.9, 0),
			Color = metal,
			Material = Enum.Material.Metal,
			Parent = parent,
		})
		part({
			Size = Vector3.new(0.3, 1.6, 0.3),
			CFrame = cf * CFrame.new(x, 2.9, 1.1),
			Color = metal,
			Material = Enum.Material.Metal,
			Parent = parent,
		})
	end
end

local function buildFlowerBed(parent, cf, width, depth, rng)
	part({
		Size = Vector3.new(width + 0.8, 1, depth + 0.8),
		CFrame = cf * CFrame.new(0, 0.5, 0),
		Color = COLORS.stone,
		Material = Enum.Material.Limestone,
		Parent = parent,
	})
	part({
		Size = Vector3.new(width, 0.3, depth),
		CFrame = cf * CFrame.new(0, 1.05, 0),
		Color = rgb(96, 66, 50),
		Material = Enum.Material.Ground,
		Parent = parent,
	})
	local count = math.floor(width * depth / 2.2)
	for _ = 1, count do
		local x = rng:NextNumber(-width / 2 + 0.6, width / 2 - 0.6)
		local z = rng:NextNumber(-depth / 2 + 0.6, depth / 2 - 0.6)
		local h = rng:NextNumber(0.8, 1.6)
		part({
			Size = Vector3.new(0.18, h, 0.18),
			CFrame = cf * CFrame.new(x, 1.2 + h / 2, z),
			Color = rgb(80, 160, 80),
			CanCollide = false,
			CastShadow = false,
			Parent = parent,
		})
		part({
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(0.8, 0.8, 0.8),
			CFrame = cf * CFrame.new(x, 1.3 + h, z),
			Color = RAINBOW[rng:NextInteger(1, #RAINBOW)],
			CanCollide = false,
			CastShadow = false,
			Parent = parent,
		})
	end
end

local function buildPlant(parent, cf, scale)
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(2.6 * scale, 2.6 * scale, 2.6 * scale),
		CFrame = cylinderUp(cf * CFrame.new(0, 1.3 * scale, 0)),
		Color = rgb(226, 132, 100),
		Material = Enum.Material.Plaster,
		Parent = parent,
	})
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.4 * scale, 2.9 * scale, 2.9 * scale),
		CFrame = cylinderUp(cf * CFrame.new(0, 2.6 * scale, 0)),
		Color = rgb(206, 112, 84),
		Material = Enum.Material.Plaster,
		Parent = parent,
	})
	for i = 1, 4 do
		local angle = i * 1.7
		part({
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(2.6, 2.6, 2.6) * scale,
			CFrame = cf
				* CFrame.new(math.cos(angle) * 0.7 * scale, (3.2 + i * 0.7) * scale, math.sin(angle) * 0.7 * scale),
			Color = rgb(80 + i * 12, 172 + i * 8, 96),
			Material = Enum.Material.LeafyGrass,
			CanCollide = false,
			Parent = parent,
		})
	end
end

local function buildFountain(parent, cf)
	local stone = rgb(240, 236, 228)
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(2, 15, 15),
		CFrame = cylinderUp(cf * CFrame.new(0, 1, 0)),
		Color = stone,
		Material = Enum.Material.Marble,
		Parent = parent,
	})
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.3, 13, 13),
		CFrame = cylinderUp(cf * CFrame.new(0, 1.85, 0)),
		Color = rgb(110, 200, 240),
		Material = Enum.Material.Glass,
		Transparency = 0.2,
		CanCollide = false,
		Parent = parent,
	})
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(5, 2.2, 2.2),
		CFrame = cylinderUp(cf * CFrame.new(0, 4, 0)),
		Color = stone,
		Material = Enum.Material.Marble,
		Parent = parent,
	})
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.8, 7, 7),
		CFrame = cylinderUp(cf * CFrame.new(0, 6.6, 0)),
		Color = stone,
		Material = Enum.Material.Marble,
		Parent = parent,
	})
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.25, 6, 6),
		CFrame = cylinderUp(cf * CFrame.new(0, 7, 0)),
		Color = rgb(110, 200, 240),
		Material = Enum.Material.Glass,
		Transparency = 0.2,
		CanCollide = false,
		Parent = parent,
	})
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(2.6, 1.2, 1.2),
		CFrame = cylinderUp(cf * CFrame.new(0, 8.3, 0)),
		Color = stone,
		Material = Enum.Material.Marble,
		Parent = parent,
	})
	local top = part({
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(1.6, 1.6, 1.6),
		CFrame = cf * CFrame.new(0, 10, 0),
		Color = rgb(120, 210, 255),
		Material = Enum.Material.Glass,
		Transparency = 0.2,
		CanCollide = false,
		Parent = parent,
	})
	local water = Instance.new("ParticleEmitter")
	water.Rate = 30
	water.Lifetime = NumberRange.new(0.8, 1.1)
	water.Speed = NumberRange.new(6, 8)
	water.SpreadAngle = Vector2.new(25, 25)
	water.Acceleration = Vector3.new(0, -18, 0)
	water.LightEmission = 0.3
	water.Transparency = NumberSequence.new(0.3, 1)
	water.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 0.15) })
	water.Color = ColorSequence.new(rgb(200, 240, 255), rgb(140, 210, 255))
	water.EmissionDirection = Enum.NormalId.Top
	water.Parent = top
end

-- Cuadro enmarcado de la galería.
local function buildFrame(parent, cf, name)
	local frame = Instance.new("Model")
	frame.Name = name
	part({
		Size = Vector3.new(8.2, 8.2, 0.5),
		CFrame = cf,
		Color = COLORS.gold,
		Material = Enum.Material.Metal,
		Reflectance = 0.08,
		Parent = frame,
	})
	part({
		Size = Vector3.new(7.4, 7.4, 0.2),
		CFrame = cf * CFrame.new(0, 0, -0.3),
		Color = rgb(250, 248, 242),
		Parent = frame,
	})
	local canvas = part({
		Name = "Canvas",
		Size = Vector3.new(6.2, 6.2, 0.2),
		CFrame = cf * CFrame.new(0, 0, -0.42),
		Color = COLORS.cream,
		Parent = frame,
	})
	local plaque = part({
		Name = "Plaque",
		Size = Vector3.new(4.8, 0.9, 0.15),
		CFrame = cf * CFrame.new(0, -4.8, -0.1),
		Color = rgb(44, 38, 58),
		Material = Enum.Material.Metal,
		Parent = frame,
	})
	local plaqueLabel = surfaceText(
		plaque,
		Enum.NormalId.Front,
		"",
		{ pps = 60, color = COLORS.gold, font = Enum.Font.BuilderSansBold }
	)
	plaqueLabel.Name = "PlaqueText"
	part({
		Size = Vector3.new(3.4, 0.25, 0.25),
		CFrame = cf * CFrame.new(0, 4.7, -0.6),
		Color = COLORS.brass,
		Material = Enum.Material.Metal,
		CanCollide = false,
		Parent = frame,
	})
	local lamp = part({
		Size = Vector3.new(3, 0.35, 0.5),
		CFrame = cf * CFrame.new(0, 4.95, -1),
		Color = COLORS.brass,
		Material = Enum.Material.Metal,
		CanCollide = false,
		Parent = frame,
	})
	addLight(
		lamp,
		"SpotLight",
		{ Face = Enum.NormalId.Bottom, Angle = 75, Range = 11, Brightness = 2.4, Color = rgb(255, 238, 214) }
	)
	frame.Parent = parent
	return canvas, plaqueLabel
end

local function buildEasel(parent, cf, scale)
	scale = scale or 1
	local model = Instance.new("Model")
	model.Name = "Easel"
	for _, x in ipairs({ -1.9, 1.9 }) do
		part({
			Size = Vector3.new(0.45, 11, 0.45) * scale,
			CFrame = cf
				* CFrame.new(x * scale, 5.5 * scale, 0)
				* CFrame.Angles(math.rad(-8), 0, math.rad(x > 0 and 8 or -8)),
			Color = COLORS.wood,
			Material = Enum.Material.Wood,
			Parent = model,
		})
	end
	part({
		Size = Vector3.new(0.45, 10, 0.45) * scale,
		CFrame = cf * CFrame.new(0, 5 * scale, 1.6 * scale) * CFrame.Angles(math.rad(14), 0, 0),
		Color = COLORS.wood,
		Material = Enum.Material.Wood,
		Parent = model,
	})
	part({
		Size = Vector3.new(6.4, 0.45, 1) * scale,
		CFrame = cf * CFrame.new(0, 4.2 * scale, -0.55 * scale),
		Color = COLORS.wood,
		Material = Enum.Material.Wood,
		Parent = model,
	})
	part({
		Size = Vector3.new(6.4, 6.4, 0.3) * scale,
		CFrame = cf * CFrame.new(0, 7.75 * scale, -0.3 * scale) * CFrame.Angles(math.rad(-8), 0, 0),
		Color = rgb(236, 226, 206),
		Parent = model,
	})
	local canvas = part({
		Name = "Canvas",
		Size = Vector3.new(6, 6, 0.2) * scale,
		CFrame = cf * CFrame.new(0, 7.75 * scale, -0.5 * scale) * CFrame.Angles(math.rad(-8), 0, 0),
		Color = COLORS.cream,
		Parent = model,
	})
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.2, 2.8, 2.8) * scale,
		CFrame = cf * CFrame.new(3 * scale, 4.6 * scale, -0.8 * scale) * CFrame.Angles(0, math.rad(90), 0),
		Color = rgb(230, 190, 140),
		Material = Enum.Material.Wood,
		Parent = model,
	})
	for i, color in ipairs(RAINBOW) do
		local angle = i * 0.9
		part({
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(0.5, 0.5, 0.5) * scale,
			CFrame = cf * CFrame.new(
				(3 + math.cos(angle) * 0.85) * scale,
				(4.6 + math.sin(angle) * 0.85) * scale,
				-0.95 * scale
			),
			Color = color,
			CanCollide = false,
			Parent = model,
		})
	end
	model.Parent = parent
	return canvas
end

-- Paredes con huecos -------------------------------------------------------------------------
-- openings: { { a, b, y0, y1 } } (a < b sobre el eje de la pared).
local function wall(parent, L, axis, fixed, from, to, y0, y1, thickness, openings, color, material)
	table.sort(openings, function(p, q)
		return p[1] < q[1]
	end)
	local function piece(a, b, ya, yb)
		if b - a < 0.01 or yb - ya < 0.01 then
			return
		end
		local size, cf
		if axis == "x" then
			size = Vector3.new(b - a, yb - ya, thickness)
			cf = L((a + b) / 2, (ya + yb) / 2, fixed)
		else
			size = Vector3.new(thickness, yb - ya, b - a)
			cf = L(fixed, (ya + yb) / 2, (a + b) / 2)
		end
		part({ Size = size, CFrame = cf, Color = color, Material = material or Enum.Material.Plaster, Parent = parent })
	end
	local cursor = from
	for _, o in ipairs(openings) do
		piece(cursor, o[1], y0, y1)
		piece(o[1], o[2], y0, math.max(y0, o[3]))
		piece(o[1], o[2], math.min(y1, o[4]), y1)
		cursor = o[2]
	end
	piece(cursor, to, y0, y1)
end

-- Marco blanco alrededor de una ventana o puerta en una pared paralela a X.
local function trimX(parent, L, z, a, b, y0, y1, depth, withSill)
	local t = 0.7
	part({
		Size = Vector3.new(b - a + t * 2, t, depth),
		CFrame = L((a + b) / 2, y1 + t / 2, z),
		Color = COLORS.trim,
		Parent = parent,
	})
	part({
		Size = Vector3.new(t, y1 - y0, depth),
		CFrame = L(a - t / 2, (y0 + y1) / 2, z),
		Color = COLORS.trim,
		Parent = parent,
	})
	part({
		Size = Vector3.new(t, y1 - y0, depth),
		CFrame = L(b + t / 2, (y0 + y1) / 2, z),
		Color = COLORS.trim,
		Parent = parent,
	})
	if withSill then
		part({
			Size = Vector3.new(b - a + t * 3, 0.5, depth + 0.6),
			CFrame = L((a + b) / 2, y0 - 0.25, z),
			Color = COLORS.trim,
			Parent = parent,
		})
	end
end

local function windowX(parent, L, z, a, b, y0, y1, mullions)
	part({
		Size = Vector3.new(b - a, y1 - y0, 0.3),
		CFrame = L((a + b) / 2, (y0 + y1) / 2, z),
		Color = COLORS.glass,
		Material = Enum.Material.Glass,
		Transparency = 0.55,
		Parent = parent,
	})
	for i = 1, mullions do
		local x = a + (b - a) * i / (mullions + 1)
		part({
			Size = Vector3.new(0.35, y1 - y0, 0.5),
			CFrame = L(x, (y0 + y1) / 2, z),
			Color = COLORS.trim,
			CanCollide = false,
			Parent = parent,
		})
	end
	part({
		Size = Vector3.new(b - a, 0.35, 0.5),
		CFrame = L((a + b) / 2, y0 + (y1 - y0) * 0.62, z),
		Color = COLORS.trim,
		CanCollide = false,
		Parent = parent,
	})
end

-- Decoraciones que aparecen con la mejora "Decoración" ----------------------------------------
