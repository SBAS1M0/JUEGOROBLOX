		pendant(folder, L(-22, CEILING, 25))
		pendant(folder, L(-22, CEILING, 40))
		roomSign(folder, L(-22, CEILING - 2.4, 46.9), "SALA DEL JARDÍN", COLORS.charcoal, rgb(255, 255, 255))
		buildPlant(folder, L(-29.5, FLOOR, 20), 0.9)
		buildPlant(folder, L(-14.5, FLOOR, 20), 0.9)
	end,
	-- 3. Sala de los maestros: paredes verde oscuro, zócalo de madera y lámpara de araña.
	[3] = function(folder, L)
		part({
			Size = Vector3.new(32, FLOOR, 30.5),
			CFrame = L(-55.5, FLOOR / 2, 32.75),
			Color = COLORS.stone,
			Material = Enum.Material.Concrete,
			Parent = folder,
		})
		part({
			Size = Vector3.new(30.6, 0.2, 29.5),
			CFrame = L(-55.2, FLOOR + 0.1, 32.75),
			Color = rgb(150, 104, 70),
			Material = Enum.Material.WoodPlanks,
			Parent = folder,
		})
		local plaster = Enum.Material.SmoothPlastic
		wall(folder, L, "x", 47.5, -71, -40, FLOOR, galleryTop, 1, {}, COLORS.plaster, plaster)
		wall(folder, L, "x", 17.5, -71, -40, FLOOR, galleryTop, 1, {}, COLORS.plaster, plaster)
		wall(folder, L, "z", -70.5, 17, 48, FLOOR, galleryTop, 1, {}, COLORS.plaster, plaster)
		-- Forrado interior verde con zócalo de madera.
		local green = rgb(38, 82, 72)
		local linings = {
			{ Vector3.new(29.6, CEILING - FLOOR - 3, 0.2), L(-55.2, (CEILING + FLOOR + 3) / 2, 46.9) },
			{ Vector3.new(29.6, CEILING - FLOOR - 3, 0.2), L(-55.2, (CEILING + FLOOR + 3) / 2, 18.1) },
			{ Vector3.new(0.2, CEILING - FLOOR - 3, 28.6), L(-69.9, (CEILING + FLOOR + 3) / 2, 32.5) },
		}
		for _, data in ipairs(linings) do
			part({ Size = data[1], CFrame = data[2], Color = green, Material = Enum.Material.Fabric, Parent = folder })
		end
		for _, data in ipairs({
			{ Vector3.new(29.6, 3, 0.3), L(-55.2, FLOOR + 1.5, 46.85) },
			{ Vector3.new(29.6, 3, 0.3), L(-55.2, FLOOR + 1.5, 18.15) },
			{ Vector3.new(0.3, 3, 28.6), L(-69.85, FLOOR + 1.5, 32.5) },
		}) do
			part({
				Size = data[1],
				CFrame = data[2],
				Color = COLORS.darkWood,
				Material = Enum.Material.Wood,
				Parent = folder,
			})
		end
		roomRoof(folder, L, -71, -40, 17.5, 47.5)
		roomExterior(folder, L, {
			{ "x", 47.5, -71, -40, 1 },
			{ "x", 17.5, -71, -40, -1 },
			{ "z", -70.5, 18, 48, -1 },
		}, { size = Vector3.new(8, 1.6, 8), cf = L(-55.5, CEILING + 1.5, 32.5) })
		-- Lámpara de araña dorada.
		local center = L(-55, CEILING, 32)
		part({
			Size = Vector3.new(0.15, 4, 0.15),
			CFrame = center * CFrame.new(0, -2, 0),
			Color = GOLD,
			Material = Enum.Material.Metal,
			CanCollide = false,
			Parent = folder,
		})
		local hub = part({
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(1.4, 1.4, 1.4),
			CFrame = center * CFrame.new(0, -4.4, 0),
			Color = GOLD,
			Material = Enum.Material.Metal,
			CanCollide = false,
			Parent = folder,
		})
		addLight(hub, "PointLight", { Range = 30, Brightness = 1.2, Color = rgb(255, 226, 180) })
		for i = 0, 7 do
			local angle = i / 8 * math.pi * 2
			local offset = Vector3.new(math.cos(angle) * 2.6, -4.6, math.sin(angle) * 2.6)
			part({
				Size = Vector3.new(2.6, 0.14, 0.14),
				CFrame = CFrame.lookAt(
					(center * CFrame.new(offset / 2)).Position,
					(center * CFrame.new(offset)).Position
				) * CFrame.Angles(0, math.pi / 2, 0),
				Color = GOLD,
				Material = Enum.Material.Metal,
				CanCollide = false,
				Parent = folder,
			})
			part({
				Shape = Enum.PartType.Ball,
				Size = Vector3.new(0.6, 0.8, 0.6),
				CFrame = center * CFrame.new(offset + Vector3.new(0, 0.5, 0)),
				Color = rgb(255, 236, 200),
				Material = Enum.Material.Neon,
				CanCollide = false,
				Parent = folder,
			})
		end
		roomSign(
			folder,
			L(-55, CEILING - 2.4, 18.3) * CFrame.Angles(0, math.pi, 0),
			"SALA DE LOS MAESTROS",
			GOLD,
			COLORS.charcoal
		)
		buildPlant(folder, L(-67.5, FLOOR, 44.5), 1)
		buildPlant(folder, L(-67.5, FLOOR, 20.5), 1)
	end,
}

-- Tapia de obra que cierra el paso a la siguiente ampliación.
-- cf: centro del hueco, a ras de suelo, mirando hacia la sala ya abierta.
local function buildHoarding(cf, roomDef)
	local model = Instance.new("Model")
	model.Name = "Expansion" .. roomDef.id
	part({
		Size = Vector3.new(8, 12, 0.6),
		CFrame = cf * CFrame.new(0, 6, 0),
		Color = rgb(214, 182, 132),
		Material = Enum.Material.WoodPlanks,
		Parent = model,
	})
	for i = 0, 7 do
		part({
			Size = Vector3.new(1.2, 0.6, 0.08),
			CFrame = cf * CFrame.new(-3.5 + i, 0.9, -0.34) * CFrame.Angles(0, 0, math.rad(45)),
			Color = i % 2 == 0 and rgb(250, 196, 40) or rgb(40, 40, 44),
			CanCollide = false,
			Parent = model,
		})
	end
	local sign = part({
		Name = "Sign",
		Size = Vector3.new(7, 5.2, 0.2),
		CFrame = cf * CFrame.new(0, 6.4, -0.4),
		Color = rgb(255, 255, 255),
		CanCollide = false,
		Parent = model,
	})
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0
	gui.Parent = sign
	local function line(name, y, h, text, font, color)
		local label = Instance.new("TextLabel")
		label.Name = name
		label.Position = UDim2.fromScale(0.06, y)
		label.Size = UDim2.fromScale(0.88, h)
		label.BackgroundTransparency = 1
		label.Font = font
		label.Text = text
		label.TextScaled = true
		label.TextColor3 = color
		label.Parent = gui
		return label
	end
	line("Icon", 0.05, 0.22, "🏗️", Enum.Font.BuilderSansBold, COLORS.charcoal)
	line("Title", 0.3, 0.16, "PRÓXIMA AMPLIACIÓN", Enum.Font.BuilderSansExtraBold, rgb(198, 124, 10))
	line("Name", 0.47, 0.18, roomDef.name, Enum.Font.FredokaOne, COLORS.charcoal)
	local status = line("Status", 0.7, 0.2, "", Enum.Font.BuilderSansBold, rgb(90, 96, 110))
	local action = prompt(sign, "Ampliar la galería", roomDef.name, 10)
	action.Name = "ExpandPrompt"
	action.HoldDuration = 1
	action.Enabled = false
	return model, action, status
end

-- Abre una sala (la construye) y coloca la tapia de la siguiente.
function WorldBuilder.openRoom(plot, room, animate)
	if plot.openRooms[room] then
		return
	end
	plot.openRooms[room] = true
	if ROOM_BUILDERS[room] then
		local folder = Instance.new("Model")
		folder.Name = "Room" .. room
		ROOM_BUILDERS[room](folder, plot.L)
		folder.Parent = plot.roomsFolder
		if animate then
			fadeIn(folder, nil)
		end
	end
	for index, hoarding in pairs(plot.hoardings) do
		hoarding.model.Parent = (not plot.openRooms[index] and plot.openRooms[index - 1]) and plot.roomsFolder or nil
	end
end

-- Taller -------------------------------------------------------------------------------------
-- Mezclador de colores: varios botes de una rareza se convierten en uno mejor.
local function buildMixer(parent, cf)
	local model = Instance.new("Model")
	model.Name = "Mixer"
	local body = part({
		Name = "Body",
		Size = Vector3.new(4.4, 3.2, 3.4),
		CFrame = cf * CFrame.new(0, 1.6, 0),
		Color = rgb(250, 250, 248),
		Parent = model,
	})
	part({
		Size = Vector3.new(4.42, 0.5, 3.42),
		CFrame = cf * CFrame.new(0, 2.4, 0),
		Color = COLORS.workshopAccent,
		Parent = model,
	})
	part({
		Size = Vector3.new(4.7, 0.3, 3.7),
		CFrame = cf * CFrame.new(0, 3.35, 0),
		Color = COLORS.charcoal,
		Material = Enum.Material.Metal,
		Parent = model,
	})
	local label = part({
		Size = Vector3.new(3.4, 0.9, 0.1),
		CFrame = cf * CFrame.new(0, 1.3, -1.75),
		Color = COLORS.charcoal,
		CanCollide = false,
		Parent = model,
	})
	surfaceText(label, Enum.NormalId.Front, "MEZCLADOR", {
		pps = 50,
		color = rgb(255, 255, 255),
		font = Enum.Font.BuilderSansExtraBold,
	})
	-- Jarra de cristal con la pintura que gira dentro.
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(4.2, 3, 3),
		CFrame = cylinderUp(cf * CFrame.new(0, 5.6, 0)),
		Color = rgb(220, 236, 246),
		Material = Enum.Material.Glass,
		Transparency = 0.6,
		CanCollide = false,
		Parent = model,
	})
	local liquid = part({
		Name = "Liquid",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(2.4, 2.5, 2.5),
		CFrame = cylinderUp(cf * CFrame.new(0, 4.75, 0)),
		Color = rgb(150, 96, 222),
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
		Parent = model,
	})
	addLight(liquid, "PointLight", { Range = 8, Brightness = 0.8, Color = rgb(200, 170, 255) })
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.6, 3.3, 3.3),
		CFrame = cylinderUp(cf * CFrame.new(0, 7.9, 0)),
		Color = COLORS.charcoal,
		Material = Enum.Material.Metal,
		Parent = model,
	})
	part({
		Size = Vector3.new(1.3, 1, 1.3),
		CFrame = cf * CFrame.new(0, 8.7, 0),
		Color = COLORS.workshopAccent,
		Material = Enum.Material.Metal,
		Parent = model,
	})
	part({
		Size = Vector3.new(0.18, 3.6, 0.18),
		CFrame = cf * CFrame.new(0, 6, 0),
		Color = rgb(200, 200, 206),
		Material = Enum.Material.Metal,
		CanCollide = false,
		Parent = model,
	})
	-- Tres botes de entrada sobre la tapa.
	for i, color in ipairs({ rgb(236, 70, 80), rgb(255, 210, 66), rgb(60, 118, 228) }) do
		local x = -1.6 + (i - 1) * 1.6
		part({
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.9, 0.8, 0.8),
			CFrame = cylinderUp(cf * CFrame.new(x, 3.95, -1.3)),
			Color = color,
			Parent = model,
		})
	end
	local mixPrompt = prompt(body, "Mezclar colores", "Mezclador", 10)
	mixPrompt.Name = "MixPrompt"
	model.Parent = parent
	return mixPrompt, liquid
end

local function buildWorkshop(model, L)
	local workshop = Instance.new("Model")
	workshop.Name = "Workshop"

	-- Máquina de colores tipo "gumball" con cúpula de cristal llena de bolas.
	local machine = Instance.new("Model")
	machine.Name = "Machine"
	local mc = L(6, FLOOR, 7) * CFrame.Angles(0, math.rad(20), 0)
	local body = part({
		Name = "Body",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(6, 5.6, 5.6),
		CFrame = cylinderUp(mc * CFrame.new(0, 3, 0)),
		Color = rgb(206, 52, 56),
		Parent = machine,
	})
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.6, 6.4, 6.4),
		CFrame = cylinderUp(mc * CFrame.new(0, 0.3, 0)),
		Color = rgb(60, 50, 80),
		Material = Enum.Material.Metal,
		Parent = machine,
	})
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.8, 6.2, 6.2),
		CFrame = cylinderUp(mc * CFrame.new(0, 6.3, 0)),
		Color = COLORS.gold,
		Material = Enum.Material.Metal,
		Parent = machine,
	})
	local glow = part({
		Name = "Glow",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.35, 5.9, 5.9),
		CFrame = cylinderUp(mc * CFrame.new(0, 4.6, 0)),
		Color = rgb(170, 170, 185),
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = machine,
	})
	local dome = part({
		Name = "Dome",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(7.4, 7.4, 7.4),
		CFrame = mc * CFrame.new(0, 9.6, 0),
		Color = rgb(220, 240, 255),
		Material = Enum.Material.Glass,
		Transparency = 0.62,
		CanCollide = false,
		Parent = machine,
	})
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.8, 2.6, 2.6),
		CFrame = cylinderUp(mc * CFrame.new(0, 13.3, 0)),
		Color = COLORS.gold,
		Material = Enum.Material.Metal,
		Parent = machine,
	})
	part({
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(1.4, 1.4, 1.4),
		CFrame = mc * CFrame.new(0, 14.1, 0),
		Color = rgb(206, 52, 56),
		Parent = machine,
	})
	local balls = {}
	local ballRng = Random.new(7)
	for i = 1, 26 do
		local layer = math.floor((i - 1) / 9)
		local angle = i * 2.4
		local radius = 1 + ballRng:NextNumber() * 1.7
		local ball = part({
			Name = "Ball",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(1.3, 1.3, 1.3),
			CFrame = mc * CFrame.new(math.cos(angle) * radius, 7.3 + layer * 1.15, math.sin(angle) * radius),
			Color = RAINBOW[(i % #RAINBOW) + 1],
			CanCollide = false,
			Parent = machine,
		})
		table.insert(balls, ball)
	end
	-- Ranura, manivela y salida.
	part({
		Size = Vector3.new(2.4, 1.6, 0.6),
		CFrame = mc * CFrame.new(0, 3.6, -2.9),
		Color = rgb(250, 248, 244),
		Material = Enum.Material.Metal,
		Parent = machine,
	})
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.4, 1.6, 1.6),
		CFrame = mc * CFrame.new(0, 3.6, -3.25) * CFrame.Angles(0, math.rad(90), 0),
		Color = COLORS.gold,
		Material = Enum.Material.Metal,
		Parent = machine,
	})
	part({
		Size = Vector3.new(0.3, 1.8, 0.3),
		CFrame = mc * CFrame.new(0, 3.6, -3.45) * CFrame.Angles(0, 0, math.rad(35)),
		Color = COLORS.gold,
		Material = Enum.Material.Metal,
		Parent = machine,
	})
	local dispenser = part({
		Name = "Dispenser",
		Size = Vector3.new(2, 1.4, 1.4),
		CFrame = mc * CFrame.new(0, 1.5, -3),
		Color = rgb(60, 50, 80),
		Material = Enum.Material.Metal,
		Parent = machine,
	})
	local can = part({
		Name = "Can",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(1.3, 1.3, 1.3),
		CFrame = mc * CFrame.new(0, 1.6, -3.5),
		Color = rgb(200, 200, 204),
		Parent = machine,
	})
	local top = part({
		Name = "Top",
		Size = Vector3.new(1, 1, 1),
		CFrame = mc * CFrame.new(0, 16.5, 0),
		Transparency = 1,
		CanCollide = false,
		Parent = machine,
	})
	addLight(glow, "PointLight", { Range = 12, Brightness = 1.2, Color = rgb(255, 255, 255) })
	local machinePrompt = prompt(body, "Tirar color", "Máquina de colores", 12)
	-- Segundo aviso (tecla F) para encender o pausar el Auto-Rolling.
	local autoPrompt = prompt(dispenser, "Activar Auto-Rolling", "Máquina de colores", 12)
	autoPrompt.KeyboardKeyCode = Enum.KeyCode.F
	autoPrompt.GamepadKeyCode = Enum.KeyCode.ButtonY
	autoPrompt.Enabled = false
	machine.Parent = workshop
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.12, 11, 11),
		CFrame = cylinderUp(mc * CFrame.new(0, 0.26, 0)),
		Color = rgb(214, 214, 210),
		Material = Enum.Material.Fabric,
		CanCollide = false,
		Parent = workshop,
	})

	-- Mesa de dibujo: caballete grande, taburete y mesita con pinturas.
	local easelCanvas = buildEasel(workshop, L(23, FLOOR, 6) * CFrame.Angles(0, math.rad(-10), 0), 1.2)
	local drawPart = part({
		Name = "DrawPrompt",
		Size = Vector3.new(4, 4, 2),
		CFrame = L(23, FLOOR + 4, 3.5),
		Transparency = 1,
		CanCollide = false,
		Parent = workshop,
	})
	local drawPrompt = prompt(drawPart, "Pintar un cuadro", "Mesa de dibujo", 12)
	part({
		Size = Vector3.new(14, 0.08, 10),
		CFrame = L(23, FLOOR + 0.25, 4),
		Color = rgb(238, 228, 206),
		Material = Enum.Material.Fabric,
		CanCollide = false,
		Parent = workshop,
	})
	local splatRng = Random.new(3)
	for _ = 1, 14 do
		local d = splatRng:NextNumber(0.6, 1.6)
		part({
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.05, d, d),
			CFrame = cylinderUp(L(23 + splatRng:NextNumber(-6, 6), FLOOR + 0.3, 4 + splatRng:NextNumber(-4.5, 4.5))),
			Color = RAINBOW[splatRng:NextInteger(1, #RAINBOW)],
			CanCollide = false,
			CastShadow = false,
			Parent = workshop,
		})
	end
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.5, 2.8, 2.8),
		CFrame = cylinderUp(L(23, FLOOR + 3, 1)),
		Color = COLORS.workshopAccent,
		Material = Enum.Material.Leather,
		Parent = workshop,
	})
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(2.8, 0.5, 0.5),
		CFrame = cylinderUp(L(23, FLOOR + 1.5, 1)),
		Color = rgb(60, 50, 80),
		Material = Enum.Material.Metal,
		Parent = workshop,
	})
	part({
		Size = Vector3.new(3, 0.3, 3),
		CFrame = L(30, FLOOR + 3.2, 3),
		Color = COLORS.wood,
		Material = Enum.Material.Wood,
		Parent = workshop,
	})
	part({
		Size = Vector3.new(0.3, 3.2, 0.3),
		CFrame = L(30, FLOOR + 1.6, 3),
		Color = COLORS.darkWood,
		Parent = workshop,
	})
	for i = 0, 2 do
		part({
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(1.2, 0.6, 0.6),
			CFrame = cylinderUp(L(29.2 + i * 0.8, FLOOR + 3.9, 2.4)),
			Color = RAINBOW[i * 2 + 1],
			Parent = workshop,
		})
	end

	-- Banco de trabajo contra la pared de ladrillo.
	part({
		Size = Vector3.new(16, 0.6, 4),
		CFrame = L(18, FLOOR + 4, 14.4),
		Color = COLORS.wood,
		Material = Enum.Material.WoodPlanks,
		Parent = workshop,
	})
	for _, x in ipairs({ 10.6, 25.4 }) do
		part({
			Size = Vector3.new(0.6, 4, 3.4),
			CFrame = L(x, FLOOR + 2, 14.4),
			Color = COLORS.darkWood,
			Material = Enum.Material.Wood,
			Parent = workshop,
		})
	end
	for i = 0, 5 do
		local x = 11.5 + i * 2.4
		part({
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(1.6, 1, 1),
			CFrame = cylinderUp(L(x, FLOOR + 5.1, 14.6)),
			Color = rgb(220, 236, 250),
			Material = Enum.Material.Glass,
			Transparency = 0.3,
			Parent = workshop,
		})
		for j = 0, 2 do
			part({
				Size = Vector3.new(0.12, 2.4, 0.12),
				CFrame = L(x - 0.2 + j * 0.2, FLOOR + 5.9, 14.6) * CFrame.Angles(0, 0, math.rad(-8 + j * 8)),
				Color = RAINBOW[(i + j) % #RAINBOW + 1],
				CanCollide = false,
				Parent = workshop,
			})
		end
	end
	for i = 0, 2 do
		part({
			Size = Vector3.new(5 - i * 0.6, 6 - i * 0.6, 0.3),
			CFrame = L(31.5, FLOOR + 3 - i * 0.3, 15.6 - i * 0.5) * CFrame.Angles(math.rad(-8), 0, 0),
			Color = rgb(244, 236, 220),
			Parent = workshop,
		})
	end

	-- Estantes con botes de pintura (muestran tus colores más raros).
	local cans = {}
	for row = 0, 2 do
		part({
			Size = Vector3.new(2.4, 0.4, 16),
			CFrame = L(34, FLOOR + 3 + row * 3.4, -2),
			Color = COLORS.wood,
			Material = Enum.Material.Wood,
			Parent = workshop,
		})
		for i = 0, 7 do
			local shelfCan = part({
				Name = "ShelfCan",
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(1.6, 1.3, 1.3),
				CFrame = cylinderUp(L(34, FLOOR + 3.95 + row * 3.4, -8.2 + i * 1.75)),
				Color = rgb(230, 230, 236),
				Transparency = 0.7,
				Parent = workshop,
			})
			table.insert(cans, shelfCan)
		end
	end
	for _, z in ipairs({ -10.2, 6.2 }) do
		part({
			Size = Vector3.new(2.4, 10.6, 0.4),
			CFrame = L(34, FLOOR + 5.3, z),
			Color = COLORS.darkWood,
			Material = Enum.Material.Wood,
			Parent = workshop,
		})
	end

	-- Lámparas industriales y plantas.
	for _, pos in ipairs({ Vector3.new(6, 0, -4), Vector3.new(22, 0, -4), Vector3.new(14, 0, 8) }) do
		part({
			Size = Vector3.new(0.15, 3.4, 0.15),
			CFrame = L(pos.X, CEILING - 1.7, pos.Z),
			Color = rgb(40, 30, 50),
			CanCollide = false,
			Parent = workshop,
		})
		part({
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(1.6, 3.2, 3.2),
			CFrame = cylinderUp(L(pos.X, CEILING - 4, pos.Z)),
			Color = rgb(52, 60, 70),
			Material = Enum.Material.Metal,
			CanCollide = false,
			Parent = workshop,
		})
		local bulb = part({
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(1.4, 1.4, 1.4),
			CFrame = L(pos.X, CEILING - 4.9, pos.Z),
			Color = rgb(255, 236, 200),
			Material = Enum.Material.Neon,
			CanCollide = false,
			Parent = workshop,
		})
		addLight(bulb, "PointLight", { Range = 24, Brightness = 1.2, Color = rgb(255, 236, 210), Shadows = true })
	end
	buildPlant(workshop, L(-1.5, FLOOR, 14.5), 1)
	buildPlant(workshop, L(32.5, FLOOR, -14.5), 0.9)
	buildPlant(workshop, L(-1.5, FLOOR, -14.5), 0.9)

	local mixPrompt, mixLiquid = buildMixer(workshop, L(0.5, FLOOR, -1) * CFrame.Angles(0, -math.pi / 2, 0))

	workshop.Parent = model
	return {
		model = workshop,
		mixPrompt = mixPrompt,
		mixLiquid = mixLiquid,
		easelCanvas = easelCanvas,
		drawPrompt = drawPrompt,
		machinePrompt = machinePrompt,
		autoPrompt = autoPrompt,
		machineTop = top,
		machineCan = can,
		machineGlow = glow,
		machineBalls = balls,
		machineDome = dome,
		shelfCans = cans,
	}
end

-- Exterior: plaza, camino, jardín, calle y bosque -------------------------------------------------
local function buildGrounds(model, L, origin, rng)
	local grounds = Instance.new("Model")
	grounds.Name = "Grounds"

	-- Plaza de losas grandes frente al edificio y camino hasta la verja.
	part({
		Size = Vector3.new(86, 0.3, 28),
		CFrame = L(-2, 0.15, -34),
		Color = COLORS.path,
		Material = Enum.Material.Pavement,
		Parent = grounds,
	})
	for x = -42, 38, 6 do
		part({
			Size = Vector3.new(0.12, 0.31, 28),
			CFrame = L(x + 3, 0.16, -34),
			Color = rgb(190, 188, 182),
			CanCollide = false,
			CastShadow = false,
			Parent = grounds,
		})
	end
	part({
		Size = Vector3.new(88, 0.32, 1.2),
		CFrame = L(-2, 0.16, -48.4),
		Color = COLORS.stone,
		Material = Enum.Material.Concrete,
		Parent = grounds,
	})
	part({
		Size = Vector3.new(8, 0.3, 56),
		CFrame = L(-22, 0.15, -76),
		Color = COLORS.path,
		Material = Enum.Material.Pavement,
		Parent = grounds,
	})
	buildFountain(grounds, L(8, 0.3, -34))
	for _, pos in ipairs({ { -36, -42 }, { 24, -44 } }) do
		buildBench(grounds, L(pos[1], 0.3, pos[2]) * CFrame.Angles(0, math.pi, 0))
	end

	-- Farolas a lo largo del camino y la plaza.
	for z = -96, -54, 14 do
		buildLampPost(grounds, L(-27.5, 0.3, z))
		buildLampPost(grounds, L(-16.5, 0.3, z))
	end
	for _, x in ipairs({ -43, 39 }) do
		buildLampPost(grounds, L(x, 0.3, -46))
	end

	-- Jardineras y arbustos alrededor de la plaza.
	buildFlowerBed(grounds, L(-38, 0.3, -30), 6, 5, rng)
	buildFlowerBed(grounds, L(30, 0.3, -28), 6, 4, rng)
	for _, pos in ipairs({ { -46, -24 }, { 42, -22 }, { -46, 14 }, { 42, 14 }, { -48, -5 }, { 44, -5 } }) do
		buildBush(grounds, L(pos[1], 0, pos[2]), 1.2)
	end

	-- Seto que rodea el terreno con una verja en el camino.
	local hedgeH = 5
	local half = 104
	local function hedge(axis, fixed, a, b)
		if b - a > 0.5 then
			local center = (a + b) / 2
			local cf = axis == "z" and L(center, hedgeH / 2, fixed) or L(fixed, hedgeH / 2, center)
			local size = axis == "z" and Vector3.new(b - a, hedgeH, 3.5) or Vector3.new(3.5, hedgeH, b - a)
			part({
				Size = size,
				CFrame = cf,
				Color = COLORS.hedge,
				Material = Enum.Material.LeafyGrass,
				Parent = grounds,
			})
		end
	end
	for _, side in ipairs({ { "x", -half }, { "x", half }, { "z", -half }, { "z", half } }) do
		local axis, fixed = side[1], side[2]
		local from = -half
		while from < half do
			local to = math.min(from + 26, half)
			if axis == "z" and fixed == -half and from < -17 and to > -27 then
				hedge(axis, fixed, from, -30)
				hedge(axis, fixed, -14, to)
			else
				hedge(axis, fixed, from, to)
			end
			from = to
		end
	end
	-- Pilares de la verja con faroles y arco con el nombre.
	for _, x in ipairs({ -28.5, -15.5 }) do
		part({
			Size = Vector3.new(2.6, 10, 2.6),
			CFrame = L(x, 5, -half),
			Color = COLORS.stone,
			Material = Enum.Material.Concrete,
			Parent = grounds,
		})
		local lantern = part({
			Size = Vector3.new(2.7, 0.3, 2.7),
			CFrame = L(x, 10.15, -half),
			Color = rgb(255, 236, 206),
			Material = Enum.Material.Neon,
			Parent = grounds,
		})
		addLight(lantern, "PointLight", { Range = 14, Brightness = 0.9, Color = rgb(255, 226, 190) })
	end
	part({
		Size = Vector3.new(15.6, 2, 0.6),
		CFrame = L(-22, 11.3, -half),
		Color = COLORS.charcoal,
		Material = Enum.Material.Metal,
		Parent = grounds,
	})
	local gateSign = part({
		Size = Vector3.new(15, 1.6, 0.2),
		CFrame = L(-22, 11.3, -half - 0.35),
		Color = COLORS.charcoal,
		Material = Enum.Material.Metal,
		Parent = grounds,
	})
	local gateLabel = surfaceText(
		gateSign,
		Enum.NormalId.Front,
		"Galería",
		{ pps = 24, color = rgb(255, 255, 255), font = Enum.Font.BuilderSansBold }
	)

	-- Calle y aceras por donde llegan los visitantes.
	part({
		Size = Vector3.new(420, 0.3, 6),
		CFrame = L(0, 0.15, -110),
		Color = rgb(214, 210, 204),
		Material = Enum.Material.Pavement,
		Parent = grounds,
	})
	part({
		Size = Vector3.new(420, 0.25, 16),
		CFrame = L(0, 0.12, -121),
		Color = COLORS.asphalt,
		Material = Enum.Material.Asphalt,
		Parent = grounds,
	})
	for x = -204, 204, 12 do
		part({
			Size = Vector3.new(5, 0.27, 0.5),
			CFrame = L(x, 0.14, -121),
			Color = rgb(250, 220, 90),
			CanCollide = false,
			Parent = grounds,
		})
	end
	part({
		Size = Vector3.new(420, 0.3, 6),
		CFrame = L(0, 0.15, -132),
		Color = rgb(214, 210, 204),
		Material = Enum.Material.Pavement,
		Parent = grounds,
	})

	-- Estanque con rocas y bancos.
	local terrain = Workspace.Terrain
	local pondCenter = origin + Vector3.new(66, 0, -66)
	terrain:FillCylinder(CFrame.new(pondCenter + Vector3.new(0, -2, 0)), 4, 15, Enum.Material.Air)
	terrain:FillCylinder(CFrame.new(pondCenter + Vector3.new(0, -2.5, 0)), 3, 15, Enum.Material.Water)
	for i = 0, 9 do
		local angle = i / 10 * math.pi * 2
		terrain:FillBall(
			pondCenter + Vector3.new(math.cos(angle) * 16, -0.5, math.sin(angle) * 16),
			rng:NextNumber(2, 3.2),
			Enum.Material.Rock
		)
	end
	buildBench(grounds, CFrame.new(pondCenter + Vector3.new(0, 0, 21)) * CFrame.Angles(0, math.pi, 0))
	buildBench(grounds, CFrame.new(pondCenter + Vector3.new(-21, 0, 0)) * CFrame.Angles(0, -math.pi / 2, 0))
	for i = 1, 3 do
		part({
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.2, 2.6, 2.6),
			CFrame = cylinderUp(CFrame.new(pondCenter + Vector3.new(-6 + i * 4, -0.4, -4 + i * 2.5))),
			Color = rgb(110, 190, 100),
			CanCollide = false,
			Parent = grounds,
		})
	end

	-- Árboles dentro del terreno y bosque alrededor.
	local inside = {
		{ -78, -70 },
		{ -70, -30 },
		{ -85, 10 },
		{ -86, 54 },
		{ -30, 72 },
		{ 10, 80 },
		{ 52, 60 },
		{ 82, 30 },
		{ 88, -10 },
		{ -50, 88 },
		{ 30, -86 },
		{ 75, -95 },
		{ -60, -92 },
	}
	for i, pos in ipairs(inside) do
		buildTree(grounds, L(pos[1], 0, pos[2]), rng:NextNumber(1, 1.4), rng, i % 4 == 0)
	end
	for i = 1, 46 do
		local angle = i / 46 * math.pi * 2
		local radius = rng:NextNumber(118, 175)
		local x, z = math.cos(angle) * radius, math.sin(angle) * radius
		if z > -100 or z < -140 then
			buildTree(grounds, L(x, 0, z), rng:NextNumber(1.2, 1.8), rng, i % 5 == 0)
		end
	end

	grounds.Parent = model
	return gateLabel
end

-- Terreno (césped y colinas) -------------------------------------------------------------------
local function fillTerrain(origin, rng)
	local terrain = Workspace.Terrain
	terrain:FillBlock(CFrame.new(origin + Vector3.new(0, -8, 0)), Vector3.new(440, 16, 440), Enum.Material.Grass)
	for i = 1, 18 do
		local angle = i / 18 * math.pi * 2 + rng:NextNumber(-0.1, 0.1)
		local radius = rng:NextNumber(190, 215)
		local x, z = math.cos(angle) * radius, math.sin(angle) * radius
		-- Sin colinas sobre la calle.
		if z > -70 or z < -175 then
			terrain:FillBall(origin + Vector3.new(x, -10, z), rng:NextNumber(26, 40), Enum.Material.Grass)
		end
	end
end

local function clearTerrain(origin)
	Workspace.Terrain:FillBlock(
		CFrame.new(origin + Vector3.new(0, 10, 0)),
		Vector3.new(500, 80, 500),
		Enum.Material.Air
	)
end

-- API ----------------------------------------------------------------------------------------------
function WorldBuilder.setDecorLevel(plot, level)
	if level < plot.decorBuilt then
		plot.decorFolder:ClearAllChildren()
		plot.decorBuilt = 0
	end
	for i = plot.decorBuilt + 1, math.min(level, #DECOR_BUILDERS) do
		local folder = Instance.new("Folder")
		folder.Name = "Decor" .. i
		DECOR_BUILDERS[i](folder, plot.L)
		folder.Parent = plot.decorFolder
		plot.decorBuilt = i
	end
end

function WorldBuilder.setOwnerName(plot, name)
	plot.signLabel.Text = "Galería de " .. name
	plot.gateLabel.Text = "Galería de " .. name
end

-- Plataforma de aparición: los personajes nacen aquí un instante y el servidor
-- los lleva enseguida a su propio terreno (la pantalla de carga lo tapa).
function WorldBuilder.buildSpawn()
	setupLighting()
	if Workspace:FindFirstChild("Llegada") then
		return
	end
	local folder = Instance.new("Model")
	folder.Name = "Llegada"
	part({
		Name = "Base",
		Size = Vector3.new(60, 2, 60),
		CFrame = CFrame.new(0, 199, 0),
		Color = COLORS.cream,
		Material = Enum.Material.Marble,
		Parent = folder,
	})
	local spawn = part({
		Class = "SpawnLocation",
		Name = "Aparicion",
		Size = Vector3.new(12, 1, 12),
		CFrame = CFrame.new(0, 200.5, 0),
		Color = COLORS.charcoal,
		Neutral = true,
		Duration = 0,
		Parent = folder,
	})
	local decal = spawn:FindFirstChildOfClass("Decal")
	if decal then
		decal:Destroy()
	end
	folder.Parent = Workspace
end

function WorldBuilder.buildLot(slot)
	setupLighting()
	local plotsFolder = Workspace:FindFirstChild("Plots")
	if not plotsFolder then
		plotsFolder = Instance.new("Folder")
		plotsFolder.Name = "Plots"
		plotsFolder.Parent = Workspace
	end

	local origin = Vector3.new(slot * LOT_SPACING, 0, 0)
	local function L(x, y, z)
		return CFrame.new(origin + Vector3.new(x, y, z))
	end
	local rng = Random.new(slot * 7919 + 13)
	fillTerrain(origin, rng)

	local model = Instance.new("Model")
	model.Name = "Lot" .. slot
	model:SetAttribute("Slot", slot)
	model:SetAttribute("OwnerUserId", 0)
	model.WorldPivot = CFrame.new(origin)
	pcall(function()
		model.ModelStreamingMode = Enum.ModelStreamingMode.PersistentPerPlayer
	end)

	local signLabel = buildBuilding(model, L)
	local caja = buildGalleryInterior(model, L)
	local workshop = buildWorkshop(model, L)
	local gateLabel = buildGrounds(model, L, origin, rng)

	-- Sala de exposición: huecos para stands, salas y tapias de ampliación.
	local gallery = Instance.new("Folder")
	gallery.Name = "Gallery"
	gallery.Parent = model
	local standsFolder = Instance.new("Folder")
	standsFolder.Name = "Stands"
	standsFolder.Parent = gallery
	local roomsFolder = Instance.new("Folder")
	roomsFolder.Name = "Rooms"
	roomsFolder.Parent = gallery
	local spotsFolder = Instance.new("Folder")
	spotsFolder.Name = "Spots"
	spotsFolder.Parent = gallery

	local spots = {}
	local standPoints = {}
	for i, def in ipairs(Exhibition.Spots) do
		local base = L(def.x, FLOOR, def.z) * CFrame.Angles(0, math.rad(def.rot), 0)
		-- Pieza invisible con el aviso del stand, a la altura del cuadro.
		local anchor = part({
			Name = "Spot" .. i,
			Size = Vector3.new(1, 1, 1),
			CFrame = base * CFrame.new(0, def.kind == "wall" and 8 or 6.5, def.kind == "wall" and -0.6 or -0.8),
			Transparency = 1,
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
			Parent = spotsFolder,
		})
		anchor:SetAttribute("Index", i)
		anchor:SetAttribute("Room", def.room)
		anchor:SetAttribute("Kind", def.kind)
		local standPrompt = prompt(anchor, "Comprar stand", "", 10)
		standPrompt.Name = "StandPrompt"
		standPrompt.Enabled = false
		-- Dónde se para un visitante para mirar el cuadro.
		local front = base * CFrame.new(0, 0, def.kind == "wall" and -6.5 or -6)
		standPoints[i] = CFrame.lookAt(front.Position, Vector3.new(base.X, FLOOR, base.Z))
		spots[i] = { def = def, base = base, anchor = anchor, prompt = standPrompt, built = nil }
	end

	local hoardings = {}
	local hoardingCFs = {
		[2] = L(-22, FLOOR, 17.5),
		[3] = L(-39.5, FLOOR, 32) * CFrame.Angles(0, -math.pi / 2, 0),
	}
	for index, cf in pairs(hoardingCFs) do
		local hoardingModel, expandPrompt, status = buildHoarding(cf, Exhibition.Rooms[index])
		hoardings[index] = { model = hoardingModel, prompt = expandPrompt, status = status }
	end

	local decor = Instance.new("Folder")
	decor.Name = "Decor"
	decor.Parent = model
	local visitors = Instance.new("Folder")
	visitors.Name = "Visitors"
	visitors.Parent = model

	model.Parent = plotsFolder

	local plot = {
		index = slot,
		slot = slot,
		model = model,
		origin = origin,
		L = L,
		signLabel = signLabel,
		gateLabel = gateLabel,
		spots = spots,
		standPoints = standPoints,
		standsFolder = standsFolder,
		roomsFolder = roomsFolder,
		hoardings = hoardings,
		openRooms = {},
		caja = caja,
		-- Recorrido de los visitantes: de la acera a la galería y de vuelta.
		route = {
			L(-90, 0.3, -110),
			L(-22, 0.3, -110),
			L(-22, 0.3, -80),
			L(-22, 0.3, -50),
			L(-22, 0.3, -26),
			L(-22, FLOOR, -12),
			L(-22, FLOOR, -5),
		},
		-- Desde el centro de la sala principal hasta cada sala.
		roomPaths = {
			[1] = {},
			[2] = { L(-22, FLOOR, 10), L(-22, FLOOR, 22) },
			[3] = { L(-22, FLOOR, 10), L(-22, FLOOR, 22), L(-33, FLOOR, 31), L(-46, FLOOR, 32) },
		},
		hub = L(-22, FLOOR, -5),
		exitRoute = {
			L(-16, FLOOR, -9),
			L(-22, FLOOR, -12),
			L(-22, 0.3, -26),
			L(-22, 0.3, -50),
			L(-22, 0.3, -80),
			L(-22, 0.3, -110),
			L(90, 0.3, -110),
		},
		-- Apareces dentro del taller, entre la máquina y el caballete.
		ownerSpawn = CFrame.lookAt(
			origin + Vector3.new(15, FLOOR + 3.5, -3),
			origin + Vector3.new(15, FLOOR + 3.5, 10)
		),
		decorFolder = decor,
		visitorsFolder = visitors,
		workshop = workshop,
		decorBuilt = 0,
	}
	WorldBuilder.openRoom(plot, 1, false)
	return plot
end

-- Cajero que atiende la caja (mejora «Cajero»).
function WorldBuilder.setCashier(plot, enabled)
	local existing = plot.cashier
	if enabled == (existing ~= nil) then
		return
	end
	if not enabled then
		existing:Destroy()
		plot.cashier = nil
		return
	end
	local ok, npc = pcall(function()
		local description = Instance.new("HumanoidDescription")
		description.HeadColor = rgb(241, 194, 150)
		description.LeftArmColor = rgb(241, 194, 150)
		description.RightArmColor = rgb(241, 194, 150)
		description.TorsoColor = rgb(40, 150, 140)
		description.LeftLegColor = rgb(44, 48, 56)
		description.RightLegColor = rgb(44, 48, 56)
		return Players:CreateHumanoidModelFromDescription(description, Enum.HumanoidRigType.R15)
	end)
	if not ok or not npc then
		return
	end
	npc.Name = "Cajero"
	local humanoid = npc:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.DisplayName = "Cajero"
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	end
	for _, descendant in ipairs(npc:GetDescendants()) do
		if descendant:IsA("BasePart") then
			descendant.Anchored = true
		end
	end
	npc:PivotTo(plot.caja.cashierCF * CFrame.new(0, 3, 0))
	npc:SetAttribute("VisitorName", "Cajero")
	npc.Parent = plot.caja.model
	plot.cashier = npc
end

function WorldBuilder.destroyLot(plot)
	plot.model:Destroy()
	clearTerrain(plot.origin)
end

return WorldBuilder
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
