	end,
}
WorldBuilder.DECOR_LEVELS = #DECOR_BUILDERS

-- Edificio -----------------------------------------------------------------------------------
-- Dos volúmenes modernos: la galería (blanca, con pretil) y el taller (forrado
-- de madera, con un alero oscuro). Grandes cristaleras con perfiles negros.

-- Cristalera con perfiles negros en una pared paralela a X.
local function glazing(parent, L, z, a, b, y0, y1, panes)
	part({
		Size = Vector3.new(b - a, y1 - y0, 0.25),
		CFrame = L((a + b) / 2, (y0 + y1) / 2, z),
		Color = COLORS.glass,
		Material = Enum.Material.Glass,
		Transparency = 0.6,
		Parent = parent,
	})
	local t = 0.3
	for i = 0, panes do
		local x = a + (b - a) * i / panes
		part({
			Size = Vector3.new(t, y1 - y0, 0.45),
			CFrame = L(x, (y0 + y1) / 2, z),
			Color = COLORS.charcoal,
			Material = Enum.Material.Metal,
			CanCollide = false,
			Parent = parent,
		})
	end
	for _, y in ipairs({ y0 + t / 2, y1 - t / 2 }) do
		part({
			Size = Vector3.new(b - a, t, 0.45),
			CFrame = L((a + b) / 2, y, z),
			Color = COLORS.charcoal,
			Material = Enum.Material.Metal,
			CanCollide = false,
			Parent = parent,
		})
	end
end

-- Marco negro alrededor de una puerta en una pared paralela a X.
local function doorFrame(parent, L, z, a, b, y0, y1)
	local t = 0.4
	part({
		Size = Vector3.new(b - a + t * 2, t, 0.6),
		CFrame = L((a + b) / 2, y1 + t / 2, z),
		Color = COLORS.charcoal,
		Material = Enum.Material.Metal,
		Parent = parent,
	})
	for _, x in ipairs({ a - t / 2, b + t / 2 }) do
		part({
			Size = Vector3.new(t, y1 - y0, 0.6),
			CFrame = L(x, (y0 + y1) / 2, z),
			Color = COLORS.charcoal,
			Material = Enum.Material.Metal,
			Parent = parent,
		})
	end
end

-- Revestimiento de listones verticales de madera sobre una pared.
-- axis "x": pared paralela a X en z = fixed; axis "z": paralela a Z en x = fixed.
local function cladding(parent, L, axis, fixed, from, to, y0, y1, openings, outward)
	wall(parent, L, axis, fixed, from, to, y0, y1, 0.3, openings, COLORS.cladding, Enum.Material.Wood)
	local function inOpening(u, y)
		for _, o in ipairs(openings) do
			if u > o[1] - 0.2 and u < o[2] + 0.2 and y > o[3] and y < o[4] then
				return o
			end
		end
		return nil
	end
	local offset = outward * 0.2
	for u = from + 1, to - 1, 1.6 do
		-- Una ranura oscura por listón, cortada por los huecos.
		local segments = {}
		local start = y0
		for _, o in ipairs(openings) do
			if u > o[1] - 0.2 and u < o[2] + 0.2 then
				table.insert(segments, { start, math.max(start, o[3]) })
				start = math.min(y1, o[4])
			end
		end
		table.insert(segments, { start, y1 })
		for _, seg in ipairs(segments) do
			local h = seg[2] - seg[1]
			if h > 0.3 and not inOpening(u, (seg[1] + seg[2]) / 2) then
				local size = axis == "x" and Vector3.new(0.14, h, 0.1) or Vector3.new(0.1, h, 0.14)
				local cf = axis == "x" and L(u, (seg[1] + seg[2]) / 2, fixed + offset)
					or L(fixed + offset, (seg[1] + seg[2]) / 2, u)
				part({
					Size = size,
					CFrame = cf,
					Color = COLORS.claddingDark,
					Material = Enum.Material.Wood,
					CanCollide = false,
					CastShadow = false,
					Parent = parent,
				})
			end
		end
	end
end

local function wallLight(parent, cf)
	part({
		Size = Vector3.new(0.8, 1.6, 0.8),
		CFrame = cf,
		Color = COLORS.charcoal,
		Material = Enum.Material.Metal,
		CanCollide = false,
		Parent = parent,
	})
	local lens = part({
		Size = Vector3.new(0.6, 0.1, 0.6),
		CFrame = cf * CFrame.new(0, -0.85, 0),
		Color = rgb(255, 236, 206),
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = parent,
	})
	addLight(lens, "SpotLight", {
		Face = Enum.NormalId.Bottom,
		Angle = 60,
		Range = 12,
		Brightness = 1.4,
		Color = rgb(255, 228, 196),
	})
end

local function grasses(parent, cf, width, rng)
	for i = 0, math.floor(width / 0.9) do
		local x = -width / 2 + 0.45 + i * 0.9
		for k = 1, 3 do
			local h = rng:NextNumber(1, 2.2)
			part({
				Size = Vector3.new(0.12, h, 0.12),
				CFrame = cf
					* CFrame.new(x + rng:NextNumber(-0.25, 0.25), h / 2, rng:NextNumber(-0.35, 0.35))
					* CFrame.Angles(rng:NextNumber(-0.25, 0.25), 0, rng:NextNumber(-0.3, 0.3)),
				Color = rgb(122, 150, 96):Lerp(rgb(196, 182, 120), (k - 1) * 0.25),
				CanCollide = false,
				CastShadow = false,
				Parent = parent,
			})
		end
	end
end

local function buildBuilding(model, L)
	local building = Instance.new("Model")
	building.Name = "Building"
	local plaster = Enum.Material.SmoothPlastic
	local rng = Random.new(11)

	-- Zócalo de hormigón y suelos.
	part({
		Size = Vector3.new(80, FLOOR, 40),
		CFrame = L(-2, FLOOR / 2, 0),
		Color = COLORS.stone,
		Material = Enum.Material.Concrete,
		Parent = building,
	})
	part({
		Size = Vector3.new(34, 0.2, 34),
		CFrame = L(-22, FLOOR + 0.1, 0),
		Color = COLORS.galleryFloor,
		Material = Enum.Material.WoodPlanks,
		Parent = building,
	})
	part({
		Size = Vector3.new(39, 0.2, 34),
		CFrame = L(15.5, FLOOR + 0.1, 0),
		Color = COLORS.workshopFloor,
		Material = Enum.Material.Concrete,
		Parent = building,
	})

	-- Fachada: cristaleras de la galería, puerta, ventanal y puerta del taller.
	local galleryTop = CEILING + 3
	local frontOpenings = {
		{ -38, -29, FLOOR + 0.5, FLOOR + 16 },
		{ -27, -17, FLOOR, FLOOR + 12 },
		{ -15, -6, FLOOR + 0.5, FLOOR + 16 },
		{ 0, 21, FLOOR + 3, FLOOR + 15 },
		{ 25, 31, FLOOR, FLOOR + 11 },
	}
	wall(building, L, "x", -17.5, -40, -4, FLOOR, galleryTop, 1, {
		frontOpenings[1],
		frontOpenings[2],
		frontOpenings[3],
	}, COLORS.plaster, plaster)
	wall(building, L, "x", -17.5, -4, 36, FLOOR, CEILING, 1, {
		frontOpenings[4],
		frontOpenings[5],
	}, COLORS.plaster, plaster)
	cladding(building, L, "x", -18.15, -4, 36.3, FLOOR, CEILING, { frontOpenings[4], frontOpenings[5] }, -1)
	glazing(building, L, -17.5, -38, -29, FLOOR + 0.5, FLOOR + 16, 3)
	glazing(building, L, -17.5, -15, -6, FLOOR + 0.5, FLOOR + 16, 3)
	glazing(building, L, -17.5, 0, 21, FLOOR + 3, FLOOR + 15, 5)
	doorFrame(building, L, -17.6, -27, -17, FLOOR, FLOOR + 12)
	doorFrame(building, L, -18.4, 25, 31, FLOOR, FLOOR + 11)

	-- Paredes traseras y laterales (la galería sube más: pretil).
	-- Pared del fondo con el arco hacia la ampliación (tapado hasta que se compra).
	wall(
		building,
		L,
		"x",
		17.5,
		-40,
		-4,
		FLOOR,
		galleryTop,
		1,
		{ { -26, -18, FLOOR, FLOOR + 12 } },
		COLORS.plaster,
		plaster
	)
	doorFrame(building, L, 17.5, -26, -18, FLOOR, FLOOR + 12)
	wall(
		building,
		L,
		"x",
		17.5,
		-4,
		36,
		FLOOR,
		CEILING,
		1,
		{ { -2, 10, FLOOR + 6, FLOOR + 14 } },
		COLORS.plaster,
		plaster
	)
	cladding(building, L, "x", 18.15, -4, 36.3, FLOOR, CEILING, { { -2, 10, FLOOR + 6, FLOOR + 14 } }, 1)
	glazing(building, L, 17.5, -2, 10, FLOOR + 6, FLOOR + 14, 2)
	wall(building, L, "z", -39.5, -18, 18, FLOOR, galleryTop, 1, {}, COLORS.plaster, plaster)
	wall(building, L, "z", 35.5, -17, 17, FLOOR, CEILING, 1, {}, COLORS.plaster, plaster)
	cladding(building, L, "z", 36.15, -18.3, 18.3, FLOOR, CEILING, {}, 1)
	-- Tabique galería-taller con paso y pretil de la galería por encima.
	wall(
		building,
		L,
		"z",
		-4.5,
		-17,
		17,
		FLOOR,
		CEILING,
		1,
		{ { -15, -6, FLOOR, FLOOR + 12 } },
		COLORS.plasterShade,
		plaster
	)
	wall(building, L, "z", -4.5, -18, 18, CEILING, galleryTop, 1, {}, COLORS.plaster, plaster)
	-- Albardillas de los pretiles.
	for _, data in ipairs({
		{ Vector3.new(37, 0.4, 1.4), L(-22, galleryTop + 0.2, -17.5) },
		{ Vector3.new(37, 0.4, 1.4), L(-22, galleryTop + 0.2, 17.5) },
		{ Vector3.new(1.4, 0.4, 36.4), L(-39.5, galleryTop + 0.2, 0) },
		{ Vector3.new(1.4, 0.4, 36.4), L(-4.5, galleryTop + 0.2, 0) },
	}) do
		part({ Size = data[1], CFrame = data[2], Color = COLORS.trim, Material = plaster, Parent = building })
	end

	-- Pared de ladrillo pintado del taller (interior).
	wall(
		building,
		L,
		"x",
		16.85,
		-4,
		35,
		FLOOR,
		CEILING,
		0.3,
		{ { -2, 10, FLOOR + 6, FLOOR + 14 } },
		COLORS.brick,
		Enum.Material.Brick
	)

	-- Techos: interior blanco, cubierta gris y alero oscuro del taller.
	part({
		Size = Vector3.new(76, 0.4, 36),
		CFrame = L(-2, CEILING + 0.2, 0),
		Color = rgb(250, 250, 248),
		Material = plaster,
		Parent = building,
	})
	part({
		Size = Vector3.new(34, 0.3, 34),
		CFrame = L(-22, CEILING + 0.55, 0),
		Color = rgb(150, 154, 160),
		Material = Enum.Material.Concrete,
		Parent = building,
	})
	part({
		Size = Vector3.new(43, 0.9, 41),
		CFrame = L(16.5, CEILING + 0.85, -1),
		Color = COLORS.charcoal,
		Material = Enum.Material.Metal,
		Parent = building,
	})
	-- Lucernario sobre el taller.
	part({
		Size = Vector3.new(10, 1.6, 6),
		CFrame = L(16, CEILING + 2, 4),
		Color = COLORS.glass,
		Material = Enum.Material.Glass,
		Transparency = 0.4,
		Parent = building,
	})

	-- Marquesina de la entrada de la galería con el rótulo.
	local canopy = part({
		Size = Vector3.new(16, 0.7, 6),
		CFrame = L(-22, FLOOR + 13.2, -20.5),
		Color = COLORS.charcoal,
		Material = Enum.Material.Metal,
		Parent = building,
	})
	local fascia = part({
		Size = Vector3.new(16, 0.9, 0.2),
		CFrame = L(-22, FLOOR + 13.2, -23.6),
		Color = COLORS.charcoal,
		Material = Enum.Material.Metal,
		Parent = building,
	})
	surfaceText(fascia, Enum.NormalId.Front, "GALERÍA", {
		pps = 40,
		color = rgb(255, 255, 255),
		font = Enum.Font.BuilderSansBold,
	})
	addLight(canopy, "SpotLight", {
		Face = Enum.NormalId.Bottom,
		Angle = 90,
		Range = 14,
		Brightness = 1.2,
		Color = rgb(255, 232, 204),
	})

	-- Rótulo con el nombre del dueño sobre la fachada blanca.
	local ownerSign = part({
		Name = "OwnerSign",
		Size = Vector3.new(32, 3.4, 0.2),
		CFrame = L(-22, CEILING + 0.6, -18.05),
		Color = COLORS.plaster,
		Material = plaster,
		Parent = building,
	})
	local ownerLabel = surfaceText(ownerSign, Enum.NormalId.Front, "Galería", {
		pps = 30,
		color = COLORS.charcoal,
		font = Enum.Font.BuilderSansExtraBold,
	})

	-- Rótulo del taller sobre el ventanal.
	local workshopSign = part({
		Size = Vector3.new(10, 1.8, 0.2),
		CFrame = L(10.5, FLOOR + 17.4, -18.4),
		Color = COLORS.charcoal,
		Material = Enum.Material.Metal,
		Parent = building,
	})
	surfaceText(workshopSign, Enum.NormalId.Front, "TALLER", {
		pps = 34,
		color = rgb(255, 255, 255),
		font = Enum.Font.BuilderSansBold,
	})

	-- Apliques de luz en la fachada.
	for _, x in ipairs({ -39, -16, -5, 23, 33 }) do
		wallLight(building, L(x, FLOOR + 11.5, -18.6))
	end

	-- Rampas de hormigón.
	part({
		Class = "WedgePart",
		Size = Vector3.new(10, FLOOR, 6),
		CFrame = L(-22, FLOOR / 2, -21),
		Color = COLORS.stone,
		Material = Enum.Material.Concrete,
		Parent = building,
	})
	part({
		Class = "WedgePart",
		Size = Vector3.new(6, FLOOR, 5),
		CFrame = L(28, FLOOR / 2, -20.5),
		Color = COLORS.stone,
		Material = Enum.Material.Concrete,
		Parent = building,
	})

	-- Jardinera de hormigón bajo el ventanal del taller.
	part({
		Size = Vector3.new(21, 1.4, 1.8),
		CFrame = L(10.5, FLOOR + 0.7, -19.3),
		Color = COLORS.stone,
		Material = Enum.Material.Concrete,
		Parent = building,
	})
	grasses(building, L(10.5, FLOOR + 1.4, -19.3), 20, rng)

	building.Parent = model
	return ownerLabel
end

-- Interior de la galería ----------------------------------------------------------------------
-- Caja: mostrador donde los visitantes pagan o te hacen una oferta.
local function buildCaja(folder, L)
	local caja = Instance.new("Model")
	caja.Name = "Caja"
	part({
		Name = "Counter",
		Size = Vector3.new(7.4, 3.8, 2.6),
		CFrame = L(-10, FLOOR + 1.9, -13.4),
		Color = COLORS.plaster,
		Material = Enum.Material.SmoothPlastic,
		Parent = caja,
	})
	-- Frente con listones de roble.
	for i = 0, 6 do
		part({
			Size = Vector3.new(0.5, 3.2, 0.12),
			CFrame = L(-13 + i, FLOOR + 1.9, -12.06),
			Color = COLORS.wood,
			Material = Enum.Material.Wood,
			CanCollide = false,
			Parent = caja,
		})
	end
	part({
		Size = Vector3.new(7.8, 0.3, 3),
		CFrame = L(-10, FLOOR + 3.95, -13.4),
		Color = COLORS.darkWood,
		Material = Enum.Material.Wood,
		Parent = caja,
	})
	-- Caja registradora con pantalla hacia el cliente.
	local register = part({
		Name = "Register",
		Size = Vector3.new(2, 0.9, 1.5),
		CFrame = L(-8.4, FLOOR + 4.55, -13.6),
		Color = COLORS.charcoal,
		Material = Enum.Material.Metal,
		Parent = caja,
	})
	part({
		Class = "WedgePart",
		Size = Vector3.new(2, 0.6, 1.2),
		CFrame = L(-8.4, FLOOR + 5.3, -13.75) * CFrame.Angles(0, math.pi, 0),
		Color = COLORS.charcoal,
		Material = Enum.Material.Metal,
		Parent = caja,
	})
	local screen = part({
		Name = "Screen",
		Size = Vector3.new(1.3, 0.7, 0.1),
		CFrame = L(-8.4, FLOOR + 5.9, -13.3) * CFrame.Angles(math.rad(-12), 0, 0),
		Color = rgb(40, 200, 170),
		Material = Enum.Material.Neon,
		Parent = caja,
	})
	local screenLabel = surfaceText(screen, Enum.NormalId.Back, "💵", { pps = 60, color = rgb(20, 40, 40) })
	screenLabel.Name = "ScreenText"
	part({
		Size = Vector3.new(1.8, 0.25, 0.1),
		CFrame = L(-8.4, FLOOR + 4.3, -12.82),
		Color = COLORS.gold,
		Material = Enum.Material.Metal,
		CanCollide = false,
		Parent = caja,
	})
	-- Datáfono y timbre.
	part({
		Size = Vector3.new(0.6, 0.15, 1),
		CFrame = L(-11.6, FLOOR + 4.2, -12.9) * CFrame.Angles(math.rad(-15), 0, 0),
		Color = COLORS.charcoal,
		Parent = caja,
	})
	part({
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(0.7, 0.7, 0.7),
		CFrame = L(-12.8, FLOOR + 4.15, -13.1),
		Color = COLORS.brass,
		Material = Enum.Material.Metal,
		Parent = caja,
	})
	-- Cartel colgante «CAJA».
	local sign = part({
		Name = "CajaSign",
		Size = Vector3.new(5, 1.6, 0.25),
		CFrame = L(-10, FLOOR + 11, -12.6),
		Color = COLORS.charcoal,
		Material = Enum.Material.Metal,
		CanCollide = false,
		Parent = caja,
	})
	surfaceText(sign, Enum.NormalId.Back, "💵 CAJA", {
		pps = 40,
		color = rgb(255, 255, 255),
		font = Enum.Font.BuilderSansExtraBold,
	})
	for _, x in ipairs({ -12, -8 }) do
		part({
			Size = Vector3.new(0.08, CEILING - FLOOR - 11.8, 0.08),
			CFrame = L(x, (CEILING + FLOOR + 11.8) / 2, -12.6),
			Color = COLORS.charcoal,
			CanCollide = false,
			Parent = caja,
		})
	end
	addLight(sign, "SpotLight", {
		Face = Enum.NormalId.Bottom,
		Angle = 80,
		Range = 12,
		Brightness = 1.3,
		Color = rgb(255, 236, 210),
	})
	-- Marcas de la cola en el suelo.
	local queue = {}
	for i = 1, 3 do
		local position = Vector3.new(-10, FLOOR, -9.4 + (i - 1) * 3)
		part({
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.06, 2.2, 2.2),
			CFrame = cylinderUp(L(position.X, FLOOR + 0.24, position.Z)),
			Color = i == 1 and rgb(40, 190, 165) or rgb(200, 204, 210),
			CanCollide = false,
			CastShadow = false,
			Parent = caja,
		})
		local world = L(position.X, position.Y, position.Z)
		queue[i] = CFrame.lookAt(world.Position, world.Position + Vector3.new(0, 0, -1))
	end
	caja.Parent = folder
	local cashier = L(-10, FLOOR, -15.6)
	return {
		model = caja,
		register = register,
		screenLabel = screenLabel,
		queue = queue,
		cashierCF = CFrame.lookAt(cashier.Position, cashier.Position + Vector3.new(0, 0, 1)),
	}
end

local function buildGalleryInterior(model, L)
	local folder = Instance.new("Model")
	folder.Name = "GalleryInterior"

	-- Pasillo central de alfombra y banco de roble junto a la cristalera.
	part({
		Size = Vector3.new(7, 0.1, 16),
		CFrame = L(-22, FLOOR + 0.25, 4),
		Color = rgb(222, 222, 218),
		Material = Enum.Material.Fabric,
		CanCollide = false,
		Parent = folder,
	})
	part({
		Size = Vector3.new(8, 0.5, 2.4),
		CFrame = L(-31, FLOOR + 1.9, -11.5),
		Color = COLORS.wood,
		Material = Enum.Material.Wood,
		Parent = folder,
	})
	for _, x in ipairs({ -34, -28 }) do
		part({
			Size = Vector3.new(0.4, 1.7, 2.2),
			CFrame = L(x, FLOOR + 0.85, -11.5),
			Color = COLORS.charcoal,
			Material = Enum.Material.Metal,
			Parent = folder,
		})
	end

	local caja = buildCaja(folder, L)

	-- Escultura abstracta sobre peana.
	part({
		Size = Vector3.new(3, 3.6, 3),
		CFrame = L(-36, FLOOR + 1.8, -14),
		Color = COLORS.plaster,
		Material = Enum.Material.SmoothPlastic,
		Parent = folder,
	})
	for i, size in ipairs({ 2.2, 1.6, 1.1 }) do
		part({
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(size, size, size),
			CFrame = L(-36 + (i - 2) * 0.25, FLOOR + 3.6 + (i - 0.5) * 1.5, -14),
			Color = i == 2 and COLORS.charcoal or rgb(214, 210, 202),
			Material = i == 2 and Enum.Material.Metal or Enum.Material.Concrete,
			Parent = folder,
		})
	end

	-- Rótulo de la sala sobre el arco del fondo.
	local sign = part({
		Size = Vector3.new(16, 1.8, 0.15),
		CFrame = L(-22, CEILING - 2.4, 16.8),
		Color = COLORS.charcoal,
		Material = Enum.Material.Metal,
		Parent = folder,
	})
	surfaceText(sign, Enum.NormalId.Front, "SALA DE EXPOSICIÓN", {
		pps = 40,
		color = rgb(255, 255, 255),
		font = Enum.Font.BuilderSansBold,
	})

	-- Plantas en las esquinas del fondo.
	buildPlant(folder, L(-36.5, FLOOR, 14.5), 1)
	buildPlant(folder, L(-7.5, FLOOR, 14.5), 1)

	-- Raíles de focos en el techo.
	for _, x in ipairs({ -31, -13 }) do
		part({
			Size = Vector3.new(0.4, 0.3, 30),
			CFrame = L(x, CEILING - 0.2, 0),
			Color = COLORS.charcoal,
			Material = Enum.Material.Metal,
			CanCollide = false,
			Parent = folder,
		})
	end
	for _, pos in ipairs({ Vector3.new(-31, 0, -4), Vector3.new(-13, 0, -4), Vector3.new(-22, 0, 8) }) do
		part({
			Size = Vector3.new(0.12, 3, 0.12),
			CFrame = L(pos.X, CEILING - 1.5, pos.Z),
			Color = COLORS.charcoal,
			CanCollide = false,
			Parent = folder,
		})
		part({
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(1.6, 2.4, 2.4),
			CFrame = cylinderUp(L(pos.X, CEILING - 3.6, pos.Z)),
			Color = COLORS.charcoal,
			Material = Enum.Material.Metal,
			CanCollide = false,
			Parent = folder,
		})
		local bulb = part({
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.1, 2, 2),
			CFrame = cylinderUp(L(pos.X, CEILING - 4.42, pos.Z)),
			Color = rgb(255, 238, 214),
			Material = Enum.Material.Neon,
			CanCollide = false,
			Parent = folder,
		})
		addLight(bulb, "PointLight", { Range = 24, Brightness = 1.1, Color = rgb(255, 232, 206), Shadows = true })
	end
	folder.Parent = model
	return caja
end

-- Stands de la sala de exposición -------------------------------------------------------------
-- Cada hueco puede tener un stand de pared (marco) o de pie, en tres calidades.
-- El cuadro siempre está en una pieza "Canvas" que el cliente dibuja.
local VELVET = rgb(124, 30, 54)
local GOLD = rgb(232, 184, 80)
local GOLD_DARK = rgb(184, 134, 46)
local OAK = rgb(214, 176, 128)
local HIGHLIGHT = rgb(18, 168, 148)

local function canvasPart(parent, cf, size)
	return part({
		Name = "Canvas",
		Size = Vector3.new(size, size, 0.2),
		CFrame = cf,
		Color = COLORS.cream,
		CanCollide = false,
		Parent = parent,
	})
end

local function plaqueOn(parent, cf, size, color, textColor)
	local plaque = part({
		Name = "Plaque",
		Size = size,
		CFrame = cf,
		Color = color,
		Material = color == GOLD and Enum.Material.Metal or Enum.Material.SmoothPlastic,
		CanCollide = false,
		Parent = parent,
	})
	local label = surfaceText(
		plaque,
		Enum.NormalId.Front,
		"",
		{ pps = 60, color = textColor or COLORS.charcoal, font = Enum.Font.BuilderSansBold }
	)
	label.Name = "PlaqueText"
	return label
end

-- Lámpara de cuadro: brazo desde arriba y foco hacia el lienzo. top = centro
-- del borde superior del marco.
local function pictureLamp(parent, top, width, color, brightness)
	part({
		Size = Vector3.new(0.18, 0.18, 1),
		CFrame = top * CFrame.new(0, 0.2, -0.5),
		Color = color,
		Material = Enum.Material.Metal,
		CanCollide = false,
		Parent = parent,
	})
	local lamp = part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(width, 0.42, 0.42),
		CFrame = top * CFrame.new(0, 0.25, -1.1),
		Color = color,
		Material = Enum.Material.Metal,
		CanCollide = false,
		Parent = parent,
	})
	addLight(lamp, "SpotLight", {
		Face = Enum.NormalId.Bottom,
		Angle = 80,
		Range = 12,
		Brightness = brightness or 2.2,
		Color = rgb(255, 240, 220),
	})
end

-- Cordón de terciopelo con dos postes dorados. base = suelo, centro.
local function velvetRope(parent, base, width)
	for _, x in ipairs({ -width / 2, width / 2 }) do
		part({
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(3, 0.3, 0.3),
			CFrame = cylinderUp(base * CFrame.new(x, 1.5, 0)),
			Color = GOLD,
			Material = Enum.Material.Metal,
			CanCollide = false,
			Parent = parent,
		})
		part({
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.2, 1.1, 1.1),
			CFrame = cylinderUp(base * CFrame.new(x, 0.1, 0)),
			Color = GOLD_DARK,
			Material = Enum.Material.Metal,
			CanCollide = false,
			Parent = parent,
		})
		part({
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(0.5, 0.5, 0.5),
			CFrame = base * CFrame.new(x, 3.1, 0),
			Color = GOLD,
			Material = Enum.Material.Metal,
			CanCollide = false,
			Parent = parent,
		})
	end
	-- La cuerda cae un poco en el centro (dos tramos).
	for _, side in ipairs({ -1, 1 }) do
		local a = Vector3.new(side * width / 2, 2.75, 0)
		local b = Vector3.new(0, 2.3, 0)
		local mid = (a + b) / 2
		local length = (a - b).Magnitude
		part({
			Size = Vector3.new(length, 0.18, 0.18),
			CFrame = base * CFrame.new(mid) * CFrame.Angles(0, 0, math.atan2(a.Y - b.Y, a.X - b.X)),
			Color = VELVET,
			Material = Enum.Material.Fabric,
			CanCollide = false,
			Parent = parent,
		})
	end
end

local function easelLegs(parent, base, color)
	for _, x in ipairs({ -1.7, 1.7 }) do
		part({
			Size = Vector3.new(0.38, 9.2, 0.38),
			CFrame = base * CFrame.new(x, 4.6, 0) * CFrame.Angles(math.rad(-7), 0, math.rad(x > 0 and 7 or -7)),
			Color = color,
			Material = Enum.Material.Wood,
			Parent = parent,
		})
	end
	part({
		Size = Vector3.new(0.38, 8.6, 0.38),
		CFrame = base * CFrame.new(0, 4.2, 1.4) * CFrame.Angles(math.rad(14), 0, 0),
		Color = color,
		Material = Enum.Material.Wood,
		CanCollide = false,
		Parent = parent,
	})
end

