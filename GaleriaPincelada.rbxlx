		MaxTextSize = 15,
		Parent = card,
	})
	board.pity = Theme.label({
		Position = UDim2.fromOffset(10, 56),
		Size = UDim2.new(1, -20, 0, 18),
		Text = "",
		Font = Theme.Fonts.Medium,
		TextColor3 = C.InkSoft,
		MaxTextSize = 13,
		Parent = card,
	})
	board.auto = Theme.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 89),
		Size = UDim2.fromOffset(180, 22),
		BackgroundColor3 = C.White,
		BackgroundTransparency = 0.04,
		Text = "",
		Font = Theme.Fonts.Bold,
		TextColor3 = C.MintDark,
		MaxTextSize = 13,
		Visible = false,
		Parent = board.gui,
	})
	Theme.round().Parent = board.auto
	Theme.padding(4, 10).Parent = board.auto
end

-- Aviso grande de color raro.
local function buildPopup()
	refs.popup = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.42),
		Size = UDim2.fromOffset(320, 300),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 30,
		Parent = gui,
	})
	local cardHolder, card = Theme.card({
		Size = UDim2.fromScale(1, 1),
		Radius = 22,
		ShadowOffset = 6,
		ShadowTransparency = 0.8,
		Parent = refs.popup,
	})
	refs.popupHolder = cardHolder
	refs.popupStroke = card:FindFirstChildOfClass("UIStroke")
	refs.popupBand = Theme.new("Frame", {
		Position = UDim2.fromOffset(24, 0),
		Size = UDim2.new(1, -48, 0, 5),
		BackgroundColor3 = C.Gold,
		BorderSizePixel = 0,
		Parent = card,
	}, { Theme.round() })
	refs.popupRarity = Theme.label({
		Position = UDim2.fromOffset(10, 22),
		Size = UDim2.new(1, -20, 0, 34),
		Text = "",
		Font = Theme.Fonts.Heavy,
		TextColor3 = C.Ink,
		MaxTextSize = 28,
		Parent = card,
	})
	refs.popupSwatch = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 86),
		Size = UDim2.fromOffset(120, 120),
		Parent = card,
	}, { Theme.round(), Theme.stroke(C.Border, 1) })
	refs.popupSparkles = {}
	for i = 1, 6 do
		local sparkle = Theme.label({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(28, 28),
			Text = "✦",
			Font = Theme.Fonts.Heavy,
			TextColor3 = C.Gold,
			MaxTextSize = 20,
			Parent = card,
		})
		refs.popupSparkles[i] = sparkle
	end
	refs.popupName = Theme.label({
		Position = UDim2.fromOffset(10, 214),
		Size = UDim2.new(1, -20, 0, 36),
		Text = "",
		Font = Theme.Fonts.Heavy,
		MaxTextSize = 26,
		Parent = card,
	})
	refs.popupMult = Theme.label({
		Position = UDim2.fromOffset(10, 252),
		Size = UDim2.new(1, -20, 0, 22),
		Text = "",
		Font = Theme.Fonts.Medium,
		TextColor3 = C.InkSoft,
		MaxTextSize = 17,
		Parent = card,
	})
end

local popupToken = 0
local function showPopup(colorId, isNew)
	local entry = Colors.ById[colorId]
	local rarity = Colors.rarityOf(entry)
	popupToken += 1
	local token = popupToken
	refs.popupBand.BackgroundColor3 = rarity.color
	refs.popupRarity.TextColor3 = rarity.color:Lerp(C.Ink, 0.25)
	refs.popupRarity.Text = (isNew and "Nuevo · " or "") .. rarity.name
	DesignArt.swatch(refs.popupSwatch, colorId)
	refs.popupName.Text = entry.name
	refs.popupMult.Text = "Multiplica tus cuadros x" .. string.format("%.1f", rarity.mult)
	refs.popup.Visible = true
	Theme.pop(refs.popupHolder, 0.3)
	Theme.playSound("success", 0.7 + rarity.index * 0.1)
	if rarity.index >= 4 then
		app.celebrate()
	end
	task.spawn(function()
		local t0 = os.clock()
		while token == popupToken and refs.popup.Visible do
			local t = os.clock() - t0
			for i, sparkle in ipairs(refs.popupSparkles) do
				local angle = t * 1.6 + i / #refs.popupSparkles * math.pi * 2
				sparkle.Position = UDim2.new(0.5, math.cos(angle) * 92, 0, 146 + math.sin(angle) * 74)
				sparkle.Rotation = t * 120
				sparkle.TextColor3 = rarity.color:Lerp(C.White, (math.sin(t * 5 + i) + 1) * 0.2)
			end
			task.wait()
		end
	end)
	task.delay(rarity.index >= 4 and 3.2 or 2.2, function()
		if token == popupToken then
			refs.popup.Visible = false
		end
	end)
end

-- Colección -------------------------------------------------------------------------------------
local function buildCollection()
	local holderGui = Theme.new("ScreenGui", {
		Name = "Collection",
		ResetOnSpawn = false,
		DisplayOrder = 12,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	collection = Theme.window({
		Name = "Window",
		Parent = holderGui,
		Size = UDim2.fromOffset(880, 600),
		Gradient = "blue",
		Title = "📚 Colección de pinturas",
		Subtitle = "Consíguelas en la máquina del taller. Cuanto más raras, más valen tus cuadros.",
	})
	refs.collectionProgress = Theme.label({
		Position = UDim2.new(1, -330, 0, 14),
		Size = UDim2.fromOffset(250, 24),
		Text = "",
		Font = Theme.Fonts.Heavy,
		TextColor3 = C.White,
		TextXAlignment = Enum.TextXAlignment.Right,
		MaxTextSize = 18,
		Parent = collection.Header,
	})
	refs.collectionList = Theme.new("ScrollingFrame", {
		Position = UDim2.fromOffset(20, 14),
		Size = UDim2.new(1, -40, 1, -28),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = C.InkFaint,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = collection.Body,
	}, {
		Theme.list("v", 8),
		Theme.new("UIPadding", {
			PaddingLeft = UDim.new(0, 4),
			PaddingRight = UDim.new(0, 12),
			PaddingTop = UDim.new(0, 4),
			PaddingBottom = UDim.new(0, 10),
		}),
	})
end

local function colorCell(parent, entry, count, order)
	local known = entry.basic or count > 0 or (knownPaints and knownPaints[entry.id])
	local _, cell = Theme.card({ Size = UDim2.fromOffset(110, 112), Radius = 16, LayoutOrder = order, Parent = parent })
	local swatch = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 10),
		Size = UDim2.fromOffset(56, 56),
		BackgroundColor3 = C.Border,
		Parent = cell,
	}, { Theme.round() })
	if known then
		DesignArt.swatch(swatch, entry.id)
		Theme.stroke(Colors.rarityOf(entry).color, 3).Parent = swatch
	else
		Theme.label({
			Size = UDim2.fromScale(1, 1),
			Text = "?",
			Font = Theme.Fonts.Display,
			TextColor3 = C.InkFaint,
			MaxTextSize = 30,
			Parent = swatch,
		})
	end
	Theme.label({
		Position = UDim2.fromOffset(4, 70),
		Size = UDim2.new(1, -8, 0, 18),
		Text = known and entry.name or "???",
		Font = Theme.Fonts.Bold,
		MaxTextSize = 15,
		Parent = cell,
	})
	Theme.label({
		Position = UDim2.fromOffset(4, 88),
		Size = UDim2.new(1, -8, 0, 16),
		Text = entry.basic and "∞" or ("x" .. count),
		Font = Theme.Fonts.Heavy,
		TextColor3 = count > 0 and C.MintDark or C.InkFaint,
		MaxTextSize = 14,
		Parent = cell,
	})
end

function Machine.refreshCollection()
	if not (collection and collection.Holder.Visible and app.state) then
		return
	end
	local list = refs.collectionList
	for _, child in ipairs(list:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	local chances = Colors.chances(Config.luck(app.state.upgrades))
	local found, total = 0, 0
	for _, entry in ipairs(Colors.List) do
		if not entry.basic then
			total += 1
			if knownPaints and knownPaints[entry.id] then
				found += 1
			end
		end
	end
	refs.collectionProgress.Text = "Descubiertos " .. found .. "/" .. total
	local order = 0
	local sections = {}
	for i = #Colors.Rarities, 1, -1 do
		table.insert(sections, Colors.Rarities[i])
	end
	table.insert(sections, Colors.BASIC_RARITY)
	for _, rarity in ipairs(sections) do
		order += 1
		local header = Theme.new(
			"Frame",
			{ Size = UDim2.new(1, 0, 0, 34), BackgroundTransparency = 1, LayoutOrder = order, Parent = list }
		)
		local chip = Theme.chip({
			Size = UDim2.fromOffset(150, 30),
			Color = rarity.color,
			Text = rarity.name,
			TextColor3 = C.White,
			MaxTextSize = 16,
			Parent = header,
		})
		chip.Position = UDim2.fromOffset(0, 2)
		Theme.label({
			Position = UDim2.fromOffset(160, 4),
			Size = UDim2.new(1, -170, 0, 26),
			Text = rarity.id == "basico" and "Siempre disponibles · x1.0"
				or string.format("Valor x%.1f  ·  %.1f%% por tirada", rarity.mult, chances[rarity.id] * 100),
			Font = Theme.Fonts.Bold,
			TextColor3 = C.InkSoft,
			TextXAlignment = Enum.TextXAlignment.Left,
			MaxTextSize = 17,
			Parent = header,
		})
		order += 1
		local entries = {}
		for _, entry in ipairs(Colors.List) do
			if (rarity.id == "basico" and entry.basic) or entry.rarity == rarity.id then
				table.insert(entries, entry)
			end
		end
		local rows = math.ceil(#entries / 7)
		local grid = Theme.new("Frame", {
			Size = UDim2.new(1, 0, 0, rows * 122),
			BackgroundTransparency = 1,
			LayoutOrder = order,
			Parent = list,
		}, {
			Theme.new("UIGridLayout", {
				CellSize = UDim2.fromOffset(110, 112),
				CellPadding = UDim2.fromOffset(8, 10),
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
		})
		for i, entry in ipairs(entries) do
			colorCell(grid, entry, app.state.paints[entry.id] or 0, i)
		end
	end
end

function Machine.openCollection()
	collection.Open()
	Machine.refreshCollection()
end

-- Tiradas ----------------------------------------------------------------------------------------
local function jiggleBalls()
	local machine = myMachine()
	if not machine then
		return
	end
	for _, ball in ipairs(machine:GetChildren()) do
		if ball.Name == "Ball" and ball:IsA("BasePart") then
			local base = ball.CFrame
			local up = base * CFrame.new(math.random() - 0.5, math.random() * 0.9, math.random() - 0.5)
			Theme.tween(ball, 0.12, { CFrame = up })
			task.delay(0.14, function()
				if ball.Parent then
					Theme.tween(ball, 0.25, { CFrame = base }, Enum.EasingStyle.Bounce)
				end
			end)
		end
	end
end

local function showColor(colorId)
	local entry = Colors.ById[colorId]
	if entry then
		DesignArt.swatch(refs.swatch, colorId)
	end
	local text, color = rarityText(colorId)
	refs.name.Text = entry and entry.name or ""
	refs.rarityLabel.Text = text
	refs.rarityChip.BackgroundColor3 = entry and color or C.PanelSoft
	refs.rarityLabel.TextColor3 = entry and C.White or C.InkSoft
	refs.reelStroke.Color = color
	board.name.Text = entry and entry.name or "Máquina de colores"
	board.rarity.Text = text
	board.rarity.TextColor3 = color
end

local function hideCardLater()
	cardToken += 1
	local token = cardToken
	task.delay(2.2, function()
		if token == cardToken then
			refs.card.Visible = false
		end
	end)
end

function Machine.onRoll(colorId, auto)
	local entry = Colors.ById[colorId]
	if not entry then
		return
	end
	local isNew = knownPaints ~= nil and not knownPaints[colorId]
	if knownPaints then
		knownPaints[colorId] = true
	end
	local rarity = Colors.rarityOf(entry)
	jiggleBalls()
	if auto then
		-- Las tiradas automáticas no interrumpen: solo avisan si sale algo bueno.
		if not spinning then
			showColor(colorId)
		end
		if rarity.index >= 3 or isNew then
			app.notify(
				"🤖 «" .. entry.name .. "» · " .. rarity.name .. " x" .. string.format("%.1f", rarity.mult),
				rarity.index >= 4 and "gold" or "success"
			)
		end
		return
	end
	spinToken += 1
	local token = spinToken
	spinning = true
	cardToken += 1
	refs.card.Visible = true
	Theme.popCard(refs.card, 0.85)
	refs.name.Text = "Girando…"
	refs.rarityLabel.Text = ""
	refs.rarityChip.BackgroundColor3 = C.PanelSoft
	refs.count.Text = ""
	task.spawn(function()
		local options = {}
		for _, option in ipairs(Colors.List) do
			if not option.basic then
				table.insert(options, option.id)
			end
		end
		for i = 1, 12 do
			if token ~= spinToken then
				return
			end
			DesignArt.swatch(refs.swatch, options[math.random(1, #options)])
			if i % 2 == 0 then
				Theme.playSound("click", 1.4 + i * 0.03)
			end
			task.wait(0.03 + i * 0.009)
		end
		if token ~= spinToken then
			return
		end
		spinning = false
		showColor(colorId)
		Theme.pop(refs.swatch, 0.5)
		if app.state then
			refs.count.Text = "Tienes x" .. (app.state.paints[colorId] or 0)
		end
		if rarity.index >= 3 or isNew then
			showPopup(colorId, isNew)
		else
			Theme.playSound("success", 1.3)
		end
		hideCardLater()
	end)
end

function Machine.applyState(state)
	knownPaints = table.clone(state.discovered or {})
	if not spinning then
		showColor(state.lastRoll)
	end
	local left = (state.pityMax or 0) - (state.pity or 0)
	board.pity.Text = left <= 1 and "🎯 ¡La próxima es Raro o mejor!"
		or ("🎯 Raro o mejor seguro en " .. left .. " tiradas")
	board.auto.Visible = state.autoUnlocked == true
	board.auto.Text = state.autoRoll and "Auto-Rolling activo  [F]" or "Auto-Rolling en pausa  [F]"
	board.auto.TextColor3 = state.autoRoll and C.MintDark or C.InkSoft
	Machine.refreshCollection()
end

function Machine.init(appRef)
	app = appRef
	gui = Theme.new("ScreenGui", {
		Name = "MachineHud",
		ResetOnSpawn = false,
		DisplayOrder = 3,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	buildResultCard()
	buildBoard()
	buildPopup()
	buildCollection()

	-- Coloca el cartel sobre tu máquina cuando aparece tu terreno.
	task.spawn(function()
		while true do
			task.wait(0.25)
			if app.state and not board.gui.Adornee then
				local machine = myMachine()
				local top = machine and machine:FindFirstChild("Top")
				board.gui.Adornee = top
				board.gui.Enabled = top ~= nil
			elseif board.gui.Adornee and not board.gui.Adornee.Parent then
				board.gui.Adornee = nil
				board.gui.Enabled = false
			end
		end
	end)

	local cardScale = Theme.new("UIScale", { Name = "ViewportScale", Parent = refs.card })
	local popupScale = Theme.new("UIScale", { Name = "ViewportScale", Parent = refs.popup })
	local function updateScale()
		local camera = Workspace.CurrentCamera
		if camera then
			local viewport = camera.ViewportSize
			cardScale.Scale = math.clamp(math.min(viewport.X / 1280, viewport.Y / 720), 0.6, 1)
			popupScale.Scale = math.clamp(viewport.Y / 720, 0.6, 1)
		end
	end
	updateScale()
	if Workspace.CurrentCamera then
		Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
	end
end

function Machine.setVisible(visible)
	gui.Enabled = visible
end

return Machine
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="27">
            <Properties>
              <string name="Name">Painter</string>
              <string name="Source"><![CDATA[-- Estudio de pintura: el dibujo aparece como un boceto con los colores en tono
-- pálido y lo coloreas pasando el pincel. La pintura se queda justo donde
-- pasas (recortada a cada figura) y, cuando cubres casi toda una figura, esta
-- se completa con su color final. Cuanto más rápido terminas, más estrellas.

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Colors = require(Shared.Colors)
local Config = require(Shared.Config)
local Designs = require(Shared.Designs)

local Theme = require(script.Parent.Theme)
local DesignArt = require(script.Parent.DesignArt)

local Painter = {}

local C = Theme.Colors
local COMPLETE_AT = 0.9 -- fracción de la figura cubierta para completarla
local DAB_SPACING = 0.5 -- distancia entre pinceladas (en radios)
local MAX_DABS = 380 -- pinceladas por figura (la pintura sigue contando después)

local app
local gui, canvasFrame, overlay, catcher, cursor, cursorIcon
local refs = {}
local current
local stroking = false
local pointer = nil
local lastBrush = nil
local tool = "brush"
local soundClock = 0
local confirmCancelUntil = 0
local finishing = false

-- Utilidades ----------------------------------------------------------------------------------
local function levels()
	return app.state and app.state.upgrades or {}
end

local function canvasPoint(position)
	local absPos = canvasFrame.AbsolutePosition
	local absSize = canvasFrame.AbsoluteSize
	if absSize.X <= 0 then
		return nil
	end
	return (position.X - absPos.X) / absSize.X, (position.Y - absPos.Y) / absSize.Y
end

-- Puntos de muestra de cada figura (solo donde la figura se ve): la figura se
-- completa cuando el pincel ha pasado cerca de casi todos.
local function buildSamples(design, radius)
	local spacing = radius * 1.2
	local list = {}
	for i, shape in ipairs(design.shapes) do
		local info = {
			points = {},
			painted = 0,
			total = 0,
			complete = false,
			dabs = 0,
			cx = shape.x,
			cy = shape.y,
			bound = 0.5 * math.sqrt(shape.w * shape.w + shape.h * shape.h),
		}
		if shape.visible > 0 then
			local nx = math.clamp(math.ceil(shape.w / spacing), 2, 40)
			local ny = math.clamp(math.ceil(shape.h / spacing), 2, 40)
			local rad = math.rad(shape.rot)
			local c, s = math.cos(rad), math.sin(rad)
			for gx = 1, nx do
				for gy = 1, ny do
					local lx = ((gx - 0.5) / nx - 0.5) * shape.w
					local ly = ((gy - 0.5) / ny - 0.5) * shape.h
					local x = shape.x + lx * c - ly * s
					local y = shape.y + lx * s + ly * c
					if x >= 0 and x <= 1 and y >= 0 and y <= 1 and Designs.shapeAt(design, x, y) == i then
						table.insert(info.points, { x, y, false })
					end
				end
			end
			if #info.points == 0 then
				-- Figura diminuta: basta con pasar por su centro.
				table.insert(info.points, { shape.x, shape.y, false })
			end
		end
		info.total = #info.points
		list[i] = info
	end
	return list
end

local function areaPercent(areaId)
	local total, done = 0, 0
	for i, shape in ipairs(current.design.shapes) do
		if shape.area == areaId and shape.visible > 0 then
			local info = current.samples[i]
			local p = info.complete and 1 or info.painted / math.max(info.total, 1)
			total += shape.visible
			done += shape.visible * p
		end
	end
	return total > 0 and done / total or 1
end

local function totalPercent()
	local total, done = 0, 0
	for i, shape in ipairs(current.design.shapes) do
		if shape.visible > 0 then
			local info = current.samples[i]
			local p = info.complete and 1 or info.painted / math.max(info.total, 1)
			total += shape.visible
			done += shape.visible * p
		end
	end
	return total > 0 and done / total or 1
end

local function isComplete()
	for _, info in ipairs(current.samples) do
		if not info.complete then
			return false
		end
	end
	return true
end

local function elapsed()
	return os.clock() - current.started
end

local function refreshLabels()
	for areaId, slot in pairs(current.slots) do
		local p = areaPercent(areaId)
		slot.bar.Set(p)
		slot.check.Visible = p >= 0.999
	end
	local total = totalPercent()
	refs.percent.Text = math.floor(total * 100) .. "%"
	refs.progress.Set(total)
end

local function refreshTimer()
	if not current or current.done then
		return
	end
	local par = Config.parTime(current.design, levels())
	local t = elapsed()
	local stars = Config.starsFor(current.design, levels(), t)
	for i, star in ipairs(refs.stars) do
		star.TextColor3 = i <= stars and C.Gold or C.Border
	end
	refs.timerBar.Set(1 - math.clamp(t / (par * 2.5), 0, 1))
	refs.timerBar.SetGradient(stars >= 3 and "gold" or (stars == 2 and "orange" or "red"))
	refs.timerText.Text = string.format("%d:%02d", math.floor(t / 60), math.floor(t % 60))
end

local function spawnParticle(x, y, color, burst)
	local dot = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(x, y),
		Size = UDim2.fromScale(0.022, 0.022),
		BackgroundColor3 = color,
		ZIndex = 6,
		Parent = overlay,
	}, { Theme.round(), Theme.stroke(C.White, 1.5, 0.3) })
	local angle = math.random() * math.pi * 2
	local distance = (burst and 0.1 or 0.04) * (0.4 + math.random())
	Theme.tween(dot, 0.5, {
		Position = UDim2.fromScale(x + math.cos(angle) * distance, y + math.sin(angle) * distance),
		Size = UDim2.fromScale(0.004, 0.004),
		BackgroundTransparency = 1,
	})
	task.delay(0.55, function()
		dot:Destroy()
	end)
end

local function areaColor(shapeIndex)
	local shape = current.design.shapes[shapeIndex]
	return Colors.mainColor(current.colors[shape.area])
end

-- Pintar ---------------------------------------------------------------------------------------
local completeIfDone

local function completeShape(i, animate)
	local info = current.samples[i]
	if info.complete then
		return
	end
	info.complete = true
	current.art.complete(i, animate)
	if animate then
		local shape = current.design.shapes[i]
		for _ = 1, 6 do
			spawnParticle(shape.x, shape.y, areaColor(i), true)
		end
		Theme.playSound("success", 1.5 + math.random() * 0.3)
	end
	refreshLabels()
	completeIfDone()
end

-- Una pincelada en (x, y): pinta los puntos cercanos y deja la marca.
local function paintAt(x, y)
	local radius = current.radius
	local r2 = radius * radius
	local reach = radius * 1.25
	local reach2 = reach * reach
	local dabGap2 = (radius * DAB_SPACING) ^ 2
	local paintedAny = false
	for i, info in ipairs(current.samples) do
		if not info.complete and info.total > 0 then
			local dx, dy = x - info.cx, y - info.cy
			local limit = info.bound + reach
			if dx * dx + dy * dy <= limit * limit then
				local near, newly = false, 0
				for _, point in ipairs(info.points) do
					local px, py = point[1] - x, point[2] - y
					local d2 = px * px + py * py
					if d2 <= reach2 then
						near = true
						if d2 <= r2 and not point[3] then
							point[3] = true
							newly += 1
						end
					end
				end
				if near and info.dabs < MAX_DABS then
					local lx, ly = info.dabX, info.dabY
					if not lx or (lx - x) ^ 2 + (ly - y) ^ 2 >= dabGap2 then
						current.art.addDab(i, x, y, radius * 1.12)
						info.dabX, info.dabY = x, y
						info.dabs += 1
					end
				end
				if newly > 0 then
					paintedAny = true
					current.lastProgress = os.clock()
					info.painted += newly
					if info.painted / info.total >= COMPLETE_AT then
						completeShape(i, true)
					end
				end
			end
		end
	end
	return paintedAny
end

-- Pinta a lo largo del trazo para que los movimientos rápidos no dejen huecos.
local function strokeTo(x, y)
	local step = current.radius * DAB_SPACING
	local fromX, fromY = x, y
	if lastBrush then
		fromX, fromY = lastBrush[1], lastBrush[2]
	end
	local distance = math.sqrt((x - fromX) ^ 2 + (y - fromY) ^ 2)
	local steps = math.clamp(math.ceil(distance / step), 1, 60)
	local painted = false
	for k = 1, steps do
		local t = k / steps
		if paintAt(fromX + (x - fromX) * t, fromY + (y - fromY) * t) then
			painted = true
		end
	end
	lastBrush = { x, y }
	return painted
end

local function bucket(x, y)
	local index = Designs.shapeAt(current.design, x, y)
	local info = index and current.samples[index]
	if not info or info.complete then
		return
	end
	current.art.flood(index, x, y, 0.3)
	info.painted = info.total
	Theme.playSound("whoosh", 1.3)
	for _ = 1, 8 do
		spawnParticle(x, y, areaColor(index), true)
	end
	task.delay(0.28, function()
		if current and current.samples[index] == info then
			completeShape(index, true)
		end
	end)
end

function completeIfDone()
	if not current.done and isComplete() then
		current.done = true
		current.finishedAt = elapsed()
		stroking = false
		refreshLabels()
		task.delay(0.6, function()
			if current and current.done then
				Painter.showComplete()
			end
		end)
	end
end

local function updateCursor()
	if not pointer or not current or current.done then
		cursor.Visible = false
		return
	end
	local x, y = canvasPoint(pointer)
	if not x or x < 0 or y < 0 or x > 1 or y > 1 then
		cursor.Visible = false
		for _, slot in pairs(current.slots) do
			slot.stroke.Color = C.Border
		end
		return
	end
	local radius = tool == "bucket" and 0.03 or current.radius
	cursor.Visible = true
	cursor.Position = UDim2.fromScale(x, y)
	cursor.Size = UDim2.fromScale(radius * 2, radius * 2)
	cursorIcon.Text = tool == "bucket" and "🪣" or "🖌️"
	local index = Designs.shapeAt(current.design, x, y)
	local color = index and areaColor(index) or C.InkSoft
	cursor.BackgroundColor3 = color
	refs.cursorStroke.Color = color:Lerp(Color3.new(0, 0, 0), 0.3)
	local areaId = index and current.design.shapes[index].area
	for id, slot in pairs(current.slots) do
		slot.stroke.Color = id == areaId and C.Primary or C.Border
		slot.stroke.Thickness = id == areaId and 3 or 1.5
	end
end

-- Pistas: si llevas un rato sin avanzar, las figuras sin pintar laten; al
-- tocar un bote de la bandeja laten las de esa zona.
local function updateHints()
	local now = os.clock()
	local idle = not current.done and now - (current.lastProgress or now) > 2.5
	local areaHint = current.hintArea and now < (current.hintUntil or 0) and current.hintArea or nil
	if not idle and not areaHint then
		if current.hinting then
			current.hinting = false
			for i in ipairs(current.samples) do
				current.art.setHint(i, 0)
			end
		end
		return
	end
	current.hinting = true
	local alpha = 0.5 + 0.5 * math.sin(now * 6)
	for i, info in ipairs(current.samples) do
		local shape = current.design.shapes[i]
		local show = not info.complete and (areaHint == nil or shape.area == areaHint)
		current.art.setHint(i, show and alpha or 0)
	end
end

local function onStep(dt)
	if not current then
		return
	end
	updateCursor()
	updateHints()
	current.timerClock = (current.timerClock or 0) + dt
	if current.timerClock > 0.2 then
		current.timerClock = 0
		refreshTimer()
	end
	if stroking and pointer and not current.done and tool == "brush" then
		local x, y = canvasPoint(pointer)
		if x and x >= -0.1 and y >= -0.1 and x <= 1.1 and y <= 1.1 then
			if strokeTo(x, y) then
				current.labelClock = (current.labelClock or 0) + dt
				if current.labelClock > 0.1 then
					current.labelClock = 0
					refreshLabels()
				end
				soundClock += dt
				if soundClock > 0.16 then
					soundClock = 0
					Theme.playSound("paint", 0.9 + math.random() * 0.3)
				end
			end
		else
			lastBrush = nil
		end
	end
end

-- Interfaz ---------------------------------------------------------------------------------------
local function setTool(name)
	tool = name
	refs.brushButton.SetVariant(name == "brush" and "primary" or "ghost")
	refs.bucketButton.SetVariant(name == "bucket" and "primary" or "ghost")
end

local function buildTopBar(parent)
	refs.exit = Theme.button({
		Position = UDim2.fromOffset(16, 12),
		Size = UDim2.fromOffset(118, 42),
		Text = "✕ Salir",
		Variant = "ghost",
		TextColor = C.InkSoft,
		MaxTextSize = 18,
		Parent = parent,
		OnClick = function()
			Painter.requestCancel()
		end,
	})
	refs.title = Theme.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 6),
		Size = UDim2.new(0.5, 0, 0, 34),
		Text = "",
		Font = Theme.Fonts.Heavy,
		MaxTextSize = 26,
		Parent = parent,
	})
	local row = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 44),
		Size = UDim2.fromOffset(300, 18),
		BackgroundTransparency = 1,
		Parent = parent,
	})
	refs.progress = Theme.progress({
		Position = UDim2.fromOffset(0, 4),
		Size = UDim2.new(1, -56, 0, 8),
		Gradient = "primary",
		Parent = row,
	})
	refs.percent = Theme.label({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.fromOffset(48, 18),
		Text = "0%",
		Font = Theme.Fonts.Bold,
		TextColor3 = C.InkSoft,
		TextXAlignment = Enum.TextXAlignment.Right,
		MaxTextSize = 16,
		Parent = row,
	})

	-- Estrellas y cronómetro.
	local holder, body = Theme.card({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 12),
		Size = UDim2.fromOffset(176, 44),
		Radius = 14,
		Parent = parent,
	})
	refs.timerCard = holder
	refs.stars = {}
	for i = 1, 3 do
		refs.stars[i] = Theme.label({
			Position = UDim2.fromOffset(12 + (i - 1) * 24, 6),
			Size = UDim2.fromOffset(24, 26),
			Text = "★",
			Font = Theme.Fonts.Heavy,
			TextColor3 = C.Gold,
			MaxTextSize = 24,
			Parent = body,
		})
	end
	refs.timerText = Theme.label({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 7),
		Size = UDim2.fromOffset(60, 24),
		Text = "0:00",
		Font = Theme.Fonts.Heavy,
		TextColor3 = C.InkSoft,
		TextXAlignment = Enum.TextXAlignment.Right,
		MaxTextSize = 19,
		Parent = body,
	})
	refs.timerBar = Theme.progress({
		Position = UDim2.new(0, 14, 1, -9),
		Size = UDim2.new(1, -28, 0, 4),
		Gradient = "gold",
		Parent = body,
	})
end

local function buildCanvas(parent)
	local area = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 74),
		Size = UDim2.new(1, -40, 1, -74 - 132),
		BackgroundTransparency = 1,
		Parent = parent,
	})
	-- Lienzo sobre una tarjeta blanca con borde fino.
	local board = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = area,
	}, { Theme.new("UIAspectRatioConstraint", { AspectRatio = 1 }) })
	refs.board = board
	Theme.new("Frame", {
		Position = UDim2.fromOffset(0, 4),
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = C.Shadow,
		BackgroundTransparency = 0.92,
		Parent = board,
	}, { Theme.corner(14) })
	local mat = Theme.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = C.White,
		Parent = board,
	}, { Theme.corner(14), Theme.stroke(C.Border, 1) })
	canvasFrame = Theme.new("Frame", {
		Name = "Canvas",
		Position = UDim2.fromOffset(14, 14),
		Size = UDim2.new(1, -28, 1, -28),
		BackgroundColor3 = C.White,
		ClipsDescendants = true,
		Parent = mat,
	}, { Theme.corner(6) })
	overlay = Theme.new("Frame", {
		Name = "Overlay",
		Position = canvasFrame.Position,
		Size = canvasFrame.Size,
		BackgroundTransparency = 1,
		ZIndex = 8,
		Parent = mat,
	})
	cursor = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromScale(0.1, 0.1),
		BackgroundTransparency = 0.55,
		Visible = false,
		ZIndex = 8,
		Parent = overlay,
	}, { Theme.round() })
	refs.cursorStroke = Theme.stroke(C.Ink, 2.5)
	refs.cursorStroke.Parent = cursor
	cursorIcon = Theme.label({
		Position = UDim2.fromScale(0.75, -0.75),
		Size = UDim2.fromOffset(26, 26),
		Text = "🖌️",
		MaxTextSize = 24,
		ZIndex = 9,
		Parent = cursor,
	})
	catcher = Theme.new("TextButton", {
		Name = "PaintInput",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 10,
		Parent = overlay,
	})
	catcher.InputBegan:Connect(function(input)
		if not current or current.done then
			return
		end
		if
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			pointer = input.Position
			lastBrush = nil
			if tool == "bucket" then
				local x, y = canvasPoint(pointer)
				if x then
					bucket(x, y)
				end
			else
				stroking = true
			end
		end
	end)
end

-- Bandeja inferior con un bote de pintura por área.
local function buildTray(parent)
	local holder, body = Theme.card({
		Name = "Tray",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -14),
		Size = UDim2.fromOffset(500, 108),
		Radius = 16,
		Parent = parent,
	})
	refs.tray = holder
	refs.slots = Theme.new("Frame", {
		Position = UDim2.fromOffset(10, 8),
		Size = UDim2.new(1, -20, 1, -16),
		BackgroundTransparency = 1,
		Parent = body,
	}, { Theme.list("h", 8, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center) })
	refs.tools = Theme.new("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(52, 92),
		BackgroundTransparency = 1,
		Parent = body,
	}, { Theme.list("v", 8, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center) })
	refs.brushButton = Theme.button({
		Size = UDim2.fromOffset(48, 42),
		Text = "🖌️",
		LayoutOrder = 1,
		Radius = 14,
		MaxTextSize = 22,
		Parent = refs.tools,
		OnClick = function()
			setTool("brush")
		end,
	})
	refs.bucketButton = Theme.button({
		Size = UDim2.fromOffset(48, 42),
		Text = "🪣",
		Variant = "ghost",
		LayoutOrder = 2,
		Radius = 14,
		MaxTextSize = 22,
		Parent = refs.tools,
		OnClick = function()
			setTool("bucket")
		end,
	})
end

local function fillTray(design, colors)
	for _, child in ipairs(refs.slots:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	current.slots = {}
	for i, areaDef in ipairs(design.areas) do
		local slotHolder, slot = Theme.card({
			Size = UDim2.fromOffset(84, 90),
			Radius = 18,
			Color = C.PanelSoft,
			LayoutOrder = i,
			Parent = refs.slots,
		})
		slotHolder:FindFirstChild("Shadow").Visible = false
		local swatch = Theme.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0, 8),
			Size = UDim2.fromOffset(42, 42),
			Parent = slot,
		}, { Theme.round(), Theme.stroke(C.Border, 1) })
		DesignArt.swatch(swatch, colors[areaDef.id])
		local check = Theme.label({
			Size = UDim2.fromScale(1, 1),
			Text = "✔",
			Font = Theme.Fonts.Heavy,
			BackgroundColor3 = C.Mint,
			BackgroundTransparency = 0,
			TextColor3 = C.White,
			MaxTextSize = 20,
			Visible = false,
			Parent = swatch,
		})
		Theme.round().Parent = check
		Theme.label({
			Position = UDim2.fromOffset(4, 54),
			Size = UDim2.new(1, -8, 0, 16),
			Text = areaDef.name,
			Font = Theme.Fonts.Bold,
			TextColor3 = C.Ink,
			MaxTextSize = 14,
			Parent = slot,
		})
		local bar = Theme.progress({
			Position = UDim2.new(0, 10, 0, 74),
			Size = UDim2.new(1, -20, 0, 6),
			Gradient = "mint",
			Parent = slot,
		})
		local pick = Theme.new("TextButton", {
			Name = "Locate",
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Text = "",
			ZIndex = 4,
			Parent = slot,
		})
		pick.Activated:Connect(function()
			if current then
				Theme.playSound("click", 1.2)
				current.hintArea = areaDef.id
				current.hintUntil = os.clock() + 1.8
			end
		end)
		current.slots[areaDef.id] = { bar = bar, check = check, stroke = slot:FindFirstChildOfClass("UIStroke") }
	end
	local hasBucket = Config.hasBucket(levels())
	refs.tools.Visible = hasBucket
	refs.slots.Size = UDim2.new(1, hasBucket and -86 or -20, 1, -16)
	local width = 20 + #design.areas * 92 - 8 + (hasBucket and 66 or 0)
	refs.tray.Size = UDim2.fromOffset(math.max(width, 200), 108)
end

-- Ventana de cuadro terminado.
local function buildComplete()
	refs.done = Theme.new("Frame", {
		Position = UDim2.fromOffset(0, -80),
		Size = UDim2.new(1, 0, 1, 80),
		BackgroundColor3 = C.Shadow,
		BackgroundTransparency = 0.45,
		Visible = false,
		ZIndex = 20,
		Parent = gui,
	})
	local wrapper = Theme.new("Frame", {
		Name = "Wrapper",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 40),
		Size = UDim2.fromOffset(460, 590),
		BackgroundTransparency = 1,
		ZIndex = 20,
		Parent = refs.done,
	})
	refs.doneWrapper = wrapper
	local panelCard, panel = Theme.card({
		Size = UDim2.fromScale(1, 1),
		Radius = 20,
		ShadowTransparency = 0.82,
		ShadowOffset = 6,
		Stroke = false,
		Parent = wrapper,
	})
	refs.donePanelCard = panelCard
	local band = Theme.new("Frame", {
		Size = UDim2.new(1, 0, 0, 116),
		BackgroundTransparency = 1,
		Parent = panel,
	})
	Theme.label({
		Position = UDim2.fromOffset(20, 16),
		Size = UDim2.new(1, -40, 0, 34),
		Text = "Cuadro terminado",
		Font = Theme.Fonts.Heavy,
		TextColor3 = C.Ink,
		MaxTextSize = 28,
		Parent = band,
	})
	refs.doneStars = {}
	for i = 1, 3 do
		local star = Theme.label({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, (i - 2) * 62, 0, i == 2 and 82 or 88),
			Size = UDim2.fromOffset(i == 2 and 60 or 50, i == 2 and 60 or 50),
			Text = "★",
			Font = Theme.Fonts.Heavy,
			TextColor3 = C.Gold,
			MaxTextSize = 50,
			Parent = band,
		})
		refs.doneStars[i] = star
	end
	local artBox = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 132),
		Size = UDim2.fromOffset(212, 212),
		BackgroundColor3 = C.White,
		Parent = panel,
	}, { Theme.corner(4), Theme.stroke(C.Ink, 4) })
	refs.doneArt = Theme.new(
		"Frame",
		{ Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = artBox },
		{ Theme.corner(4) }
	)
	refs.doneValue = Theme.label({
		Position = UDim2.fromOffset(20, 356),
		Size = UDim2.new(1, -40, 0, 34),
		Text = "",
		Font = Theme.Fonts.Heavy,
		TextColor3 = C.Ink,
		MaxTextSize = 28,
		Parent = panel,
	})
	refs.doneBreakdown = Theme.label({
		Position = UDim2.fromOffset(20, 392),
		Size = UDim2.new(1, -40, 0, 22),
		Text = "",
		Font = Theme.Fonts.Medium,
		TextColor3 = C.InkSoft,
		MaxTextSize = 15,
		Parent = panel,
	})
	refs.doneInfo = Theme.label({
		Position = UDim2.fromOffset(20, 416),
		Size = UDim2.new(1, -40, 0, 22),
		Text = "",
		Font = Theme.Fonts.Medium,
		TextColor3 = C.InkSoft,
		MaxTextSize = 16,
		Parent = panel,
	})
	refs.exhibit = Theme.button({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 450),
		Size = UDim2.new(1, -60, 0, 52),
		Text = "",
		Variant = "primary",
		Radius = 12,
		Parent = panel,
		OnClick = function()
			Painter.finish("galeria")
		end,
	})
	refs.sell = Theme.button({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 520),
		Size = UDim2.new(1, -60, 0, 48),
		Text = "",
		Variant = "ghost",
		Radius = 12,
		Parent = panel,
		OnClick = function()
			Painter.finish("vender")
		end,
	})
end

local function buildUI()
	gui = Theme.new("ScreenGui", {
		Name = "Painter",
		ResetOnSpawn = false,
		DisplayOrder = 15,
		Enabled = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = Players.LocalPlayer:WaitForChild("PlayerGui"),
	})
	-- Fondo de estudio que tapa también la barra superior de Roblox.
	local background = Theme.new("Frame", {
		Position = UDim2.fromOffset(0, -80),
		Size = UDim2.new(1, 0, 1, 80),
		BackgroundColor3 = C.White,
		Parent = gui,
	}, { Theme.gradient(C.Bg, C.Bg, 90) })
	local root = Theme.new("Frame", {
		Position = UDim2.fromOffset(0, 80),
		Size = UDim2.new(1, 0, 1, -80),
		BackgroundTransparency = 1,
		Parent = background,
	})
	buildTopBar(root)
	buildCanvas(root)
	buildTray(root)
	buildComplete()
end

local function updateScales()
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local viewport = camera.ViewportSize
	local scale = math.clamp(math.min((viewport.X - 20) / 460, (viewport.Y - 70) / 590), 0.45, 1.1)
	local uiScale = refs.doneWrapper:FindFirstChild("ViewportScale")
		or Theme.new("UIScale", { Name = "ViewportScale", Parent = refs.doneWrapper })
	uiScale.Scale = scale
	local hudScale = math.clamp(math.min(viewport.X / 1280, viewport.Y / 720), 0.6, 1)
	for _, frame in ipairs({ refs.timerCard, refs.tray }) do
		local s = frame:FindFirstChild("ViewportScale")
			or Theme.new("UIScale", { Name = "ViewportScale", Parent = frame })
		s.Scale = hudScale
	end
end

local function bindInput()
	UserInputService.InputChanged:Connect(function(input)
		if not current then
			return
		end
		if
			input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch
		then
			pointer = input.Position
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			stroking = false
			lastBrush = nil
			if current then
				refreshLabels()
			end
		end
	end)
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or not current then
			return
		end
		if input.KeyCode == Enum.KeyCode.B then
			setTool("brush")
		elseif input.KeyCode == Enum.KeyCode.F and Config.hasBucket(levels()) then
			setTool("bucket")
		end
	end)
	RunService.RenderStepped:Connect(onStep)
end

local function setControlsEnabled(enabled)
	pcall(function()
		local playerModule = require(Players.LocalPlayer.PlayerScripts:WaitForChild("PlayerModule", 2))
		local controls = playerModule:GetControls()
		if enabled then
			controls:Enable()
		else
			controls:Disable()
		end
	end)
end

-- API --------------------------------------------------------------------------------------------
function Painter.open(design, colors)
	local radius = Config.brushRadius(levels())
	current = {
		design = design,
		colors = colors,
		radius = radius,
		samples = buildSamples(design, radius),
		slots = {},
		done = false,
		started = os.clock(),
		lastProgress = os.clock(),
	}
	stroking = false
	lastBrush = nil
	current.art = DesignArt.render(canvasFrame, design, { mode = "paint", colors = colors, stroke = 2 })
	for i, info in ipairs(current.samples) do
		-- Las figuras completamente tapadas ya cuentan como pintadas.
		if info.total == 0 then
			info.complete = true
			current.art.complete(i, false)
		end
	end
	fillTray(design, colors)
	refs.title.Text = design.name
	refs.done.Visible = false
	setTool(tool == "bucket" and Config.hasBucket(levels()) and "bucket" or "brush")
	refreshLabels()
	refreshTimer()
	updateScales()
	gui.Enabled = true
	ProximityPromptService.Enabled = false
	setControlsEnabled(false)
	app.setHudVisible(false)
	Theme.playSound("whoosh")
	completeIfDone()
end

function Painter.isOpen()
	return current ~= nil
end

function Painter.close()
	current = nil
	stroking = false
	gui.Enabled = false
	refs.done.Visible = false
	ProximityPromptService.Enabled = true
	setControlsEnabled(true)
	app.setHudVisible(true)
end

function Painter.requestCancel()
	if not current then
		return
	end
	if os.clock() > confirmCancelUntil then
		confirmCancelUntil = os.clock() + 3
		refs.exit.SetText("¿Salir?")
		task.delay(3, function()
			refs.exit.SetText("✕ Salir")
		end)
		app.notify("Toca otra vez para salir (te devolvemos las pinturas).", "info")
		return
	end
	confirmCancelUntil = 0
	refs.exit.SetText("✕ Salir")
	app.remotes.CancelPainting:FireServer()
	Painter.close()
end

function Painter.showComplete()
	local state = app.state
	local design = current.design
	local stars = Config.starsFor(design, levels(), current.finishedAt or elapsed())
	current.stars = stars
	local made = state and state.made[design.id] or 0
	local value = Config.paintingValue(design, current.colors, levels(), made, stars)
	current.value = value
	local tier = Config.masteryFor(made)
	DesignArt.render(refs.doneArt, design, { mode = "color", colors = current.colors, outline = false })
	refs.doneValue.Text = "💵 " .. Theme.formatNumber(value)
	refs.doneBreakdown.Text = string.format(
		"Colores x%.2f  ·  Estrellas +%d%%  ·  Maestría +%d%%",
		Config.colorMultiplier(design, current.colors),
		math.floor(Config.STAR_BONUS[stars] * 100),
		math.floor((tier and tier.bonus or 0) * 100)
	)
	local free = state and (state.slots - state.displayed) or 0
	refs.doneInfo.Text = free > 0 and ("Huecos libres en tu galería: " .. free)
		or "Tu galería está llena: compra «Más paredes» 🖼️"
	refs.exhibit.SetText(
		"Exponer en tu galería · 💵 " .. Theme.formatNumber(math.floor(value * Config.GALLERY_BONUS))
	)
	refs.exhibit.SetEnabled(free > 0)
	refs.sell.SetText("Vender ya · 💵 " .. Theme.formatNumber(value))
	for _, star in ipairs(refs.doneStars) do
		star.TextColor3 = C.Border
		star.TextTransparency = 0
	end
	updateScales()
	refs.done.Visible = true
	Theme.pop(refs.donePanelCard, 0.6)
	Theme.playSound("success", 1)
	task.spawn(function()
		task.wait(0.35)
		for i = 1, stars do
			local star = refs.doneStars[i]
			if not star.Parent then
				return
			end
			star.TextColor3 = C.Gold
			star.TextTransparency = 0
			Theme.pop(star, 1.8)
			Theme.playSound("success", 0.9 + i * 0.15)
			task.wait(0.28)
		end
		if stars >= 3 then
			app.celebrate()
		end
	end)
end

function Painter.finish(choice)
	if finishing or not current then
		return
	end
	finishing = true
	local result
	for _ = 1, 30 do
		local ok, response = pcall(function()
			return app.remotes.FinishPainting:InvokeServer(choice)
		end)
		result = ok and response or nil
		if result and not result.ok and result.reason == "¡Aún no está terminado!" then
			task.wait(1)
		else
			break
		end
	end
	finishing = false
	if not (result and result.ok) then
		app.notify(result and result.reason or "No se pudo terminar el cuadro.", "error")
		return
	end
	Painter.close()
	local stars = string.rep("⭐", result.stars or 1)
	if result.displayed then
		app.notify(
			stars .. " ¡Expuesto! Un visitante lo comprará por 💵" .. Theme.formatNumber(result.price),
			"success"
		)
	else
		app.notify(stars .. " ¡Vendido por 💵" .. Theme.formatNumber(result.price) .. "!", "gold")
	end
	if result.mastery then
		app.notify("🏅 ¡Maestría de " .. result.mastery .. " en este diseño!", "gold")
	end
	if result.newLevel then
		app.notify("🔓 ¡Nivel " .. result.newLevel .. " de diseños desbloqueado!", "gold")
		app.celebrate()
	end
end

function Painter.init(appRef)
	app = appRef
	buildUI()
	bindInput()
	if workspace.CurrentCamera then
		workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScales)
	end
end

return Painter
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="28">
            <Properties>
              <string name="Name">Shop</string>
              <string name="Source"><![CDATA[-- Tienda de mejoras del taller y la galería, agrupadas por secciones.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Colors = require(Shared.Colors)
local Config = require(Shared.Config)

local Theme = require(script.Parent.Theme)

local Shop = {}

local C = Theme.Colors

local SECTIONS = {
	{ name = "Máquina de colores", ids = { "suerte", "velocidad", "auto" } },
	{ name = "Pintura", ids = { "pincel", "cubeta" } },
	{ name = "Galería", ids = { "precio", "fama", "paredes", "decoracion" } },
}

local app
local window
local cards = {}
local busy = false

-- Efecto actual → siguiente de cada mejora.
local function effectText(id, level)
	local levels = { [id] = level }
	local nextLevels = { [id] = level + 1 }
	if id == "precio" or id == "decoracion" then
		return string.format("Valor x%.2f → x%.2f", Config.payMultiplier(levels), Config.payMultiplier(nextLevels))
	elseif id == "suerte" then
		local function rare(chances)
			return (chances.raro + chances.epico + chances.legendario + chances.mitico) * 100
		end
		return string.format(
			"Raro o mejor %.1f%% → %.1f%%",
			rare(Colors.chances(Config.luck(levels))),
			rare(Colors.chances(Config.luck(nextLevels)))
		)
	elseif id == "velocidad" then
		return string.format("Recarga %.1fs → %.1fs", Config.rollInterval(levels), Config.rollInterval(nextLevels))
	elseif id == "auto" then
		return "Tira sola cada " .. string.format("%.1f", Config.autoRollInterval({})) .. "s"
	elseif id == "pincel" then
		local base = Config.brushRadius({})
		return string.format(
			"Grosor %d%% → %d%%",
			math.floor(Config.brushRadius(levels) / base * 100 + 0.5),
			math.floor(Config.brushRadius(nextLevels) / base * 100 + 0.5)
		)
	elseif id == "cubeta" then
		return "Un toque rellena una figura"
	elseif id == "fama" then
		return string.format(
			"Visitas cada %.0fs → %.0fs · VIP %d%%",
			Config.buyerInterval(levels),
			Config.buyerInterval(nextLevels),
			math.floor(Config.vipChance(nextLevels) * 100 + 0.5)
		)
	elseif id == "paredes" then
		return string.format("Cuadros en venta %d → %d", Config.gallerySlots(levels), Config.gallerySlots(nextLevels))
	end
	return ""
end

local function buildCard(upgrade, order, parent)
	local _, body = Theme.card({
		Name = upgrade.id,
		Size = UDim2.fromOffset(372, 132),
		Radius = 14,
		LayoutOrder = order,
		Parent = parent,
	})
	local icon = Theme.new("Frame", {
		Position = UDim2.fromOffset(12, 12),
		Size = UDim2.fromOffset(60, 60),
		BackgroundColor3 = C.PanelSoft,
		Parent = body,
	}, { Theme.corner(12) })
	Theme.label({ Size = UDim2.fromScale(1, 1), Text = upgrade.icon, MaxTextSize = 30, Parent = icon })
	Theme.label({
		Position = UDim2.fromOffset(88, 10),
		Size = UDim2.new(1, -170, 0, 24),
		Text = upgrade.name,
		Font = Theme.Fonts.Heavy,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 18,
		Parent = body,
	})
	local level, levelLabel = Theme.chip({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 12),
		Size = UDim2.fromOffset(72, 22),
		Color = C.PanelSoft,
		TextColor3 = C.InkSoft,
		Text = "",
		MaxTextSize = 12,
		Parent = body,
	})
	Theme.label({
		Position = UDim2.fromOffset(88, 34),
		Size = UDim2.new(1, -100, 0, 18),
		Text = upgrade.desc,
		Font = Theme.Fonts.Medium,
		TextColor3 = C.InkSoft,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 14,
		Parent = body,
	})
	local effect = Theme.label({
		Position = UDim2.fromOffset(88, 54),
		Size = UDim2.new(1, -100, 0, 18),
		Text = "",
		Font = Theme.Fonts.Bold,
		TextColor3 = C.Primary,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 14,
		Parent = body,
	})
	local bar = Theme.progress({
		Position = UDim2.fromOffset(12, 98),
		Size = UDim2.new(1, -170, 0, 6),
		Gradient = "primary",
		Parent = body,
	})
	local button = Theme.button({
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -12, 1, -12),
		Size = UDim2.fromOffset(140, 40),
		Text = "",
		Variant = "primary",
		Radius = 12,
		MaxTextSize = 17,
		Parent = body,
		OnClick = function()
			Shop.buy(upgrade, body)
		end,
	})
	cards[upgrade.id] = { effect = effect, bar = bar, button = button, level = level, levelLabel = levelLabel }
end

function Shop.buy(upgrade, body)
	if busy then
		return
	end
	busy = true
	local ok, success, message = pcall(function()
		return app.remotes.BuyUpgrade:InvokeServer(upgrade.id)
	end)
	busy = false
	if ok and success then
		Theme.playSound("success", 1.2)
		app.notify("✨ " .. message, "success")
		Theme.pop(body, 0.92)
	else
		app.notify(ok and message or "No se pudo comprar.", "error")
	end
end

function Shop.refresh()
	local state = app.state
	if not (state and window) then
		return
	end
	window.Subtitle.Text = "Tienes 💵 " .. Theme.formatNumber(state.coins)
	for _, upgrade in ipairs(Config.Upgrades) do
		local card = cards[upgrade.id]
		local level = state.upgrades[upgrade.id] or 0
		card.bar.Set(level / upgrade.max)
		card.levelLabel.Text = "Nv " .. level .. "/" .. upgrade.max
		if level >= upgrade.max then
			card.effect.Text = "Nivel máximo"
			card.button.SetText("Completado")
			card.button.SetEnabled(false)
		else
			local cost = Config.upgradeCost(upgrade.id, level)
			card.effect.Text = effectText(upgrade.id, level)
			card.button.SetText("💵 " .. Theme.formatNumber(cost))
			card.button.SetEnabled(state.coins >= cost)
		end
	end
end

function Shop.open()
	window.Open()
	Shop.refresh()
end

function Shop.close()
	window.Close()
end

function Shop.init(appRef)
	app = appRef
	local gui = Theme.new("ScreenGui", {
		Name = "Shop",
		ResetOnSpawn = false,
		DisplayOrder = 14,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = Players.LocalPlayer:WaitForChild("PlayerGui"),
	})
	window = Theme.window({
		Name = "Window",
		Parent = gui,
		Size = UDim2.fromOffset(830, 640),
		Title = "Mejoras",
	})
	local list = Theme.new("ScrollingFrame", {
		Position = UDim2.fromOffset(18, 12),
		Size = UDim2.new(1, -36, 1, -24),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = C.InkFaint,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = window.Body,
	}, {
		Theme.list("v", 10),
		Theme.new("UIPadding", {
			PaddingRight = UDim.new(0, 10),
			PaddingLeft = UDim.new(0, 4),
			PaddingTop = UDim.new(0, 4),
			PaddingBottom = UDim.new(0, 12),
		}),
	})
	local order = 0
	for _, section in ipairs(SECTIONS) do
		order += 1
		Theme.label({
			Size = UDim2.new(1, 0, 0, 26),
			Text = section.name,
			Font = Theme.Fonts.Heavy,
			TextColor3 = C.InkSoft,
			TextXAlignment = Enum.TextXAlignment.Left,
			MaxTextSize = 16,
			LayoutOrder = order,
			Parent = list,
		})
		order += 1
		local rows = math.ceil(#section.ids / 2)
		local grid = Theme.new("Frame", {
			Size = UDim2.new(1, 0, 0, rows * 146),
			BackgroundTransparency = 1,
			LayoutOrder = order,
			Parent = list,
		}, {
			Theme.new("UIGridLayout", {
				CellSize = UDim2.fromOffset(372, 132),
				CellPadding = UDim2.fromOffset(14, 14),
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
		})
		for i, id in ipairs(section.ids) do
			buildCard(Config.UpgradeById[id], i, grid)
		end
	end
end

return Shop
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="29">
            <Properties>
              <string name="Name">Theme</string>
              <string name="Source"><![CDATA[-- Sistema de diseño de la interfaz: colores, tipografías y componentes
-- (botones, tarjetas, ventanas, barras, insignias). Estilo minimalista:
-- colores planos, sombras suaves y un único color de acento.

local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Theme = {}

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

-- Paleta neutra con un solo color de acento (azul). Pensada para todo el
-- público: fondos claros, texto oscuro y colores planos.
Theme.Colors = {
	Bg = rgb(244, 245, 247),
	Panel = rgb(255, 255, 255),
	PanelSoft = rgb(242, 243, 246),
	Border = rgb(225, 228, 234),
	Ink = rgb(26, 30, 38),
	InkSoft = rgb(96, 104, 118),
	InkFaint = rgb(156, 163, 175),
	Primary = rgb(40, 104, 232),
	PrimaryDark = rgb(28, 80, 196),
	PrimaryLight = rgb(232, 239, 253),
	Pink = rgb(40, 104, 232),
	PinkLight = rgb(232, 239, 253),
	Mint = rgb(26, 160, 108),
	MintDark = rgb(16, 128, 84),
	MintLight = rgb(225, 245, 236),
	Gold = rgb(240, 168, 32),
	GoldDark = rgb(170, 108, 0),
	GoldLight = rgb(253, 245, 225),
	Red = rgb(220, 64, 64),
	RedLight = rgb(252, 232, 232),
	Orange = rgb(234, 126, 40),
	Blue = rgb(40, 104, 232),
	Purple = rgb(112, 90, 214),
	Shadow = rgb(14, 18, 28),
	White = rgb(255, 255, 255),
}
local C = Theme.Colors

-- Colores de relleno (casi planos: el degradado es apenas perceptible).
Theme.Gradients = {
	primary = { rgb(48, 112, 240), rgb(36, 98, 226) },
	mint = { rgb(32, 170, 116), rgb(24, 154, 104) },
	gold = { rgb(244, 176, 44), rgb(234, 160, 28) },
	red = { rgb(228, 74, 74), rgb(212, 58, 58) },
	blue = { rgb(48, 112, 240), rgb(36, 98, 226) },
	purple = { rgb(122, 100, 222), rgb(108, 86, 208) },
	pink = { rgb(48, 112, 240), rgb(36, 98, 226) },
	orange = { rgb(240, 138, 52), rgb(228, 122, 38) },
	dark = { rgb(44, 50, 62), rgb(32, 37, 48) },
	gray = { rgb(228, 231, 236), rgb(220, 224, 230) },
}

Theme.Fonts = {
	Display = Enum.Font.BuilderSansExtraBold,
	Heavy = Enum.Font.BuilderSansExtraBold,
	Bold = Enum.Font.BuilderSansBold,
	Medium = Enum.Font.BuilderSansMedium,
	Body = Enum.Font.BuilderSans,
	Title = Enum.Font.BuilderSansExtraBold,
}

-- Instancias ----------------------------------------------------------------------------------
function Theme.new(className, props, children)
	local instance = Instance.new(className)
	if props then
		for key, value in pairs(props) do
			if key ~= "Parent" then
				instance[key] = value
			end
		end
	end
	if children then
		for _, child in ipairs(children) do
			child.Parent = instance
		end
	end
	if props and props.Parent then
		instance.Parent = props.Parent
	end
	return instance
end

function Theme.corner(radius)
	return Theme.new("UICorner", { CornerRadius = UDim.new(0, radius or 14) })
end

function Theme.round()
	return Theme.new("UICorner", { CornerRadius = UDim.new(0.5, 0) })
end

function Theme.stroke(color, thickness, transparency)
	return Theme.new("UIStroke", {
		Color = color or C.Border,
		Thickness = thickness or 2,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function Theme.textStroke(color, thickness, transparency)
	return Theme.new("UIStroke", {
		Color = color or C.Ink,
		Thickness = thickness or 2,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
	})
end

function Theme.padding(all, horizontal)
	local v = UDim.new(0, all)
	local h = UDim.new(0, horizontal or all)
	return Theme.new("UIPadding", { PaddingTop = v, PaddingBottom = v, PaddingLeft = h, PaddingRight = h })
end

function Theme.gradient(a, b, rotation)
	if type(a) == "string" then
		local pair = Theme.Gradients[a]
		return Theme.new("UIGradient", { Color = ColorSequence.new(pair[1], pair[2]), Rotation = b or 90 })
	end
	return Theme.new("UIGradient", { Color = ColorSequence.new(a, b), Rotation = rotation or 90 })
end

function Theme.list(direction, padding, hAlign, vAlign)
	return Theme.new("UIListLayout", {
		FillDirection = direction == "h" and Enum.FillDirection.Horizontal or Enum.FillDirection.Vertical,
		Padding = UDim.new(0, padding or 8),
		HorizontalAlignment = hAlign or Enum.HorizontalAlignment.Left,
		VerticalAlignment = vAlign or Enum.VerticalAlignment.Top,
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
end

-- Texto con tamaño automático y límite de tamaño.
function Theme.label(props)
	local defaults = {
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Bold,
		TextColor3 = C.Ink,
		TextScaled = true,
		TextWrapped = true,
		Text = "",
	}
	for key, value in pairs(props) do
		if key ~= "MaxTextSize" then
			defaults[key] = value
		end
	end
	local label = Theme.new("TextLabel", defaults)
	if label.TextScaled then
		Theme.new("UITextSizeConstraint", { MaxTextSize = props.MaxTextSize or 32, Parent = label })
	end
	return label
end

-- Tarjeta blanca con sombra muy suave. Devuelve el contenedor y el cuerpo.
function Theme.card(props)
	local holder = Theme.new("Frame", {
		Name = props.Name or "Card",
		Size = props.Size or UDim2.fromOffset(200, 100),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.new(),
		BackgroundTransparency = 1,
		LayoutOrder = props.LayoutOrder or 0,
		Visible = props.Visible ~= false,
		Parent = props.Parent,
	})
	local radius = props.Radius or 14
	Theme.new("Frame", {
		Name = "Shadow",
		Position = UDim2.fromOffset(0, props.ShadowOffset or 3),
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = C.Shadow,
		BackgroundTransparency = props.ShadowTransparency or 0.93,
		Parent = holder,
	}, { Theme.corner(radius) })
	local body = Theme.new("Frame", {
		Name = "Body",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = props.Color or C.Panel,
		Parent = holder,
	}, { Theme.corner(radius) })
	if props.Stroke ~= false then
		Theme.stroke(props.StrokeColor or C.Border, props.StrokeThickness or 1).Parent = body
	end
	return holder, body
end

-- Botones -------------------------------------------------------------------------------------
-- Variant: primary, mint, gold, red, dark, ghost (blanco con borde).
function Theme.button(props)
	local variant = props.Variant or (props.Soft and "ghost") or "primary"
	local radius = props.Radius or 12
	local holder = Theme.new("Frame", {
		Name = props.Name or "Button",
		Size = props.Size or UDim2.fromOffset(160, 44),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.new(),
		BackgroundTransparency = 1,
		LayoutOrder = props.LayoutOrder or 0,
		ZIndex = props.ZIndex or 1,
		Parent = props.Parent,
	})
	local shadow = Theme.new("Frame", {
		Name = "Shadow",
		Size = UDim2.fromScale(1, 1),
		Position = UDim2.fromOffset(0, 2),
		BackgroundColor3 = C.Shadow,
		BackgroundTransparency = 0.9,
		ZIndex = holder.ZIndex,
		Parent = holder,
	}, { Theme.corner(radius) })
	local button = Theme.new("TextButton", {
		Name = "Face",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = C.White,
		AutoButtonColor = false,
		Font = props.Font or Theme.Fonts.Bold,
		Text = props.Text or "",
		TextColor3 = C.White,
		TextScaled = true,
		ZIndex = holder.ZIndex + 1,
		Parent = holder,
	}, {
		Theme.corner(radius),
		Theme.new("UIPadding", {
			PaddingTop = UDim.new(0.22, 0),
			PaddingBottom = UDim.new(0.22, 0),
			PaddingLeft = UDim.new(0, 10),
			PaddingRight = UDim.new(0, 10),
		}),
		Theme.new("UITextSizeConstraint", { MaxTextSize = props.MaxTextSize or 20 }),
	})
	local gradient = Theme.new("UIGradient", { Rotation = 90, Parent = button })
	local border = Theme.stroke(C.Border, 0)
	border.Parent = button
	local scale = Theme.new("UIScale", { Name = "Interact", Parent = holder })

	local enabled = true
	local function paint()
		if not enabled then
			local pair = Theme.Gradients.gray
			gradient.Color = ColorSequence.new(pair[1], pair[2])
			button.TextColor3 = C.InkFaint
			border.Thickness = 0
			shadow.BackgroundTransparency = 1
		elseif variant == "ghost" then
			gradient.Color = ColorSequence.new(C.White)
			button.TextColor3 = props.TextColor or C.Ink
			border.Color = props.Color or C.Border
			border.Thickness = 1.5
			shadow.BackgroundTransparency = 0.95
		else
			local pair = Theme.Gradients[variant] or Theme.Gradients.primary
			gradient.Color = ColorSequence.new(pair[1], pair[2])
			button.TextColor3 = C.White
			border.Thickness = 0
			shadow.BackgroundTransparency = 0.88
		end
	end
	paint()

	button.MouseEnter:Connect(function()
		if enabled then
			Theme.tween(scale, 0.12, { Scale = 1.03 })
		end
	end)
	button.MouseLeave:Connect(function()
		Theme.tween(scale, 0.12, { Scale = 1 })
	end)
	button.MouseButton1Down:Connect(function()
		if enabled then
			Theme.tween(scale, 0.06, { Scale = 0.97 })
		end
	end)
	button.MouseButton1Up:Connect(function()
		Theme.tween(scale, 0.1, { Scale = 1 })
	end)

	local api = { Holder = holder, Button = button, Shadow = shadow }
	function api.SetEnabled(value)
		enabled = value
		button.Active = value
		paint()
	end
	function api.SetVariant(newVariant)
		variant = newVariant
		paint()
	end
	function api.SetText(text)
		button.Text = text
	end
	if props.OnClick then
		button.Activated:Connect(function()
			if enabled then
				Theme.playSound("click")
				props.OnClick()
			end
		end)
	end
	return api
end

-- Botón cuadrado del menú lateral (icono + texto) con insignia.
function Theme.tile(props)
	local holder = Theme.new("Frame", {
		Name = props.Name or "Tile",
		Size = props.Size or UDim2.fromOffset(64, 64),
		BackgroundTransparency = 1,
		LayoutOrder = props.LayoutOrder or 0,
		Parent = props.Parent,
	})
	Theme.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		Position = UDim2.fromOffset(0, 2),
		BackgroundColor3 = C.Shadow,
		BackgroundTransparency = 0.92,
		Parent = holder,
	}, { Theme.corner(14) })
	local face = Theme.new("TextButton", {
		Name = "Face",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = C.White,
		BackgroundTransparency = 0.04,
		AutoButtonColor = false,
		Text = "",
		Parent = holder,
	}, {
		Theme.corner(14),
		Theme.stroke(C.Border, 1),
	})
	Theme.label({
		Name = "Icon",
		Size = UDim2.new(1, 0, 0.5, 0),
		Position = UDim2.fromScale(0, 0.1),
		Text = props.Icon,
		Font = Theme.Fonts.Bold,
		MaxTextSize = props.IconSize or 26,
		Parent = face,
	})
	local caption = Theme.label({
		Name = "Caption",
		Size = UDim2.new(1, -6, 0.24, 0),
		Position = UDim2.new(0, 3, 0.66, 0),
		Text = props.Text,
		Font = Theme.Fonts.Bold,
		TextColor3 = C.InkSoft,
		MaxTextSize = 12,
		Parent = face,
	})
	local badge = Theme.new("Frame", {
		Name = "Badge",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -5, 0, 5),
		Size = UDim2.fromOffset(18, 18),
		BackgroundColor3 = C.Red,
		Visible = false,
		ZIndex = 5,
		Parent = holder,
	}, { Theme.round(), Theme.stroke(C.White, 2) })
	local badgeText = Theme.label({
		Size = UDim2.fromScale(1, 1),
		Text = "!",
		Font = Theme.Fonts.Heavy,
		TextColor3 = C.White,
		MaxTextSize = 11,
		ZIndex = 6,
		Parent = badge,
	})
	local scale = Theme.new("UIScale", { Name = "Interact", Parent = holder })
	face.MouseEnter:Connect(function()
		Theme.tween(scale, 0.12, { Scale = 1.04 })
	end)
	face.MouseLeave:Connect(function()
		Theme.tween(scale, 0.12, { Scale = 1 })
	end)
	face.MouseButton1Down:Connect(function()
		Theme.tween(scale, 0.06, { Scale = 0.96 })
	end)
	face.MouseButton1Up:Connect(function()
		Theme.tween(scale, 0.1, { Scale = 1 })
	end)
	if props.OnClick then
		face.Activated:Connect(function()
			Theme.playSound("click")
			props.OnClick()
		end)
	end
	local api = { Holder = holder, Button = face, Caption = caption }
	function api.SetBadge(value)
		if value == nil or value == false or value == 0 then
			badge.Visible = false
		else
			badge.Visible = true
			badgeText.Text = value == true and "!" or tostring(value)
		end
	end
	function api.SetActive(active)
		face.BackgroundColor3 = active and C.PrimaryLight or C.White
		caption.TextColor3 = active and C.PrimaryDark or C.InkSoft
	end
	return api
end

-- Barra de progreso con degradado.
function Theme.progress(props)
	local track = Theme.new("Frame", {
		Name = props.Name or "Progress",
		Size = props.Size or UDim2.new(1, 0, 0, 10),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.new(),
		BackgroundColor3 = props.TrackColor or rgb(232, 235, 240),
		LayoutOrder = props.LayoutOrder or 0,
		ZIndex = props.ZIndex or 1,
		Parent = props.Parent,
	}, { Theme.round() })
	local fill = Theme.new("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = C.White,
		ZIndex = track.ZIndex,
		Parent = track,
	}, { Theme.round() })
	local fillGradient = Theme.gradient(props.Gradient or "primary", 0)
	fillGradient.Parent = fill
	local api = { Frame = track, Fill = fill }
	function api.Set(fraction, animate)
		fraction = math.clamp(fraction or 0, 0, 1)
		local target = UDim2.fromScale(fraction, 1)
		if animate then
			Theme.tween(fill, 0.35, { Size = target })
		else
			fill.Size = target
		end
		fill.Visible = fraction > 0.001
	end
	function api.SetGradient(name)
		local pair = Theme.Gradients[name]
		fillGradient.Color = ColorSequence.new(pair[1], pair[2])
	end
	return api
end

-- Etiqueta en forma de píldora.
function Theme.chip(props)
	local chip = Theme.new("Frame", {
		Name = props.Name or "Chip",
		Size = props.Size or UDim2.fromOffset(100, 26),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.new(),
		BackgroundColor3 = props.Color or C.PrimaryLight,
		LayoutOrder = props.LayoutOrder or 0,
		Visible = props.Visible ~= false,
		ZIndex = props.ZIndex or 1,
		Parent = props.Parent,
	}, { Theme.round() })
	local label = Theme.label({
		Size = UDim2.fromScale(1, 1),
		Text = props.Text or "",
		Font = Theme.Fonts.Heavy,
		TextColor3 = props.TextColor or props.TextColor3 or C.PrimaryDark,
		MaxTextSize = props.MaxTextSize or 15,
		ZIndex = chip.ZIndex,
		Parent = chip,
	})
	Theme.new("UIPadding", {
		PaddingLeft = UDim.new(0, 8),
		PaddingRight = UDim.new(0, 8),
		PaddingTop = UDim.new(0.15, 0),
		PaddingBottom = UDim.new(0.15, 0),
		Parent = label,
	})
	return chip, label
end

-- Ventana modal: tarjeta blanca con cabecera sencilla y línea divisoria -----------------------
function Theme.window(props)
	local holder = Theme.new("Frame", {
		Name = props.Name or "Window",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = props.Parent,
	})
	local dim = Theme.new("TextButton", {
		Name = "Dim",
		Position = UDim2.fromOffset(0, -80),
		Size = UDim2.new(1, 0, 1, 80),
		BackgroundColor3 = C.Shadow,
		BackgroundTransparency = 0.55,
		Text = "",
		AutoButtonColor = false,
		Parent = holder,
	})
	local wrapper = Theme.new("Frame", {
		Name = "Wrapper",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = props.Size or UDim2.fromOffset(900, 560),
		BackgroundTransparency = 1,
		Parent = holder,
	})
	local panelCard, panel = Theme.card({
		Name = "PanelCard",
		Size = UDim2.fromScale(1, 1),
		Radius = 18,
		Color = C.Bg,
		ShadowOffset = 6,
		ShadowTransparency = 0.82,
		Stroke = false,
		Parent = wrapper,
	})
	panel.Name = "Panel"
	local header = Theme.new("Frame", {
		Name = "Header",
		Size = UDim2.new(1, 0, 0, 72),
		BackgroundColor3 = C.White,
		Parent = panel,
	}, { Theme.corner(18) })
	-- Tapa las esquinas inferiores redondeadas de la cabecera y dibuja la línea.
	Theme.new("Frame", {
		Position = UDim2.new(0, 0, 1, -18),
		Size = UDim2.new(1, 0, 0, 18),
		BackgroundColor3 = C.White,
		BorderSizePixel = 0,
		Parent = header,
	})
	Theme.new("Frame", {
		Name = "Divider",
		Position = UDim2.new(0, 0, 1, -1),
		Size = UDim2.new(1, 0, 0, 1),
		BackgroundColor3 = C.Border,
		BorderSizePixel = 0,
		Parent = header,
	})
	local title = Theme.label({
		Name = "Title",
		Size = UDim2.new(1, -140, 0, 30),
		Position = UDim2.fromOffset(24, 12),
		Text = props.Title or "",
		Font = Theme.Fonts.Display,
		TextColor3 = C.Ink,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 26,
		Parent = header,
	})
	local subtitle = Theme.label({
		Name = "Subtitle",
		Size = UDim2.new(1, -140, 0, 18),
		Position = UDim2.fromOffset(24, 43),
		Text = props.Subtitle or "",
		Font = Theme.Fonts.Medium,
		TextColor3 = C.InkSoft,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 15,
		Parent = header,
	})
	local close = Theme.new("TextButton", {
		Name = "Close",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -18, 0, 36),
		Size = UDim2.fromOffset(36, 36),
		BackgroundColor3 = C.PanelSoft,
		Font = Theme.Fonts.Bold,
		Text = "✕",
		TextScaled = true,
		TextColor3 = C.InkSoft,
		AutoButtonColor = true,
		Parent = header,
	}, { Theme.round(), Theme.padding(10) })
	local body = Theme.new("Frame", {
		Name = "Body",
		Position = UDim2.fromOffset(0, 72),
		Size = UDim2.new(1, 0, 1, -72),
		BackgroundTransparency = 1,
		Parent = panel,
	})

	local api = {
		Holder = holder,
		Panel = panel,
		Body = body,
		Header = header,
		Wrapper = wrapper,
		Title = title,
		Subtitle = subtitle,
		Close = close,
	}
	function api.Open()
		holder.Visible = true
		dim.BackgroundTransparency = 1
		Theme.tween(dim, 0.2, { BackgroundTransparency = 0.55 })
		Theme.pop(panelCard, 0.94)
		Theme.playSound("whoosh", 1.1)
	end
	function api.Close()
		holder.Visible = false
	end
	local function requestClose()
		Theme.playSound("click")
		if props.OnClose then
			props.OnClose()
		else
			api.Close()
		end
	end
	close.Activated:Connect(requestClose)
	if not props.Modal then
		dim.Activated:Connect(requestClose)
	end
	local function updateScale()
		local camera = workspace.CurrentCamera
		if not camera then
			return
		end
		local size = wrapper.Size
		local viewport = camera.ViewportSize
		local scale = math.min((viewport.X - 24) / size.X.Offset, (viewport.Y - 70) / size.Y.Offset)
		local uiScale = wrapper:FindFirstChild("ViewportScale")
			or Theme.new("UIScale", { Name = "ViewportScale", Parent = wrapper })
		uiScale.Scale = math.clamp(scale, 0.4, 1.1)
	end
	updateScale()
	if workspace.CurrentCamera then
		workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
	end
	api.UpdateScale = updateScale
	return api
end

-- Mayúsculas que respetan tildes y eñes (string.upper solo cambia ASCII).
local ACCENTS =
	{ ["á"] = "Á", ["é"] = "É", ["í"] = "Í", ["ó"] = "Ó", ["ú"] = "Ú", ["ñ"] = "Ñ", ["ü"] = "Ü" }
function Theme.upper(text)
	local result = string.upper(text)
	for lower, upper in pairs(ACCENTS) do
		result = string.gsub(result, lower, upper)
	end
	return result
end

-- Animaciones ---------------------------------------------------------------------------------
function Theme.tween(instance, time, props, style, direction)
	local tween = TweenService:Create(
		instance,
		TweenInfo.new(time, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out),
		props
	)
	tween:Play()
	return tween
end

-- Igual que pop pero para tarjetas (cuerpo y sombra crecen juntos).
function Theme.popCard(holder, scale)
	for _, name in ipairs({ "Body", "Shadow" }) do
		local part = holder:FindFirstChild(name)
		if part then
			Theme.pop(part, scale)
		end
	end
end

function Theme.pop(guiObject, scale)
	local uiScale = guiObject:FindFirstChild("PopScale")
	if not uiScale then
		uiScale = Theme.new("UIScale", { Name = "PopScale", Parent = guiObject })
	end
	uiScale.Scale = scale or 0.6
	Theme.tween(uiScale, 0.28, { Scale = 1 }, Enum.EasingStyle.Quart)
end

-- Formato ---------------------------------------------------------------------------------------
local function trimZero(text)
	local cleaned = string.gsub(text, "%.0$", "")
	return cleaned
end

function Theme.formatNumber(n)
	n = math.floor(n or 0)
	local abs = math.abs(n)
	if abs >= 1e9 then
		return trimZero(string.format("%.1f", n / 1e9)) .. "B"
	elseif abs >= 1e6 then
		return trimZero(string.format("%.1f", n / 1e6)) .. "M"
	elseif abs >= 1e4 then
		return trimZero(string.format("%.1f", n / 1e3)) .. "K"
	end
	local formatted = tostring(n)
	while true do
		local replaced, count = string.gsub(formatted, "^(-?%d+)(%d%d%d)", "%1.%2")
		formatted = replaced
		if count == 0 then
			break
		end
	end
	return formatted
end

function Theme.formatTime(seconds)
	seconds = math.max(0, math.floor(seconds))
	local h = math.floor(seconds / 3600)
	local m = math.floor(seconds % 3600 / 60)
	if h > 0 then
		return string.format("%dh %02dm", h, m)
	end
	return string.format("%dm %02ds", m, seconds % 60)
end

-- Sonidos ---------------------------------------------------------------------------------------
-- Sonidos incluidos en el cliente de Roblox (no requieren subir audio).
local SOUND_IDS = {
	click = "rbxasset://sounds/button.wav",
	paint = "rbxasset://sounds/clickfast.wav",
	success = "rbxasset://sounds/electronicpingshort.wav",
	whoosh = "rbxasset://sounds/swoosh.wav",
}
local SOUND_VOLUME = { click = 0.35, paint = 0.12, success = 0.55, whoosh = 0.35 }
local soundCache = {}
Theme.soundsEnabled = true

function Theme.playSound(name, pitch)
	if not Theme.soundsEnabled then
		return
	end
	local id = SOUND_IDS[name]
	if not id then
		return
	end
	local sound = soundCache[name]
	if not sound then
		sound = Instance.new("Sound")
		sound.SoundId = id
		sound.Volume = SOUND_VOLUME[name] or 0.5
		sound.Parent = SoundService
		soundCache[name] = sound
	end
	sound.PlaybackSpeed = pitch or 1
	SoundService:PlayLocalSound(sound)
end

return Theme
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="30">
            <Properties>
              <string name="Name">Tutorial</string>
              <string name="Source"><![CDATA[-- Marcas del tutorial en el mundo: resalta el objeto del paso actual y pone
-- una flecha flotante encima.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)

local Theme = require(script.Parent.Theme)

local Tutorial = {}

local C = Theme.Colors
local player = Players.LocalPlayer

local app
local highlight
local arrow
local arrowLabel
local currentTarget

local function findTarget(name)
	local plotName = app.state and app.state.plotName or ""
	local plots = Workspace:FindFirstChild("Plots")
	local plot = plots and plotName ~= "" and plots:FindFirstChild(plotName)
	if not plot then
		return nil, nil
	end
	local workshop = plot:FindFirstChild("Workshop")
	if name == "machine" then
		local machine = workshop and workshop:FindFirstChild("Machine")
		return machine, machine and machine:FindFirstChild("Top")
	elseif name == "easel" then
		local easel = workshop and workshop:FindFirstChild("Easel")
		return easel, easel and easel:FindFirstChild("Canvas")
	elseif name == "gallery" then
		local gallery = plot:FindFirstChild("Gallery")
		local frame = gallery and gallery:FindFirstChild("Frame1")
		return frame, frame and frame:FindFirstChild("Canvas")
	end
	return nil, nil
end

function Tutorial.update()
	local state = app.state
	local step = state and state.tutorial or 0
	local def = Config.Tutorial[step]
	local targetName = def and def.target or nil
	local model, anchor = nil, nil
	if targetName and not app.isBusy() then
		model, anchor = findTarget(targetName)
	end
	if model ~= currentTarget then
		currentTarget = model
		highlight.Adornee = model
		highlight.Parent = model
		highlight.Enabled = model ~= nil
	end
	arrow.Adornee = anchor
	arrow.Enabled = anchor ~= nil
	if def then
		arrowLabel.Text = step == 1 and "¡Tira aquí!" or (step == 2 and "¡Pinta aquí!" or "¡Aquí!")
	end
end

function Tutorial.init(appRef)
	app = appRef
	highlight = Instance.new("Highlight")
	highlight.Name = "TutorialHighlight"
	highlight.FillColor = C.Primary
	highlight.FillTransparency = 0.8
	highlight.OutlineColor = C.White
	highlight.OutlineTransparency = 0
	highlight.DepthMode = Enum.HighlightDepthMode.Occluded
	highlight.Enabled = false

	arrow = Theme.new("BillboardGui", {
		Name = "TutorialArrow",
		Size = UDim2.fromOffset(170, 110),
		StudsOffset = Vector3.new(0, 3, 0),
		AlwaysOnTop = true,
		LightInfluence = 0,
		ResetOnSpawn = false,
		Enabled = false,
		Parent = player:WaitForChild("PlayerGui"),
	})
	local bubble = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0),
		Size = UDim2.fromOffset(150, 38),
		BackgroundColor3 = C.Primary,
		Parent = arrow,
	}, { Theme.round(), Theme.stroke(C.White, 2) })
	arrowLabel = Theme.label({
		Size = UDim2.new(1, -16, 1, -10),
		Position = UDim2.fromOffset(8, 5),
		Text = "",
		Font = Theme.Fonts.Bold,
		TextColor3 = C.White,
		MaxTextSize = 18,
		Parent = bubble,
	})
	local pointer = Theme.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 44),
		Size = UDim2.fromOffset(60, 60),
		Text = "⬇",
		Font = Theme.Fonts.Heavy,
		TextColor3 = C.Primary,
		MaxTextSize = 46,
		Parent = arrow,
	})
	Theme.textStroke(C.White, 2).Parent = pointer

	-- La flecha flota arriba y abajo.
	RunService.RenderStepped:Connect(function()
		if arrow.Enabled then
			arrow.StudsOffset = Vector3.new(0, 3 + math.sin(os.clock() * 4) * 0.6, 0)
		end
	end)
	task.spawn(function()
		while true do
			task.wait(0.5)
			Tutorial.update()
		end
	end)
end

return Tutorial
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">World</string>
            <string name="Source"><![CDATA[-- Parte visual del mundo que se dibuja en el cliente: cuadros de la galería,
-- caballete del taller y globos de diálogo de los visitantes.

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Designs = require(Shared.Designs)

local UI = script.Parent:WaitForChild("UI")
local Theme = require(UI.Theme)
local DesignArt = require(UI.DesignArt)

local World = {}

local C = Theme.Colors
local player = Players.LocalPlayer

-- Cuadros -------------------------------------------------------------------------------
local function setupCanvas(canvas)
	if canvas:FindFirstChild("ArtGui") then
		return
	end
	local gui = Theme.new("SurfaceGui", {
		Name = "ArtGui",
		Face = Enum.NormalId.Front,
		SizingMode = Enum.SurfaceGuiSizingMode.FixedSize,
		CanvasSize = Vector2.new(300, 300),
		LightInfluence = 0.35,
		Brightness = 1.15,
		Parent = canvas,
	})
	local art = Theme.new("Frame", {
		Name = "Art",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(252, 248, 240),
		BorderSizePixel = 0,
		Parent = gui,
	})
	local placeholder = Theme.label({
		Name = "Placeholder",
		Size = UDim2.fromScale(0.84, 0.5),
		Position = UDim2.fromScale(0.08, 0.25),
		Text = "",
		TextColor3 = Color3.fromRGB(176, 180, 190),
		Font = Theme.Fonts.Medium,
		MaxTextSize = 34,
		Parent = art,
	})
	local stars = Theme.label({
		Name = "Stars",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -8, 1, -8),
		Size = UDim2.fromOffset(84, 28),
		BackgroundColor3 = C.Ink,
		BackgroundTransparency = 0.25,
		Text = "",
		Font = Theme.Fonts.Heavy,
		TextColor3 = C.Gold,
		MaxTextSize = 22,
		ZIndex = 5,
		Parent = art,
	})
	Theme.round().Parent = stars
	local function refresh()
		local design = Designs.get(canvas:GetAttribute("Design") or "")
		local starCount = canvas:GetAttribute("Stars") or 0
		stars.Text = design and string.rep("★", starCount) or ""
		stars.Visible = stars.Text ~= ""
		if design then
			placeholder.Visible = false
			DesignArt.render(art, design, {
				mode = "color",
				colors = Designs.decodeColors(canvas:GetAttribute("Colors")),
				outlineThickness = 1.5,
			})
		else
			local old = art:FindFirstChild("Art")
			if old then
				old:Destroy()
			end
			placeholder.Visible = true
			placeholder.Text = canvas:GetAttribute("Locked") and "🔒" or "Espacio libre"
		end
	end
	canvas:GetAttributeChangedSignal("Design"):Connect(refresh)
	canvas:GetAttributeChangedSignal("Colors"):Connect(refresh)
	canvas:GetAttributeChangedSignal("Locked"):Connect(refresh)
	canvas:GetAttributeChangedSignal("Stars"):Connect(refresh)
	refresh()
end

-- Visitantes -----------------------------------------------------------------------------
local function setupVisitor(model)
	local head = model:WaitForChild("Head", 10)
	if not head or head:FindFirstChild("VisitorBubble") then
		return
	end
	local billboard = Theme.new("BillboardGui", {
		Name = "VisitorBubble",
		Size = UDim2.fromOffset(240, 110),
		StudsOffset = Vector3.new(0, 3.2, 0),
		MaxDistance = 70,
		LightInfluence = 0,
		ResetOnSpawn = false,
		Parent = head,
	})
	local bubble = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -30),
		Size = UDim2.fromOffset(220, 54),
		BackgroundColor3 = C.Panel,
		Visible = false,
		Parent = billboard,
	}, { Theme.corner(14), Theme.stroke(model:GetAttribute("VIP") and C.Gold or C.Border, 1.5) })
	local reaction = Theme.label({
		Size = UDim2.new(1, -16, 1, -8),
		Position = UDim2.fromOffset(8, 4),
		Text = "",
		MaxTextSize = 22,
		Parent = bubble,
	})
	local name = Theme.label({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, 0),
		Size = UDim2.fromOffset(220, 26),
		Text = (model:GetAttribute("VIP") and "👑 " or "") .. tostring(model:GetAttribute("VisitorName") or ""),
		Font = Theme.Fonts.Heavy,
		TextColor3 = model:GetAttribute("VIP") and C.Gold or Color3.new(1, 1, 1),
		MaxTextSize = 22,
		Parent = billboard,
	})
	Theme.textStroke(C.Ink, 1.5, 0.2).Parent = name
	local function refresh()
		local text = model:GetAttribute("Reaction") or ""
		bubble.Visible = text ~= ""
		reaction.Text = text
		bubble.Size = UDim2.fromOffset(text == "🤔" and 60 or 220, string.find(text, "\n") and 64 or 46)
		if bubble.Visible then
			Theme.pop(bubble, 0.5)
		end
	end
	model:GetAttributeChangedSignal("Reaction"):Connect(refresh)
	refresh()
end

-- Avisos solo para el dueño del taller.
local function updatePrompts(plot)
	local mine = plot:GetAttribute("OwnerUserId") == player.UserId
	local workshop = plot:FindFirstChild("Workshop")
	if not workshop then
		return
	end
	for _, descendant in ipairs(workshop:GetDescendants()) do
		if descendant:IsA("ProximityPrompt") then
			descendant.MaxActivationDistance = mine and 12 or 0
		end
	end
end

local function watchPlot(plot)
	local gallery = plot:WaitForChild("Gallery", 10)
	if gallery then
		for _, descendant in ipairs(gallery:GetDescendants()) do
			if descendant.Name == "Canvas" and descendant:IsA("BasePart") then
				setupCanvas(descendant)
			end
		end
	end
	local workshop = plot:WaitForChild("Workshop", 10)
	local easel = workshop and workshop:WaitForChild("Easel", 10)
	local easelCanvas = easel and easel:WaitForChild("Canvas", 10)
	if easelCanvas then
		setupCanvas(easelCanvas)
	end
	local visitors = plot:WaitForChild("Visitors", 10)
	if visitors then
		for _, model in ipairs(visitors:GetChildren()) do
			task.spawn(setupVisitor, model)
		end
		visitors.ChildAdded:Connect(function(model)
			task.spawn(setupVisitor, model)
		end)
	end
	plot:GetAttributeChangedSignal("OwnerUserId"):Connect(function()
		updatePrompts(plot)
	end)
	updatePrompts(plot)
end

function World.start()
	local plots = Workspace:WaitForChild("Plots")
	for _, plot in ipairs(plots:GetChildren()) do
		task.spawn(watchPlot, plot)
	end
	plots.ChildAdded:Connect(function(plot)
		task.spawn(watchPlot, plot)
	end)
end

return World
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
