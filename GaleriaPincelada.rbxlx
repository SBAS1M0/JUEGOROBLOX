          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Punto de entrada del servidor: crea el terreno propio de cada jugador y
-- gestiona la máquina de colores, los cuadros, la galería, las ventas,
-- las mejoras, las misiones diarias y el tutorial.

local Players = game:GetService("Players")
local PhysicsService = game:GetService("PhysicsService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Colors = require(Shared.Colors)
local Designs = require(Shared.Designs)

local Services = script.Parent:WaitForChild("Services")
local DataService = require(Services.DataService)
local WorldBuilder = require(Services.WorldBuilder)
local VisitorService = require(Services.VisitorService)

local rng = Random.new()

-- Remotos -------------------------------------------------------------------------
local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
local function remote(class, name)
	local r = Instance.new(class)
	r.Name = name
	r.Parent = remotes
	return r
end
local GetState = remote("RemoteFunction", "GetState")
local StateChanged = remote("RemoteEvent", "StateChanged")
local Notify = remote("RemoteEvent", "Notify")
local RollResult = remote("RemoteEvent", "RollResult")
local OpenDesigns = remote("RemoteEvent", "OpenDesigns")
local UnlockDesign = remote("RemoteFunction", "UnlockDesign")
local StartPainting = remote("RemoteFunction", "StartPainting")
local CancelPainting = remote("RemoteEvent", "CancelPainting")
local FinishPainting = remote("RemoteFunction", "FinishPainting")
local BuyUpgrade = remote("RemoteFunction", "BuyUpgrade")
local ClaimDaily = remote("RemoteFunction", "ClaimDaily")
local ClaimQuest = remote("RemoteFunction", "ClaimQuest")
local GoHome = remote("RemoteEvent", "GoHome")
remotes.Parent = ReplicatedStorage

-- Colisiones: los visitantes no empujan a los jugadores ni entre ellos.
local PLAYER_GROUP = "Jugadores"
pcall(function()
	PhysicsService:RegisterCollisionGroup(VisitorService.COLLISION_GROUP)
	PhysicsService:RegisterCollisionGroup(PLAYER_GROUP)
	PhysicsService:CollisionGroupSetCollidable(VisitorService.COLLISION_GROUP, VisitorService.COLLISION_GROUP, false)
	PhysicsService:CollisionGroupSetCollidable(VisitorService.COLLISION_GROUP, PLAYER_GROUP, false)
end)

local tryRoll
local renderAutoPrompt
local toggleAutoRoll

-- Estado de la sesión --------------------------------------------------------------------
local plotOf = {}
local usedSlots = {}
local sessions = {}

local function getSession(player)
	local session = sessions[player]
	if not session then
		session = { nextRoll = 0, nextAuto = 0, painting = nil, lastHome = 0 }
		sessions[player] = session
	end
	return session
end

local function notify(player, text, kind)
	Notify:FireClient(player, text, kind or "info")
end

local function openLevel(data)
	local level = 1
	for l = 2, Designs.MAX_LEVEL do
		if Designs.isLevelOpen(l, data.made) then
			level = l
		end
	end
	return level
end

local function dailyStatus(data)
	local now = os.time()
	local ready = now - data.lastDaily >= Config.DAILY_COOLDOWN
	local streak = data.dailyStreak
	if now - data.lastDaily > Config.DAILY_COOLDOWN * 2.4 then
		streak = 0
	end
	local nextStreak = math.min(streak + 1, 7)
	local amount = math.floor((80 + nextStreak * 40) * Config.questScale(openLevel(data)))
	return ready, amount, math.max(0, Config.DAILY_COOLDOWN - (now - data.lastDaily)), nextStreak
end

-- Misiones diarias -----------------------------------------------------------------------
local function ensureQuests(data)
	local day = math.floor(os.time() / 86400)
	if data.questDay == day and #data.quests == Config.QUESTS_PER_DAY then
		return
	end
	data.questDay = day
	data.questBonus = false
	data.quests = {}
	local scale = Config.questScale(openLevel(data))
	local pool = {}
	for _, def in ipairs(Config.QuestTypes) do
		table.insert(pool, def)
	end
	for _ = 1, Config.QUESTS_PER_DAY do
		local def = table.remove(pool, rng:NextInteger(1, #pool))
		local tier = rng:NextInteger(1, #def.goals)
		local goal = def.goals[tier]
		if def.scale then
			goal = math.floor(goal * scale / 10 + 0.5) * 10
		end
		table.insert(data.quests, {
			id = def.id,
			goal = goal,
			progress = 0,
			reward = math.floor((40 + 35 * tier) * scale),
			claimed = false,
		})
	end
end

-- Tutorial ----------------------------------------------------------------------------------
local pushState

local function tutorialEvent(player, data, step, amount)
	if data.tutorial ~= step then
		return
	end
	local def = Config.Tutorial[step]
	data.tutorialProgress += amount or 1
	if data.tutorialProgress >= def.goal then
		data.tutorial += 1
		data.tutorialProgress = 0
		if data.tutorial > #Config.Tutorial then
			data.tutorial = 0
			data.coins += Config.TUTORIAL_REWARD
			notify(player, "🎓 ¡Tutorial completado! +💵" .. Config.TUTORIAL_REWARD, "gold")
		end
	end
end

local function questEvent(player, data, id, amount)
	ensureQuests(data)
	for _, quest in ipairs(data.quests) do
		if quest.id == id and quest.progress < quest.goal then
			quest.progress = math.min(quest.goal, quest.progress + amount)
			if quest.progress >= quest.goal then
				notify(player, "✅ Misión lista: " .. Config.questText(quest) .. " (¡reclámala!)", "success")
			end
		end
	end
end

local function earn(player, data, amount)
	data.coins += amount
	data.earned += amount
	questEvent(player, data, "ganar", amount)
end

-- Estado para el cliente -------------------------------------------------------------------
local function buildState(player)
	local data = DataService.get(player)
	if not data then
		return nil
	end
	ensureQuests(data)
	local session = getSession(player)
	local ready, amount, wait, nextStreak = dailyStatus(data)
	local plot = plotOf[player]
	return {
		coins = data.coins,
		paints = data.paints,
		unlocked = data.unlocked,
		made = data.made,
		upgrades = data.upgrades,
		openLevel = openLevel(data),
		slots = Config.gallerySlots(data.upgrades),
		displayed = #data.gallery,
		autoUnlocked = Config.hasAutoRoll(data.upgrades),
		autoRoll = data.autoRoll and Config.hasAutoRoll(data.upgrades),
		lastRoll = data.lastRoll,
		rolls = data.rolls,
		discovered = data.discovered,
		pity = data.pity,
		pityMax = Config.PITY_ROLLS,
		rollInterval = Config.rollInterval(data.upgrades),
		sold = data.sold,
		earned = data.earned,
		painting = session.painting and session.painting.designId or nil,
		quests = data.quests,
		questBonus = data.questBonus,
		tutorial = data.tutorial,
		tutorialProgress = data.tutorialProgress,
		dailyReady = ready,
		dailyAmount = amount,
		dailyWait = wait,
		dailyStreak = nextStreak,
		plotName = plot and plot.model.Name or "",
	}
end

local function updateLeaderstats(player)
	local data = DataService.get(player)
	local stats = player:FindFirstChild("leaderstats")
	if data and stats then
		stats.Monedas.Value = data.coins
		stats.Vendidos.Value = data.sold
	end
end

function pushState(player)
	local state = buildState(player)
	if state then
		StateChanged:FireClient(player, state)
	end
	updateLeaderstats(player)
end

-- Visuales del terreno ----------------------------------------------------------------------
local function rarityIndex(colorId)
	return Colors.rarityOf(Colors.ById[colorId]).index
end

local function ownedSorted(data)
	local owned = {}
	for colorId, count in pairs(data and data.paints or {}) do
		if count > 0 and Colors.ById[colorId] then
			table.insert(owned, colorId)
		end
	end
	table.sort(owned, function(a, b)
		local ra, rb = rarityIndex(a), rarityIndex(b)
		if ra ~= rb then
			return ra > rb
		end
		return Colors.ById[a].index < Colors.ById[b].index
	end)
	return owned
end

local function renderShelf(plot, data)
	local owned = ownedSorted(data)
	for i, can in ipairs(plot.workshop.shelfCans) do
		local colorId = owned[i]
		if colorId then
			local rarity = rarityIndex(colorId)
			can.Color = Colors.mainColor(colorId)
			can.Transparency = 0
			can.Material = rarity >= 6 and Enum.Material.Neon
				or (rarity >= 5 and Enum.Material.Metal or Enum.Material.SmoothPlastic)
		else
			can.Color = Color3.fromRGB(230, 230, 236)
			can.Transparency = 0.7
			can.Material = Enum.Material.SmoothPlastic
		end
	end
	-- Las bolas de la máquina muestran tus colores.
	if #owned > 0 then
		for i, ball in ipairs(plot.workshop.machineBalls) do
			ball.Color = Colors.mainColor(owned[(i - 1) % #owned + 1])
		end
	end
end

local function renderMachine(plot, colorId)
	local workshop = plot.workshop
	local entry = Colors.ById[colorId]
	workshop.machineTop:SetAttribute("ColorId", entry and colorId or "")
	if entry then
		workshop.machineCan.Color = Colors.mainColor(colorId)
		workshop.machineGlow.Color = Colors.rarityOf(entry).color
	end
end

renderAutoPrompt = function(plot, data)
	if not (plot and data) then
		return
	end
	local autoPrompt = plot.workshop.autoPrompt
	autoPrompt.Enabled = Config.hasAutoRoll(data.upgrades)
	autoPrompt.ActionText = data.autoRoll and "Pausar Auto-Rolling" or "Activar Auto-Rolling"
end

local function slotEntry(data, slot)
	for i, entry in ipairs(data.gallery) do
		if entry.s == slot then
			return entry, i
		end
	end
	return nil
end

local function renderGallery(plot, data)
	local slots = Config.gallerySlots(data.upgrades)
	for i = 1, Config.GALLERY_SIZE do
		local canvas = plot.canvases[i]
		local plaque = plot.plaques[i]
		local entry = slotEntry(data, i)
		local design = entry and Designs.get(entry.d)
		canvas:SetAttribute("Locked", i > slots)
		if design then
			canvas:SetAttribute("Design", entry.d)
			canvas:SetAttribute("Colors", entry.c)
			canvas:SetAttribute("Price", entry.v)
			canvas:SetAttribute("Stars", entry.st or 1)
			plaque.Text = design.name .. "  ·  💵 " .. entry.v
		else
			canvas:SetAttribute("Design", "")
			canvas:SetAttribute("Colors", "")
			canvas:SetAttribute("Price", 0)
			canvas:SetAttribute("Stars", 0)
			plaque.Text = i > slots and "🔒 Mejora «Más paredes»" or "Espacio libre"
		end
	end
end

local function renderEasel(plot, designId, colors)
	plot.workshop.easelCanvas:SetAttribute("Design", designId or "")
	plot.workshop.easelCanvas:SetAttribute("Colors", colors or "")
end

local function refreshPlot(player)
	local plot = plotOf[player]
	local data = DataService.get(player)
	if plot and data then
		renderGallery(plot, data)
		renderShelf(plot, data)
	end
end

-- Terreno propio de cada jugador ----------------------------------------------------------------
local function createPlot(player, data)
	local slot
	for i = 1, Config.MAX_PLOTS do
		if not usedSlots[i] then
			slot = i
			break
		end
	end
	if not slot then
		return nil
	end
	usedSlots[slot] = player
	local plot = WorldBuilder.buildLot(slot)
	plot.model:SetAttribute("OwnerUserId", player.UserId)
	pcall(function()
		plot.model:AddPersistentPlayer(player)
	end)
	WorldBuilder.setOwnerName(plot, player.DisplayName)
	plotOf[player] = plot
	renderGallery(plot, data)
	renderShelf(plot, data)
	renderMachine(plot, data.lastRoll)
	WorldBuilder.setDecorLevel(plot, data.upgrades.decoracion or 0)
	VisitorService.attach(plot, player)

	plot.workshop.drawPrompt.Triggered:Connect(function(who)
		if who == player then
			OpenDesigns:FireClient(player)
		end
	end)
	plot.workshop.machinePrompt.Triggered:Connect(function(who)
		if who == player then
			tryRoll(player)
		end
	end)
	plot.workshop.autoPrompt.Triggered:Connect(function(who)
		if who == player then
			toggleAutoRoll(player)
		end
	end)
	renderAutoPrompt(plot, data)
	return plot
end

local function releasePlot(player)
	local plot = plotOf[player]
	if not plot then
		return
	end
	plotOf[player] = nil
	usedSlots[plot.slot] = nil
	VisitorService.detach(plot)
	WorldBuilder.destroyLot(plot)
end

local function teleportHome(player)
	local plot = plotOf[player]
	local character = player.Character
	if not (plot and character and character:FindFirstChild("HumanoidRootPart")) then
		return
	end
	pcall(function()
		player:RequestStreamAroundAsync(plot.ownerSpawn.Position, 5)
	end)
	if character.Parent then
		character:PivotTo(plot.ownerSpawn)
	end
end

-- Máquina de colores ---------------------------------------------------------------------------
-- Suma pintura y la apunta en la colección; devuelve true si es nueva.
local function addPaint(data, colorId, amount)
	data.paints[colorId] = math.min(Config.MAX_PAINT_STACK, (data.paints[colorId] or 0) + amount)
	if not data.discovered[colorId] then
		data.discovered[colorId] = true
		return true
	end
	return false
end

local function doRoll(player, auto)
	local data = DataService.get(player)
	if not data then
		return nil
	end
	-- Tras muchas tiradas sin suerte, la siguiente es Raro o mejor seguro.
	local guaranteed = data.pity + 1 >= Config.PITY_ROLLS
	local entry = Colors.roll(Config.luck(data.upgrades), rng, guaranteed and Config.PITY_RARITY or 1)
	local rarity = Colors.rarityOf(entry)
	local isNew = addPaint(data, entry.id, 1)
	data.lastRoll = entry.id
	data.rolls += 1
	data.pity = rarity.index >= Config.PITY_RARITY and 0 or data.pity + 1
	questEvent(player, data, "tirar", 1)
	if rarity.index >= 3 then
		questEvent(player, data, "raro", 1)
	end
	if isNew then
		local bonus = Config.discoveryBonus(rarity)
		earn(player, data, bonus)
		notify(player, "✨ Color nuevo en tu colección: +💵" .. bonus, "gold")
	end
	tutorialEvent(player, data, 1, 1)
	local plot = plotOf[player]
	if plot then
		renderMachine(plot, entry.id)
		renderShelf(plot, data)
	end
	RollResult:FireClient(player, entry.id, auto == true)
	pushState(player)
	return entry.id
end

function tryRoll(player)
	local data = DataService.get(player)
	local session = getSession(player)
	if not data then
		return nil
	end
	local now = os.clock()
	if now < session.nextRoll then
		return nil
	end
	local interval = Config.rollInterval(data.upgrades)
	session.nextRoll = now + interval
	-- El aviso de la máquina desaparece mientras gira.
	local plot = plotOf[player]
	if plot then
		local machinePrompt = plot.workshop.machinePrompt
		machinePrompt.Enabled = false
		task.delay(interval, function()
			if plotOf[player] == plot then
				machinePrompt.Enabled = true
			end
		end)
	end
	return doRoll(player, false)
end

toggleAutoRoll = function(player)
	local data = DataService.get(player)
	if not (data and Config.hasAutoRoll(data.upgrades)) then
		return
	end
	data.autoRoll = not data.autoRoll
	renderAutoPrompt(plotOf[player], data)
	notify(player, data.autoRoll and "🤖 Auto-Rolling activado" or "⏸ Auto-Rolling en pausa", "info")
	pushState(player)
end

-- Diseños y pintura -------------------------------------------------------------------------------
UnlockDesign.OnServerInvoke = function(player, designId)
	local data = DataService.get(player)
	local design = type(designId) == "string" and Designs.get(designId)
	if not (data and design) then
		return false, "Diseño no válido."
	end
	if data.unlocked[designId] then
		return false, "Ya lo tienes."
	end
	if not Designs.isLevelOpen(design.level, data.made) then
		return false, "Pinta todos los diseños del nivel " .. (design.level - 1) .. " primero."
	end
	if data.coins < design.price then
		return false, "Te faltan " .. (design.price - data.coins) .. " monedas."
	end
	data.coins -= design.price
	data.unlocked[designId] = true
	pushState(player)
	return true, "¡Desbloqueaste «" .. design.name .. "»!"
end

-- Unidades de cada color que pide la elección (las básicas no se gastan).
local function paintCost(colors)
	local cost = {}
	for _, colorId in pairs(colors) do
		local entry = Colors.ById[colorId]
		if entry and not entry.basic then
			cost[colorId] = (cost[colorId] or 0) + 1
		end
	end
	return cost
end

StartPainting.OnServerInvoke = function(player, designId, colors)
	local data = DataService.get(player)
	local session = getSession(player)
	local design = type(designId) == "string" and Designs.get(designId)
	if not (data and design) or type(colors) ~= "table" then
		return false, "Diseño no válido."
	end
	if session.painting then
		return false, "Ya estás pintando un cuadro."
	end
	if not data.unlocked[designId] or not Designs.isLevelOpen(design.level, data.made) then
		return false, "Ese diseño está bloqueado."
	end
	local chosen = {}
	for _, area in ipairs(design.areas) do
		local colorId = colors[area.id]
		if type(colorId) ~= "string" or not Colors.ById[colorId] then
			return false, "Elige un color para «" .. area.name .. "»."
		end
		chosen[area.id] = colorId
	end
	local cost = paintCost(chosen)
	for colorId, amount in pairs(cost) do
		if (data.paints[colorId] or 0) < amount then
			return false, "No tienes suficiente «" .. Colors.ById[colorId].name .. "»."
		end
	end
	for colorId, amount in pairs(cost) do
		data.paints[colorId] -= amount
		if data.paints[colorId] <= 0 then
			data.paints[colorId] = nil
		end
	end
	session.painting = {
		designId = designId,
		colors = chosen,
		started = os.clock(),
		minTime = Config.minPaintTime(design, data.upgrades),
	}
	tutorialEvent(player, data, 2, 1)
	refreshPlot(player)
	pushState(player)
	return true
end

local function cancelPainting(player)
	local data = DataService.get(player)
	local session = getSession(player)
	local painting = session.painting
	if not (data and painting) then
		return
	end
	session.painting = nil
	for colorId, amount in pairs(paintCost(painting.colors)) do
		addPaint(data, colorId, amount)
	end
	refreshPlot(player)
	pushState(player)
end

CancelPainting.OnServerEvent:Connect(cancelPainting)

local function freeSlot(data)
	for slot = 1, Config.gallerySlots(data.upgrades) do
		if not slotEntry(data, slot) then
			return slot
		end
	end
	return nil
end

FinishPainting.OnServerInvoke = function(player, choice)
	local data = DataService.get(player)
	local session = getSession(player)
	local painting = session.painting
	if not (data and painting) then
		return { ok = false, reason = "No estás pintando nada." }
	end
	local elapsed = os.clock() - painting.started
	if elapsed < painting.minTime then
		return { ok = false, reason = "¡Aún no está terminado!" }
	end
	local design = Designs.get(painting.designId)
	local madeBefore = data.made[design.id] or 0
	-- Las estrellas se calculan sobre el primer intento de entrega.
	painting.stars = painting.stars or Config.starsFor(design, data.upgrades, elapsed)
	local stars = painting.stars
	local value = Config.paintingValue(design, painting.colors, data.upgrades, madeBefore, stars)
	local encoded = Designs.encodeColors(painting.colors)
	local levelBefore = openLevel(data)
	local tierBefore = Config.masteryFor(madeBefore)

	session.painting = nil
	data.made[design.id] = madeBefore + 1
	questEvent(player, data, "pintar", 1)
	if stars >= 3 then
		questEvent(player, data, "estrellas", 1)
	end
	tutorialEvent(player, data, 3, 1)

	local result = { ok = true, value = value, stars = stars, designId = design.id }
	local slot = choice == "galeria" and freeSlot(data)
	if slot then
		local price = math.floor(value * Config.GALLERY_BONUS)
		table.insert(data.gallery, { s = slot, d = design.id, c = encoded, v = price, st = stars })
		result.displayed = true
		result.price = price
		result.slot = slot
		tutorialEvent(player, data, 4, 1)
	else
		earn(player, data, value)
		data.sold += 1
		result.displayed = false
		result.price = value
	end

	local tierAfter = Config.masteryFor(data.made[design.id])
	if tierAfter and tierAfter ~= tierBefore then
		result.mastery = tierAfter.name
	end
	local levelAfter = openLevel(data)
	if levelAfter > levelBefore then
		result.newLevel = levelAfter
	end

	local plot = plotOf[player]
	if plot then
		renderEasel(plot, design.id, encoded)
	end
	refreshPlot(player)
	pushState(player)
	return result
end

-- Ventas a visitantes ---------------------------------------------------------------------------
VisitorService.getProfile = function(player)
	return DataService.get(player)
end

VisitorService.availableSlots = function(player)
	local data = DataService.get(player)
	local list = {}
	if data then
		for _, entry in ipairs(data.gallery) do
			table.insert(list, entry.s)
		end
	end
	return list
end

VisitorService.onPurchase = function(player, slot, buyerName, vip)
	local data = DataService.get(player)
	if not data or not player.Parent then
		return nil
	end
	local entry, index = slotEntry(data, slot)
	if not entry then
		return nil
	end
	table.remove(data.gallery, index)
	local price = vip and math.floor(entry.v * Config.VIP_MULTIPLIER) or entry.v
	earn(player, data, price)
	data.sold += 1
	questEvent(player, data, "vender", 1)
	tutorialEvent(player, data, 5, 1)
	local design = Designs.get(entry.d)
	notify(
		player,
		(vip and "👑 ¡Coleccionista! " or "🖼️ ")
			.. tostring(buyerName)
			.. " compró «"
			.. (design and design.name or "tu cuadro")
			.. "» por 💵"
			.. price,
		"gold"
	)
	refreshPlot(player)
	pushState(player)
	return price
end

-- Mejoras, regalo diario y misiones ----------------------------------------------------------------
BuyUpgrade.OnServerInvoke = function(player, id)
	local data = DataService.get(player)
	local upgrade = type(id) == "string" and Config.UpgradeById[id]
	if not (data and upgrade) then
		return false, "Mejora no válida."
	end
	local level = data.upgrades[id] or 0
	if level >= upgrade.max then
		return false, "¡Ya está al máximo!"
	end
	local cost = Config.upgradeCost(id, level)
	if data.coins < cost then
		return false, "Te faltan " .. (cost - data.coins) .. " monedas."
	end
	data.coins -= cost
	data.upgrades[id] = level + 1
	local plot = plotOf[player]
	if plot then
		if id == "decoracion" then
			WorldBuilder.setDecorLevel(plot, level + 1)
		elseif id == "paredes" then
			renderGallery(plot, data)
		end
	end
	if id == "auto" then
		data.autoRoll = true
		renderAutoPrompt(plotOf[player], data)
	end
	pushState(player)
	return true, upgrade.name .. " subió a nivel " .. (level + 1) .. "!"
end

local function rareGift(minRarity)
	local gift
	for _ = 1, 200 do
		gift = Colors.roll(4, rng)
		if Colors.rarityOf(gift).index >= (minRarity or 3) then
			break
		end
	end
	return gift
end

ClaimDaily.OnServerInvoke = function(player)
	local data = DataService.get(player)
	if not data then
		return false
	end
	local ready, amount, _, nextStreak = dailyStatus(data)
	if not ready then
		return false
	end
	data.lastDaily = os.time()
	data.dailyStreak = nextStreak
	earn(player, data, amount)
	-- El séptimo día de racha regala un color Épico o mejor.
	local gift = rareGift(nextStreak >= 7 and 4 or 3)
	addPaint(data, gift.id, 1)
	refreshPlot(player)
	pushState(player)
	return true, amount, gift.id
end

ClaimQuest.OnServerInvoke = function(player, index)
	local data = DataService.get(player)
	if not data or type(index) ~= "number" then
		return false
	end
	ensureQuests(data)
	local quest = data.quests[index]
	if not quest or quest.claimed or quest.progress < quest.goal then
		return false
	end
	quest.claimed = true
	data.coins += quest.reward
	local result = { reward = quest.reward }
	local allDone = true
	for _, q in ipairs(data.quests) do
		if not q.claimed then
			allDone = false
		end
	end
	if allDone and not data.questBonus then
		data.questBonus = true
		local bonus = nil
		for _ = 1, 80 do
			bonus = Colors.roll(6, rng)
			if Colors.rarityOf(bonus).index >= 4 then
				break
			end
		end
		addPaint(data, bonus.id, 1)
		result.bonusColor = bonus.id
	end
	refreshPlot(player)
	pushState(player)
	return true, result
end

GetState.OnServerInvoke = function(player)
	for _ = 1, 50 do
		if DataService.get(player) then
			break
		end
		task.wait(0.2)
	end
	return buildState(player)
end

GoHome.OnServerEvent:Connect(function(player)
	local session = getSession(player)
	if os.clock() - session.lastHome >= 2 then
		session.lastHome = os.clock()
		teleportHome(player)
	end
end)

-- Jugadores -----------------------------------------------------------------------------------------
local function setCharacterGroup(character)
	local function apply(part)
		if part:IsA("BasePart") then
			part.CollisionGroup = PLAYER_GROUP
		end
	end
	for _, descendant in ipairs(character:GetDescendants()) do
		apply(descendant)
	end
	character.DescendantAdded:Connect(apply)
end

local function onPlayerAdded(player)
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	for _, name in ipairs({ "Monedas", "Vendidos" }) do
		local value = Instance.new("IntValue")
		value.Name = name
		value.Parent = stats
	end
	stats.Parent = player

	player.CharacterAdded:Connect(function(character)
		setCharacterGroup(character)
		character:WaitForChild("HumanoidRootPart", 10)
		task.wait(0.2)
		teleportHome(player)
	end)

	local data = DataService.load(player)
	if not player.Parent then
		return
	end
	-- Los jugadores que ya habían vendido no necesitan el tutorial.
	if data.tutorial ~= 0 and data.sold > 0 then
		data.tutorial = 0
	end
	if not Config.hasAutoRoll(data.upgrades) then
		data.autoRoll = false
	end
	-- Partidas anteriores: la colección empieza con los colores que ya tenías.
	for colorId, count in pairs(data.paints) do
		if count > 0 then
			data.discovered[colorId] = true
		end
	end
	ensureQuests(data)

	local plot = createPlot(player, data)
	if not plot then
		notify(player, "El servidor está lleno, prueba en otro servidor.", "error")
	end
	if player.Character then
		setCharacterGroup(player.Character)
		task.defer(teleportHome, player)
	end
	pushState(player)
	notify(player, "¡Bienvenido a tu galería! 🎨", "success")
end

-- Si el servidor estaba lleno, el primero que esperaba recibe el terreno libre.
local function assignWaitingPlayers()
	for _, waiting in ipairs(Players:GetPlayers()) do
		local data = DataService.get(waiting)
		if data and not plotOf[waiting] then
			if not createPlot(waiting, data) then
				return
			end
			teleportHome(waiting)
			pushState(waiting)
			notify(waiting, "¡Tu galería está lista! 🎨", "success")
		end
	end
end

local function onPlayerRemoving(player)
	cancelPainting(player)
	releasePlot(player)
	DataService.release(player)
	sessions[player] = nil
	task.defer(assignWaitingPlayers)
end

-- Arranque -------------------------------------------------------------------------------------------
WorldBuilder.buildSpawn()
DataService.start()
VisitorService.start()

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, player)
end

-- Tiradas automáticas (solo con la mejora Auto-Rolling).
task.spawn(function()
	while true do
		task.wait(0.2)
		local now = os.clock()
		for _, player in ipairs(Players:GetPlayers()) do
			local data = DataService.get(player)
			local session = sessions[player]
			if data and session and data.autoRoll and Config.hasAutoRoll(data.upgrades) and plotOf[player] then
				if now >= session.nextAuto then
					session.nextAuto = now + Config.autoRollInterval(data.upgrades)
					doRoll(player, true)
				end
			end
		end
	end
end)

-- Refresca el contador del regalo diario y cambia las misiones al cambiar el día.
task.spawn(function()
	while true do
		task.wait(60)
		for _, player in ipairs(Players:GetPlayers()) do
			pushState(player)
		end
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="11">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[-- Guarda y carga el progreso de cada jugador con DataStoreService.
-- Si los DataStores no están disponibles (por ejemplo en Studio sin publicar)
-- el juego sigue funcionando, solo que sin guardar.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)

local DataService = {}

local STORE_NAME = "GaleriaPincelada_v2"
local MAX_RETRIES = 4

local store = nil
local profiles = {}
local loaded = {}

do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
	else
		warn("[Galería] DataStores no disponibles, el progreso no se guardará: " .. tostring(result))
	end
end

local function defaultData()
	return {
		coins = Config.START_COINS,
		paints = {}, -- colorId -> cantidad
		unlocked = { globo = true }, -- diseños comprados
		made = {}, -- diseñoId -> veces pintado
		upgrades = {},
		gallery = {}, -- { s = hueco, d = diseño, c = colores, v = valor }
		autoRoll = false,
		lastRoll = "",
		rolls = 0,
		pity = 0, -- tiradas seguidas sin nada Raro o mejor
		discovered = {}, -- colorId -> true (colección)
		quests = {},
		questDay = 0,
		questBonus = false,
		tutorial = 1,
		tutorialProgress = 0,
		sold = 0,
		earned = 0,
		lastDaily = 0,
		dailyStreak = 0,
	}
end

-- Rellena campos que falten (por ejemplo tras una actualización del juego).
local function reconcile(data)
	local template = defaultData()
	if type(data) ~= "table" then
		return template
	end
	for key, value in pairs(template) do
		if type(data[key]) ~= type(value) then
			data[key] = value
		end
	end
	for id in pairs(data.upgrades) do
		if not Config.UpgradeById[id] then
			data.upgrades[id] = nil
		end
	end
	return data
end

-- Errores que no se arreglan reintentando (Studio sin acceso a las APIs).
local function isPermanentError(message)
	message = tostring(message)
	return string.find(message, "StudioAccessToApisNotAllowed", 1, true) ~= nil
		or string.find(message, "publish", 1, true) ~= nil
end

local function disableStore(reason)
	if store then
		store = nil
		warn("[Galería] DataStores no disponibles, el progreso no se guardará: " .. tostring(reason))
	end
end

local function withRetries(callback)
	local lastError
	for attempt = 1, MAX_RETRIES do
		local ok, result = pcall(callback)
		if ok then
			return true, result
		end
		lastError = result
		if isPermanentError(result) then
			disableStore(result)
			break
		end
		task.wait(attempt * 1.5)
	end
	return false, lastError
end

function DataService.load(player)
	local data
	local canSave = store ~= nil
	local currentStore = store
	if currentStore then
		local ok, result = withRetries(function()
			return currentStore:GetAsync("player_" .. player.UserId)
		end)
		if ok then
			data = result
		else
			-- No guardamos encima de datos que no pudimos leer.
			canSave = false
			if store then
				warn("[Galería] No se pudo cargar a " .. player.Name .. ": " .. tostring(result))
			end
		end
	end
	data = reconcile(data)
	if player.Parent then
		profiles[player] = data
		loaded[player] = canSave
	end
	return data
end

function DataService.get(player)
	return profiles[player]
end

function DataService.save(player)
	local data = profiles[player]
	local currentStore = store
	if not (currentStore and data and loaded[player]) then
		return
	end
	local ok, result = withRetries(function()
		return currentStore:UpdateAsync("player_" .. player.UserId, function()
			return data
		end)
	end)
	if not ok then
		warn("[Galería] No se pudo guardar a " .. player.Name .. ": " .. tostring(result))
	end
end

function DataService.release(player)
	DataService.save(player)
	profiles[player] = nil
	loaded[player] = nil
end

function DataService.start()
	task.spawn(function()
		while true do
			task.wait(Config.AUTOSAVE_SECONDS)
			for _, player in ipairs(Players:GetPlayers()) do
				task.spawn(DataService.save, player)
			end
		end
	end)

	game:BindToClose(function()
		if RunService:IsStudio() and not store then
			return
		end
		local pending = 0
		for _, player in ipairs(Players:GetPlayers()) do
			pending += 1
			task.spawn(function()
				DataService.save(player)
				pending -= 1
			end)
		end
		local started = os.clock()
		while pending > 0 and os.clock() - started < 25 do
			task.wait(0.2)
		end
	end)
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">VisitorService</string>
            <string name="Source"><![CDATA[-- Visitantes: avatares reales de Roblox (los amigos del dueño o avatares
-- conocidos) que entran a la galería, miran un cuadro expuesto y lo compran.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)

local VisitorService = {}

VisitorService.COLLISION_GROUP = "Visitantes"

local ANIMATIONS = {
	walk = "rbxassetid://507777826",
	idle = "rbxassetid://507766388",
	cheer = "rbxassetid://507770677",
	wave = "rbxassetid://507770239",
}
local FALLBACK_NAMES =
	{ "Lucía", "Mateo", "Sofía", "Diego", "Valentina", "Leo", "Camila", "Hugo", "Martina", "Bruno" }
local SKIN_TONES = {
	Color3.fromRGB(255, 224, 196),
	Color3.fromRGB(241, 194, 150),
	Color3.fromRGB(214, 160, 120),
	Color3.fromRGB(170, 116, 80),
	Color3.fromRGB(120, 80, 56),
}
local SHIRT_COLORS = {
	Color3.fromRGB(255, 140, 160),
	Color3.fromRGB(120, 190, 255),
	Color3.fromRGB(130, 220, 160),
	Color3.fromRGB(255, 200, 100),
	Color3.fromRGB(190, 150, 255),
}

-- Callbacks que asigna el servidor principal.
VisitorService.getProfile = nil -- (player) -> datos
VisitorService.availableSlots = nil -- (player) -> { hueco, ... } con cuadro
VisitorService.onPurchase = nil -- (player, hueco, nombre) -> precio o nil

local rng = Random.new()
local states = {}
local descriptionCache = {}
local friendsOf = {}

local function pick(list)
	return list[rng:NextInteger(1, #list)]
end

-- Avatares ----------------------------------------------------------------------------
local function loadFriends(owner)
	if friendsOf[owner] then
		return
	end
	friendsOf[owner] = {}
	task.spawn(function()
		local ok, pages = pcall(function()
			return Players:GetFriendsAsync(owner.UserId)
		end)
		if not ok or not pages then
			return
		end
		local okPage, page = pcall(function()
			return pages:GetCurrentPage()
		end)
		if okPage and type(page) == "table" then
			local list = {}
			for _, friend in ipairs(page) do
				if type(friend) == "table" and friend.Id then
					table.insert(list, { id = friend.Id, name = friend.DisplayName or friend.Username })
				end
			end
			if owner.Parent then
				friendsOf[owner] = list
			end
		end
	end)
end

local function getDescription(userId)
	local cached = descriptionCache[userId]
	if cached ~= nil then
		return cached or nil
	end
	local ok, description = pcall(function()
		return Players:GetHumanoidDescriptionFromUserId(userId)
	end)
	descriptionCache[userId] = (ok and description) or false
	return ok and description or nil
end

local function randomDescription()
	local description = Instance.new("HumanoidDescription")
	local skin = pick(SKIN_TONES)
	local shirt = pick(SHIRT_COLORS)
	description.HeadColor = skin
	description.LeftArmColor = skin
	description.RightArmColor = skin
	description.TorsoColor = shirt
	description.LeftLegColor = Color3.fromRGB(70, 70, 110)
	description.RightLegColor = Color3.fromRGB(70, 70, 110)
	return description
end

local function setCollisionGroup(model)
	for _, descendant in ipairs(model:GetDescendants()) do
		if descendant:IsA("BasePart") then
			descendant.CollisionGroup = VisitorService.COLLISION_GROUP
		end
	end
end

local function createAvatar(owner)
	local friends = friendsOf[owner] or {}
	local userId, name
	if #friends > 0 and rng:NextNumber() < 0.75 then
		local friend = pick(friends)
		userId, name = friend.id, friend.name
	else
		userId = pick(Config.FALLBACK_AVATARS)
	end
	local description = getDescription(userId) or randomDescription()
	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromDescription(description, Enum.HumanoidRigType.R15)
	end)
	if not ok or not model then
		ok, model = pcall(function()
			return Players:CreateHumanoidModelFromDescription(randomDescription(), Enum.HumanoidRigType.R15)
		end)
		if not ok or not model then
			return nil
		end
	end
	return model, name or pick(FALLBACK_NAMES)
end

-- Movimiento y animaciones -------------------------------------------------------------
local function loadTracks(humanoid)
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end
	local tracks = {}
	for name, id in pairs(ANIMATIONS) do
		local animation = Instance.new("Animation")
		animation.AnimationId = id
		local ok, track = pcall(function()
			return animator:LoadAnimation(animation)
		end)
		if ok and track then
			track.Looped = name == "walk" or name == "idle"
			tracks[name] = track
		end
	end
	return tracks
end

local function play(visitor, name)
	for trackName, track in pairs(visitor.tracks) do
		if trackName ~= name and track.IsPlaying then
			track:Stop(0.2)
		end
	end
	local track = visitor.tracks[name]
	if track and not track.IsPlaying then
		track:Play(0.2)
	end
end

local function alive(visitor)
	return visitor.model.Parent ~= nil and visitor.humanoid.Parent ~= nil
end

-- Camina hasta el punto. Roblox corta MoveTo a los 8 s, así que se repite
-- mientras siga avanzando; si se atasca, se le acerca al destino.
local function walkTo(visitor, target)
	for _ = 1, 4 do
		if not alive(visitor) then
			return false
		end
		play(visitor, "walk")
		local finished = false
		local connection = visitor.humanoid.MoveToFinished:Connect(function()
			finished = true
		end)
		visitor.humanoid:MoveTo(target.Position)
		local started = os.clock()
		while not finished and alive(visitor) and os.clock() - started < 9 do
			task.wait(0.1)
		end
		connection:Disconnect()
		if not alive(visitor) then
			return false
		end
		local offset = visitor.root.Position - target.Position
		if Vector3.new(offset.X, 0, offset.Z).Magnitude <= 3 then
			return true
		end
	end
	visitor.model:PivotTo(target * CFrame.new(0, 3, 0))
	return true
end

local function walkRoute(visitor, points)
	for _, point in ipairs(points) do
		if not walkTo(visitor, point) then
			return false
		end
	end
	return true
end

-- Ciclo de un visitante -----------------------------------------------------------------
local function runVisitor(state, slot)
	local plot = state.plot
	local owner = state.owner
	local model, name = createAvatar(owner)
	if not model or states[plot.index] ~= state then
		state.reserved[slot] = nil
		if model then
			model:Destroy()
		end
		return
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local root = model:FindFirstChild("HumanoidRootPart")
	if not (humanoid and root) then
		state.reserved[slot] = nil
		model:Destroy()
		return
	end
	local profile = VisitorService.getProfile(owner)
	local vip = profile ~= nil and rng:NextNumber() < Config.vipChance(profile.upgrades)
	model.Name = vip and "Coleccionista" or "Visitante"
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.WalkSpeed = 13
	model:SetAttribute("VisitorName", name)
	model:SetAttribute("VIP", vip)
	model:SetAttribute("Owner", owner.UserId)
	model:SetAttribute("Reaction", "")
	setCollisionGroup(model)
	local start = plot.route[1]
	model:PivotTo(CFrame.lookAt(start.Position, plot.route[2].Position) * CFrame.new(0, 3, 0))
	model.Parent = plot.visitorsFolder
	pcall(function()
		root:SetNetworkOwner(nil)
	end)
	if vip then
		local sparkles = Instance.new("Sparkles")
		sparkles.SparkleColor = Color3.fromRGB(255, 210, 80)
		sparkles.Parent = root
	end

	local visitor = { model = model, humanoid = humanoid, root = root, tracks = loadTracks(humanoid) }
	state.visitors[visitor] = true

	local function finish()
		state.visitors[visitor] = nil
		state.reserved[slot] = nil
		if model.Parent then
			model:Destroy()
		end
	end

	if not walkRoute(visitor, plot.route) then
		finish()
		return
	end

	-- Mira otro cuadro antes de decidirse (si hay más de uno).
	local others = {}
	for _, other in ipairs(VisitorService.availableSlots(owner)) do
		if other ~= slot then
			table.insert(others, other)
		end
	end
	if #others > 0 and rng:NextNumber() < 0.6 then
		local browse = plot.standPoints[pick(others)]
		if walkTo(visitor, browse) then
			model:PivotTo(browse * CFrame.new(0, 3, 0))
			play(visitor, "idle")
			model:SetAttribute("Reaction", "👀")
			task.wait(rng:NextNumber(1.5, 2.5))
		end
	end

	-- Se planta frente al cuadro elegido y lo admira.
	local stand = plot.standPoints[slot]
	if not walkTo(visitor, stand) then
		finish()
		return
	end
	model:PivotTo(stand * CFrame.new(0, 3, 0))
	play(visitor, "idle")
	model:SetAttribute("Reaction", vip and "🧐✨" or "🤔")
	task.wait(rng:NextNumber(2.5, 4))
	if not alive(visitor) or states[plot.index] ~= state then
		finish()
		return
	end

	local price = VisitorService.onPurchase and VisitorService.onPurchase(owner, slot, name, vip)
	if price then
		local line = vip and "¡Una joya para mi colección! 👑" or pick(Config.BuyerLines)
		model:SetAttribute("Reaction", line .. "\n💰 " .. price)
		play(visitor, "cheer")
	else
		model:SetAttribute("Reaction", "Oh... ya no está 😢")
		play(visitor, "wave")
	end
	state.reserved[slot] = nil
	task.wait(2.6)

	walkRoute(visitor, plot.exitRoute)
	finish()
end

-- API pública --------------------------------------------------------------------------
function VisitorService.attach(plot, owner)
	loadFriends(owner)
	states[plot.index] = {
		plot = plot,
		owner = owner,
		timer = 0,
		visitors = {},
		reserved = {},
	}
end

function VisitorService.detach(plot)
	local state = states[plot.index]
	states[plot.index] = nil
	if state then
		for visitor in pairs(state.visitors) do
			if visitor.model.Parent then
				visitor.model:Destroy()
			end
		end
		friendsOf[state.owner] = nil
	end
	plot.visitorsFolder:ClearAllChildren()
end

function VisitorService.start()
	RunService.Heartbeat:Connect(function(dt)
		for _, state in pairs(states) do
			local profile = VisitorService.getProfile(state.owner)
			if profile then
				local levels = profile.upgrades
				local count = 0
				for _ in pairs(state.visitors) do
					count += 1
				end
				state.timer += dt
				if count < Config.maxBuyers(levels) and state.timer >= Config.buyerInterval(levels) then
					local options = {}
					for _, slot in ipairs(VisitorService.availableSlots(state.owner)) do
						if not state.reserved[slot] then
							table.insert(options, slot)
						end
					end
					if #options > 0 then
						state.timer = 0
						local slot = pick(options)
						state.reserved[slot] = true
						task.spawn(runVisitor, state, slot)
					else
						state.timer = Config.buyerInterval(levels) * 0.7
					end
				end
			end
		end
	end)
end

return VisitorService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">WorldBuilder</string>
            <string name="Source"><![CDATA[-- Construye el terreno privado de cada jugador: galería y taller conectados,
-- jardín, estanque, fuente, calle y bosque alrededor. Todo por código, sin
-- assets externos. Cada jugador tiene su propio terreno, lejos de los demás.

local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)

local WorldBuilder = {}

local LOT_SPACING = 3000
local FLOOR = 2
local CEILING = 22

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local COLORS = {
	plaster = rgb(244, 243, 239),
	plasterShade = rgb(234, 233, 229),
	trim = rgb(226, 226, 222),
	stone = rgb(196, 196, 192),
	galleryFloor = rgb(206, 172, 132),
	workshopFloor = rgb(184, 184, 180),
	brick = rgb(236, 234, 228),
	charcoal = rgb(44, 48, 56),
	cladding = rgb(168, 120, 80),
	claddingDark = rgb(110, 76, 50),
	wood = rgb(190, 146, 104),
	darkWood = rgb(96, 70, 50),
	gold = rgb(214, 172, 96),
	brass = rgb(196, 160, 100),
	cream = rgb(250, 248, 242),
	glass = rgb(196, 220, 236),
	leaf = rgb(96, 160, 84),
	hedge = rgb(66, 124, 70),
	path = rgb(214, 212, 206),
	asphalt = rgb(70, 72, 80),
	workshopAccent = rgb(40, 150, 140),
}
local FLOWERS = {
	rgb(250, 250, 246),
	rgb(255, 214, 92),
	rgb(150, 132, 220),
	rgb(110, 150, 230),
}
local RAINBOW = {
	rgb(255, 90, 110),
	rgb(255, 170, 60),
	rgb(255, 225, 80),
	rgb(110, 220, 120),
	rgb(90, 170, 255),
	rgb(180, 120, 255),
}

-- Utilidades ---------------------------------------------------------------------------
local function part(props)
	local p = Instance.new(props.Class or "Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for key, value in pairs(props) do
		if key ~= "Class" and key ~= "Parent" then
			p[key] = value
		end
	end
	p.Parent = props.Parent
	return p
end

local function cylinderUp(cf)
	return cf * CFrame.Angles(0, 0, math.rad(90))
end

local function addLight(parent, class, props)
	local light = Instance.new(class)
	for key, value in pairs(props) do
		light[key] = value
	end
	light.Parent = parent
	return light
end

local function surfaceText(parentPart, face, text, props)
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = props.pps or 40
	gui.LightInfluence = props.lightInfluence or 0
	gui.Parent = parentPart
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = props.font or Enum.Font.FredokaOne
	label.Text = text
	label.TextScaled = true
	label.TextColor3 = props.color or Color3.new(1, 1, 1)
	label.Parent = gui
	local padding = Instance.new("UIPadding")
	padding.PaddingLeft = UDim.new(0.05, 0)
	padding.PaddingRight = UDim.new(0.05, 0)
	padding.PaddingTop = UDim.new(0.12, 0)
	padding.PaddingBottom = UDim.new(0.12, 0)
	padding.Parent = label
	if props.stroke then
		local stroke = Instance.new("UIStroke")
		stroke.Color = props.stroke
		stroke.Thickness = props.strokeThickness or 3
		stroke.Parent = label
	end
	return label
end

local function prompt(parent, action, object, distance)
	local p = Instance.new("ProximityPrompt")
	p.ActionText = action
	p.ObjectText = object
	p.HoldDuration = 0
	p.MaxActivationDistance = distance or 12
	p.RequiresLineOfSight = false
	p.Parent = parent
	return p
end

-- Ambiente global -----------------------------------------------------------------------
local lightingReady = false
local function setupLighting()
	if lightingReady then
		return
	end
	lightingReady = true
	Lighting.ClockTime = 14.8
	Lighting.GeographicLatitude = 30
	Lighting.Brightness = 3
	Lighting.Ambient = rgb(112, 114, 120)
	Lighting.OutdoorAmbient = rgb(142, 146, 154)
	Lighting.EnvironmentDiffuseScale = 1
	Lighting.EnvironmentSpecularScale = 1
	Lighting.GlobalShadows = true
	Lighting.ShadowSoftness = 0.2
	for _, child in ipairs(Lighting:GetChildren()) do
		if child:IsA("PostEffect") or child:IsA("Atmosphere") then
			child:Destroy()
		end
	end
	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Density = 0.3
	atmosphere.Offset = 0.2
	atmosphere.Color = rgb(200, 212, 226)
	atmosphere.Decay = rgb(110, 124, 146)
	atmosphere.Glare = 0.25
	atmosphere.Haze = 1.4
	atmosphere.Parent = Lighting
	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.5
	bloom.Size = 24
	bloom.Threshold = 1.5
	bloom.Parent = Lighting
	local color = Instance.new("ColorCorrectionEffect")
	color.Saturation = 0.06
	color.Contrast = 0.06
	color.Brightness = 0.02
	color.TintColor = rgb(255, 250, 244)
	color.Parent = Lighting
	local rays = Instance.new("SunRaysEffect")
	rays.Intensity = 0.05
	rays.Spread = 0.7
	rays.Parent = Lighting
	local depth = Instance.new("DepthOfFieldEffect")
	depth.FarIntensity = 0.12
	depth.FocusDistance = 120
	depth.InFocusRadius = 140
	depth.NearIntensity = 0
	depth.Parent = Lighting

	local terrain = Workspace.Terrain
	terrain.WaterColor = rgb(80, 170, 200)
	terrain.WaterTransparency = 0.6
	terrain.WaterWaveSize = 0.08
	terrain.WaterReflectance = 0.4
	if not terrain:FindFirstChildOfClass("Clouds") then
		local clouds = Instance.new("Clouds")
		clouds.Cover = 0.55
		clouds.Density = 0.6
		clouds.Color = rgb(250, 252, 255)
		clouds.Parent = terrain
	end
end

-- Elementos reutilizables ------------------------------------------------------------------
local function buildTree(parent, cf, scale, rng, autumn)
	local model = Instance.new("Model")
	model.Name = "Tree"
	local trunkHeight = 9 * scale
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(trunkHeight, 1.8 * scale, 1.8 * scale),
		CFrame = cylinderUp(cf * CFrame.new(0, trunkHeight / 2, 0)),
		Color = rgb(112, 76, 56),
		Material = Enum.Material.Wood,
		Parent = model,
	})
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(1.2 * scale, 2.8 * scale, 2.8 * scale),
		CFrame = cylinderUp(cf * CFrame.new(0, 0.5 * scale, 0)),
		Color = rgb(98, 66, 48),
		Material = Enum.Material.Wood,
		Parent = model,
	})
	local base = autumn and rgb(214, 150, 70) or COLORS.leaf
	for i = 1, 5 do
		local size = (5.5 + rng:NextNumber() * 3) * scale
		local offset = Vector3.new(
			rng:NextNumber(-2.4, 2.4),
			trunkHeight + rng:NextNumber(-1, 3),
			rng:NextNumber(-2.4, 2.4)
		) * scale
		if i == 1 then
			offset = Vector3.new(0, trunkHeight + 2 * scale, 0)
			size = 8 * scale
		end
		part({
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(size, size, size),
			CFrame = cf * CFrame.new(offset),
			Color = base:Lerp(rgb(255, 255, 255), rng:NextNumber() * 0.15)
				:Lerp(rgb(30, 80, 40), rng:NextNumber() * 0.15),
			Material = Enum.Material.LeafyGrass,
			CanCollide = false,
			Parent = model,
		})
	end
	model.Parent = parent
end

local function buildBush(parent, cf, scale, color)
	for i = 1, 3 do
		local angle = i * 2.1
		local size = (2.6 + i * 0.3) * scale
		part({
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(size, size, size),
			CFrame = cf * CFrame.new(math.cos(angle) * 0.9 * scale, size * 0.35, math.sin(angle) * 0.9 * scale),
			Color = color or COLORS.leaf:Lerp(rgb(30, 90, 40), i * 0.08),
			Material = Enum.Material.LeafyGrass,
			CanCollide = false,
			Parent = parent,
		})
	end
end

local function buildLampPost(parent, cf)
	-- Farola moderna: poste fino y cabezal plano.
	part({
		Size = Vector3.new(1.4, 0.4, 1.4),
		CFrame = cf * CFrame.new(0, 0.2, 0),
		Color = COLORS.charcoal,
		Material = Enum.Material.Metal,
		Parent = parent,
	})
	part({
		Size = Vector3.new(0.45, 12, 0.45),
		CFrame = cf * CFrame.new(0, 6.2, 0),
		Color = COLORS.charcoal,
		Material = Enum.Material.Metal,
		Parent = parent,
	})
	part({
		Size = Vector3.new(2.6, 0.35, 0.9),
		CFrame = cf * CFrame.new(0.9, 12.3, 0),
		Color = COLORS.charcoal,
		Material = Enum.Material.Metal,
		Parent = parent,
	})
	local lens = part({
		Size = Vector3.new(2, 0.1, 0.6),
		CFrame = cf * CFrame.new(1, 12.1, 0),
		Color = rgb(255, 236, 206),
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = parent,
	})
	addLight(lens, "SpotLight", {
		Face = Enum.NormalId.Bottom,
		Angle = 80,
		Range = 18,
		Brightness = 1.2,
		Color = rgb(255, 226, 190),
		Shadows = false,
	})
end

local function buildBench(parent, cf)
	-- Banco de roble sobre dos bloques de hormigón.
	for _, x in ipairs({ -2.3, 2.3 }) do
		part({
			Size = Vector3.new(1.2, 1.7, 2.2),
			CFrame = cf * CFrame.new(x, 0.85, 0),
			Color = COLORS.stone,
			Material = Enum.Material.Concrete,
			Parent = parent,
		})
	end
	for i = 0, 3 do
		part({
			Size = Vector3.new(6.4, 0.35, 0.5),
			CFrame = cf * CFrame.new(0, 1.85, -0.84 + i * 0.56),
			Color = COLORS.wood,
			Material = Enum.Material.Wood,
			Parent = parent,
		})
	end
end

local function buildFlowerBed(parent, cf, width, depth, rng)
	part({
		Size = Vector3.new(width + 0.8, 1, depth + 0.8),
		CFrame = cf * CFrame.new(0, 0.5, 0),
		Color = COLORS.stone,
		Material = Enum.Material.Concrete,
		Parent = parent,
	})
	part({
		Size = Vector3.new(width, 0.3, depth),
		CFrame = cf * CFrame.new(0, 1.05, 0),
		Color = rgb(96, 66, 50),
		Material = Enum.Material.Ground,
		Parent = parent,
	})
	local count = math.floor(width * depth / 2.2)
	for _ = 1, count do
		local x = rng:NextNumber(-width / 2 + 0.6, width / 2 - 0.6)
		local z = rng:NextNumber(-depth / 2 + 0.6, depth / 2 - 0.6)
		local h = rng:NextNumber(0.8, 1.6)
		part({
			Size = Vector3.new(0.18, h, 0.18),
			CFrame = cf * CFrame.new(x, 1.2 + h / 2, z),
			Color = rgb(80, 160, 80),
			CanCollide = false,
			CastShadow = false,
			Parent = parent,
		})
		part({
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(0.8, 0.8, 0.8),
			CFrame = cf * CFrame.new(x, 1.3 + h, z),
			Color = FLOWERS[rng:NextInteger(1, #FLOWERS)],
			CanCollide = false,
			CastShadow = false,
			Parent = parent,
		})
	end
end

local function buildPlant(parent, cf, scale)
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(2.6 * scale, 2.6 * scale, 2.6 * scale),
		CFrame = cylinderUp(cf * CFrame.new(0, 1.3 * scale, 0)),
		Color = rgb(222, 220, 214),
		Material = Enum.Material.Concrete,
		Parent = parent,
	})
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.4 * scale, 2.9 * scale, 2.9 * scale),
		CFrame = cylinderUp(cf * CFrame.new(0, 2.6 * scale, 0)),
		Color = rgb(206, 204, 198),
		Material = Enum.Material.Concrete,
		Parent = parent,
	})
	for i = 1, 4 do
		local angle = i * 1.7
		part({
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(2.6, 2.6, 2.6) * scale,
			CFrame = cf
				* CFrame.new(math.cos(angle) * 0.7 * scale, (3.2 + i * 0.7) * scale, math.sin(angle) * 0.7 * scale),
			Color = rgb(80 + i * 12, 172 + i * 8, 96),
			Material = Enum.Material.LeafyGrass,
			CanCollide = false,
			Parent = parent,
		})
	end
end

local function buildFountain(parent, cf)
	-- Estanque rectangular de hormigón con tres surtidores bajos.
	local edge = COLORS.stone
	part({
		Size = Vector3.new(18, 1.2, 10),
		CFrame = cf * CFrame.new(0, 0.6, 0),
		Color = edge,
		Material = Enum.Material.Concrete,
		Parent = parent,
	})
	part({
		Size = Vector3.new(16.6, 0.2, 8.6),
		CFrame = cf * CFrame.new(0, 1.15, 0),
		Color = rgb(96, 150, 180),
		Material = Enum.Material.Glass,
		Transparency = 0.15,
		Reflectance = 0.2,
		CanCollide = false,
		Parent = parent,
	})
	for _, x in ipairs({ -5, 0, 5 }) do
		local jet = part({
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.3, 0.6, 0.6),
			CFrame = cylinderUp(cf * CFrame.new(x, 1.3, 0)),
			Color = COLORS.charcoal,
			Material = Enum.Material.Metal,
			CanCollide = false,
			Parent = parent,
		})
		local water = Instance.new("ParticleEmitter")
		water.Rate = 24
		water.Lifetime = NumberRange.new(0.6, 0.8)
		water.Speed = NumberRange.new(5, 6)
		water.SpreadAngle = Vector2.new(6, 6)
		water.Acceleration = Vector3.new(0, -20, 0)
		water.LightEmission = 0.2
		water.Transparency = NumberSequence.new(0.35, 1)
		water.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 0.12) })
		water.Color = ColorSequence.new(rgb(220, 240, 255), rgb(170, 210, 240))
		water.EmissionDirection = Enum.NormalId.Top
		water.Parent = jet
	end
end

-- Cuadro enmarcado de la galería: marco negro fino, paspartú blanco y foco.
local function buildFrame(parent, cf, name)
	local frame = Instance.new("Model")
	frame.Name = name
	part({
		Size = Vector3.new(8, 8, 0.4),
		CFrame = cf,
		Color = COLORS.charcoal,
		Material = Enum.Material.Metal,
		Parent = frame,
	})
	part({
		Size = Vector3.new(7.5, 7.5, 0.2),
		CFrame = cf * CFrame.new(0, 0, -0.25),
		Color = rgb(250, 250, 248),
		Parent = frame,
	})
	local canvas = part({
		Name = "Canvas",
		Size = Vector3.new(6.2, 6.2, 0.2),
		CFrame = cf * CFrame.new(0, 0, -0.38),
		Color = COLORS.cream,
		Parent = frame,
	})
	local plaque = part({
		Name = "Plaque",
		Size = Vector3.new(4.6, 0.8, 0.12),
		CFrame = cf * CFrame.new(0, -4.7, -0.1),
		Color = rgb(250, 250, 248),
		Parent = frame,
	})
	local plaqueLabel = surfaceText(
		plaque,
		Enum.NormalId.Front,
		"",
		{ pps = 60, color = COLORS.charcoal, font = Enum.Font.BuilderSansBold }
	)
	plaqueLabel.Name = "PlaqueText"
	part({
		Size = Vector3.new(0.2, 0.2, 1),
		CFrame = cf * CFrame.new(0, 4.6, -0.6),
		Color = COLORS.charcoal,
		Material = Enum.Material.Metal,
		CanCollide = false,
		Parent = frame,
	})
	local lamp = part({
		Size = Vector3.new(2.6, 0.3, 0.4),
		CFrame = cf * CFrame.new(0, 4.8, -1.1),
		Color = COLORS.charcoal,
		Material = Enum.Material.Metal,
		CanCollide = false,
		Parent = frame,
	})
	addLight(
		lamp,
		"SpotLight",
		{ Face = Enum.NormalId.Bottom, Angle = 75, Range = 11, Brightness = 2.2, Color = rgb(255, 242, 224) }
	)
	frame.Parent = parent
	return canvas, plaqueLabel
end

local function buildEasel(parent, cf, scale)
	scale = scale or 1
	local model = Instance.new("Model")
	model.Name = "Easel"
	for _, x in ipairs({ -1.9, 1.9 }) do
		part({
			Size = Vector3.new(0.45, 11, 0.45) * scale,
			CFrame = cf
				* CFrame.new(x * scale, 5.5 * scale, 0)
				* CFrame.Angles(math.rad(-8), 0, math.rad(x > 0 and 8 or -8)),
			Color = COLORS.wood,
			Material = Enum.Material.Wood,
			Parent = model,
		})
	end
	part({
		Size = Vector3.new(0.45, 10, 0.45) * scale,
		CFrame = cf * CFrame.new(0, 5 * scale, 1.6 * scale) * CFrame.Angles(math.rad(14), 0, 0),
		Color = COLORS.wood,
		Material = Enum.Material.Wood,
		Parent = model,
	})
	part({
		Size = Vector3.new(6.4, 0.45, 1) * scale,
		CFrame = cf * CFrame.new(0, 4.2 * scale, -0.55 * scale),
		Color = COLORS.wood,
		Material = Enum.Material.Wood,
		Parent = model,
	})
	part({
		Size = Vector3.new(6.4, 6.4, 0.3) * scale,
		CFrame = cf * CFrame.new(0, 7.75 * scale, -0.3 * scale) * CFrame.Angles(math.rad(-8), 0, 0),
		Color = rgb(236, 226, 206),
		Parent = model,
	})
	local canvas = part({
		Name = "Canvas",
		Size = Vector3.new(6, 6, 0.2) * scale,
		CFrame = cf * CFrame.new(0, 7.75 * scale, -0.5 * scale) * CFrame.Angles(math.rad(-8), 0, 0),
		Color = COLORS.cream,
		Parent = model,
	})
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.2, 2.8, 2.8) * scale,
		CFrame = cf * CFrame.new(3 * scale, 4.6 * scale, -0.8 * scale) * CFrame.Angles(0, math.rad(90), 0),
		Color = rgb(230, 190, 140),
		Material = Enum.Material.Wood,
		Parent = model,
	})
	for i, color in ipairs(RAINBOW) do
		local angle = i * 0.9
		part({
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(0.5, 0.5, 0.5) * scale,
			CFrame = cf * CFrame.new(
				(3 + math.cos(angle) * 0.85) * scale,
				(4.6 + math.sin(angle) * 0.85) * scale,
				-0.95 * scale
			),
			Color = color,
			CanCollide = false,
			Parent = model,
		})
	end
	model.Parent = parent
	return canvas
end

-- Paredes con huecos -------------------------------------------------------------------------
-- openings: { { a, b, y0, y1 } } (a < b sobre el eje de la pared).
local function wall(parent, L, axis, fixed, from, to, y0, y1, thickness, openings, color, material)
	table.sort(openings, function(p, q)
		return p[1] < q[1]
	end)
	local function piece(a, b, ya, yb)
		if b - a < 0.01 or yb - ya < 0.01 then
			return
		end
		local size, cf
		if axis == "x" then
			size = Vector3.new(b - a, yb - ya, thickness)
			cf = L((a + b) / 2, (ya + yb) / 2, fixed)
		else
			size = Vector3.new(thickness, yb - ya, b - a)
			cf = L(fixed, (ya + yb) / 2, (a + b) / 2)
		end
		part({ Size = size, CFrame = cf, Color = color, Material = material or Enum.Material.Plaster, Parent = parent })
	end
	local cursor = from
	for _, o in ipairs(openings) do
		piece(cursor, o[1], y0, y1)
		piece(o[1], o[2], y0, math.max(y0, o[3]))
		piece(o[1], o[2], math.min(y1, o[4]), y1)
		cursor = o[2]
	end
	piece(cursor, to, y0, y1)
end

-- Decoraciones que aparecen con la mejora "Decoración" ----------------------------------------
local function topiary(parent, cf, height)
	part({
		Size = Vector3.new(3, 2.4, 3),
		CFrame = cf * CFrame.new(0, 1.2, 0),
		Color = COLORS.charcoal,
		Material = Enum.Material.Concrete,
		Parent = parent,
	})
	for i = 0, 2 do
		local size = (2.6 - i * 0.6) * height / 6
		part({
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(size * 1.3, size * 1.6, size * 1.3),
			CFrame = cf * CFrame.new(0, 3 + i * height / 4, 0),
			Color = COLORS.hedge:Lerp(COLORS.leaf, i * 0.15),
			Material = Enum.Material.LeafyGrass,
			CanCollide = false,
			Parent = parent,
		})
	end
end

local DECOR_BUILDERS = {
	-- 1. Árboles en maceta junto a la entrada.
	function(folder, L)
		topiary(folder, L(-30.5, 0.3, -25), 7)
		topiary(folder, L(-13.5, 0.3, -25), 7)
	end,
	-- 2. Alfombra de entrada y pasillo en gris oscuro.
	function(folder, L)
		part({
			Size = Vector3.new(5, 0.12, 20),
			CFrame = L(-22, FLOOR + 0.27, -8),
			Color = rgb(70, 74, 84),
			Material = Enum.Material.Fabric,
			CanCollide = false,
			Parent = folder,
		})
		part({
			Size = Vector3.new(5, 0.12, 22),
			CFrame = L(-22, 0.36, -36),
			Color = rgb(70, 74, 84),
			Material = Enum.Material.Fabric,
			CanCollide = false,
			Parent = folder,
		})
	end,
	-- 3. Escultura de acero en la plaza.
	function(folder, L)
		part({
			Size = Vector3.new(4, 1.2, 4),
			CFrame = L(30, 0.9, -36),
			Color = COLORS.stone,
			Material = Enum.Material.Concrete,
			Parent = folder,
		})
		-- Arco de acero hecho con tramos tangentes a una circunferencia.
		local radius = 5
		for i = 0, 14 do
			local angle = math.pi * (i + 0.5) / 15
			part({
				Size = Vector3.new(0.8, 1.15, 0.8),
				CFrame = L(30 + math.cos(angle) * radius, 1.5 + math.sin(angle) * radius, -36)
					* CFrame.Angles(0, 0, angle),
				Color = COLORS.charcoal,
				Material = Enum.Material.Metal,
				Parent = folder,
			})
		end
		part({
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(2.4, 2.4, 2.4),
			CFrame = L(30, 2.7, -36),
			Color = rgb(236, 236, 232),
			Material = Enum.Material.Marble,
			Parent = folder,
		})
	end,
	-- 4. Guirnalda de luces cálidas en la fachada.
	function(folder, L)
		for i = 0, 38 do
			local x = -40 + i * 2
			local bulb = part({
				Shape = Enum.PartType.Ball,
				Size = Vector3.new(0.6, 0.6, 0.6),
				CFrame = L(x, 19.6 - math.sin(i * 0.5) ^ 2 * 0.7, -19),
				Color = rgb(255, 226, 170),
				Material = Enum.Material.Neon,
				CanCollide = false,
				Parent = folder,
			})
			if i % 6 == 0 then
				addLight(bulb, "PointLight", { Range = 8, Brightness = 0.6, Color = rgb(255, 214, 160) })
			end
		end
	end,
	-- 5. Lámpara lineal sobre la sala de la galería.
	function(folder, L)
		local c = L(-22, 0, 2)
		for _, x in ipairs({ -7, 7 }) do
			part({
				Size = Vector3.new(0.1, 3, 0.1),
				CFrame = c * CFrame.new(x, CEILING - 1.5, 0),
				Color = COLORS.charcoal,
				CanCollide = false,
				Parent = folder,
			})
		end
		part({
			Size = Vector3.new(16, 0.5, 1),
			CFrame = c * CFrame.new(0, CEILING - 3.2, 0),
			Color = COLORS.charcoal,
			Material = Enum.Material.Metal,
			CanCollide = false,
			Parent = folder,
		})
		local strip = part({
			Size = Vector3.new(15.4, 0.1, 0.6),
			CFrame = c * CFrame.new(0, CEILING - 3.5, 0),
			Color = rgb(255, 240, 220),
			Material = Enum.Material.Neon,
			CanCollide = false,
			Parent = folder,
		})
		addLight(strip, "PointLight", { Range = 26, Brightness = 1.1, Color = rgb(255, 238, 216) })
	end,
	-- 6. Focos que iluminan la fachada y el jardín de noche.
	function(folder, L)
		local spots = {
			{ -46, 0.3, -10, Enum.NormalId.Top },
			{ 42, 0.3, -10, Enum.NormalId.Top },
			{ -46, 0.3, 10, Enum.NormalId.Top },
			{ 42, 0.3, 10, Enum.NormalId.Top },
		}
		for _, x in ipairs({ -36, -8, 4, 18, 34 }) do
			table.insert(spots, { x, FLOOR, -19.4, Enum.NormalId.Top })
		end
		for _, data in ipairs(spots) do
			local spot = part({
				Size = Vector3.new(0.8, 0.5, 0.8),
				CFrame = L(data[1], data[2] + 0.25, data[3]),
				Color = COLORS.charcoal,
				Material = Enum.Material.Metal,
				CanCollide = false,
				Parent = folder,
			})
			addLight(spot, "SpotLight", {
				Face = data[4],
				Angle = 40,
				Range = 18,
				Brightness = 1.2,
				Color = rgb(255, 236, 210),
			})
		end
	end,
}
WorldBuilder.DECOR_LEVELS = #DECOR_BUILDERS

-- Edificio -----------------------------------------------------------------------------------
-- Dos volúmenes modernos: la galería (blanca, con pretil) y el taller (forrado
-- de madera, con un alero oscuro). Grandes cristaleras con perfiles negros.

-- Cristalera con perfiles negros en una pared paralela a X.
local function glazing(parent, L, z, a, b, y0, y1, panes)
	part({
		Size = Vector3.new(b - a, y1 - y0, 0.25),
		CFrame = L((a + b) / 2, (y0 + y1) / 2, z),
		Color = COLORS.glass,
		Material = Enum.Material.Glass,
		Transparency = 0.6,
		Parent = parent,
	})
	local t = 0.3
	for i = 0, panes do
		local x = a + (b - a) * i / panes
		part({
			Size = Vector3.new(t, y1 - y0, 0.45),
			CFrame = L(x, (y0 + y1) / 2, z),
			Color = COLORS.charcoal,
			Material = Enum.Material.Metal,
			CanCollide = false,
			Parent = parent,
		})
	end
	for _, y in ipairs({ y0 + t / 2, y1 - t / 2 }) do
		part({
			Size = Vector3.new(b - a, t, 0.45),
			CFrame = L((a + b) / 2, y, z),
			Color = COLORS.charcoal,
			Material = Enum.Material.Metal,
			CanCollide = false,
			Parent = parent,
		})
	end
end

-- Marco negro alrededor de una puerta en una pared paralela a X.
local function doorFrame(parent, L, z, a, b, y0, y1)
	local t = 0.4
	part({
		Size = Vector3.new(b - a + t * 2, t, 0.6),
		CFrame = L((a + b) / 2, y1 + t / 2, z),
		Color = COLORS.charcoal,
		Material = Enum.Material.Metal,
		Parent = parent,
	})
	for _, x in ipairs({ a - t / 2, b + t / 2 }) do
		part({
			Size = Vector3.new(t, y1 - y0, 0.6),
			CFrame = L(x, (y0 + y1) / 2, z),
			Color = COLORS.charcoal,
			Material = Enum.Material.Metal,
			Parent = parent,
		})
	end
end

-- Revestimiento de listones verticales de madera sobre una pared.
-- axis "x": pared paralela a X en z = fixed; axis "z": paralela a Z en x = fixed.
local function cladding(parent, L, axis, fixed, from, to, y0, y1, openings, outward)
	wall(parent, L, axis, fixed, from, to, y0, y1, 0.3, openings, COLORS.cladding, Enum.Material.Wood)
	local function inOpening(u, y)
		for _, o in ipairs(openings) do
			if u > o[1] - 0.2 and u < o[2] + 0.2 and y > o[3] and y < o[4] then
				return o
			end
		end
		return nil
	end
	local offset = outward * 0.2
	for u = from + 1, to - 1, 1.6 do
		-- Una ranura oscura por listón, cortada por los huecos.
		local segments = {}
		local start = y0
		for _, o in ipairs(openings) do
			if u > o[1] - 0.2 and u < o[2] + 0.2 then
				table.insert(segments, { start, math.max(start, o[3]) })
				start = math.min(y1, o[4])
			end
		end
		table.insert(segments, { start, y1 })
		for _, seg in ipairs(segments) do
			local h = seg[2] - seg[1]
			if h > 0.3 and not inOpening(u, (seg[1] + seg[2]) / 2) then
				local size = axis == "x" and Vector3.new(0.14, h, 0.1) or Vector3.new(0.1, h, 0.14)
				local cf = axis == "x" and L(u, (seg[1] + seg[2]) / 2, fixed + offset)
					or L(fixed + offset, (seg[1] + seg[2]) / 2, u)
				part({
					Size = size,
					CFrame = cf,
					Color = COLORS.claddingDark,
					Material = Enum.Material.Wood,
					CanCollide = false,
					CastShadow = false,
					Parent = parent,
				})
			end
		end
	end
end

local function wallLight(parent, cf)
	part({
		Size = Vector3.new(0.8, 1.6, 0.8),
		CFrame = cf,
		Color = COLORS.charcoal,
		Material = Enum.Material.Metal,
		CanCollide = false,
		Parent = parent,
	})
	local lens = part({
		Size = Vector3.new(0.6, 0.1, 0.6),
		CFrame = cf * CFrame.new(0, -0.85, 0),
		Color = rgb(255, 236, 206),
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = parent,
	})
	addLight(lens, "SpotLight", {
		Face = Enum.NormalId.Bottom,
		Angle = 60,
		Range = 12,
		Brightness = 1.4,
		Color = rgb(255, 228, 196),
	})
end

local function grasses(parent, cf, width, rng)
	for i = 0, math.floor(width / 0.9) do
		local x = -width / 2 + 0.45 + i * 0.9
		for k = 1, 3 do
			local h = rng:NextNumber(1, 2.2)
			part({
				Size = Vector3.new(0.12, h, 0.12),
				CFrame = cf
					* CFrame.new(x + rng:NextNumber(-0.25, 0.25), h / 2, rng:NextNumber(-0.35, 0.35))
					* CFrame.Angles(rng:NextNumber(-0.25, 0.25), 0, rng:NextNumber(-0.3, 0.3)),
				Color = rgb(122, 150, 96):Lerp(rgb(196, 182, 120), (k - 1) * 0.25),
				CanCollide = false,
				CastShadow = false,
				Parent = parent,
			})
		end
	end
end

local function buildBuilding(model, L)
	local building = Instance.new("Model")
	building.Name = "Building"
	local plaster = Enum.Material.SmoothPlastic
	local rng = Random.new(11)

	-- Zócalo de hormigón y suelos.
	part({
		Size = Vector3.new(80, FLOOR, 40),
		CFrame = L(-2, FLOOR / 2, 0),
		Color = COLORS.stone,
		Material = Enum.Material.Concrete,
		Parent = building,
	})
	part({
		Size = Vector3.new(34, 0.2, 34),
		CFrame = L(-22, FLOOR + 0.1, 0),
		Color = COLORS.galleryFloor,
		Material = Enum.Material.WoodPlanks,
		Parent = building,
	})
	part({
		Size = Vector3.new(39, 0.2, 34),
		CFrame = L(15.5, FLOOR + 0.1, 0),
		Color = COLORS.workshopFloor,
		Material = Enum.Material.Concrete,
		Parent = building,
	})

	-- Fachada: cristaleras de la galería, puerta, ventanal y puerta del taller.
	local galleryTop = CEILING + 3
	local frontOpenings = {
		{ -38, -29, FLOOR + 0.5, FLOOR + 16 },
		{ -27, -17, FLOOR, FLOOR + 12 },
		{ -15, -6, FLOOR + 0.5, FLOOR + 16 },
		{ 0, 21, FLOOR + 3, FLOOR + 15 },
		{ 25, 31, FLOOR, FLOOR + 11 },
	}
	wall(building, L, "x", -17.5, -40, -4, FLOOR, galleryTop, 1, {
		frontOpenings[1],
		frontOpenings[2],
		frontOpenings[3],
	}, COLORS.plaster, plaster)
	wall(building, L, "x", -17.5, -4, 36, FLOOR, CEILING, 1, {
		frontOpenings[4],
		frontOpenings[5],
	}, COLORS.plaster, plaster)
	cladding(building, L, "x", -18.15, -4, 36.3, FLOOR, CEILING, { frontOpenings[4], frontOpenings[5] }, -1)
	glazing(building, L, -17.5, -38, -29, FLOOR + 0.5, FLOOR + 16, 3)
	glazing(building, L, -17.5, -15, -6, FLOOR + 0.5, FLOOR + 16, 3)
	glazing(building, L, -17.5, 0, 21, FLOOR + 3, FLOOR + 15, 5)
	doorFrame(building, L, -17.6, -27, -17, FLOOR, FLOOR + 12)
	doorFrame(building, L, -18.4, 25, 31, FLOOR, FLOOR + 11)

	-- Paredes traseras y laterales (la galería sube más: pretil).
	wall(building, L, "x", 17.5, -40, -4, FLOOR, galleryTop, 1, {}, COLORS.plaster, plaster)
	wall(
		building,
		L,
		"x",
		17.5,
		-4,
		36,
		FLOOR,
		CEILING,
		1,
		{ { -2, 10, FLOOR + 6, FLOOR + 14 } },
		COLORS.plaster,
		plaster
	)
	cladding(building, L, "x", 18.15, -4, 36.3, FLOOR, CEILING, { { -2, 10, FLOOR + 6, FLOOR + 14 } }, 1)
	glazing(building, L, 17.5, -2, 10, FLOOR + 6, FLOOR + 14, 2)
	wall(building, L, "z", -39.5, -18, 18, FLOOR, galleryTop, 1, {}, COLORS.plaster, plaster)
	wall(building, L, "z", 35.5, -17, 17, FLOOR, CEILING, 1, {}, COLORS.plaster, plaster)
	cladding(building, L, "z", 36.15, -18.3, 18.3, FLOOR, CEILING, {}, 1)
	-- Tabique galería-taller con paso y pretil de la galería por encima.
	wall(
		building,
		L,
		"z",
		-4.5,
		-17,
		17,
		FLOOR,
		CEILING,
		1,
		{ { -15, -6, FLOOR, FLOOR + 12 } },
		COLORS.plasterShade,
		plaster
	)
	wall(building, L, "z", -4.5, -18, 18, CEILING, galleryTop, 1, {}, COLORS.plaster, plaster)
	-- Albardillas de los pretiles.
	for _, data in ipairs({
		{ Vector3.new(37, 0.4, 1.4), L(-22, galleryTop + 0.2, -17.5) },
		{ Vector3.new(37, 0.4, 1.4), L(-22, galleryTop + 0.2, 17.5) },
		{ Vector3.new(1.4, 0.4, 36.4), L(-39.5, galleryTop + 0.2, 0) },
		{ Vector3.new(1.4, 0.4, 36.4), L(-4.5, galleryTop + 0.2, 0) },
	}) do
		part({ Size = data[1], CFrame = data[2], Color = COLORS.trim, Material = plaster, Parent = building })
	end

	-- Pared de ladrillo pintado del taller (interior).
	wall(
		building,
		L,
		"x",
		16.85,
		-4,
		35,
		FLOOR,
		CEILING,
		0.3,
		{ { -2, 10, FLOOR + 6, FLOOR + 14 } },
		COLORS.brick,
		Enum.Material.Brick
	)

	-- Techos: interior blanco, cubierta gris y alero oscuro del taller.
	part({
		Size = Vector3.new(76, 0.4, 36),
		CFrame = L(-2, CEILING + 0.2, 0),
		Color = rgb(250, 250, 248),
		Material = plaster,
		Parent = building,
	})
	part({
		Size = Vector3.new(34, 0.3, 34),
		CFrame = L(-22, CEILING + 0.55, 0),
		Color = rgb(150, 154, 160),
		Material = Enum.Material.Concrete,
		Parent = building,
	})
	part({
		Size = Vector3.new(43, 0.9, 41),
		CFrame = L(16.5, CEILING + 0.85, -1),
		Color = COLORS.charcoal,
		Material = Enum.Material.Metal,
		Parent = building,
	})
	-- Lucernario sobre el taller.
	part({
		Size = Vector3.new(10, 1.6, 6),
		CFrame = L(16, CEILING + 2, 4),
		Color = COLORS.glass,
		Material = Enum.Material.Glass,
		Transparency = 0.4,
		Parent = building,
	})

	-- Marquesina de la entrada de la galería con el rótulo.
	local canopy = part({
		Size = Vector3.new(16, 0.7, 6),
		CFrame = L(-22, FLOOR + 13.2, -20.5),
		Color = COLORS.charcoal,
		Material = Enum.Material.Metal,
		Parent = building,
	})
	local fascia = part({
		Size = Vector3.new(16, 0.9, 0.2),
		CFrame = L(-22, FLOOR + 13.2, -23.6),
		Color = COLORS.charcoal,
		Material = Enum.Material.Metal,
		Parent = building,
	})
	surfaceText(fascia, Enum.NormalId.Front, "GALERÍA", {
		pps = 40,
		color = rgb(255, 255, 255),
		font = Enum.Font.BuilderSansBold,
	})
	addLight(canopy, "SpotLight", {
		Face = Enum.NormalId.Bottom,
		Angle = 90,
		Range = 14,
		Brightness = 1.2,
		Color = rgb(255, 232, 204),
	})

	-- Rótulo con el nombre del dueño sobre la fachada blanca.
	local ownerSign = part({
		Name = "OwnerSign",
		Size = Vector3.new(32, 3.4, 0.2),
		CFrame = L(-22, CEILING + 0.6, -18.05),
		Color = COLORS.plaster,
		Material = plaster,
		Parent = building,
	})
	local ownerLabel = surfaceText(ownerSign, Enum.NormalId.Front, "Galería", {
		pps = 30,
		color = COLORS.charcoal,
		font = Enum.Font.BuilderSansExtraBold,
	})

	-- Rótulo del taller sobre el ventanal.
	local workshopSign = part({
		Size = Vector3.new(10, 1.8, 0.2),
		CFrame = L(10.5, FLOOR + 17.4, -18.4),
		Color = COLORS.charcoal,
		Material = Enum.Material.Metal,
		Parent = building,
	})
	surfaceText(workshopSign, Enum.NormalId.Front, "TALLER", {
		pps = 34,
		color = rgb(255, 255, 255),
		font = Enum.Font.BuilderSansBold,
	})

	-- Apliques de luz en la fachada.
	for _, x in ipairs({ -39, -16, -5, 23, 33 }) do
		wallLight(building, L(x, FLOOR + 11.5, -18.6))
	end

	-- Rampas de hormigón.
	part({
		Class = "WedgePart",
		Size = Vector3.new(10, FLOOR, 6),
		CFrame = L(-22, FLOOR / 2, -21),
		Color = COLORS.stone,
		Material = Enum.Material.Concrete,
		Parent = building,
	})
	part({
		Class = "WedgePart",
		Size = Vector3.new(6, FLOOR, 5),
		CFrame = L(28, FLOOR / 2, -20.5),
		Color = COLORS.stone,
		Material = Enum.Material.Concrete,
		Parent = building,
	})

	-- Jardinera de hormigón bajo el ventanal del taller.
	part({
		Size = Vector3.new(21, 1.4, 1.8),
		CFrame = L(10.5, FLOOR + 0.7, -19.3),
		Color = COLORS.stone,
		Material = Enum.Material.Concrete,
		Parent = building,
	})
	grasses(building, L(10.5, FLOOR + 1.4, -19.3), 20, rng)

	building.Parent = model
	return ownerLabel
end

-- Interior de la galería ----------------------------------------------------------------------
local function buildGalleryInterior(model, L)
	local folder = Instance.new("Model")
	folder.Name = "GalleryInterior"

	-- Alfombra gris claro y banco de roble junto a la cristalera.
	part({
		Size = Vector3.new(16, 0.1, 10),
		CFrame = L(-22, FLOOR + 0.25, 3),
		Color = rgb(222, 222, 218),
		Material = Enum.Material.Fabric,
		CanCollide = false,
		Parent = folder,
	})
	part({
		Size = Vector3.new(8, 0.5, 2.4),
		CFrame = L(-31, FLOOR + 1.9, -11.5),
		Color = COLORS.wood,
		Material = Enum.Material.Wood,
		Parent = folder,
	})
	for _, x in ipairs({ -34, -28 }) do
		part({
			Size = Vector3.new(0.4, 1.7, 2.2),
			CFrame = L(x, FLOOR + 0.85, -11.5),
			Color = COLORS.charcoal,
			Material = Enum.Material.Metal,
			Parent = folder,
		})
	end

	-- Mostrador de recepción blanco con tapa de roble y pantalla.
	part({
		Size = Vector3.new(7, 3.8, 2.6),
		CFrame = L(-10, FLOOR + 1.9, -13),
		Color = COLORS.plaster,
		Material = Enum.Material.SmoothPlastic,
		Parent = folder,
	})
	part({
		Size = Vector3.new(7.4, 0.3, 3),
		CFrame = L(-10, FLOOR + 3.95, -13),
		Color = COLORS.wood,
		Material = Enum.Material.Wood,
		Parent = folder,
	})
	part({
		Size = Vector3.new(1.8, 1.1, 0.12),
		CFrame = L(-8.4, FLOOR + 4.8, -12.6) * CFrame.Angles(math.rad(-10), 0, 0),
		Color = COLORS.charcoal,
		Material = Enum.Material.Metal,
		Parent = folder,
	})

	-- Escultura abstracta sobre peana.
	part({
		Size = Vector3.new(3, 3.6, 3),
		CFrame = L(-36, FLOOR + 1.8, -14),
		Color = COLORS.plaster,
		Material = Enum.Material.SmoothPlastic,
		Parent = folder,
	})
	for i, size in ipairs({ 2.2, 1.6, 1.1 }) do
		part({
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(size, size, size),
			CFrame = L(-36 + (i - 2) * 0.25, FLOOR + 3.6 + (i - 0.5) * 1.5, -14),
			Color = i == 2 and COLORS.charcoal or rgb(214, 210, 202),
			Material = i == 2 and Enum.Material.Metal or Enum.Material.Concrete,
			Parent = folder,
		})
	end

	-- Plantas en las esquinas.
	buildPlant(folder, L(-36.5, FLOOR, 14.5), 1)
	buildPlant(folder, L(-7.5, FLOOR, 14.5), 1)

	-- Raíles de focos en el techo.
	for _, x in ipairs({ -31, -13 }) do
		part({
			Size = Vector3.new(0.4, 0.3, 30),
			CFrame = L(x, CEILING - 0.2, 0),
			Color = COLORS.charcoal,
			Material = Enum.Material.Metal,
			CanCollide = false,
			Parent = folder,
		})
	end
	for _, pos in ipairs({ Vector3.new(-31, 0, -4), Vector3.new(-13, 0, -4), Vector3.new(-22, 0, 8) }) do
		part({
			Size = Vector3.new(0.12, 3, 0.12),
			CFrame = L(pos.X, CEILING - 1.5, pos.Z),
			Color = COLORS.charcoal,
			CanCollide = false,
			Parent = folder,
		})
		part({
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(1.6, 2.4, 2.4),
			CFrame = cylinderUp(L(pos.X, CEILING - 3.6, pos.Z)),
			Color = COLORS.charcoal,
			Material = Enum.Material.Metal,
			CanCollide = false,
			Parent = folder,
		})
		local bulb = part({
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.1, 2, 2),
			CFrame = cylinderUp(L(pos.X, CEILING - 4.42, pos.Z)),
			Color = rgb(255, 238, 214),
			Material = Enum.Material.Neon,
			CanCollide = false,
			Parent = folder,
		})
		addLight(bulb, "PointLight", { Range = 24, Brightness = 1.1, Color = rgb(255, 232, 206), Shadows = true })
	end
	folder.Parent = model
end

-- Taller -------------------------------------------------------------------------------------
local function buildWorkshop(model, L)
	local workshop = Instance.new("Model")
	workshop.Name = "Workshop"

	-- Máquina de colores tipo "gumball" con cúpula de cristal llena de bolas.
	local machine = Instance.new("Model")
	machine.Name = "Machine"
	local mc = L(6, FLOOR, 7) * CFrame.Angles(0, math.rad(20), 0)
	local body = part({
		Name = "Body",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(6, 5.6, 5.6),
		CFrame = cylinderUp(mc * CFrame.new(0, 3, 0)),
		Color = rgb(206, 52, 56),
		Parent = machine,
	})
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.6, 6.4, 6.4),
		CFrame = cylinderUp(mc * CFrame.new(0, 0.3, 0)),
		Color = rgb(60, 50, 80),
		Material = Enum.Material.Metal,
		Parent = machine,
	})
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.8, 6.2, 6.2),
		CFrame = cylinderUp(mc * CFrame.new(0, 6.3, 0)),
		Color = COLORS.gold,
		Material = Enum.Material.Metal,
		Parent = machine,
	})
	local glow = part({
		Name = "Glow",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.35, 5.9, 5.9),
		CFrame = cylinderUp(mc * CFrame.new(0, 4.6, 0)),
		Color = rgb(170, 170, 185),
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = machine,
	})
	local dome = part({
		Name = "Dome",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(7.4, 7.4, 7.4),
		CFrame = mc * CFrame.new(0, 9.6, 0),
		Color = rgb(220, 240, 255),
		Material = Enum.Material.Glass,
		Transparency = 0.62,
		CanCollide = false,
		Parent = machine,
	})
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.8, 2.6, 2.6),
		CFrame = cylinderUp(mc * CFrame.new(0, 13.3, 0)),
		Color = COLORS.gold,
		Material = Enum.Material.Metal,
		Parent = machine,
	})
	part({
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(1.4, 1.4, 1.4),
		CFrame = mc * CFrame.new(0, 14.1, 0),
		Color = rgb(206, 52, 56),
		Parent = machine,
	})
	local balls = {}
	local ballRng = Random.new(7)
	for i = 1, 26 do
		local layer = math.floor((i - 1) / 9)
		local angle = i * 2.4
		local radius = 1 + ballRng:NextNumber() * 1.7
		local ball = part({
			Name = "Ball",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(1.3, 1.3, 1.3),
			CFrame = mc * CFrame.new(math.cos(angle) * radius, 7.3 + layer * 1.15, math.sin(angle) * radius),
			Color = RAINBOW[(i % #RAINBOW) + 1],
			CanCollide = false,
			Parent = machine,
		})
		table.insert(balls, ball)
	end
	-- Ranura, manivela y salida.
	part({
		Size = Vector3.new(2.4, 1.6, 0.6),
		CFrame = mc * CFrame.new(0, 3.6, -2.9),
		Color = rgb(250, 248, 244),
		Material = Enum.Material.Metal,
		Parent = machine,
	})
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.4, 1.6, 1.6),
		CFrame = mc * CFrame.new(0, 3.6, -3.25) * CFrame.Angles(0, math.rad(90), 0),
		Color = COLORS.gold,
		Material = Enum.Material.Metal,
		Parent = machine,
	})
	part({
		Size = Vector3.new(0.3, 1.8, 0.3),
		CFrame = mc * CFrame.new(0, 3.6, -3.45) * CFrame.Angles(0, 0, math.rad(35)),
		Color = COLORS.gold,
		Material = Enum.Material.Metal,
		Parent = machine,
	})
	local dispenser = part({
		Name = "Dispenser",
		Size = Vector3.new(2, 1.4, 1.4),
		CFrame = mc * CFrame.new(0, 1.5, -3),
		Color = rgb(60, 50, 80),
		Material = Enum.Material.Metal,
		Parent = machine,
	})
	local can = part({
		Name = "Can",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(1.3, 1.3, 1.3),
		CFrame = mc * CFrame.new(0, 1.6, -3.5),
		Color = rgb(200, 200, 204),
		Parent = machine,
	})
	local top = part({
		Name = "Top",
		Size = Vector3.new(1, 1, 1),
		CFrame = mc * CFrame.new(0, 16.5, 0),
		Transparency = 1,
		CanCollide = false,
		Parent = machine,
	})
	addLight(glow, "PointLight", { Range = 12, Brightness = 1.2, Color = rgb(255, 255, 255) })
	local machinePrompt = prompt(body, "Tirar color", "Máquina de colores", 12)
	-- Segundo aviso (tecla F) para encender o pausar el Auto-Rolling.
	local autoPrompt = prompt(dispenser, "Activar Auto-Rolling", "Máquina de colores", 12)
	autoPrompt.KeyboardKeyCode = Enum.KeyCode.F
	autoPrompt.GamepadKeyCode = Enum.KeyCode.ButtonY
	autoPrompt.Enabled = false
	machine.Parent = workshop
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.12, 11, 11),
		CFrame = cylinderUp(mc * CFrame.new(0, 0.26, 0)),
		Color = rgb(214, 214, 210),
		Material = Enum.Material.Fabric,
		CanCollide = false,
		Parent = workshop,
	})

	-- Mesa de dibujo: caballete grande, taburete y mesita con pinturas.
	local easelCanvas = buildEasel(workshop, L(23, FLOOR, 6) * CFrame.Angles(0, math.rad(-10), 0), 1.2)
	local drawPart = part({
		Name = "DrawPrompt",
		Size = Vector3.new(4, 4, 2),
		CFrame = L(23, FLOOR + 4, 3.5),
		Transparency = 1,
		CanCollide = false,
		Parent = workshop,
	})
	local drawPrompt = prompt(drawPart, "Pintar un cuadro", "Mesa de dibujo", 12)
	part({
		Size = Vector3.new(14, 0.08, 10),
		CFrame = L(23, FLOOR + 0.25, 4),
		Color = rgb(238, 228, 206),
		Material = Enum.Material.Fabric,
		CanCollide = false,
		Parent = workshop,
	})
	local splatRng = Random.new(3)
	for _ = 1, 14 do
		local d = splatRng:NextNumber(0.6, 1.6)
		part({
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.05, d, d),
			CFrame = cylinderUp(L(23 + splatRng:NextNumber(-6, 6), FLOOR + 0.3, 4 + splatRng:NextNumber(-4.5, 4.5))),
			Color = RAINBOW[splatRng:NextInteger(1, #RAINBOW)],
			CanCollide = false,
			CastShadow = false,
			Parent = workshop,
		})
	end
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.5, 2.8, 2.8),
		CFrame = cylinderUp(L(23, FLOOR + 3, 1)),
		Color = COLORS.workshopAccent,
		Material = Enum.Material.Leather,
		Parent = workshop,
	})
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(2.8, 0.5, 0.5),
		CFrame = cylinderUp(L(23, FLOOR + 1.5, 1)),
		Color = rgb(60, 50, 80),
		Material = Enum.Material.Metal,
		Parent = workshop,
	})
	part({
		Size = Vector3.new(3, 0.3, 3),
		CFrame = L(30, FLOOR + 3.2, 3),
		Color = COLORS.wood,
		Material = Enum.Material.Wood,
		Parent = workshop,
	})
	part({
		Size = Vector3.new(0.3, 3.2, 0.3),
		CFrame = L(30, FLOOR + 1.6, 3),
		Color = COLORS.darkWood,
		Parent = workshop,
	})
	for i = 0, 2 do
		part({
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(1.2, 0.6, 0.6),
			CFrame = cylinderUp(L(29.2 + i * 0.8, FLOOR + 3.9, 2.4)),
			Color = RAINBOW[i * 2 + 1],
			Parent = workshop,
		})
	end

	-- Banco de trabajo contra la pared de ladrillo.
	part({
		Size = Vector3.new(16, 0.6, 4),
		CFrame = L(18, FLOOR + 4, 14.4),
		Color = COLORS.wood,
		Material = Enum.Material.WoodPlanks,
		Parent = workshop,
	})
	for _, x in ipairs({ 10.6, 25.4 }) do
		part({
			Size = Vector3.new(0.6, 4, 3.4),
			CFrame = L(x, FLOOR + 2, 14.4),
			Color = COLORS.darkWood,
			Material = Enum.Material.Wood,
			Parent = workshop,
		})
	end
	for i = 0, 5 do
		local x = 11.5 + i * 2.4
		part({
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(1.6, 1, 1),
			CFrame = cylinderUp(L(x, FLOOR + 5.1, 14.6)),
			Color = rgb(220, 236, 250),
			Material = Enum.Material.Glass,
			Transparency = 0.3,
			Parent = workshop,
		})
		for j = 0, 2 do
			part({
				Size = Vector3.new(0.12, 2.4, 0.12),
				CFrame = L(x - 0.2 + j * 0.2, FLOOR + 5.9, 14.6) * CFrame.Angles(0, 0, math.rad(-8 + j * 8)),
				Color = RAINBOW[(i + j) % #RAINBOW + 1],
				CanCollide = false,
				Parent = workshop,
			})
		end
	end
	for i = 0, 2 do
		part({
			Size = Vector3.new(5 - i * 0.6, 6 - i * 0.6, 0.3),
			CFrame = L(31.5, FLOOR + 3 - i * 0.3, 15.6 - i * 0.5) * CFrame.Angles(math.rad(-8), 0, 0),
			Color = rgb(244, 236, 220),
			Parent = workshop,
		})
	end

	-- Estantes con botes de pintura (muestran tus colores más raros).
	local cans = {}
	for row = 0, 2 do
		part({
			Size = Vector3.new(2.4, 0.4, 16),
			CFrame = L(34, FLOOR + 3 + row * 3.4, -2),
			Color = COLORS.wood,
			Material = Enum.Material.Wood,
			Parent = workshop,
		})
		for i = 0, 7 do
			local shelfCan = part({
				Name = "ShelfCan",
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(1.6, 1.3, 1.3),
				CFrame = cylinderUp(L(34, FLOOR + 3.95 + row * 3.4, -8.2 + i * 1.75)),
				Color = rgb(230, 230, 236),
				Transparency = 0.7,
				Parent = workshop,
			})
			table.insert(cans, shelfCan)
		end
	end
	for _, z in ipairs({ -10.2, 6.2 }) do
		part({
			Size = Vector3.new(2.4, 10.6, 0.4),
			CFrame = L(34, FLOOR + 5.3, z),
			Color = COLORS.darkWood,
			Material = Enum.Material.Wood,
			Parent = workshop,
		})
	end

	-- Lámparas industriales y plantas.
	for _, pos in ipairs({ Vector3.new(6, 0, -4), Vector3.new(22, 0, -4), Vector3.new(14, 0, 8) }) do
		part({
			Size = Vector3.new(0.15, 3.4, 0.15),
			CFrame = L(pos.X, CEILING - 1.7, pos.Z),
			Color = rgb(40, 30, 50),
			CanCollide = false,
			Parent = workshop,
		})
		part({
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(1.6, 3.2, 3.2),
			CFrame = cylinderUp(L(pos.X, CEILING - 4, pos.Z)),
			Color = rgb(52, 60, 70),
			Material = Enum.Material.Metal,
			CanCollide = false,
			Parent = workshop,
		})
		local bulb = part({
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(1.4, 1.4, 1.4),
			CFrame = L(pos.X, CEILING - 4.9, pos.Z),
			Color = rgb(255, 236, 200),
			Material = Enum.Material.Neon,
			CanCollide = false,
			Parent = workshop,
		})
		addLight(bulb, "PointLight", { Range = 24, Brightness = 1.2, Color = rgb(255, 236, 210), Shadows = true })
	end
	buildPlant(workshop, L(-1.5, FLOOR, 14.5), 1)
	buildPlant(workshop, L(32.5, FLOOR, -14.5), 0.9)
	buildPlant(workshop, L(-1.5, FLOOR, -14.5), 0.9)

	workshop.Parent = model
	return {
		model = workshop,
		easelCanvas = easelCanvas,
		drawPrompt = drawPrompt,
		machinePrompt = machinePrompt,
		autoPrompt = autoPrompt,
		machineTop = top,
		machineCan = can,
		machineGlow = glow,
		machineBalls = balls,
		machineDome = dome,
		shelfCans = cans,
	}
end

-- Exterior: plaza, camino, jardín, calle y bosque -------------------------------------------------
local function buildGrounds(model, L, origin, rng)
	local grounds = Instance.new("Model")
	grounds.Name = "Grounds"

	-- Plaza de losas grandes frente al edificio y camino hasta la verja.
	part({
		Size = Vector3.new(86, 0.3, 28),
		CFrame = L(-2, 0.15, -34),
		Color = COLORS.path,
		Material = Enum.Material.Pavement,
		Parent = grounds,
	})
	for x = -42, 38, 6 do
		part({
			Size = Vector3.new(0.12, 0.31, 28),
			CFrame = L(x + 3, 0.16, -34),
			Color = rgb(190, 188, 182),
			CanCollide = false,
			CastShadow = false,
			Parent = grounds,
		})
	end
	part({
		Size = Vector3.new(88, 0.32, 1.2),
		CFrame = L(-2, 0.16, -48.4),
		Color = COLORS.stone,
		Material = Enum.Material.Concrete,
		Parent = grounds,
	})
	part({
		Size = Vector3.new(8, 0.3, 56),
		CFrame = L(-22, 0.15, -76),
		Color = COLORS.path,
		Material = Enum.Material.Pavement,
		Parent = grounds,
	})
	buildFountain(grounds, L(8, 0.3, -34))
	for _, pos in ipairs({ { -36, -42 }, { 24, -44 } }) do
		buildBench(grounds, L(pos[1], 0.3, pos[2]) * CFrame.Angles(0, math.pi, 0))
	end

	-- Farolas a lo largo del camino y la plaza.
	for z = -96, -54, 14 do
		buildLampPost(grounds, L(-27.5, 0.3, z))
		buildLampPost(grounds, L(-16.5, 0.3, z))
	end
	for _, x in ipairs({ -43, 39 }) do
		buildLampPost(grounds, L(x, 0.3, -46))
	end

	-- Jardineras y arbustos alrededor de la plaza.
	buildFlowerBed(grounds, L(-38, 0.3, -30), 6, 5, rng)
	buildFlowerBed(grounds, L(30, 0.3, -28), 6, 4, rng)
	for _, pos in ipairs({ { -46, -24 }, { 42, -22 }, { -46, 14 }, { 42, 14 }, { -48, -5 }, { 44, -5 } }) do
		buildBush(grounds, L(pos[1], 0, pos[2]), 1.2)
	end

	-- Seto que rodea el terreno con una verja en el camino.
	local hedgeH = 5
	local half = 104
	local function hedge(axis, fixed, a, b)
		if b - a > 0.5 then
			local center = (a + b) / 2
			local cf = axis == "z" and L(center, hedgeH / 2, fixed) or L(fixed, hedgeH / 2, center)
			local size = axis == "z" and Vector3.new(b - a, hedgeH, 3.5) or Vector3.new(3.5, hedgeH, b - a)
			part({
				Size = size,
				CFrame = cf,
				Color = COLORS.hedge,
				Material = Enum.Material.LeafyGrass,
				Parent = grounds,
			})
		end
	end
	for _, side in ipairs({ { "x", -half }, { "x", half }, { "z", -half }, { "z", half } }) do
		local axis, fixed = side[1], side[2]
		local from = -half
		while from < half do
			local to = math.min(from + 26, half)
			if axis == "z" and fixed == -half and from < -17 and to > -27 then
				hedge(axis, fixed, from, -30)
				hedge(axis, fixed, -14, to)
			else
				hedge(axis, fixed, from, to)
			end
			from = to
		end
	end
	-- Pilares de la verja con faroles y arco con el nombre.
	for _, x in ipairs({ -28.5, -15.5 }) do
		part({
			Size = Vector3.new(2.6, 10, 2.6),
			CFrame = L(x, 5, -half),
			Color = COLORS.stone,
			Material = Enum.Material.Concrete,
			Parent = grounds,
		})
		local lantern = part({
			Size = Vector3.new(2.7, 0.3, 2.7),
			CFrame = L(x, 10.15, -half),
			Color = rgb(255, 236, 206),
			Material = Enum.Material.Neon,
			Parent = grounds,
		})
		addLight(lantern, "PointLight", { Range = 14, Brightness = 0.9, Color = rgb(255, 226, 190) })
	end
	part({
		Size = Vector3.new(15.6, 2, 0.6),
		CFrame = L(-22, 11.3, -half),
		Color = COLORS.charcoal,
		Material = Enum.Material.Metal,
		Parent = grounds,
	})
	local gateSign = part({
		Size = Vector3.new(15, 1.6, 0.2),
		CFrame = L(-22, 11.3, -half - 0.35),
		Color = COLORS.charcoal,
		Material = Enum.Material.Metal,
		Parent = grounds,
	})
	local gateLabel = surfaceText(
		gateSign,
		Enum.NormalId.Front,
		"Galería",
		{ pps = 24, color = rgb(255, 255, 255), font = Enum.Font.BuilderSansBold }
	)

	-- Calle y aceras por donde llegan los visitantes.
	part({
		Size = Vector3.new(420, 0.3, 6),
		CFrame = L(0, 0.15, -110),
		Color = rgb(214, 210, 204),
		Material = Enum.Material.Pavement,
		Parent = grounds,
	})
	part({
		Size = Vector3.new(420, 0.25, 16),
		CFrame = L(0, 0.12, -121),
		Color = COLORS.asphalt,
		Material = Enum.Material.Asphalt,
		Parent = grounds,
	})
	for x = -204, 204, 12 do
		part({
			Size = Vector3.new(5, 0.27, 0.5),
			CFrame = L(x, 0.14, -121),
			Color = rgb(250, 220, 90),
			CanCollide = false,
			Parent = grounds,
		})
	end
	part({
		Size = Vector3.new(420, 0.3, 6),
		CFrame = L(0, 0.15, -132),
		Color = rgb(214, 210, 204),
		Material = Enum.Material.Pavement,
		Parent = grounds,
	})

	-- Estanque con rocas y bancos.
	local terrain = Workspace.Terrain
	local pondCenter = origin + Vector3.new(66, 0, -66)
	terrain:FillCylinder(CFrame.new(pondCenter + Vector3.new(0, -2, 0)), 4, 15, Enum.Material.Air)
	terrain:FillCylinder(CFrame.new(pondCenter + Vector3.new(0, -2.5, 0)), 3, 15, Enum.Material.Water)
	for i = 0, 9 do
		local angle = i / 10 * math.pi * 2
		terrain:FillBall(
			pondCenter + Vector3.new(math.cos(angle) * 16, -0.5, math.sin(angle) * 16),
			rng:NextNumber(2, 3.2),
			Enum.Material.Rock
		)
	end
	buildBench(grounds, CFrame.new(pondCenter + Vector3.new(0, 0, 21)) * CFrame.Angles(0, math.pi, 0))
	buildBench(grounds, CFrame.new(pondCenter + Vector3.new(-21, 0, 0)) * CFrame.Angles(0, -math.pi / 2, 0))
	for i = 1, 3 do
		part({
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.2, 2.6, 2.6),
			CFrame = cylinderUp(CFrame.new(pondCenter + Vector3.new(-6 + i * 4, -0.4, -4 + i * 2.5))),
			Color = rgb(110, 190, 100),
			CanCollide = false,
			Parent = grounds,
		})
	end

	-- Árboles dentro del terreno y bosque alrededor.
	local inside = {
		{ -78, -70 },
		{ -70, -30 },
		{ -85, 10 },
		{ -66, 50 },
		{ -30, 72 },
		{ 10, 80 },
		{ 52, 60 },
		{ 82, 30 },
		{ 88, -10 },
		{ -50, 88 },
		{ 30, -86 },
		{ 75, -95 },
		{ -60, -92 },
	}
	for i, pos in ipairs(inside) do
		buildTree(grounds, L(pos[1], 0, pos[2]), rng:NextNumber(1, 1.4), rng, i % 4 == 0)
	end
	for i = 1, 46 do
		local angle = i / 46 * math.pi * 2
		local radius = rng:NextNumber(118, 175)
		local x, z = math.cos(angle) * radius, math.sin(angle) * radius
		if z > -100 or z < -140 then
			buildTree(grounds, L(x, 0, z), rng:NextNumber(1.2, 1.8), rng, i % 5 == 0)
		end
	end

	grounds.Parent = model
	return gateLabel
end

-- Terreno (césped y colinas) -------------------------------------------------------------------
local function fillTerrain(origin, rng)
	local terrain = Workspace.Terrain
	terrain:FillBlock(CFrame.new(origin + Vector3.new(0, -8, 0)), Vector3.new(440, 16, 440), Enum.Material.Grass)
	for i = 1, 18 do
		local angle = i / 18 * math.pi * 2 + rng:NextNumber(-0.1, 0.1)
		local radius = rng:NextNumber(190, 215)
		local x, z = math.cos(angle) * radius, math.sin(angle) * radius
		-- Sin colinas sobre la calle.
		if z > -70 or z < -175 then
			terrain:FillBall(origin + Vector3.new(x, -10, z), rng:NextNumber(26, 40), Enum.Material.Grass)
		end
	end
end

local function clearTerrain(origin)
	Workspace.Terrain:FillBlock(
		CFrame.new(origin + Vector3.new(0, 10, 0)),
		Vector3.new(500, 80, 500),
		Enum.Material.Air
	)
end

-- API ----------------------------------------------------------------------------------------------
function WorldBuilder.setDecorLevel(plot, level)
	if level < plot.decorBuilt then
		plot.decorFolder:ClearAllChildren()
		plot.decorBuilt = 0
	end
	for i = plot.decorBuilt + 1, math.min(level, #DECOR_BUILDERS) do
		local folder = Instance.new("Folder")
		folder.Name = "Decor" .. i
		DECOR_BUILDERS[i](folder, plot.L)
		folder.Parent = plot.decorFolder
		plot.decorBuilt = i
	end
end

function WorldBuilder.setOwnerName(plot, name)
	plot.signLabel.Text = "Galería de " .. name
	plot.gateLabel.Text = "Galería de " .. name
end

-- Plataforma de aparición: los personajes nacen aquí un instante y el servidor
-- los lleva enseguida a su propio terreno (la pantalla de carga lo tapa).
function WorldBuilder.buildSpawn()
	setupLighting()
	if Workspace:FindFirstChild("Llegada") then
		return
	end
	local folder = Instance.new("Model")
	folder.Name = "Llegada"
	part({
		Name = "Base",
		Size = Vector3.new(60, 2, 60),
		CFrame = CFrame.new(0, 199, 0),
		Color = COLORS.cream,
		Material = Enum.Material.Marble,
		Parent = folder,
	})
	local spawn = part({
		Class = "SpawnLocation",
		Name = "Aparicion",
		Size = Vector3.new(12, 1, 12),
		CFrame = CFrame.new(0, 200.5, 0),
		Color = COLORS.charcoal,
		Neutral = true,
		Duration = 0,
		Parent = folder,
	})
	local decal = spawn:FindFirstChildOfClass("Decal")
	if decal then
		decal:Destroy()
	end
	folder.Parent = Workspace
end

function WorldBuilder.buildLot(slot)
	setupLighting()
	local plotsFolder = Workspace:FindFirstChild("Plots")
	if not plotsFolder then
		plotsFolder = Instance.new("Folder")
		plotsFolder.Name = "Plots"
		plotsFolder.Parent = Workspace
	end

	local origin = Vector3.new(slot * LOT_SPACING, 0, 0)
	local function L(x, y, z)
		return CFrame.new(origin + Vector3.new(x, y, z))
	end
	local rng = Random.new(slot * 7919 + 13)
	fillTerrain(origin, rng)

	local model = Instance.new("Model")
	model.Name = "Lot" .. slot
	model:SetAttribute("Slot", slot)
	model:SetAttribute("OwnerUserId", 0)
	model.WorldPivot = CFrame.new(origin)
	pcall(function()
		model.ModelStreamingMode = Enum.ModelStreamingMode.PersistentPerPlayer
	end)

	local signLabel = buildBuilding(model, L)
	buildGalleryInterior(model, L)
	local workshop = buildWorkshop(model, L)
	local gateLabel = buildGrounds(model, L, origin, rng)

	local gallery = Instance.new("Folder")
	gallery.Name = "Gallery"
	gallery.Parent = model
	local y = FLOOR + 10.5
	local frameCFrames = {
		L(-34, y, 16.6),
		L(-22, y, 16.6),
		L(-10, y, 16.6),
		L(-38.6, y, 7) * CFrame.Angles(0, -math.pi / 2, 0),
		L(-38.6, y, -5) * CFrame.Angles(0, -math.pi / 2, 0),
		L(-5.4, y, 11) * CFrame.Angles(0, math.pi / 2, 0),
		L(-5.4, y, 1) * CFrame.Angles(0, math.pi / 2, 0),
	}
	local canvases, plaques, standPoints = {}, {}, {}
	for i = 1, Config.GALLERY_SIZE do
		canvases[i], plaques[i] = buildFrame(gallery, frameCFrames[i], "Frame" .. i)
		canvases[i]:SetAttribute("Slot", i)
		-- Dónde se para un visitante para mirar el cuadro.
		local front = frameCFrames[i] * CFrame.new(0, 0, -7)
		standPoints[i] = CFrame.lookAt(
			Vector3.new(front.X, FLOOR, front.Z),
			Vector3.new(frameCFrames[i].X, FLOOR, frameCFrames[i].Z)
		)
	end

	local decor = Instance.new("Folder")
	decor.Name = "Decor"
	decor.Parent = model
	local visitors = Instance.new("Folder")
	visitors.Name = "Visitors"
	visitors.Parent = model

	model.Parent = plotsFolder

	return {
		index = slot,
		slot = slot,
		model = model,
		origin = origin,
		L = L,
		signLabel = signLabel,
		gateLabel = gateLabel,
		canvases = canvases,
		plaques = plaques,
		standPoints = standPoints,
		-- Recorrido de los visitantes: de la acera a la galería y de vuelta.
		route = {
			L(-90, 0.3, -110),
			L(-22, 0.3, -110),
			L(-22, 0.3, -80),
			L(-22, 0.3, -50),
			L(-22, 0.3, -26),
			L(-22, FLOOR, -12),
			L(-22, FLOOR, -5),
		},
		exitRoute = {
			L(-22, FLOOR, -12),
			L(-22, 0.3, -26),
			L(-22, 0.3, -50),
			L(-22, 0.3, -80),
			L(-22, 0.3, -110),
			L(90, 0.3, -110),
		},
		-- Apareces dentro del taller, entre la máquina y el caballete.
		ownerSpawn = CFrame.lookAt(
			origin + Vector3.new(15, FLOOR + 3.5, -3),
			origin + Vector3.new(15, FLOOR + 3.5, 10)
		),
		decorFolder = decor,
		visitorsFolder = visitors,
		workshop = workshop,
		decorBuilt = 0,
	}
end

function WorldBuilder.destroyLot(plot)
	plot.model:Destroy()
	clearTerrain(plot.origin)
end

return WorldBuilder
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="15">
    <Properties>
      <string name="Name">SoundService</string>
      <bool name="RespectFilteringEnabled">true</bool>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="16">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">80</float>
      <float name="CharacterWalkSpeed">20</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="17">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="18">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="LocalScript" referent="19">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- Punto de entrada del cliente: conecta las ventanas con el servidor.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")

local UI = script.Parent:WaitForChild("UI")
local Theme = require(UI.Theme)
local HUD = require(UI.HUD)
local Machine = require(UI.Machine)
local DesignPicker = require(UI.DesignPicker)
local ColorPicker = require(UI.ColorPicker)
local Painter = require(UI.Painter)
local Shop = require(UI.Shop)
local Daily = require(UI.Daily)
local Tutorial = require(UI.Tutorial)
local World = require(script.Parent:WaitForChild("World"))

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Colors = require(Shared.Colors)

local remotes = ReplicatedStorage:WaitForChild("Remotes")

local app = { state = nil, remotes = {} }
for _, name in ipairs({
	"GetState",
	"StateChanged",
	"Notify",
	"RollResult",
	"OpenDesigns",
	"UnlockDesign",
	"StartPainting",
	"CancelPainting",
	"FinishPainting",
	"BuyUpgrade",
	"ClaimDaily",
	"ClaimQuest",
	"GoHome",
}) do
	app.remotes[name] = remotes:WaitForChild(name)
end

-- Último cuadro empezado (para retomarlo si se cierra la ventana).
local lastPainting = nil

function app.notify(text, kind)
	HUD.notify(text, kind)
end

function app.celebrate()
	HUD.celebrate()
end

function app.openShop()
	Shop.open()
end

function app.openCollection()
	Machine.openCollection()
end

function app.openDaily()
	Daily.open()
end

function app.openDesigns()
	if Painter.isOpen() then
		return
	end
	DesignPicker.open()
end

function app.openColorPicker(design)
	ColorPicker.open(design)
end

function app.openPainter(design, colors)
	lastPainting = { design = design, colors = colors }
	Painter.open(design, colors)
end

function app.resumePainting()
	if Painter.isOpen() then
		return
	end
	if lastPainting and app.state and app.state.painting == lastPainting.design.id then
		Painter.open(lastPainting.design, lastPainting.colors)
	else
		app.remotes.CancelPainting:FireServer()
	end
end

-- ¿Hay alguna ventana grande abierta? (oculta el tutorial mientras tanto)
function app.isBusy()
	return Painter.isOpen() or DesignPicker.isOpen()
end

function app.setHudVisible(visible)
	HUD.setVisible(visible)
	Machine.setVisible(visible)
end

local claimingQuest = false
function app.claimQuest(index)
	if claimingQuest then
		return
	end
	claimingQuest = true
	local ok, success, result = pcall(function()
		return app.remotes.ClaimQuest:InvokeServer(index)
	end)
	claimingQuest = false
	if ok and success and type(result) == "table" then
		Theme.playSound("success", 1.15)
		app.notify("📜 ¡Misión completada! +💵" .. Theme.formatNumber(result.reward), "gold")
		local bonus = Colors.ById[result.bonusColor or ""]
		if bonus then
			app.notify("🎉 ¡Bonus del día! Ganaste «" .. bonus.name .. "»", "gold")
			app.celebrate()
		end
	end
end

local function applyState(state)
	if type(state) ~= "table" then
		return
	end
	app.state = state
	HUD.applyState(state)
	Machine.applyState(state)
	Shop.refresh()
	DesignPicker.refresh()
	ColorPicker.refresh()
	Daily.refresh()
end

pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
end)

HUD.init(app)
Machine.init(app)
DesignPicker.init(app)
ColorPicker.init(app)
Painter.init(app)
Shop.init(app)
Daily.init(app)
Tutorial.init(app)
World.start()

app.remotes.StateChanged.OnClientEvent:Connect(applyState)
app.remotes.Notify.OnClientEvent:Connect(function(text, kind)
	app.notify(text, kind)
end)
app.remotes.RollResult.OnClientEvent:Connect(function(colorId, auto)
	Machine.onRoll(colorId, auto)
end)
app.remotes.OpenDesigns.OnClientEvent:Connect(function()
	app.openDesigns()
end)

task.spawn(function()
	local ok, state = pcall(function()
		return app.remotes.GetState:InvokeServer()
	end)
	if ok and state and not app.state then
		applyState(state)
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="20">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="21">
            <Properties>
              <string name="Name">ColorPicker</string>
              <string name="Source"><![CDATA[-- Ventana "Elige tus colores": un color por área antes de empezar a pintar.
-- Los colores raros multiplican el valor del cuadro.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Colors = require(Shared.Colors)
local Config = require(Shared.Config)

local Theme = require(script.Parent.Theme)
local DesignArt = require(script.Parent.DesignArt)

local ColorPicker = {}

local C = Theme.Colors

local app
local window
local refs = {}
local design
local choices = {}
local selectedArea
local preview
local areaRows = {}
local remembered = {}
local busy = false

local function owned(colorId)
	local entry = Colors.ById[colorId]
	if entry and entry.basic then
		return math.huge
	end
	return app.state and app.state.paints[colorId] or 0
end

-- Unidades libres de un color sin contar el área indicada.
local function remaining(colorId, exceptArea)
	local used = 0
	for areaId, chosen in pairs(choices) do
		if chosen == colorId and areaId ~= exceptArea then
			used += 1
		end
	end
	return owned(colorId) - used
end

local function rarityInfo(colorId)
	local entry = Colors.ById[colorId]
	local rarity = Colors.rarityOf(entry)
	return rarity, string.format("%s x%.1f", rarity.name, rarity.mult)
end

local function updateValue()
	if not design then
		return
	end
	local state = app.state
	local mult = Config.colorMultiplier(design, choices)
	local value = Config.paintingValue(design, choices, state.upgrades, state.made[design.id] or 0, 1)
	refs.multiplier.Text = string.format("x%.2f", mult)
	refs.value.Text = "💵 "
		.. Theme.formatNumber(value)
		.. "  (hasta "
		.. Theme.formatNumber(math.floor(value * (1 + Config.STAR_BONUS[3])))
		.. " con ⭐⭐⭐)"
	refs.multBar.Set(math.clamp((mult - 1) / 5, 0, 1), true)
	preview.setColors(choices)
end

local function refreshAreas()
	for _, row in pairs(areaRows) do
		local areaId = row.area.id
		local selected = areaId == selectedArea
		row.stroke.Color = selected and C.Primary or C.Border
		row.stroke.Thickness = selected and 2 or 1
		DesignArt.swatch(row.swatch, choices[areaId])
		local entry = Colors.ById[choices[areaId]]
		local rarity = rarityInfo(choices[areaId])
		row.colorName.Text = entry and entry.name or ""
		row.colorName.TextColor3 = entry and entry.basic and C.InkSoft or rarity.color:Lerp(C.Ink, 0.25)
	end
end

local function sortedColors()
	local list = {}
	for _, entry in ipairs(Colors.List) do
		if not entry.basic and owned(entry.id) > 0 then
			table.insert(list, entry)
		end
	end
	table.sort(list, function(a, b)
		local ra, rb = Colors.rarityOf(a).index, Colors.rarityOf(b).index
		if ra ~= rb then
			return ra > rb
		end
		return a.index < b.index
	end)
	for _, entry in ipairs(Colors.List) do
		if entry.basic then
			table.insert(list, entry)
		end
	end
	return list
end

local function refreshColors()
	local area = design.areaById[selectedArea]
	refs.colorsTitle.Text = "Pintura para «" .. area.name .. "»"
	for _, child in ipairs(refs.grid:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	for order, entry in ipairs(sortedColors()) do
		local free = remaining(entry.id, selectedArea)
		local selected = choices[selectedArea] == entry.id
		local rarity, rarityLabel = rarityInfo(entry.id)
		local holder, body = Theme.card({
			Name = entry.id,
			Size = UDim2.fromOffset(112, 128),
			Radius = 12,
			LayoutOrder = order,
			StrokeColor = selected and C.Primary or C.Border,
			StrokeThickness = selected and 2 or 1,
			Parent = refs.grid,
		})
		local cell = Theme.new("TextButton", {
			Name = entry.id,
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Text = "",
			ZIndex = 3,
			Parent = body,
		})
		local swatch = Theme.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0, 10),
			Size = UDim2.fromOffset(58, 58),
			Parent = body,
		}, { Theme.round() })
		DesignArt.swatch(swatch, entry.id)
		Theme.stroke(entry.basic and C.Border or rarity.color, 2.5).Parent = swatch
		Theme.label({
			Position = UDim2.fromOffset(4, 72),
			Size = UDim2.new(1, -8, 0, 18),
			Text = entry.name,
			Font = Theme.Fonts.Bold,
			MaxTextSize = 15,
			Parent = body,
		})
		Theme.chip({
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0, 94),
			Size = UDim2.new(1, -12, 0, 22),
			Color = C.PanelSoft,
			TextColor3 = entry.basic and C.InkSoft or rarity.color:Lerp(C.Ink, 0.3),
			Text = entry.basic and "Básico · ∞" or (rarityLabel .. " · " .. owned(entry.id)),
			MaxTextSize = 12,
			Parent = body,
		})
		if free <= 0 and not selected then
			body.BackgroundTransparency = 0.4
			swatch.BackgroundTransparency = 0.6
		end
		cell.Activated:Connect(function()
			if remaining(entry.id, selectedArea) <= 0 then
				app.notify("Ya usaste todo tu «" .. entry.name .. "» 🎨", "error")
				return
			end
			Theme.playSound("click", 1.2)
			choices[selectedArea] = entry.id
			local index = design.areaById[selectedArea].index
			local nextArea = design.areas[index + 1]
			if nextArea then
				selectedArea = nextArea.id
			end
			refreshAreas()
			refreshColors()
			updateValue()
		end)
		holder.Name = entry.id
	end
end

-- Asigna los colores más valiosos a las áreas más grandes.
local function autoPick()
	local areas = {}
	for _, area in ipairs(design.areas) do
		table.insert(areas, area)
		choices[area.id] = area.default
	end
	table.sort(areas, function(a, b)
		return a.weight > b.weight
	end)
	local pool = {}
	for _, entry in ipairs(Colors.List) do
		if not entry.basic then
			for _ = 1, owned(entry.id) do
				table.insert(pool, entry)
			end
		end
	end
	table.sort(pool, function(a, b)
		return Colors.rarityOf(a).mult > Colors.rarityOf(b).mult
	end)
	for i, area in ipairs(areas) do
		local entry = pool[i]
		if entry and Colors.rarityOf(entry).mult > 1 then
			choices[area.id] = entry.id
		end
	end
	refreshAreas()
	refreshColors()
	updateValue()
	Theme.playSound("success", 1.3)
end

local function build(parent)
	-- Izquierda: vista previa y áreas.
	local _, left = Theme.card({
		Position = UDim2.fromOffset(18, 14),
		Size = UDim2.new(0, 330, 1, -28),
		Radius = 16,
		Parent = parent,
	})
	local previewBox = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 14),
		Size = UDim2.fromOffset(200, 200),
		BackgroundColor3 = C.White,
		Parent = left,
	}, { Theme.corner(12), Theme.stroke(C.Border, 1) })
	refs.previewBox = Theme.new(
		"Frame",
		{ Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = previewBox },
		{
			Theme.corner(12),
		}
	)
	refs.areas = Theme.new("ScrollingFrame", {
		Position = UDim2.fromOffset(10, 224),
		Size = UDim2.new(1, -20, 1, -234),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 5,
		ScrollBarImageColor3 = C.InkFaint,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = left,
	}, {
		Theme.list("v", 6),
		Theme.new("UIPadding", {
			PaddingTop = UDim.new(0, 3),
			PaddingLeft = UDim.new(0, 3),
			PaddingRight = UDim.new(0, 10),
			PaddingBottom = UDim.new(0, 6),
		}),
	})

	-- Derecha: colores.
	refs.colorsTitle = Theme.label({
		Position = UDim2.fromOffset(366, 12),
		Size = UDim2.new(1, -600, 0, 32),
		Text = "",
		Font = Theme.Fonts.Heavy,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 21,
		Parent = parent,
	})
	Theme.button({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -20, 0, 10),
		Size = UDim2.fromOffset(210, 40),
		Text = "✨ Mejores colores",
		Variant = "ghost",
		TextColor = C.Primary,
		MaxTextSize = 17,
		Parent = parent,
		OnClick = function()
			autoPick()
		end,
	})
	refs.grid = Theme.new("ScrollingFrame", {
		Position = UDim2.fromOffset(360, 56),
		Size = UDim2.new(1, -378, 1, -160),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = C.InkFaint,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = parent,
	}, {
		Theme.new("UIGridLayout", {
			CellSize = UDim2.fromOffset(112, 128),
			CellPadding = UDim2.fromOffset(10, 12),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
		Theme.new(
			"UIPadding",
			{ PaddingTop = UDim.new(0, 4), PaddingLeft = UDim.new(0, 6), PaddingBottom = UDim.new(0, 8) }
		),
	})

	-- Barra inferior con el valor.
	local _, footer = Theme.card({
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 360, 1, -14),
		Size = UDim2.new(1, -378, 0, 84),
		Radius = 16,
		Parent = parent,
	})
	Theme.label({
		Position = UDim2.fromOffset(16, 10),
		Size = UDim2.fromOffset(170, 18),
		Text = "Valor del cuadro",
		Font = Theme.Fonts.Bold,
		TextColor3 = C.InkSoft,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 13,
		Parent = footer,
	})
	refs.multiplier = Theme.label({
		Position = UDim2.fromOffset(16, 28),
		Size = UDim2.fromOffset(110, 40),
		Text = "x1.00",
		Font = Theme.Fonts.Heavy,
		TextColor3 = C.Ink,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 30,
		Parent = footer,
	})
	refs.value = Theme.label({
		Position = UDim2.fromOffset(130, 32),
		Size = UDim2.new(1, -390, 0, 24),
		Text = "",
		Font = Theme.Fonts.Bold,
		TextColor3 = C.MintDark,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 17,
		Parent = footer,
	})
	refs.multBar = Theme.progress({
		Position = UDim2.fromOffset(130, 60),
		Size = UDim2.new(1, -390, 0, 6),
		Gradient = "primary",
		Parent = footer,
	})
	refs.continue = Theme.button({
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0.5, 0),
		Size = UDim2.fromOffset(210, 50),
		Text = "Empezar a pintar",
		Variant = "primary",
		Radius = 12,
		Parent = footer,
		OnClick = function()
			ColorPicker.confirm()
		end,
	})
end

function ColorPicker.open(newDesign)
	design = newDesign
	choices = {}
	local saved = remembered[design.id] or {}
	for _, area in ipairs(design.areas) do
		local colorId = saved[area.id]
		if not colorId or owned(colorId) <= 0 then
			colorId = area.default
		end
		choices[area.id] = colorId
	end
	for _, area in ipairs(design.areas) do
		if remaining(choices[area.id], nil) < 0 then
			choices[area.id] = area.default
		end
	end
	selectedArea = design.areas[1].id

	window.Title.Text = "Elige tus colores · " .. design.name
	window.Subtitle.Text = "Un color para cada una de sus " .. #design.areas .. " zonas. Los colores raros valen más."
	preview = DesignArt.render(refs.previewBox, design, { mode = "color", colors = choices, outline = false })

	for _, row in pairs(areaRows) do
		row.holder:Destroy()
	end
	areaRows = {}
	for _, area in ipairs(design.areas) do
		local holder, body = Theme.card({
			Size = UDim2.new(1, 0, 0, 48),
			Radius = 12,
			LayoutOrder = area.index,
			Parent = refs.areas,
		})
		local button = Theme.new("TextButton", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Text = "",
			ZIndex = 3,
			Parent = body,
		})
		local swatch = Theme.new("Frame", {
			Position = UDim2.fromOffset(10, 9),
			Size = UDim2.fromOffset(30, 30),
			Parent = body,
		}, { Theme.round(), Theme.stroke(C.Border, 1) })
		Theme.label({
			Position = UDim2.fromOffset(48, 6),
			Size = UDim2.new(0.5, -40, 1, -12),
			Text = area.name,
			Font = Theme.Fonts.Bold,
			TextXAlignment = Enum.TextXAlignment.Left,
			MaxTextSize = 17,
			Parent = body,
		})
		local colorName = Theme.label({
			Position = UDim2.new(0.5, 0, 0, 8),
			Size = UDim2.new(0.5, -12, 1, -16),
			Text = "",
			Font = Theme.Fonts.Heavy,
			TextXAlignment = Enum.TextXAlignment.Right,
			MaxTextSize = 14,
			Parent = body,
		})
		button.Activated:Connect(function()
			Theme.playSound("click", 1.1)
			selectedArea = area.id
			refreshAreas()
			refreshColors()
		end)
		areaRows[area.id] = {
			area = area,
			holder = holder,
			body = body,
			stroke = body:FindFirstChildOfClass("UIStroke"),
			swatch = swatch,
			colorName = colorName,
		}
	end

	refreshAreas()
	refreshColors()
	updateValue()
	window.Open()
end

function ColorPicker.refresh()
	if design and window.Holder.Visible then
		refreshColors()
		updateValue()
	end
end

function ColorPicker.confirm()
	if busy or not design then
		return
	end
	busy = true
	local ok, success, message = pcall(function()
		return app.remotes.StartPainting:InvokeServer(design.id, choices)
	end)
	busy = false
	if ok and success then
		remembered[design.id] = table.clone(choices)
		window.Close()
		app.openPainter(design, choices)
	else
		app.notify(ok and message or "No se pudo empezar.", "error")
	end
end

function ColorPicker.init(appRef)
	app = appRef
	local gui = Theme.new("ScreenGui", {
		Name = "ColorPicker",
		ResetOnSpawn = false,
		DisplayOrder = 13,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = Players.LocalPlayer:WaitForChild("PlayerGui"),
	})
	window = Theme.window({
		Name = "Window",
		Parent = gui,
		Size = UDim2.fromOffset(1010, 650),
		Title = "Elige tus colores",
	})
	build(window.Body)
end

return ColorPicker
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="22">
            <Properties>
              <string name="Name">Daily</string>
              <string name="Source"><![CDATA[-- Ventana del regalo diario: racha de 7 días con monedas y un color raro.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Colors = require(Shared.Colors)
local Config = require(Shared.Config)

local Theme = require(script.Parent.Theme)

local Daily = {}

local C = Theme.Colors

local app
local window
local tiles = {}
local claimButton
local claiming = false

local function buildTiles(parent)
	local row = Theme.new("Frame", {
		Position = UDim2.fromOffset(20, 22),
		Size = UDim2.new(1, -40, 0, 156),
		BackgroundTransparency = 1,
		Parent = parent,
	}, { Theme.list("h", 10, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center) })
	for day = 1, 7 do
		local big = day == 7
		local _, body = Theme.card({
			Name = "Day" .. day,
			Size = UDim2.fromOffset(big and 120 or 92, 150),
			Radius = 14,
			LayoutOrder = day,
			Parent = row,
		})
		local title = Theme.label({
			Position = UDim2.fromOffset(4, 10),
			Size = UDim2.new(1, -8, 0, 22),
			Text = big and "Día 7 · ¡Premio!" or ("Día " .. day),
			Font = Theme.Fonts.Heavy,
			TextColor3 = C.InkSoft,
			MaxTextSize = 17,
			Parent = body,
		})
		local icon = Theme.label({
			Position = UDim2.fromOffset(4, 36),
			Size = UDim2.new(1, -8, 0, 46),
			Text = big and "👑" or "🎁",
			MaxTextSize = big and 44 or 38,
			Parent = body,
		})
		local amount = Theme.label({
			Position = UDim2.fromOffset(4, 88),
			Size = UDim2.new(1, -8, 0, 22),
			Text = "",
			Font = Theme.Fonts.Heavy,
			TextColor3 = C.Ink,
			MaxTextSize = 18,
			Parent = body,
		})
		Theme.label({
			Position = UDim2.fromOffset(4, 114),
			Size = UDim2.new(1, -8, 0, 18),
			Text = big and "+ color Épico" or "+ color raro",
			Font = Theme.Fonts.Medium,
			TextColor3 = C.InkSoft,
			MaxTextSize = 13,
			Parent = body,
		})
		local check = Theme.label({
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -6, 0, 6),
			Size = UDim2.fromOffset(24, 24),
			Text = "✔",
			Font = Theme.Fonts.Heavy,
			TextColor3 = C.MintDark,
			MaxTextSize = 18,
			Visible = false,
			Parent = body,
		})
		tiles[day] = {
			body = body,
			big = big,
			stroke = body:FindFirstChildOfClass("UIStroke"),
			title = title,
			icon = icon,
			amount = amount,
			check = check,
		}
	end
end

function Daily.refresh()
	local state = app.state
	if not (state and window and window.Holder.Visible) then
		return
	end
	local scale = Config.questScale(state.openLevel)
	local today = state.dailyStreak
	for day, tile in ipairs(tiles) do
		tile.amount.Text = "💵 " .. Theme.formatNumber(math.floor((80 + day * 40) * scale))
		local claimed = day < today or (day == today and not state.dailyReady)
		local current = day == today and state.dailyReady
		tile.check.Visible = claimed
		tile.body.BackgroundColor3 = claimed and C.PanelSoft or C.Panel
		tile.stroke.Color = current and C.Primary or C.Border
		tile.stroke.Thickness = current and 2 or 1
		tile.title.TextColor3 = current and C.Primary or C.InkSoft
	end
	if state.dailyReady then
		claimButton.SetText("Reclamar día " .. today)
		claimButton.SetEnabled(true)
	else
		claimButton.SetText("Vuelve en " .. Theme.formatTime(state.dailyWait))
		claimButton.SetEnabled(false)
	end
end

function Daily.open()
	window.Open()
	Daily.refresh()
end

function Daily.claim()
	if claiming then
		return
	end
	claiming = true
	local ok, success, amount, colorId = pcall(function()
		return app.remotes.ClaimDaily:InvokeServer()
	end)
	claiming = false
	if ok and success then
		Theme.playSound("success", 1.1)
		local entry = Colors.ById[colorId]
		app.notify(
			"🎁 ¡Regalo diario! +💵"
				.. Theme.formatNumber(amount)
				.. (entry and (" y «" .. entry.name .. "»") or ""),
			"gold"
		)
		app.celebrate()
		window.Close()
	end
end

function Daily.init(appRef)
	app = appRef
	local gui = Theme.new("ScreenGui", {
		Name = "Daily",
		ResetOnSpawn = false,
		DisplayOrder = 14,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = Players.LocalPlayer:WaitForChild("PlayerGui"),
	})
	window = Theme.window({
		Name = "Window",
		Parent = gui,
		Size = UDim2.fromOffset(820, 360),
		Title = "Regalo diario",
		Subtitle = "Vuelve cada día: la recompensa crece con tu racha.",
	})
	buildTiles(window.Body)
	claimButton = Theme.button({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -18),
		Size = UDim2.fromOffset(280, 48),
		Text = "",
		Variant = "primary",
		Radius = 12,
		Parent = window.Body,
		OnClick = function()
			Daily.claim()
		end,
	})
end

return Daily
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="23">
            <Properties>
              <string name="Name">DesignArt</string>
              <string name="Source"><![CDATA[-- Dibuja un diseño (figuras) dentro de un Frame cuadrado.
-- mode = "color": cuadro terminado.
-- mode = "paint": boceto para colorear. Cada figura se ve en un tono pálido de
-- su color con línea de lápiz; las pinceladas (addDab) se recortan a la forma
-- de la figura con un CanvasGroup y, al completarla, el color final aparece.

local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Colors = require(Shared.Colors)
local Designs = require(Shared.Designs)

local DesignArt = {}

local WHITE = Color3.new(1, 1, 1)
local SKETCH_LINE = Color3.fromRGB(150, 156, 170)
local UNPAINTED_LIGHT = Color3.fromRGB(196, 200, 210)
local HINT_LINE = Color3.fromRGB(40, 104, 232)
local FADE = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

local function applyColor(frame, gradient, colorId)
	local entry = Colors.ById[colorId]
	if entry and entry.gradient then
		frame.BackgroundColor3 = WHITE
		gradient.Color = Colors.sequence(colorId)
	else
		frame.BackgroundColor3 = entry and entry.color or WHITE
		gradient.Color = ColorSequence.new(WHITE)
	end
end

local function addCorner(frame, shape)
	if shape.r > 0 then
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(shape.r, 0)
		corner.Parent = frame
	end
end

-- Punto del lienzo (0..1) en coordenadas locales de la figura (0..1).
function DesignArt.toLocal(shape, x, y)
	local dx, dy = x - shape.x, y - shape.y
	local rad = math.rad(shape.rot)
	local c, s = math.cos(rad), math.sin(rad)
	local lx = dx * c + dy * s
	local ly = -dx * s + dy * c
	return lx / shape.w + 0.5, ly / shape.h + 0.5
end

function DesignArt.render(container, design, opts)
	opts = opts or {}
	local old = container:FindFirstChild("Art")
	if old then
		old:Destroy()
	end
	local mode = opts.mode or "color"
	local colors = opts.colors or Designs.defaultColors(design)
	local zindex = opts.zindex or container.ZIndex
	local stroke = opts.stroke or 2

	local holder = Instance.new("Frame")
	holder.Name = "Art"
	holder.Size = UDim2.fromScale(1, 1)
	holder.BackgroundTransparency = 1
	holder.ClipsDescendants = true
	holder.ZIndex = zindex

	local handle = { shapes = {}, design = design, holder = holder }

	for i, shape in ipairs(design.shapes) do
		local base = Instance.new("Frame")
		base.Name = "S" .. i
		base.AnchorPoint = Vector2.new(0.5, 0.5)
		base.Position = UDim2.fromScale(shape.x, shape.y)
		base.Size = UDim2.fromScale(shape.w, shape.h)
		base.Rotation = shape.rot
		base.BorderSizePixel = 0
		base.ZIndex = zindex
		addCorner(base, shape)

		local entry = { shape = shape, base = base, done = false }
		if mode == "paint" then
			local main = Colors.mainColor(colors[shape.area])
			entry.main = main
			-- Tono pálido del color final; los colores muy claros se ven en gris
			-- para que se note qué falta por pintar.
			local light = 0.299 * main.R + 0.587 * main.G + 0.114 * main.B
			base.BackgroundColor3 = light > 0.8 and main:Lerp(UNPAINTED_LIGHT, 0.6) or main:Lerp(WHITE, 0.78)
			local line = Instance.new("UIStroke")
			line.Color = SKETCH_LINE
			line.Thickness = stroke
			line.Transparency = 0.1
			line.Parent = base
			entry.line = line

			local fill = Instance.new("Frame")
			fill.Name = "Fill"
			fill.Size = UDim2.fromScale(1, 1)
			fill.BorderSizePixel = 0
			fill.BackgroundTransparency = 1
			fill.ZIndex = zindex + 2
			addCorner(fill, shape)
			local gradient = Instance.new("UIGradient")
			gradient.Rotation = 35
			gradient.Parent = fill
			applyColor(fill, gradient, colors[shape.area])
			fill.Parent = base
			entry.fill = fill
			entry.gradient = gradient
		else
			local gradient = Instance.new("UIGradient")
			gradient.Rotation = 35
			gradient.Parent = base
			applyColor(base, gradient, colors[shape.area])
			entry.gradient = gradient
			if opts.outline ~= false then
				local line = Instance.new("UIStroke")
				line.Color = Colors.mainColor(colors[shape.area]):Lerp(Color3.new(0, 0, 0), 0.25)
				line.Thickness = opts.outlineThickness or 1
				line.Transparency = 0.55
				line.Parent = base
			end
		end
		base.Parent = holder
		handle.shapes[i] = entry
	end

	-- Capa de pintura recortada a la forma de la figura.
	local function paintLayer(entry)
		if entry.group then
			return entry.group
		end
		local group = Instance.new("CanvasGroup")
		group.Name = "Paint"
		group.Size = UDim2.fromScale(1, 1)
		group.BackgroundTransparency = 1
		group.ZIndex = zindex + 1
		addCorner(group, entry.shape)
		group.Parent = entry.base
		entry.group = group
		return group
	end

	-- Pincelada redonda de radio `radius` (en fracción del lienzo) en (x, y).
	function handle.addDab(i, x, y, radius)
		local entry = handle.shapes[i]
		if not entry or entry.done or mode ~= "paint" then
			return
		end
		local shape = entry.shape
		local u, v = DesignArt.toLocal(shape, x, y)
		local dab = Instance.new("Frame")
		dab.AnchorPoint = Vector2.new(0.5, 0.5)
		dab.Position = UDim2.fromScale(u, v)
		dab.Size = UDim2.fromScale(2 * radius / shape.w, 2 * radius / shape.h)
		dab.BackgroundColor3 = entry.main
		dab.BorderSizePixel = 0
		dab.ZIndex = zindex + 1
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.5, 0)
		corner.Parent = dab
		dab.Parent = paintLayer(entry)
	end

	-- Relleno de cubeta: una mancha que crece desde (x, y) hasta cubrir la figura.
	function handle.flood(i, x, y, duration)
		local entry = handle.shapes[i]
		if not entry or entry.done or mode ~= "paint" then
			return
		end
		local shape = entry.shape
		local u, v = DesignArt.toLocal(shape, x, y)
		local dab = Instance.new("Frame")
		dab.AnchorPoint = Vector2.new(0.5, 0.5)
		dab.Position = UDim2.fromScale(u, v)
		dab.Size = UDim2.fromScale(0, 0)
		dab.BackgroundColor3 = entry.main
		dab.BorderSizePixel = 0
		dab.ZIndex = zindex + 1
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.5, 0)
		corner.Parent = dab
		dab.Parent = paintLayer(entry)
		local reach = 2.2 * math.sqrt(shape.w * shape.w + shape.h * shape.h)
		TweenService:Create(
			dab,
			TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{ Size = UDim2.fromScale(reach / shape.w, reach / shape.h) }
		):Play()
	end

	-- La figura queda pintada con su color final (con o sin animación).
	function handle.complete(i, animate)
		local entry = handle.shapes[i]
		if not entry or entry.done then
			return
		end
		entry.done = true
		if mode ~= "paint" then
			return
		end
		local finalLine = entry.main:Lerp(Color3.new(0, 0, 0), 0.25)
		if animate then
			TweenService:Create(entry.fill, FADE, { BackgroundTransparency = 0 }):Play()
			TweenService:Create(entry.line, FADE, { Color = finalLine, Transparency = 0.55 }):Play()
			local group = entry.group
			if group then
				task.delay(0.3, function()
					group:Destroy()
				end)
			end
		else
			entry.fill.BackgroundTransparency = 0
			entry.line.Color = finalLine
			entry.line.Transparency = 0.55
			if entry.group then
				entry.group:Destroy()
			end
		end
		entry.group = nil
	end

	-- Pista: resalta el contorno de una figura sin pintar (alpha 0..1).
	function handle.setHint(i, alpha)
		local entry = handle.shapes[i]
		if not entry or entry.done or not entry.line then
			return
		end
		entry.line.Color = SKETCH_LINE:Lerp(HINT_LINE, alpha)
		entry.line.Thickness = stroke + alpha * 1.5
		entry.line.Transparency = 0.1 * (1 - alpha)
	end

	function handle.setColors(newColors)
		colors = newColors
		for _, entry in ipairs(handle.shapes) do
			local target = entry.fill or entry.base
			applyColor(target, entry.gradient, newColors[entry.shape.area])
		end
	end

	holder.Parent = container
	return handle
end

-- Muestra de color redonda (soporta degradados).
function DesignArt.swatch(frame, colorId)
	local gradient = frame:FindFirstChild("SwatchGradient")
	if not gradient then
		gradient = Instance.new("UIGradient")
		gradient.Name = "SwatchGradient"
		gradient.Rotation = 35
		gradient.Parent = frame
	end
	applyColor(frame, gradient, colorId)
end

return DesignArt
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="24">
            <Properties>
              <string name="Name">DesignPicker</string>
              <string name="Source"><![CDATA[-- Ventana "Elige un diseño": diseños por niveles, desbloqueos y maestría.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Designs = require(Shared.Designs)

local Theme = require(script.Parent.Theme)
local DesignArt = require(script.Parent.DesignArt)

local DesignPicker = {}

local C = Theme.Colors
local MEDALS = { bronce = "🥉", plata = "🥈", oro = "🥇" }

local app
local window
local cards = {}
local levelHeaders = {}
local detail = {}
local selectedId = "globo"
local busy = false

local function stateOf(design)
	local state = app.state
	if not state then
		return "closed"
	end
	if state.unlocked[design.id] then
		return "unlocked"
	end
	if Designs.isLevelOpen(design.level, state.made) then
		return "buyable"
	end
	return "closed"
end

local function averageValue(level)
	local total, count = 0, 0
	for _, design in ipairs(Designs.Levels[level]) do
		total += design.value
		count += 1
	end
	return math.floor(total / math.max(count, 1))
end

-- Tarjetas ------------------------------------------------------------------------------------
local function buildCard(design, parent)
	local holder, body = Theme.card({
		Name = design.id,
		Size = UDim2.fromOffset(146, 192),
		Radius = 14,
		LayoutOrder = design.index,
		Parent = parent,
	})
	local stroke = body:FindFirstChildOfClass("UIStroke")
	local button = Theme.new("TextButton", {
		Name = design.id,
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		ZIndex = 3,
		Parent = body,
	})
	local artBox = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 10),
		Size = UDim2.fromOffset(122, 122),
		BackgroundColor3 = C.PanelSoft,
		Parent = body,
	}, { Theme.corner(10) })
	local art = Theme.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = artBox }, {
		Theme.corner(10),
	})
	DesignArt.render(art, design, { mode = "color", outline = false })
	local lock = Theme.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = C.PanelSoft,
		BackgroundTransparency = 0.15,
		Visible = false,
		ZIndex = 2,
		Parent = artBox,
	}, { Theme.corner(10) })
	local lockIcon = Theme.label({
		Size = UDim2.fromScale(1, 1),
		Text = "🔒",
		Font = Theme.Fonts.Heavy,
		MaxTextSize = 30,
		ZIndex = 2,
		Parent = lock,
	})
	local name = Theme.label({
		Position = UDim2.fromOffset(6, 136),
		Size = UDim2.new(1, -12, 0, 22),
		Text = design.name,
		Font = Theme.Fonts.Bold,
		MaxTextSize = 16,
		Parent = body,
	})
	local footer = Theme.new("Frame", {
		Position = UDim2.fromOffset(10, 162),
		Size = UDim2.new(1, -20, 0, 22),
		BackgroundTransparency = 1,
		Parent = body,
	})
	local medal = Theme.label({ Size = UDim2.fromOffset(22, 22), Text = "", MaxTextSize = 18, Parent = footer })
	local bar = Theme.progress({
		Position = UDim2.new(0, 26, 0.5, -4),
		Size = UDim2.new(1, -66, 0, 6),
		Gradient = "primary",
		Parent = footer,
	})
	local count = Theme.label({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 1),
		Size = UDim2.fromOffset(36, 20),
		Text = "",
		Font = Theme.Fonts.Heavy,
		TextColor3 = C.InkSoft,
		TextXAlignment = Enum.TextXAlignment.Right,
		MaxTextSize = 13,
		Parent = footer,
	})
	local price, priceLabel = Theme.chip({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 161),
		Size = UDim2.fromOffset(110, 24),
		Color = C.PanelSoft,
		TextColor3 = C.Ink,
		Text = "",
		MaxTextSize = 14,
		Parent = body,
	})

	button.Activated:Connect(function()
		Theme.playSound("click", 1.2)
		selectedId = design.id
		DesignPicker.refresh()
	end)

	cards[design.id] = {
		holder = holder,
		body = body,
		stroke = stroke,
		art = art,
		lock = lock,
		lockIcon = lockIcon,
		name = name,
		footer = footer,
		medal = medal,
		bar = bar,
		count = count,
		price = price,
		priceLabel = priceLabel,
	}
end

local function buildList(parent)
	local list = Theme.new("ScrollingFrame", {
		Position = UDim2.fromOffset(18, 14),
		Size = UDim2.new(0, 668, 1, -28),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = C.InkFaint,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = parent,
	}, {
		Theme.list("v", 10),
		Theme.new("UIPadding", {
			PaddingTop = UDim.new(0, 4),
			PaddingLeft = UDim.new(0, 6),
			PaddingRight = UDim.new(0, 8),
			PaddingBottom = UDim.new(0, 14),
		}),
	})
	for level = 1, Designs.MAX_LEVEL do
		local header = Theme.new("Frame", {
			Name = "Header" .. level,
			Size = UDim2.new(1, -10, 0, 36),
			BackgroundTransparency = 1,
			LayoutOrder = level * 2 - 1,
			Parent = list,
		})
		local title = Theme.label({
			Position = UDim2.fromOffset(2, 6),
			Size = UDim2.fromOffset(112, 26),
			Text = "Nivel " .. level,
			Font = Theme.Fonts.Heavy,
			TextXAlignment = Enum.TextXAlignment.Left,
			MaxTextSize = 20,
			Parent = header,
		})
		local info = Theme.label({
			Position = UDim2.fromOffset(120, 9),
			Size = UDim2.new(1, -128, 0, 20),
			Text = "Se venden por ~💵" .. Theme.formatNumber(averageValue(level)),
			Font = Theme.Fonts.Medium,
			TextColor3 = C.InkSoft,
			TextXAlignment = Enum.TextXAlignment.Left,
			MaxTextSize = 15,
			Parent = header,
		})
		levelHeaders[level] = { title = title, info = info }
		local grid = Theme.new("Frame", {
			Name = "Level" .. level,
			Size = UDim2.new(1, -10, 0, 204),
			BackgroundTransparency = 1,
			LayoutOrder = level * 2,
			Parent = list,
		}, {
			Theme.new("UIGridLayout", {
				CellSize = UDim2.fromOffset(146, 192),
				CellPadding = UDim2.fromOffset(12, 10),
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
		})
		for _, design in ipairs(Designs.Levels[level]) do
			buildCard(design, grid)
		end
	end
end

-- Panel de detalle ------------------------------------------------------------------------------
local function buildDetail(parent)
	local _, panel = Theme.card({
		Position = UDim2.new(1, -306, 0, 14),
		Size = UDim2.new(0, 288, 1, -28),
		Radius = 16,
		Parent = parent,
	})
	local artBox = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 16),
		Size = UDim2.fromOffset(176, 176),
		BackgroundColor3 = C.PanelSoft,
		Parent = panel,
	}, { Theme.corner(12), Theme.stroke(C.Border, 1) })
	detail.art = Theme.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = artBox }, {
		Theme.corner(12),
	})
	detail.lock = Theme.label({
		Size = UDim2.fromScale(1, 1),
		Text = "🔒",
		Font = Theme.Fonts.Heavy,
		BackgroundColor3 = C.PanelSoft,
		BackgroundTransparency = 0.15,
		MaxTextSize = 40,
		Visible = false,
		Parent = artBox,
	})
	Theme.corner(12).Parent = detail.lock
	detail.name = Theme.label({
		Position = UDim2.fromOffset(12, 200),
		Size = UDim2.new(1, -24, 0, 34),
		Text = "",
		Font = Theme.Fonts.Heavy,
		MaxTextSize = 24,
		Parent = panel,
	})
	detail.value = Theme.label({
		Position = UDim2.fromOffset(12, 234),
		Size = UDim2.new(1, -24, 0, 24),
		Text = "",
		Font = Theme.Fonts.Bold,
		TextColor3 = C.MintDark,
		MaxTextSize = 17,
		Parent = panel,
	})
	detail.info = Theme.label({
		Position = UDim2.fromOffset(12, 258),
		Size = UDim2.new(1, -24, 0, 20),
		Text = "",
		Font = Theme.Fonts.Medium,
		TextColor3 = C.InkSoft,
		MaxTextSize = 15,
		Parent = panel,
	})
	local masteryBox = Theme.new("Frame", {
		Position = UDim2.fromOffset(12, 286),
		Size = UDim2.new(1, -24, 0, 92),
		BackgroundColor3 = C.PanelSoft,
		Parent = panel,
	}, { Theme.corner(12) })
	detail.medal = Theme.label({
		Position = UDim2.fromOffset(8, 8),
		Size = UDim2.fromOffset(40, 40),
		Text = "",
		MaxTextSize = 34,
		Parent = masteryBox,
	})
	detail.tier = Theme.label({
		Position = UDim2.fromOffset(54, 8),
		Size = UDim2.new(1, -62, 0, 22),
		Text = "",
		Font = Theme.Fonts.Heavy,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 17,
		Parent = masteryBox,
	})
	detail.tierBonus = Theme.label({
		Position = UDim2.fromOffset(54, 30),
		Size = UDim2.new(1, -62, 0, 18),
		Text = "",
		Font = Theme.Fonts.Medium,
		TextColor3 = C.InkSoft,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 14,
		Parent = masteryBox,
	})
	detail.bar = Theme.progress({
		Position = UDim2.fromOffset(10, 56),
		Size = UDim2.new(1, -20, 0, 6),
		Gradient = "primary",
		Parent = masteryBox,
	})
	detail.progress = Theme.label({
		Position = UDim2.fromOffset(10, 68),
		Size = UDim2.new(1, -20, 0, 18),
		Text = "",
		Font = Theme.Fonts.Bold,
		TextColor3 = C.InkSoft,
		MaxTextSize = 13,
		Parent = masteryBox,
	})
	detail.tiers = Theme.label({
		Position = UDim2.fromOffset(12, 384),
		Size = UDim2.new(1, -24, 0, 20),
		Text = "🥉 3 → +5%   🥈 8 → +10%   🥇 20 → +20%",
		Font = Theme.Fonts.Bold,
		TextColor3 = C.InkSoft,
		MaxTextSize = 14,
		Parent = panel,
	})
	detail.button = Theme.button({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -14),
		Size = UDim2.new(1, -28, 0, 50),
		Text = "Empezar a pintar",
		Variant = "primary",
		Radius = 12,
		Parent = panel,
		OnClick = function()
			DesignPicker.action()
		end,
	})
end

-- Lógica ---------------------------------------------------------------------------------------------
function DesignPicker.refresh()
	if not (window and window.Holder.Visible and app.state) then
		return
	end
	local state = app.state
	for level, header in pairs(levelHeaders) do
		local open = Designs.isLevelOpen(level, state.made)
		header.title.TextColor3 = open and C.Ink or C.InkFaint
		header.title.Text = (open and "" or "🔒 ") .. "Nivel " .. level
	end
	for _, design in ipairs(Designs.List) do
		local card = cards[design.id]
		local status = stateOf(design)
		local made = state.made[design.id] or 0
		local selected = design.id == selectedId
		card.stroke.Color = selected and C.Primary or C.Border
		card.stroke.Thickness = selected and 2 or 1
		card.art.Visible = status ~= "closed"
		card.lock.Visible = status ~= "unlocked"
		card.lockIcon.Text = status == "closed" and "🔒" or "🛒"
		card.footer.Visible = status == "unlocked"
		card.price.Visible = status ~= "unlocked"
		card.priceLabel.Text = (status == "closed" and "🔒 " or "💵 ") .. Theme.formatNumber(design.price)
		card.name.Text = status == "closed" and "???" or design.name
		card.name.TextColor3 = status == "closed" and C.InkFaint or C.Ink
		local tier, nextTier = Config.masteryFor(made)
		card.medal.Text = tier and MEDALS[tier.id] or "⚪"
		local goal = nextTier and nextTier.made or made
		card.bar.Set(made / math.max(goal, 1))
		card.count.Text = nextTier and (made .. "/" .. goal) or tostring(made)
	end

	local design = Designs.get(selectedId) or Designs.List[1]
	local status = stateOf(design)
	local made = state.made[design.id] or 0
	DesignArt.render(detail.art, design, { mode = "color", outline = false })
	detail.art.Visible = status ~= "closed"
	detail.lock.Visible = status == "closed"
	local value = Config.paintingValue(design, Designs.defaultColors(design), state.upgrades, made, 3)
	detail.value.Text = "💵 Hasta ~" .. Theme.formatNumber(value) .. " con colores básicos"
	detail.name.Text = status == "closed" and "???" or design.name
	detail.info.Text = "Nivel "
		.. design.level
		.. "  ·  "
		.. #design.areas
		.. " colores  ·  "
		.. #design.shapes
		.. " figuras"
	local tier, nextTier = Config.masteryFor(made)
	detail.medal.Text = tier and MEDALS[tier.id] or "⚪"
	detail.tier.Text = tier and ("Maestría de " .. tier.name) or "Sin maestría aún"
	detail.tierBonus.Text = tier and ("Se vende un " .. math.floor(tier.bonus * 100 + 0.5) .. "% más caro")
		or "Píntalo varias veces para ganar medallas"
	if nextTier then
		detail.bar.Set(made / nextTier.made)
		detail.progress.Text = made .. " de " .. nextTier.made .. " para " .. nextTier.name
	else
		detail.bar.Set(1)
		detail.progress.Text = "¡Maestría máxima! (" .. made .. " pintados)"
	end

	if status == "unlocked" then
		detail.button.SetText(state.painting and "Tienes un cuadro empezado" or "Empezar a pintar")
		detail.button.SetVariant("primary")
		detail.button.SetEnabled(not state.painting)
	elseif status == "buyable" then
		detail.button.SetText("Desbloquear · 💵 " .. Theme.formatNumber(design.price))
		detail.button.SetVariant("primary")
		detail.button.SetEnabled(state.coins >= design.price)
	else
		detail.button.SetText("Pinta todo el nivel " .. (design.level - 1))
		detail.button.SetEnabled(false)
	end
end

function DesignPicker.action()
	if busy then
		return
	end
	local design = Designs.get(selectedId)
	local status = stateOf(design)
	if status == "unlocked" then
		window.Close()
		app.openColorPicker(design)
	elseif status == "buyable" then
		busy = true
		local ok, success, message = pcall(function()
			return app.remotes.UnlockDesign:InvokeServer(design.id)
		end)
		busy = false
		if ok and success then
			Theme.playSound("success", 1.1)
			app.notify("🔓 " .. message, "success")
			app.celebrate()
		else
			app.notify(ok and message or "No se pudo desbloquear.", "error")
		end
		DesignPicker.refresh()
	end
end

function DesignPicker.open()
	if app.state and app.state.painting then
		app.resumePainting()
		return
	end
	window.Open()
	DesignPicker.refresh()
end

function DesignPicker.isOpen()
	return window.Holder.Visible
end

function DesignPicker.init(appRef)
	app = appRef
	local gui = Theme.new("ScreenGui", {
		Name = "DesignPicker",
		ResetOnSpawn = false,
		DisplayOrder = 12,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = Players.LocalPlayer:WaitForChild("PlayerGui"),
	})
	window = Theme.window({
		Name = "Window",
		Parent = gui,
		Size = UDim2.fromOffset(1010, 650),
		Title = "Elige un diseño",
		Subtitle = "Pinta todos los diseños de un nivel para abrir el siguiente.",
	})
	buildList(window.Body)
	buildDetail(window.Body)
end

return DesignPicker
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="25">
            <Properties>
              <string name="Name">HUD</string>
              <string name="Source"><![CDATA[-- Interfaz principal, mínima: monedas y cuadros en venta arriba, una columna
-- de botones a la izquierda, misiones plegables, tutorial, avisos y confeti.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)

local Theme = require(script.Parent.Theme)

local HUD = {}

local C = Theme.Colors
local player = Players.LocalPlayer

local app
local gui
local refs = {}
local tiles = {}
local questRows = {}
local shownCoins = nil
local toastHolder
local confettiHolder

local KIND_COLOR = { info = C.Primary, success = C.Mint, error = C.Red, gold = C.Gold }
local CONFETTI_COLORS = {
	Color3.fromRGB(255, 120, 170),
	Color3.fromRGB(255, 210, 80),
	Color3.fromRGB(110, 210, 255),
	Color3.fromRGB(150, 120, 255),
	Color3.fromRGB(100, 220, 160),
}

-- Avisos ------------------------------------------------------------------------------------
function HUD.notify(text, kind)
	if not toastHolder then
		return
	end
	local holder, body = Theme.card({
		Size = UDim2.new(1, 0, 0, 40),
		Radius = 20,
		LayoutOrder = -math.floor(os.clock() * 100),
		Parent = toastHolder,
	})
	local accent = Theme.new("Frame", {
		Position = UDim2.fromOffset(8, 8),
		Size = UDim2.fromOffset(24, 24),
		BackgroundColor3 = KIND_COLOR[kind] or C.Primary,
		Parent = body,
	}, { Theme.round() })
	Theme.label({
		Size = UDim2.fromScale(1, 1),
		Text = kind == "error" and "!" or (kind == "gold" and "★" or "✓"),
		Font = Theme.Fonts.Heavy,
		TextColor3 = C.White,
		MaxTextSize = 14,
		Parent = accent,
	})
	Theme.label({
		Size = UDim2.new(1, -54, 1, -12),
		Position = UDim2.fromOffset(42, 6),
		Text = text,
		Font = Theme.Fonts.Medium,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 16,
		Parent = body,
	})
	Theme.pop(holder, 0.7)
	if kind == "error" then
		Theme.playSound("click", 0.6)
	end
	task.delay(3.5, function()
		if holder.Parent then
			holder:Destroy()
		end
	end)
	local toasts = {}
	for _, child in ipairs(toastHolder:GetChildren()) do
		if child:IsA("Frame") then
			table.insert(toasts, child)
		end
	end
	if #toasts > 3 then
		table.sort(toasts, function(a, b)
			return a.LayoutOrder > b.LayoutOrder
		end)
		toasts[1]:Destroy()
	end
end

function HUD.celebrate()
	local random = Random.new()
	for _ = 1, 70 do
		local piece = Theme.new("Frame", {
			Size = UDim2.fromOffset(random:NextInteger(8, 14), random:NextInteger(12, 20)),
			Position = UDim2.new(random:NextNumber(0.05, 0.95), 0, -0.05, 0),
			Rotation = random:NextInteger(0, 360),
			BackgroundColor3 = CONFETTI_COLORS[random:NextInteger(1, #CONFETTI_COLORS)],
			BorderSizePixel = 0,
			Parent = confettiHolder,
		}, { Theme.corner(3) })
		local duration = random:NextNumber(1.6, 2.8)
		Theme.tween(piece, duration, {
			Position = UDim2.new(piece.Position.X.Scale + random:NextNumber(-0.15, 0.15), 0, 1.05, 0),
			Rotation = piece.Rotation + random:NextInteger(-540, 540),
		}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		task.delay(duration, function()
			piece:Destroy()
		end)
	end
end

-- Barra superior --------------------------------------------------------------------------------
local function pill(parent, props)
	local holder, body = Theme.card({
		Name = props.Name,
		Size = props.Size,
		Radius = 21,
		LayoutOrder = props.LayoutOrder,
		Parent = parent,
	})
	Theme.label({
		Name = "Icon",
		Position = UDim2.fromOffset(10, 8),
		Size = UDim2.fromOffset(26, 26),
		Text = props.Icon,
		MaxTextSize = 20,
		Parent = body,
	})
	local label = Theme.label({
		Name = "Value",
		Size = UDim2.new(1, -(props.Right or 52), 1, -14),
		Position = UDim2.fromOffset(42, 7),
		Text = "0",
		Font = props.Font or Theme.Fonts.Heavy,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = props.MaxTextSize or 20,
		Parent = body,
	})
	return holder, label, body
end

local function buildTopBar()
	local bar = Theme.new("Frame", {
		Name = "TopBar",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 8),
		Size = UDim2.new(0, 330, 0, 42),
		BackgroundTransparency = 1,
		Parent = gui,
	}, { Theme.list("h", 10, Enum.HorizontalAlignment.Center) })
	local coins, coinsLabel, coinsBody = pill(bar, {
		Name = "Coins",
		Size = UDim2.new(0, 190, 1, 0),
		Icon = "💵",
		LayoutOrder = 1,
		MaxTextSize = 20,
		Right = 82,
	})
	refs.coins = coinsLabel
	refs.coinsBody = coinsBody
	refs.coinsFrame = coins
	local plus = Theme.new("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -5, 0.5, 0),
		Size = UDim2.fromOffset(30, 30),
		BackgroundColor3 = C.PanelSoft,
		Font = Theme.Fonts.Bold,
		Text = "+",
		TextScaled = true,
		TextColor3 = C.InkSoft,
		Parent = coinsBody,
	}, { Theme.round(), Theme.padding(6) })
	plus.Activated:Connect(function()
		Theme.playSound("click")
		app.openShop()
	end)
	local _, gallery = pill(bar, {
		Name = "Gallery",
		Size = UDim2.new(0, 120, 1, 0),
		Icon = "🖼️",
		LayoutOrder = 2,
		MaxTextSize = 20,
		Right = 52,
	})
	refs.gallery = gallery
end

-- Columna de botones -------------------------------------------------------------------------------
local function buildMenu()
	local menu = Theme.new("Frame", {
		Name = "Menu",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 12, 0.5, 0),
		Size = UDim2.fromOffset(66, 400),
		BackgroundTransparency = 1,
		Parent = gui,
	}, { Theme.list("v", 10, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center) })
	local entries = {
		{ "shop", "🛒", "Mejoras", "mint", app.openShop },
		{ "colors", "📚", "Colores", "blue", app.openCollection },
		{ "quests", "📜", "Misiones", "gold", HUD.toggleQuests },
		{ "daily", "🎁", "Regalo", "pink", app.openDaily },
		{
			"home",
			"🏠",
			"Taller",
			"orange",
			function()
				app.remotes.GoHome:FireServer()
			end,
		},
	}
	for order, entry in ipairs(entries) do
		local action = entry[5]
		tiles[entry[1]] = Theme.tile({
			Name = entry[1],
			Size = UDim2.fromOffset(64, 64),
			IconSize = 26,
			Icon = entry[2],
			Text = entry[3],
			Gradient = entry[4],
			LayoutOrder = order,
			Parent = menu,
			OnClick = function()
				action()
			end,
		})
	end
	-- Sonido on/off, discreto debajo de los botones.
	local sound = Theme.new("TextButton", {
		Name = "Settings",
		Size = UDim2.fromOffset(38, 38),
		BackgroundColor3 = C.White,
		BackgroundTransparency = 0.15,
		Font = Theme.Fonts.Bold,
		Text = "🔊",
		TextScaled = true,
		LayoutOrder = 99,
		Parent = menu,
	}, { Theme.round(), Theme.stroke(C.Border, 2), Theme.padding(8) })
	sound.Activated:Connect(function()
		Theme.soundsEnabled = not Theme.soundsEnabled
		sound.Text = Theme.soundsEnabled and "🔊" or "🔇"
		Theme.playSound("click")
	end)
	refs.menu = menu
end

-- Misiones diarias (plegables) ---------------------------------------------------------------------
local function buildQuests()
	local holder, body = Theme.card({
		Name = "Quests",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 90, 0.5, 0),
		Size = UDim2.fromOffset(284, 300),
		Radius = 20,
		Visible = false,
		Parent = gui,
	})
	refs.quests = holder
	local header = Theme.new("Frame", {
		Size = UDim2.new(1, 0, 0, 44),
		BackgroundTransparency = 1,
		Parent = body,
	})
	Theme.new("Frame", {
		Position = UDim2.new(0, 12, 1, -1),
		Size = UDim2.new(1, -24, 0, 1),
		BackgroundColor3 = C.Border,
		BorderSizePixel = 0,
		Parent = header,
	})
	Theme.label({
		Position = UDim2.fromOffset(14, 10),
		Size = UDim2.new(1, -60, 0, 24),
		Text = "Misiones de hoy",
		Font = Theme.Fonts.Heavy,
		TextColor3 = C.Ink,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 18,
		Parent = header,
	})
	local close = Theme.new("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -8, 0.5, 0),
		Size = UDim2.fromOffset(28, 28),
		BackgroundColor3 = C.PanelSoft,
		Font = Theme.Fonts.Bold,
		Text = "✕",
		TextScaled = true,
		TextColor3 = C.InkSoft,
		Parent = header,
	}, { Theme.round(), Theme.padding(8) })
	close.Activated:Connect(function()
		Theme.playSound("click")
		HUD.toggleQuests(false)
	end)
	local list = Theme.new("Frame", {
		Position = UDim2.fromOffset(10, 52),
		Size = UDim2.new(1, -20, 1, -86),
		BackgroundTransparency = 1,
		Parent = body,
	}, { Theme.list("v", 6) })
	for i = 1, Config.QUESTS_PER_DAY do
		local row = Theme.new("Frame", {
			Size = UDim2.new(1, 0, 0, 64),
			BackgroundColor3 = C.PanelSoft,
			LayoutOrder = i,
			Parent = list,
		}, { Theme.corner(14) })
		local icon = Theme.new("Frame", {
			Position = UDim2.fromOffset(8, 8),
			Size = UDim2.fromOffset(28, 28),
			BackgroundColor3 = C.White,
			Parent = row,
		}, { Theme.corner(8) })
		local iconLabel = Theme.label({ Size = UDim2.fromScale(1, 1), Text = "", MaxTextSize = 17, Parent = icon })
		local text = Theme.label({
			Position = UDim2.fromOffset(44, 6),
			Size = UDim2.new(1, -52, 0, 32),
			Text = "",
			Font = Theme.Fonts.Bold,
			TextXAlignment = Enum.TextXAlignment.Left,
			MaxTextSize = 15,
			Parent = row,
		})
		local bar = Theme.progress({
			Position = UDim2.fromOffset(10, 46),
			Size = UDim2.new(1, -132, 0, 6),
			Gradient = "primary",
			Parent = row,
		})
		local count = Theme.label({
			Position = UDim2.new(1, -118, 0, 41),
			Size = UDim2.fromOffset(48, 18),
			Text = "",
			Font = Theme.Fonts.Heavy,
			TextColor3 = C.InkSoft,
			MaxTextSize = 13,
			Parent = row,
		})
		local claim = Theme.button({
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -6, 0, 38),
			Size = UDim2.fromOffset(62, 22),
			Text = "",
			Variant = "mint",
			Radius = 9,
			MaxTextSize = 12,
			Parent = row,
			OnClick = function()
				app.claimQuest(i)
			end,
		})
		questRows[i] = { row = row, icon = iconLabel, text = text, bar = bar, count = count, claim = claim }
	end
	refs.questBonus = Theme.label({
		Position = UDim2.new(0, 10, 1, -30),
		Size = UDim2.new(1, -20, 0, 22),
		Text = "",
		Font = Theme.Fonts.Bold,
		TextColor3 = C.InkSoft,
		MaxTextSize = 13,
		Parent = body,
	})
end

function HUD.toggleQuests(show)
	if show == nil then
		show = not refs.quests.Visible
	end
	refs.quests.Visible = show
	tiles.quests.SetActive(show)
	if show then
		Theme.popCard(refs.quests, 0.9)
	end
end

local function refreshQuests(state)
	local claimable = 0
	for i, rowRefs in ipairs(questRows) do
		local quest = state.quests and state.quests[i]
		rowRefs.row.Visible = quest ~= nil
		if quest then
			local def = Config.QuestById[quest.id]
			rowRefs.icon.Text = def and def.icon or "❔"
			rowRefs.text.Text = Config.questText(quest)
			rowRefs.bar.Set(quest.progress / math.max(quest.goal, 1), true)
			rowRefs.count.Text = Theme.formatNumber(quest.progress) .. "/" .. Theme.formatNumber(quest.goal)
			local done = quest.progress >= quest.goal
			if quest.claimed then
				rowRefs.claim.SetText("✔")
				rowRefs.claim.SetEnabled(false)
			else
				if done then
					claimable += 1
				end
				rowRefs.claim.SetText("💵 " .. Theme.formatNumber(quest.reward))
				rowRefs.claim.SetEnabled(done)
			end
			rowRefs.row.BackgroundColor3 = (done and not quest.claimed) and C.MintLight or C.PanelSoft
		end
	end
	refs.questBonus.Text = state.questBonus and "🎉 ¡Bonus de hoy reclamado!"
		or "🎁 Completa las 3: ¡color Épico o mejor!"
	tiles.quests.SetBadge(claimable > 0 and claimable or nil)
end

-- Tutorial (una sola línea) ----------------------------------------------------------------------
local function buildTutorial()
	local holder, body = Theme.card({
		Name = "Tutorial",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 58),
		Size = UDim2.fromOffset(420, 40),
		Radius = 20,
		Visible = false,
		Parent = gui,
	})
	refs.tutorial = holder
	local step = Theme.new("Frame", {
		Position = UDim2.fromOffset(6, 6),
		Size = UDim2.fromOffset(28, 28),
		BackgroundColor3 = C.Primary,
		Parent = body,
	}, { Theme.round() })
	refs.tutorialStep = Theme.label({
		Size = UDim2.fromScale(1, 1),
		Text = "1",
		Font = Theme.Fonts.Heavy,
		TextColor3 = C.White,
		MaxTextSize = 15,
		Parent = step,
	})
	refs.tutorialText = Theme.label({
		Position = UDim2.fromOffset(42, 6),
		Size = UDim2.new(1, -54, 1, -12),
		Text = "",
		Font = Theme.Fonts.Medium,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 16,
		Parent = body,
	})
end

local function refreshTutorial(state)
	local step = state.tutorial or 0
	local def = Config.Tutorial[step]
	local visible = step > 0 and def ~= nil and not app.isBusy()
	refs.tutorial.Visible = visible
	if def then
		refs.tutorialStep.Text = tostring(step)
		local suffix = def.goal > 1 and ("  " .. (state.tutorialProgress or 0) .. "/" .. def.goal) or ""
		refs.tutorialText.Text = def.text .. suffix
	end
	if refs.lastTutorial ~= step then
		refs.lastTutorial = step
		if visible then
			Theme.popCard(refs.tutorial, 0.85)
		end
	end
end

-- Estado --------------------------------------------------------------------------------------------
local function animateCoins(target)
	if shownCoins == nil then
		shownCoins = target
		refs.coins.Text = Theme.formatNumber(target)
		return
	end
	local start = shownCoins
	shownCoins = target
	if start == target then
		return
	end
	if target > start then
		Theme.popCard(refs.coinsFrame, 0.9)
	end
	task.spawn(function()
		local duration = 0.6
		local t0 = os.clock()
		while os.clock() - t0 < duration do
			if shownCoins ~= target then
				return
			end
			refs.coins.Text = Theme.formatNumber(start + (target - start) * (os.clock() - t0) / duration)
			RunService.RenderStepped:Wait()
		end
		refs.coins.Text = Theme.formatNumber(target)
	end)
end

function HUD.applyState(state)
	animateCoins(state.coins)
	refs.gallery.Text = state.displayed .. "/" .. state.slots
	tiles.daily.SetBadge(state.dailyReady)
	tiles.daily.Caption.Text = state.dailyReady and "¡Regalo!" or Theme.formatTime(state.dailyWait)
	refreshQuests(state)
	refreshTutorial(state)
end

function HUD.setVisible(visible)
	gui.Enabled = visible
end

function HUD.init(appRef)
	app = appRef
	gui = Theme.new("ScreenGui", {
		Name = "HUD",
		ResetOnSpawn = false,
		DisplayOrder = 1,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	buildTopBar()
	buildMenu()
	buildQuests()
	buildTutorial()

	local overlay = Theme.new("ScreenGui", {
		Name = "Notifications",
		ResetOnSpawn = false,
		DisplayOrder = 50,
		Parent = player:WaitForChild("PlayerGui"),
	})
	toastHolder = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 106),
		Size = UDim2.new(0, 420, 0, 150),
		BackgroundTransparency = 1,
		Parent = overlay,
	}, { Theme.list("v", 6, Enum.HorizontalAlignment.Center) })
	confettiHolder = Theme.new("Frame", {
		Position = UDim2.fromOffset(0, -80),
		Size = UDim2.new(1, 0, 1, 80),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		Parent = overlay,
	})

	-- Escala en pantallas pequeñas.
	local scaled = { gui.TopBar, refs.menu, refs.quests, refs.tutorial, toastHolder }
	local function updateScale()
		local camera = Workspace.CurrentCamera
		if not camera then
			return
		end
		local viewport = camera.ViewportSize
		local scale = math.clamp(math.min(viewport.X / 1280, viewport.Y / 720), 0.6, 1)
		for _, frame in ipairs(scaled) do
			local uiScale = frame:FindFirstChild("ViewportScale")
				or Theme.new("UIScale", { Name = "ViewportScale", Parent = frame })
			uiScale.Scale = scale
		end
	end
	updateScale()
	if Workspace.CurrentCamera then
		Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
	end
end

return HUD
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="26">
            <Properties>
              <string name="Name">Machine</string>
              <string name="Source"><![CDATA[-- Máquina de colores: los colores solo se tiran en la máquina del taller
-- (aviso «Tirar color»). Aquí está el cartel sobre la máquina, la tarjeta con
-- el resultado de cada tirada, el aviso de colores raros y la colección.

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Colors = require(Shared.Colors)
local Config = require(Shared.Config)

local Theme = require(script.Parent.Theme)
local DesignArt = require(script.Parent.DesignArt)

local Machine = {}

local C = Theme.Colors
local player = Players.LocalPlayer

local app
local gui
local refs = {}
local board = {}
local collection
local spinning = false
local spinToken = 0
local cardToken = 0
local knownPaints = nil

local function rarityText(colorId)
	local entry = Colors.ById[colorId]
	if not entry then
		return "¡Tira tu primer color!", C.InkSoft
	end
	local rarity = Colors.rarityOf(entry)
	return rarity.name .. "  ·  x" .. string.format("%.1f", rarity.mult), rarity.color
end

local function myMachine()
	local name = app.state and app.state.plotName or ""
	local plots = Workspace:FindFirstChild("Plots")
	local plot = plots and name ~= "" and plots:FindFirstChild(name)
	local workshop = plot and plot:FindFirstChild("Workshop")
	return workshop and workshop:FindFirstChild("Machine")
end

-- Tarjeta con el resultado (aparece un momento al tirar en la máquina) ------------------------
local function buildResultCard()
	local holder, body = Theme.card({
		Name = "RollResult",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -24),
		Size = UDim2.fromOffset(330, 84),
		Radius = 24,
		Visible = false,
		Parent = gui,
	})
	refs.card = holder
	local reel = Theme.new("Frame", {
		Position = UDim2.fromOffset(10, 10),
		Size = UDim2.fromOffset(64, 64),
		BackgroundColor3 = C.PanelSoft,
		Parent = body,
	}, { Theme.corner(14) })
	refs.reelStroke = Theme.stroke(C.Border, 2)
	refs.reelStroke.Parent = reel
	refs.swatch = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(44, 44),
		BackgroundColor3 = C.Border,
		Parent = reel,
	}, { Theme.round(), Theme.stroke(C.White, 2) })
	Theme.new("Frame", {
		Position = UDim2.fromScale(0.2, 0.14),
		Size = UDim2.fromScale(0.28, 0.2),
		BackgroundColor3 = C.White,
		BackgroundTransparency = 0.45,
		Rotation = -25,
		Parent = refs.swatch,
	}, { Theme.round() })
	refs.name = Theme.label({
		Position = UDim2.fromOffset(86, 10),
		Size = UDim2.new(1, -98, 0, 28),
		Text = "",
		Font = Theme.Fonts.Heavy,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 21,
		Parent = body,
	})
	local chip, chipLabel = Theme.chip({
		Position = UDim2.fromOffset(86, 44),
		Size = UDim2.fromOffset(130, 24),
		Color = C.PanelSoft,
		Text = "",
		MaxTextSize = 13,
		Parent = body,
	})
	refs.rarityChip = chip
	refs.rarityLabel = chipLabel
	refs.count = Theme.label({
		Position = UDim2.fromOffset(224, 46),
		Size = UDim2.new(1, -234, 0, 20),
		Text = "",
		Font = Theme.Fonts.Bold,
		TextColor3 = C.InkSoft,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 14,
		Parent = body,
	})
end

-- Cartel sobre la máquina del taller.
local function buildBoard()
	board.gui = Theme.new("BillboardGui", {
		Name = "MachineBoard",
		Size = UDim2.fromOffset(230, 112),
		StudsOffset = Vector3.new(0, 1.5, 0),
		MaxDistance = 50,
		LightInfluence = 0,
		ResetOnSpawn = false,
		Enabled = false,
