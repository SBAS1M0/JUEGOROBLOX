		Visible = false,
		Parent = board.gui,
	})
	Theme.round().Parent = board.auto
	Theme.padding(4, 10).Parent = board.auto
end

-- Aviso grande de color raro.
local function buildPopup()
	refs.popup = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.42),
		Size = UDim2.fromOffset(320, 300),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 30,
		Parent = gui,
	})
	local cardHolder, card = Theme.card({
		Size = UDim2.fromScale(1, 1),
		Radius = 22,
		ShadowOffset = 6,
		ShadowTransparency = 0.8,
		Parent = refs.popup,
	})
	refs.popupHolder = cardHolder
	refs.popupStroke = card:FindFirstChildOfClass("UIStroke")
	refs.popupBand = Theme.new("Frame", {
		Position = UDim2.fromOffset(24, 0),
		Size = UDim2.new(1, -48, 0, 5),
		BackgroundColor3 = C.Gold,
		BorderSizePixel = 0,
		Parent = card,
	}, { Theme.round() })
	refs.popupRarity = Theme.label({
		Position = UDim2.fromOffset(10, 22),
		Size = UDim2.new(1, -20, 0, 34),
		Text = "",
		Font = Theme.Fonts.Heavy,
		TextColor3 = C.Ink,
		MaxTextSize = 28,
		Parent = card,
	})
	refs.popupSwatch = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 86),
		Size = UDim2.fromOffset(120, 120),
		Parent = card,
	}, { Theme.round(), Theme.stroke(C.Border, 1) })
	refs.popupSparkles = {}
	for i = 1, 6 do
		local sparkle = Theme.label({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(28, 28),
			Text = "✦",
			Font = Theme.Fonts.Heavy,
			TextColor3 = C.Gold,
			MaxTextSize = 20,
			Parent = card,
		})
		refs.popupSparkles[i] = sparkle
	end
	refs.popupName = Theme.label({
		Position = UDim2.fromOffset(10, 214),
		Size = UDim2.new(1, -20, 0, 36),
		Text = "",
		Font = Theme.Fonts.Heavy,
		MaxTextSize = 26,
		Parent = card,
	})
	refs.popupMult = Theme.label({
		Position = UDim2.fromOffset(10, 252),
		Size = UDim2.new(1, -20, 0, 22),
		Text = "",
		Font = Theme.Fonts.Medium,
		TextColor3 = C.InkSoft,
		MaxTextSize = 17,
		Parent = card,
	})
end

local popupToken = 0
local function showPopup(colorId, isNew)
	local entry = Colors.ById[colorId]
	local rarity = Colors.rarityOf(entry)
	popupToken += 1
	local token = popupToken
	refs.popupBand.BackgroundColor3 = rarity.color
	refs.popupRarity.TextColor3 = rarity.color:Lerp(C.Ink, 0.25)
	refs.popupRarity.Text = (isNew and "Nuevo · " or "") .. rarity.name .. " · " .. rarity.finish
	DesignArt.swatch(refs.popupSwatch, colorId)
	refs.popupName.Text = entry.name
	refs.popupMult.Text = "Multiplica tus cuadros x" .. string.format("%.1f", rarity.mult)
	refs.popup.Visible = true
	Theme.pop(refs.popupHolder, 0.3)
	Theme.playSound("success", 0.7 + rarity.index * 0.1)
	if rarity.index >= 4 then
		app.celebrate()
	end
	task.spawn(function()
		local t0 = os.clock()
		while token == popupToken and refs.popup.Visible do
			local t = os.clock() - t0
			for i, sparkle in ipairs(refs.popupSparkles) do
				local angle = t * 1.6 + i / #refs.popupSparkles * math.pi * 2
				sparkle.Position = UDim2.new(0.5, math.cos(angle) * 92, 0, 146 + math.sin(angle) * 74)
				sparkle.Rotation = t * 120
				sparkle.TextColor3 = rarity.color:Lerp(C.White, (math.sin(t * 5 + i) + 1) * 0.2)
			end
			task.wait()
		end
	end)
	task.delay(rarity.index >= 4 and 3.2 or 2.2, function()
		if token == popupToken then
			refs.popup.Visible = false
		end
	end)
end

-- Colección -------------------------------------------------------------------------------------
local function buildCollection()
	local holderGui = Theme.new("ScreenGui", {
		Name = "Collection",
		ResetOnSpawn = false,
		DisplayOrder = 12,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	collection = Theme.window({
		Name = "Window",
		Parent = holderGui,
		Size = UDim2.fromOffset(880, 600),
		Title = "Colección de pinturas",
		Icon = "📚",
		Accent = "blue",
		Subtitle = "Consíguelas en la máquina del taller. Cuanto más raras, más valen tus cuadros.",
	})
	refs.collectionProgress = Theme.label({
		Position = UDim2.new(1, -330, 0, 14),
		Size = UDim2.fromOffset(250, 24),
		Text = "",
		Font = Theme.Fonts.Heavy,
		TextColor3 = C.White,
		TextXAlignment = Enum.TextXAlignment.Right,
		MaxTextSize = 18,
		Parent = collection.Header,
	})
	refs.collectionList = Theme.new("ScrollingFrame", {
		Position = UDim2.fromOffset(20, 14),
		Size = UDim2.new(1, -40, 1, -28),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = C.InkFaint,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = collection.Body,
	}, {
		Theme.list("v", 8),
		Theme.new("UIPadding", {
			PaddingLeft = UDim.new(0, 4),
			PaddingRight = UDim.new(0, 12),
			PaddingTop = UDim.new(0, 4),
			PaddingBottom = UDim.new(0, 10),
		}),
	})
end

local function colorCell(parent, entry, count, order)
	local known = entry.basic or count > 0 or (knownPaints and knownPaints[entry.id])
	local _, cell = Theme.card({ Size = UDim2.fromOffset(110, 112), Radius = 16, LayoutOrder = order, Parent = parent })
	local swatch = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 10),
		Size = UDim2.fromOffset(56, 56),
		BackgroundColor3 = C.Border,
		Parent = cell,
	}, { Theme.round() })
	if known then
		DesignArt.swatch(swatch, entry.id)
		Theme.stroke(Colors.rarityOf(entry).color, 3).Parent = swatch
	else
		Theme.label({
			Size = UDim2.fromScale(1, 1),
			Text = "?",
			Font = Theme.Fonts.Display,
			TextColor3 = C.InkFaint,
			MaxTextSize = 30,
			Parent = swatch,
		})
	end
	Theme.label({
		Position = UDim2.fromOffset(4, 70),
		Size = UDim2.new(1, -8, 0, 18),
		Text = known and entry.name or "???",
		Font = Theme.Fonts.Bold,
		MaxTextSize = 15,
		Parent = cell,
	})
	Theme.label({
		Position = UDim2.fromOffset(4, 88),
		Size = UDim2.new(1, -8, 0, 16),
		Text = entry.basic and "∞" or ("x" .. count),
		Font = Theme.Fonts.Heavy,
		TextColor3 = count > 0 and C.MintDark or C.InkFaint,
		MaxTextSize = 14,
		Parent = cell,
	})
end

function Machine.refreshCollection()
	if not (collection and collection.Holder.Visible and app.state) then
		return
	end
	local list = refs.collectionList
	for _, child in ipairs(list:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	local chances = Colors.chances(Config.luck(app.state.upgrades))
	local found, total = 0, 0
	for _, entry in ipairs(Colors.List) do
		if not entry.basic then
			total += 1
			if knownPaints and knownPaints[entry.id] then
				found += 1
			end
		end
	end
	refs.collectionProgress.Text = "Descubiertos " .. found .. "/" .. total
	local order = 0
	local sections = {}
	for i = #Colors.Rarities, 1, -1 do
		table.insert(sections, Colors.Rarities[i])
	end
	table.insert(sections, Colors.BASIC_RARITY)
	for _, rarity in ipairs(sections) do
		order += 1
		local header = Theme.new(
			"Frame",
			{ Size = UDim2.new(1, 0, 0, 34), BackgroundTransparency = 1, LayoutOrder = order, Parent = list }
		)
		local chip = Theme.chip({
			Size = UDim2.fromOffset(150, 30),
			Color = rarity.color,
			Text = rarity.name,
			TextColor3 = C.White,
			MaxTextSize = 16,
			Parent = header,
		})
		chip.Position = UDim2.fromOffset(0, 2)
		Theme.label({
			Position = UDim2.fromOffset(160, 4),
			Size = UDim2.new(1, -170, 0, 26),
			Text = rarity.id == "basico" and "Siempre disponibles · x1.0" or string.format(
				"Acabado %s  ·  Valor x%.1f  ·  %.1f%% por tirada",
				rarity.finish,
				rarity.mult,
				chances[rarity.id] * 100
			),
			Font = Theme.Fonts.Bold,
			TextColor3 = C.InkSoft,
			TextXAlignment = Enum.TextXAlignment.Left,
			MaxTextSize = 17,
			Parent = header,
		})
		order += 1
		local entries = {}
		for _, entry in ipairs(Colors.List) do
			if (rarity.id == "basico" and entry.basic) or entry.rarity == rarity.id then
				table.insert(entries, entry)
			end
		end
		local rows = math.ceil(#entries / 7)
		local grid = Theme.new("Frame", {
			Size = UDim2.new(1, 0, 0, rows * 122),
			BackgroundTransparency = 1,
			LayoutOrder = order,
			Parent = list,
		}, {
			Theme.new("UIGridLayout", {
				CellSize = UDim2.fromOffset(110, 112),
				CellPadding = UDim2.fromOffset(8, 10),
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
		})
		for i, entry in ipairs(entries) do
			colorCell(grid, entry, app.state.paints[entry.id] or 0, i)
		end
	end
end

-- Muestra la ventana de color conseguido (también la usa el mezclador).
function Machine.reveal(colorId, isNew)
	knownPaints = knownPaints or {}
	knownPaints[colorId] = true
	showPopup(colorId, isNew)
end

function Machine.openCollection()
	collection.Open()
	Machine.refreshCollection()
end

-- Tiradas ----------------------------------------------------------------------------------------
local function jiggleBalls()
	local machine = myMachine()
	if not machine then
		return
	end
	for _, ball in ipairs(machine:GetChildren()) do
		if ball.Name == "Ball" and ball:IsA("BasePart") then
			local base = ball.CFrame
			local up = base * CFrame.new(math.random() - 0.5, math.random() * 0.9, math.random() - 0.5)
			Theme.tween(ball, 0.12, { CFrame = up })
			task.delay(0.14, function()
				if ball.Parent then
					Theme.tween(ball, 0.25, { CFrame = base }, Enum.EasingStyle.Bounce)
				end
			end)
		end
	end
end

local function showColor(colorId)
	local entry = Colors.ById[colorId]
	if entry then
		DesignArt.swatch(refs.swatch, colorId)
	end
	local text, color = rarityText(colorId)
	refs.name.Text = entry and entry.name or ""
	refs.rarityLabel.Text = text
	refs.rarityChip.BackgroundColor3 = entry and color or C.PanelSoft
	refs.rarityLabel.TextColor3 = entry and C.White or C.InkSoft
	refs.reelStroke.Color = color
	board.name.Text = entry and entry.name or "Máquina de colores"
	board.rarity.Text = text
	board.rarity.TextColor3 = color
end

local function hideCardLater()
	cardToken += 1
	local token = cardToken
	task.delay(2.2, function()
		if token == cardToken then
			refs.card.Visible = false
		end
	end)
end

function Machine.onRoll(colorId, auto)
	local entry = Colors.ById[colorId]
	if not entry then
		return
	end
	local isNew = knownPaints ~= nil and not knownPaints[colorId]
	if knownPaints then
		knownPaints[colorId] = true
	end
	local rarity = Colors.rarityOf(entry)
	jiggleBalls()
	if auto then
		-- Las tiradas automáticas no interrumpen: solo avisan si sale algo bueno.
		if not spinning then
			showColor(colorId)
		end
		if rarity.index >= 3 or isNew then
			app.notify(
				"🤖 «" .. entry.name .. "» · " .. rarity.name .. " x" .. string.format("%.1f", rarity.mult),
				rarity.index >= 4 and "gold" or "success"
			)
		end
		return
	end
	spinToken += 1
	local token = spinToken
	spinning = true
	cardToken += 1
	refs.card.Visible = true
	Theme.popCard(refs.card, 0.85)
	refs.name.Text = "Girando…"
	refs.rarityLabel.Text = ""
	refs.rarityChip.BackgroundColor3 = C.PanelSoft
	refs.count.Text = ""
	task.spawn(function()
		local options = {}
		for _, option in ipairs(Colors.List) do
			if not option.basic then
				table.insert(options, option.id)
			end
		end
		for i = 1, 12 do
			if token ~= spinToken then
				return
			end
			DesignArt.swatch(refs.swatch, options[math.random(1, #options)])
			if i % 2 == 0 then
				Theme.playSound("click", 1.4 + i * 0.03)
			end
			task.wait(0.03 + i * 0.009)
		end
		if token ~= spinToken then
			return
		end
		spinning = false
		showColor(colorId)
		Theme.pop(refs.swatch, 0.5)
		if app.state then
			refs.count.Text = "Tienes x" .. (app.state.paints[colorId] or 0)
		end
		if rarity.index >= 3 or isNew then
			showPopup(colorId, isNew)
		else
			Theme.playSound("success", 1.3)
		end
		hideCardLater()
	end)
end

function Machine.applyState(state)
	knownPaints = table.clone(state.discovered or {})
	if not spinning then
		showColor(state.lastRoll)
	end
	local left = (state.pityMax or 0) - (state.pity or 0)
	board.pity.Text = left <= 1 and "🎯 ¡La próxima es Raro o mejor!"
		or ("🎯 Raro o mejor seguro en " .. left .. " tiradas")
	board.auto.Visible = state.autoUnlocked == true
	board.auto.Text = state.autoRoll and "Auto-Rolling activo  [F]" or "Auto-Rolling en pausa  [F]"
	board.auto.TextColor3 = state.autoRoll and C.MintDark or C.InkSoft
	Machine.refreshCollection()
end

function Machine.init(appRef)
	app = appRef
	gui = Theme.new("ScreenGui", {
		Name = "MachineHud",
		ResetOnSpawn = false,
		DisplayOrder = 3,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	buildResultCard()
	buildBoard()
	buildPopup()
	buildCollection()

	-- Coloca el cartel sobre tu máquina cuando aparece tu terreno.
	task.spawn(function()
		while true do
			task.wait(0.25)
			if app.state and not board.gui.Adornee then
				local machine = myMachine()
				local top = machine and machine:FindFirstChild("Top")
				board.gui.Adornee = top
				board.gui.Enabled = top ~= nil
			elseif board.gui.Adornee and not board.gui.Adornee.Parent then
				board.gui.Adornee = nil
				board.gui.Enabled = false
			end
		end
	end)

	local cardScale = Theme.new("UIScale", { Name = "ViewportScale", Parent = refs.card })
	local popupScale = Theme.new("UIScale", { Name = "ViewportScale", Parent = refs.popup })
	local function updateScale()
		local camera = Workspace.CurrentCamera
		if camera then
			local viewport = camera.ViewportSize
			cardScale.Scale = math.clamp(math.min(viewport.X / 1280, viewport.Y / 720), 0.6, 1)
			popupScale.Scale = math.clamp(viewport.Y / 720, 0.6, 1)
		end
	end
	updateScale()
	if Workspace.CurrentCamera then
		Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
	end
end

function Machine.setVisible(visible)
	gui.Enabled = visible
end

return Machine
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="28">
            <Properties>
              <string name="Name">Mixer</string>
              <string name="Source"><![CDATA[-- Mezclador de colores del taller: echas varios botes de una misma rareza y
-- sale un color de la rareza siguiente (la mitad de las veces, uno nuevo).

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Colors = require(Shared.Colors)

local Theme = require(script.Parent.Theme)
local DesignArt = require(script.Parent.DesignArt)

local Mixer = {}

local C = Theme.Colors
local MIXABLE = { "comun", "pococomun", "raro", "epico", "legendario" }

local app
local window
local refs = {}
local rarityId = "comun"
local picks = {} -- lista de colorId en los huecos
local busy = false
local shownKey = nil -- evita redibujar si nada cambió

local function need()
	return Colors.MixCost[rarityId]
end

local function owned(colorId)
	return app.state and app.state.paints[colorId] or 0
end

local function pickedCount(colorId)
	local count = 0
	for _, id in ipairs(picks) do
		if id == colorId then
			count += 1
		end
	end
	return count
end

local function picksMap()
	local map = {}
	for _, id in ipairs(picks) do
		map[id] = (map[id] or 0) + 1
	end
	return map
end

-- Huecos del mezclador y resultado ------------------------------------------------------------------
local function refreshSlots()
	for _, child in ipairs(refs.slots:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	local rarity = Colors.RarityById[rarityId]
	for i = 1, need() do
		local colorId = picks[i]
		local slot = Theme.new("TextButton", {
			Name = "Slot" .. i,
			Size = UDim2.fromOffset(64, 64),
			BackgroundColor3 = C.PanelSoft,
			AutoButtonColor = false,
			Text = colorId and "" or "+",
			Font = Theme.Fonts.Display,
			TextColor3 = C.InkFaint,
			TextScaled = true,
			LayoutOrder = i,
			Parent = refs.slots,
		}, { Theme.round(), Theme.stroke(colorId and rarity.color or C.Border, colorId and 3 or 2) })
		if colorId then
			DesignArt.swatch(slot, colorId)
			slot.Activated:Connect(function()
				table.remove(picks, i)
				Theme.playSound("click", 0.9)
				Mixer.refresh()
			end)
		end
	end
	local nextRarity = Colors.Rarities[rarity.index + 1]
	refs.resultChip.BackgroundColor3 = nextRarity.color
	refs.resultText.Text = "1 color " .. nextRarity.name
	refs.resultSwatch.BackgroundColor3 = nextRarity.color
	refs.resultHint.Text = "Acabado "
		.. nextRarity.finish:lower()
		.. " · valor x"
		.. string.format("%.1f", nextRarity.mult)
	local full = #picks == need()
	refs.mix.SetEnabled(full)
	refs.mix.SetText(full and "🧪 ¡Mezclar!" or ("Faltan " .. need() - #picks .. " colores"))
end

-- Colores que tienes de la rareza elegida ---------------------------------------------------------
local function refreshColors()
	for _, child in ipairs(refs.grid:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	local rarity = Colors.RarityById[rarityId]
	local any = false
	for order, entry in ipairs(Colors.ByRarity[rarityId]) do
		local count = owned(entry.id)
		if count > 0 then
			any = true
			local left = count - pickedCount(entry.id)
			local _, cell =
				Theme.card({ Size = UDim2.fromOffset(104, 112), Radius = 14, LayoutOrder = order, Parent = refs.grid })
			local swatch = Theme.new("Frame", {
				AnchorPoint = Vector2.new(0.5, 0),
				Position = UDim2.new(0.5, 0, 0, 10),
				Size = UDim2.fromOffset(54, 54),
				Parent = cell,
			}, { Theme.round(), Theme.stroke(rarity.color, 3) })
			DesignArt.swatch(swatch, entry.id)
			Theme.label({
				Position = UDim2.fromOffset(4, 68),
				Size = UDim2.new(1, -8, 0, 18),
				Text = entry.name,
				Font = Theme.Fonts.Bold,
				MaxTextSize = 14,
				Parent = cell,
			})
			Theme.label({
				Position = UDim2.fromOffset(4, 88),
				Size = UDim2.new(1, -8, 0, 16),
				Text = "x" .. left,
				Font = Theme.Fonts.Heavy,
				TextColor3 = left > 0 and C.MintDark or C.InkFaint,
				MaxTextSize = 14,
				Parent = cell,
			})
			local button = Theme.new("TextButton", {
				Name = "Add_" .. entry.id,
				Size = UDim2.fromScale(1, 1),
				BackgroundTransparency = 1,
				Text = "",
				Parent = cell,
			})
			button.Activated:Connect(function()
				if left > 0 and #picks < need() then
					table.insert(picks, entry.id)
					Theme.playSound("paint", 1.2)
					Mixer.refresh()
				end
			end)
		end
	end
	refs.none.Visible = not any
end

function Mixer.refresh()
	if not (window and window.Holder.Visible and app.state) then
		return
	end
	-- Quita de los huecos lo que ya no tengas.
	for i = #picks, 1, -1 do
		if pickedCount(picks[i]) > owned(picks[i]) then
			table.remove(picks, i)
		end
	end
	local key = rarityId .. ":" .. table.concat(picks, ",")
	for _, entry in ipairs(Colors.ByRarity[rarityId]) do
		key ..= "|" .. owned(entry.id)
	end
	if key == shownKey then
		return
	end
	shownKey = key
	for id, tab in pairs(refs.tabs) do
		tab.SetVariant(id == rarityId and "purple" or "ghost")
	end
	refs.rule.Text = need() .. " colores " .. Colors.RarityById[rarityId].name .. " → 1 color de la rareza siguiente"
	refreshColors()
	refreshSlots()
end

local function autoFill()
	local options = {}
	for _, entry in ipairs(Colors.ByRarity[rarityId]) do
		local left = owned(entry.id) - pickedCount(entry.id)
		if left > 0 then
			table.insert(options, { id = entry.id, left = left })
		end
	end
	-- Primero los repetidos (los que más tienes).
	table.sort(options, function(a, b)
		return a.left > b.left
	end)
	for _, option in ipairs(options) do
		while option.left > 0 and #picks < need() do
			table.insert(picks, option.id)
			option.left -= 1
		end
	end
	Mixer.refresh()
end

local function mix()
	if busy or #picks ~= need() then
		return
	end
	busy = true
	refs.mix.SetEnabled(false)
	refs.mix.SetText("Mezclando…")
	Theme.playSound("whoosh", 0.8)
	Theme.pop(refs.slots, 0.8)
	local ok, success, colorId, isNew = pcall(function()
		return app.remotes.MixColors:InvokeServer(rarityId, picksMap())
	end)
	busy = false
	picks = {}
	if ok and success and Colors.ById[colorId] then
		Mixer.close()
		app.reveal(colorId, isNew)
	else
		app.notify(ok and colorId or "No se pudo mezclar.", "error")
		Mixer.refresh()
	end
end

-- Construcción -------------------------------------------------------------------------------------
function Mixer.open()
	shownKey = nil
	window.Open()
	Mixer.refresh()
end

function Mixer.close()
	window.Close()
end

function Mixer.init(appRef)
	app = appRef
	local gui = Theme.new("ScreenGui", {
		Name = "Mixer",
		ResetOnSpawn = false,
		DisplayOrder = 14,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = Players.LocalPlayer:WaitForChild("PlayerGui"),
	})
	window = Theme.window({
		Name = "Window",
		Parent = gui,
		Size = UDim2.fromOffset(860, 560),
		Title = "Mezclador de colores",
		Subtitle = "Junta colores repetidos y consigue uno más raro",
		Icon = "🧪",
		Accent = "purple",
	})
	local body = window.Body
	-- Pestañas de rareza.
	local tabs = Theme.new("Frame", {
		Position = UDim2.fromOffset(18, 12),
		Size = UDim2.new(1, -36, 0, 44),
		BackgroundTransparency = 1,
		Parent = body,
	}, { Theme.list("h", 8) })
	refs.tabs = {}
	for i, id in ipairs(MIXABLE) do
		local rarity = Colors.RarityById[id]
		refs.tabs[id] = Theme.button({
			Size = UDim2.new(0.2, -7, 1, 0),
			Text = rarity.name,
			Variant = "ghost",
			Radius = 12,
			MaxTextSize = 16,
			LayoutOrder = i,
			Parent = tabs,
			OnClick = function()
				if rarityId ~= id then
					rarityId = id
					picks = {}
					Mixer.refresh()
				end
			end,
		})
	end
	refs.rule = Theme.label({
		Position = UDim2.fromOffset(18, 62),
		Size = UDim2.new(1, -36, 0, 22),
		Text = "",
		Font = Theme.Fonts.Bold,
		TextColor3 = C.InkSoft,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 16,
		Parent = body,
	})
	-- Tus colores de esa rareza.
	refs.grid = Theme.new("ScrollingFrame", {
		Position = UDim2.fromOffset(18, 92),
		Size = UDim2.new(0, 470, 1, -110),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = C.InkFaint,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = body,
	}, {
		Theme.new("UIGridLayout", {
			CellSize = UDim2.fromOffset(104, 112),
			CellPadding = UDim2.fromOffset(10, 10),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
		Theme.padding(4),
	})
	refs.none = Theme.label({
		Position = UDim2.fromOffset(18, 150),
		Size = UDim2.fromOffset(470, 80),
		Text = "No tienes colores de esta rareza.\nTíralos en la máquina de colores 🎰",
		Font = Theme.Fonts.Bold,
		TextColor3 = C.InkSoft,
		MaxTextSize = 18,
		Visible = false,
		Parent = body,
	})
	-- La jarra: huecos, flecha y resultado.
	local _, jar = Theme.card({
		Position = UDim2.new(1, -350, 0, 92),
		Size = UDim2.fromOffset(332, 376),
		Radius = 18,
		Parent = body,
	})
	Theme.label({
		Position = UDim2.fromOffset(12, 10),
		Size = UDim2.new(1, -24, 0, 22),
		Text = "En el mezclador",
		Font = Theme.Fonts.Heavy,
		MaxTextSize = 18,
		Parent = jar,
	})
	refs.slots = Theme.new("Frame", {
		Position = UDim2.fromOffset(12, 40),
		Size = UDim2.new(1, -24, 0, 140),
		BackgroundTransparency = 1,
		Parent = jar,
	}, {
		Theme.new("UIGridLayout", {
			CellSize = UDim2.fromOffset(64, 64),
			CellPadding = UDim2.fromOffset(10, 10),
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	Theme.label({
		Position = UDim2.fromOffset(12, 182),
		Size = UDim2.new(1, -24, 0, 30),
		Text = "⬇",
		Font = Theme.Fonts.Heavy,
		TextColor3 = C.InkFaint,
		MaxTextSize = 28,
		Parent = jar,
	})
	refs.resultSwatch = Theme.new("Frame", {
		Position = UDim2.fromOffset(24, 218),
		Size = UDim2.fromOffset(56, 56),
		Parent = jar,
	}, { Theme.round(), Theme.stroke(C.White, 3) })
	Theme.label({
		Size = UDim2.fromScale(1, 1),
		Text = "?",
		Font = Theme.Fonts.Display,
		TextColor3 = C.White,
		MaxTextSize = 30,
		Parent = refs.resultSwatch,
	})
	refs.resultChip = Theme.new("Frame", {
		Position = UDim2.fromOffset(92, 222),
		Size = UDim2.new(1, -116, 0, 28),
		Parent = jar,
	}, { Theme.round() })
	refs.resultText = Theme.label({
		Size = UDim2.fromScale(1, 1),
		Text = "",
		Font = Theme.Fonts.Heavy,
		TextColor3 = C.White,
		MaxTextSize = 16,
		Parent = refs.resultChip,
	})
	refs.resultHint = Theme.label({
		Position = UDim2.fromOffset(92, 252),
		Size = UDim2.new(1, -116, 0, 18),
		Text = "",
		Font = Theme.Fonts.Medium,
		TextColor3 = C.InkSoft,
		MaxTextSize = 14,
		Parent = jar,
	})
	Theme.button({
		Position = UDim2.fromOffset(12, 284),
		Size = UDim2.new(0.4, -12, 0, 42),
		Text = "Auto",
		Variant = "ghost",
		Radius = 12,
		MaxTextSize = 17,
		Parent = jar,
		OnClick = autoFill,
	})
	refs.mix = Theme.button({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 284),
		Size = UDim2.new(0.6, -12, 0, 42),
		Text = "",
		Variant = "purple",
		Radius = 12,
		MaxTextSize = 18,
		Parent = jar,
		OnClick = mix,
	})
	Theme.label({
		Position = UDim2.fromOffset(12, 334),
		Size = UDim2.new(1, -24, 0, 32),
		Text = "La mitad de las veces sale un color que aún no tienes.",
		Font = Theme.Fonts.Medium,
		TextColor3 = C.InkSoft,
		MaxTextSize = 14,
		Parent = jar,
	})
end

function Mixer.isOpen()
	return window ~= nil and window.Holder.Visible
end

return Mixer
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="29">
            <Properties>
              <string name="Name">Offers</string>
              <string name="Source"><![CDATA[-- Ofertas de la caja: cuando un visitante quiere un cuadro y tu precio le
-- parece alto, te hace una oferta. Puedes aceptarla, pedirle un poco más o
-- rechazarla. Las tarjetas se ven también mientras pintas.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Designs = require(Shared.Designs)
local Exhibition = require(Shared.Exhibition)

local Theme = require(script.Parent.Theme)
local DesignArt = require(script.Parent.DesignArt)

local Offers = {}

local C = Theme.Colors
local CARD_WIDTH = 340
local CARD_HEIGHT = 214

local app
local holder
local cards = {}

local function closeCard(id, text)
	local card = cards[id]
	if not card then
		return
	end
	cards[id] = nil
	card.closing = true
	if text then
		card.status.Text = text
	end
	task.delay(text and 1.2 or 0.2, function()
		Theme.tween(card.scale, 0.2, { Scale = 0.6 })
		task.wait(0.2)
		card.holder:Destroy()
	end)
end

local function respond(id, action)
	local card = cards[id]
	if not card or card.answered then
		return
	end
	card.answered = true
	for _, button in ipairs(card.buttons) do
		button.SetEnabled(false)
	end
	card.status.Text = action == "accept" and "✔ Aceptada"
		or (action == "counter" and "↔ Pediste 💵" .. Theme.formatNumber(card.data.counter) or "✖ Rechazada")
	app.remotes.RespondOffer:FireServer(id, action)
end

local function buildCard(data)
	local cardHolder, body = Theme.card({
		Name = "Offer" .. data.id,
		Size = UDim2.fromOffset(CARD_WIDTH, CARD_HEIGHT),
		Radius = 18,
		Color = C.Bg,
		StrokeColor = data.vip and C.Gold or C.Navy,
		StrokeThickness = data.vip and 3 or 2,
		ShadowTransparency = 0.7,
		LayoutOrder = data.id,
		Parent = holder,
	})
	local scale = Theme.new("UIScale", { Name = "PopScale", Parent = cardHolder })
	-- Cabecera con el visitante.
	local header = Theme.new("Frame", {
		Size = UDim2.new(1, 0, 0, 50),
		BackgroundColor3 = C.White,
		Parent = body,
	}, {
		Theme.corner(18),
		Theme.gradient(
			data.vip and Theme.Gradients.gold[1] or Theme.Gradients.navy[1],
			data.vip and Theme.Gradients.gold[2] or Theme.Gradients.navy[2],
			90
		),
	})
	Theme.new("Frame", {
		Position = UDim2.new(0, 0, 1, -14),
		Size = UDim2.new(1, 0, 0, 14),
		BackgroundColor3 = data.vip and Theme.Gradients.gold[2] or Theme.Gradients.navy[2],
		BorderSizePixel = 0,
		Parent = header,
	})
	Theme.new("ImageLabel", {
		Position = UDim2.fromOffset(10, 6),
		Size = UDim2.fromOffset(38, 38),
		BackgroundColor3 = C.PanelSoft,
		Image = data.userId and ("rbxthumb://type=AvatarHeadShot&id=" .. data.userId .. "&w=150&h=150") or "",
		Parent = header,
	}, { Theme.round(), Theme.stroke(C.White, 2) })
	Theme.label({
		Position = UDim2.fromOffset(56, 6),
		Size = UDim2.new(1, -66, 0, 22),
		Text = (data.vip and "👑 " or "") .. tostring(data.buyer) .. " está en la caja",
		Font = Theme.Fonts.Heavy,
		TextColor3 = C.White,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 17,
		Parent = header,
	})
	Theme.label({
		Position = UDim2.fromOffset(56, 27),
		Size = UDim2.new(1, -66, 0, 16),
		Text = data.final and "Te hace su ÚLTIMA oferta" or "Te hace una oferta por tu cuadro",
		Font = Theme.Fonts.Medium,
		TextColor3 = C.White,
		TextTransparency = 0.15,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 14,
		Parent = header,
	})
	-- Cuadro y cifras.
	local art = Theme.new("Frame", {
		Position = UDim2.fromOffset(12, 60),
		Size = UDim2.fromOffset(70, 70),
		BackgroundColor3 = C.White,
		Parent = body,
	}, { Theme.corner(4), Theme.stroke(C.Navy, 3) })
	local design = Designs.get(data.designId or "")
	if design then
		DesignArt.render(art, design, { mode = "color", colors = Designs.decodeColors(data.colors), outline = false })
	end
	Theme.label({
		Position = UDim2.fromOffset(94, 58),
		Size = UDim2.new(1, -104, 0, 20),
		Text = design and ("«" .. design.name .. "»") or "",
		Font = Theme.Fonts.Heavy,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 16,
		Parent = body,
	})
	Theme.label({
		Position = UDim2.fromOffset(94, 78),
		Size = UDim2.new(1, -104, 0, 18),
		Text = "Tu precio 💵 " .. Theme.formatNumber(data.price) .. "  ·  Medio 💵 " .. Theme.formatNumber(
			data.market
		),
		Font = Theme.Fonts.Bold,
		TextColor3 = C.InkSoft,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 14,
		Parent = body,
	})
	local ratio = data.offer / math.max(1, data.price)
	Theme.label({
		Position = UDim2.fromOffset(94, 98),
		Size = UDim2.fromOffset(150, 32),
		Text = "💵 " .. Theme.formatNumber(data.offer),
		Font = Theme.Fonts.Display,
		TextColor3 = C.Ink,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 30,
		Parent = body,
	})
	Theme.chip({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 104),
		Size = UDim2.fromOffset(70, 26),
		Text = math.floor(ratio * 100 + 0.5) .. "%",
		Color = ratio >= Exhibition.CASHIER_ACCEPT and C.MintLight or C.GoldLight,
		TextColor3 = ratio >= Exhibition.CASHIER_ACCEPT and C.MintDark or C.GoldDark,
		MaxTextSize = 15,
		Parent = body,
	})
	-- Botones.
	local row = Theme.new("Frame", {
		Position = UDim2.fromOffset(12, 140),
		Size = UDim2.new(1, -24, 0, 42),
		BackgroundTransparency = 1,
		Parent = body,
	}, { Theme.list("h", 8) })
	local buttons = {}
	table.insert(
		buttons,
		Theme.button({
			Size = UDim2.new(data.final and 0.6 or 0.36, -6, 1, 0),
			Text = "✔ Aceptar",
			Variant = "mint",
			Radius = 12,
			MaxTextSize = 17,
			LayoutOrder = 1,
			Parent = row,
			OnClick = function()
				respond(data.id, "accept")
			end,
		})
	)
	if not data.final then
		table.insert(
			buttons,
			Theme.button({
				Size = UDim2.new(0.4, -6, 1, 0),
				Text = "Pedir 💵" .. Theme.formatNumber(data.counter),
				Variant = "gold",
				Radius = 12,
				MaxTextSize = 16,
				LayoutOrder = 2,
				Parent = row,
				OnClick = function()
					respond(data.id, "counter")
				end,
			})
		)
	end
	table.insert(
		buttons,
		Theme.button({
			Size = UDim2.new(data.final and 0.4 or 0.24, -6, 1, 0),
			Text = "✖ No",
			Variant = "ghost",
			TextColor = C.Red,
			Radius = 12,
			MaxTextSize = 16,
			LayoutOrder = 3,
			Parent = row,
			OnClick = function()
				respond(data.id, "reject")
			end,
		})
	)
	local status = Theme.label({
		Position = UDim2.fromOffset(12, 186),
		Size = UDim2.new(1, -24, 0, 14),
		Text = data.cashier and "Si no respondes, tu cajero decide por ti" or "Si no respondes, se irá sin comprar",
		Font = Theme.Fonts.Medium,
		TextColor3 = C.InkSoft,
		MaxTextSize = 12,
		Parent = body,
	})
	local timer = Theme.progress({
		Position = UDim2.new(0, 14, 1, -8),
		Size = UDim2.new(1, -28, 0, 4),
		Gradient = data.vip and "gold" or "primary",
		Parent = body,
	})
	timer.Set(1)
	local card = {
		holder = cardHolder,
		scale = scale,
		status = status,
		buttons = buttons,
		data = data,
		started = os.clock(),
		timer = timer,
	}
	Theme.pop(cardHolder, 0.7)
	return card
end

function Offers.show(data)
	if type(data) ~= "table" or not data.id then
		return
	end
	cards[data.id] = buildCard(data)
	Theme.playSound("success", 1.7)
	-- El temporizador se vacía hasta que el visitante se cansa.
	task.spawn(function()
		local card = cards[data.id]
		while card and cards[data.id] == card do
			local left = 1 - (os.clock() - card.started) / math.max(1, data.time or 20)
			card.timer.Set(left)
			task.wait(0.1)
		end
	end)
end

function Offers.closed(id)
	local card = cards[id]
	if card then
		closeCard(id, not card.answered and "⏳ Se acabó el tiempo" or nil)
	end
end

function Offers.init(appRef)
	app = appRef
	local gui = Theme.new("ScreenGui", {
		Name = "Offers",
		ResetOnSpawn = false,
		DisplayOrder = 20,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = Players.LocalPlayer:WaitForChild("PlayerGui"),
	})
	holder = Theme.new("Frame", {
		Name = "Holder",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 84),
		Size = UDim2.fromOffset(CARD_WIDTH, 600),
		BackgroundTransparency = 1,
		Parent = gui,
	}, { Theme.list("v", 10, Enum.HorizontalAlignment.Right) })
	local function updateScale()
		local camera = workspace.CurrentCamera
		if not camera then
			return
		end
		local viewport = camera.ViewportSize
		local scale = holder:FindFirstChild("ViewportScale")
			or Theme.new("UIScale", { Name = "ViewportScale", Parent = holder })
		scale.Scale = math.clamp(math.min(viewport.X / 1280, viewport.Y / 720), 0.6, 1)
	end
	updateScale()
	if workspace.CurrentCamera then
		workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
	end
end

return Offers
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="30">
            <Properties>
              <string name="Name">Painter</string>
              <string name="Source"><![CDATA[-- Estudio de pintura. El dibujo aparece como un boceto numerado y se pinta
-- color por color, como en la vida real: eliges un bote de la paleta de
-- madera y las zonas de ese color se iluminan (más color, contorno que late y
-- su número destacado) mientras las demás se quedan casi en blanco. El pincel
-- solo deja pintura en esas zonas, con vetas como el óleo, y cada figura se
-- completa al cubrir casi toda su superficie. Cuanto más rápido, más estrellas.

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Colors = require(Shared.Colors)
local Config = require(Shared.Config)
local Designs = require(Shared.Designs)

local Theme = require(script.Parent.Theme)
local DesignArt = require(script.Parent.DesignArt)

local Painter = {}

local C = Theme.Colors
local COMPLETE_AT = 0.9 -- fracción de la figura cubierta para completarla
local STROKE_STEP = 0.5 -- muestreo del trazo (en radios del pincel)
local MAX_SEGMENT = 0.25 -- largo máximo de un trazo dibujado (fracción del lienzo)
local MAX_STROKES = 500 -- trazos por figura (la pintura sigue contando después)
local WOOD_LIGHT = Color3.fromRGB(226, 186, 136)
local WOOD = Color3.fromRGB(200, 152, 102)
local WOOD_DARK = Color3.fromRGB(150, 106, 66)

local app
local gui, canvasFrame, overlay, catcher, cursor, cursorTip
local refs = {}
local current
local stroking = false
local pointer = nil
local lastBrush = nil
local tool = "brush"
local soundClock = 0
local confirmCancelUntil = 0
local finishing = false
local nagUntil = 0

-- Utilidades ----------------------------------------------------------------------------------
local function levels()
	return app.state and app.state.upgrades or {}
end

local function canvasPoint(position)
	local absPos = canvasFrame.AbsolutePosition
	local absSize = canvasFrame.AbsoluteSize
	if absSize.X <= 0 then
		return nil
	end
	return (position.X - absPos.X) / absSize.X, (position.Y - absPos.Y) / absSize.Y
end

-- Puntos de muestra de cada figura (solo donde la figura se ve): la figura se
-- completa cuando el pincel ha pasado cerca de casi todos.
local function buildSamples(design, radius)
	local spacing = radius * 1.2
	local list = {}
	for i, shape in ipairs(design.shapes) do
		local info = {
			points = {},
			painted = 0,
			total = 0,
			complete = false,
			strokes = 0,
			cx = shape.x,
			cy = shape.y,
			area = shape.area,
			bound = 0.5 * math.sqrt(shape.w * shape.w + shape.h * shape.h),
		}
		if shape.visible > 0 then
			local nx = math.clamp(math.ceil(shape.w / spacing), 2, 40)
			local ny = math.clamp(math.ceil(shape.h / spacing), 2, 40)
			local rad = math.rad(shape.rot)
			local c, s = math.cos(rad), math.sin(rad)
			for gx = 1, nx do
				for gy = 1, ny do
					local lx = ((gx - 0.5) / nx - 0.5) * shape.w
					local ly = ((gy - 0.5) / ny - 0.5) * shape.h
					local x = shape.x + lx * c - ly * s
					local y = shape.y + lx * s + ly * c
					if x >= 0 and x <= 1 and y >= 0 and y <= 1 and Designs.shapeAt(design, x, y) == i then
						table.insert(info.points, { x, y, false })
					end
				end
			end
			if #info.points == 0 then
				-- Figura diminuta: basta con pasar por su centro.
				table.insert(info.points, { shape.x, shape.y, false })
			end
		end
		info.total = #info.points
		list[i] = info
	end
	return list
end

-- Dónde va el número de cada figura: el punto visible más alejado de sus
-- bordes (así no tapa detalles y siempre queda dentro de la zona).
local LABEL_GRID = 48
local labelCache = {}
local function labelSpots(design)
	if labelCache[design.id] then
		return labelCache[design.id]
	end
	local n = LABEL_GRID
	local owner = {}
	for gy = 0, n - 1 do
		for gx = 0, n - 1 do
			owner[gy * n + gx] = Designs.shapeAt(design, (gx + 0.5) / n, (gy + 0.5) / n) or 0
		end
	end
	local spots = {}
	for i in ipairs(design.shapes) do
		-- Distancia (en celdas) al borde más cercano de la figura.
		local dist = {}
		local queue = {}
		for gy = 0, n - 1 do
			for gx = 0, n - 1 do
				local index = gy * n + gx
				if owner[index] ~= i then
					dist[index] = 0
					table.insert(queue, index)
				elseif gx == 0 or gy == 0 or gx == n - 1 or gy == n - 1 then
					dist[index] = 1
					table.insert(queue, index)
				end
			end
		end
		local head = 1
		while head <= #queue do
			local index = queue[head]
			head += 1
			local gx, gy = index % n, index // n
			local d = dist[index] + 1
			for _, offset in ipairs({ { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } }) do
				local nx, ny = gx + offset[1], gy + offset[2]
				if nx >= 0 and ny >= 0 and nx < n and ny < n then
					local other = ny * n + nx
					if dist[other] == nil then
						dist[other] = d
						table.insert(queue, other)
					end
				end
			end
		end
		local best, bestIndex = 0, nil
		for index, d in pairs(dist) do
			if owner[index] == i and d > best then
				best, bestIndex = d, index
			end
		end
		if bestIndex then
			spots[i] = { x = (bestIndex % n + 0.5) / n, y = (bestIndex // n + 0.5) / n, r = best / n }
		end
	end
	labelCache[design.id] = spots
	return spots
end

local function areaPercent(areaId)
	local total, done = 0, 0
	for i, shape in ipairs(current.design.shapes) do
		if shape.area == areaId and shape.visible > 0 then
			local info = current.samples[i]
			local p = info.complete and 1 or info.painted / math.max(info.total, 1)
			total += shape.visible
			done += shape.visible * p
		end
	end
	return total > 0 and done / total or 1
end

local function totalPercent()
	local total, done = 0, 0
	for i, shape in ipairs(current.design.shapes) do
		if shape.visible > 0 then
			local info = current.samples[i]
			local p = info.complete and 1 or info.painted / math.max(info.total, 1)
			total += shape.visible
			done += shape.visible * p
		end
	end
	return total > 0 and done / total or 1
end

local function isComplete()
	for _, info in ipairs(current.samples) do
		if not info.complete then
			return false
		end
	end
	return true
end

local function elapsed()
	return os.clock() - current.started
end

local function areaName(areaId)
	local area = current.design.areaById[areaId]
	return area and area.name or ""
end

local function areaMain(areaId)
	return Colors.mainColor(current.colors[areaId])
end

-- Bocadillo de ayuda sobre la paleta (o el lienzo).
local function coach(text)
	refs.coach.Visible = text ~= nil
	if text then
		refs.coachText.Text = text
	end
end

local function refreshCoach()
	local text = nil
	if current and not current.done then
		if not current.activeArea then
			text = "👇 Elige un color de la paleta para empezar"
		elseif areaPercent(current.activeArea) >= 0.999 then
			text = "✔ ¡" .. areaName(current.activeArea) .. " listo! Elige otro color"
		elseif app.state and app.state.tutorial == 3 and totalPercent() < 0.08 then
			text = "🖌️ Pasa el pincel por las zonas marcadas de " .. areaName(current.activeArea)
		end
	end
	coach(text)
end

local function refreshLabels()
	for areaId, slot in pairs(current.slots) do
		local p = areaPercent(areaId)
		slot.bar.Set(p)
		slot.check.Visible = p >= 0.999
		local active = areaId == current.activeArea
		slot.ring.Thickness = active and 4 or 0
		slot.blob.Position = UDim2.new(0.5, 0, 0, active and 2 or 8)
	end
	local total = totalPercent()
	refs.percent.Text = math.floor(total * 100) .. "%"
	refs.progress.Set(total)
	refreshCoach()
end

local function refreshTimer()
	if not current or current.done then
		return
	end
	local par = Config.parTime(current.design, levels())
	local t = elapsed()
	local stars = Config.starsFor(current.design, levels(), t)
	for i, star in ipairs(refs.stars) do
		star.TextColor3 = i <= stars and C.Gold or C.Border
	end
	refs.timerBar.Set(1 - math.clamp(t / (par * 2.5), 0, 1))
	refs.timerBar.SetGradient(stars >= 3 and "gold" or (stars == 2 and "orange" or "red"))
	refs.timerText.Text = string.format("%d:%02d", math.floor(t / 60), math.floor(t % 60))
end

local function spawnParticle(x, y, color, burst)
	local dot = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(x, y),
		Size = UDim2.fromScale(0.022, 0.022),
		BackgroundColor3 = color,
		ZIndex = 6,
		Parent = overlay,
	}, { Theme.round(), Theme.stroke(C.White, 1.5, 0.3) })
	local angle = math.random() * math.pi * 2
	local distance = (burst and 0.1 or 0.04) * (0.4 + math.random())
	Theme.tween(dot, 0.5, {
		Position = UDim2.fromScale(x + math.cos(angle) * distance, y + math.sin(angle) * distance),
		Size = UDim2.fromScale(0.004, 0.004),
		BackgroundTransparency = 1,
	})
	task.delay(0.55, function()
		dot:Destroy()
	end)
end

local function nag(text)
	if os.clock() > nagUntil then
		nagUntil = os.clock() + 2.5
		app.notify(text, "info")
		Theme.pop(refs.paletteBody, 0.94)
	end
end

-- Pintar ---------------------------------------------------------------------------------------
local completeIfDone
local buildLabels

local function completeShape(i, animate)
	local info = current.samples[i]
	if info.complete then
		return
	end
	info.complete = true
	current.art.complete(i, animate)
	if animate then
		local shape = current.design.shapes[i]
		for _ = 1, 6 do
			spawnParticle(shape.x, shape.y, areaMain(shape.area), true)
		end
		Theme.playSound("success", 1.5 + math.random() * 0.3)
	end
	refreshLabels()
	completeIfDone()
end

-- Cubre los puntos cercanos a (x, y) en las figuras del color elegido y
-- devuelve qué figuras tocó el pincel.
local function coverAt(x, y, touched)
	local radius = current.radius
	local r2 = radius * radius
	local reach = radius * 1.25
	local reach2 = reach * reach
	local painted = false
	for i, info in ipairs(current.samples) do
		if info.area == current.activeArea and not info.complete and info.total > 0 then
			local dx, dy = x - info.cx, y - info.cy
			local limit = info.bound + reach
			if dx * dx + dy * dy <= limit * limit then
				local newly = 0
				for _, point in ipairs(info.points) do
					local px, py = point[1] - x, point[2] - y
					local d2 = px * px + py * py
					if d2 <= reach2 then
						touched[i] = true
						if d2 <= r2 and not point[3] then
							point[3] = true
							newly += 1
						end
					end
				end
				if newly > 0 then
					painted = true
					info.painted += newly
				end
			end
		end
	end
	return painted
end

-- Un tramo de pincelada desde el punto anterior hasta (x, y).
local function strokeTo(x, y)
	local radius = current.radius
	local fromX, fromY = x, y
	if lastBrush then
		fromX, fromY = lastBrush[1], lastBrush[2]
	end
	local distance = math.sqrt((x - fromX) ^ 2 + (y - fromY) ^ 2)
	if lastBrush and distance < radius * 0.25 then
		return false
	end
	local steps = math.clamp(math.ceil(distance / (radius * STROKE_STEP)), 1, 80)
	local touched = {}
	local painted = false
	for k = 1, steps do
		local t = k / steps
		if coverAt(fromX + (x - fromX) * t, fromY + (y - fromY) * t, touched) then
			painted = true
		end
	end
	-- Dibuja el trazo en cada figura tocada (el CanvasGroup lo recorta).
	local pieces = math.max(1, math.ceil(distance / MAX_SEGMENT))
	local tint = areaMain(current.activeArea):Lerp(
		math.random() < 0.5 and Color3.new(1, 1, 1) or Color3.new(0, 0, 0),
		math.random() * 0.07
	)
	for i in pairs(touched) do
		local info = current.samples[i]
		if info.strokes < MAX_STROKES then
			for k = 1, pieces do
				local a, b = (k - 1) / pieces, k / pieces
				current.art.addStroke(
					i,
					fromX + (x - fromX) * a,
					fromY + (y - fromY) * a,
					fromX + (x - fromX) * b,
					fromY + (y - fromY) * b,
					radius,
					tint
				)
				info.strokes += 1
			end
		end
	end
	for i in pairs(touched) do
		local info = current.samples[i]
		if not info.complete and info.painted / info.total >= COMPLETE_AT then
			completeShape(i, true)
		end
	end
	if painted then
		current.lastProgress = os.clock()
	end
	lastBrush = { x, y }
	return painted
end

local function bucket(x, y)
	local index = Designs.shapeAt(current.design, x, y)
	local info = index and current.samples[index]
	if not info or info.complete then
		return
	end
	if info.area ~= current.activeArea then
		nag("Esa zona va de otro color: elige «" .. areaName(info.area) .. "» en la paleta")
		return
	end
	current.art.flood(index, x, y, 0.3)
	info.painted = info.total
	current.lastProgress = os.clock()
	Theme.playSound("whoosh", 1.3)
	for _ = 1, 8 do
		spawnParticle(x, y, areaMain(info.area), true)
	end
	task.delay(0.28, function()
		if current and current.samples[index] == info then
			completeShape(index, true)
		end
	end)
end

function completeIfDone()
	if not current.done and isComplete() then
		current.done = true
		current.finishedAt = elapsed()
		stroking = false
		refreshLabels()
		task.delay(0.6, function()
			if current and current.done then
				Painter.showComplete()
			end
		end)
	end
end

local function selectArea(areaId)
	if not current or current.done then
		return
	end
	current.activeArea = areaId
	current.art.setFocus(areaId)
	current.lastProgress = os.clock()
	current.flashAt = os.clock()
	lastBrush = nil
	Theme.playSound("click", 1.25)
	refreshLabels()
	local slot = current.slots[areaId]
	if slot then
		Theme.pop(slot.blob, 0.8)
	end
end

local function updateCursor()
	if not pointer or not current or current.done then
		cursor.Visible = false
		return
	end
	local x, y = canvasPoint(pointer)
	if not x or x < 0 or y < 0 or x > 1 or y > 1 then
		cursor.Visible = false
		return
	end
	local radius = tool == "bucket" and 0.03 or current.radius
	cursor.Visible = true
	cursor.Position = UDim2.fromScale(x, y)
	cursor.Size = UDim2.fromScale(radius * 2, radius * 2)
	local color = current.activeArea and areaMain(current.activeArea) or C.InkFaint
	cursor.BackgroundColor3 = color
	cursor.BackgroundTransparency = current.activeArea and 0.35 or 0.7
	refs.cursorStroke.Color = color:Lerp(Color3.new(0, 0, 0), 0.35)
	cursorTip.Text = tool == "bucket" and "🪣" or "🖌️"
end

-- Resaltado: las zonas del color elegido laten siempre (más fuerte al
-- elegirlo y si llevas un rato sin avanzar) y sus números se agrandan.
-- Sin color elegido, brilla la paleta.
local function updateHints()
	local now = os.clock()
	local idle = not current.done and now - (current.lastProgress or now) > 2.5
	refs.paletteGlow.Thickness = (not current.done and not current.activeArea) and (2 + 2 * math.abs(math.sin(now * 4)))
		or 0
	local alpha = 0
	if current.activeArea and not current.done then
		local wave = 0.5 + 0.5 * math.sin(now * 5)
		alpha = idle and wave or wave * 0.45
		local flash = 1 - (now - (current.flashAt or 0)) / 0.9
		if flash > 0 then
			alpha = math.max(alpha, flash * (0.5 + 0.5 * math.sin(now * 18)))
		end
	end
	for i, info in ipairs(current.samples) do
		local active = not info.complete and info.area == current.activeArea
		current.art.setHint(i, active and alpha or 0)
	end
	for _, label in ipairs(current.labels or {}) do
		local info = current.samples[label.index]
		local active = not current.done and info.area == current.activeArea
		if info.complete then
			label.frame.Visible = false
		else
			label.frame.Visible = true
			label.frame.BackgroundTransparency = active and 0 or 1
			label.text.TextColor3 = active and C.Ink or C.InkFaint
			label.text.TextTransparency = (current.activeArea == nil or active) and 0 or 0.35
			label.ring.Thickness = active and 2.5 or 0
			label.scale.Scale = active and (1.1 + alpha * 0.2) or 0.8
		end
	end
end

local function onStep(dt)
	if not current then
		return
	end
	updateCursor()
	updateHints()
	current.timerClock = (current.timerClock or 0) + dt
	if current.timerClock > 0.2 then
		current.timerClock = 0
		refreshTimer()
	end
	if stroking and pointer and not current.done and tool == "brush" then
		local x, y = canvasPoint(pointer)
		if x and x >= -0.1 and y >= -0.1 and x <= 1.1 and y <= 1.1 then
			if not current.activeArea then
				nag("🎨 Primero elige un color de la paleta")
				return
			end
			if strokeTo(x, y) then
				current.labelClock = (current.labelClock or 0) + dt
				if current.labelClock > 0.1 then
					current.labelClock = 0
					refreshLabels()
				end
				soundClock += dt
				if soundClock > 0.16 then
					soundClock = 0
					Theme.playSound("paint", 0.9 + math.random() * 0.3)
				end
			end
		else
			lastBrush = nil
		end
	end
end

-- Interfaz ---------------------------------------------------------------------------------------
local function setTool(name)
	tool = name
	refs.brushButton.SetVariant(name == "brush" and "primary" or "ghost")
	refs.bucketButton.SetVariant(name == "bucket" and "primary" or "ghost")
end

