	})
	refs.another = Theme.button({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 528),
		Size = UDim2.new(1, -60, 0, 48),
		Text = "🎨 Guardarlo y pintar otro",
		Variant = "ghost",
		Radius = 14,
		MaxTextSize = 19,
		Parent = panel,
		OnClick = function()
			Painter.finish(true)
		end,
	})
end

local function buildUI()
	gui = Theme.new("ScreenGui", {
		Name = "Painter",
		ResetOnSpawn = false,
		DisplayOrder = 15,
		Enabled = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = Players.LocalPlayer:WaitForChild("PlayerGui"),
	})
	-- Fondo de estudio (pared crema) que tapa también la barra de Roblox.
	local background = Theme.new("Frame", {
		Position = UDim2.fromOffset(0, -80),
		Size = UDim2.new(1, 0, 1, 80),
		BackgroundColor3 = C.White,
		Parent = gui,
	}, { Theme.gradient(Color3.fromRGB(246, 238, 224), Color3.fromRGB(226, 214, 196), 90) })
	local root = Theme.new("Frame", {
		Position = UDim2.fromOffset(0, 80),
		Size = UDim2.new(1, 0, 1, -80),
		BackgroundTransparency = 1,
		Parent = background,
	})
	buildTopBar(root)
	buildCanvas(root)
	buildPalette(root)
	buildComplete()
end

local function updateScales()
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local viewport = camera.ViewportSize
	local scale = math.clamp(math.min((viewport.X - 20) / 460, (viewport.Y - 100) / 600), 0.45, 1.1)
	local uiScale = refs.doneWrapper:FindFirstChild("ViewportScale")
		or Theme.new("UIScale", { Name = "ViewportScale", Parent = refs.doneWrapper })
	uiScale.Scale = scale
	local hudScale = math.clamp(math.min(viewport.X / 1280, viewport.Y / 720), 0.6, 1)
	for _, frame in ipairs({ refs.timerCard, refs.palette }) do
		local s = frame:FindFirstChild("ViewportScale")
			or Theme.new("UIScale", { Name = "ViewportScale", Parent = frame })
		s.Scale = hudScale
	end
end

local function bindInput()
	UserInputService.InputChanged:Connect(function(input)
		if not current then
			return
		end
		if
			input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch
		then
			pointer = input.Position
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			stroking = false
			lastBrush = nil
			if current then
				refreshLabels()
			end
		end
	end)
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or not current then
			return
		end
		if input.KeyCode == Enum.KeyCode.B then
			setTool("brush")
		elseif input.KeyCode == Enum.KeyCode.F and Config.hasBucket(levels()) then
			setTool("bucket")
		end
		-- Teclas 1-9 para elegir color.
		if input.KeyCode then
			local digit = input.KeyCode.Value - Enum.KeyCode.One.Value + 1
			local areaDef = digit >= 1 and digit <= 9 and current.design.areas[digit]
			if areaDef then
				selectArea(areaDef.id)
			end
		end
	end)
	RunService.RenderStepped:Connect(onStep)
end

local function setControlsEnabled(enabled)
	pcall(function()
		local playerModule = require(Players.LocalPlayer.PlayerScripts:WaitForChild("PlayerModule", 2))
		local controls = playerModule:GetControls()
		if enabled then
			controls:Enable()
		else
			controls:Disable()
		end
	end)
end

-- API --------------------------------------------------------------------------------------------
function Painter.open(design, colors)
	local radius = Config.brushRadius(levels())
	current = {
		design = design,
		colors = colors,
		radius = radius,
		samples = buildSamples(design, radius),
		slots = {},
		done = false,
		started = os.clock(),
		lastProgress = os.clock(),
		activeArea = nil,
	}
	stroking = false
	lastBrush = nil
	current.art = DesignArt.render(canvasFrame, design, { mode = "paint", colors = colors, stroke = 2 })
	for i, info in ipairs(current.samples) do
		-- Las figuras completamente tapadas ya cuentan como pintadas.
		if info.total == 0 then
			info.complete = true
			current.art.complete(i, false)
		end
	end
	buildLabels(design, colors)
	fillPalette(design, colors)
	refs.title.Text = design.name
	refs.done.Visible = false
	setTool(tool == "bucket" and Config.hasBucket(levels()) and "bucket" or "brush")
	refreshLabels()
	refreshTimer()
	updateScales()
	gui.Enabled = true
	ProximityPromptService.Enabled = false
	setControlsEnabled(false)
	app.setHudVisible(false)
	Theme.playSound("whoosh")
	completeIfDone()
end

function Painter.isOpen()
	return current ~= nil
end

function Painter.close()
	current = nil
	stroking = false
	gui.Enabled = false
	refs.done.Visible = false
	ProximityPromptService.Enabled = true
	setControlsEnabled(true)
	app.setHudVisible(true)
end

function Painter.requestCancel()
	if not current then
		return
	end
	if os.clock() > confirmCancelUntil then
		confirmCancelUntil = os.clock() + 3
		refs.exit.SetText("¿Salir?")
		task.delay(3, function()
			refs.exit.SetText("✕ Salir")
		end)
		app.notify("Toca otra vez para salir (te devolvemos las pinturas).", "info")
		return
	end
	confirmCancelUntil = 0
	refs.exit.SetText("✕ Salir")
	app.remotes.CancelPainting:FireServer()
	Painter.close()
end

function Painter.showComplete()
	local state = app.state
	local design = current.design
	local stars = Config.starsFor(design, levels(), current.finishedAt or elapsed())
	current.stars = stars
	local made = state and state.made[design.id] or 0
	local value = Config.paintingValue(design, current.colors, levels(), made, stars)
	local price = math.floor(value * Config.GALLERY_BONUS)
	local tier = Config.masteryFor(made)
	DesignArt.render(refs.doneArt, design, { mode = "color", colors = current.colors, outline = false })
	refs.doneValue.Text = "Precio medio: 💵 " .. Theme.formatNumber(price)
	refs.doneBreakdown.Text = string.format(
		"Colores x%.2f  ·  Estrellas +%d%%  ·  Maestría +%d%%",
		Config.colorMultiplier(design, current.colors),
		math.floor(Config.STAR_BONUS[stars] * 100),
		math.floor((tier and tier.bonus or 0) * 100)
	)
	refs.doneInfo.Text =
		"Llévalo a un stand de la sala y ponle tu precio: los visitantes te harán ofertas en la caja."
	local stored = state and state.storage and #state.storage or 0
	refs.another.SetEnabled(stored + 1 < Config.STORAGE_SIZE)
	for _, star in ipairs(refs.doneStars) do
		star.TextColor3 = C.NavyDark
		star.TextTransparency = 0.3
	end
	updateScales()
	refs.done.Visible = true
	Theme.pop(refs.donePanelCard, 0.6)
	Theme.playSound("success", 1)
	task.spawn(function()
		task.wait(0.35)
		for i = 1, stars do
			local star = refs.doneStars[i]
			if not star.Parent then
				return
			end
			star.TextColor3 = C.Gold
			star.TextTransparency = 0
			Theme.pop(star, 1.8)
			Theme.playSound("success", 0.9 + i * 0.15)
			task.wait(0.28)
		end
		if stars >= 3 then
			app.celebrate()
		end
	end)
end

-- Entrega el cuadro: va al almacén y lo llevas a la espalda hasta exponerlo.
function Painter.finish(paintAnother)
	if finishing or not current then
		return
	end
	finishing = true
	local result
	for _ = 1, 30 do
		local ok, response = pcall(function()
			return app.remotes.FinishPainting:InvokeServer()
		end)
		result = ok and response or nil
		if result and not result.ok and result.reason == "¡Aún no está terminado!" then
			task.wait(1)
		else
			break
		end
	end
	finishing = false
	if not (result and result.ok) then
		app.notify(result and result.reason or "No se pudo terminar el cuadro.", "error")
		return
	end
	local design = Designs.get(result.designId)
	Painter.close()
	if result.freeStands then
		app.notify(
			"🖼️ Llevas «" .. (design and design.name or "tu cuadro") .. "»: exponlo en un stand libre de la sala",
			"success"
		)
	else
		app.notify("Todos tus stands están ocupados: compra otro stand en la sala (＋).", "info")
	end
	if result.mastery then
		app.notify("🏅 ¡Maestría de " .. result.mastery .. " en este diseño!", "gold")
	end
	if result.newLevel then
		app.notify("🔓 ¡Nivel " .. result.newLevel .. " de diseños desbloqueado!", "gold")
		app.celebrate()
	end
	if paintAnother then
		task.defer(app.openDesigns)
	end
end

function Painter.init(appRef)
	app = appRef
	buildUI()
	bindInput()
	if workspace.CurrentCamera then
		workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScales)
	end
end

return Painter
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="31">
            <Properties>
              <string name="Name">Shop</string>
              <string name="Source"><![CDATA[-- Tienda de mejoras del taller y la galería, agrupadas por secciones.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Colors = require(Shared.Colors)
local Config = require(Shared.Config)
local Exhibition = require(Shared.Exhibition)

local Theme = require(script.Parent.Theme)

local Shop = {}

local C = Theme.Colors

local SECTIONS = {
	{ name = "Máquina de colores", ids = { "suerte", "velocidad", "auto" } },
	{ name = "Pintura", ids = { "pincel", "cubeta" } },
	{ name = "Galería", ids = { "precio", "fama", "cajero", "decoracion" } },
}

local app
local window
local cards = {}
local busy = false

-- Efecto actual → siguiente de cada mejora.
local function effectText(id, level)
	local levels = { [id] = level }
	local nextLevels = { [id] = level + 1 }
	if id == "precio" or id == "decoracion" then
		return string.format("Valor x%.2f → x%.2f", Config.payMultiplier(levels), Config.payMultiplier(nextLevels))
	elseif id == "suerte" then
		local function rare(chances)
			return (chances.raro + chances.epico + chances.legendario + chances.mitico) * 100
		end
		return string.format(
			"Raro o mejor %.1f%% → %.1f%%",
			rare(Colors.chances(Config.luck(levels))),
			rare(Colors.chances(Config.luck(nextLevels)))
		)
	elseif id == "velocidad" then
		return string.format("Recarga %.1fs → %.1fs", Config.rollInterval(levels), Config.rollInterval(nextLevels))
	elseif id == "auto" then
		return "Tira sola cada " .. string.format("%.1f", Config.autoRollInterval({})) .. "s"
	elseif id == "pincel" then
		local base = Config.brushRadius({})
		return string.format(
			"Grosor %d%% → %d%%",
			math.floor(Config.brushRadius(levels) / base * 100 + 0.5),
			math.floor(Config.brushRadius(nextLevels) / base * 100 + 0.5)
		)
	elseif id == "cubeta" then
		return "Un toque rellena una figura"
	elseif id == "fama" then
		return string.format(
			"Visitas cada %.0fs → %.0fs · VIP %d%%",
			Config.buyerInterval(levels),
			Config.buyerInterval(nextLevels),
			math.floor(Config.vipChance(nextLevels) * 100 + 0.5)
		)
	elseif id == "cajero" then
		return "Acepta solo las ofertas de al menos el " .. math.floor(Exhibition.CASHIER_ACCEPT * 100) .. "%"
	end
	return ""
end

local function buildCard(upgrade, order, parent)
	local _, body = Theme.card({
		Name = upgrade.id,
		Size = UDim2.fromOffset(372, 132),
		Radius = 14,
		LayoutOrder = order,
		Parent = parent,
	})
	local icon = Theme.new("Frame", {
		Position = UDim2.fromOffset(12, 12),
		Size = UDim2.fromOffset(60, 60),
		BackgroundColor3 = C.PanelSoft,
		Parent = body,
	}, { Theme.corner(12) })
	Theme.label({ Size = UDim2.fromScale(1, 1), Text = upgrade.icon, MaxTextSize = 30, Parent = icon })
	Theme.label({
		Position = UDim2.fromOffset(88, 10),
		Size = UDim2.new(1, -170, 0, 24),
		Text = upgrade.name,
		Font = Theme.Fonts.Heavy,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 18,
		Parent = body,
	})
	local level, levelLabel = Theme.chip({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 12),
		Size = UDim2.fromOffset(72, 22),
		Color = C.PanelSoft,
		TextColor3 = C.InkSoft,
		Text = "",
		MaxTextSize = 12,
		Parent = body,
	})
	Theme.label({
		Position = UDim2.fromOffset(88, 34),
		Size = UDim2.new(1, -100, 0, 18),
		Text = upgrade.desc,
		Font = Theme.Fonts.Medium,
		TextColor3 = C.InkSoft,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 14,
		Parent = body,
	})
	local effect = Theme.label({
		Position = UDim2.fromOffset(88, 54),
		Size = UDim2.new(1, -100, 0, 18),
		Text = "",
		Font = Theme.Fonts.Bold,
		TextColor3 = C.Primary,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 14,
		Parent = body,
	})
	local bar = Theme.progress({
		Position = UDim2.fromOffset(12, 98),
		Size = UDim2.new(1, -170, 0, 6),
		Gradient = "primary",
		Parent = body,
	})
	local button = Theme.button({
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -12, 1, -12),
		Size = UDim2.fromOffset(140, 40),
		Text = "",
		Variant = "primary",
		Radius = 12,
		MaxTextSize = 17,
		Parent = body,
		OnClick = function()
			Shop.buy(upgrade, body)
		end,
	})
	cards[upgrade.id] = { effect = effect, bar = bar, button = button, level = level, levelLabel = levelLabel }
end

function Shop.buy(upgrade, body)
	if busy then
		return
	end
	busy = true
	local ok, success, message = pcall(function()
		return app.remotes.BuyUpgrade:InvokeServer(upgrade.id)
	end)
	busy = false
	if ok and success then
		Theme.playSound("success", 1.2)
		app.notify("✨ " .. message, "success")
		Theme.pop(body, 0.92)
	else
		app.notify(ok and message or "No se pudo comprar.", "error")
	end
end

function Shop.refresh()
	local state = app.state
	if not (state and window) then
		return
	end
	window.Subtitle.Text = "Tienes 💵 " .. Theme.formatNumber(state.coins)
	for _, upgrade in ipairs(Config.Upgrades) do
		local card = cards[upgrade.id]
		local level = state.upgrades[upgrade.id] or 0
		card.bar.Set(level / upgrade.max)
		card.levelLabel.Text = "Nv " .. level .. "/" .. upgrade.max
		if level >= upgrade.max then
			card.effect.Text = "Nivel máximo"
			card.button.SetText("Completado")
			card.button.SetEnabled(false)
		else
			local cost = Config.upgradeCost(upgrade.id, level)
			card.effect.Text = effectText(upgrade.id, level)
			card.button.SetText("💵 " .. Theme.formatNumber(cost))
			card.button.SetEnabled(state.coins >= cost)
		end
	end
end

function Shop.open()
	window.Open()
	Shop.refresh()
end

function Shop.close()
	window.Close()
end

function Shop.init(appRef)
	app = appRef
	local gui = Theme.new("ScreenGui", {
		Name = "Shop",
		ResetOnSpawn = false,
		DisplayOrder = 14,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = Players.LocalPlayer:WaitForChild("PlayerGui"),
	})
	window = Theme.window({
		Name = "Window",
		Parent = gui,
		Size = UDim2.fromOffset(830, 640),
		Title = "Mejoras",
		Icon = "🛒",
		Accent = "primary",
	})
	local list = Theme.new("ScrollingFrame", {
		Position = UDim2.fromOffset(18, 12),
		Size = UDim2.new(1, -36, 1, -24),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = C.InkFaint,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = window.Body,
	}, {
		Theme.list("v", 10),
		Theme.new("UIPadding", {
			PaddingRight = UDim.new(0, 10),
			PaddingLeft = UDim.new(0, 4),
			PaddingTop = UDim.new(0, 4),
			PaddingBottom = UDim.new(0, 12),
		}),
	})
	local order = 0
	for _, section in ipairs(SECTIONS) do
		order += 1
		Theme.label({
			Size = UDim2.new(1, 0, 0, 26),
			Text = section.name,
			Font = Theme.Fonts.Heavy,
			TextColor3 = C.InkSoft,
			TextXAlignment = Enum.TextXAlignment.Left,
			MaxTextSize = 16,
			LayoutOrder = order,
			Parent = list,
		})
		order += 1
		local rows = math.ceil(#section.ids / 2)
		local grid = Theme.new("Frame", {
			Size = UDim2.new(1, 0, 0, rows * 146),
			BackgroundTransparency = 1,
			LayoutOrder = order,
			Parent = list,
		}, {
			Theme.new("UIGridLayout", {
				CellSize = UDim2.fromOffset(372, 132),
				CellPadding = UDim2.fromOffset(14, 14),
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
		})
		for i, id in ipairs(section.ids) do
			buildCard(Config.UpgradeById[id], i, grid)
		end
	end
end

return Shop
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="32">
            <Properties>
              <string name="Name">StandPanel</string>
              <string name="Source"><![CDATA[-- Panel de un stand de la sala: eliges qué cuadro exponer, le pones tu
-- precio (el juego te enseña el precio medio y cómo de rápido se venderá),
-- lo retiras o mejoras la calidad del stand.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Designs = require(Shared.Designs)
local Exhibition = require(Shared.Exhibition)

local Theme = require(script.Parent.Theme)
local DesignArt = require(script.Parent.DesignArt)

local StandPanel = {}

local C = Theme.Colors
local METER_MIN, METER_MAX = 0.5, 2
local TIER_COLORS = {
	Color3.fromRGB(214, 176, 128),
	Color3.fromRGB(44, 48, 56),
	Color3.fromRGB(232, 184, 80),
}

local app
local window
local refs = {}
local spot = nil
local selected = 1 -- índice del cuadro elegido en el almacén
local price = 0
local busy = false
local previewKey, storageKey = nil, nil -- evita redibujar si nada cambió

local function state()
	return app.state
end

local function entryOnStand()
	local s = state()
	for _, entry in ipairs(s and s.gallery or {}) do
		if entry.s == spot then
			return entry
		end
	end
	return nil
end

local function tierOf()
	local s = state()
	return s and s.stands and s.stands[spot] or 0
end

-- Cuadro que se está editando: el expuesto o el elegido del almacén.
local function currentPainting()
	local entry = entryOnStand()
	if entry then
		return entry, true
	end
	local s = state()
	return s and s.storage and s.storage[selected], false
end

local function marketOf(painting)
	return painting and Exhibition.marketPrice(painting.v, math.max(1, tierOf())) or 0
end

local function ratioToMeter(ratio)
	return math.clamp((ratio - METER_MIN) / (METER_MAX - METER_MIN), 0, 1)
end

-- Precio y medidor ---------------------------------------------------------------------------
local function refreshPrice()
	local painting = currentPainting()
	local market = marketOf(painting)
	refs.priceSection.Visible = painting ~= nil
	if not painting then
		return
	end
	price = Exhibition.clampPrice(price, market)
	local ratio = price / math.max(1, market)
	local band = Exhibition.band(ratio)
	refs.market.Text = "Precio medio: 💵 " .. Theme.formatNumber(market)
	refs.price.Text = "💵 " .. Theme.formatNumber(price)
	refs.percent.Text = math.floor(ratio * 100 + 0.5) .. "% del precio medio"
	refs.bandText.Text = band.text
	refs.bandText.TextColor3 = Theme.darker(band.color, 0.25)
	refs.marker.Position = UDim2.new(ratioToMeter(ratio), 0, 0.5, 0)
	refs.markerDot.BackgroundColor3 = band.color
	local interest = Exhibition.interest(ratio)
	refs.interest.Text = string.format("Interés de los visitantes: %d%%", math.floor(interest * 100 + 0.5))
	local onStand = entryOnStand()
	if onStand then
		refs.primary.SetText("💾 Guardar precio")
		refs.primary.SetEnabled(price ~= onStand.p)
	else
		refs.primary.SetText("🖼️ Exponer por 💵 " .. Theme.formatNumber(price))
		refs.primary.SetEnabled(true)
	end
end

local function setPrice(value)
	price = value
	refreshPrice()
end

-- Vista previa y calidad del stand --------------------------------------------------------------
local function refreshPreview()
	local painting = currentPainting()
	local design = painting and Designs.get(painting.d)
	local tier = tierOf()
	refs.artFrame.BackgroundColor3 = TIER_COLORS[math.clamp(tier, 1, 3)]
	local key = design and (painting.d .. painting.c .. (painting.st or 1)) or ""
	if key == previewKey then
		design = nil
	end
	previewKey = key
	if key == "" then
		design = nil
	end
	if design then
		refs.placeholder.Visible = false
		DesignArt.render(refs.art, design, {
			mode = "color",
			colors = Designs.decodeColors(painting.c),
			outlineThickness = 1.5,
		})
		refs.paintingName.Text = design.name
		refs.paintingStars.Text = string.rep("★", painting.st or 1) .. string.rep("☆", 3 - (painting.st or 1))
	elseif key == "" then
		local old = refs.art:FindFirstChild("Art")
		if old then
			old:Destroy()
		end
		refs.placeholder.Visible = true
		refs.paintingName.Text = "Stand vacío"
		refs.paintingStars.Text = ""
	end
	-- Calidad del stand y mejora.
	local def = Exhibition.Spots[spot]
	refs.tierName.Text = Exhibition.tierName(spot, tier)
	local bonus = Exhibition.tierBonus(tier)
	refs.tierBonus.Text = bonus > 0 and string.format("+%d%% de precio medio", math.floor(bonus * 100 + 0.5))
		or "Calidad básica"
	if tier >= Exhibition.MAX_TIER then
		refs.upgrade.SetText("✨ Calidad máxima")
		refs.upgrade.SetEnabled(false)
		refs.upgradeInfo.Text = "Este stand ya luce como en un museo."
	else
		local cost = Exhibition.upgradeCost(tier, def.room)
		local nextBonus = Exhibition.tierBonus(tier + 1)
		refs.upgrade.SetText("Mejorar · 💵 " .. Theme.formatNumber(cost))
		refs.upgrade.SetEnabled((state().coins or 0) >= cost)
		refs.upgradeInfo.Text = "→ "
			.. Exhibition.tierName(spot, tier + 1)
			.. string.format(" (+%d%%)", math.floor(nextBonus * 100 + 0.5))
	end
end

-- Lista de cuadros del almacén -----------------------------------------------------------------------
local function refreshStorage()
	local onStand = entryOnStand()
	local storage = state().storage or {}
	local key = (onStand and "on" or "off") .. selected .. ":" .. tierOf()
	for _, painting in ipairs(storage) do
		key ..= "|" .. painting.d .. painting.c .. painting.v
	end
	if key == storageKey then
		return
	end
	storageKey = key
	for _, child in ipairs(refs.storageList:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	refs.storageSection.Visible = onStand == nil
	refs.manage.Visible = onStand ~= nil
	refs.empty.Visible = onStand == nil and #storage == 0
	refs.priceTitle.Text = onStand and "Precio del cuadro" or "2. Ponle tu precio"
	if onStand then
		return
	end
	if selected > #storage then
		selected = 1
	end
	for i, painting in ipairs(storage) do
		local design = Designs.get(painting.d)
		local card = Theme.new("TextButton", {
			Name = "Stored" .. i,
			Size = UDim2.fromOffset(96, 112),
			BackgroundColor3 = C.Panel,
			AutoButtonColor = false,
			Text = "",
			LayoutOrder = i,
			Parent = refs.storageList,
		}, { Theme.corner(12), Theme.stroke(i == selected and C.Primary or C.Border, i == selected and 3 or 1.5) })
		local box = Theme.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0, 8),
			Size = UDim2.fromOffset(72, 72),
			BackgroundColor3 = C.White,
			Parent = card,
		}, { Theme.corner(4), Theme.stroke(C.Navy, 2) })
		if design then
			DesignArt.render(
				box,
				design,
				{ mode = "color", colors = Designs.decodeColors(painting.c), outline = false }
			)
		end
		Theme.label({
			Position = UDim2.fromOffset(4, 84),
			Size = UDim2.new(1, -8, 0, 20),
			Text = "💵 " .. Theme.formatNumber(Exhibition.marketPrice(painting.v, math.max(1, tierOf()))),
			Font = Theme.Fonts.Heavy,
			TextColor3 = C.Ink,
			MaxTextSize = 15,
			Parent = card,
		})
		card.Activated:Connect(function()
			if selected ~= i then
				selected = i
				Theme.playSound("click", 1.2)
				price = Exhibition.marketPrice(painting.v, math.max(1, tierOf()))
				refreshStorage()
				refreshPreview()
				refreshPrice()
			end
		end)
	end
end

function StandPanel.refresh()
	if not (window and spot and window.Holder.Visible and state()) then
		return
	end
	if tierOf() == 0 then
		StandPanel.close()
		return
	end
	local def = Exhibition.Spots[spot]
	local room = Exhibition.Rooms[def.room]
	window.Title.Text = "Stand " .. spot .. " · " .. Exhibition.tierName(spot, tierOf())
	window.Subtitle.Text = (room and room.name or "") .. " · Tienes 💵 " .. Theme.formatNumber(state().coins)
	refreshStorage()
	refreshPreview()
	refreshPrice()
end

-- Acciones -----------------------------------------------------------------------------------------
local function invoke(action, a, b)
	if busy then
		return false
	end
	busy = true
	local ok, success, message = pcall(function()
		return app.remotes.StandAction:InvokeServer(action, spot, a, b)
	end)
	busy = false
	if ok and success then
		return true, message
	end
	app.notify(ok and message or "No se pudo hacer.", "error")
	return false
end

local function primaryAction()
	local onStand = entryOnStand()
	if onStand then
		local ok, message = invoke("price", price)
		if ok then
			Theme.playSound("success", 1.3)
			app.notify(message, "success")
		end
		return
	end
	local ok, message = invoke("exhibit", selected, price)
	if ok then
		Theme.playSound("success", 1.1)
		app.notify(message, "success")
		StandPanel.close()
	end
end

-- Construcción ---------------------------------------------------------------------------------------
local function sectionTitle(parent, text, y)
	return Theme.label({
		Position = UDim2.fromOffset(0, y),
		Size = UDim2.new(1, 0, 0, 24),
		Text = text,
		Font = Theme.Fonts.Heavy,
		TextColor3 = C.Ink,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 19,
		Parent = parent,
	})
end

local function buildLeft(body)
	local _, card = Theme.card({
