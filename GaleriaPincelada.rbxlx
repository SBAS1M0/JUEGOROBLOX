        <Item class="LocalScript" referent="18">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- Punto de entrada del cliente: conecta la interfaz con el servidor.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")
local Workspace = game:GetService("Workspace")

local UI = script.Parent:WaitForChild("UI")
local Theme = require(UI.Theme)
local HUD = require(UI.HUD)
local Studio = require(UI.Studio)
local Shop = require(UI.Shop)
local Results = require(UI.Results)
local World = require(script.Parent:WaitForChild("World"))

local player = Players.LocalPlayer
local remotes = ReplicatedStorage:WaitForChild("Remotes")

local app = {
	state = nil,
	remotes = {},
	patienceColor = World.patienceColor,
	orderPreview = World.orderPreview,
}
for _, name in ipairs({
	"GetState",
	"StateChanged",
	"Notify",
	"OpenOrder",
	"StartPainting",
	"StopPainting",
	"SubmitPainting",
	"BuyUpgrade",
	"ClaimDaily",
	"GoHome",
}) do
	app.remotes[name] = remotes:WaitForChild(name)
end

function app.notify(text, kind)
	HUD.notify(text, kind)
end

function app.openShop()
	Shop.open()
end

function app.showHelp()
	Results.showHelp()
end

function app.openStudio(model)
	if Studio.isOpen() then
		return
	end
	Studio.open(model)
end

function app.showResults(result, template, art)
	Results.show(result, template, art)
end

local claiming = false
function app.claimDaily()
	if claiming then
		return
	end
	if not (app.state and app.state.dailyReady) then
		app.notify(
			"Tu próximo regalo llega en " .. Theme.formatTime(app.state and app.state.dailyWait or 0) .. " ⏰",
			"info"
		)
		return
	end
	claiming = true
	local ok, success, amount = pcall(function()
		return app.remotes.ClaimDaily:InvokeServer()
	end)
	claiming = false
	if ok and success then
		Theme.playSound("success", 1.1)
		app.notify("🎁 ¡Regalo diario! +" .. Theme.formatNumber(amount) .. " monedas", "gold")
	end
end

local function applyState(state)
	if type(state) ~= "table" then
		return
	end
	local first = app.state == nil
	app.state = state
	HUD.applyState(state)
	Shop.refresh()
	if first and state.sold == 0 then
		task.delay(1.5, Results.showHelp)
	end
end

-- Quita la mochila (no se usa) y prepara la interfaz.
pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
end)

HUD.init(app)
Studio.init(app)
Shop.init(app)
Results.init()
Studio.start()
World.start()

app.remotes.StateChanged.OnClientEvent:Connect(applyState)
app.remotes.Notify.OnClientEvent:Connect(function(text, kind)
	app.notify(text, kind)
end)
app.remotes.OpenOrder.OnClientEvent:Connect(function(orderId)
	local plots = Workspace:FindFirstChild("Plots")
	if not plots then
		return
	end
	for _, plot in ipairs(plots:GetChildren()) do
		local customers = plot:FindFirstChild("Customers")
		if customers then
			for _, model in ipairs(customers:GetChildren()) do
				if model:GetAttribute("OrderId") == orderId then
					app.openStudio(model)
					return
				end
			end
		end
	end
end)

task.spawn(function()
	local ok, state = pcall(function()
		return app.remotes.GetState:InvokeServer()
	end)
	if ok and state and not app.state then
		applyState(state)
	end
end)

player.CharacterAdded:Connect(function()
	if Studio.isOpen() then
		Studio.close(true)
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="19">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="20">
            <Properties>
              <string name="Name">HUD</string>
              <string name="Source"><![CDATA[-- Interfaz principal: monedas, nivel, racha, lista de pedidos, botones y avisos.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Templates = require(Shared.Templates)

local Theme = require(script.Parent.Theme)
local PixelArt = require(script.Parent.PixelArt)

local HUD = {}

local C = Theme.Colors
local player = Players.LocalPlayer

local app
local gui
local refs = {}
local cards = {}
local shownCoins = nil

-- Avisos tipo "toast" --------------------------------------------------------------
local toastHolder
local KIND_COLORS = {
	info = C.Primary,
	success = C.Green,
	error = C.Red,
	gold = C.GoldDark,
}

function HUD.notify(text, kind)
	if not toastHolder then
		return
	end
	local color = KIND_COLORS[kind] or C.Primary
	local toast = Theme.new("Frame", {
		Size = UDim2.new(1, 0, 0, 46),
		BackgroundColor3 = C.Panel,
		LayoutOrder = -math.floor(os.clock() * 100),
		Parent = toastHolder,
	}, {
		Theme.corner(14),
		Theme.stroke(color, 3),
	})
	Theme.new("Frame", {
		Size = UDim2.new(0, 8, 1, -16),
		Position = UDim2.fromOffset(8, 8),
		BackgroundColor3 = color,
		Parent = toast,
	}, { Theme.corner(4) })
	Theme.label({
		Size = UDim2.new(1, -30, 1, -12),
		Position = UDim2.fromOffset(22, 6),
		Text = text,
		Font = Theme.Fonts.Bold,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 20,
		Parent = toast,
	})
	Theme.pop(toast, 0.7)
	if kind == "error" then
		Theme.playSound("click", 0.6)
	end
	task.delay(3.5, function()
		if toast.Parent then
			Theme.tween(toast, 0.3, { BackgroundTransparency = 1 })
			for _, d in ipairs(toast:GetDescendants()) do
				if d:IsA("TextLabel") then
					Theme.tween(d, 0.3, { TextTransparency = 1 })
				elseif d:IsA("UIStroke") then
					Theme.tween(d, 0.3, { Transparency = 1 })
				elseif d:IsA("Frame") then
					Theme.tween(d, 0.3, { BackgroundTransparency = 1 })
				end
			end
			task.wait(0.35)
			toast:Destroy()
		end
	end)
	local toasts = {}
	for _, child in ipairs(toastHolder:GetChildren()) do
		if child:IsA("Frame") then
			table.insert(toasts, child)
		end
	end
	if #toasts > 4 then
		table.sort(toasts, function(a, b)
			return a.LayoutOrder > b.LayoutOrder
		end)
		toasts[1]:Destroy()
	end
end

-- Barra superior ---------------------------------------------------------------------
local function pill(parent, props)
	local frame = Theme.new("Frame", {
		Name = props.Name,
		Size = props.Size,
		BackgroundColor3 = C.Panel,
		LayoutOrder = props.LayoutOrder,
		Parent = parent,
	}, {
		Theme.corner(22),
		Theme.stroke(props.Color, 3),
	})
	local icon = Theme.new("Frame", {
		Size = UDim2.new(0, 44, 0, 44),
		Position = UDim2.new(0, -6, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundColor3 = props.Color,
		ZIndex = 2,
		Parent = frame,
	}, { Theme.corner(22), Theme.stroke(Color3.new(1, 1, 1), 3) })
	Theme.label({
		Size = UDim2.fromScale(1, 1),
		Text = props.Icon,
		ZIndex = 3,
		MaxTextSize = 26,
		Parent = icon,
	})
	local label = Theme.label({
		Name = "Value",
		Size = UDim2.new(1, -50, 1, -10),
		Position = UDim2.fromOffset(44, 5),
		Text = "0",
		TextColor3 = C.Ink,
		MaxTextSize = 26,
		Parent = frame,
	})
	return frame, label
end

local function buildTopBar()
	local bar = Theme.new("Frame", {
		Name = "TopBar",
