      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[-- Ajustes generales: economía, mejoras, maestría y visitantes.

local Designs = require(script.Parent.Designs)
local Colors = require(script.Parent.Colors)

local Config = {}

Config.MAX_PLOTS = 6
Config.GALLERY_SIZE = 7
Config.START_COINS = 25
Config.AUTOSAVE_SECONDS = 90
Config.DAILY_COOLDOWN = 20 * 60 * 60
Config.MAX_PAINT_STACK = 999

-- Vender en la galería (a un visitante) paga más que vender al instante.
Config.GALLERY_BONUS = 1.25
Config.QUICK_SELL = 1

-- Maestría por diseño: cuantas más veces lo pintas, más vale.
Config.Mastery = {
	{ id = "bronce", name = "Bronce", made = 3, bonus = 0.05, color = Color3.fromRGB(220, 140, 70) },
	{ id = "plata", name = "Plata", made = 8, bonus = 0.1, color = Color3.fromRGB(170, 180, 210) },
	{ id = "oro", name = "Oro", made = 20, bonus = 0.2, color = Color3.fromRGB(255, 200, 40) },
}

function Config.masteryFor(made)
	local current, nextTier = nil, Config.Mastery[1]
	for i, tier in ipairs(Config.Mastery) do
		if (made or 0) >= tier.made then
			current = tier
			nextTier = Config.Mastery[i + 1]
		end
	end
	return current, nextTier
end

-- Mejoras ------------------------------------------------------------------------------
Config.Upgrades = {
	{
		id = "suerte",
		name = "Suerte de la máquina",
		icon = "🍀",
		desc = "Más colores raros al tirar.",
		max = 12,
		cost = 80,
		growth = 1.55,
	},
	{
		id = "velocidad",
		name = "Máquina veloz",
		icon = "⚙️",
		desc = "La máquina tira colores más rápido.",
		max = 10,
		cost = 60,
		growth = 1.5,
	},
	{
		id = "pincel",
		name = "Pincel grande",
		icon = "🖌️",
		desc = "Pintas más rápido y con trazo más ancho.",
		max = 8,
		cost = 90,
		growth = 1.6,
	},
	{
		id = "cubeta",
		name = "Cubeta mágica",
		icon = "🪣",
		desc = "Rellena una figura entera con un toque.",
		max = 1,
		cost = 2500,
		growth = 1,
	},
	{
		id = "precio",
		name = "Precios de artista",
		icon = "💰",
		desc = "Tus cuadros se venden más caros.",
		max = 15,
		cost = 120,
		growth = 1.45,
	},
	{
		id = "fama",
		name = "Fama",
		icon = "⭐",
		desc = "Llegan visitantes a comprar más seguido.",
		max = 10,
		cost = 150,
		growth = 1.55,
	},
	{
		id = "paredes",
		name = "Más paredes",
		icon = "🖼️",
		desc = "Más cuadros expuestos a la venta.",
		max = 4,
		cost = 300,
		growth = 2.2,
	},
	{
		id = "decoracion",
		name = "Decoración",
		icon = "🪴",
		desc = "Embellece tu galería: +6% de valor por nivel.",
		max = 6,
		cost = 250,
		growth = 1.9,
	},
}
Config.UpgradeById = {}
for _, upgrade in ipairs(Config.Upgrades) do
	Config.UpgradeById[upgrade.id] = upgrade
end

function Config.upgradeCost(id, currentLevel)
	local upgrade = Config.UpgradeById[id]
	return math.floor(upgrade.cost * upgrade.growth ^ currentLevel)
end

function Config.rollInterval(levels)
	return math.max(0.8, 4 * 0.86 ^ (levels.velocidad or 0))
end

function Config.luck(levels)
	return 1 + 0.1 * (levels.suerte or 0)
end

function Config.brushSpeed(levels)
	return 1 + 0.3 * (levels.pincel or 0)
end

function Config.brushRadius(levels)
	return 0.035 + 0.008 * (levels.pincel or 0)
end

function Config.hasBucket(levels)
	return (levels.cubeta or 0) >= 1
end

function Config.payMultiplier(levels)
	return (1 + 0.1 * (levels.precio or 0)) * (1 + 0.06 * (levels.decoracion or 0))
end

function Config.buyerInterval(levels)
	return math.max(5, 18 * 0.88 ^ (levels.fama or 0))
end

function Config.maxBuyers(levels)
	return math.min(4, 2 + math.floor((levels.fama or 0) / 4))
end

function Config.gallerySlots(levels)
	return math.min(Config.GALLERY_SIZE, 3 + (levels.paredes or 0))
end

-- Valor de un cuadro ---------------------------------------------------------------------
-- Cada área pesa según su tamaño (raíz para que las áreas pequeñas también cuenten).
function Config.colorMultiplier(design, colors)
	local total, weighted = 0, 0
	for _, area in ipairs(design.areas) do
		local weight = math.sqrt(area.weight)
		total += weight
		weighted += weight * Colors.multiplier(colors[area.id])
	end
	return total > 0 and weighted / total or 1
end

function Config.paintingValue(design, colors, levels, made)
	local tier = Config.masteryFor(made)
	local mastery = 1 + (tier and tier.bonus or 0)
	return math.floor(design.value * Config.colorMultiplier(design, colors) * mastery * Config.payMultiplier(levels))
end

-- Tiempo mínimo que el servidor exige para aceptar un cuadro (anti-trampas).
function Config.minPaintTime(design, levels)
	if Config.hasBucket(levels) then
		return #design.shapes * 0.08
	end
	return Designs.totalTime(design) / Config.brushSpeed(levels) * 0.45
end

-- Visitantes -----------------------------------------------------------------------------
-- Si no se pueden cargar avatares de amigos se usan estos usuarios conocidos.
Config.FALLBACK_AVATARS = { 1, 156, 261, 2, 3 }

Config.BuyerLines = {
	"¡Qué belleza! Me lo llevo 😍",
	"¡Justo lo que buscaba! 💖",
	"¡Esto va en mi sala! 🖼️",
	"¡Wow, qué colores! ✨",
	"¡Lo compro ya mismo! 💰",
}

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Designs</string>
          <string name="Source"><![CDATA[-- Diseños que se pintan. Cada diseño está hecho de figuras (rectángulos
-- redondeados, círculos y píldoras) sobre un lienzo cuadrado de 0 a 1.
-- Cada figura pertenece a un "área"; antes de pintar se elige un color por área.

local Designs = {}

-- Figuras ---------------------------------------------------------------------------
-- r: redondeo de las esquinas (0 = recto, 0.5 = círculo / píldora).
local function R(area, x, y, w, h, rot, r)
	return { area = area, x = x, y = y, w = w, h = h, rot = rot or 0, r = r or 0 }
end
local function C(area, x, y, d)
	return R(area, x, y, d, d, 0, 0.5)
end
local function P(area, x, y, w, h, rot)
	return R(area, x, y, w, h, rot, 0.5)
end
-- Destello de 4 puntas.
local function Sparkle(area, x, y, s)
	return { P(area, x, y, s, s * 0.24), P(area, x, y, s * 0.24, s) }
end
-- Corazón: un rombo y dos círculos.
local function Heart(area, x, y, s)
	return {
		R(area, x, y + s * 0.1, s * 0.6, s * 0.6, 45, 0.12),
		C(area, x - s * 0.21, y - s * 0.1, s * 0.56),
		C(area, x + s * 0.21, y - s * 0.1, s * 0.56),
	}
end
local function Ring(area, count, cx, cy, radius, w, h, r)
	local list = {}
	for i = 0, count - 1 do
		local angle = i / count * 360
		local rad = math.rad(angle)
		table.insert(list, R(area, cx + math.cos(rad) * radius, cy + math.sin(rad) * radius, w, h, angle, r))
	end
	return list
end
local function Background(area)
	return R(area, 0.5, 0.5, 1, 1)
end

-- Diseños -----------------------------------------------------------------------------
-- value: precio base de venta. price: lo que cuesta desbloquearlo.
Designs.List = {
	-- Nivel 1 ------------------------------------------------------------------------
	{
		id = "globo",
		name = "Globo Rojo",
		level = 1,
		value = 30,
		price = 0,
		areas = {
			{ id = "cielo", name = "Cielo", default = "celeste" },
			{ id = "nubes", name = "Nubes", default = "blanco" },
			{ id = "cuerda", name = "Cuerda", default = "cafe" },
			{ id = "globo", name = "Globo", default = "rojo" },
			{ id = "brillo", name = "Brillo", default = "rosa" },
		},
		shapes = {
			Background("cielo"),
			C("nubes", 0.18, 0.76, 0.2),
			C("nubes", 0.3, 0.71, 0.24),
			C("nubes", 0.42, 0.77, 0.18),
			P("nubes", 0.3, 0.81, 0.42, 0.11),
			C("nubes", 0.78, 0.24, 0.15),
			C("nubes", 0.87, 0.27, 0.12),
			P("nubes", 0.81, 0.3, 0.26, 0.08),
			R("cuerda", 0.52, 0.77, 0.014, 0.28, -6),
			P("globo", 0.5, 0.4, 0.42, 0.5),
			R("globo", 0.5, 0.655, 0.07, 0.07, 45, 0.15),
			P("brillo", 0.39, 0.3, 0.07, 0.15, 25),
		},
	},
	{
		id = "sol",
		name = "Sol Feliz",
		level = 1,
		value = 35,
		price = 60,
		areas = {
			{ id = "cielo", name = "Cielo", default = "celeste" },
			{ id = "rayos", name = "Rayos", default = "naranja" },
			{ id = "sol", name = "Sol", default = "amarillo" },
			{ id = "cara", name = "Carita", default = "cafe" },
			{ id = "mejillas", name = "Mejillas", default = "rosa" },
		},
		shapes = {
			Background("cielo"),
			Ring("rayos", 10, 0.5, 0.5, 0.31, 0.15, 0.07, 0.5),
			C("sol", 0.5, 0.5, 0.46),
			C("cara", 0.41, 0.46, 0.055),
			C("cara", 0.59, 0.46, 0.055),
			P("cara", 0.5, 0.59, 0.12, 0.045),
			C("mejillas", 0.35, 0.56, 0.08),
			C("mejillas", 0.65, 0.56, 0.08),
		},
	},
	{
		id = "taza",
		name = "Taza de Té",
		level = 1,
		value = 40,
		price = 110,
		areas = {
			{ id = "pared", name = "Pared", default = "durazno" },
			{ id = "mesa", name = "Mesa", default = "cafe" },
			{ id = "plato", name = "Plato", default = "celeste" },
			{ id = "taza", name = "Taza", default = "blanco" },
			{ id = "corazon", name = "Corazón", default = "rosa" },
			{ id = "vapor", name = "Vapor", default = "crema" },
		},
		shapes = {
			Background("pared"),
			R("mesa", 0.5, 0.88, 1, 0.24),
			C("taza", 0.7, 0.56, 0.2),
			C("pared", 0.7, 0.56, 0.1),
			P("plato", 0.47, 0.79, 0.62, 0.09),
			R("taza", 0.47, 0.59, 0.4, 0.36, 0, 0.28),
			P("taza", 0.47, 0.42, 0.44, 0.06),
			Heart("corazon", 0.47, 0.6, 0.15),
			P("vapor", 0.38, 0.25, 0.05, 0.14, 15),
			P("vapor", 0.48, 0.2, 0.05, 0.16, -10),
			P("vapor", 0.58, 0.26, 0.05, 0.13, 15),
		},
	},
	{
		id = "gatito",
		name = "Gatito",
		level = 1,
		value = 45,
		price = 170,
		areas = {
			{ id = "fondo", name = "Fondo", default = "verde" },
			{ id = "pelaje", name = "Pelaje", default = "naranja" },
			{ id = "orejas", name = "Orejas y nariz", default = "rosa" },
			{ id = "hocico", name = "Hocico", default = "blanco" },
			{ id = "ojos", name = "Ojos", default = "negro" },
		},
		shapes = {
			Background("fondo"),
