-- Geometría ---------------------------------------------------------------------------
-- ¿El punto (x, y) del lienzo cae dentro de la figura? (rectángulo redondeado rotado)
function Designs.contains(shape, x, y)
	local dx, dy = x - shape.x, y - shape.y
	local rad = math.rad(shape.rot)
	local c, s = math.cos(rad), math.sin(rad)
	local lx = math.abs(dx * c + dy * s)
	local ly = math.abs(-dx * s + dy * c)
	local hw, hh = shape.w / 2, shape.h / 2
	if lx > hw or ly > hh then
		return false
	end
	local rr = shape.r * math.min(shape.w, shape.h)
	local qx, qy = lx - (hw - rr), ly - (hh - rr)
	if qx <= 0 or qy <= 0 then
		return true
	end
	return qx * qx + qy * qy <= rr * rr
end

-- Índice de la figura visible (la de más arriba) en ese punto.
function Designs.shapeAt(design, x, y)
	local shapes = design.shapes
	for i = #shapes, 1, -1 do
		if Designs.contains(shapes[i], x, y) then
			return i
		end
	end
	return nil
end

local SAMPLES = 40

-- Preparación ---------------------------------------------------------------------------
Designs.ById = {}
Designs.Levels = {}
for index, design in ipairs(Designs.List) do
	design.index = index
	-- Aplana las figuras compuestas (destellos, corazones, anillos).
	local flat = {}
	for _, item in ipairs(design.shapes) do
		if item.area then
			table.insert(flat, item)
		else
			for _, shape in ipairs(item) do
				table.insert(flat, shape)
			end
		end
	end
	design.shapes = flat
	design.areaById = {}
	for areaIndex, area in ipairs(design.areas) do
		area.index = areaIndex
		area.weight = 0
		design.areaById[area.id] = area
	end
	-- Parte visible de cada figura (muestreo del lienzo).
	local counts = {}
	for gx = 0, SAMPLES - 1 do
		for gy = 0, SAMPLES - 1 do
			local hit = Designs.shapeAt(design, (gx + 0.5) / SAMPLES, (gy + 0.5) / SAMPLES)
			if hit then
				counts[hit] = (counts[hit] or 0) + 1
			end
		end
	end
	for i, shape in ipairs(flat) do
		local area = design.areaById[shape.area]
		assert(area, "Área desconocida " .. tostring(shape.area) .. " en " .. design.id)
		shape.visible = (counts[i] or 0) / (SAMPLES * SAMPLES)
		area.weight += shape.visible
	end
	for _, area in ipairs(design.areas) do
		assert(area.weight > 0, "El área " .. area.id .. " de " .. design.id .. " no se ve")
	end
	Designs.ById[design.id] = design
	Designs.Levels[design.level] = Designs.Levels[design.level] or {}
	table.insert(Designs.Levels[design.level], design)
end
Designs.MAX_LEVEL = #Designs.Levels

function Designs.get(id)
	return Designs.ById[id]
end

-- Segundos de pincel que necesita una figura (las grandes tardan más).
-- Las figuras tapadas del todo no hace falta pintarlas.
function Designs.shapeTime(shape)
	if shape.visible <= 0 then
		return 0
	end
	return 0.25 + 3 * math.sqrt(shape.visible)
end

function Designs.totalTime(design)
	local total = 0
	for _, shape in ipairs(design.shapes) do
		total += Designs.shapeTime(shape)
	end
	return total
end

-- ¿Está abierto el nivel? (todos los diseños del nivel anterior pintados).
function Designs.isLevelOpen(level, made)
	if level <= 1 then
		return true
	end
	local previous = Designs.Levels[level - 1]
	if not previous then
		return false
	end
	for _, design in ipairs(previous) do
		if (made[design.id] or 0) < 1 then
			return false
		end
	end
	return Designs.isLevelOpen(level - 1, made)
end

-- Colores por defecto de un diseño (para miniaturas).
function Designs.defaultColors(design)
	local colors = {}
	for _, area in ipairs(design.areas) do
		colors[area.id] = area.default
	end
	return colors
end

-- "area:color,area:color" <-> tabla
function Designs.encodeColors(colors)
	local parts = {}
	for areaId, colorId in pairs(colors) do
		table.insert(parts, areaId .. ":" .. colorId)
	end
	table.sort(parts)
	return table.concat(parts, ",")
end

function Designs.decodeColors(str)
	local colors = {}
	if type(str) == "string" then
		for areaId, colorId in string.gmatch(str, "([%w_]+):([%w_]+)") do
			colors[areaId] = colorId
		end
	end
	return colors
end

return Designs
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="6">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="7">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Script" referent="8">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Punto de entrada del servidor: crea el mundo, asigna galerías y gestiona la
-- máquina de colores, los cuadros, la galería, las ventas y las mejoras.

local Players = game:GetService("Players")
local PhysicsService = game:GetService("PhysicsService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Colors = require(Shared.Colors)
local Designs = require(Shared.Designs)

local Services = script.Parent:WaitForChild("Services")
local DataService = require(Services.DataService)
local WorldBuilder = require(Services.WorldBuilder)
local VisitorService = require(Services.VisitorService)

local rng = Random.new()

-- Remotos -------------------------------------------------------------------------
local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
local function remote(class, name)
	local r = Instance.new(class)
	r.Name = name
	r.Parent = remotes
	return r
end
local GetState = remote("RemoteFunction", "GetState")
local StateChanged = remote("RemoteEvent", "StateChanged")
local Notify = remote("RemoteEvent", "Notify")
local Roll = remote("RemoteFunction", "Roll")
local SetAutoRoll = remote("RemoteEvent", "SetAutoRoll")
local RollResult = remote("RemoteEvent", "RollResult")
local OpenDesigns = remote("RemoteEvent", "OpenDesigns")
local UnlockDesign = remote("RemoteFunction", "UnlockDesign")
local StartPainting = remote("RemoteFunction", "StartPainting")
local CancelPainting = remote("RemoteEvent", "CancelPainting")
local FinishPainting = remote("RemoteFunction", "FinishPainting")
local BuyUpgrade = remote("RemoteFunction", "BuyUpgrade")
local ClaimDaily = remote("RemoteFunction", "ClaimDaily")
local GoHome = remote("RemoteEvent", "GoHome")
remotes.Parent = ReplicatedStorage

-- Colisiones: los visitantes no empujan a los jugadores ni entre ellos.
local PLAYER_GROUP = "Jugadores"
pcall(function()
	PhysicsService:RegisterCollisionGroup(VisitorService.COLLISION_GROUP)
	PhysicsService:RegisterCollisionGroup(PLAYER_GROUP)
	PhysicsService:CollisionGroupSetCollidable(VisitorService.COLLISION_GROUP, VisitorService.COLLISION_GROUP, false)
	PhysicsService:CollisionGroupSetCollidable(VisitorService.COLLISION_GROUP, PLAYER_GROUP, false)
end)

-- Mundo ---------------------------------------------------------------------------
local plots = WorldBuilder.build()
local plotOf = {}
local sessions = {}

local function getSession(player)
	local session = sessions[player]
	if not session then
		session = { nextRoll = 0, painting = nil, lastHome = 0 }
		sessions[player] = session
	end
	return session
end

local function notify(player, text, kind)
	Notify:FireClient(player, text, kind or "info")
end

local function dailyStatus(data)
	local now = os.time()
	local ready = now - data.lastDaily >= Config.DAILY_COOLDOWN
	local streak = data.dailyStreak
	if now - data.lastDaily > Config.DAILY_COOLDOWN * 2.4 then
		streak = 0
	end
	local nextStreak = math.min(streak + 1, 7)
	local amount = 80 + nextStreak * 40
	return ready, amount, math.max(0, Config.DAILY_COOLDOWN - (now - data.lastDaily)), nextStreak
end

local function openLevel(data)
	local level = 1
	for l = 2, Designs.MAX_LEVEL do
		if Designs.isLevelOpen(l, data.made) then
			level = l
		end
	end
	return level
end

local function buildState(player)
	local data = DataService.get(player)
	if not data then
		return nil
	end
	local session = getSession(player)
	local ready, amount, wait, nextStreak = dailyStatus(data)
	local plot = plotOf[player]
	return {
		coins = data.coins,
		paints = data.paints,
		unlocked = data.unlocked,
		made = data.made,
		upgrades = data.upgrades,
		openLevel = openLevel(data),
		slots = Config.gallerySlots(data.upgrades),
		displayed = #data.gallery,
		autoRoll = data.autoRoll,
		lastRoll = data.lastRoll,
		rollInterval = Config.rollInterval(data.upgrades),
		sold = data.sold,
		earned = data.earned,
		painting = session.painting and session.painting.designId or nil,
		dailyReady = ready,
		dailyAmount = amount,
		dailyWait = wait,
		dailyStreak = nextStreak,
		plotIndex = plot and plot.index or 0,
	}
end

local function updateLeaderstats(player)
	local data = DataService.get(player)
	local stats = player:FindFirstChild("leaderstats")
	if data and stats then
		stats.Monedas.Value = data.coins
		stats.Vendidos.Value = data.sold
	end
end

local function pushState(player)
	local state = buildState(player)
	if state then
		StateChanged:FireClient(player, state)
	end
	updateLeaderstats(player)
end

-- Visuales de la parcela ---------------------------------------------------------------
local function rarityIndex(colorId)
	return Colors.rarityOf(Colors.ById[colorId]).index
end

local function renderShelf(plot, data)
	local owned = {}
	for colorId, count in pairs(data and data.paints or {}) do
		if count > 0 and Colors.ById[colorId] then
			table.insert(owned, colorId)
		end
	end
	table.sort(owned, function(a, b)
		local ra, rb = rarityIndex(a), rarityIndex(b)
		if ra ~= rb then
			return ra > rb
		end
		return Colors.ById[a].index < Colors.ById[b].index
	end)
	for i, can in ipairs(plot.workshop.shelfCans) do
		local colorId = owned[i]
		if colorId then
			local rarity = rarityIndex(colorId)
			can.Color = Colors.mainColor(colorId)
			can.Transparency = 0
			can.Material = rarity >= 6 and Enum.Material.Neon
				or (rarity >= 5 and Enum.Material.Metal or Enum.Material.SmoothPlastic)
		else
			can.Color = Color3.fromRGB(230, 230, 236)
			can.Transparency = 0.7
			can.Material = Enum.Material.SmoothPlastic
		end
	end
end

local function renderMachine(plot, colorId)
	local workshop = plot.workshop
	local entry = Colors.ById[colorId]
	workshop.machineTop:SetAttribute("ColorId", entry and colorId or "")
	if entry then
		workshop.machineCan.Color = Colors.mainColor(colorId)
		workshop.machineGlow.Color = Colors.rarityOf(entry).color
	end
end

local function slotEntry(data, slot)
	for i, entry in ipairs(data.gallery) do
		if entry.s == slot then
			return entry, i
		end
	end
	return nil
end

local function renderGallery(plot, data)
	local slots = data and Config.gallerySlots(data.upgrades) or 0
	for i = 1, Config.GALLERY_SIZE do
		local canvas = plot.canvases[i]
		local plaque = plot.plaques[i]
		local entry = data and slotEntry(data, i)
		local design = entry and Designs.get(entry.d)
		canvas:SetAttribute("Locked", i > slots)
		if design then
			canvas:SetAttribute("Design", entry.d)
			canvas:SetAttribute("Colors", entry.c)
			canvas:SetAttribute("Price", entry.v)
			plaque.Text = design.name .. " · 💰" .. entry.v
		else
			canvas:SetAttribute("Design", "")
			canvas:SetAttribute("Colors", "")
			canvas:SetAttribute("Price", 0)
			plaque.Text = i > slots and "🔒 Más paredes" or "Espacio libre"
		end
	end
end

local function renderEasel(plot, designId, colors)
	plot.workshop.easelCanvas:SetAttribute("Design", designId or "")
	plot.workshop.easelCanvas:SetAttribute("Colors", colors or "")
end

-- Galerías -----------------------------------------------------------------------------
local function assignPlot(player)
	for _, plot in ipairs(plots) do
		if plot.model:GetAttribute("OwnerUserId") == 0 then
			plot.model:SetAttribute("OwnerUserId", player.UserId)
			plotOf[player] = plot
			plot.signLabel.Text = "Galería de " .. player.DisplayName
			return plot
		end
	end
	return nil
end

local function releasePlot(player)
	local plot = plotOf[player]
	if not plot then
		return
	end
	plotOf[player] = nil
	VisitorService.detach(plot)
	plot.model:SetAttribute("OwnerUserId", 0)
	plot.signLabel.Text = "Galería libre"
	renderGallery(plot, nil)
	renderShelf(plot, nil)
	renderMachine(plot, "")
	renderEasel(plot, nil, nil)
	WorldBuilder.setDecorLevel(plot, 0)
end

local function teleportHome(player)
	local plot = plotOf[player]
	local character = player.Character
	if plot and character and character:FindFirstChild("HumanoidRootPart") then
		character:PivotTo(plot.ownerSpawn)
	end
end

local function refreshPlot(player)
	local plot = plotOf[player]
	local data = DataService.get(player)
	if plot and data then
		renderGallery(plot, data)
		renderShelf(plot, data)
	end
end

-- Máquina de colores ---------------------------------------------------------------------
local function addPaint(data, colorId, amount)
	data.paints[colorId] = math.min(Config.MAX_PAINT_STACK, (data.paints[colorId] or 0) + amount)
end

local function doRoll(player)
	local data = DataService.get(player)
	if not data then
		return nil
	end
	local entry = Colors.roll(Config.luck(data.upgrades), rng)
	addPaint(data, entry.id, 1)
	data.lastRoll = entry.id
	local plot = plotOf[player]
	if plot then
		renderMachine(plot, entry.id)
		renderShelf(plot, data)
	end
	RollResult:FireClient(player, entry.id)
	pushState(player)
	return entry.id
end

local function tryRoll(player)
	local data = DataService.get(player)
	local session = getSession(player)
	if not data then
		return nil
	end
	local now = os.clock()
	if now < session.nextRoll then
		return nil
	end
	session.nextRoll = now + Config.rollInterval(data.upgrades)
	return doRoll(player)
end

Roll.OnServerInvoke = function(player)
	return tryRoll(player)
end

SetAutoRoll.OnServerEvent:Connect(function(player, enabled)
	local data = DataService.get(player)
	if data and type(enabled) == "boolean" then
		data.autoRoll = enabled
		pushState(player)
	end
end)

-- Diseños y pintura ------------------------------------------------------------------------
UnlockDesign.OnServerInvoke = function(player, designId)
	local data = DataService.get(player)
	local design = type(designId) == "string" and Designs.get(designId)
	if not (data and design) then
		return false, "Diseño no válido."
	end
	if data.unlocked[designId] then
		return false, "Ya lo tienes."
	end
	if not Designs.isLevelOpen(design.level, data.made) then
		return false, "Pinta todos los diseños del nivel " .. (design.level - 1) .. " primero."
	end
	if data.coins < design.price then
		return false, "Te faltan " .. (design.price - data.coins) .. " monedas."
	end
	data.coins -= design.price
	data.unlocked[designId] = true
	pushState(player)
	return true, "¡Desbloqueaste «" .. design.name .. "»!"
end

-- Cuántas unidades de cada color pide la elección (las básicas no se gastan).
local function paintCost(colors)
	local cost = {}
	for _, colorId in pairs(colors) do
		local entry = Colors.ById[colorId]
		if entry and not entry.basic then
			cost[colorId] = (cost[colorId] or 0) + 1
		end
	end
	return cost
end

StartPainting.OnServerInvoke = function(player, designId, colors)
	local data = DataService.get(player)
	local session = getSession(player)
	local design = type(designId) == "string" and Designs.get(designId)
	if not (data and design) or type(colors) ~= "table" then
		return false, "Diseño no válido."
	end
	if session.painting then
		return false, "Ya estás pintando un cuadro."
	end
	if not data.unlocked[designId] or not Designs.isLevelOpen(design.level, data.made) then
		return false, "Ese diseño está bloqueado."
	end
	local chosen = {}
	for _, area in ipairs(design.areas) do
		local colorId = colors[area.id]
		if type(colorId) ~= "string" or not Colors.ById[colorId] then
			return false, "Elige un color para «" .. area.name .. "»."
		end
		chosen[area.id] = colorId
	end
	local cost = paintCost(chosen)
	for colorId, amount in pairs(cost) do
		if (data.paints[colorId] or 0) < amount then
			return false, "No tienes suficiente «" .. Colors.ById[colorId].name .. "»."
		end
	end
	for colorId, amount in pairs(cost) do
		data.paints[colorId] -= amount
		if data.paints[colorId] <= 0 then
			data.paints[colorId] = nil
		end
	end
	session.painting = {
		designId = designId,
		colors = chosen,
		started = os.clock(),
		minTime = Config.minPaintTime(design, data.upgrades),
	}
	refreshPlot(player)
	pushState(player)
	return true
end

local function cancelPainting(player)
	local data = DataService.get(player)
	local session = getSession(player)
	local painting = session.painting
	if not (data and painting) then
		return
	end
	session.painting = nil
	-- Devolvemos las pinturas usadas.
	for colorId, amount in pairs(paintCost(painting.colors)) do
		addPaint(data, colorId, amount)
	end
	refreshPlot(player)
	pushState(player)
end

CancelPainting.OnServerEvent:Connect(cancelPainting)

local function freeSlot(data)
	for slot = 1, Config.gallerySlots(data.upgrades) do
		if not slotEntry(data, slot) then
			return slot
		end
	end
	return nil
end

FinishPainting.OnServerInvoke = function(player, choice)
	local data = DataService.get(player)
	local session = getSession(player)
	local painting = session.painting
	if not (data and painting) then
		return { ok = false, reason = "No estás pintando nada." }
	end
	if os.clock() - painting.started < painting.minTime then
		return { ok = false, reason = "¡Aún no está terminado!" }
	end
	local design = Designs.get(painting.designId)
	local madeBefore = data.made[design.id] or 0
	local value = Config.paintingValue(design, painting.colors, data.upgrades, madeBefore)
	local encoded = Designs.encodeColors(painting.colors)
	local levelBefore = openLevel(data)
	local tierBefore = Config.masteryFor(madeBefore)

	session.painting = nil
	data.made[design.id] = madeBefore + 1

	local result = { ok = true, value = value, designId = design.id }
	local slot = choice == "galeria" and freeSlot(data)
	if slot then
		local price = math.floor(value * Config.GALLERY_BONUS)
		table.insert(data.gallery, { s = slot, d = design.id, c = encoded, v = price })
		result.displayed = true
		result.price = price
		result.slot = slot
	else
		data.coins += value
		data.earned += value
		data.sold += 1
		result.displayed = false
		result.price = value
	end

	local tierAfter = Config.masteryFor(data.made[design.id])
	if tierAfter and tierAfter ~= tierBefore then
		result.mastery = tierAfter.name
	end
	local levelAfter = openLevel(data)
	if levelAfter > levelBefore then
		result.newLevel = levelAfter
	end

	local plot = plotOf[player]
	if plot then
		renderEasel(plot, design.id, encoded)
	end
	refreshPlot(player)
	pushState(player)
	return result
end

-- Ventas a visitantes --------------------------------------------------------------------
VisitorService.getProfile = function(player)
	return DataService.get(player)
end

VisitorService.availableSlots = function(player)
	local data = DataService.get(player)
	local list = {}
	if data then
		for _, entry in ipairs(data.gallery) do
			table.insert(list, entry.s)
		end
	end
	return list
end

VisitorService.onPurchase = function(player, slot, buyerName)
	local data = DataService.get(player)
	if not data or not player.Parent then
		return nil
	end
	local entry, index = slotEntry(data, slot)
	if not entry then
		return nil
	end
	table.remove(data.gallery, index)
	data.coins += entry.v
	data.earned += entry.v
	data.sold += 1
	local design = Designs.get(entry.d)
	notify(
		player,
		"🖼️ "
			.. tostring(buyerName)
			.. " compró «"
			.. (design and design.name or "tu cuadro")
			.. "» por 💰"
			.. entry.v,
		"gold"
	)
	refreshPlot(player)
	pushState(player)
	return entry.v
end

-- Mejoras y regalo diario -------------------------------------------------------------------
BuyUpgrade.OnServerInvoke = function(player, id)
	local data = DataService.get(player)
	local upgrade = type(id) == "string" and Config.UpgradeById[id]
	if not (data and upgrade) then
		return false, "Mejora no válida."
	end
	local level = data.upgrades[id] or 0
	if level >= upgrade.max then
		return false, "¡Ya está al máximo!"
	end
	local cost = Config.upgradeCost(id, level)
	if data.coins < cost then
		return false, "Te faltan " .. (cost - data.coins) .. " monedas."
	end
	data.coins -= cost
	data.upgrades[id] = level + 1
	local plot = plotOf[player]
	if plot then
		if id == "decoracion" then
			WorldBuilder.setDecorLevel(plot, level + 1)
		elseif id == "paredes" then
			renderGallery(plot, data)
		end
	end
	pushState(player)
	return true, upgrade.name .. " subió a nivel " .. (level + 1) .. "!"
end

ClaimDaily.OnServerInvoke = function(player)
	local data = DataService.get(player)
	if not data then
		return false
	end
	local ready, amount, _, nextStreak = dailyStatus(data)
	if not ready then
		return false
	end
	data.lastDaily = os.time()
	data.dailyStreak = nextStreak
	data.coins += amount
	-- Además regala un color raro o mejor.
	local gift
	for _ = 1, 60 do
		gift = Colors.roll(4, rng)
		if Colors.rarityOf(gift).index >= 3 then
			break
		end
	end
	addPaint(data, gift.id, 1)
	refreshPlot(player)
	pushState(player)
	return true, amount, gift.id
end

GetState.OnServerInvoke = function(player)
	for _ = 1, 50 do
		if DataService.get(player) then
			break
		end
		task.wait(0.2)
	end
	return buildState(player)
end

GoHome.OnServerEvent:Connect(function(player)
	local session = getSession(player)
	if os.clock() - session.lastHome >= 2 then
		session.lastHome = os.clock()
		teleportHome(player)
	end
end)

-- Jugadores ----------------------------------------------------------------------------------
local function setCharacterGroup(character)
	local function apply(part)
		if part:IsA("BasePart") then
			part.CollisionGroup = PLAYER_GROUP
		end
	end
	for _, descendant in ipairs(character:GetDescendants()) do
		apply(descendant)
	end
	character.DescendantAdded:Connect(apply)
end

local function onPlayerAdded(player)
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	for _, name in ipairs({ "Monedas", "Vendidos" }) do
		local value = Instance.new("IntValue")
		value.Name = name
		value.Parent = stats
	end
	stats.Parent = player

	player.CharacterAdded:Connect(function(character)
		setCharacterGroup(character)
		character:WaitForChild("HumanoidRootPart", 10)
		task.wait(0.2)
		teleportHome(player)
	end)

	local data = DataService.load(player)
	if not player.Parent then
		return
	end
	local plot = assignPlot(player)
	if plot then
		renderGallery(plot, data)
		renderShelf(plot, data)
		renderMachine(plot, data.lastRoll)
		WorldBuilder.setDecorLevel(plot, data.upgrades.decoracion or 0)
		VisitorService.attach(plot, player)
	else
		notify(player, "Todas las galerías están ocupadas. ¡Explora la plaza!", "error")
	end
	if player.Character then
		setCharacterGroup(player.Character)
		task.defer(teleportHome, player)
	end
	pushState(player)
	notify(player, "¡Bienvenido a tu taller! Tira colores y pinta tu primer cuadro 🎨", "success")
end

local function onPlayerRemoving(player)
	cancelPainting(player)
	releasePlot(player)
	DataService.release(player)
	sessions[player] = nil
end

-- Avisos del taller: solo responden al dueño de la parcela.
for _, plot in ipairs(plots) do
	plot.workshop.drawPrompt.Triggered:Connect(function(who)
		if plotOf[who] == plot then
			OpenDesigns:FireClient(who)
		else
			notify(who, "Este taller es de otro artista 😉", "error")
		end
	end)
	plot.workshop.machinePrompt.Triggered:Connect(function(who)
		if plotOf[who] == plot then
			tryRoll(who)
		end
	end)
end

-- Arranque -----------------------------------------------------------------------------------
DataService.start()
VisitorService.start()

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, player)
end

-- Tiradas automáticas de la máquina.
task.spawn(function()
	while true do
		task.wait(0.2)
		for _, player in ipairs(Players:GetPlayers()) do
			local data = DataService.get(player)
			if data and data.autoRoll and plotOf[player] then
				tryRoll(player)
			end
		end
	end
end)

-- Refresca el contador del regalo diario.
task.spawn(function()
	while true do
		task.wait(60)
		for _, player in ipairs(Players:GetPlayers()) do
			pushState(player)
		end
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="9">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[-- Guarda y carga el progreso de cada jugador con DataStoreService.
-- Si los DataStores no están disponibles (por ejemplo en Studio sin publicar)
-- el juego sigue funcionando, solo que sin guardar.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)

local DataService = {}

local STORE_NAME = "GaleriaPincelada_v2"
local MAX_RETRIES = 4

local store = nil
local profiles = {}
local loaded = {}

do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
	else
		warn("[Galería] DataStores no disponibles, el progreso no se guardará: " .. tostring(result))
	end
end

local function defaultData()
	return {
		coins = Config.START_COINS,
		paints = {}, -- colorId -> cantidad
		unlocked = { globo = true }, -- diseños comprados
		made = {}, -- diseñoId -> veces pintado
		upgrades = {},
		gallery = {}, -- { s = hueco, d = diseño, c = colores, v = valor }
		autoRoll = true,
		lastRoll = "",
		sold = 0,
		earned = 0,
		lastDaily = 0,
		dailyStreak = 0,
	}
end

-- Rellena campos que falten (por ejemplo tras una actualización del juego).
local function reconcile(data)
	local template = defaultData()
	if type(data) ~= "table" then
		return template
	end
	for key, value in pairs(template) do
		if type(data[key]) ~= type(value) then
			data[key] = value
		end
	end
	for id in pairs(data.upgrades) do
		if not Config.UpgradeById[id] then
			data.upgrades[id] = nil
		end
	end
	return data
end

-- Errores que no se arreglan reintentando (Studio sin acceso a las APIs).
local function isPermanentError(message)
	message = tostring(message)
	return string.find(message, "StudioAccessToApisNotAllowed", 1, true) ~= nil
		or string.find(message, "publish", 1, true) ~= nil
end

local function disableStore(reason)
	if store then
		store = nil
		warn("[Galería] DataStores no disponibles, el progreso no se guardará: " .. tostring(reason))
	end
end

local function withRetries(callback)
	local lastError
	for attempt = 1, MAX_RETRIES do
		local ok, result = pcall(callback)
		if ok then
			return true, result
		end
		lastError = result
		if isPermanentError(result) then
			disableStore(result)
			break
		end
		task.wait(attempt * 1.5)
	end
	return false, lastError
end

function DataService.load(player)
	local data
	local canSave = store ~= nil
	local currentStore = store
	if currentStore then
		local ok, result = withRetries(function()
			return currentStore:GetAsync("player_" .. player.UserId)
		end)
		if ok then
			data = result
		else
			-- No guardamos encima de datos que no pudimos leer.
			canSave = false
			if store then
				warn("[Galería] No se pudo cargar a " .. player.Name .. ": " .. tostring(result))
			end
		end
	end
	data = reconcile(data)
	if player.Parent then
		profiles[player] = data
		loaded[player] = canSave
	end
	return data
end

function DataService.get(player)
	return profiles[player]
end

function DataService.save(player)
	local data = profiles[player]
	local currentStore = store
	if not (currentStore and data and loaded[player]) then
		return
	end
	local ok, result = withRetries(function()
		return currentStore:UpdateAsync("player_" .. player.UserId, function()
			return data
		end)
	end)
	if not ok then
		warn("[Galería] No se pudo guardar a " .. player.Name .. ": " .. tostring(result))
	end
end

function DataService.release(player)
	DataService.save(player)
	profiles[player] = nil
	loaded[player] = nil
end

function DataService.start()
	task.spawn(function()
		while true do
			task.wait(Config.AUTOSAVE_SECONDS)
			for _, player in ipairs(Players:GetPlayers()) do
				task.spawn(DataService.save, player)
			end
		end
	end)

	game:BindToClose(function()
		if RunService:IsStudio() and not store then
			return
		end
		local pending = 0
		for _, player in ipairs(Players:GetPlayers()) do
			pending += 1
			task.spawn(function()
				DataService.save(player)
				pending -= 1
			end)
		end
		local started = os.clock()
		while pending > 0 and os.clock() - started < 25 do
			task.wait(0.2)
		end
	end)
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">VisitorService</string>
            <string name="Source"><![CDATA[-- Visitantes: avatares reales de Roblox (los amigos del dueño o avatares
-- conocidos) que entran a la galería, miran un cuadro expuesto y lo compran.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)

local VisitorService = {}

VisitorService.COLLISION_GROUP = "Visitantes"

local ANIMATIONS = {
	walk = "rbxassetid://507777826",
	idle = "rbxassetid://507766388",
	cheer = "rbxassetid://507770677",
	wave = "rbxassetid://507770239",
}
local FALLBACK_NAMES =
	{ "Lucía", "Mateo", "Sofía", "Diego", "Valentina", "Leo", "Camila", "Hugo", "Martina", "Bruno" }
local SKIN_TONES = {
	Color3.fromRGB(255, 224, 196),
	Color3.fromRGB(241, 194, 150),
	Color3.fromRGB(214, 160, 120),
	Color3.fromRGB(170, 116, 80),
	Color3.fromRGB(120, 80, 56),
}
local SHIRT_COLORS = {
	Color3.fromRGB(255, 140, 160),
	Color3.fromRGB(120, 190, 255),
	Color3.fromRGB(130, 220, 160),
	Color3.fromRGB(255, 200, 100),
	Color3.fromRGB(190, 150, 255),
}

-- Callbacks que asigna el servidor principal.
VisitorService.getProfile = nil -- (player) -> datos
VisitorService.availableSlots = nil -- (player) -> { hueco, ... } con cuadro
VisitorService.onPurchase = nil -- (player, hueco, nombre) -> precio o nil

local rng = Random.new()
local states = {}
local descriptionCache = {}
local friendsOf = {}

local function pick(list)
	return list[rng:NextInteger(1, #list)]
end

-- Avatares ----------------------------------------------------------------------------
local function loadFriends(owner)
	if friendsOf[owner] then
		return
	end
	friendsOf[owner] = {}
	task.spawn(function()
		local ok, pages = pcall(function()
			return Players:GetFriendsAsync(owner.UserId)
		end)
		if not ok or not pages then
			return
		end
		local okPage, page = pcall(function()
			return pages:GetCurrentPage()
		end)
		if okPage and type(page) == "table" then
			local list = {}
			for _, friend in ipairs(page) do
				if type(friend) == "table" and friend.Id then
					table.insert(list, { id = friend.Id, name = friend.DisplayName or friend.Username })
				end
			end
			if owner.Parent then
				friendsOf[owner] = list
			end
		end
	end)
end

local function getDescription(userId)
	local cached = descriptionCache[userId]
	if cached ~= nil then
		return cached or nil
	end
	local ok, description = pcall(function()
		return Players:GetHumanoidDescriptionFromUserId(userId)
	end)
	descriptionCache[userId] = (ok and description) or false
	return ok and description or nil
end

local function randomDescription()
	local description = Instance.new("HumanoidDescription")
	local skin = pick(SKIN_TONES)
	local shirt = pick(SHIRT_COLORS)
	description.HeadColor = skin
	description.LeftArmColor = skin
	description.RightArmColor = skin
	description.TorsoColor = shirt
	description.LeftLegColor = Color3.fromRGB(70, 70, 110)
	description.RightLegColor = Color3.fromRGB(70, 70, 110)
	return description
end

local function setCollisionGroup(model)
	for _, descendant in ipairs(model:GetDescendants()) do
		if descendant:IsA("BasePart") then
			descendant.CollisionGroup = VisitorService.COLLISION_GROUP
		end
	end
end

local function createAvatar(owner)
	local friends = friendsOf[owner] or {}
	local userId, name
	if #friends > 0 and rng:NextNumber() < 0.75 then
		local friend = pick(friends)
		userId, name = friend.id, friend.name
	else
		userId = pick(Config.FALLBACK_AVATARS)
	end
	local description = getDescription(userId) or randomDescription()
	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromDescription(description, Enum.HumanoidRigType.R15)
	end)
	if not ok or not model then
		ok, model = pcall(function()
			return Players:CreateHumanoidModelFromDescription(randomDescription(), Enum.HumanoidRigType.R15)
		end)
		if not ok or not model then
			return nil
		end
	end
	return model, name or pick(FALLBACK_NAMES)
end

-- Movimiento y animaciones -------------------------------------------------------------
local function loadTracks(humanoid)
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end
	local tracks = {}
	for name, id in pairs(ANIMATIONS) do
		local animation = Instance.new("Animation")
		animation.AnimationId = id
		local ok, track = pcall(function()
			return animator:LoadAnimation(animation)
		end)
		if ok and track then
			track.Looped = name == "walk" or name == "idle"
			tracks[name] = track
		end
	end
	return tracks
end

local function play(visitor, name)
	for trackName, track in pairs(visitor.tracks) do
		if trackName ~= name and track.IsPlaying then
			track:Stop(0.2)
		end
	end
	local track = visitor.tracks[name]
	if track and not track.IsPlaying then
		track:Play(0.2)
	end
end

local function alive(visitor)
	return visitor.model.Parent ~= nil and visitor.humanoid.Parent ~= nil
end

local function walkTo(visitor, target)
	if not alive(visitor) then
		return false
	end
	play(visitor, "walk")
	local reached = false
	local connection = visitor.humanoid.MoveToFinished:Connect(function()
		reached = true
	end)
	visitor.humanoid:MoveTo(target.Position)
	local started = os.clock()
	while not reached and alive(visitor) and os.clock() - started < 9 do
		task.wait(0.1)
	end
	connection:Disconnect()
	if not alive(visitor) then
		return false
	end
	-- Si se atascó, lo acercamos al destino para que nunca se quede trabado.
	local root = visitor.root
	local offset = root.Position - target.Position
	if Vector3.new(offset.X, 0, offset.Z).Magnitude > 3 then
		visitor.model:PivotTo(target * CFrame.new(0, 3, 0))
	end
	return true
end

-- Ciclo de un visitante -----------------------------------------------------------------
local function runVisitor(state, slot)
	local plot = state.plot
	local owner = state.owner
	local model, name = createAvatar(owner)
	if not model or states[plot.index] ~= state then
		state.reserved[slot] = nil
		if model then
			model:Destroy()
		end
		return
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local root = model:FindFirstChild("HumanoidRootPart")
	if not (humanoid and root) then
		state.reserved[slot] = nil
		model:Destroy()
		return
	end
	model.Name = "Visitante"
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.WalkSpeed = 11
	model:SetAttribute("VisitorName", name)
	model:SetAttribute("Owner", owner.UserId)
	model:SetAttribute("Reaction", "")
	setCollisionGroup(model)
	model:PivotTo(plot.street * CFrame.new(0, 3, 0) * CFrame.Angles(0, math.pi, 0))
	model.Parent = plot.visitorsFolder
	pcall(function()
		root:SetNetworkOwner(nil)
	end)

	local visitor = { model = model, humanoid = humanoid, root = root, tracks = loadTracks(humanoid) }
	state.visitors[visitor] = true

	local function finish()
		state.visitors[visitor] = nil
		state.reserved[slot] = nil
		if model.Parent then
			model:Destroy()
		end
	end

	local stand = plot.standPoints[slot]
	for _, point in ipairs({ plot.entrance, plot.inside, stand }) do
		if not walkTo(visitor, point) then
			finish()
			return
		end
	end

	-- Admira el cuadro.
	model:PivotTo(stand * CFrame.new(0, 3, 0))
	play(visitor, "idle")
	model:SetAttribute("Reaction", "🤔")
	task.wait(rng:NextNumber(2.5, 4))
	if not alive(visitor) or states[plot.index] ~= state then
		finish()
		return
	end

	local price = VisitorService.onPurchase and VisitorService.onPurchase(owner, slot, name)
	if price then
		model:SetAttribute("Reaction", pick(Config.BuyerLines) .. "\n💰 " .. price)
		play(visitor, "cheer")
	else
		model:SetAttribute("Reaction", "Oh... ya no está 😢")
		play(visitor, "wave")
	end
	state.reserved[slot] = nil
	task.wait(2.5)

	for _, point in ipairs({ plot.inside, plot.entrance, plot.street }) do
		if not walkTo(visitor, point) then
			break
		end
	end
	finish()
end

-- API pública --------------------------------------------------------------------------
function VisitorService.attach(plot, owner)
	loadFriends(owner)
	states[plot.index] = {
		plot = plot,
		owner = owner,
		timer = 0,
		visitors = {},
		reserved = {},
	}
end

function VisitorService.detach(plot)
	local state = states[plot.index]
	states[plot.index] = nil
	if state then
		for visitor in pairs(state.visitors) do
			if visitor.model.Parent then
				visitor.model:Destroy()
			end
		end
		friendsOf[state.owner] = nil
	end
	plot.visitorsFolder:ClearAllChildren()
end

function VisitorService.start()
	RunService.Heartbeat:Connect(function(dt)
		for _, state in pairs(states) do
			local profile = VisitorService.getProfile(state.owner)
			if profile then
				local levels = profile.upgrades
				local count = 0
				for _ in pairs(state.visitors) do
					count += 1
				end
				state.timer += dt
				if count < Config.maxBuyers(levels) and state.timer >= Config.buyerInterval(levels) then
					local options = {}
					for _, slot in ipairs(VisitorService.availableSlots(state.owner)) do
						if not state.reserved[slot] then
							table.insert(options, slot)
						end
					end
					if #options > 0 then
						state.timer = 0
						local slot = pick(options)
						state.reserved[slot] = true
						task.spawn(runVisitor, state, slot)
					else
						state.timer = Config.buyerInterval(levels) * 0.7
					end
				end
			end
		end
	end)
end

return VisitorService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">WorldBuilder</string>
            <string name="Source"><![CDATA[-- Construye todo el mundo por código: plaza, fuente, árboles y las galerías.
-- Así el juego funciona sin modelos externos ni assets que puedan fallar.

local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)

local WorldBuilder = {}
local buildWorkshop

local PLOT_RADIUS = 150
local PLAZA_RADIUS = 58

local WALL_COLORS = {
	Color3.fromRGB(255, 196, 214),
	Color3.fromRGB(184, 236, 214),
	Color3.fromRGB(212, 196, 255),
	Color3.fromRGB(255, 214, 176),
	Color3.fromRGB(178, 220, 255),
	Color3.fromRGB(255, 236, 160),
}
local ACCENT_COLORS = {
	Color3.fromRGB(236, 72, 128),
	Color3.fromRGB(30, 170, 120),
	Color3.fromRGB(124, 92, 255),
	Color3.fromRGB(255, 120, 40),
	Color3.fromRGB(40, 130, 230),
	Color3.fromRGB(230, 170, 20),
}
local RAINBOW = {
	Color3.fromRGB(255, 90, 110),
	Color3.fromRGB(255, 170, 60),
	Color3.fromRGB(255, 225, 80),
	Color3.fromRGB(110, 220, 120),
	Color3.fromRGB(90, 170, 255),
	Color3.fromRGB(180, 120, 255),
}

local WOOD = Color3.fromRGB(196, 140, 96)
local DARK_WOOD = Color3.fromRGB(120, 78, 52)
local CREAM = Color3.fromRGB(255, 248, 236)
local GOLD = Color3.fromRGB(240, 190, 70)

-- Crea una pieza anclada con propiedades por defecto bonitas.
local function part(props)
	local p = Instance.new(props.Class or "Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for key, value in pairs(props) do
		if key ~= "Class" and key ~= "Parent" then
			p[key] = value
		end
	end
	p.Parent = props.Parent
	return p
end

local function cylinderUp(cf)
	return cf * CFrame.Angles(0, 0, math.rad(90))
end

local function addLight(parent, class, props)
	local light = Instance.new(class)
	for key, value in pairs(props) do
		light[key] = value
	end
	light.Parent = parent
	return light
end

local function surfaceText(parentPart, face, text, props)
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = props.pps or 40
	gui.LightInfluence = props.lightInfluence or 0
	gui.Parent = parentPart
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = props.font or Enum.Font.FredokaOne
	label.Text = text
	label.TextScaled = true
	label.TextColor3 = props.color or Color3.new(1, 1, 1)
	label.Parent = gui
	local padding = Instance.new("UIPadding")
	padding.PaddingLeft = UDim.new(0.04, 0)
	padding.PaddingRight = UDim.new(0.04, 0)
	padding.PaddingTop = UDim.new(0.08, 0)
	padding.PaddingBottom = UDim.new(0.08, 0)
	padding.Parent = label
	if props.stroke then
		local stroke = Instance.new("UIStroke")
		stroke.Color = props.stroke
		stroke.Thickness = props.strokeThickness or 3
		stroke.Parent = label
	end
	return label
end

-- Ambiente -----------------------------------------------------------------------
local function setupLighting()
	Lighting.ClockTime = 14.6
	Lighting.GeographicLatitude = 35
	Lighting.Brightness = 2.6
	Lighting.Ambient = Color3.fromRGB(105, 95, 120)
	Lighting.OutdoorAmbient = Color3.fromRGB(150, 140, 165)
	Lighting.EnvironmentDiffuseScale = 1
	Lighting.EnvironmentSpecularScale = 1
	Lighting.GlobalShadows = true
	Lighting.ShadowSoftness = 0.25

	for _, child in ipairs(Lighting:GetChildren()) do
		if child:IsA("PostEffect") or child:IsA("Atmosphere") or child:IsA("Sky") then
			child:Destroy()
		end
	end

	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Density = 0.28
	atmosphere.Offset = 0.15
	atmosphere.Color = Color3.fromRGB(214, 190, 235)
	atmosphere.Decay = Color3.fromRGB(150, 120, 190)
	atmosphere.Glare = 0.3
	atmosphere.Haze = 1.2
	atmosphere.Parent = Lighting

	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.55
	bloom.Size = 26
	bloom.Threshold = 1.4
	bloom.Parent = Lighting

	local color = Instance.new("ColorCorrectionEffect")
	color.Saturation = 0.18
	color.Contrast = 0.06
	color.Brightness = 0.02
	color.TintColor = Color3.fromRGB(255, 248, 242)
	color.Parent = Lighting

	local rays = Instance.new("SunRaysEffect")
	rays.Intensity = 0.06
	rays.Spread = 0.8
	rays.Parent = Lighting
end

-- Elementos decorativos -------------------------------------------------------
local function buildTree(parent, cf, scale, rng)
	local model = Instance.new("Model")
	model.Name = "Tree"
	local trunkHeight = 9 * scale
	part({
		Name = "Trunk",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(trunkHeight, 1.6 * scale, 1.6 * scale),
		CFrame = cylinderUp(cf * CFrame.new(0, trunkHeight / 2, 0)),
		Color = DARK_WOOD,
		Material = Enum.Material.Wood,
		Parent = model,
	})
	local leafColors = {
		Color3.fromRGB(110, 200, 110),
		Color3.fromRGB(90, 180, 100),
		Color3.fromRGB(255, 170, 200),
		Color3.fromRGB(130, 210, 120),
	}
	local leafColor = leafColors[rng:NextInteger(1, #leafColors)]
	for i = 1, 4 do
		local size = (6 + rng:NextNumber() * 3) * scale
		local offset = Vector3.new(rng:NextNumber(-2, 2), trunkHeight + rng:NextNumber(-1, 3), rng:NextNumber(-2, 2))
			* scale
		if i == 1 then
			offset = Vector3.new(0, trunkHeight + 1.5 * scale, 0)
		end
		part({
			Name = "Leaves",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(size, size, size),
			CFrame = cf * CFrame.new(offset),
			Color = leafColor:Lerp(Color3.new(1, 1, 1), rng:NextNumber() * 0.12),
			Material = Enum.Material.Grass,
			CanCollide = false,
			Parent = model,
		})
	end
	model.Parent = parent
end

local function buildLampPost(parent, cf)
	local model = Instance.new("Model")
	model.Name = "Lamp"
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(12, 0.7, 0.7),
		CFrame = cylinderUp(cf * CFrame.new(0, 6, 0)),
		Color = Color3.fromRGB(60, 50, 80),
		Material = Enum.Material.Metal,
		Parent = model,
	})
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.6, 2, 2),
		CFrame = cylinderUp(cf * CFrame.new(0, 0.3, 0)),
		Color = Color3.fromRGB(60, 50, 80),
		Material = Enum.Material.Metal,
		Parent = model,
	})
	local bulb = part({
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(2.2, 2.2, 2.2),
		CFrame = cf * CFrame.new(0, 12.6, 0),
		Color = Color3.fromRGB(255, 226, 170),
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = model,
	})
	addLight(
		bulb,
		"PointLight",
		{ Range = 18, Brightness = 1.3, Color = Color3.fromRGB(255, 214, 160), Shadows = false }
	)
	model.Parent = parent
end

local function buildBench(parent, cf)
	local model = Instance.new("Model")
	model.Name = "Bench"
	part({
		Size = Vector3.new(6, 0.4, 2),
		CFrame = cf * CFrame.new(0, 1.8, 0),
		Color = WOOD,
		Material = Enum.Material.WoodPlanks,
		Parent = model,
	})
	part({
		Size = Vector3.new(6, 1.6, 0.3),
		CFrame = cf * CFrame.new(0, 3, 0.9),
		Color = WOOD,
		Material = Enum.Material.WoodPlanks,
		Parent = model,
	})
	for _, x in ipairs({ -2.5, 2.5 }) do
		part({
			Size = Vector3.new(0.4, 1.6, 1.8),
			CFrame = cf * CFrame.new(x, 0.8, 0),
			Color = Color3.fromRGB(60, 50, 80),
			Material = Enum.Material.Metal,
			Parent = model,
		})
	end
	model.Parent = parent
end

local function buildFlowerBed(parent, cf, width, rng)
	part({
		Size = Vector3.new(width, 0.8, 3),
		CFrame = cf * CFrame.new(0, 0.4, 0),
		Color = Color3.fromRGB(110, 76, 56),
		Material = Enum.Material.Ground,
		Parent = parent,
	})
	local count = math.floor(width / 1.4)
	for i = 1, count do
		local x = -width / 2 + (i - 0.5) * (width / count)
		local z = rng:NextNumber(-0.8, 0.8)
		part({
			Size = Vector3.new(0.2, 1.2, 0.2),
			CFrame = cf * CFrame.new(x, 1.2, z),
			Color = Color3.fromRGB(80, 170, 80),
			CanCollide = false,
			Parent = parent,
		})
		part({
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(0.9, 0.9, 0.9),
			CFrame = cf * CFrame.new(x, 1.9, z),
			Color = RAINBOW[rng:NextInteger(1, #RAINBOW)],
			CanCollide = false,
			Parent = parent,
		})
	end
end

local function buildPlant(parent, cf, scale)
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(2.4 * scale, 2.4 * scale, 2.4 * scale),
		CFrame = cylinderUp(cf * CFrame.new(0, 1.2 * scale, 0)),
		Color = Color3.fromRGB(220, 120, 90),
		Material = Enum.Material.Slate,
		Parent = parent,
	})
	for i = 1, 3 do
		local angle = i * 2.1
		part({
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(2.6, 2.6, 2.6) * scale,
			CFrame = cf
				* CFrame.new(math.cos(angle) * 0.6 * scale, (3 + i * 0.8) * scale, math.sin(angle) * 0.6 * scale),
			Color = Color3.fromRGB(80 + i * 15, 180 + i * 10, 100),
			Material = Enum.Material.Grass,
			CanCollide = false,
			Parent = parent,
		})
	end
end

local function buildFountain(parent)
	local model = Instance.new("Model")
	model.Name = "Fountain"
	local base = CFrame.new(0, 0, 0)
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(2.4, 26, 26),
		CFrame = cylinderUp(base * CFrame.new(0, 1.2, 0)),
		Color = CREAM,
		Material = Enum.Material.Marble,
		Parent = model,
	})
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.4, 23, 23),
		CFrame = cylinderUp(base * CFrame.new(0, 2.3, 0)),
		Color = Color3.fromRGB(110, 200, 255),
		Material = Enum.Material.Glass,
		Transparency = 0.25,
		CanCollide = false,
		Parent = model,
	})
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(8, 3, 3),
		CFrame = cylinderUp(base * CFrame.new(0, 5, 0)),
		Color = CREAM,
		Material = Enum.Material.Marble,
		Parent = model,
	})
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(1, 11, 11),
		CFrame = cylinderUp(base * CFrame.new(0, 9, 0)),
		Color = CREAM,
		Material = Enum.Material.Marble,
		Parent = model,
	})
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.3, 9.6, 9.6),
		CFrame = cylinderUp(base * CFrame.new(0, 9.5, 0)),
		Color = Color3.fromRGB(110, 200, 255),
		Material = Enum.Material.Glass,
		Transparency = 0.25,
		CanCollide = false,
		Parent = model,
	})

	-- Escultura de pincel gigante sobre la fuente.
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(7, 1.2, 1.2),
		CFrame = cylinderUp(base * CFrame.new(0, 13, 0)),
		Color = Color3.fromRGB(236, 72, 128),
		Material = Enum.Material.SmoothPlastic,
		Parent = model,
	})
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(1.2, 1.5, 1.5),
		CFrame = cylinderUp(base * CFrame.new(0, 16.8, 0)),
		Color = GOLD,
		Material = Enum.Material.Metal,
		Parent = model,
	})
	local tip = part({
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(2.4, 2.4, 2.4),
		CFrame = base * CFrame.new(0, 18.2, 0),
		Color = Color3.fromRGB(124, 92, 255),
		Material = Enum.Material.Neon,
		Parent = model,
	})
	addLight(tip, "PointLight", { Range = 22, Brightness = 1.5, Color = Color3.fromRGB(190, 160, 255) })

	local sparkles = Instance.new("ParticleEmitter")
	sparkles.Rate = 12
	sparkles.Lifetime = NumberRange.new(1.5, 2.5)
	sparkles.Speed = NumberRange.new(2, 4)
	sparkles.SpreadAngle = Vector2.new(180, 180)
	sparkles.LightEmission = 1
	sparkles.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.6),
		NumberSequenceKeypoint.new(1, 0),
	})
	sparkles.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 160, 220)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(160, 220, 255)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 240, 160)),
	})
	sparkles.Parent = tip
	model.Parent = parent
end

-- Marcos de la galería ---------------------------------------------------------
local function buildFrame(parent, cf, name)
	local frame = Instance.new("Model")
	frame.Name = name
	part({
		Size = Vector3.new(7.4, 7.4, 0.5),
		CFrame = cf,
		Color = GOLD,
		Material = Enum.Material.Metal,
		Reflectance = 0.05,
		Parent = frame,
	})
	local canvas = part({
		Name = "Canvas",
		Size = Vector3.new(6.2, 6.2, 0.2),
		CFrame = cf * CFrame.new(0, 0, -0.3),
		Color = CREAM,
		Parent = frame,
	})
	canvas:SetAttribute("Cells", "")
	local plaque = part({
		Name = "Plaque",
		Size = Vector3.new(3.6, 0.9, 0.2),
		CFrame = cf * CFrame.new(0, -4.3, -0.1),
		Color = Color3.fromRGB(50, 40, 70),
		Parent = frame,
	})
	local plaqueLabel = surfaceText(plaque, Enum.NormalId.Front, "", { pps = 50, color = GOLD })
	plaqueLabel.Name = "PlaqueText"
	local lamp = part({
		Size = Vector3.new(2.4, 0.4, 0.6),
		CFrame = cf * CFrame.new(0, 4.4, -0.8),
		Color = Color3.fromRGB(50, 40, 70),
		Material = Enum.Material.Metal,
		CanCollide = false,
		Parent = frame,
	})
	addLight(lamp, "SpotLight", {
		Face = Enum.NormalId.Bottom,
		Angle = 70,
		Range = 10,
		Brightness = 2.2,
		Color = Color3.fromRGB(255, 236, 210),
	})
	frame.Parent = parent
	return canvas, plaqueLabel
end

local function buildEasel(parent, cf)
	local model = Instance.new("Model")
	model.Name = "Easel"
	for _, x in ipairs({ -1.8, 1.8 }) do
		part({
			Size = Vector3.new(0.4, 10, 0.4),
			CFrame = cf * CFrame.new(x, 5, 0) * CFrame.Angles(math.rad(-8), 0, math.rad(x > 0 and 8 or -8)),
			Color = WOOD,
			Material = Enum.Material.Wood,
			Parent = model,
		})
	end
	part({
		Size = Vector3.new(0.4, 9, 0.4),
		CFrame = cf * CFrame.new(0, 4.5, 1.4) * CFrame.Angles(math.rad(14), 0, 0),
		Color = WOOD,
		Material = Enum.Material.Wood,
		Parent = model,
	})
	part({
		Size = Vector3.new(6, 0.4, 0.9),
		CFrame = cf * CFrame.new(0, 3.9, -0.5),
		Color = WOOD,
		Material = Enum.Material.Wood,
		Parent = model,
	})
	local canvas = part({
		Name = "Canvas",
		Size = Vector3.new(5.6, 5.6, 0.25),
		CFrame = cf * CFrame.new(0, 6.95, -0.35) * CFrame.Angles(math.rad(-8), 0, 0),
		Color = CREAM,
		Parent = model,
	})
	canvas:SetAttribute("Cells", "")
	-- Paleta de pintor apoyada.
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.2, 2.6, 2.6),
		CFrame = cf * CFrame.new(2.6, 4.2, -0.6) * CFrame.Angles(0, math.rad(90), 0),
		Color = Color3.fromRGB(230, 190, 140),
		Parent = model,
	})
	for i, color in ipairs(RAINBOW) do
		local angle = i * 0.9
		part({
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(0.45, 0.45, 0.45),
			CFrame = cf * CFrame.new(2.6 + math.cos(angle) * 0.8, 4.2 + math.sin(angle) * 0.8, -0.75),
			Color = color,
			CanCollide = false,
			Parent = model,
		})
	end
	model.Parent = parent
	return canvas
end

-- Decoraciones que aparecen al subir la mejora "Decoración".
local DECOR_BUILDERS = {
	function(folder, L)
		buildPlant(folder, L(-7.5, 0, -21.5), 1.1)
		buildPlant(folder, L(7.5, 0, -21.5), 1.1)
	end,
	function(folder, L)
		part({
			Size = Vector3.new(5, 0.12, 22),
			CFrame = L(0, 1.06, -8),
			Color = Color3.fromRGB(200, 40, 70),
			Material = Enum.Material.Fabric,
			CanCollide = false,
			Parent = folder,
		})
		for _, x in ipairs({ -2.6, 2.6 }) do
			part({
				Size = Vector3.new(0.25, 0.14, 22),
				CFrame = L(x, 1.07, -8),
				Color = GOLD,
				Material = Enum.Material.Fabric,
				CanCollide = false,
				Parent = folder,
			})
		end
	end,
	function(folder, L)
		part({
			Size = Vector3.new(3, 3, 3),
			CFrame = L(-17, 2.5, -12),
			Color = CREAM,
			Material = Enum.Material.Marble,
			Parent = folder,
		})
		local shapes = { Enum.PartType.Ball, Enum.PartType.Block, Enum.PartType.Ball }
		for i, shape in ipairs(shapes) do
			local s = 2.4 - i * 0.4
			part({
				Shape = shape,
				Size = Vector3.new(s, s, s),
				CFrame = L(-17, 3.5 + i * 1.7, -12) * CFrame.Angles(i, i * 0.7, 0),
				Color = RAINBOW[i * 2],
				Material = Enum.Material.Glass,
				Transparency = 0.15,
				CanCollide = false,
				Parent = folder,
			})
		end
	end,
	function(folder, L)
		for i = 0, 22 do
			local x = -22 + i * 2
			local bulb = part({
				Shape = Enum.PartType.Ball,
				Size = Vector3.new(0.7, 0.7, 0.7),
				CFrame = L(x, 11.9 - math.sin(i * 0.55) ^ 2 * 0.6, -23.4),
				Color = RAINBOW[i % #RAINBOW + 1],
				Material = Enum.Material.Neon,
				CanCollide = false,
				Parent = folder,
			})
			if i % 4 == 0 then
				addLight(bulb, "PointLight", { Range = 8, Brightness = 0.8, Color = bulb.Color })
			end
		end
	end,
	function(folder, L)
		part({
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.4, 5, 5),
			CFrame = cylinderUp(L(0, 16.5, 9)),
			Color = GOLD,
			Material = Enum.Material.Metal,
			CanCollide = false,
			Parent = folder,
		})
		part({
			Size = Vector3.new(0.2, 2.5, 0.2),
			CFrame = L(0, 17.9, 9),
			Color = GOLD,
			Material = Enum.Material.Metal,
			CanCollide = false,
			Parent = folder,
		})
		for i = 1, 8 do
			local angle = i / 8 * math.pi * 2
			part({
				Shape = Enum.PartType.Ball,
				Size = Vector3.new(0.8, 0.8, 0.8),
				CFrame = L(math.cos(angle) * 2.5, 16.1, 9 + math.sin(angle) * 2.5),
				Color = Color3.fromRGB(220, 240, 255),
				Material = Enum.Material.Neon,
				CanCollide = false,
				Parent = folder,
			})
		end
		local core = part({
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(1.4, 1.4, 1.4),
			CFrame = L(0, 15.6, 9),
			Color = Color3.fromRGB(200, 230, 255),
			Material = Enum.Material.Glass,
			Transparency = 0.2,
			CanCollide = false,
			Parent = folder,
		})
		addLight(core, "PointLight", { Range = 20, Brightness = 1.2, Color = Color3.fromRGB(230, 240, 255) })
	end,
	function(folder, L)
		local index = 0
		for step = 0, 16 do
			local angle = math.pi * step / 16
			index += 1
			part({
				Shape = Enum.PartType.Ball,
				Size = Vector3.new(1.4, 1.4, 1.4),
				CFrame = L(math.cos(angle) * 6.2, 7 + math.sin(angle) * 5.6, -19.9),
				Color = RAINBOW[index % #RAINBOW + 1],
				Material = Enum.Material.SmoothPlastic,
				Reflectance = 0.15,
				CanCollide = false,
				Parent = folder,
			})
		end
		for _, x in ipairs({ -6.2, 6.2 }) do
			for y = 1.7, 6.5, 1.3 do
				index += 1
				part({
					Shape = Enum.PartType.Ball,
					Size = Vector3.new(1.4, 1.4, 1.4),
					CFrame = L(x, y, -19.9),
					Color = RAINBOW[index % #RAINBOW + 1],
					Reflectance = 0.15,
					CanCollide = false,
					Parent = folder,
				})
			end
		end
	end,
}
WorldBuilder.DECOR_LEVELS = #DECOR_BUILDERS

-- Taller: mesa de dibujo, máquina de colores y estantes con botes ----------------------
function buildWorkshop(parent, L, accent)
	local model = Instance.new("Model")
	model.Name = "Workshop"
	local white = Color3.fromRGB(250, 248, 244)
	local cx = 44

	-- Suelo, paredes y techo.
	part({
		Size = Vector3.new(30, 1, 30),
		CFrame = L(cx, 0.5, 0),
		Color = Color3.fromRGB(226, 196, 160),
		Material = Enum.Material.WoodPlanks,
		Parent = model,
	})
	part({ Size = Vector3.new(30, 14, 1), CFrame = L(cx, 8, 14.5), Color = white, Parent = model })
	part({ Size = Vector3.new(1, 14, 30), CFrame = L(cx - 14.5, 8, 0), Color = white, Parent = model })
	part({ Size = Vector3.new(1, 14, 30), CFrame = L(cx + 14.5, 8, 0), Color = white, Parent = model })
	for _, x in ipairs({ cx - 12.5, cx + 12.5 }) do
		part({ Size = Vector3.new(5, 14, 1), CFrame = L(x, 8, -14.5), Color = white, Parent = model })
	end
	part({ Size = Vector3.new(20, 3, 1), CFrame = L(cx, 13.5, -14.5), Color = white, Parent = model })
	part({ Size = Vector3.new(32, 1, 32), CFrame = L(cx, 15.5, 0), Color = Color3.fromRGB(70, 60, 90), Parent = model })
	-- Techo interior blanco y toldo de rayas en la entrada.
	part({ Size = Vector3.new(29, 0.2, 29), CFrame = L(cx, 14.9, 0), Color = white, Parent = model })
	for i = 0, 4 do
		local stripe = (i % 2 == 0) and accent or Color3.new(1, 1, 1)
		part({
			Size = Vector3.new(4, 0.3, 4.6),
			CFrame = L(cx - 8 + i * 4, 12.4, -16.4) * CFrame.Angles(math.rad(-28), 0, 0),
			Color = stripe,
			Material = Enum.Material.Fabric,
			CanCollide = false,
			Parent = model,
		})
		part({
			Size = Vector3.new(4, 0.8, 0.2),
			CFrame = L(cx - 8 + i * 4, 11.05, -18.45),
			Color = stripe,
			Material = Enum.Material.Fabric,
			CanCollide = false,
			Parent = model,
		})
	end
	-- Macetas con flores a los lados de la entrada.
	buildPlant(model, L(cx - 12.5, 0, -17.5), 0.8)
	buildPlant(model, L(cx + 12.5, 0, -17.5), 0.8)

	-- Zócalo y moldura de color.
	for _, data in ipairs({
		{ Vector3.new(30, 0.8, 0.2), L(cx, 1.4, 13.95) },
		{ Vector3.new(0.2, 0.8, 30), L(cx - 13.95, 1.4, 0) },
		{ Vector3.new(0.2, 0.8, 30), L(cx + 13.95, 1.4, 0) },
	}) do
		part({ Size = data[1], CFrame = data[2], Color = accent, Parent = model })
	end
	-- Ventana redonda en la pared del fondo.
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.4, 6, 6),
		CFrame = L(cx, 10, 14) * CFrame.Angles(0, math.pi / 2, 0),
		Color = Color3.fromRGB(190, 230, 255),
		Material = Enum.Material.Glass,
		Transparency = 0.3,
		Parent = model,
	})
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.3, 6.8, 6.8),
		CFrame = L(cx, 10, 14.15) * CFrame.Angles(0, math.pi / 2, 0),
		Color = accent,
		Parent = model,
	})

	-- Letrero "Taller".
	local sign = part({
		Size = Vector3.new(12, 3, 0.4),
		CFrame = L(cx, 17.8, -14.6),
		Color = Color3.fromRGB(60, 48, 84),
		Parent = model,
	})
	surfaceText(
		sign,
		Enum.NormalId.Front,
		"🎨 Taller",
		{ pps = 30, color = Color3.fromRGB(255, 244, 220), stroke = accent }
	)

	-- Alfombra redonda.
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.1, 14, 14),
		CFrame = cylinderUp(L(cx, 1.05, -1)),
		Color = accent:Lerp(Color3.new(1, 1, 1), 0.55),
		Material = Enum.Material.Fabric,
		CanCollide = false,
		Parent = model,
	})

	-- Mesa de dibujo (caballete grande).
	local easelCanvas = buildEasel(model, L(cx + 5, 1, 7) * CFrame.Angles(0, math.rad(-12), 0))
	local drawPart = part({
		Name = "DrawPrompt",
		Size = Vector3.new(4, 4, 2),
		CFrame = L(cx + 5, 4, 5.5),
		Transparency = 1,
		CanCollide = false,
		Parent = model,
	})
	local drawPrompt = Instance.new("ProximityPrompt")
	drawPrompt.ActionText = "Pintar un cuadro"
	drawPrompt.ObjectText = "Mesa de dibujo"
	drawPrompt.HoldDuration = 0
	drawPrompt.MaxActivationDistance = 12
	drawPrompt.RequiresLineOfSight = false
	drawPrompt.Parent = drawPart
	-- Taburete.
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.5, 2.6, 2.6),
		CFrame = cylinderUp(L(cx + 5, 3.2, 2.5)),
		Color = accent,
		Material = Enum.Material.Fabric,
		Parent = model,
	})
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(2.2, 0.5, 0.5),
		CFrame = cylinderUp(L(cx + 5, 2, 2.5)),
		Color = DARK_WOOD,
		Parent = model,
	})

	-- Máquina de colores (mueble con cajón y bote de pintura).
	local machine = Instance.new("Model")
	machine.Name = "Machine"
	local m = function(x, y, z)
		return L(cx - 8 + x, 1 + y, 7 + z) * CFrame.Angles(0, math.rad(15), 0)
	end
	local body = part({
		Name = "Body",
		Size = Vector3.new(6, 7, 4),
		CFrame = m(0, 3.5, 0),
		Color = Color3.fromRGB(232, 236, 214),
		Parent = machine,
	})
	part({
		Size = Vector3.new(6.4, 0.4, 4.4),
		CFrame = m(0, 7.2, 0),
		Color = Color3.fromRGB(214, 220, 196),
		Parent = machine,
	})
	part({
		Size = Vector3.new(4.6, 2.6, 0.2),
		CFrame = m(0, 5.4, -1.95),
		Color = Color3.fromRGB(170, 200, 170),
		Parent = machine,
	})
	part({
		Size = Vector3.new(4.8, 0.3, 2.4),
		CFrame = m(0, 4, -2.6),
		Color = Color3.fromRGB(240, 200, 150),
		Material = Enum.Material.Wood,
		Parent = machine,
	})
	part({
		Size = Vector3.new(5.2, 2.6, 0.2),
		CFrame = m(0, 1.6, -2.05),
		Color = Color3.fromRGB(240, 200, 150),
		Material = Enum.Material.Wood,
		Parent = machine,
	})
	part({
		Size = Vector3.new(0.15, 2.2, 0.1),
		CFrame = m(0, 1.6, -2.18),
		Color = Color3.fromRGB(200, 160, 120),
		Parent = machine,
	})
	for _, x in ipairs({ -0.5, 0.5 }) do
		part({
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(0.35, 0.35, 0.35),
			CFrame = m(x, 1.8, -2.2),
			Color = DARK_WOOD,
			Parent = machine,
		})
	end
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(1.4, 0.3, 0.3),
		CFrame = m(3.4, 4.5, 0) * CFrame.Angles(0, 0, 0),
		Color = GOLD,
		Material = Enum.Material.Metal,
		Parent = machine,
	})
	part({
		Size = Vector3.new(0.25, 1.6, 0.25),
		CFrame = m(4.05, 3.8, 0),
		Color = GOLD,
		Material = Enum.Material.Metal,
		Parent = machine,
	})
	local can = part({
		Name = "Can",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(1.8, 1.4, 1.4),
		CFrame = cylinderUp(m(0.8, 5.1, -2.9)),
		Color = Color3.fromRGB(160, 140, 220),
		Parent = machine,
	})
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.2, 1.45, 1.45),
		CFrame = cylinderUp(m(0.8, 6.05, -2.9)),
		Color = Color3.fromRGB(200, 200, 210),
		Material = Enum.Material.Metal,
		Parent = machine,
	})
	local glow = part({
		Name = "Glow",
		Size = Vector3.new(6.2, 0.25, 0.2),
		CFrame = m(0, 7.0, -2.2),
		Color = Color3.fromRGB(160, 160, 175),
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = machine,
	})
	local top = part({
		Name = "Top",
		Size = Vector3.new(1, 1, 1),
		CFrame = m(0, 8.5, 0),
		Transparency = 1,
		CanCollide = false,
		Parent = machine,
	})
	local machinePrompt = Instance.new("ProximityPrompt")
	machinePrompt.ActionText = "Tirar color"
	machinePrompt.ObjectText = "Máquina de colores"
	machinePrompt.HoldDuration = 0
	machinePrompt.MaxActivationDistance = 12
	machinePrompt.RequiresLineOfSight = false
	machinePrompt.Parent = body
	addLight(glow, "PointLight", { Range = 10, Brightness = 1, Color = Color3.fromRGB(255, 255, 255) })
	machine.Parent = model

	-- Estantes con botes de pintura (muestran tus colores más raros).
	local cans = {}
	for row = 0, 2 do
		part({
			Size = Vector3.new(14, 0.4, 2.2),
			CFrame = L(cx - 6, 3 + row * 3, 12.9),
			Color = WOOD,
			Material = Enum.Material.Wood,
			Parent = model,
		})
		for i = 0, 7 do
			local shelfCan = part({
				Name = "ShelfCan",
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(1.5, 1.2, 1.2),
				CFrame = cylinderUp(L(cx - 12 + i * 1.7, 3.95 + row * 3, 12.9)),
				Color = Color3.fromRGB(230, 230, 236),
				Transparency = 0.7,
				Parent = model,
			})
			table.insert(cans, shelfCan)
		end
	end

	-- Lámparas y plantas.
	for _, x in ipairs({ cx - 6, cx + 6 }) do
		part({
			Size = Vector3.new(0.15, 2.5, 0.15),
			CFrame = L(x, 13.8, 0),
			Color = Color3.fromRGB(40, 30, 50),
			CanCollide = false,
			Parent = model,
		})
		local bulb = part({
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(1.6, 1.6, 1.6),
			CFrame = L(x, 12.3, 0),
			Color = Color3.fromRGB(255, 236, 200),
			Material = Enum.Material.Neon,
			CanCollide = false,
			Parent = model,
		})
		addLight(
			bulb,
			"PointLight",
			{ Range = 24, Brightness = 1.3, Color = Color3.fromRGB(255, 236, 210), Shadows = true }
		)
	end
	buildPlant(model, L(cx + 12, 1, 12), 1)
	buildPlant(model, L(cx - 12.5, 1, -12), 0.9)

	-- Camino hasta la calle principal.
	part({
		Size = Vector3.new(8, 0.4, 18),
		CFrame = L(cx, 0.2, -23),
		Color = Color3.fromRGB(230, 214, 190),
		Material = Enum.Material.Cobblestone,
		Parent = model,
	})
	part({
		Size = Vector3.new(cx - 1, 0.4, 7),
		CFrame = L((cx + 5) / 2, 0.2, -31.5),
		Color = Color3.fromRGB(230, 214, 190),
		Material = Enum.Material.Cobblestone,
		Parent = model,
	})

	model.Parent = parent
	return {
		model = model,
		easelCanvas = easelCanvas,
		drawPrompt = drawPrompt,
		machinePrompt = machinePrompt,
		machineTop = top,
		machineCan = can,
		machineGlow = glow,
		shelfCans = cans,
	}
end

-- Galería de un jugador -----------------------------------------------------------
local function buildPlot(parent, index, plotCF, rng)
	local wallColor = WALL_COLORS[index]
	local accent = ACCENT_COLORS[index]
	local function L(x, y, z)
		return plotCF * CFrame.new(x, y, z)
	end

	local model = Instance.new("Model")
	model.Name = "Plot" .. index
	model:SetAttribute("Index", index)
	model:SetAttribute("OwnerUserId", 0)

	local shop = Instance.new("Model")
	shop.Name = "Shop"
	shop.Parent = model

	-- Suelo, alfombra y camino hasta la plaza.
	part({
		Name = "Floor",
		Size = Vector3.new(46, 1, 38),
		CFrame = L(0, 0.5, 0),
		Color = WOOD,
		Material = Enum.Material.WoodPlanks,
		Parent = shop,
	})
	part({
		Size = Vector3.new(18, 0.1, 11),
		CFrame = L(0, 1.05, -9),
		Color = accent:Lerp(Color3.new(1, 1, 1), 0.55),
		Material = Enum.Material.Fabric,
		CanCollide = false,
		Parent = shop,
	})
	part({
		Size = Vector3.new(16.6, 0.12, 9.6),
		CFrame = L(0, 1.06, -9),
		Color = accent:Lerp(Color3.new(1, 1, 1), 0.25),
		Material = Enum.Material.Fabric,
		CanCollide = false,
		Parent = shop,
	})
	local pathLength = PLOT_RADIUS - PLAZA_RADIUS - 19
	part({
		Size = Vector3.new(10, 0.4, pathLength),
		CFrame = L(0, 0.2, -19 - pathLength / 2),
		Color = Color3.fromRGB(230, 214, 190),
		Material = Enum.Material.Cobblestone,
		Parent = shop,
	})
	part({
		Size = Vector3.new(8, 0.15, 3),
		CFrame = L(0, 1.07, -16.6),
		Color = accent,
		Material = Enum.Material.Fabric,
		CanCollide = false,
		Parent = shop,
	})

	-- Paredes.
	part({ Size = Vector3.new(46, 18, 1), CFrame = L(0, 10, 18.5), Color = wallColor, Parent = shop })
	part({ Size = Vector3.new(1, 18, 38), CFrame = L(-22.5, 10, 0), Color = wallColor, Parent = shop })
	part({ Size = Vector3.new(1, 18, 38), CFrame = L(22.5, 10, 0), Color = wallColor, Parent = shop })
	for _, side in ipairs({ -1, 1 }) do
		local cx = side * 14
		part({ Size = Vector3.new(18, 3, 1), CFrame = L(cx, 2.5, -18.5), Color = wallColor, Parent = shop })
		part({ Size = Vector3.new(18, 6, 1), CFrame = L(cx, 16, -18.5), Color = wallColor, Parent = shop })
		part({
			Size = Vector3.new(18, 9, 0.3),
			CFrame = L(cx, 8.5, -18.5),
			Color = Color3.fromRGB(200, 235, 255),
			Material = Enum.Material.Glass,
			Transparency = 0.65,
			Parent = shop,
		})
		part({ Size = Vector3.new(0.4, 9, 0.6), CFrame = L(cx, 8.5, -18.5), Color = CREAM, Parent = shop })
		part({ Size = Vector3.new(18, 0.4, 0.6), CFrame = L(cx, 8.5, -18.5), Color = CREAM, Parent = shop })
	end
	part({ Size = Vector3.new(10, 6, 1), CFrame = L(0, 16, -18.5), Color = wallColor, Parent = shop })
	-- Molduras.
	for _, z in ipairs({ -18.5, 18.5 }) do
		part({ Size = Vector3.new(46.4, 0.8, 1.4), CFrame = L(0, 19, z), Color = CREAM, Parent = shop })
		part({ Size = Vector3.new(46.4, 0.6, 1.3), CFrame = L(0, 1.3, z), Color = CREAM, Parent = shop })
	end
	for _, x in ipairs({ -22.5, 22.5 }) do
		part({ Size = Vector3.new(1.4, 0.8, 38), CFrame = L(x, 19, 0), Color = CREAM, Parent = shop })
	end
	for _, x in ipairs({ -5.4, 5.4, -22.8, 22.8 }) do
		part({ Size = Vector3.new(1, 18, 1.4), CFrame = L(x, 10, -18.6), Color = CREAM, Parent = shop })
	end

	-- Techo y letrero.
	part({ Size = Vector3.new(48, 1.2, 40), CFrame = L(0, 19.9, 0), Color = Color3.fromRGB(70, 60, 90), Parent = shop })
	part({
		Size = Vector3.new(26, 5.4, 0.8),
		CFrame = L(0, 23.2, -18.7),
		Color = Color3.fromRGB(50, 40, 70),
		Parent = shop,
	})
	local signPart = part({
		Name = "Sign",
		Size = Vector3.new(24.8, 4.4, 0.3),
		CFrame = L(0, 23.2, -19.2),
		Color = Color3.fromRGB(60, 48, 84),
		Parent = shop,
	})
	local signLabel = surfaceText(signPart, Enum.NormalId.Front, "Galería libre", {
		pps = 30,
		color = Color3.fromRGB(255, 244, 220),
		stroke = accent,
		strokeThickness = 4,
	})
	signLabel.Name = "SignText"
	for _, data in ipairs({
		{ Vector3.new(26, 0.35, 0.35), CFrame.new(0, 2.85, 0) },
		{ Vector3.new(26, 0.35, 0.35), CFrame.new(0, -2.85, 0) },
		{ Vector3.new(0.35, 6, 0.35), CFrame.new(13, 0, 0) },
		{ Vector3.new(0.35, 6, 0.35), CFrame.new(-13, 0, 0) },
	}) do
		local neon = part({
			Size = data[1],
			CFrame = L(0, 23.2, -19.2) * data[2],
			Color = accent,
			Material = Enum.Material.Neon,
			CanCollide = false,
			Parent = shop,
		})
		neon.Name = "SignNeon"
	end
	addLight(
		signPart,
		"SurfaceLight",
		{ Face = Enum.NormalId.Front, Range = 10, Brightness = 1.2, Color = accent, Angle = 80 }
	)

	-- Toldo de rayas sobre las ventanas (lonas inclinadas con faldón).
	for side = -1, 1, 2 do
		for i = 0, 3 do
			local x = side * (5.75 + 2.25 + i * 4.5)
			local stripe = (i % 2 == 0) and accent or Color3.new(1, 1, 1)
			part({
				Size = Vector3.new(4.5, 0.3, 4.8),
				CFrame = L(x, 14.2, -20.8) * CFrame.Angles(math.rad(-28), 0, 0),
				Color = stripe,
				Material = Enum.Material.Fabric,
				CanCollide = false,
				Parent = shop,
			})
			part({
				Size = Vector3.new(4.5, 0.9, 0.2),
				CFrame = L(x, 12.75, -22.9),
				Color = stripe,
				Material = Enum.Material.Fabric,
				CanCollide = false,
				Parent = shop,
			})
		end
	end

	-- Mostrador con caja registradora (esquina delantera derecha).
	part({
		Size = Vector3.new(9, 4, 3),
		CFrame = L(16, 3, -13),
		Color = DARK_WOOD,
		Material = Enum.Material.Wood,
		Parent = shop,
	})
	part({ Size = Vector3.new(9.2, 0.6, 0.2), CFrame = L(16, 4.3, -14.55), Color = accent, Parent = shop })
	part({
		Size = Vector3.new(9.6, 0.5, 3.6),
		CFrame = L(16, 5.25, -13),
		Color = CREAM,
		Material = Enum.Material.Marble,
		Parent = shop,
	})
	part({
		Size = Vector3.new(2.2, 1.4, 1.8),
		CFrame = L(18, 6.2, -12.8),
		Color = Color3.fromRGB(70, 60, 90),
		Parent = shop,
	})
	part({
		Size = Vector3.new(1.8, 0.9, 0.2),
		CFrame = L(18, 7.2, -13.4) * CFrame.Angles(math.rad(20), 0, 0),
		Color = Color3.fromRGB(120, 255, 190),
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = shop,
	})

	-- Banco acolchado para admirar los cuadros.
	part({
		Size = Vector3.new(7, 1.4, 2.6),
		CFrame = L(-12, 1.7, 4),
		Color = accent:Lerp(Color3.new(1, 1, 1), 0.3),
		Material = Enum.Material.Fabric,
		Parent = shop,
	})
	for _, x in ipairs({ -15, -9 }) do
		part({ Size = Vector3.new(0.5, 1, 2.2), CFrame = L(x, 1.5, 4), Color = DARK_WOOD, Parent = shop })
	end

	-- Lámparas colgantes.
	for _, pos in ipairs({
		Vector3.new(-12, 0, -2),
		Vector3.new(12, 0, -2),
		Vector3.new(0, 0, -10),
		Vector3.new(0, 0, 8),
	}) do
		part({
			Size = Vector3.new(0.15, 3, 0.15),
			CFrame = L(pos.X, 17.8, pos.Z),
			Color = Color3.fromRGB(40, 30, 50),
			CanCollide = false,
			Parent = shop,
		})
		part({
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(1, 2.6, 2.6),
			CFrame = cylinderUp(L(pos.X, 16.2, pos.Z)),
			Color = accent,
			CanCollide = false,
			Parent = shop,
		})
		local bulb = part({
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(1.3, 1.3, 1.3),
			CFrame = L(pos.X, 15.6, pos.Z),
			Color = Color3.fromRGB(255, 230, 180),
			Material = Enum.Material.Neon,
			CanCollide = false,
			Parent = shop,
		})
		addLight(
			bulb,
			"PointLight",
			{ Range = 22, Brightness = 1.1, Color = Color3.fromRGB(255, 220, 180), Shadows = true }
		)
	end

	-- Plantas interiores.
	buildPlant(shop, L(19.5, 1, 15.5), 1)
	buildPlant(shop, L(-19.5, 1, 15.5), 1)
	buildPlant(shop, L(-19.5, 1, -15.5), 0.9)

	-- Galería en las paredes.
	local gallery = Instance.new("Folder")
	gallery.Name = "Gallery"
	gallery.Parent = model
	local frameCFrames = {
		L(-12, 11, 17.9),
		L(0, 11.5, 17.9),
		L(12, 11, 17.9),
		L(-21.9, 11, 8) * CFrame.Angles(0, -math.pi / 2, 0),
		L(21.9, 11, 8) * CFrame.Angles(0, math.pi / 2, 0),
		L(-21.9, 11, -6) * CFrame.Angles(0, -math.pi / 2, 0),
		L(21.9, 11, -6) * CFrame.Angles(0, math.pi / 2, 0),
	}
	local canvases, plaques, standPoints = {}, {}, {}
	for i = 1, Config.GALLERY_SIZE do
		canvases[i], plaques[i] = buildFrame(gallery, frameCFrames[i], "Frame" .. i)
		canvases[i]:SetAttribute("Slot", i)
		-- Dónde se para un visitante para mirar el cuadro.
		local front = frameCFrames[i] * CFrame.new(0, 0, -6.5)
		standPoints[i] = CFrame.lookAt(
			Vector3.new(front.X, plotCF.Y + 1, front.Z),
			Vector3.new(frameCFrames[i].X, plotCF.Y + 1, frameCFrames[i].Z)
		)
	end

	local decor = Instance.new("Folder")
	decor.Name = "Decor"
	decor.Parent = model

	local visitors = Instance.new("Folder")
	visitors.Name = "Visitors"
	visitors.Parent = model

	-- Exterior: jardineras junto a la entrada.
	buildFlowerBed(shop, L(-14, 0, -24.5), 16, rng)
	buildFlowerBed(shop, L(14, 0, -24.5), 16, rng)

	local workshop = buildWorkshop(model, L, accent)

	model.Parent = parent

	return {
		index = index,
		model = model,
		cframe = plotCF,
		entrance = L(0, 0.4, -24),
		inside = L(0, 1, -12),
		street = L(0, 0.4, -(PLOT_RADIUS - PLAZA_RADIUS) + 4),
		ownerSpawn = L(44, 4, -7) * CFrame.Angles(0, math.pi, 0),
		signLabel = signLabel,
		canvases = canvases,
		plaques = plaques,
		standPoints = standPoints,
		decorFolder = decor,
		visitorsFolder = visitors,
		workshop = workshop,
		decorBuilt = 0,
		L = L,
	}
end

-- Construye las decoraciones hasta el nivel indicado (o las quita si baja).
function WorldBuilder.setDecorLevel(plot, level)
	if level < plot.decorBuilt then
		plot.decorFolder:ClearAllChildren()
		plot.decorBuilt = 0
	end
	for i = plot.decorBuilt + 1, math.min(level, #DECOR_BUILDERS) do
		local folder = Instance.new("Folder")
		folder.Name = "Decor" .. i
		DECOR_BUILDERS[i](folder, plot.L)
		folder.Parent = plot.decorFolder
		plot.decorBuilt = i
	end
end

function WorldBuilder.build()
	setupLighting()

	local world = Instance.new("Folder")
	world.Name = "World"
	world.Parent = Workspace

	local rng = Random.new(2024)

	part({
		Name = "Ground",
		Size = Vector3.new(800, 4, 800),
		CFrame = CFrame.new(0, -2, 0),
		Color = Color3.fromRGB(120, 200, 110),
		Material = Enum.Material.Grass,
		Parent = world,
	})
	part({
		Name = "Plaza",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.4, PLAZA_RADIUS * 2, PLAZA_RADIUS * 2),
		CFrame = cylinderUp(CFrame.new(0, 0.2, 0)),
		Color = Color3.fromRGB(236, 222, 200),
		Material = Enum.Material.Cobblestone,
		Parent = world,
	})
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.45, 40, 40),
		CFrame = cylinderUp(CFrame.new(0, 0.22, 0)),
		Color = Color3.fromRGB(214, 196, 240),
		Material = Enum.Material.Pavement,
		Parent = world,
	})
	buildFountain(world)

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "PlazaSpawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(8, 0.4, 8)
	spawn.CFrame = CFrame.new(26, 0.6, 0)
	spawn.Color = Color3.fromRGB(255, 196, 214)
	spawn.Material = Enum.Material.SmoothPlastic
	spawn.Duration = 0
	spawn.Neutral = true
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.Parent = world

	-- Jardineras redondas alrededor de la fuente, entre los caminos.
	for i = 0, Config.MAX_PLOTS - 1 do
		local angle = (i + 0.5) / Config.MAX_PLOTS * math.pi * 2
		local center = CFrame.new(math.cos(angle) * 30, 0, math.sin(angle) * 30)
		part({
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(1.6, 9, 9),
			CFrame = cylinderUp(center * CFrame.new(0, 0.8, 0)),
			Color = CREAM,
			Material = Enum.Material.Marble,
			Parent = world,
		})
		part({
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.4, 8, 8),
			CFrame = cylinderUp(center * CFrame.new(0, 1.5, 0)),
			Color = Color3.fromRGB(110, 76, 56),
			Material = Enum.Material.Ground,
			Parent = world,
		})
		for f = 1, 10 do
			local a = f / 10 * math.pi * 2
			local r = (f % 2 == 0) and 2.6 or 1.4
			part({
				Shape = Enum.PartType.Ball,
				Size = Vector3.new(1.3, 1.3, 1.3),
				CFrame = center * CFrame.new(math.cos(a) * r, 2.3 + (f % 3) * 0.3, math.sin(a) * r),
				Color = RAINBOW[(i + f) % #RAINBOW + 1],
				CanCollide = false,
				Parent = world,
			})
		end
		part({
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(3.4, 3.4, 3.4),
			CFrame = center * CFrame.new(0, 3.2, 0),
			Color = Color3.fromRGB(110, 200, 110),
			Material = Enum.Material.Grass,
			CanCollide = false,
			Parent = world,
		})
	end

	for i = 0, 11 do
		local angle = (i + 0.5) / 12 * math.pi * 2
		local pos = Vector3.new(math.cos(angle), 0, math.sin(angle)) * (PLAZA_RADIUS - 4)
		buildLampPost(world, CFrame.new(pos))
		if i % 2 == 0 then
			buildBench(world, CFrame.lookAt(pos * 0.82, Vector3.new(0, 0, 0)))
		end
	end

	-- Árboles entre galerías y alrededor del mundo.
	for i = 0, Config.MAX_PLOTS - 1 do
		local angle = (i + 0.5) / Config.MAX_PLOTS * math.pi * 2
		for _, radius in ipairs({ 100, 178, 215 }) do
			local jitter = Vector3.new(rng:NextNumber(-6, 6), 0, rng:NextNumber(-6, 6))
			local pos = Vector3.new(math.cos(angle), 0, math.sin(angle)) * radius + jitter
			buildTree(world, CFrame.new(pos), rng:NextNumber(0.9, 1.3), rng)
		end
	end
	for i = 1, 40 do
		local angle = i / 40 * math.pi * 2 + rng:NextNumber(-0.05, 0.05)
		local radius = rng:NextNumber(235, 300)
		buildTree(world, CFrame.new(math.cos(angle) * radius, 0, math.sin(angle) * radius), rng:NextNumber(1, 1.6), rng)
	end

	local plotsFolder = Instance.new("Folder")
	plotsFolder.Name = "Plots"
	plotsFolder.Parent = Workspace

	local plots = {}
	for i = 1, Config.MAX_PLOTS do
		local angle = (i - 1) / Config.MAX_PLOTS * math.pi * 2
		local position = Vector3.new(math.cos(angle), 0, math.sin(angle)) * PLOT_RADIUS
		local plotCF = CFrame.lookAt(position, Vector3.new(0, 0, 0))
		plots[i] = buildPlot(plotsFolder, i, plotCF, rng)
	end
	return plots
end

return WorldBuilder
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="13">
    <Properties>
      <string name="Name">SoundService</string>
      <bool name="RespectFilteringEnabled">true</bool>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="14">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">80</float>
      <float name="CharacterWalkSpeed">20</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="15">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="16">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="LocalScript" referent="17">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- Punto de entrada del cliente: conecta las ventanas con el servidor.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")

local UI = script.Parent:WaitForChild("UI")
local Theme = require(UI.Theme)
local HUD = require(UI.HUD)
local Machine = require(UI.Machine)
local DesignPicker = require(UI.DesignPicker)
local ColorPicker = require(UI.ColorPicker)
local Painter = require(UI.Painter)
local Shop = require(UI.Shop)
local World = require(script.Parent:WaitForChild("World"))

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Colors = require(Shared.Colors)

local remotes = ReplicatedStorage:WaitForChild("Remotes")

local app = { state = nil, remotes = {} }
for _, name in ipairs({
	"GetState",
	"StateChanged",
	"Notify",
	"Roll",
	"SetAutoRoll",
	"RollResult",
	"OpenDesigns",
	"UnlockDesign",
	"StartPainting",
	"CancelPainting",
	"FinishPainting",
	"BuyUpgrade",
	"ClaimDaily",
	"GoHome",
}) do
	app.remotes[name] = remotes:WaitForChild(name)
end

-- Último cuadro empezado (para retomarlo si se cierra la ventana).
local lastPainting = nil

function app.notify(text, kind)
	HUD.notify(text, kind)
end

function app.celebrate()
	HUD.celebrate()
end

function app.openShop()
	Shop.open()
end

function app.openCollection()
	Machine.openCollection()
end

function app.openDesigns()
	if Painter.isOpen() then
		return
	end
	DesignPicker.open()
end

function app.openColorPicker(design)
	ColorPicker.open(design)
end

function app.openPainter(design, colors)
	lastPainting = { design = design, colors = colors }
	Painter.open(design, colors)
end

function app.resumePainting()
	if Painter.isOpen() then
		return
	end
	if lastPainting and app.state and app.state.painting == lastPainting.design.id then
		Painter.open(lastPainting.design, lastPainting.colors)
	else
		app.remotes.CancelPainting:FireServer()
	end
end

function app.setHudVisible(visible)
	HUD.setVisible(visible)
	Machine.setVisible(visible)
end

local claiming = false
function app.claimDaily()
	if claiming then
		return
	end
	if not (app.state and app.state.dailyReady) then
		app.notify(
			"Tu próximo regalo llega en " .. Theme.formatTime(app.state and app.state.dailyWait or 0) .. " ⏰",
			"info"
		)
		return
	end
	claiming = true
	local ok, success, amount, colorId = pcall(function()
		return app.remotes.ClaimDaily:InvokeServer()
	end)
	claiming = false
	if ok and success then
		Theme.playSound("success", 1.1)
		local entry = Colors.ById[colorId]
		app.notify(
			"🎁 ¡Regalo diario! +💵"
				.. Theme.formatNumber(amount)
				.. (entry and (" y «" .. entry.name .. "»") or ""),
			"gold"
		)
		app.celebrate()
	end
end

local function applyState(state)
	if type(state) ~= "table" then
		return
	end
	app.state = state
	HUD.applyState(state)
	Machine.applyState(state)
	Shop.refresh()
	DesignPicker.refresh()
	ColorPicker.refresh()
end

pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
end)

HUD.init(app)
Machine.init(app)
DesignPicker.init(app)
ColorPicker.init(app)
Painter.init(app)
Shop.init(app)
World.start()

app.remotes.StateChanged.OnClientEvent:Connect(applyState)
app.remotes.Notify.OnClientEvent:Connect(function(text, kind)
	app.notify(text, kind)
end)
app.remotes.RollResult.OnClientEvent:Connect(function(colorId)
	Machine.onRoll(colorId)
end)
app.remotes.OpenDesigns.OnClientEvent:Connect(function()
	app.openDesigns()
end)

task.spawn(function()
	local ok, state = pcall(function()
		return app.remotes.GetState:InvokeServer()
	end)
	if ok and state and not app.state then
		applyState(state)
	end
end)
]]></string>
          </Properties>
