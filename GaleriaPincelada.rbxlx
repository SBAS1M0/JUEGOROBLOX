      <Item class="Folder" referent="12">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[-- Guarda y carga el progreso de cada jugador con DataStoreService.
-- Si los DataStores no están disponibles (por ejemplo en Studio sin publicar)
-- el juego sigue funcionando, solo que sin guardar.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Exhibition = require(Shared.Exhibition)

local DataService = {}

local STORE_NAME = "GaleriaPincelada_v2"
local MAX_RETRIES = 4

local store = nil
local profiles = {}
local loaded = {}

do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
	else
		warn("[Galería] DataStores no disponibles, el progreso no se guardará: " .. tostring(result))
	end
end

local function defaultStands()
	local stands = {}
	for i = 1, Exhibition.SPOT_COUNT do
		stands[i] = i <= Exhibition.FREE_STANDS and 1 or 0
	end
	return stands
end

local function defaultData()
	return {
		coins = Config.START_COINS,
		paints = {}, -- colorId -> cantidad
		unlocked = { globo = true }, -- diseños comprados
		made = {}, -- diseñoId -> veces pintado
		upgrades = {},
		gallery = {}, -- { s = stand, d = diseño, c = colores, v = valor, p = precio, st = estrellas }
		storage = {}, -- cuadros terminados sin exponer (el primero es el que llevas)
		stands = defaultStands(), -- calidad del stand de cada hueco (0 = sin comprar)
		rooms = 1, -- salas abiertas
		best = 0, -- mejor venta
		autoRoll = false,
		lastRoll = "",
		rolls = 0,
		pity = 0, -- tiradas seguidas sin nada Raro o mejor
		discovered = {}, -- colorId -> true (colección)
		quests = {},
		questDay = 0,
		questBonus = false,
		tutorial = 1,
		tutorialProgress = 0,
		sold = 0,
		earned = 0,
		lastDaily = 0,
		dailyStreak = 0,
	}
end

-- Partidas de la versión con marcos fijos y la mejora «Más paredes»: cada
-- marco que tenías pasa a ser un stand de galería con su cuadro expuesto.
local function migrate(data)
	if type(data) ~= "table" or data.stands ~= nil then
		return data
	end
	local upgrades = type(data.upgrades) == "table" and data.upgrades or {}
	local frames = math.clamp(3 + (tonumber(upgrades.paredes) or 0), 1, 8)
	upgrades.paredes = nil
	local stands = {}
	for i = 1, Exhibition.SPOT_COUNT do
		stands[i] = i <= frames and 2 or 0
	end
	data.stands = stands
	data.rooms = 1
	if type(data.gallery) == "table" then
		local kept = {}
		for _, entry in ipairs(data.gallery) do
			if type(entry) == "table" and #kept < frames then
				entry.s = #kept + 1
				entry.p = entry.v
				table.insert(kept, entry)
			end
		end
		data.gallery = kept
	end
	return data
end

-- Rellena campos que falten (por ejemplo tras una actualización del juego).
local function reconcile(data)
	local template = defaultData()
	data = migrate(data)
	if type(data) ~= "table" then
		return template
	end
	for key, value in pairs(template) do
		if type(data[key]) ~= type(value) then
			data[key] = value
		end
	end
	for id in pairs(data.upgrades) do
		if not Config.UpgradeById[id] then
			data.upgrades[id] = nil
		end
	end
	for i = 1, Exhibition.SPOT_COUNT do
		if type(data.stands[i]) ~= "number" then
			data.stands[i] = 0
		end
		data.stands[i] = math.clamp(math.floor(data.stands[i]), 0, Exhibition.MAX_TIER)
	end
	data.rooms = math.clamp(math.floor(data.rooms), 1, #Exhibition.Rooms)
	return data
end

-- Errores que no se arreglan reintentando (Studio sin acceso a las APIs).
local function isPermanentError(message)
	message = tostring(message)
	return string.find(message, "StudioAccessToApisNotAllowed", 1, true) ~= nil
		or string.find(message, "publish", 1, true) ~= nil
end

local function disableStore(reason)
	if store then
		store = nil
		warn("[Galería] DataStores no disponibles, el progreso no se guardará: " .. tostring(reason))
	end
end

local function withRetries(callback)
	local lastError
	for attempt = 1, MAX_RETRIES do
		local ok, result = pcall(callback)
		if ok then
			return true, result
		end
		lastError = result
		if isPermanentError(result) then
			disableStore(result)
			break
		end
		task.wait(attempt * 1.5)
	end
	return false, lastError
end

function DataService.load(player)
	local data
	local canSave = store ~= nil
	local currentStore = store
	if currentStore then
		local ok, result = withRetries(function()
			return currentStore:GetAsync("player_" .. player.UserId)
		end)
		if ok then
			data = result
		else
			-- No guardamos encima de datos que no pudimos leer.
			canSave = false
			if store then
				warn("[Galería] No se pudo cargar a " .. player.Name .. ": " .. tostring(result))
			end
		end
	end
	data = reconcile(data)
	if player.Parent then
		profiles[player] = data
		loaded[player] = canSave
	end
	return data
end

function DataService.get(player)
	return profiles[player]
end

function DataService.save(player)
	local data = profiles[player]
	local currentStore = store
	if not (currentStore and data and loaded[player]) then
		return
	end
	local ok, result = withRetries(function()
		return currentStore:UpdateAsync("player_" .. player.UserId, function()
			return data
		end)
	end)
	if not ok then
		warn("[Galería] No se pudo guardar a " .. player.Name .. ": " .. tostring(result))
	end
end

function DataService.release(player)
	DataService.save(player)
	profiles[player] = nil
	loaded[player] = nil
end

function DataService.start()
	task.spawn(function()
		while true do
			task.wait(Config.AUTOSAVE_SECONDS)
			for _, player in ipairs(Players:GetPlayers()) do
				task.spawn(DataService.save, player)
			end
		end
	end)

	game:BindToClose(function()
		if RunService:IsStudio() and not store then
			return
		end
		local pending = 0
		for _, player in ipairs(Players:GetPlayers()) do
			pending += 1
			task.spawn(function()
				DataService.save(player)
				pending -= 1
			end)
		end
		local started = os.clock()
		while pending > 0 and os.clock() - started < 25 do
			task.wait(0.2)
		end
	end)
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">VisitorService</string>
            <string name="Source"><![CDATA[-- Visitantes: avatares reales de Roblox (los amigos del dueño o avatares
-- conocidos) que entran a la galería, miran los cuadros expuestos y, si el
-- precio les convence, van a la caja a pagarlo o a hacerte una oferta.

local PathfindingService = game:GetService("PathfindingService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Exhibition = require(Shared.Exhibition)

local VisitorService = {}

VisitorService.COLLISION_GROUP = "Visitantes"

local ANIMATIONS = {
	walk = "rbxassetid://507777826",
	idle = "rbxassetid://507766388",
	cheer = "rbxassetid://507770677",
	wave = "rbxassetid://507770239",
}
local FALLBACK_NAMES =
	{ "Lucía", "Mateo", "Sofía", "Diego", "Valentina", "Leo", "Camila", "Hugo", "Martina", "Bruno" }
local SKIN_TONES = {
	Color3.fromRGB(255, 224, 196),
	Color3.fromRGB(241, 194, 150),
	Color3.fromRGB(214, 160, 120),
	Color3.fromRGB(170, 116, 80),
	Color3.fromRGB(120, 80, 56),
}
local SHIRT_COLORS = {
	Color3.fromRGB(255, 140, 160),
	Color3.fromRGB(120, 190, 255),
	Color3.fromRGB(130, 220, 160),
	Color3.fromRGB(255, 200, 100),
	Color3.fromRGB(190, 150, 255),
}

-- Callbacks que asigna el servidor principal.
VisitorService.getProfile = nil -- (player) -> datos
VisitorService.listings = nil -- (player) -> { [stand] = { price, market, tier, d, c, st } }
VisitorService.isTutorial = nil -- (player) -> true si el tutorial espera la primera venta
VisitorService.hasCashier = nil -- (player) -> true con la mejora Cajero
VisitorService.askOwner = nil -- (player, oferta) -> "accept" | "reject" | "counter" | "timeout"
VisitorService.onSale = nil -- (player, stand, precio, nombre, vip, cómo) -> cuadro vendido o nil
VisitorService.onPass = nil -- (player, stand, ratio, nombre): no lo compró por caro

local rng = Random.new()
local states = {}
local descriptionCache = {}
local friendsOf = {}

local function pick(list)
	return list[rng:NextInteger(1, #list)]
end

-- Avatares ----------------------------------------------------------------------------
local function loadFriends(owner)
	if friendsOf[owner] then
		return
	end
	friendsOf[owner] = {}
	task.spawn(function()
		local ok, pages = pcall(function()
			return Players:GetFriendsAsync(owner.UserId)
		end)
		if not ok or not pages then
			return
		end
		local okPage, page = pcall(function()
			return pages:GetCurrentPage()
		end)
		if okPage and type(page) == "table" then
			local list = {}
			for _, friend in ipairs(page) do
				if type(friend) == "table" and friend.Id then
					table.insert(list, { id = friend.Id, name = friend.DisplayName or friend.Username })
				end
			end
			if owner.Parent then
				friendsOf[owner] = list
			end
		end
	end)
end

local function getDescription(userId)
	local cached = descriptionCache[userId]
	if cached ~= nil then
		return cached or nil
	end
	local ok, description = pcall(function()
		return Players:GetHumanoidDescriptionFromUserId(userId)
	end)
	descriptionCache[userId] = (ok and description) or false
	return ok and description or nil
end

local function randomDescription()
	local description = Instance.new("HumanoidDescription")
	local skin = pick(SKIN_TONES)
	local shirt = pick(SHIRT_COLORS)
	description.HeadColor = skin
	description.LeftArmColor = skin
	description.RightArmColor = skin
	description.TorsoColor = shirt
	description.LeftLegColor = Color3.fromRGB(70, 70, 110)
	description.RightLegColor = Color3.fromRGB(70, 70, 110)
	return description
end

local function setCollisionGroup(model)
	for _, descendant in ipairs(model:GetDescendants()) do
		if descendant:IsA("BasePart") then
			descendant.CollisionGroup = VisitorService.COLLISION_GROUP
		end
	end
end

local function createAvatar(owner)
	local friends = friendsOf[owner] or {}
	local userId, name
	if #friends > 0 and rng:NextNumber() < 0.75 then
		local friend = pick(friends)
		userId, name = friend.id, friend.name
	else
		userId = pick(Config.FALLBACK_AVATARS)
	end
	local description = getDescription(userId) or randomDescription()
	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromDescription(description, Enum.HumanoidRigType.R15)
	end)
	if not ok or not model then
		ok, model = pcall(function()
			return Players:CreateHumanoidModelFromDescription(randomDescription(), Enum.HumanoidRigType.R15)
		end)
		if not ok or not model then
			return nil
		end
	end
	return model, name or pick(FALLBACK_NAMES), userId
end

-- Movimiento y animaciones -------------------------------------------------------------
local PATH_PARAMS = { AgentRadius = 1.6, AgentHeight = 5, AgentCanJump = false, WaypointSpacing = 4 }

local function loadTracks(humanoid)
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end
	local tracks = {}
	for name, id in pairs(ANIMATIONS) do
		local animation = Instance.new("Animation")
		animation.AnimationId = id
		local ok, track = pcall(function()
			return animator:LoadAnimation(animation)
		end)
		if ok and track then
			track.Looped = name == "walk" or name == "idle"
			tracks[name] = track
		end
	end
	return tracks
end

local function play(visitor, name)
	for trackName, track in pairs(visitor.tracks) do
		if trackName ~= name and track.IsPlaying then
			track:Stop(0.2)
		end
	end
	local track = visitor.tracks[name]
	if track and not track.IsPlaying then
		track:Play(0.2)
	end
end

local function alive(visitor)
	return visitor.model.Parent ~= nil and visitor.humanoid.Parent ~= nil
end

local function flatDistance(a, b)
	return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
end

-- Un paso con MoveTo; espera a que llegue o a que pase el tiempo.
local function stepTo(visitor, position, timeout)
	local finished = false
	local connection = visitor.humanoid.MoveToFinished:Connect(function()
		finished = true
	end)
	visitor.humanoid:MoveTo(position)
	local started = os.clock()
	while not finished and alive(visitor) and os.clock() - started < timeout do
		task.wait(0.1)
	end
	connection:Disconnect()
	return alive(visitor)
end

-- Camina hasta el punto esquivando los stands (PathfindingService). Si no
-- encuentra camino va en línea recta y, si se atasca, se le acerca al destino.
local function walkTo(visitor, target)
	if not alive(visitor) then
		return false
	end
	play(visitor, "walk")
	local goal = target.Position
	-- Fuera (calle y jardín) se camina en línea recta; dentro hay stands.
	local indoors = goal.Y > 1
	local ok, path = false, nil
	if indoors then
		ok, path = pcall(function()
			local newPath = PathfindingService:CreatePath(PATH_PARAMS)
			newPath:ComputeAsync(visitor.root.Position, goal)
			return newPath
		end)
	end
	if ok and path and path.Status == Enum.PathStatus.Success then
		local waypoints = path:GetWaypoints()
		for i = 2, #waypoints do
			if not stepTo(visitor, waypoints[i].Position, 4) then
				return false
			end
			if flatDistance(visitor.root.Position, waypoints[i].Position) > 4 then
				break
			end
		end
	end
	for _ = 1, 3 do
		if not alive(visitor) then
			return false
		end
		if flatDistance(visitor.root.Position, goal) <= 3 then
			return true
		end
		stepTo(visitor, goal, 9)
	end
	if not alive(visitor) then
		return false
	end
	if flatDistance(visitor.root.Position, goal) > 3 then
		visitor.model:PivotTo(target * CFrame.new(0, 3, 0))
	end
	return true
end

local function walkRoute(visitor, points)
	for _, point in ipairs(points) do
		if not walkTo(visitor, point) then
			return false
		end
	end
	return true
end

-- Recorridos dentro de la galería (las ampliaciones están al fondo).
local function pathTo(plot, slot)
	local list = table.clone(plot.roomPaths[Exhibition.roomOf(slot)] or {})
	table.insert(list, plot.standPoints[slot])
	return list
end

local function pathBack(plot, slot)
	local list = {}
	local path = plot.roomPaths[Exhibition.roomOf(slot)] or {}
	for i = #path, 1, -1 do
		table.insert(list, path[i])
	end
	table.insert(list, plot.hub)
	return list
end

local function goToStand(visitor, plot, fromSlot, slot)
	if fromSlot and Exhibition.roomOf(fromSlot) == Exhibition.roomOf(slot) then
		return walkTo(visitor, plot.standPoints[slot])
	end
	if fromSlot and not walkRoute(visitor, pathBack(plot, fromSlot)) then
		return false
	end
	return walkRoute(visitor, pathTo(plot, slot))
end

local function standStill(visitor, cf)
	visitor.model:PivotTo(cf * CFrame.new(0, 3, 0))
	play(visitor, "idle")
end

-- El cuadro comprado se lo lleva bajo el brazo (a la espalda).
local function carryPainting(visitor, bought)
	local root = visitor.root
	local holder = Instance.new("Model")
	holder.Name = "BoughtPainting"
	local base = root.CFrame * CFrame.new(0, 0.3, 0.9) * CFrame.Angles(math.rad(-8), math.pi, 0)
	local back = Instance.new("Part")
	back.Name = "Back"
	back.Size = Vector3.new(3, 3, 0.25)
	back.CFrame = base
	back.Color = Color3.fromRGB(214, 176, 128)
	back.Material = Enum.Material.Wood
	local canvas = Instance.new("Part")
	canvas.Name = "Canvas"
	canvas.Size = Vector3.new(2.6, 2.6, 0.1)
	canvas.CFrame = base * CFrame.new(0, 0, -0.16)
	canvas.Color = Color3.fromRGB(250, 248, 242)
	for _, piece in ipairs({ back, canvas }) do
		piece.CanCollide = false
		piece.CanQuery = false
		piece.CanTouch = false
		piece.Massless = true
		piece.CastShadow = false
		piece.CollisionGroup = VisitorService.COLLISION_GROUP
		piece.Parent = holder
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = root
		weld.Part1 = piece
		weld.Parent = piece
	end
	canvas:SetAttribute("Design", bought.d)
	canvas:SetAttribute("Colors", bought.c)
	canvas:SetAttribute("Stars", bought.st or 1)
	holder.Parent = visitor.model
end

-- Cola de la caja ------------------------------------------------------------------------
local function queueIndex(state, visitor)
	for i, other in ipairs(state.queue) do
		if other == visitor then
			return i
		end
	end
	return nil
end

local function leaveQueue(state, visitor)
	local index = queueIndex(state, visitor)
	if index then
		table.remove(state.queue, index)
	end
end

-- Hace cola hasta ser el primero; devuelve false si algo sale mal.
local function waitTurn(state, visitor)
	local plot = state.plot
	table.insert(state.queue, visitor)
	local lastSpot = nil
	while alive(visitor) and states[plot.index] == state do
		local index = queueIndex(state, visitor)
		if not index then
			return false
		end
		local spot = math.min(index, #plot.caja.queue)
		if spot ~= lastSpot then
			lastSpot = spot
			if not walkTo(visitor, plot.caja.queue[spot]) then
				return false
			end
			standStill(visitor, plot.caja.queue[spot])
			if index > 1 then
				visitor.model:SetAttribute("Reaction", "⏳")
			end
		end
		if index == 1 then
			return true
		end
		task.wait(0.3)
	end
	return false
end

-- Regateo en la caja: devuelve lo que paga (o nil) y cómo se cerró.
local function negotiate(visitor, owner, info, listing, budget, tutorial)
	local model = visitor.model
	local function say(text)
		model:SetAttribute("Reaction", text)
	end
	local offer = Exhibition.roundPrice(math.max(budget, listing.market * Exhibition.PRICE_MIN))
	if offer >= listing.price then
		return listing.price, nil
	end
	say("💬 ¿Te doy 💵" .. Config.formatNumber(offer) .. "?")
	local base = {
		buyer = info.name,
		userId = info.userId,
		vip = info.vip,
		d = listing.d,
		c = listing.c,
		st = listing.st,
		price = listing.price,
		market = listing.market,
	}
	base.offer = offer
	base.final = false
	local answer = VisitorService.askOwner(owner, base)
	if answer == "accept" then
		return offer, nil
	elseif answer == "counter" then
		local counter = Exhibition.counterPrice(offer, listing.price)
		local flex = tutorial and 10 or rng:NextNumber(1, 1.16)
		if counter <= budget * flex then
			say("🤝 ¡Trato hecho!")
			task.wait(1)
			return counter, nil
		end
		if rng:NextNumber() < 0.55 then
			local final = math.max(offer, Exhibition.roundPrice(offer + (counter - offer) * rng:NextNumber(0.3, 0.6)))
			say("Mi última oferta: 💵" .. Config.formatNumber(final))
			base.offer = final
			base.final = true
			local second = VisitorService.askOwner(owner, base)
			if second == "accept" then
				return final, nil
			elseif second == "timeout" and VisitorService.hasCashier(owner) then
				if final >= listing.price * Exhibition.CASHIER_ACCEPT then
					return final, "cashier"
				end
			end
		end
		say("¡Es demasiado para mí! 😤")
		return nil, nil
	elseif answer == "timeout" then
		if VisitorService.hasCashier(owner) then
			if offer >= listing.price * Exhibition.CASHIER_ACCEPT then
				return offer, "cashier"
			end
			say("El cajero dijo que no… 😕")
			return nil, nil
		end
		say("Nadie me atiende… 😕")
		return nil, nil
	end
	say("Vaya… otra vez será 😕")
	return nil, nil
end

-- Ciclo de un visitante -----------------------------------------------------------------
local function runVisitor(state, slot)
	local plot = state.plot
	local owner = state.owner
	local model, name, userId = createAvatar(owner)
	if not model or states[plot.index] ~= state then
		state.reserved[slot] = nil
		if model then
			model:Destroy()
		end
		return
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local root = model:FindFirstChild("HumanoidRootPart")
	if not (humanoid and root) then
		state.reserved[slot] = nil
		model:Destroy()
		return
	end
	local profile = VisitorService.getProfile(owner)
	local vip = profile ~= nil and rng:NextNumber() < Config.vipChance(profile.upgrades)
	model.Name = vip and "Coleccionista" or "Visitante"
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.WalkSpeed = 13
	model:SetAttribute("VisitorName", name)
	model:SetAttribute("VIP", vip)
	model:SetAttribute("Owner", owner.UserId)
	model:SetAttribute("Reaction", "")
	setCollisionGroup(model)
	local start = plot.route[1]
	model:PivotTo(CFrame.lookAt(start.Position, plot.route[2].Position) * CFrame.new(0, 3, 0))
	model.Parent = plot.visitorsFolder
	pcall(function()
		root:SetNetworkOwner(nil)
	end)
	if vip then
		local sparkles = Instance.new("Sparkles")
		sparkles.SparkleColor = Color3.fromRGB(255, 210, 80)
		sparkles.Parent = root
	end

	local visitor = { model = model, humanoid = humanoid, root = root, tracks = loadTracks(humanoid) }
	state.visitors[visitor] = true
	local info = { name = name, userId = userId, vip = vip }

	local function finish()
		leaveQueue(state, visitor)
		state.visitors[visitor] = nil
		state.reserved[slot] = nil
		if model.Parent then
			model:Destroy()
		end
	end
	local function valid()
		return alive(visitor) and states[plot.index] == state
	end
	local function leave(fromSlot)
		state.reserved[slot] = nil
		if fromSlot then
			walkRoute(visitor, pathBack(plot, fromSlot))
		end
		walkRoute(visitor, plot.exitFromHub)
		finish()
	end

	if not walkRoute(visitor, plot.route) then
		finish()
		return
	end

	-- Mira otro cuadro antes de decidirse (si hay más de uno).
	local current = nil
	local others = {}
	for other in pairs(VisitorService.listings(owner)) do
		if other ~= slot then
			table.insert(others, other)
		end
	end
	if #others > 0 and rng:NextNumber() < 0.6 then
		local browse = pick(others)
		if goToStand(visitor, plot, nil, browse) then
			standStill(visitor, plot.standPoints[browse])
			model:SetAttribute("Reaction", "👀")
			task.wait(rng:NextNumber(1.5, 2.5))
			current = browse
		end
	end

	-- Se planta frente al cuadro elegido y lo admira.
	if not goToStand(visitor, plot, current, slot) or not valid() then
		finish()
		return
	end
	standStill(visitor, plot.standPoints[slot])
	model:SetAttribute("Reaction", vip and "🧐✨" or "🤔")
	task.wait(rng:NextNumber(2.5, 4))
	if not valid() then
		finish()
		return
	end

	local listing = VisitorService.listings(owner)[slot]
	if not listing then
		model:SetAttribute("Reaction", "Oh... ya no está 😢")
		play(visitor, "wave")
		task.wait(2)
		leave(slot)
		return
	end
	local tutorial = VisitorService.isTutorial(owner)
	local ratio = listing.price / math.max(1, listing.market)
	local effective = vip and ratio / 1.8 or ratio
	if not tutorial and rng:NextNumber() > Exhibition.interest(effective) then
		model:SetAttribute(
			"Reaction",
			effective > 1.25 and pick(Config.TooExpensiveLines) or pick(Config.NotForMeLines)
		)
		if VisitorService.onPass then
			VisitorService.onPass(owner, slot, effective, name)
		end
		task.wait(2.4)
		leave(slot)
		return
	end

	-- Le encanta: va a la caja a pagar o a hacerte una oferta.
	model:SetAttribute("Reaction", pick(Config.InterestedLines))
	task.wait(1.4)
	if not walkRoute(visitor, pathBack(plot, slot)) or not waitTurn(state, visitor) then
		finish()
		return
	end
	local caja = plot.caja.queue[1]
	standStill(visitor, caja)

	listing = VisitorService.listings(owner)[slot]
	local amount, how = nil, nil
	if listing then
		local budget = tutorial and listing.price * 0.9 or Exhibition.budget(listing.market, vip, rng)
		if listing.price <= budget then
			amount = listing.price
			model:SetAttribute("Reaction", "¡Pago lo que pides! 💵" .. Config.formatNumber(amount))
			task.wait(1.2)
		else
			amount, how = negotiate(visitor, owner, info, listing, budget, tutorial)
		end
	else
		model:SetAttribute("Reaction", "Oh... ya no está 😢")
	end
	if not valid() then
		finish()
		return
	end
	local bought = amount and VisitorService.onSale and VisitorService.onSale(owner, slot, amount, name, vip, how)
	if bought then
		carryPainting(visitor, bought)
		local line = vip and "¡Una joya para mi colección! 👑" or pick(Config.BuyerLines)
		model:SetAttribute("Reaction", line .. "\n💰 " .. Config.formatNumber(amount))
		play(visitor, "cheer")
	elseif amount then
		model:SetAttribute("Reaction", "Oh... ya no está 😢")
		play(visitor, "wave")
	else
		play(visitor, "wave")
	end
	leaveQueue(state, visitor)
	state.reserved[slot] = nil
	task.wait(2.6)
	walkRoute(visitor, plot.exitRoute)
	finish()
end

-- Elige un cuadro: los más baratos (respecto a su precio medio) y los
-- stands mejores atraen más.
local function chooseListing(state)
	local options, total = {}, 0
	for slot, listing in pairs(VisitorService.listings(state.owner)) do
		if not state.reserved[slot] then
			local ratio = listing.price / math.max(1, listing.market)
			local weight = Exhibition.interest(ratio) * (1 + Exhibition.tierBonus(listing.tier))
			table.insert(options, { slot = slot, weight = weight })
			total += weight
		end
	end
	if #options == 0 then
		return nil
	end
	local roll = rng:NextNumber() * total
	for _, option in ipairs(options) do
		roll -= option.weight
		if roll <= 0 then
			return option.slot
		end
	end
	return options[#options].slot
end

-- API pública --------------------------------------------------------------------------
function VisitorService.attach(plot, owner)
	loadFriends(owner)
	local exitFromHub = table.clone(plot.exitRoute)
	table.remove(exitFromHub, 1)
	plot.exitFromHub = exitFromHub
	states[plot.index] = {
		plot = plot,
		owner = owner,
		timer = 0,
		visitors = {},
		reserved = {},
		queue = {},
	}
end

function VisitorService.detach(plot)
	local state = states[plot.index]
	states[plot.index] = nil
	if state then
		for visitor in pairs(state.visitors) do
			if visitor.model.Parent then
				visitor.model:Destroy()
			end
		end
		friendsOf[state.owner] = nil
	end
	plot.visitorsFolder:ClearAllChildren()
end

function VisitorService.start()
	RunService.Heartbeat:Connect(function(dt)
		for _, state in pairs(states) do
			local profile = VisitorService.getProfile(state.owner)
			if profile then
				local levels = profile.upgrades
				local count = 0
				for _ in pairs(state.visitors) do
					count += 1
				end
				-- En el tutorial el primer visitante llega enseguida.
				local interval = VisitorService.isTutorial(state.owner) and 4 or Config.buyerInterval(levels)
				state.timer += dt
				if count < Config.maxBuyers(levels) and state.timer >= interval then
					local slot = chooseListing(state)
					if slot then
						state.timer = 0
						state.reserved[slot] = true
						task.spawn(runVisitor, state, slot)
					else
						state.timer = interval * 0.7
					end
				end
			end
		end
	end)
end

return VisitorService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">WorldBuilder</string>
            <string name="Source"><![CDATA[-- Construye el terreno privado de cada jugador: galería y taller conectados,
-- jardín, estanque, fuente, calle y bosque alrededor. Todo por código, sin
-- assets externos. Cada jugador tiene su propio terreno, lejos de los demás.

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Exhibition = require(Shared.Exhibition)

local WorldBuilder = {}

local LOT_SPACING = 3000
local FLOOR = 2
local CEILING = 22

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local COLORS = {
	plaster = rgb(244, 243, 239),
	plasterShade = rgb(234, 233, 229),
	trim = rgb(226, 226, 222),
	stone = rgb(196, 196, 192),
	galleryFloor = rgb(206, 172, 132),
	workshopFloor = rgb(184, 184, 180),
	brick = rgb(236, 234, 228),
	charcoal = rgb(44, 48, 56),
	cladding = rgb(168, 120, 80),
	claddingDark = rgb(110, 76, 50),
	wood = rgb(190, 146, 104),
	darkWood = rgb(96, 70, 50),
	gold = rgb(214, 172, 96),
	brass = rgb(196, 160, 100),
	cream = rgb(250, 248, 242),
	glass = rgb(196, 220, 236),
	leaf = rgb(96, 160, 84),
	hedge = rgb(66, 124, 70),
	path = rgb(214, 212, 206),
	asphalt = rgb(70, 72, 80),
	workshopAccent = rgb(40, 150, 140),
}
local FLOWERS = {
	rgb(250, 250, 246),
	rgb(255, 214, 92),
	rgb(150, 132, 220),
	rgb(110, 150, 230),
}
local RAINBOW = {
	rgb(255, 90, 110),
	rgb(255, 170, 60),
	rgb(255, 225, 80),
	rgb(110, 220, 120),
	rgb(90, 170, 255),
	rgb(180, 120, 255),
}

-- Utilidades ---------------------------------------------------------------------------
local function part(props)
	local p = Instance.new(props.Class or "Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for key, value in pairs(props) do
		if key ~= "Class" and key ~= "Parent" then
			p[key] = value
		end
	end
	p.Parent = props.Parent
	return p
end

local function cylinderUp(cf)
	return cf * CFrame.Angles(0, 0, math.rad(90))
end

local function addLight(parent, class, props)
	local light = Instance.new(class)
	for key, value in pairs(props) do
		light[key] = value
	end
	light.Parent = parent
	return light
end

local function surfaceText(parentPart, face, text, props)
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = props.pps or 40
	gui.LightInfluence = props.lightInfluence or 0
	gui.Parent = parentPart
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = props.font or Enum.Font.FredokaOne
	label.Text = text
	label.TextScaled = true
	label.TextColor3 = props.color or Color3.new(1, 1, 1)
	label.Parent = gui
	local padding = Instance.new("UIPadding")
	padding.PaddingLeft = UDim.new(0.05, 0)
	padding.PaddingRight = UDim.new(0.05, 0)
	padding.PaddingTop = UDim.new(0.12, 0)
	padding.PaddingBottom = UDim.new(0.12, 0)
	padding.Parent = label
	if props.stroke then
		local stroke = Instance.new("UIStroke")
		stroke.Color = props.stroke
		stroke.Thickness = props.strokeThickness or 3
		stroke.Parent = label
	end
	return label
end

local function prompt(parent, action, object, distance)
	local p = Instance.new("ProximityPrompt")
	p.ActionText = action
	p.ObjectText = object
	p.HoldDuration = 0
	p.MaxActivationDistance = distance or 12
	p.RequiresLineOfSight = false
	p.Parent = parent
	return p
end

-- Ambiente global -----------------------------------------------------------------------
local lightingReady = false
local function setupLighting()
	if lightingReady then
		return
	end
	lightingReady = true
	Lighting.ClockTime = 14.8
	Lighting.GeographicLatitude = 30
	Lighting.Brightness = 3
	Lighting.Ambient = rgb(112, 114, 120)
	Lighting.OutdoorAmbient = rgb(142, 146, 154)
	Lighting.EnvironmentDiffuseScale = 1
	Lighting.EnvironmentSpecularScale = 1
	Lighting.GlobalShadows = true
	Lighting.ShadowSoftness = 0.2
	for _, child in ipairs(Lighting:GetChildren()) do
		if child:IsA("PostEffect") or child:IsA("Atmosphere") then
			child:Destroy()
		end
	end
	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Density = 0.3
	atmosphere.Offset = 0.2
	atmosphere.Color = rgb(200, 212, 226)
	atmosphere.Decay = rgb(110, 124, 146)
	atmosphere.Glare = 0.25
	atmosphere.Haze = 1.4
	atmosphere.Parent = Lighting
	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.5
	bloom.Size = 24
	bloom.Threshold = 1.5
	bloom.Parent = Lighting
	local color = Instance.new("ColorCorrectionEffect")
	color.Saturation = 0.06
	color.Contrast = 0.06
	color.Brightness = 0.02
	color.TintColor = rgb(255, 250, 244)
	color.Parent = Lighting
	local rays = Instance.new("SunRaysEffect")
	rays.Intensity = 0.05
	rays.Spread = 0.7
	rays.Parent = Lighting
	local depth = Instance.new("DepthOfFieldEffect")
	depth.FarIntensity = 0.12
	depth.FocusDistance = 120
	depth.InFocusRadius = 140
	depth.NearIntensity = 0
	depth.Parent = Lighting

	local terrain = Workspace.Terrain
	terrain.WaterColor = rgb(80, 170, 200)
	terrain.WaterTransparency = 0.6
	terrain.WaterWaveSize = 0.08
	terrain.WaterReflectance = 0.4
	if not terrain:FindFirstChildOfClass("Clouds") then
		local clouds = Instance.new("Clouds")
		clouds.Cover = 0.55
		clouds.Density = 0.6
		clouds.Color = rgb(250, 252, 255)
		clouds.Parent = terrain
	end
end

-- Elementos reutilizables ------------------------------------------------------------------
local function buildTree(parent, cf, scale, rng, autumn)
	local model = Instance.new("Model")
	model.Name = "Tree"
	local trunkHeight = 9 * scale
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(trunkHeight, 1.8 * scale, 1.8 * scale),
		CFrame = cylinderUp(cf * CFrame.new(0, trunkHeight / 2, 0)),
		Color = rgb(112, 76, 56),
		Material = Enum.Material.Wood,
		Parent = model,
	})
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(1.2 * scale, 2.8 * scale, 2.8 * scale),
		CFrame = cylinderUp(cf * CFrame.new(0, 0.5 * scale, 0)),
		Color = rgb(98, 66, 48),
		Material = Enum.Material.Wood,
		Parent = model,
	})
	local base = autumn and rgb(214, 150, 70) or COLORS.leaf
	for i = 1, 5 do
		local size = (5.5 + rng:NextNumber() * 3) * scale
		local offset = Vector3.new(
			rng:NextNumber(-2.4, 2.4),
			trunkHeight + rng:NextNumber(-1, 3),
			rng:NextNumber(-2.4, 2.4)
		) * scale
		if i == 1 then
			offset = Vector3.new(0, trunkHeight + 2 * scale, 0)
			size = 8 * scale
		end
		part({
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(size, size, size),
			CFrame = cf * CFrame.new(offset),
			Color = base:Lerp(rgb(255, 255, 255), rng:NextNumber() * 0.15)
				:Lerp(rgb(30, 80, 40), rng:NextNumber() * 0.15),
			Material = Enum.Material.LeafyGrass,
			CanCollide = false,
			Parent = model,
		})
	end
	model.Parent = parent
end

local function buildBush(parent, cf, scale, color)
	for i = 1, 3 do
		local angle = i * 2.1
		local size = (2.6 + i * 0.3) * scale
		part({
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(size, size, size),
			CFrame = cf * CFrame.new(math.cos(angle) * 0.9 * scale, size * 0.35, math.sin(angle) * 0.9 * scale),
			Color = color or COLORS.leaf:Lerp(rgb(30, 90, 40), i * 0.08),
			Material = Enum.Material.LeafyGrass,
			CanCollide = false,
			Parent = parent,
		})
	end
end

local function buildLampPost(parent, cf)
	-- Farola moderna: poste fino y cabezal plano.
	part({
		Size = Vector3.new(1.4, 0.4, 1.4),
		CFrame = cf * CFrame.new(0, 0.2, 0),
		Color = COLORS.charcoal,
		Material = Enum.Material.Metal,
		Parent = parent,
	})
	part({
		Size = Vector3.new(0.45, 12, 0.45),
		CFrame = cf * CFrame.new(0, 6.2, 0),
		Color = COLORS.charcoal,
		Material = Enum.Material.Metal,
		Parent = parent,
	})
	part({
		Size = Vector3.new(2.6, 0.35, 0.9),
		CFrame = cf * CFrame.new(0.9, 12.3, 0),
		Color = COLORS.charcoal,
		Material = Enum.Material.Metal,
		Parent = parent,
	})
	local lens = part({
		Size = Vector3.new(2, 0.1, 0.6),
		CFrame = cf * CFrame.new(1, 12.1, 0),
		Color = rgb(255, 236, 206),
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = parent,
	})
	addLight(lens, "SpotLight", {
		Face = Enum.NormalId.Bottom,
		Angle = 80,
		Range = 18,
		Brightness = 1.2,
		Color = rgb(255, 226, 190),
		Shadows = false,
	})
end

local function buildBench(parent, cf)
	-- Banco de roble sobre dos bloques de hormigón.
	for _, x in ipairs({ -2.3, 2.3 }) do
		part({
			Size = Vector3.new(1.2, 1.7, 2.2),
			CFrame = cf * CFrame.new(x, 0.85, 0),
			Color = COLORS.stone,
			Material = Enum.Material.Concrete,
			Parent = parent,
		})
	end
	for i = 0, 3 do
		part({
			Size = Vector3.new(6.4, 0.35, 0.5),
			CFrame = cf * CFrame.new(0, 1.85, -0.84 + i * 0.56),
			Color = COLORS.wood,
			Material = Enum.Material.Wood,
			Parent = parent,
		})
	end
end

local function buildFlowerBed(parent, cf, width, depth, rng)
	part({
		Size = Vector3.new(width + 0.8, 1, depth + 0.8),
		CFrame = cf * CFrame.new(0, 0.5, 0),
		Color = COLORS.stone,
		Material = Enum.Material.Concrete,
		Parent = parent,
	})
	part({
		Size = Vector3.new(width, 0.3, depth),
		CFrame = cf * CFrame.new(0, 1.05, 0),
		Color = rgb(96, 66, 50),
		Material = Enum.Material.Ground,
		Parent = parent,
	})
	local count = math.floor(width * depth / 2.2)
	for _ = 1, count do
		local x = rng:NextNumber(-width / 2 + 0.6, width / 2 - 0.6)
		local z = rng:NextNumber(-depth / 2 + 0.6, depth / 2 - 0.6)
		local h = rng:NextNumber(0.8, 1.6)
		part({
			Size = Vector3.new(0.18, h, 0.18),
			CFrame = cf * CFrame.new(x, 1.2 + h / 2, z),
			Color = rgb(80, 160, 80),
			CanCollide = false,
			CastShadow = false,
			Parent = parent,
		})
		part({
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(0.8, 0.8, 0.8),
			CFrame = cf * CFrame.new(x, 1.3 + h, z),
			Color = FLOWERS[rng:NextInteger(1, #FLOWERS)],
			CanCollide = false,
			CastShadow = false,
			Parent = parent,
		})
	end
end

local function buildPlant(parent, cf, scale)
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(2.6 * scale, 2.6 * scale, 2.6 * scale),
		CFrame = cylinderUp(cf * CFrame.new(0, 1.3 * scale, 0)),
		Color = rgb(222, 220, 214),
		Material = Enum.Material.Concrete,
		Parent = parent,
	})
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.4 * scale, 2.9 * scale, 2.9 * scale),
		CFrame = cylinderUp(cf * CFrame.new(0, 2.6 * scale, 0)),
		Color = rgb(206, 204, 198),
		Material = Enum.Material.Concrete,
		Parent = parent,
	})
	for i = 1, 4 do
		local angle = i * 1.7
		part({
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(2.6, 2.6, 2.6) * scale,
			CFrame = cf
				* CFrame.new(math.cos(angle) * 0.7 * scale, (3.2 + i * 0.7) * scale, math.sin(angle) * 0.7 * scale),
			Color = rgb(80 + i * 12, 172 + i * 8, 96),
			Material = Enum.Material.LeafyGrass,
			CanCollide = false,
			Parent = parent,
		})
	end
end

local function buildFountain(parent, cf)
	-- Estanque rectangular de hormigón con tres surtidores bajos.
	local edge = COLORS.stone
	part({
		Size = Vector3.new(18, 1.2, 10),
		CFrame = cf * CFrame.new(0, 0.6, 0),
		Color = edge,
		Material = Enum.Material.Concrete,
		Parent = parent,
	})
	part({
		Size = Vector3.new(16.6, 0.2, 8.6),
		CFrame = cf * CFrame.new(0, 1.15, 0),
		Color = rgb(96, 150, 180),
		Material = Enum.Material.Glass,
		Transparency = 0.15,
		Reflectance = 0.2,
		CanCollide = false,
		Parent = parent,
	})
	for _, x in ipairs({ -5, 0, 5 }) do
		local jet = part({
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.3, 0.6, 0.6),
			CFrame = cylinderUp(cf * CFrame.new(x, 1.3, 0)),
			Color = COLORS.charcoal,
			Material = Enum.Material.Metal,
			CanCollide = false,
			Parent = parent,
		})
		local water = Instance.new("ParticleEmitter")
		water.Rate = 24
		water.Lifetime = NumberRange.new(0.6, 0.8)
		water.Speed = NumberRange.new(5, 6)
		water.SpreadAngle = Vector2.new(6, 6)
		water.Acceleration = Vector3.new(0, -20, 0)
		water.LightEmission = 0.2
		water.Transparency = NumberSequence.new(0.35, 1)
		water.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 0.12) })
		water.Color = ColorSequence.new(rgb(220, 240, 255), rgb(170, 210, 240))
		water.EmissionDirection = Enum.NormalId.Top
		water.Parent = jet
	end
end

local function buildEasel(parent, cf, scale)
	scale = scale or 1
	local model = Instance.new("Model")
	model.Name = "Easel"
	for _, x in ipairs({ -1.9, 1.9 }) do
		part({
			Size = Vector3.new(0.45, 11, 0.45) * scale,
			CFrame = cf
				* CFrame.new(x * scale, 5.5 * scale, 0)
				* CFrame.Angles(math.rad(-8), 0, math.rad(x > 0 and 8 or -8)),
			Color = COLORS.wood,
			Material = Enum.Material.Wood,
			Parent = model,
		})
	end
	part({
		Size = Vector3.new(0.45, 10, 0.45) * scale,
		CFrame = cf * CFrame.new(0, 5 * scale, 1.6 * scale) * CFrame.Angles(math.rad(14), 0, 0),
		Color = COLORS.wood,
		Material = Enum.Material.Wood,
		Parent = model,
	})
	part({
		Size = Vector3.new(6.4, 0.45, 1) * scale,
		CFrame = cf * CFrame.new(0, 4.2 * scale, -0.55 * scale),
		Color = COLORS.wood,
		Material = Enum.Material.Wood,
		Parent = model,
	})
	part({
		Size = Vector3.new(6.4, 6.4, 0.3) * scale,
		CFrame = cf * CFrame.new(0, 7.75 * scale, -0.3 * scale) * CFrame.Angles(math.rad(-8), 0, 0),
		Color = rgb(236, 226, 206),
		Parent = model,
	})
	local canvas = part({
		Name = "Canvas",
		Size = Vector3.new(6, 6, 0.2) * scale,
		CFrame = cf * CFrame.new(0, 7.75 * scale, -0.5 * scale) * CFrame.Angles(math.rad(-8), 0, 0),
		Color = COLORS.cream,
		Parent = model,
	})
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.2, 2.8, 2.8) * scale,
		CFrame = cf * CFrame.new(3 * scale, 4.6 * scale, -0.8 * scale) * CFrame.Angles(0, math.rad(90), 0),
		Color = rgb(230, 190, 140),
		Material = Enum.Material.Wood,
		Parent = model,
	})
	for i, color in ipairs(RAINBOW) do
		local angle = i * 0.9
		part({
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(0.5, 0.5, 0.5) * scale,
			CFrame = cf * CFrame.new(
				(3 + math.cos(angle) * 0.85) * scale,
				(4.6 + math.sin(angle) * 0.85) * scale,
				-0.95 * scale
			),
			Color = color,
			CanCollide = false,
			Parent = model,
		})
	end
	model.Parent = parent
	return canvas
end

-- Paredes con huecos -------------------------------------------------------------------------
-- openings: { { a, b, y0, y1 } } (a < b sobre el eje de la pared).
local function wall(parent, L, axis, fixed, from, to, y0, y1, thickness, openings, color, material)
	table.sort(openings, function(p, q)
		return p[1] < q[1]
	end)
	local function piece(a, b, ya, yb)
		if b - a < 0.01 or yb - ya < 0.01 then
			return
		end
		local size, cf
		if axis == "x" then
			size = Vector3.new(b - a, yb - ya, thickness)
			cf = L((a + b) / 2, (ya + yb) / 2, fixed)
		else
			size = Vector3.new(thickness, yb - ya, b - a)
			cf = L(fixed, (ya + yb) / 2, (a + b) / 2)
		end
		part({ Size = size, CFrame = cf, Color = color, Material = material or Enum.Material.Plaster, Parent = parent })
	end
	local cursor = from
	for _, o in ipairs(openings) do
		piece(cursor, o[1], y0, y1)
		piece(o[1], o[2], y0, math.max(y0, o[3]))
		piece(o[1], o[2], math.min(y1, o[4]), y1)
		cursor = o[2]
	end
	piece(cursor, to, y0, y1)
end

-- Decoraciones que aparecen con la mejora "Decoración" ----------------------------------------
local function topiary(parent, cf, height)
	part({
		Size = Vector3.new(3, 2.4, 3),
		CFrame = cf * CFrame.new(0, 1.2, 0),
		Color = COLORS.charcoal,
		Material = Enum.Material.Concrete,
		Parent = parent,
	})
	for i = 0, 2 do
		local size = (2.6 - i * 0.6) * height / 6
		part({
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(size * 1.3, size * 1.6, size * 1.3),
			CFrame = cf * CFrame.new(0, 3 + i * height / 4, 0),
			Color = COLORS.hedge:Lerp(COLORS.leaf, i * 0.15),
			Material = Enum.Material.LeafyGrass,
			CanCollide = false,
			Parent = parent,
		})
	end
end

