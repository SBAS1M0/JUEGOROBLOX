        <Item class="Folder" referent="18">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="19">
            <Properties>
              <string name="Name">ColorPicker</string>
              <string name="Source"><![CDATA[-- Ventana "Elige tus colores": un color por área antes de empezar a pintar.
-- Los colores raros multiplican el valor del cuadro.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Colors = require(Shared.Colors)
local Config = require(Shared.Config)

local Theme = require(script.Parent.Theme)
local DesignArt = require(script.Parent.DesignArt)

local ColorPicker = {}

local C = Theme.Colors

local app
local window
local refs = {}
local design
local choices = {}
local selectedArea
local preview
local areaRows = {}
local remembered = {}
local busy = false

local function owned(colorId)
	local entry = Colors.ById[colorId]
	if entry and entry.basic then
		return math.huge
	end
	return app.state and app.state.paints[colorId] or 0
end

-- Unidades libres de un color sin contar el área seleccionada.
local function remaining(colorId, exceptArea)
	local used = 0
	for areaId, chosen in pairs(choices) do
		if chosen == colorId and areaId ~= exceptArea then
			used += 1
		end
	end
	return owned(colorId) - used
end

local function colorRarityText(colorId)
	local entry = Colors.ById[colorId]
	local rarity = Colors.rarityOf(entry)
	return rarity.name .. " x" .. string.format("%.1f", rarity.mult), rarity.color
end

local function updateValue()
	if not design then
		return
	end
	local state = app.state
	local mult = Config.colorMultiplier(design, choices)
	local value = Config.paintingValue(design, choices, state.upgrades, state.made[design.id] or 0)
	refs.value.Text = string.format("Valor del cuadro x%.2f  ·  💵 %s", mult, Theme.formatNumber(value))
	preview.setColors(choices)
end

local function refreshAreas()
	for _, row in pairs(areaRows) do
		local areaId = row.area.id
		local selected = areaId == selectedArea
		row.frame.BackgroundColor3 = selected and C.YellowSoft or C.Panel
		row.stroke.Thickness = selected and 2.5 or 0
		DesignArt.swatch(row.swatch, choices[areaId])
		local entry = Colors.ById[choices[areaId]]
		row.colorName.Text = entry and entry.name or ""
		local _, rarityColor = colorRarityText(choices[areaId])
		row.colorName.TextColor3 = entry and entry.basic and C.InkSoft or rarityColor
	end
end

local function sortedColors()
	local list = {}
	for _, entry in ipairs(Colors.List) do
		if not entry.basic and owned(entry.id) > 0 then
			table.insert(list, entry)
		end
	end
	table.sort(list, function(a, b)
		local ra, rb = Colors.rarityOf(a).index, Colors.rarityOf(b).index
		if ra ~= rb then
			return ra > rb
		end
		return a.index < b.index
	end)
	for _, entry in ipairs(Colors.List) do
		if entry.basic then
			table.insert(list, entry)
		end
	end
	return list
end

local function refreshColors()
	local area = design.areaById[selectedArea]
	refs.colorsTitle.Text = "Pintura para «" .. area.name .. "»"
	for _, child in ipairs(refs.grid:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	for order, entry in ipairs(sortedColors()) do
		local free = remaining(entry.id, selectedArea)
		local selected = choices[selectedArea] == entry.id
		local cell = Theme.new("TextButton", {
			Name = entry.id,
			BackgroundColor3 = selected and C.YellowSoft or C.Panel,
			BackgroundTransparency = selected and 0 or 1,
			AutoButtonColor = false,
			Text = "",
			LayoutOrder = order,
			Parent = refs.grid,
		}, { Theme.corner(14) })
		Theme.stroke(C.Yellow, selected and 2.5 or 0).Parent = cell
		local swatch = Theme.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0, 6),
			Size = UDim2.fromOffset(60, 60),
			Parent = cell,
		}, { Theme.corner(30) })
		DesignArt.swatch(swatch, entry.id)
		local rarityText, rarityColor = colorRarityText(entry.id)
		Theme.stroke(entry.basic and Color3.fromRGB(235, 225, 215) or rarityColor, 3).Parent = swatch
		Theme.label({
			Size = UDim2.new(1, -6, 0, 20),
			Position = UDim2.fromOffset(3, 70),
			Text = entry.name,
			MaxTextSize = 18,
			Parent = cell,
		})
		Theme.label({
			Size = UDim2.new(1, -6, 0, 16),
			Position = UDim2.fromOffset(3, 90),
			Text = entry.basic and "Básico · ∞" or (rarityText .. " · x" .. owned(entry.id)),
			TextColor3 = entry.basic and C.InkSoft or rarityColor,
			MaxTextSize = 15,
			Parent = cell,
		})
		if free <= 0 and not selected then
			cell.BackgroundTransparency = 1
			swatch.BackgroundTransparency = 0.6
		end
		cell.Activated:Connect(function()
			if remaining(entry.id, selectedArea) <= 0 then
				app.notify("Ya usaste todo tu «" .. entry.name .. "» 🎨", "error")
				return
			end
			Theme.playSound("click", 1.2)
			choices[selectedArea] = entry.id
			-- Pasa a la siguiente área automáticamente.
			local index = design.areaById[selectedArea].index
			local nextArea = design.areas[index + 1]
			if nextArea then
				selectedArea = nextArea.id
			end
			refreshAreas()
			refreshColors()
			updateValue()
		end)
	end
end

local function build(parent)
	-- Izquierda: vista previa y áreas.
	local previewBox = Theme.new("Frame", {
		Position = UDim2.fromOffset(60, 98),
		Size = UDim2.fromOffset(240, 240),
		BackgroundColor3 = C.Panel,
		Parent = parent,
	}, { Theme.corner(18), Theme.stroke(Color3.fromRGB(240, 230, 220), 3) })
	refs.previewBox = Theme.new(
		"Frame",
		{ Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = previewBox },
		{
			Theme.corner(18),
		}
	)
	refs.areas = Theme.new("ScrollingFrame", {
		Position = UDim2.fromOffset(24, 352),
		Size = UDim2.new(0, 316, 1, -372),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 5,
		ScrollBarImageColor3 = C.InkSoft,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = parent,
	}, {
		Theme.new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
		Theme.new(
			"UIPadding",
			{ PaddingTop = UDim.new(0, 3), PaddingLeft = UDim.new(0, 3), PaddingRight = UDim.new(0, 10) }
		),
	})

	-- Derecha: colores.
	refs.colorsTitle = Theme.label({
		Position = UDim2.fromOffset(372, 100),
		Size = UDim2.new(1, -400, 0, 30),
		Text = "",
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 26,
		Parent = parent,
	})
	refs.grid = Theme.new("ScrollingFrame", {
		Position = UDim2.fromOffset(366, 136),
		Size = UDim2.new(1, -390, 1, -236),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = C.InkSoft,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = parent,
	}, {
		Theme.new("UIGridLayout", {
			CellSize = UDim2.fromOffset(112, 112),
			CellPadding = UDim2.fromOffset(6, 6),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
		Theme.new("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingLeft = UDim.new(0, 4) }),
	})
	refs.value = Theme.label({
		Position = UDim2.new(0, 372, 1, -78),
		Size = UDim2.new(1, -640, 0, 56),
		Text = "",
		TextColor3 = C.PrimaryDark,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 24,
		Parent = parent,
	})
	refs.continue = Theme.button({
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -24, 1, -22),
		Size = UDim2.fromOffset(220, 56),
		Text = "Continuar",
		Soft = true,
		Color = C.Mint,
		Parent = parent,
		OnClick = function()
			ColorPicker.confirm()
		end,
	})
end

function ColorPicker.open(newDesign)
	design = newDesign
	choices = {}
	local saved = remembered[design.id] or {}
	for _, area in ipairs(design.areas) do
		local colorId = saved[area.id]
		if not colorId or owned(colorId) <= 0 then
			colorId = area.default
		end
		choices[area.id] = colorId
	end
	-- Si guardamos más usos de un color de los que hay, volvemos al básico.
	for _, area in ipairs(design.areas) do
		if remaining(choices[area.id], nil) < 0 then
			choices[area.id] = area.default
		end
	end
	selectedArea = design.areas[1].id

	window.Title.Text = "Elige tus colores · " .. design.name
	window.Subtitle.Text = "Este cuadro tiene "
		.. #design.areas
		.. " áreas. Cada área toma el color de su pintura: ¡los colores raros valen más!"
	preview = DesignArt.render(refs.previewBox, design, { mode = "color", colors = choices, outline = false })

	for _, row in pairs(areaRows) do
		row.frame:Destroy()
	end
	areaRows = {}
	for _, area in ipairs(design.areas) do
		local frame = Theme.new("TextButton", {
			Size = UDim2.new(1, 0, 0, 46),
			BackgroundColor3 = C.Panel,
			AutoButtonColor = false,
			Text = "",
			LayoutOrder = area.index,
			Parent = refs.areas,
		}, { Theme.corner(12) })
		local stroke = Theme.stroke(C.Yellow, 0)
		stroke.Parent = frame
		local swatch = Theme.new("Frame", {
			Position = UDim2.fromOffset(10, 8),
			Size = UDim2.fromOffset(30, 30),
			Parent = frame,
		}, { Theme.corner(15), Theme.stroke(Color3.fromRGB(235, 225, 215), 2) })
		Theme.label({
			Position = UDim2.fromOffset(50, 6),
			Size = UDim2.new(0.5, -40, 1, -12),
			Text = area.name,
			TextXAlignment = Enum.TextXAlignment.Left,
			MaxTextSize = 21,
			Parent = frame,
		})
		local colorName = Theme.label({
			Position = UDim2.new(0.5, 0, 0, 8),
			Size = UDim2.new(0.5, -10, 1, -16),
			Text = "",
			TextXAlignment = Enum.TextXAlignment.Right,
			MaxTextSize = 17,
			Parent = frame,
		})
		frame.Activated:Connect(function()
			Theme.playSound("click", 1.1)
			selectedArea = area.id
			refreshAreas()
			refreshColors()
		end)
		areaRows[area.id] = { area = area, frame = frame, stroke = stroke, swatch = swatch, colorName = colorName }
	end

	refreshAreas()
	refreshColors()
	updateValue()
	window.Open()
end

function ColorPicker.refresh()
	if design and window.Holder.Visible then
		refreshColors()
		updateValue()
	end
end

function ColorPicker.confirm()
	if busy or not design then
		return
	end
	busy = true
	local ok, success, message = pcall(function()
		return app.remotes.StartPainting:InvokeServer(design.id, choices)
	end)
	busy = false
	if ok and success then
		remembered[design.id] = table.clone(choices)
		window.Close()
		app.openPainter(design, choices)
	else
		app.notify(ok and message or "No se pudo empezar.", "error")
	end
end

function ColorPicker.init(appRef)
	app = appRef
	local gui = Theme.new("ScreenGui", {
		Name = "ColorPicker",
		ResetOnSpawn = false,
		DisplayOrder = 13,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = Players.LocalPlayer:WaitForChild("PlayerGui"),
	})
	window = Theme.window({
		Name = "Window",
		Parent = gui,
		Size = UDim2.fromOffset(1000, 640),
		Title = "Elige tus colores",
	})
	build(window.Panel)
end

return ColorPicker
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="20">
            <Properties>
              <string name="Name">DesignArt</string>
              <string name="Source"><![CDATA[-- Dibuja un diseño (figuras) dentro de un Frame cuadrado.
-- mode = "color": cuadro terminado. mode = "lineart": líneas para colorear,
-- cada figura se va rellenando de abajo arriba con setProgress.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Colors = require(Shared.Colors)
local Designs = require(Shared.Designs)

local DesignArt = {}

local LINE_COLOR = Color3.fromRGB(236, 150, 186)

local function applyColor(frame, gradient, colorId)
	local entry = Colors.ById[colorId]
	if entry and entry.gradient then
		frame.BackgroundColor3 = Color3.new(1, 1, 1)
		gradient.Color = Colors.sequence(colorId)
	else
		frame.BackgroundColor3 = entry and entry.color or Color3.new(1, 1, 1)
		gradient.Color = ColorSequence.new(Color3.new(1, 1, 1))
	end
end

local function revealSequence(p)
	if p >= 1 then
		return NumberSequence.new(0)
	end
	if p <= 0 then
		return NumberSequence.new(1)
	end
	local edge = math.min(p + 0.05, 1)
	if edge >= 1 then
		return NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(p, 0),
			NumberSequenceKeypoint.new(1, 1),
		})
	end
	return NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(p, 0),
		NumberSequenceKeypoint.new(edge, 1),
		NumberSequenceKeypoint.new(1, 1),
	})
end

function DesignArt.render(container, design, opts)
	opts = opts or {}
	local old = container:FindFirstChild("Art")
	if old then
		old:Destroy()
	end
	local mode = opts.mode or "color"
	local colors = opts.colors or Designs.defaultColors(design)
	local zindex = opts.zindex or container.ZIndex
	local stroke = opts.stroke or 2

	local holder = Instance.new("Frame")
	holder.Name = "Art"
	holder.Size = UDim2.fromScale(1, 1)
	holder.BackgroundTransparency = 1
	holder.ClipsDescendants = true
	holder.ZIndex = zindex

	local handle = { shapes = {}, design = design, holder = holder }

	for i, shape in ipairs(design.shapes) do
		local base = Instance.new("Frame")
		base.Name = "S" .. i
		base.AnchorPoint = Vector2.new(0.5, 0.5)
		base.Position = UDim2.fromScale(shape.x, shape.y)
		base.Size = UDim2.fromScale(shape.w, shape.h)
		base.Rotation = shape.rot
		base.BorderSizePixel = 0
		base.ZIndex = zindex
		if shape.r > 0 then
			local corner = Instance.new("UICorner")
			corner.CornerRadius = UDim.new(shape.r, 0)
			corner.Parent = base
		end

		local entry = { shape = shape, base = base }
		if mode == "lineart" then
			base.BackgroundColor3 = Color3.new(1, 1, 1)
			local line = Instance.new("UIStroke")
			line.Color = LINE_COLOR
			line.Thickness = stroke
			line.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
			line.Parent = base

			local fill = Instance.new("Frame")
			fill.Name = "Fill"
			fill.Size = UDim2.fromScale(1, 1)
			fill.BorderSizePixel = 0
			fill.ZIndex = zindex
			if shape.r > 0 then
				local corner = Instance.new("UICorner")
				corner.CornerRadius = UDim.new(shape.r, 0)
				corner.Parent = fill
			end
			local gradient = Instance.new("UIGradient")
			gradient.Rotation = -90
			gradient.Transparency = revealSequence(0)
			gradient.Parent = fill
			applyColor(fill, gradient, colors[shape.area])
			fill.Parent = base
			entry.fill = fill
			entry.gradient = gradient
			entry.progress = 0
		else
			local gradient = Instance.new("UIGradient")
			gradient.Rotation = 35
			gradient.Parent = base
			applyColor(base, gradient, colors[shape.area])
			entry.gradient = gradient
			if opts.outline ~= false then
				local line = Instance.new("UIStroke")
				line.Color = Colors.mainColor(colors[shape.area]):Lerp(Color3.new(0, 0, 0), 0.25)
				line.Thickness = opts.outlineThickness or 1
				line.Transparency = 0.55
				line.Parent = base
			end
		end
		base.Parent = holder
		handle.shapes[i] = entry
	end

	function handle.setProgress(i, p)
		local entry = handle.shapes[i]
		if entry and entry.gradient and entry.fill then
			entry.progress = p
			entry.gradient.Transparency = revealSequence(p)
		end
	end

	function handle.setColors(newColors)
		colors = newColors
		for _, entry in ipairs(handle.shapes) do
			local target = entry.fill or entry.base
			applyColor(target, entry.gradient, newColors[entry.shape.area])
		end
	end

	holder.Parent = container
	return handle
end

-- Muestra de color redonda (soporta degradados).
function DesignArt.swatch(frame, colorId)
	local gradient = frame:FindFirstChild("SwatchGradient")
	if not gradient then
		gradient = Instance.new("UIGradient")
		gradient.Name = "SwatchGradient"
		gradient.Rotation = 35
		gradient.Parent = frame
	end
	applyColor(frame, gradient, colorId)
end

return DesignArt
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="21">
            <Properties>
              <string name="Name">DesignPicker</string>
              <string name="Source"><![CDATA[-- Ventana "Elige un diseño": diseños por niveles, desbloqueos y maestría.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Designs = require(Shared.Designs)

local Theme = require(script.Parent.Theme)
local DesignArt = require(script.Parent.DesignArt)

local DesignPicker = {}

local C = Theme.Colors
local MEDALS = { bronce = "🥉", plata = "🥈", oro = "🥇" }

local app
local window
local list
local cards = {}
local detail = {}
local selectedId = "globo"
local busy = false

local function stateOf(design)
	local state = app.state
	if not state then
		return "closed"
	end
	if state.unlocked[design.id] then
		return "unlocked"
	end
	if Designs.isLevelOpen(design.level, state.made) then
		return "buyable"
	end
	return "closed"
end

local function masteryText(made)
	local tier, nextTier = Config.masteryFor(made)
	local medal = tier and MEDALS[tier.id] or "⚪"
	return medal, tier, nextTier
end

local function averageValue(level)
	local total, count = 0, 0
	for _, design in ipairs(Designs.Levels[level]) do
		total += design.value
		count += 1
	end
	return math.floor(total / math.max(count, 1))
end

-- Tarjetas ----------------------------------------------------------------------------------
local function buildCard(design, parent)
	local card = Theme.new("TextButton", {
		Name = design.id,
		Size = UDim2.fromOffset(138, 176),
		BackgroundColor3 = C.Panel,
		AutoButtonColor = false,
		Text = "",
		LayoutOrder = design.index,
		Parent = parent,
	}, { Theme.corner(18) })
	local stroke = Theme.stroke(C.Yellow, 0)
	stroke.Parent = card
	local artBox = Theme.new("Frame", {
		Size = UDim2.fromOffset(104, 104),
		Position = UDim2.fromOffset(17, 10),
		BackgroundColor3 = C.PanelSoft,
		Parent = card,
	}, { Theme.corner(16) })
	local art = Theme.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = artBox,
	}, { Theme.corner(16) })
	DesignArt.render(art, design, { mode = "color", outline = false })
	local mystery = Theme.label({
		Size = UDim2.fromScale(1, 1),
		Text = "?",
		TextColor3 = C.InkSoft,
		MaxTextSize = 64,
		Visible = false,
		Parent = artBox,
	})
	local name = Theme.label({
		Size = UDim2.new(1, -10, 0, 24),
		Position = UDim2.fromOffset(5, 118),
		Text = design.name,
		MaxTextSize = 21,
		Parent = card,
	})
	local footer = Theme.new("Frame", {
		Size = UDim2.new(1, -20, 0, 24),
		Position = UDim2.fromOffset(10, 144),
		BackgroundTransparency = 1,
		Parent = card,
	})
	local medal = Theme.label({ Size = UDim2.fromOffset(24, 24), Text = "⚪", MaxTextSize = 20, Parent = footer })
	local barBack = Theme.new("Frame", {
		Size = UDim2.new(1, -66, 0, 8),
		Position = UDim2.new(0, 28, 0.5, -4),
		BackgroundColor3 = Color3.fromRGB(240, 234, 226),
		Parent = footer,
	}, { Theme.corner(4) })
	local bar = Theme.new(
		"Frame",
		{ Size = UDim2.fromScale(0, 1), BackgroundColor3 = C.Yellow, Parent = barBack },
		{ Theme.corner(4) }
	)
	local count = Theme.label({
		Size = UDim2.fromOffset(36, 24),
		Position = UDim2.new(1, -36, 0, 0),
		Text = "",
		TextColor3 = C.InkSoft,
		TextXAlignment = Enum.TextXAlignment.Right,
		MaxTextSize = 16,
		Parent = footer,
	})
	local price = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 142),
		Size = UDim2.fromOffset(96, 28),
		BackgroundColor3 = C.Panel,
		Visible = false,
		Parent = card,
	}, { Theme.corner(14), Theme.stroke(C.MintSoft, 2) })
	local priceLabel = Theme.label({
		Size = UDim2.fromScale(1, 1),
		Text = "",
		TextColor3 = C.PrimaryDark,
		MaxTextSize = 18,
		Parent = price,
	})

	card.Activated:Connect(function()
		Theme.playSound("click", 1.2)
		selectedId = design.id
		DesignPicker.refresh()
	end)

	cards[design.id] = {
		card = card,
		stroke = stroke,
		art = art,
		mystery = mystery,
		name = name,
		footer = footer,
		medal = medal,
		bar = bar,
		count = count,
		price = price,
		priceLabel = priceLabel,
	}
end

local function buildList(parent)
	list = Theme.new("ScrollingFrame", {
		Position = UDim2.fromOffset(24, 100),
		Size = UDim2.new(0, 630, 1, -120),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = C.InkSoft,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = parent,
	}, {
		Theme.new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
		Theme.new(
			"UIPadding",
			{ PaddingTop = UDim.new(0, 6), PaddingLeft = UDim.new(0, 6), PaddingBottom = UDim.new(0, 12) }
		),
	})
	for level = 1, Designs.MAX_LEVEL do
		local header = Theme.new("Frame", {
			Name = "Header" .. level,
			Size = UDim2.new(1, -16, 0, 34),
			BackgroundTransparency = 1,
			LayoutOrder = level * 2 - 1,
			Parent = list,
		})
		Theme.label({
			Size = UDim2.fromOffset(110, 34),
			Text = "Nivel " .. level,
			TextXAlignment = Enum.TextXAlignment.Left,
			MaxTextSize = 28,
			Parent = header,
		})
		Theme.label({
			Size = UDim2.fromOffset(240, 34),
			Position = UDim2.fromOffset(100, 0),
			Text = "💵 Se vende por ~" .. Theme.formatNumber(averageValue(level)),
			TextColor3 = C.PrimaryDark,
			TextXAlignment = Enum.TextXAlignment.Left,
			MaxTextSize = 20,
			Parent = header,
		})
		local grid = Theme.new("Frame", {
			Name = "Level" .. level,
			Size = UDim2.new(1, -16, 0, 184),
			BackgroundTransparency = 1,
			LayoutOrder = level * 2,
			Parent = list,
		}, {
			Theme.new("UIGridLayout", {
				CellSize = UDim2.fromOffset(138, 176),
				CellPadding = UDim2.fromOffset(16, 8),
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
		})
		for _, design in ipairs(Designs.Levels[level]) do
			buildCard(design, grid)
		end
	end
end

-- Panel de detalle ---------------------------------------------------------------------------
local function buildDetail(parent)
	local panel = Theme.new("Frame", {
		Position = UDim2.new(1, -324, 0, 100),
		Size = UDim2.new(0, 300, 1, -120),
		BackgroundTransparency = 1,
		Parent = parent,
	})
	local artBox = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 0),
		Size = UDim2.fromOffset(170, 170),
		BackgroundColor3 = C.PanelSoft,
		Parent = panel,
	}, { Theme.corner(22), Theme.stroke(Color3.fromRGB(240, 230, 220), 3) })
	detail.art = Theme.new(
		"Frame",
		{ Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = artBox },
		{ Theme.corner(22) }
	)
	detail.mystery = Theme.label({
		Size = UDim2.fromScale(1, 1),
		Text = "?",
		TextColor3 = C.InkSoft,
		MaxTextSize = 90,
		Parent = artBox,
	})
	detail.value = Theme.label({
		Size = UDim2.new(1, 0, 0, 26),
		Position = UDim2.fromOffset(0, 176),
		Text = "",
		TextColor3 = C.PrimaryDark,
		MaxTextSize = 21,
		Parent = panel,
	})
	detail.name = Theme.label({
		Size = UDim2.new(1, 0, 0, 40),
		Position = UDim2.fromOffset(0, 204),
		Text = "",
		MaxTextSize = 34,
		Parent = panel,
	})
	detail.info = Theme.label({
		Size = UDim2.new(1, 0, 0, 22),
		Position = UDim2.fromOffset(0, 244),
		Text = "",
		TextColor3 = C.InkSoft,
		MaxTextSize = 18,
		Parent = panel,
	})
	detail.medal = Theme.label({
		Size = UDim2.fromOffset(54, 54),
		Position = UDim2.fromOffset(0, 276),
		Text = "⚪",
		MaxTextSize = 44,
		Parent = panel,
	})
	detail.tier = Theme.label({
		Size = UDim2.new(1, -64, 0, 28),
		Position = UDim2.fromOffset(62, 276),
		Text = "",
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 24,
		Parent = panel,
	})
	detail.tierBonus = Theme.label({
		Size = UDim2.new(1, -64, 0, 22),
		Position = UDim2.fromOffset(62, 304),
		Text = "",
		TextColor3 = C.PrimaryDark,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 18,
		Parent = panel,
	})
	local barBack = Theme.new("Frame", {
		Size = UDim2.new(1, 0, 0, 12),
		Position = UDim2.fromOffset(0, 340),
		BackgroundColor3 = Color3.fromRGB(240, 234, 226),
		Parent = panel,
	}, { Theme.corner(6) })
	detail.bar = Theme.new(
		"Frame",
		{ Size = UDim2.fromScale(0, 1), BackgroundColor3 = C.Yellow, Parent = barBack },
		{ Theme.corner(6) }
	)
	detail.progress = Theme.label({
		Size = UDim2.new(1, 0, 0, 22),
		Position = UDim2.fromOffset(0, 356),
		Text = "",
		TextColor3 = C.InkSoft,
		MaxTextSize = 17,
		Parent = panel,
	})
	detail.tiers = Theme.label({
		Size = UDim2.new(1, 0, 0, 22),
		Position = UDim2.fromOffset(0, 380),
		Text = "🥉 +5%   🥈 +10%   🥇 +20%",
		TextColor3 = C.Ink,
		MaxTextSize = 18,
		Parent = panel,
	})
	detail.button = Theme.button({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -4),
		Size = UDim2.new(1, -10, 0, 56),
		Text = "Empezar a pintar",
		Soft = true,
		Color = C.Mint,
		Parent = panel,
		OnClick = function()
			DesignPicker.action()
		end,
	})
end

-- Lógica ------------------------------------------------------------------------------------
function DesignPicker.refresh()
	if not (window and window.Holder.Visible and app.state) then
		return
	end
	local state = app.state
	for _, design in ipairs(Designs.List) do
		local card = cards[design.id]
		local status = stateOf(design)
		local made = state.made[design.id] or 0
		card.stroke.Thickness = design.id == selectedId and 3 or 0
		card.card.BackgroundColor3 = design.id == selectedId and C.YellowSoft or C.Panel
		card.art.Visible = status ~= "closed"
		card.mystery.Visible = status == "closed"
		card.footer.Visible = status == "unlocked"
		card.price.Visible = status ~= "unlocked"
		if status == "buyable" then
			card.priceLabel.Text = "💵 " .. Theme.formatNumber(design.price)
		elseif status == "closed" then
			card.priceLabel.Text = "🔒 " .. Theme.formatNumber(design.price)
		end
		local medal, _, nextTier = masteryText(made)
		card.medal.Text = medal
		local goal = nextTier and nextTier.made or made
		card.bar.Size = UDim2.fromScale(math.clamp(made / math.max(goal, 1), 0, 1), 1)
		card.count.Text = nextTier and (made .. "/" .. goal) or tostring(made)
		card.name.TextTransparency = status == "closed" and 0.5 or 0
	end

	local design = Designs.get(selectedId) or Designs.List[1]
	local status = stateOf(design)
	local made = state.made[design.id] or 0
	DesignArt.render(detail.art, design, { mode = "color", outline = false })
	detail.art.Visible = status ~= "closed"
	detail.mystery.Visible = status == "closed"
	local value = Config.paintingValue(design, Designs.defaultColors(design), state.upgrades, made)
	detail.value.Text = "💵 Se vende por ~" .. Theme.formatNumber(value)
	detail.name.Text = status == "closed" and "???" or design.name
	detail.info.Text = "Nivel "
		.. design.level
		.. " · "
		.. #design.areas
		.. " colores · "
		.. #design.shapes
		.. " figuras"
	local medal, tier, nextTier = masteryText(made)
	detail.medal.Text = medal
	detail.tier.Text = tier and ("Maestría de " .. tier.name) or "Sin maestría aún"
	detail.tierBonus.Text = tier and ("Se vende por +" .. math.floor(tier.bonus * 100 + 0.5) .. "%")
		or "Píntalo varias veces para ganar medallas"
	if nextTier then
		detail.bar.Size = UDim2.fromScale(math.clamp(made / nextTier.made, 0, 1), 1)
		detail.progress.Text = made .. " de " .. nextTier.made .. " para " .. nextTier.name
	else
		detail.bar.Size = UDim2.fromScale(1, 1)
		detail.progress.Text = "¡Maestría máxima! (" .. made .. " pintados)"
	end

	if status == "unlocked" then
		detail.button.Button.Text = "🎨 Empezar a pintar"
		detail.button.SetBaseColor(C.Mint)
		detail.button.SetEnabled(not state.painting)
	elseif status == "buyable" then
		detail.button.Button.Text = "Desbloquear · 💵 " .. Theme.formatNumber(design.price)
		detail.button.SetBaseColor(C.Gold)
		detail.button.SetEnabled(state.coins >= design.price)
	else
		detail.button.Button.Text = "🔒 Pinta todo el nivel " .. (design.level - 1)
		detail.button.SetEnabled(false)
	end
end

function DesignPicker.action()
	if busy then
		return
	end
	local design = Designs.get(selectedId)
	local status = stateOf(design)
	if status == "unlocked" then
		window.Close()
		app.openColorPicker(design)
	elseif status == "buyable" then
		busy = true
		local ok, success, message = pcall(function()
			return app.remotes.UnlockDesign:InvokeServer(design.id)
		end)
		busy = false
		if ok and success then
			Theme.playSound("success", 1.1)
			app.notify("🔓 " .. message, "success")
			app.celebrate()
		else
			app.notify(ok and message or "No se pudo desbloquear.", "error")
		end
		DesignPicker.refresh()
	end
end

function DesignPicker.open()
	if app.state and app.state.painting then
		app.notify("Ya tienes un cuadro empezado 🎨", "info")
		app.resumePainting()
		return
	end
	window.Open()
	DesignPicker.refresh()
end

function DesignPicker.isOpen()
	return window.Holder.Visible
end

function DesignPicker.init(appRef)
	app = appRef
	local gui = Theme.new("ScreenGui", {
		Name = "DesignPicker",
		ResetOnSpawn = false,
		DisplayOrder = 12,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = Players.LocalPlayer:WaitForChild("PlayerGui"),
	})
	window = Theme.window({
		Name = "Window",
		Parent = gui,
		Size = UDim2.fromOffset(1000, 640),
		Title = "Elige un diseño",
		Subtitle = "Pinta todos los diseños de un nivel para abrir el siguiente. Los niveles altos se venden más caros.",
	})
	buildList(window.Panel)
	buildDetail(window.Panel)
end

return DesignPicker
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="22">
            <Properties>
              <string name="Name">HUD</string>
              <string name="Source"><![CDATA[-- Interfaz principal: monedas, galería, botones laterales, avisos y confeti.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Theme = require(script.Parent.Theme)

local HUD = {}

local C = Theme.Colors
local player = Players.LocalPlayer

local app
local gui
local refs = {}
local shownCoins = nil
local toastHolder
local confettiHolder

local KIND_COLORS = {
	info = C.Mint,
	success = C.Green,
	error = C.Red,
	gold = C.Gold,
}
local CONFETTI_COLORS = {
	Color3.fromRGB(255, 120, 170),
	Color3.fromRGB(255, 210, 80),
	Color3.fromRGB(110, 210, 255),
	Color3.fromRGB(150, 120, 255),
	Color3.fromRGB(100, 220, 160),
}

-- Avisos ------------------------------------------------------------------------------------
function HUD.notify(text, kind)
	if not toastHolder then
		return
	end
	local color = KIND_COLORS[kind] or C.Mint
	local toast = Theme.new("Frame", {
		Size = UDim2.new(1, 0, 0, 46),
		BackgroundColor3 = C.Panel,
		LayoutOrder = -math.floor(os.clock() * 100),
		Parent = toastHolder,
	}, { Theme.corner(23), Theme.stroke(color, 2.5) })
	Theme.label({
		Size = UDim2.new(1, -28, 1, -10),
		Position = UDim2.fromOffset(14, 5),
		Text = text,
		MaxTextSize = 22,
		Parent = toast,
	})
	Theme.pop(toast, 0.7)
	task.delay(3.6, function()
		if toast.Parent then
			toast:Destroy()
		end
	end)
	local toasts = {}
	for _, child in ipairs(toastHolder:GetChildren()) do
		if child:IsA("Frame") then
			table.insert(toasts, child)
		end
	end
	if #toasts > 4 then
		table.sort(toasts, function(a, b)
			return a.LayoutOrder > b.LayoutOrder
		end)
		toasts[1]:Destroy()
	end
end

function HUD.celebrate()
	local random = Random.new()
	for _ = 1, 70 do
		local piece = Theme.new("Frame", {
			Size = UDim2.fromOffset(random:NextInteger(8, 14), random:NextInteger(12, 20)),
			Position = UDim2.new(random:NextNumber(0.05, 0.95), 0, -0.05, 0),
			Rotation = random:NextInteger(0, 360),
			BackgroundColor3 = CONFETTI_COLORS[random:NextInteger(1, #CONFETTI_COLORS)],
			BorderSizePixel = 0,
			Parent = confettiHolder,
		}, { Theme.corner(3) })
		local duration = random:NextNumber(1.6, 2.8)
		Theme.tween(piece, duration, {
			Position = UDim2.new(piece.Position.X.Scale + random:NextNumber(-0.15, 0.15), 0, 1.05, 0),
			Rotation = piece.Rotation + random:NextInteger(-540, 540),
		}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		task.delay(duration, function()
			piece:Destroy()
		end)
	end
end

-- Barra superior --------------------------------------------------------------------------
local function pill(parent, props)
	local frame = Theme.new("Frame", {
		Name = props.Name,
		Size = props.Size,
		BackgroundColor3 = C.Panel,
		LayoutOrder = props.LayoutOrder,
		Parent = parent,
	}, { Theme.corner(22), Theme.stroke(props.Color, 2.5) })
	Theme.label({
		Size = UDim2.fromOffset(40, 40),
		Position = UDim2.fromOffset(6, 2),
		Text = props.Icon,
		MaxTextSize = 26,
		Parent = frame,
	})
	local label = Theme.label({
		Name = "Value",
		Size = UDim2.new(1, -56, 1, -8),
		Position = UDim2.fromOffset(46, 4),
		Text = "0",
		MaxTextSize = 28,
		Parent = frame,
	})
	return frame, label
end

local function buildTopBar()
	local bar = Theme.new("Frame", {
		Name = "TopBar",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 8),
		Size = UDim2.new(0, 560, 0, 44),
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		Theme.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			Padding = UDim.new(0, 14),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	local coinsFrame, coins =
		pill(bar, { Name = "Coins", Size = UDim2.new(0, 190, 1, 0), Color = C.Gold, Icon = "💵", LayoutOrder = 1 })
	refs.coins = coins
	refs.coinsFrame = coinsFrame
	local _, gallery = pill(
		bar,
		{ Name = "Gallery", Size = UDim2.new(0, 170, 1, 0), Color = C.Pink, Icon = "🖼️", LayoutOrder = 2 }
	)
	refs.gallery = gallery
	local _, sold =
		pill(bar, { Name = "Sold", Size = UDim2.new(0, 175, 1, 0), Color = C.Mint, Icon = "🏷️", LayoutOrder = 3 })
	refs.sold = sold
end

-- Botones laterales -------------------------------------------------------------------------
local function buildSideButtons()
	local holder = Theme.new("Frame", {
		Name = "SideButtons",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.new(0, 92, 0, 430),
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		Theme.new("UIListLayout", {
			Padding = UDim.new(0, 12),
			SortOrder = Enum.SortOrder.LayoutOrder,
			VerticalAlignment = Enum.VerticalAlignment.Center,
		}),
	})
	local function sideButton(order, icon, text, color, onClick)
		local button = Theme.button({
			Size = UDim2.new(1, 0, 0, 74),
			Text = "",
			Soft = true,
			Color = color,
			LayoutOrder = order,
			Radius = 20,
			Parent = holder,
			OnClick = onClick,
		})
		Theme.label({
			Size = UDim2.new(1, 0, 0.6, 0),
			Text = icon,
			ZIndex = 4,
			MaxTextSize = 34,
			Parent = button.Button,
		})
		local caption = Theme.label({
			Size = UDim2.new(1, 0, 0.4, 0),
			Position = UDim2.fromScale(0, 0.6),
			Text = text,
			ZIndex = 4,
			MaxTextSize = 18,
			Parent = button.Button,
		})
		return button, caption
	end
	sideButton(1, "🖌️", "Pintar", C.Mint, function()
		app.openDesigns()
	end)
	sideButton(2, "📚", "Colores", C.Purple, function()
		app.openCollection()
	end)
	sideButton(3, "🛒", "Mejoras", C.Green, function()
		app.openShop()
	end)
	local daily, dailyCaption = sideButton(4, "🎁", "Regalo", C.Pink, function()
		app.claimDaily()
	end)
	refs.dailyCaption = dailyCaption
	refs.dailyBadge = Theme.new("Frame", {
		Size = UDim2.fromOffset(22, 22),
		Position = UDim2.new(1, -14, 0, -8),
		BackgroundColor3 = C.Red,
		ZIndex = 6,
		Visible = false,
		Parent = daily.Holder,
	}, { Theme.corner(11), Theme.stroke(Color3.new(1, 1, 1), 2) })
	Theme.label({
		Size = UDim2.fromScale(1, 1),
		Text = "!",
		TextColor3 = Color3.new(1, 1, 1),
		ZIndex = 7,
		Parent = refs.dailyBadge,
	})
	sideButton(5, "🏠", "Mi taller", C.Orange, function()
		app.remotes.GoHome:FireServer()
	end)
end

-- Estado ------------------------------------------------------------------------------------
local function animateCoins(target)
	if shownCoins == nil then
		shownCoins = target
		refs.coins.Text = Theme.formatNumber(target)
		return
	end
	local start = shownCoins
	shownCoins = target
	if start == target then
		return
	end
	if target > start then
		Theme.pop(refs.coinsFrame, 0.85)
	end
	task.spawn(function()
		local duration = 0.6
		local t0 = os.clock()
		while os.clock() - t0 < duration do
			if shownCoins ~= target then
				return
			end
			refs.coins.Text = Theme.formatNumber(start + (target - start) * (os.clock() - t0) / duration)
			RunService.RenderStepped:Wait()
		end
		refs.coins.Text = Theme.formatNumber(target)
	end)
end

function HUD.applyState(state)
	animateCoins(state.coins)
	refs.gallery.Text = state.displayed .. "/" .. state.slots .. " en venta"
	refs.sold.Text = Theme.formatNumber(state.sold) .. " vendidos"
	refs.dailyBadge.Visible = state.dailyReady
	refs.dailyCaption.Text = state.dailyReady and "¡Regalo!" or Theme.formatTime(state.dailyWait)
	if state.painting then
		refs.hint.Text = "🎨 Tienes un cuadro a medio pintar: pulsa «Pintar» para seguir"
	elseif state.displayed >= state.slots then
		refs.hint.Text = "🖼️ Galería llena: espera a los visitantes o compra «Más paredes»"
	elseif state.sold == 0 and state.displayed == 0 then
		refs.hint.Text = "👉 Ve a la mesa de dibujo de tu taller o pulsa «Pintar»"
	else
		refs.hint.Text = ""
	end
end

function HUD.setVisible(visible)
	gui.Enabled = visible
end

function HUD.init(appRef)
	app = appRef
	gui = Theme.new("ScreenGui", {
		Name = "HUD",
		ResetOnSpawn = false,
		DisplayOrder = 1,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	buildTopBar()
	buildSideButtons()
	refs.hint = Theme.label({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -14),
		Size = UDim2.new(0, 560, 0, 30),
		Text = "",
		TextColor3 = C.Ink,
		MaxTextSize = 24,
		Parent = gui,
	})
	Theme.textStroke(Color3.new(1, 1, 1), 2.5).Parent = refs.hint

	local overlay = Theme.new("ScreenGui", {
		Name = "Notifications",
		ResetOnSpawn = false,
		DisplayOrder = 50,
		Parent = player:WaitForChild("PlayerGui"),
	})
	toastHolder = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 62),
		Size = UDim2.new(0, 460, 0, 260),
		BackgroundTransparency = 1,
		Parent = overlay,
	}, {
		Theme.new("UIListLayout", {
			Padding = UDim.new(0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
		}),
	})
	confettiHolder = Theme.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		Parent = overlay,
	})

	-- Escala en pantallas pequeñas.
	local scaled = { gui.TopBar, gui.SideButtons, toastHolder }
	local function updateScale()
		local camera = Workspace.CurrentCamera
		if not camera then
			return
		end
		local viewport = camera.ViewportSize
		local scale = math.clamp(math.min(viewport.X / 1280, viewport.Y / 720), 0.55, 1)
		for _, frame in ipairs(scaled) do
			local uiScale = frame:FindFirstChild("ViewportScale")
				or Theme.new("UIScale", { Name = "ViewportScale", Parent = frame })
			uiScale.Scale = scale
		end
	end
	updateScale()
	if Workspace.CurrentCamera then
		Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
	end
end

return HUD
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="23">
            <Properties>
              <string name="Name">Machine</string>
              <string name="Source"><![CDATA[-- Máquina de colores: panel en pantalla, cartel sobre la máquina del taller,
-- animación de colores raros y ventana de colección.

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Colors = require(Shared.Colors)
local Config = require(Shared.Config)

local Theme = require(script.Parent.Theme)
local DesignArt = require(script.Parent.DesignArt)

local Machine = {}

local C = Theme.Colors
local player = Players.LocalPlayer

local app
local gui
local refs = {}
local board = {}
local collection
local lastRollAt = 0
local rolling = false
local knownPaints = nil

local function rarityLine(colorId)
	local entry = Colors.ById[colorId]
	if not entry then
		return "¡Tira tu primer color!", C.InkSoft
	end
	local rarity = Colors.rarityOf(entry)
	return rarity.name .. "  x" .. string.format("%.1f", rarity.mult), rarity.color
end

-- Panel de la esquina -----------------------------------------------------------------------
local function buildWidget()
	local frame = Theme.new("Frame", {
		Name = "Machine",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 14, 1, -14),
		Size = UDim2.fromOffset(320, 128),
		BackgroundColor3 = C.Panel,
		Parent = gui,
	}, { Theme.corner(22), Theme.stroke(Color3.fromRGB(240, 230, 220), 3) })
	refs.widget = frame
	Theme.label({
		Position = UDim2.fromOffset(16, 6),
		Size = UDim2.new(1, -32, 0, 24),
		Text = "🎨 Máquina de colores",
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 21,
		Parent = frame,
	})
	refs.swatch = Theme.new("Frame", {
		Position = UDim2.fromOffset(16, 34),
		Size = UDim2.fromOffset(46, 46),
		BackgroundColor3 = Color3.fromRGB(235, 230, 225),
		Parent = frame,
	}, { Theme.corner(23) })
	refs.swatchStroke = Theme.stroke(C.InkSoft, 3)
	refs.swatchStroke.Parent = refs.swatch
	refs.name = Theme.label({
		Position = UDim2.fromOffset(72, 34),
		Size = UDim2.new(1, -88, 0, 24),
		Text = "",
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 22,
		Parent = frame,
	})
	refs.rarity = Theme.label({
		Position = UDim2.fromOffset(72, 58),
		Size = UDim2.new(1, -88, 0, 20),
		Text = "",
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 18,
		Parent = frame,
	})
	local barBack = Theme.new("Frame", {
		Position = UDim2.fromOffset(16, 86),
		Size = UDim2.new(1, -32, 0, 6),
		BackgroundColor3 = Color3.fromRGB(240, 234, 226),
		Parent = frame,
	}, { Theme.corner(3) })
	refs.bar = Theme.new(
		"Frame",
		{ Size = UDim2.fromScale(0, 1), BackgroundColor3 = C.Mint, Parent = barBack },
		{ Theme.corner(3) }
	)

	local row = Theme.new("Frame", {
		Position = UDim2.fromOffset(12, 96),
		Size = UDim2.new(1, -24, 0, 28),
		BackgroundTransparency = 1,
		Parent = frame,
	})
	refs.rollButton = Theme.button({
		Size = UDim2.new(1 / 3, -6, 1, -2),
		Text = "🎲 Tirar",
		Soft = true,
		Color = C.Mint,
		MaxTextSize = 18,
		Radius = 12,
		Parent = row,
		OnClick = function()
			Machine.roll()
		end,
	})
	refs.autoButton = Theme.button({
		Position = UDim2.new(1 / 3, 3, 0, 0),
		Size = UDim2.new(1 / 3, -6, 1, -2),
		Text = "🔄 Auto",
		Soft = true,
		Color = C.Mint,
		MaxTextSize = 18,
		Radius = 12,
		Parent = row,
		OnClick = function()
			Machine.toggleAuto()
		end,
	})
	Theme.button({
		Position = UDim2.new(2 / 3, 6, 0, 0),
		Size = UDim2.new(1 / 3, -6, 1, -2),
		Text = "📚 Colección",
		Soft = true,
		Color = C.Yellow,
		MaxTextSize = 16,
		Radius = 12,
		Parent = row,
		OnClick = function()
			Machine.openCollection()
		end,
	})
end

-- Cartel sobre la máquina del taller (como "Auto-Rolling / Mejora").
local function buildBoard()
	board.gui = Theme.new("BillboardGui", {
		Name = "MachineBoard",
		Size = UDim2.fromOffset(230, 150),
		StudsOffset = Vector3.new(0, 2.5, 0),
		MaxDistance = 45,
		LightInfluence = 0,
		AlwaysOnTop = false,
		ResetOnSpawn = false,
		Active = true,
		Enabled = false,
		Parent = player:WaitForChild("PlayerGui"),
	})
	board.auto = Theme.new("TextButton", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 0),
		Size = UDim2.fromOffset(170, 40),
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.1,
		Font = Theme.Fonts.Title,
		Text = "🔄 Auto-Rolling",
		TextScaled = true,
		TextColor3 = C.PrimaryDark,
		Parent = board.gui,
	}, { Theme.corner(20), Theme.stroke(C.MintSoft, 3), Theme.padding(6) })
	board.auto.Activated:Connect(function()
		Machine.toggleAuto()
	end)
	board.upgrade = Theme.new("TextButton", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 46),
		Size = UDim2.fromOffset(130, 30),
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Title,
		Text = "⬆ Mejora",
		TextScaled = true,
		TextColor3 = Color3.fromRGB(200, 120, 70),
		Parent = board.gui,
	})
	Theme.textStroke(Color3.new(1, 1, 1), 2).Parent = board.upgrade
	board.upgrade.Activated:Connect(function()
		app.openShop()
	end)
	board.info = Theme.label({
		Position = UDim2.fromOffset(0, 84),
		Size = UDim2.new(1, 0, 0, 60),
		Text = "",
		TextColor3 = C.Ink,
		MaxTextSize = 20,
		Parent = board.gui,
	})
	Theme.textStroke(Color3.new(1, 1, 1), 2).Parent = board.info
end

-- Animación de color raro ------------------------------------------------------------------
local function buildPopup()
	refs.popup = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.42),
		Size = UDim2.fromOffset(300, 260),
		BackgroundColor3 = C.Panel,
		Visible = false,
		ZIndex = 30,
		Parent = gui,
	}, { Theme.corner(30) })
	refs.popupStroke = Theme.stroke(C.Gold, 5)
	refs.popupStroke.Parent = refs.popup
	refs.popupRarity = Theme.label({
		Position = UDim2.fromOffset(10, 14),
		Size = UDim2.new(1, -20, 0, 44),
		Text = "",
		MaxTextSize = 42,
		ZIndex = 31,
		Parent = refs.popup,
	})
	Theme.textStroke(Color3.new(1, 1, 1), 2).Parent = refs.popupRarity
	refs.popupSwatch = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 64),
		Size = UDim2.fromOffset(110, 110),
		ZIndex = 31,
		Parent = refs.popup,
	}, { Theme.corner(55), Theme.stroke(Color3.new(1, 1, 1), 5) })
	refs.popupName = Theme.label({
		Position = UDim2.fromOffset(10, 182),
		Size = UDim2.new(1, -20, 0, 36),
		Text = "",
		MaxTextSize = 32,
		ZIndex = 31,
		Parent = refs.popup,
	})
	refs.popupMult = Theme.label({
		Position = UDim2.fromOffset(10, 218),
		Size = UDim2.new(1, -20, 0, 28),
		Text = "",
		TextColor3 = C.PrimaryDark,
		MaxTextSize = 24,
		ZIndex = 31,
		Parent = refs.popup,
	})
end

local popupToken = 0
local function showPopup(colorId, isNew)
	local entry = Colors.ById[colorId]
	local rarity = Colors.rarityOf(entry)
	popupToken += 1
	local token = popupToken
	refs.popupStroke.Color = rarity.color
	refs.popupRarity.Text = (isNew and "¡NUEVO! " or "¡") .. string.upper(rarity.name) .. "!"
	refs.popupRarity.TextColor3 = rarity.color
	DesignArt.swatch(refs.popupSwatch, colorId)
	refs.popupName.Text = entry.name
	refs.popupMult.Text = "Multiplica el valor x" .. string.format("%.1f", rarity.mult)
	refs.popup.Visible = true
	Theme.pop(refs.popup, 0.3)
	Theme.playSound("success", 0.7 + rarity.index * 0.1)
	if rarity.index >= 4 then
		app.celebrate()
	end
	task.delay(rarity.index >= 4 and 3 or 2, function()
		if token == popupToken then
			refs.popup.Visible = false
		end
	end)
end

-- Colección ----------------------------------------------------------------------------------
local function buildCollection()
	local holderGui = Theme.new("ScreenGui", {
		Name = "Collection",
		ResetOnSpawn = false,
		DisplayOrder = 12,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	collection = Theme.window({
		Name = "Window",
		Parent = holderGui,
		Size = UDim2.fromOffset(860, 600),
		Title = "📚 Mis pinturas",
		Subtitle = "Tira la máquina para descubrir colores. Cuanto más raros, más vale tu cuadro.",
	})
	refs.collectionList = Theme.new("ScrollingFrame", {
		Position = UDim2.fromOffset(24, 100),
		Size = UDim2.new(1, -48, 1, -120),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = C.InkSoft,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = collection.Panel,
	}, {
		Theme.new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
		Theme.new(
			"UIPadding",
			{ PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10) }
		),
	})
end

local function colorCell(parent, entry, count, order)
	local known = entry.basic or count > 0 or (knownPaints and knownPaints[entry.id])
	local cell = Theme.new("Frame", {
		BackgroundColor3 = C.Panel,
		LayoutOrder = order,
		Parent = parent,
	}, { Theme.corner(14) })
	local swatch = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 6),
		Size = UDim2.fromOffset(52, 52),
		BackgroundColor3 = Color3.fromRGB(236, 232, 226),
		Parent = cell,
	}, { Theme.corner(26) })
	if known then
		DesignArt.swatch(swatch, entry.id)
	else
		Theme.label({
			Size = UDim2.fromScale(1, 1),
			Text = "?",
			TextColor3 = C.InkSoft,
			MaxTextSize = 30,
			Parent = swatch,
		})
	end
	Theme.label({
		Position = UDim2.fromOffset(3, 60),
		Size = UDim2.new(1, -6, 0, 18),
		Text = known and entry.name or "???",
		MaxTextSize = 16,
		Parent = cell,
	})
	Theme.label({
		Position = UDim2.fromOffset(3, 78),
		Size = UDim2.new(1, -6, 0, 16),
		Text = entry.basic and "∞" or ("x" .. count),
		TextColor3 = count > 0 and C.PrimaryDark or C.InkSoft,
		MaxTextSize = 15,
		Parent = cell,
	})
end

function Machine.refreshCollection()
	if not (collection and collection.Holder.Visible and app.state) then
		return
	end
	local list = refs.collectionList
	for _, child in ipairs(list:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	local chances = Colors.chances(Config.luck(app.state.upgrades))
	local order = 0
	local sections = {}
	for i = #Colors.Rarities, 1, -1 do
		table.insert(sections, Colors.Rarities[i])
	end
	table.insert(sections, Colors.BASIC_RARITY)
	for _, rarity in ipairs(sections) do
		order += 1
		local header = Theme.label({
			Size = UDim2.new(1, 0, 0, 30),
			Text = rarity.id == "basico" and "Básicos · siempre disponibles" or string.format(
				"%s · x%.1f · %s%% por tirada",
				rarity.name,
				rarity.mult,
				string.format("%.1f", chances[rarity.id] * 100)
			),
			TextColor3 = rarity.color,
			TextXAlignment = Enum.TextXAlignment.Left,
			MaxTextSize = 24,
			LayoutOrder = order,
			Parent = list,
		})
		Theme.textStroke(Color3.new(1, 1, 1), 1).Parent = header
		order += 1
		local entries = {}
		for _, entry in ipairs(Colors.List) do
			if (rarity.id == "basico" and entry.basic) or entry.rarity == rarity.id then
				table.insert(entries, entry)
			end
		end
		local rows = math.ceil(#entries / 7)
		local grid = Theme.new("Frame", {
			Size = UDim2.new(1, 0, 0, rows * 104),
			BackgroundTransparency = 1,
			LayoutOrder = order,
			Parent = list,
		}, {
			Theme.new("UIGridLayout", {
				CellSize = UDim2.fromOffset(104, 98),
				CellPadding = UDim2.fromOffset(6, 6),
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
		})
		for i, entry in ipairs(entries) do
			colorCell(grid, entry, app.state.paints[entry.id] or 0, i)
		end
	end
end

function Machine.openCollection()
	collection.Open()
	Machine.refreshCollection()
end

-- Acciones -----------------------------------------------------------------------------------
function Machine.roll()
	if rolling then
		return
	end
	rolling = true
	local ok, result = pcall(function()
		return app.remotes.Roll:InvokeServer()
	end)
	rolling = false
	if ok and not result then
		app.notify("La máquina se está recargando ⚙️", "info")
	end
end

function Machine.toggleAuto()
	local enabled = not (app.state and app.state.autoRoll)
	app.remotes.SetAutoRoll:FireServer(enabled)
	Theme.playSound("click", enabled and 1.2 or 0.9)
end

function Machine.onRoll(colorId)
	lastRollAt = os.clock()
	local entry = Colors.ById[colorId]
	if not entry then
		return
	end
	local isNew = knownPaints ~= nil and not knownPaints[colorId]
	if knownPaints then
		knownPaints[colorId] = true
	end
	Theme.pop(refs.swatch, 0.6)
	local rarity = Colors.rarityOf(entry)
	if rarity.index >= 3 or isNew then
		showPopup(colorId, isNew)
	else
		Theme.playSound("click", 1.4)
	end
end

function Machine.applyState(state)
	if knownPaints == nil then
		knownPaints = {}
		for colorId, count in pairs(state.paints) do
			if count > 0 then
				knownPaints[colorId] = true
			end
		end
	end
	local colorId = state.lastRoll
	local entry = Colors.ById[colorId]
	if entry then
		DesignArt.swatch(refs.swatch, colorId)
		refs.name.Text = entry.name .. "  ·  x" .. (state.paints[colorId] or 0)
	else
		refs.name.Text = "Sin colores todavía"
	end
	local text, color = rarityLine(colorId)
	refs.rarity.Text = text
	refs.rarity.TextColor3 = color
	refs.swatchStroke.Color = color
	refs.autoButton.Button.Text = state.autoRoll and "🔄 Auto: Sí" or "🔄 Auto: No"
	refs.autoButton.SetBaseColor(state.autoRoll and C.Mint or Color3.fromRGB(220, 210, 200))
	board.auto.Text = state.autoRoll and "🔄 Auto-Rolling" or "⏸ Auto-Rolling"
	board.auto.TextColor3 = state.autoRoll and C.PrimaryDark or C.InkSoft
	board.info.Text = entry and (entry.name .. "\n" .. text) or "¡Tira tu primer color!"
	board.info.TextColor3 = color
	Machine.refreshCollection()
end

-- Coloca el cartel sobre la máquina de mi taller.
local function attachBoard()
	local index = app.state and app.state.plotIndex or 0
	local plots = Workspace:FindFirstChild("Plots")
	local plot = plots and plots:FindFirstChild("Plot" .. index)
	local workshop = plot and plot:FindFirstChild("Workshop")
	local machine = workshop and workshop:FindFirstChild("Machine")
	local top = machine and machine:FindFirstChild("Top")
	board.gui.Adornee = top
	board.gui.Enabled = top ~= nil
end

function Machine.init(appRef)
	app = appRef
	gui = Theme.new("ScreenGui", {
		Name = "MachineHud",
		ResetOnSpawn = false,
		DisplayOrder = 3,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	buildWidget()
	buildBoard()
	buildPopup()
	buildCollection()

	-- Barra de recarga y cartel.
	task.spawn(function()
		while true do
			task.wait(0.1)
			local state = app.state
			if state then
				if not board.gui.Enabled then
					attachBoard()
				end
				local interval = state.rollInterval or 4
				local fraction = math.clamp((os.clock() - lastRollAt) / interval, 0, 1)
				refs.bar.Size = UDim2.fromScale(fraction, 1)
				refs.rollButton.SetEnabled(fraction >= 1)
			end
		end
	end)

	-- Escala en pantallas pequeñas.
	local function updateScale()
		local camera = Workspace.CurrentCamera
		if camera then
			local viewport = camera.ViewportSize
			local scale = math.clamp(math.min(viewport.X / 1280, viewport.Y / 720), 0.6, 1)
			local uiScale = refs.widget:FindFirstChild("ViewportScale")
				or Theme.new("UIScale", { Name = "ViewportScale", Parent = refs.widget })
			uiScale.Scale = scale
		end
	end
	updateScale()
	if Workspace.CurrentCamera then
		Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
	end
end

function Machine.setVisible(visible)
	gui.Enabled = visible
end

return Machine
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="24">
            <Properties>
              <string name="Name">Painter</string>
              <string name="Source"><![CDATA[-- Estudio de pintura: el diseño aparece en líneas y cada figura se rellena con
-- el color de su área mientras pasas el pincel por encima.

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Colors = require(Shared.Colors)
local Config = require(Shared.Config)
local Designs = require(Shared.Designs)

local Theme = require(script.Parent.Theme)
local DesignArt = require(script.Parent.DesignArt)

local Painter = {}

local C = Theme.Colors
local SAMPLE_RING = 6

local app
local gui, root, canvasFrame, catcher, cursor, particles
local refs = {}
local current -- { design, colors, art, progress, areaLabels, done }
local stroking = false
local pointer = nil
local tool = "brush"
local particleClock = 0
local soundClock = 0
local confirmCancelUntil = 0
local finishing = false

-- Utilidades ----------------------------------------------------------------------------
local function levels()
	return app.state and app.state.upgrades or {}
end

local function canvasPoint(position)
	local absPos = canvasFrame.AbsolutePosition
	local absSize = canvasFrame.AbsoluteSize
	if absSize.X <= 0 then
		return nil
	end
	return (position.X - absPos.X) / absSize.X, (position.Y - absPos.Y) / absSize.Y
end

local function areaPercent(areaId)
	local total, done = 0, 0
	for i, shape in ipairs(current.design.shapes) do
		if shape.area == areaId then
			total += shape.visible
			done += shape.visible * current.progress[i]
		end
	end
	return total > 0 and done / total or 1
end

local function totalPercent()
	local total, done = 0, 0
	for i, shape in ipairs(current.design.shapes) do
		total += shape.visible
		done += shape.visible * current.progress[i]
	end
	return total > 0 and done / total or 1
end

local function isComplete()
	for i in ipairs(current.design.shapes) do
		if current.progress[i] < 1 then
			return false
		end
	end
	return true
end

local function refreshLabels()
	for areaId, label in pairs(current.areaLabels) do
		local p = areaPercent(areaId)
		local area = current.design.areaById[areaId]
		if p >= 0.999 then
			label.Text = area.name .. "\n✔ 100%"
			label.TextColor3 = C.PrimaryDark
		else
			label.Text = area.name .. "\n" .. math.floor(p * 100) .. "%"
			label.TextColor3 = C.Ink
		end
	end
	local total = totalPercent()
	refs.title.Text = current.design.name .. " · " .. math.floor(total * 100) .. "%"
	refs.progressFill.Size = UDim2.fromScale(total, 1)
end

-- Partículas --------------------------------------------------------------------------------
local function spawnParticle(x, y, color, burst)
	local dot = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(x, y),
		Size = UDim2.fromScale(0.018, 0.018),
		BackgroundColor3 = color,
		ZIndex = 6,
		Parent = particles,
	}, { Theme.corner(50) })
	local angle = math.random() * math.pi * 2
	local distance = (burst and 0.08 or 0.035) * (0.4 + math.random())
	Theme.tween(dot, 0.45, {
		Position = UDim2.fromScale(x + math.cos(angle) * distance, y + math.sin(angle) * distance),
		Size = UDim2.fromScale(0.004, 0.004),
		BackgroundTransparency = 1,
	})
	task.delay(0.5, function()
		dot:Destroy()
	end)
end

-- Pintar ------------------------------------------------------------------------------------
local function setShapeProgress(i, p)
	current.progress[i] = p
	current.art.setProgress(i, p)
end

local function areaColor(shapeIndex)
	local shape = current.design.shapes[shapeIndex]
	return Colors.mainColor(current.colors[shape.area])
end

local function completeIfDone()
	if not current.done and isComplete() then
		current.done = true
		stroking = false
		refreshLabels()
		task.delay(0.35, function()
			if current and current.done then
				Painter.showComplete()
			end
		end)
	end
end

local function brush(x, y, dt)
	local radius = Config.brushRadius(levels())
	local speed = Config.brushSpeed(levels())
	local hits = {}
	local samples = { { x, y } }
	for k = 0, SAMPLE_RING - 1 do
		local angle = k / SAMPLE_RING * math.pi * 2
		table.insert(samples, { x + math.cos(angle) * radius, y + math.sin(angle) * radius })
	end
	for _, point in ipairs(samples) do
		local index = Designs.shapeAt(current.design, point[1], point[2])
		if index and current.progress[index] < 1 then
			hits[index] = (hits[index] or 0) + 1
		end
	end
	local painted = nil
	for index, count in pairs(hits) do
		local time = Designs.shapeTime(current.design.shapes[index])
		-- Basta con rozar una figura para pintarla; cubrirla entera va más rápido.
		local coverage = 0.6 + 0.4 * count / #samples
		local amount = dt * speed * coverage * 1.15 / math.max(time, 0.05)
		setShapeProgress(index, math.min(1, current.progress[index] + amount))
		painted = index
	end
	if painted then
		particleClock += dt
		if particleClock > 0.05 then
			particleClock = 0
			spawnParticle(x, y, areaColor(painted), false)
		end
		soundClock += dt
		if soundClock > 0.18 then
			soundClock = 0
			Theme.playSound("paint", 0.9 + math.random() * 0.3)
		end
	end
	return painted ~= nil
end

local function bucket(x, y)
	local index = Designs.shapeAt(current.design, x, y)
	if index and current.progress[index] < 1 then
		setShapeProgress(index, 1)
		for _ = 1, 10 do
			spawnParticle(x, y, areaColor(index), true)
		end
		Theme.playSound("whoosh", 1.3)
		refreshLabels()
		completeIfDone()
	end
end

local function updateCursor()
	if not pointer or not current or current.done then
		cursor.Visible = false
		return
	end
	local x, y = canvasPoint(pointer)
	if not x or x < 0 or y < 0 or x > 1 or y > 1 then
		cursor.Visible = false
		return
	end
	local radius = tool == "bucket" and 0.02 or Config.brushRadius(levels())
	cursor.Visible = true
	cursor.Position = UDim2.fromScale(x, y)
	cursor.Size = UDim2.fromScale(radius * 2.4, radius * 2.4)
	local index = Designs.shapeAt(current.design, x, y)
	cursor.BackgroundColor3 = index and areaColor(index) or Color3.new(1, 1, 1)
end

local function onStep(dt)
	if not current then
		return
	end
	updateCursor()
	if stroking and pointer and not current.done and tool == "brush" then
		local x, y = canvasPoint(pointer)
		if x and x >= -0.05 and y >= -0.05 and x <= 1.05 and y <= 1.05 then
			if brush(x, y, math.min(dt, 0.1)) then
				current.labelClock = (current.labelClock or 0) + dt
				if current.labelClock > 0.1 then
					current.labelClock = 0
					refreshLabels()
				end
				completeIfDone()
			end
		end
	end
end

-- Interfaz ---------------------------------------------------------------------------------
local function setTool(name)
	tool = name
	refs.brushButton.SetBaseColor(name == "brush" and C.Mint or Color3.fromRGB(220, 210, 200))
	refs.bucketButton.SetBaseColor(name == "bucket" and C.Mint or Color3.fromRGB(220, 210, 200))
end

local function buildUI()
	gui = Theme.new("ScreenGui", {
		Name = "Painter",
		ResetOnSpawn = false,
		DisplayOrder = 15,
		Enabled = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = Players.LocalPlayer:WaitForChild("PlayerGui"),
	})
	-- Se extiende hacia arriba para tapar también la barra superior de Roblox.
	root = Theme.new("Frame", {
		Position = UDim2.fromOffset(0, -80),
		Size = UDim2.new(1, 0, 1, 80),
		BackgroundColor3 = C.Background,
		Parent = gui,
	})
	root = Theme.new("Frame", {
		Position = UDim2.fromOffset(0, 80),
		Size = UDim2.new(1, 0, 1, -80),
		BackgroundTransparency = 1,
		Parent = root,
	})

	-- Barra superior.
	refs.exit = Theme.button({
		Position = UDim2.fromOffset(16, 12),
		Size = UDim2.fromOffset(140, 46),
		Text = "✕ Salir",
		Soft = true,
		Color = C.Red,
		Parent = root,
		OnClick = function()
			Painter.requestCancel()
		end,
	})
	refs.title = Theme.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 10),
		Size = UDim2.new(0.5, 0, 0, 40),
		Text = "",
		MaxTextSize = 36,
		Parent = root,
	})
	local barBack = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 52),
		Size = UDim2.new(0.3, 0, 0, 10),
		BackgroundColor3 = Color3.fromRGB(240, 234, 226),
		Parent = root,
	}, { Theme.corner(5) })
	refs.progressFill = Theme.new("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = C.Mint,
		Parent = barBack,
	}, { Theme.corner(5) })

	refs.brushButton = Theme.button({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -170, 0, 12),
		Size = UDim2.fromOffset(140, 46),
		Text = "🖌️ Pincel",
		Color = C.Mint,
		Parent = root,
		OnClick = function()
			setTool("brush")
		end,
	})
	refs.bucketButton = Theme.button({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 12),
		Size = UDim2.fromOffset(140, 46),
		Text = "🪣 Cubeta",
		Color = Color3.fromRGB(220, 210, 200),
		Parent = root,
		OnClick = function()
			if Config.hasBucket(levels()) then
				setTool("bucket")
			else
				app.notify("Compra la mejora «Cubeta mágica» 🪣", "info")
			end
		end,
	})

	-- Lienzo.
	local canvasHolder = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.55),
		Size = UDim2.new(0.6, 0, 1, -150),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = root,
	}, {
		Theme.new("UIAspectRatioConstraint", { AspectRatio = 1 }),
		Theme.corner(18),
		Theme.stroke(Color3.fromRGB(240, 230, 220), 4),
	})
	canvasFrame = Theme.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = canvasHolder,
	}, { Theme.corner(18) })
	particles = Theme.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 6,
		Parent = canvasHolder,
	})
	cursor = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromScale(0.07, 0.07),
		BackgroundTransparency = 0.35,
		Visible = false,
		ZIndex = 8,
		Parent = canvasHolder,
	}, { Theme.corner(50), Theme.stroke(C.Ink, 2) })
	catcher = Theme.new("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 9,
		Parent = canvasHolder,
	})
	catcher.InputBegan:Connect(function(input)
		if not current or current.done then
			return
		end
		if
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			pointer = input.Position
			if tool == "bucket" then
				local x, y = canvasPoint(pointer)
				if x then
					bucket(x, y)
				end
			else
				stroking = true
			end
		end
	end)

	-- Columnas de áreas a los lados del lienzo.
	refs.left = Theme.new("Frame", {
		Position = UDim2.new(0, 16, 0, 80),
		Size = UDim2.new(0.18, 0, 1, -100),
		BackgroundTransparency = 1,
		Parent = root,
	}, {
		Theme.new("UIListLayout", {
			Padding = UDim.new(0, 6),
			VerticalAlignment = Enum.VerticalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	refs.right = Theme.new("Frame", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 80),
		Size = UDim2.new(0.18, 0, 1, -100),
		BackgroundTransparency = 1,
		Parent = root,
	}, {
		Theme.new("UIListLayout", {
			Padding = UDim.new(0, 6),
			VerticalAlignment = Enum.VerticalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})

	refs.value = Theme.label({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -6),
		Size = UDim2.new(0.5, 0, 0, 28),
		Text = "",
		TextColor3 = C.PrimaryDark,
		MaxTextSize = 24,
		Parent = root,
	})

	-- Ventana de cuadro terminado.
	refs.done = Theme.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = C.Shadow,
		BackgroundTransparency = 0.45,
		Visible = false,
		ZIndex = 20,
		Parent = gui,
	})
	local wrapper = Theme.new("Frame", {
		Name = "Wrapper",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(460, 560),
		BackgroundTransparency = 1,
		ZIndex = 20,
		Parent = refs.done,
	})
	refs.donePanel = Theme.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = C.Background,
		ZIndex = 20,
		Parent = wrapper,
	}, { Theme.corner(28), Theme.stroke(Color3.fromRGB(240, 230, 220), 3) })
	Theme.label({
		Position = UDim2.fromOffset(20, 16),
		Size = UDim2.new(1, -40, 0, 50),
		Text = "✨ ¡Cuadro terminado! ✨",
		MaxTextSize = 40,
		ZIndex = 21,
		Parent = refs.donePanel,
	})
	local artBox = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 72),
		Size = UDim2.fromOffset(240, 240),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 21,
		Parent = refs.donePanel,
	}, { Theme.corner(12), Theme.stroke(C.Gold, 8) })
	refs.doneArt = Theme.new(
		"Frame",
		{ Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 21, Parent = artBox },
		{
			Theme.corner(12),
		}
	)
	refs.doneValue = Theme.label({
		Position = UDim2.fromOffset(20, 324),
		Size = UDim2.new(1, -40, 0, 34),
		Text = "",
		TextColor3 = C.PrimaryDark,
		MaxTextSize = 30,
		ZIndex = 21,
		Parent = refs.donePanel,
	})
	refs.doneInfo = Theme.label({
		Position = UDim2.fromOffset(20, 358),
		Size = UDim2.new(1, -40, 0, 26),
		Text = "",
		TextColor3 = C.InkSoft,
		MaxTextSize = 19,
		ZIndex = 21,
		Parent = refs.donePanel,
	})
	refs.exhibit = Theme.button({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 396),
		Size = UDim2.new(1, -60, 0, 60),
		Text = "",
		Color = C.Mint,
		ZIndex = 21,
		Parent = refs.donePanel,
		OnClick = function()
			Painter.finish("galeria")
		end,
	})
	refs.sell = Theme.button({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 470),
		Size = UDim2.new(1, -60, 0, 56),
		Text = "",
		Soft = true,
		Color = C.Gold,
		ZIndex = 21,
		Parent = refs.donePanel,
		OnClick = function()
			Painter.finish("vender")
		end,
	})
	refs.doneWrapper = wrapper
end

local function updateDoneScale()
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local viewport = camera.ViewportSize
	local scale = math.clamp(math.min((viewport.X - 20) / 460, (viewport.Y - 80) / 560), 0.45, 1.1)
	local uiScale = refs.doneWrapper:FindFirstChild("ViewportScale")
		or Theme.new("UIScale", { Name = "ViewportScale", Parent = refs.doneWrapper })
	uiScale.Scale = scale
end

local function bindInput()
	UserInputService.InputChanged:Connect(function(input)
		if not current then
			return
		end
		if
			input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch
		then
			pointer = input.Position
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			stroking = false
			if current then
				refreshLabels()
			end
		end
	end)
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or not current then
			return
		end
		if input.KeyCode == Enum.KeyCode.B then
			setTool("brush")
		elseif input.KeyCode == Enum.KeyCode.F and Config.hasBucket(levels()) then
			setTool("bucket")
		end
	end)
	RunService.RenderStepped:Connect(onStep)
end

local function setControlsEnabled(enabled)
	pcall(function()
		local playerModule = require(Players.LocalPlayer.PlayerScripts:WaitForChild("PlayerModule", 2))
		local controls = playerModule:GetControls()
		if enabled then
			controls:Enable()
		else
			controls:Disable()
		end
	end)
end

-- API -----------------------------------------------------------------------------------------
function Painter.open(design, colors)
	current = {
		design = design,
		colors = colors,
		progress = {},
		areaLabels = {},
		done = false,
	}
	current.art = DesignArt.render(canvasFrame, design, { mode = "lineart", colors = colors, stroke = 2 })
	for i, shape in ipairs(design.shapes) do
		-- Las figuras completamente tapadas ya cuentan como pintadas.
		local initial = shape.visible <= 0 and 1 or 0
		setShapeProgress(i, initial)
	end
	for _, column in ipairs({ refs.left, refs.right }) do
		for _, child in ipairs(column:GetChildren()) do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end
	end
	local half = math.ceil(#design.areas / 2)
	for i, area in ipairs(design.areas) do
		local column = i <= half and refs.left or refs.right
		local row = Theme.new("Frame", {
			Size = UDim2.new(1, 0, 0, 58),
			BackgroundTransparency = 1,
			LayoutOrder = i,
			Parent = column,
		})
		local swatch = Theme.new("Frame", {
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 0, 0.5, 0),
			Size = UDim2.fromOffset(26, 26),
			Parent = row,
		}, { Theme.corner(13), Theme.stroke(Color3.fromRGB(235, 225, 215), 2) })
		DesignArt.swatch(swatch, colors[area.id])
		current.areaLabels[area.id] = Theme.label({
			Position = UDim2.fromOffset(34, 0),
			Size = UDim2.new(1, -34, 1, 0),
			Text = area.name,
			TextXAlignment = Enum.TextXAlignment.Left,
			MaxTextSize = 24,
			Parent = row,
		})
	end
	local value = Config.paintingValue(design, colors, levels(), app.state and app.state.made[design.id] or 0)
	refs.value.Text =
		string.format("Valor x%.2f · 💵 %s", Config.colorMultiplier(design, colors), Theme.formatNumber(value))
	current.value = value
	refs.done.Visible = false
	setTool(tool == "bucket" and Config.hasBucket(levels()) and "bucket" or "brush")
	refreshLabels()
	gui.Enabled = true
	ProximityPromptService.Enabled = false
	setControlsEnabled(false)
	app.setHudVisible(false)
	Theme.playSound("whoosh")
	completeIfDone()
end

function Painter.isOpen()
	return current ~= nil
end

function Painter.close()
	current = nil
	stroking = false
	gui.Enabled = false
	refs.done.Visible = false
	ProximityPromptService.Enabled = true
	setControlsEnabled(true)
	app.setHudVisible(true)
end

function Painter.requestCancel()
	if not current then
		return
	end
	if os.clock() > confirmCancelUntil then
		confirmCancelUntil = os.clock() + 3
		refs.exit.Button.Text = "¿Salir? Toca otra vez"
		task.delay(3, function()
			refs.exit.Button.Text = "✕ Salir"
		end)
		app.notify("Si sales pierdes este cuadro (te devolvemos las pinturas).", "info")
		return
	end
	confirmCancelUntil = 0
	refs.exit.Button.Text = "✕ Salir"
	app.remotes.CancelPainting:FireServer()
	Painter.close()
end

function Painter.showComplete()
	local state = app.state
	DesignArt.render(refs.doneArt, current.design, { mode = "color", colors = current.colors, outline = false })
	local value = current.value
	local galleryPrice = math.floor(value * Config.GALLERY_BONUS)
	refs.doneValue.Text = "💵 Vale " .. Theme.formatNumber(value)
	local free = state and (state.slots - state.displayed) or 0
	refs.doneInfo.Text = free > 0 and ("Huecos libres en tu galería: " .. free)
		or "Tu galería está llena: compra «Más paredes» 🖼️"
	refs.exhibit.Button.Text = "🖼️ Exponer en la galería · 💵 " .. Theme.formatNumber(galleryPrice)
	refs.exhibit.SetEnabled(free > 0)
	refs.sell.Button.Text = "💰 Vender ya · 💵 " .. Theme.formatNumber(value)
	updateDoneScale()
	refs.done.Visible = true
	Theme.pop(refs.donePanel, 0.6)
	Theme.playSound("success", 1)
	app.celebrate()
end

function Painter.finish(choice)
	if finishing or not current then
		return
	end
	finishing = true
	local result
	for _ = 1, 30 do
		local ok, response = pcall(function()
			return app.remotes.FinishPainting:InvokeServer(choice)
		end)
		result = ok and response or nil
		if result and not result.ok and result.reason == "¡Aún no está terminado!" then
			task.wait(1)
		else
			break
		end
	end
	finishing = false
	if not (result and result.ok) then
		app.notify(result and result.reason or "No se pudo terminar el cuadro.", "error")
		return
	end
	Painter.close()
	if result.displayed then
		app.notify(
			"🖼️ ¡Tu cuadro está en la galería! Un visitante lo comprará por 💵" .. result.price,
			"success"
		)
	else
		app.notify("💰 ¡Vendido por 💵" .. result.price .. "!", "gold")
	end
	if result.mastery then
		app.notify("🏅 ¡Maestría de " .. result.mastery .. " en este diseño!", "gold")
	end
	if result.newLevel then
		app.notify("🔓 ¡Nivel " .. result.newLevel .. " de diseños desbloqueado!", "gold")
		app.celebrate()
	end
end

function Painter.init(appRef)
	app = appRef
	buildUI()
	bindInput()
end

return Painter
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="25">
            <Properties>
              <string name="Name">Shop</string>
              <string name="Source"><![CDATA[-- Tienda de mejoras de la galería y del taller.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Colors = require(Shared.Colors)
local Config = require(Shared.Config)

local Theme = require(script.Parent.Theme)

local Shop = {}

local C = Theme.Colors

local app
local window
local cards = {}
local busy = false

-- Texto con el efecto actual y el siguiente de cada mejora.
local function effectText(id, level)
	local levels = { [id] = level }
	local nextLevels = { [id] = level + 1 }
	if id == "precio" or id == "decoracion" then
		return string.format("Valor x%.2f → x%.2f", Config.payMultiplier(levels), Config.payMultiplier(nextLevels))
	elseif id == "suerte" then
		local now = Colors.chances(Config.luck(levels))
		local after = Colors.chances(Config.luck(nextLevels))
		local rare = function(chances)
			return (chances.raro + chances.epico + chances.legendario + chances.mitico) * 100
		end
		return string.format("Raro o mejor: %.1f%% → %.1f%%", rare(now), rare(after))
	elseif id == "velocidad" then
		return string.format(
			"Un color cada %.1fs → %.1fs",
			Config.rollInterval(levels),
			Config.rollInterval(nextLevels)
		)
	elseif id == "pincel" then
		return string.format("Velocidad x%.1f → x%.1f", Config.brushSpeed(levels), Config.brushSpeed(nextLevels))
	elseif id == "cubeta" then
		return "Toca una figura y se rellena entera"
	elseif id == "fama" then
		return string.format(
			"Visitante cada %.0fs → %.0fs",
			Config.buyerInterval(levels),
			Config.buyerInterval(nextLevels)
		)
	elseif id == "paredes" then
		return string.format("Cuadros en venta %d → %d", Config.gallerySlots(levels), Config.gallerySlots(nextLevels))
	end
	return ""
end

local function buildCard(upgrade, order, parent)
	local card = Theme.new("Frame", {
		Size = UDim2.new(1, 0, 0, 96),
		BackgroundColor3 = C.Panel,
		LayoutOrder = order,
		Parent = parent,
	}, { Theme.corner(18), Theme.stroke(Color3.fromRGB(240, 230, 220), 2.5) })
	local iconBack = Theme.new("Frame", {
		Size = UDim2.fromOffset(72, 72),
		Position = UDim2.fromOffset(12, 12),
		BackgroundColor3 = C.PanelSoft,
		Parent = card,
	}, { Theme.corner(16) })
	Theme.label({ Size = UDim2.fromScale(1, 1), Text = upgrade.icon, MaxTextSize = 44, Parent = iconBack })

	Theme.label({
		Size = UDim2.new(1, -270, 0, 28),
		Position = UDim2.fromOffset(96, 8),
		Text = upgrade.name,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 24,
		Parent = card,
	})
	Theme.label({
		Size = UDim2.new(1, -270, 0, 20),
		Position = UDim2.fromOffset(96, 36),
		Text = upgrade.desc,
		Font = Theme.Fonts.Body,
		TextColor3 = C.InkSoft,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 16,
		Parent = card,
	})
	local effect = Theme.label({
		Size = UDim2.new(1, -270, 0, 18),
		Position = UDim2.fromOffset(96, 58),
		Text = "",
		TextColor3 = C.PrimaryDark,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 15,
		Parent = card,
	})
	local dots = Theme.new("Frame", {
		Size = UDim2.new(1, -270, 0, 8),
		Position = UDim2.fromOffset(96, 80),
		BackgroundTransparency = 1,
		Parent = card,
	}, {
		Theme.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 3),
		}),
	})
	local dotFrames = {}
	for i = 1, upgrade.max do
		dotFrames[i] = Theme.new("Frame", {
			Size = UDim2.new(1 / upgrade.max, -3, 1, 0),
			BackgroundColor3 = Color3.fromRGB(230, 224, 240),
			Parent = dots,
		}, { Theme.corner(4) })
	end

	local button = Theme.button({
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0.5, -2),
		Size = UDim2.fromOffset(150, 60),
		Text = "",
		Color = C.Mint,
		Soft = true,
		Parent = card,
		OnClick = function()
			if busy then
				return
			end
			busy = true
			local ok, success, message = pcall(function()
				return app.remotes.BuyUpgrade:InvokeServer(upgrade.id)
			end)
			busy = false
			if ok and success then
				Theme.playSound("success", 1.2)
				app.notify("✨ " .. message, "success")
				Theme.pop(card, 0.9)
			else
				app.notify(ok and message or "No se pudo comprar.", "error")
			end
		end,
	})
	cards[upgrade.id] = { effect = effect, dots = dotFrames, button = button }
end

function Shop.refresh()
	local state = app.state
	if not (state and window) then
		return
	end
	for _, upgrade in ipairs(Config.Upgrades) do
		local card = cards[upgrade.id]
		local level = state.upgrades[upgrade.id] or 0
		for i, dot in ipairs(card.dots) do
			dot.BackgroundColor3 = i <= level and C.Pink or Color3.fromRGB(230, 224, 240)
		end
		if level >= upgrade.max then
			card.effect.Text = "¡Nivel máximo!"
			card.button.Button.Text = "MÁX"
			card.button.SetEnabled(false)
		else
			local cost = Config.upgradeCost(upgrade.id, level)
			card.effect.Text = effectText(upgrade.id, level)
			card.button.Button.Text = "💰 " .. Theme.formatNumber(cost)
			card.button.SetEnabled(state.coins >= cost)
		end
	end
	if window then
		window.Subtitle.Text = "Tienes 💵 " .. Theme.formatNumber(state.coins)
	end
end

function Shop.open()
	window.Open()
	Shop.refresh()
end

function Shop.close()
	window.Close()
end

function Shop.init(appRef)
	app = appRef
	local gui = Theme.new("ScreenGui", {
		Name = "Shop",
		ResetOnSpawn = false,
		DisplayOrder = 14,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = Players.LocalPlayer:WaitForChild("PlayerGui"),
	})
	window = Theme.window({
		Name = "Window",
		Parent = gui,
		Size = UDim2.fromOffset(760, 620),
		Title = "🛒 Mejoras",
	})
	local list = Theme.new("ScrollingFrame", {
		Position = UDim2.fromOffset(24, 100),
		Size = UDim2.new(1, -48, 1, -120),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = C.InkSoft,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = window.Panel,
	}, {
		Theme.new("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }),
		Theme.new("UIPadding", {
			PaddingRight = UDim.new(0, 12),
			PaddingLeft = UDim.new(0, 3),
			PaddingTop = UDim.new(0, 3),
			PaddingBottom = UDim.new(0, 8),
		}),
	})
	for order, upgrade in ipairs(Config.Upgrades) do
		buildCard(upgrade, order, list)
	end
end

return Shop
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="26">
            <Properties>
              <string name="Name">Theme</string>
              <string name="Source"><![CDATA[-- Estilo visual compartido por toda la interfaz y pequeñas utilidades.

local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Theme = {}

Theme.Colors = {
	Background = Color3.fromRGB(255, 253, 248),
	Panel = Color3.fromRGB(255, 255, 255),
	PanelSoft = Color3.fromRGB(250, 246, 240),
	Ink = Color3.fromRGB(122, 86, 64),
	InkSoft = Color3.fromRGB(196, 168, 146),
	Primary = Color3.fromRGB(96, 206, 168),
	PrimaryDark = Color3.fromRGB(56, 160, 126),
	Mint = Color3.fromRGB(96, 206, 168),
	MintSoft = Color3.fromRGB(226, 248, 240),
	Yellow = Color3.fromRGB(255, 236, 100),
	YellowSoft = Color3.fromRGB(255, 249, 200),
	Pink = Color3.fromRGB(255, 130, 186),
	Gold = Color3.fromRGB(255, 196, 40),
	GoldDark = Color3.fromRGB(214, 150, 10),
	Green = Color3.fromRGB(80, 200, 130),
	GreenDark = Color3.fromRGB(40, 150, 90),
	Red = Color3.fromRGB(240, 96, 110),
	Orange = Color3.fromRGB(255, 160, 70),
	Purple = Color3.fromRGB(150, 110, 240),
	Shadow = Color3.fromRGB(90, 60, 50),
	Line = Color3.fromRGB(236, 150, 186),
}

Theme.Fonts = {
	Title = Enum.Font.PatrickHand,
	Body = Enum.Font.PatrickHand,
	Bold = Enum.Font.FredokaOne,
}

-- Crea una instancia con propiedades e hijos en una sola llamada.
function Theme.new(className, props, children)
	local instance = Instance.new(className)
	if props then
		for key, value in pairs(props) do
			if key ~= "Parent" then
				instance[key] = value
			end
		end
	end
	if children then
		for _, child in ipairs(children) do
			child.Parent = instance
		end
	end
	if props and props.Parent then
		instance.Parent = props.Parent
	end
	return instance
end

function Theme.corner(radius)
	return Theme.new("UICorner", { CornerRadius = UDim.new(0, radius or 14) })
end

function Theme.stroke(color, thickness, transparency)
	return Theme.new("UIStroke", {
		Color = color or Theme.Colors.Ink,
		Thickness = thickness or 2,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function Theme.textStroke(color, thickness)
	return Theme.new("UIStroke", {
		Color = color or Theme.Colors.Ink,
		Thickness = thickness or 2,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
	})
end

function Theme.padding(all)
	local p = UDim.new(0, all)
	return Theme.new("UIPadding", { PaddingTop = p, PaddingBottom = p, PaddingLeft = p, PaddingRight = p })
end

function Theme.gradient(top, bottom, rotation)
	return Theme.new("UIGradient", {
		Color = ColorSequence.new(top, bottom),
		Rotation = rotation or 90,
	})
end

function Theme.label(props)
	local defaults = {
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Title,
		TextColor3 = Theme.Colors.Ink,
		TextScaled = true,
		Text = "",
	}
	for key, value in pairs(props) do
		if key ~= "MaxTextSize" then
			defaults[key] = value
		end
	end
	local label = Theme.new("TextLabel", defaults)
	if props.TextScaled ~= false and not label:FindFirstChildOfClass("UITextSizeConstraint") then
		Theme.new("UITextSizeConstraint", { MaxTextSize = props.MaxTextSize or 40, Parent = label })
	end
	return label
end

-- Botón con sombra "3D" y animación al pulsar.
-- Botón con sombra suave. Soft = true: fondo blanco con borde de color
-- (como «Empezar a pintar»); si no, botón relleno de color.
function Theme.button(props)
	local color = props.Color or Theme.Colors.Primary
	local soft = props.Soft == true
	local radius = props.Radius or 14
	local holder = Theme.new("Frame", {
		Name = props.Name or "Button",
		Size = props.Size or UDim2.fromOffset(160, 48),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.new(),
		BackgroundTransparency = 1,
		LayoutOrder = props.LayoutOrder or 0,
		ZIndex = props.ZIndex or 1,
		Parent = props.Parent,
	})
	local shadow = Theme.new("Frame", {
		Name = "Shadow",
		Size = UDim2.new(1, 0, 1, 0),
		Position = UDim2.fromOffset(0, 3),
		BackgroundColor3 = color,
		BackgroundTransparency = soft and 0.55 or 0,
		ZIndex = holder.ZIndex,
		Parent = holder,
	}, { Theme.corner(radius) })
	local button = Theme.new("TextButton", {
		Name = "Face",
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundColor3 = soft and Color3.new(1, 1, 1) or color,
		AutoButtonColor = false,
		Font = Theme.Fonts.Title,
		Text = props.Text or "",
		TextColor3 = props.TextColor or (soft and Theme.Colors.Ink or Color3.new(1, 1, 1)),
		TextScaled = true,
		ZIndex = holder.ZIndex + 1,
		Parent = holder,
	}, {
		Theme.corner(radius),
		Theme.new("UIPadding", {
			PaddingTop = UDim.new(0.16, 0),
			PaddingBottom = UDim.new(0.16, 0),
			PaddingLeft = UDim.new(0, 8),
			PaddingRight = UDim.new(0, 8),
		}),
		Theme.new("UITextSizeConstraint", { MaxTextSize = props.MaxTextSize or 28 }),
	})
	local border = Theme.stroke(color, soft and 2.5 or 0)
	border.Parent = button
	if not soft then
		Theme.textStroke(color:Lerp(Color3.new(0, 0, 0), 0.35), 1).Parent = button
	end

	local enabled = true
	button.MouseButton1Down:Connect(function()
		if enabled then
			button.Position = UDim2.fromOffset(0, 2)
		end
	end)
	button.MouseButton1Up:Connect(function()
		button.Position = UDim2.fromOffset(0, 0)
	end)
	button.MouseLeave:Connect(function()
		button.Position = UDim2.fromOffset(0, 0)
	end)

	local api = { Holder = holder, Button = button, Shadow = shadow }
	function api.SetColor(newColor)
		if soft then
			border.Color = newColor
		else
			button.BackgroundColor3 = newColor
		end
		shadow.BackgroundColor3 = newColor
	end
	function api.SetEnabled(value)
		enabled = value
		button.Active = value
		api.SetColor(value and color or Color3.fromRGB(205, 198, 192))
		button.TextTransparency = value and 0 or 0.35
	end
	function api.SetBaseColor(newColor)
		color = newColor
		api.SetColor(newColor)
	end
	if props.OnClick then
		button.Activated:Connect(function()
			if enabled then
				Theme.playSound("click")
				props.OnClick()
			end
		end)
	end
	return api
end

-- Panel blanco con borde suave y título a mano (como las ventanas del juego).
function Theme.window(props)
	local holder = Theme.new("Frame", {
		Name = props.Name or "Window",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = props.Parent,
	})
	local dim = Theme.new("TextButton", {
		Name = "Dim",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Colors.Shadow,
		BackgroundTransparency = 0.6,
		Text = "",
		AutoButtonColor = false,
		Parent = holder,
	})
	local wrapper = Theme.new("Frame", {
		Name = "Wrapper",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = props.Size or UDim2.fromOffset(900, 560),
		BackgroundTransparency = 1,
		Parent = holder,
	})
	local panel = Theme.new("Frame", {
		Name = "Panel",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Colors.Background,
		Parent = wrapper,
	}, {
		Theme.corner(28),
		Theme.stroke(Color3.fromRGB(240, 230, 220), 3),
	})
	local title = Theme.label({
		Name = "Title",
		Size = UDim2.new(1, -120, 0, 44),
		Position = UDim2.fromOffset(32, 20),
		Text = props.Title or "",
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 38,
		Parent = panel,
	})
	local subtitle = Theme.label({
		Name = "Subtitle",
		Size = UDim2.new(1, -120, 0, 22),
		Position = UDim2.fromOffset(32, 62),
		Text = props.Subtitle or "",
		TextColor3 = Theme.Colors.InkSoft,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 20,
		Parent = panel,
	})
	local close = Theme.new("TextButton", {
		Name = "Close",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -20, 0, 18),
		Size = UDim2.fromOffset(44, 44),
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Title,
		Text = "✕",
		TextScaled = true,
		TextColor3 = Theme.Colors.Ink,
		Parent = panel,
	})
	local api = { Holder = holder, Panel = panel, Wrapper = wrapper, Title = title, Subtitle = subtitle, Close = close }
	function api.Open()
		holder.Visible = true
		Theme.pop(panel, 0.85)
		Theme.playSound("whoosh", 1.1)
	end
	function api.Close()
		holder.Visible = false
	end
	close.Activated:Connect(function()
		Theme.playSound("click")
		if props.OnClose then
			props.OnClose()
		else
			api.Close()
		end
	end)
	if not props.Modal then
		dim.Activated:Connect(function()
			if props.OnClose then
				props.OnClose()
			else
				api.Close()
			end
		end)
	end
	-- Ajusta el tamaño a pantallas pequeñas.
	local function updateScale()
		local camera = workspace.CurrentCamera
		if not camera then
			return
		end
		local size = wrapper.Size
		local viewport = camera.ViewportSize
		local scale = math.min((viewport.X - 24) / size.X.Offset, (viewport.Y - 70) / size.Y.Offset)
		local uiScale = wrapper:FindFirstChild("ViewportScale")
			or Theme.new("UIScale", { Name = "ViewportScale", Parent = wrapper })
		uiScale.Scale = math.clamp(scale, 0.4, 1.2)
	end
	updateScale()
	if workspace.CurrentCamera then
		workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
	end
	api.UpdateScale = updateScale
	return api
end

function Theme.tween(instance, time, props, style, direction)
	local tween = TweenService:Create(
		instance,
		TweenInfo.new(time, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out),
		props
	)
	tween:Play()
	return tween
end

-- Pequeño "rebote" al aparecer.
function Theme.pop(guiObject, scale)
	local uiScale = guiObject:FindFirstChild("PopScale")
	if not uiScale then
		uiScale = Theme.new("UIScale", { Name = "PopScale", Parent = guiObject })
	end
	uiScale.Scale = scale or 0.6
	Theme.tween(uiScale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
end

-- Formatea números grandes: 1234 -> 1.234, 1500000 -> 1,5M
function Theme.formatNumber(n)
	n = math.floor(n or 0)
	if n >= 1000000 then
		return (string.gsub(string.format("%.1fM", n / 1000000), "%.", ","))
	end
	local formatted = tostring(n)
	while true do
		local replaced, count = string.gsub(formatted, "^(-?%d+)(%d%d%d)", "%1.%2")
		formatted = replaced
		if count == 0 then
			break
		end
	end
	return formatted
end

function Theme.formatTime(seconds)
	seconds = math.max(0, math.floor(seconds))
	local h = math.floor(seconds / 3600)
	local m = math.floor(seconds % 3600 / 60)
	if h > 0 then
		return string.format("%dh %02dm", h, m)
	end
	return string.format("%dm %02ds", m, seconds % 60)
end

-- Sonidos incluidos en el cliente de Roblox (no requieren subir audio).
local SOUND_IDS = {
	click = "rbxasset://sounds/button.wav",
	paint = "rbxasset://sounds/clickfast.wav",
	success = "rbxasset://sounds/electronicpingshort.wav",
	whoosh = "rbxasset://sounds/swoosh.wav",
}
local SOUND_VOLUME = {
	click = 0.4,
	paint = 0.15,
	success = 0.6,
	whoosh = 0.4,
}
local soundCache = {}

function Theme.playSound(name, pitch)
	local id = SOUND_IDS[name]
	if not id then
		return
	end
	local sound = soundCache[name]
	if not sound then
		sound = Instance.new("Sound")
		sound.SoundId = id
		sound.Volume = SOUND_VOLUME[name] or 0.5
		sound.Parent = SoundService
		soundCache[name] = sound
	end
	sound.PlaybackSpeed = pitch or 1
	SoundService:PlayLocalSound(sound)
end

return Theme
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">World</string>
            <string name="Source"><![CDATA[-- Parte visual del mundo que se dibuja en el cliente: cuadros de la galería,
-- caballete del taller y globos de diálogo de los visitantes.

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Designs = require(Shared.Designs)

local UI = script.Parent:WaitForChild("UI")
local Theme = require(UI.Theme)
local DesignArt = require(UI.DesignArt)

local World = {}

local C = Theme.Colors
local player = Players.LocalPlayer

-- Cuadros -------------------------------------------------------------------------------
local function setupCanvas(canvas)
	if canvas:FindFirstChild("ArtGui") then
		return
	end
	local gui = Theme.new("SurfaceGui", {
		Name = "ArtGui",
		Face = Enum.NormalId.Front,
		SizingMode = Enum.SurfaceGuiSizingMode.FixedSize,
		CanvasSize = Vector2.new(300, 300),
		LightInfluence = 0.35,
		Brightness = 1.15,
		Parent = canvas,
	})
	local art = Theme.new("Frame", {
		Name = "Art",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(252, 248, 240),
		BorderSizePixel = 0,
		Parent = gui,
	})
	local placeholder = Theme.label({
		Name = "Placeholder",
		Size = UDim2.fromScale(0.84, 0.5),
		Position = UDim2.fromScale(0.08, 0.25),
		Text = "",
		TextColor3 = Color3.fromRGB(196, 180, 170),
		MaxTextSize = 60,
		Parent = art,
	})
	local function refresh()
		local design = Designs.get(canvas:GetAttribute("Design") or "")
		if design then
			placeholder.Visible = false
			DesignArt.render(art, design, {
				mode = "color",
				colors = Designs.decodeColors(canvas:GetAttribute("Colors")),
				outlineThickness = 1.5,
			})
		else
			local old = art:FindFirstChild("Art")
			if old then
				old:Destroy()
			end
			placeholder.Visible = true
			placeholder.Text = canvas:GetAttribute("Locked") and "🔒" or "🖌️\nEspacio libre"
		end
	end
	canvas:GetAttributeChangedSignal("Design"):Connect(refresh)
	canvas:GetAttributeChangedSignal("Colors"):Connect(refresh)
	canvas:GetAttributeChangedSignal("Locked"):Connect(refresh)
	refresh()
end

-- Visitantes -----------------------------------------------------------------------------
local function setupVisitor(model)
	local head = model:WaitForChild("Head", 10)
	if not head or head:FindFirstChild("VisitorBubble") then
		return
	end
	local billboard = Theme.new("BillboardGui", {
		Name = "VisitorBubble",
		Size = UDim2.fromOffset(240, 110),
		StudsOffset = Vector3.new(0, 3.2, 0),
		MaxDistance = 70,
		LightInfluence = 0,
		ResetOnSpawn = false,
		Parent = head,
	})
	local bubble = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -30),
		Size = UDim2.fromOffset(220, 54),
		BackgroundColor3 = C.Panel,
		Visible = false,
		Parent = billboard,
	}, { Theme.corner(18), Theme.stroke(C.Pink, 2.5) })
	local reaction = Theme.label({
		Size = UDim2.new(1, -16, 1, -8),
		Position = UDim2.fromOffset(8, 4),
		Text = "",
		MaxTextSize = 22,
		Parent = bubble,
	})
	local name = Theme.label({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, 0),
		Size = UDim2.fromOffset(220, 26),
		Text = tostring(model:GetAttribute("VisitorName") or ""),
		TextColor3 = Color3.new(1, 1, 1),
		MaxTextSize = 22,
		Parent = billboard,
	})
	Theme.textStroke(C.Ink, 2).Parent = name
	local function refresh()
		local text = model:GetAttribute("Reaction") or ""
		bubble.Visible = text ~= ""
		reaction.Text = text
		bubble.Size = UDim2.fromOffset(text == "🤔" and 60 or 220, string.find(text, "\n") and 64 or 46)
		if bubble.Visible then
			Theme.pop(bubble, 0.5)
		end
	end
	model:GetAttributeChangedSignal("Reaction"):Connect(refresh)
	refresh()
end

-- Avisos solo para el dueño del taller.
local function updatePrompts(plot)
	local mine = plot:GetAttribute("OwnerUserId") == player.UserId
	local workshop = plot:FindFirstChild("Workshop")
	if not workshop then
		return
	end
	for _, descendant in ipairs(workshop:GetDescendants()) do
		if descendant:IsA("ProximityPrompt") then
			descendant.MaxActivationDistance = mine and 12 or 0
		end
	end
end

local function watchPlot(plot)
	local gallery = plot:WaitForChild("Gallery", 10)
	if gallery then
		for _, descendant in ipairs(gallery:GetDescendants()) do
			if descendant.Name == "Canvas" and descendant:IsA("BasePart") then
				setupCanvas(descendant)
			end
		end
	end
	local workshop = plot:WaitForChild("Workshop", 10)
	local easel = workshop and workshop:WaitForChild("Easel", 10)
	local easelCanvas = easel and easel:WaitForChild("Canvas", 10)
	if easelCanvas then
		setupCanvas(easelCanvas)
	end
	local visitors = plot:WaitForChild("Visitors", 10)
	if visitors then
		for _, model in ipairs(visitors:GetChildren()) do
			task.spawn(setupVisitor, model)
		end
		visitors.ChildAdded:Connect(function(model)
			task.spawn(setupVisitor, model)
		end)
	end
	plot:GetAttributeChangedSignal("OwnerUserId"):Connect(function()
		updatePrompts(plot)
	end)
	updatePrompts(plot)
end

function World.start()
	local plots = Workspace:WaitForChild("Plots")
	for _, plot in ipairs(plots:GetChildren()) do
		task.spawn(watchPlot, plot)
	end
	plots.ChildAdded:Connect(function(plot)
		task.spawn(watchPlot, plot)
	end)
end

return World
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="28">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">false</bool>
    </Properties>
  </Item>
</roblox>